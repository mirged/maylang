// -------------------------------------------------------------
// Transaction Ledger & Risk Auditor
// -------------------------------------------------------------

// The transactions are an untrusted input stream, so each one stays a dynamic
// record (`Any`): a poisoned field must fault at run time and be caught, not be
// rejected at compile time. Everything derived from them is typed.
struct Audit { id: Int, status: Str, user: Str, total: Str, fee: Str, note: Str }

// Formatter for dollar amounts
fun format_money(cents: Int) -> Str {
    return "$" + str(cents / 100) + "." + str(cents % 100);
}

// Calculates fee with a risk-adjusted multiplier.
// FAULT HAZARD: Transactions with zero duration or corrupted
// metrics will trigger runtime faults here.
fun calc_risk_fee(tx: Any) -> Int {
    // Risky calculation:
    // If risk_factor is missing or 0, this divides by zero.
    let base_fee: Int = int(tx.amount / 50);
    let multiplier: Int = int(100 / tx.risk_score);

    return base_fee * multiplier;
}

// Speculatively process each transaction
fun audit_transaction(tx: Any) -> Audit {
    return may {
        let fee: Int = calc_risk_fee(tx);
        let total: Int = int(tx.amount + fee);

        Audit(int(tx.id), "CLEARED", str(tx.user), format_money(total), format_money(fee), "OK")
    } otherwise {
        Audit(int(tx.id), "REJECTED", str(tx.user), "$0.00", "$0.00", "Audit Fault: " + str(err))
    };
}

// Pipeline formatting stage
fun format_record(record: Audit, prefix: Str) -> Str {
    return prefix + " [" + record.status + "] " + record.user +
    " | Total: " + record.total +
    " (Fee: " + record.fee + ")" +
    " -> " + record.note;
}

// -------------------------------------------------------------
// The Data Stream (Mix of valid and poisoned inputs)
// -------------------------------------------------------------
let batch: List<Any> = [
    { id: 101, user: "Alice",   amount: 5000, risk_score: 10 },
    { id: 102, user: "Bob",     amount: 1250, risk_score: 25 },
    { id: 103, user: "Charlie", amount: 9900, risk_score: 0  },  // Division by zero!
    { id: 104, user: "Diana",   amount: 3200, risk_score: 50 },
    { id: 105, user: "Eve",     amount: "corrupted", risk_score: 5 } // Type fault!
];

// -------------------------------------------------------------
// Execution & Aggregation Pipeline
// -------------------------------------------------------------
mut processed: Int = 0;
mut cleared: Int = 0;
mut rejected: Int = 0;

print("==================================================");
print("        MAYLANG TRANSACTION AUDIT REPORT          ");
print("==================================================");

for tx: Any in batch {
    processed = processed + 1;

    let audit: Audit = audit_transaction(tx);

    if (audit.status == "CLEARED") {
        cleared = cleared + 1;
    } else {
        rejected = rejected + 1;
    }

    let line: Str = audit
        |> format_record("TX #" + str(audit.id));

    print(line);
}

print("--------------------------------------------------");
print("Summary: " + str(processed) + " processed | " + str(cleared) + " cleared | " + str(rejected) + " rejected");
print("==================================================");
