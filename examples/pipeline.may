// Pipelines: `data |> f |> g` inserts data as the first argument.

fun double(x: Int) -> Int { return x * 2; }
fun is_even(x: Int) -> Bool { return x % 2 == 0; }
fun add(a: Int, b: Int) -> Int { return a + b; }

let data: List<Int> = 1..=10;

let result: Int = data
    |> filter(is_even)
    |> map(double)
    |> sum;

print("sum of doubled evens 1..10 =", result); // 60

// Pipe with extra arguments: `x |> add(y)` == `add(x, y)`.
print("10 |> add(5) =", 10 |> add(5));

// Lambdas work anywhere a function value is expected.
let squares: List<Int> = map(1..=5, fun(x: Int) -> Int { return x * x; });
print("squares =", squares);
