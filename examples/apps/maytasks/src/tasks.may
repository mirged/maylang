// tasks.may — the task model and JSON persistence for `maytasks`.
//
// Tasks are persisted to `$HOME/.maytasks.json` (or `./maytasks.json` when
// HOME is unset) as a JSON list of `{ "id", "text", "done", "created" }`
// objects, which is how a Task struct serializes.

struct Task { id: Int, text: Str, done: Bool, created: Int }

fun tasks_path() -> Str {
    let home: Str = env("HOME") ?? "";
    if (len(home) == 0) { return "maytasks.json"; }
    return home + "/.maytasks.json";
}

/// Convert one decoded JSON entry into a Task; raise a fault when a field is missing or mistyped.
fun decode_task(entry: Any) -> Task {
    return Task(int(entry.id), str(entry.text), bool(entry.done), int(entry.created));
}

/// Load the task list, tolerating a missing or corrupt file and skipping malformed entries.
fun load_tasks() -> List<Task> {
    let tasks: List<Task> = [];
    let path: Str = tasks_path();
    if (!file_exists(path)) { return tasks; }
    let raw: Str = may { read_file(path) } otherwise { return tasks; };
    if (len(trim(raw)) == 0) { return tasks; }
    // JSON is dynamic: decode it at this boundary into Tasks.
    let parsed: Any = may { json_parse(raw) } otherwise { return tasks; };
    if (value_tag(parsed) != 5) { return tasks; } // must be a list
    for entry: Any in parsed {
        may { push(tasks, decode_task(entry)); } otherwise { continue; }
    }
    return tasks;
}

fun save_tasks(ts: List<Task>) -> Nil {
    write_file(tasks_path(), json_stringify(ts));
    return;
}

fun next_id(ts: List<Task>) -> Int {
    mut highest: Int = 0;
    for t: Task in ts {
        if (t.id > highest) { highest = t.id; }
    }
    return highest + 1;
}

/// Add a task and return the (new) list.
fun add_task(ts: List<Task>, text: Str) -> List<Task> {
    push(ts, Task(next_id(ts), text, false, time()));
    return ts;
}

/// Return the position of the task with `id`, or -1.
fun task_index(ts: List<Task>, id: Int) -> Int {
    for i: Int in 0..len(ts) {
        if (ts[i].id == id) { return i; }
    }
    return -1;
}

fun remove_task(ts: List<Task>, id: Int) -> List<Task> {
    return [t for t: Task in ts if t.id != id];
}

fun clear_completed(ts: List<Task>) -> List<Task> {
    return [t for t: Task in ts if !t.done];
}

fun open_tasks(ts: List<Task>) -> List<Task> { return [t for t: Task in ts if !t.done]; }
fun done_tasks(ts: List<Task>) -> List<Task> { return [t for t: Task in ts if t.done]; }

fun search_tasks(ts: List<Task>, needle: Str) -> List<Task> {
    let q: Str = to_lower(needle);
    return [t for t: Task in ts if contains(to_lower(t.text), q)];
}
