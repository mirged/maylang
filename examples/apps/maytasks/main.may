// main.may — a small, everyday task manager for the terminal.
//
//   maylang build -o maytasks examples/apps/maytasks/main.may
//   ./maytasks                 # interactive shell
//   ./maytasks add "buy milk"  # one-shot commands
//   ./maytasks list
//   ./maytasks done 2
//
// Tasks persist in $HOME/.maytasks.json.

import "src/tasks.may";

mut tasks: List<Task> = load_tasks();

fun help() -> Nil {
    print("maytasks — a tiny todo list that remembers");
    print("");
    print("  add <text>     add a task");
    print("  list, ls       show open and completed tasks");
    print("  done <id>      mark a task complete");
    print("  undone <id>    mark a task incomplete");
    print("  edit <id> <t>  replace a task's text");
    print("  rm <id>        delete a task");
    print("  clear          delete completed tasks");
    print("  find <text>    search task text");
    print("  stats          show counts");
    print("  help           show this help");
    print("  quit, q        leave the shell");
    return;
}

fun fmt_task(t: Task) -> Str {
    let mark: Str = if (t.done) { "x" } else { " " };
    return "  ${t.id}. [${mark}] ${t.text}";
}

fun show(ts: List<Task>) -> Nil {
    if (len(ts) == 0) {
        print("  (no tasks yet — add one with `add <text>`)");
        return;
    }
    let open: List<Task> = open_tasks(ts);
    let done: List<Task> = done_tasks(ts);
    if (len(open) > 0) {
        print("Open (${len(open)}):");
        for t: Task in open { print(fmt_task(t)); }
    }
    if (len(done) > 0) {
        print("Completed (${len(done)}):");
        for t: Task in done { print(fmt_task(t)); }
    }
    return;
}

fun parse_id(s: Str) -> Int {
    return may { int(s) } otherwise { -1 };
}

fun run_stats(ts: List<Task>) -> Nil {
    let total: Int = len(ts);
    let done: Int = len(done_tasks(ts));
    let pct: Int = if (total == 0) { 0 } else { (done * 100) / total };
    print("  total ${total} | open ${total - done} | done ${done} (${pct}%)");
    return;
}

/// Execute one command line. Returns true when the shell should exit.
fun run_command(line: Str) -> Bool {
    let parts: List<Str> = split(line, " ");
    mut cmd: Str = parts[0];
    let rest: Str = trim(join(slice(parts, 1, len(parts)), " "));

    if (cmd == "q" || cmd == "exit") { cmd = "quit"; }
    if (cmd == "ls") { cmd = "list"; }
    if (cmd == "del") { cmd = "rm"; }

    return match (cmd) {
        "add" => {
            if (len(rest) == 0) { print("  usage: add <text>"); return false; }
            tasks = add_task(tasks, rest);
            save_tasks(tasks);
            print("  added #${next_id(tasks) - 1}: ${rest}");
            false
        },
        "list" => { show(tasks); false },
        "done" => {
            let i: Int = task_index(tasks, parse_id(rest));
            if (i < 0) { print("  no task with that id"); return false; }
            let t: Task = tasks[i];
            t.done = true;
            save_tasks(tasks);
            print("  completed: ${t.text}");
            false
        },
        "undone" => {
            let i: Int = task_index(tasks, parse_id(rest));
            if (i < 0) { print("  no task with that id"); return false; }
            let t: Task = tasks[i];
            t.done = false;
            save_tasks(tasks);
            print("  reopened: ${t.text}");
            false
        },
        "edit" => {
            let sp: List<Str> = split(rest, " ");
            let i: Int = task_index(tasks, parse_id(sp[0]));
            if (i < 0) { print("  no task with that id"); return false; }
            let t: Task = tasks[i];
            let text: Str = trim(join(slice(sp, 1, len(sp)), " "));
            if (len(text) == 0) { print("  usage: edit <id> <text>"); return false; }
            t.text = text;
            save_tasks(tasks);
            print("  updated #${t.id}");
            false
        },
        "rm" => {
            let id: Int = parse_id(rest);
            if (task_index(tasks, id) < 0) { print("  no task with that id"); return false; }
            tasks = remove_task(tasks, id);
            save_tasks(tasks);
            print("  removed #${id}");
            false
        },
        "clear" => {
            let removed: Int = len(tasks) - len(clear_completed(tasks));
            tasks = clear_completed(tasks);
            save_tasks(tasks);
            print("  cleared ${removed} completed task(s)");
            false
        },
        "find" => {
            if (len(rest) == 0) { print("  usage: find <text>"); return false; }
            let hits: List<Task> = search_tasks(tasks, rest);
            print("  ${len(hits)} match(es):");
            for t: Task in hits { print(fmt_task(t)); }
            false
        },
        "stats" => { run_stats(tasks); false },
        "help" => { help(); false },
        "quit" => true,
        _ => { print("  unknown command `${cmd}` — try `help`"); false },
    };
}

fun interactive() -> Nil {
    print("maytasks — your list is saved to ${tasks_path()}");
    print("Type `help` for commands.");
    while (true) {
        let read: Optional<Str> = input("tasks> ");
        if (read == nil) { print(""); break; }
        let line: Str = read ?? "";
        if (trim(line) == "") { continue; }
        if (run_command(line)) { break; }
    }
    print("by the way, you have ${len(open_tasks(tasks))} open task(s).");
    return;
}

// Run one-shot commands when given arguments, otherwise start the shell.
let argv: List<Str> = args();
if (len(argv) > 1) {
    run_command(join(slice(argv, 1, len(argv)), " "));
} else {
    interactive();
}
