// Closures capture variables by reference.
fun make_counter(start: Int) -> () -> Int {
    mut n: Int = start;
    fun next() -> Int {
        n = n + 1;
        return n;
    }
    return next;
}

let a: () -> Int = make_counter(0);
let b: () -> Int = make_counter(100);

print(a()); // 1
print(a()); // 2
print(b()); // 101
print(a()); // 3

// Guard clauses with `unless` (single-statement form).
fun safe_head<T>(xs: List<T>) -> Optional<T> {
    unless (len(xs) > 0) return nil;
    return xs[0];
}

print(safe_head([10, 20, 30])); // 10
print(safe_head([]));           // nil

// Recursion and expression-oriented `if`.
fun fact(n: Int) -> Int {
    return if (n <= 1) { 1 } else { n * fact(n - 1) };
}

print("5! =", fact(5));
