import "model.may";

fun show_city(city: City, policy: Str) -> Nil {
    print("");
    print("[" + policy + "]  ~ canal  + garden  . homes  ! flooded homes  * deep flood");
    for y: Int in 0..8 {
        mut line: Str = "  ";
        for x: Int in 0..12 {
            let cell: Cell = city.cells[y * 12 + x];
            let glyph: Str = if (cell.people > 0 and cell.water > 22) { "*" }
                else if (cell.people > 0 and cell.water > 8) { "!" }
                else if (cell.kind == "canal") { "~" }
                else if (cell.kind == "park") { "+" } else { "." };
            line += glyph + " ";
        }
        print(line);
    }
    let t: Ledger = city.ledger;
    print("  exposure index: " + str(t.damage) + " / peak people flooded: " + str(t.peak));
    print("  pumped: " + str(t.pumped) + " / stored: " + str(stored_water(city)) + " / water balance error: " + str(balance_error(city)));
    return;
}

fun result_data(city: City, config: Config) -> Any {
    return {"policy": config.policy, "ledger": city.ledger, "frames": city.history};
}

fun export_results(results: List<Any>, config: Config) -> Nil {
    let city: City = new_city(config.seed);
    let terrain: List<Any> = [];
    for cell: Cell in city.cells {
        push(terrain, {"kind": cell.kind, "elevation": cell.elevation, "people": cell.people});
    }
    let document: Any = {"schema": "kaindsim-v1", "width": 12, "height": 8,
        "seed": config.seed, "steps": config.steps, "budget": config.budget,
        "cells": terrain, "runs": results};
    let payload: Str = json_stringify(document);
    let csv: List<Str> = ["policy,hour,rain,tide,people_exposed,exposure_index,stored,pumped,balance_error"];
    for run: Any in results {
        for frame: Any in run.frames {
            push(csv, str(run.policy) + "," + str(frame.tick) + "," + str(frame.rain) + "," +
                str(frame.tide) + "," + str(frame.exposed) + "," + str(frame.damage) + "," +
                str(frame.stored) + "," + str(frame.pumped) + "," + str(frame.balance));
        }
    }
    write_file(config.output + ".json", payload + "\n");
    write_file(config.output + ".csv", join(csv, "\n") + "\n");
    write_file(config.output + ".html", replay_html(payload));
    return;
}

fun replay_html(payload: Str) -> Str {
    return "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>KaindSim — The river remembers</title>\n<style>\n:root{color-scheme:dark;--bg:#101c24;--panel:#162731;--ink:#e7f1ed;--muted:#99b1b9;--mint:#b9eccb;--line:#304550}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,sans-serif}main{max-width:1160px;margin:auto;padding:36px 28px}header{display:flex;justify-content:space-between;align-items:start;gap:24px;margin-bottom:28px}.eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--mint)}h1{font:normal clamp(32px,5vw,58px)/1.07 Georgia,serif;letter-spacing:-.03em;margin:12px 0}p{color:var(--muted);margin:10px 0}.tag{border:1px solid var(--line);border-radius:24px;padding:8px 14px;white-space:nowrap;font-size:12px}.layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,1fr);gap:20px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:22px}.topline{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:16px}h2{font-size:16px;font-weight:500;margin:0}.small{font-size:12px;color:var(--muted)}.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px}button{font:inherit;border:1px solid var(--line);background:transparent;color:var(--ink);padding:9px 13px;border-radius:8px;cursor:pointer}button:hover,button.active{background:var(--mint);color:var(--bg);border-color:var(--mint)}svg#map{width:100%;display:block;background:#12212a;border-radius:8px}#map rect.cell{cursor:pointer}#map rect.cell:focus{outline:none;stroke:#fff;stroke-width:3}#detail{min-height:42px;margin-top:12px;color:var(--muted);font-size:13px}.legend{display:flex;gap:18px;flex-wrap:wrap;margin-top:12px;font-size:12px;color:var(--muted)}.dot{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px}.controls{display:flex;align-items:center;gap:12px;margin-top:22px}input[type=range]{width:100%;accent-color:var(--mint);cursor:pointer}select{background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:8px;font:inherit}.clock{font-variant-numeric:tabular-nums;white-space:nowrap}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:18px 0}.metric strong{display:block;font-size:30px;font-weight:400;letter-spacing:-.04em}.metric span{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.rule{border-top:1px solid var(--line);padding-top:18px;margin-top:14px}.note{font-size:13px}svg#chart{width:100%;height:130px;display:block;margin-top:12px}table{width:100%;border-collapse:collapse;font-size:12px}td,th{text-align:right;padding:11px 5px;border-bottom:1px solid var(--line);font-weight:400}td:first-child,th:first-child{text-align:left}th{color:var(--muted)}.current td{color:var(--mint)}footer{padding:24px 0;color:var(--muted);font-size:12px}a{color:var(--mint)}@media(max-width:780px){.layout{grid-template-columns:1fr}header{display:block}.tag{display:inline-block;margin-top:12px}main{padding:24px 16px}.panel{padding:16px}}\n</style></head><body><main>\n<header><div><div class=\"eyebrow\">KaindSim / Waterworks laboratory</div><h1>The river remembers.</h1><p>One city. The same storm. Three ways to keep the water out.</p></div><div class=\"tag\" id=\"seed\"></div></header>\n<div class=\"tabs\" id=\"tabs\" role=\"group\" aria-label=\"Pump policy\"></div><div class=\"layout\">\n<section class=\"panel\"><div class=\"topline\"><h2>A city between river and tide</h2><span class=\"small\">12 × 8 catchments · north ↑</span></div><svg id=\"map\" viewBox=\"0 0 600 400\" role=\"group\" aria-label=\"City flood map\"></svg>\n<div class=\"legend\"><span><i class=\"dot\" style=\"background:#687d72\"></i>Homes</span><span><i class=\"dot\" style=\"background:#527c59\"></i>Rain garden</span><span><i class=\"dot\" style=\"background:#2e697e\"></i>Canal</span><span><i class=\"dot\" style=\"background:#df895b\"></i>Flooded homes</span><span>◎ Pump station</span></div>\n<div id=\"detail\" aria-live=\"polite\">Select a catchment to inspect its water level and residents.</div>\n<div class=\"controls\"><button id=\"play\" aria-label=\"Play replay\">Play</button><input id=\"time\" type=\"range\" min=\"0\" value=\"0\" aria-label=\"Simulation hour\"><span class=\"clock\" id=\"clock\"></span><select id=\"speed\" aria-label=\"Playback speed\"><option value=\"350\">1×</option><option value=\"120\" selected>3×</option><option value=\"40\">9×</option></select></div><p class=\"small\">Scrub the timeline or press Play. Switching policies keeps the same hour.</p>\n<div class=\"rule\"><div class=\"topline\"><h2>People exposed to flooding</h2><span class=\"small\">All policies · full experiment</span></div><svg id=\"chart\" viewBox=\"0 0 600 130\" role=\"img\" aria-label=\"Exposure over time\"></svg><div class=\"legend\" id=\"chartlegend\"></div></div></section>\n<aside class=\"panel\"><div class=\"topline\"><h2 id=\"policyname\"></h2><span class=\"eyebrow\">Live ledger</span></div><p class=\"note\" id=\"description\"></p>\n<div class=\"metrics\"><div class=\"metric\"><strong id=\"exposed\"></strong><span>People exposed</span></div><div class=\"metric\"><strong id=\"stored\"></strong><span>Water in city</span></div><div class=\"metric\"><strong id=\"rain\"></strong><span>Rain this hour</span></div><div class=\"metric\"><strong id=\"tide\"></strong><span>Sea level</span></div></div>\n<div class=\"rule\"><div class=\"topline\"><span>Water balance error</span><strong id=\"balance\"></strong></div><p class=\"note\">Rain + river + tidal inflow = stored water + infiltration + drainage + pumping. Every hour is checked with integer arithmetic.</p></div>\n<div class=\"rule\"><h2>Final policy comparison</h2><table><thead><tr><th>Policy</th><th>Exposure*</th><th>Pumped</th></tr></thead><tbody id=\"comparison\"></tbody></table><p class=\"small\">*Cumulative excess-depth × residents, a model exposure index. Lower is better.</p><p class=\"note\" id=\"verdict\"></p></div>\n<div class=\"rule small\">The pump policies share four stations and the same hourly energy budget. The baseline leaves them off. Each weather draw is identical across policies.</div></aside></div>\n<footer>A simplified water-routing experiment, not a flood forecast. One tick = one model hour. Depth and elevation use arbitrary units. Generated by strict Maylang → mayc, managed with maypkg. <a id=\"download\" download=\"kaindsim-data.json\">Download experiment JSON</a></footer></main>\n<script id=\"experiment\" type=\"application/json\">" + payload + "</script><script>\n'use strict';\nconst data=JSON.parse(document.getElementById('experiment').textContent);\nconst names={none:'Pumps off',homes:'Protect homes',canal:'Clear canals'};\nconst descriptions={none:'A passive baseline: the river, tide, terrain and rain gardens decide where the water goes.',homes:'Prioritise excess water around inhabited catchments, weighted by the number of residents.',canal:'Prioritise clearing the canals, preserving their capacity to carry water through the city.'};\nconst colors={none:'#ffb983',homes:'#b9eccb',canal:'#80badb'};\nconst $=id=>document.getElementById(id),NS='http://www.w3.org/2000/svg';\nlet selected=0,hour=0,inspected=-1,timer=null;\nfunction el(tag,attrs,parent){const node=document.createElementNS(NS,tag);Object.entries(attrs).forEach(([k,v])=>node.setAttribute(k,v));parent.appendChild(node);return node;}\n$('seed').textContent='Seed '+data.seed+' / '+data.steps+' hours / budget '+data.budget;\n$('time').max=data.steps;\nconst tiles=data.cells.map((c,i)=>{\n const x=(i%12)*50,y=Math.floor(i/12)*50;\n const tile=el('rect',{x:x+2,y:y+2,width:46,height:46,rx:5,class:'cell',tabindex:0,role:'button'},$('map'));\n tile.addEventListener('click',()=>{inspected=i;render();});\n tile.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();inspected=i;render();}});\n const text=el('text',{x:x+25,y:y+29,'text-anchor':'middle',fill:'#eef5ee','font-size':12,'pointer-events':'none'},$('map'));\n if([27,32,63,68].includes(i))text.textContent='◎';else if(c.kind==='canal')text.textContent='≈';\n return tile;\n});\ndata.runs.forEach((run,i)=>{const button=document.createElement('button');button.textContent=names[run.policy];button.onclick=()=>{selected=i;render();};$('tabs').appendChild(button);});\nconst peak=Math.max(1,...data.runs.flatMap(r=>r.frames.map(f=>f.exposed)));\n[0,0.5,1].forEach(q=>el('line',{x1:0,x2:600,y1:115-q*105,y2:115-q*105,stroke:'#304550'},$('chart')));\ndata.runs.forEach(run=>{\n const points=run.frames.map(f=>(f.tick/data.steps*600)+','+(115-f.exposed/peak*105)).join(' ');\n el('polyline',{points,fill:'none',stroke:colors[run.policy],'stroke-width':2},$('chart'));\n const item=document.createElement('span'),dot=document.createElement('i');dot.className='dot';dot.style.background=colors[run.policy];item.appendChild(dot);item.append(names[run.policy]);$('chartlegend').appendChild(item);\n});\nconst cursor=el('line',{y1:0,y2:130,stroke:'#eef5ee','stroke-dasharray':'3 4'},$('chart'));\nconst rows=data.runs.map(run=>{const tr=document.createElement('tr');[names[run.policy],run.ledger.damage.toLocaleString(),run.ledger.pumped.toLocaleString()].forEach(value=>{const td=document.createElement('td');td.textContent=value;tr.appendChild(td);});$('comparison').appendChild(tr);return tr;});\nif(data.runs.length>1){const best=data.runs.reduce((a,b)=>a.ledger.damage<=b.ledger.damage?a:b),base=data.runs.find(r=>r.policy==='none');const reduction=base.ledger.damage?Math.round(100*(base.ledger.damage-best.ledger.damage)/base.ledger.damage):0;$('verdict').textContent=names[best.policy]+' has the lowest exposure index for this seed'+(base.ledger.damage?', '+reduction+'% below the passive baseline.':'.');}else $('verdict').textContent='Run compare to evaluate all policies against the same weather.';\nfunction render(){\n const run=data.runs[selected],f=run.frames[hour];\n [...$('tabs').children].forEach((b,i)=>{b.classList.toggle('active',i===selected);b.setAttribute('aria-pressed',i===selected);});\n rows.forEach((row,i)=>row.classList.toggle('current',i===selected));\n $('policyname').textContent=names[run.policy];$('description').textContent=descriptions[run.policy];\n ['exposed','stored','rain','tide','balance'].forEach(key=>$(key).textContent=f[key].toLocaleString());\n $('balance').style.color=f.balance===0?'#b9eccb':'#ffb983';\n $('clock').textContent='H '+String(hour).padStart(3,'0');$('time').value=hour;\n cursor.setAttribute('x1',hour/data.steps*600);cursor.setAttribute('x2',hour/data.steps*600);\n tiles.forEach((tile,i)=>{const c=data.cells[i],w=f.water[i];let fill=c.kind==='canal'?'#2e697e':c.kind==='park'?'#527c59':'#687d72';if(c.kind==='homes'&&w>8)fill=w>22?'#df895b':'#a7916b';else if(w>3)fill=c.kind==='canal'?'#428fa6':'#537c89';tile.setAttribute('fill',fill);tile.setAttribute('aria-label',c.kind+' catchment '+(i%12)+','+Math.floor(i/12)+', water '+w+', residents '+c.people);tile.setAttribute('stroke',i===inspected?'#fff':'#162731');tile.setAttribute('stroke-width',i===inspected?3:1.5);});\n if(inspected>=0){const c=data.cells[inspected];$('detail').textContent='Catchment '+(inspected%12)+', '+Math.floor(inspected/12)+' · '+c.kind+' · elevation '+c.elevation+' · water '+f.water[inspected]+' · '+c.people+' residents';}\n}\nfunction stop(){clearInterval(timer);timer=null;$('play').textContent='Play';$('play').setAttribute('aria-label','Play replay');}\nfunction play(){if(hour>=data.steps)hour=0;$('play').textContent='Pause';$('play').setAttribute('aria-label','Pause replay');timer=setInterval(()=>{if(hour>=data.steps){stop();return;}hour++;render();},Number($('speed').value));render();}\n$('play').onclick=()=>timer?stop():play();$('time').oninput=()=>{hour=Number($('time').value);render();};$('speed').onchange=()=>{if(timer){stop();play();}};\n$('download').href=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));\nrender();\n</script></body></html>";
}
