// A small module. Everything top-level becomes a global of the importing VM.
let TAU: Float = 6.283185307179586;

fun square(x: Int) -> Int { return x * x; }
fun cube(x: Int) -> Int { return x * x * x; }
fun clamp<T>(x: T, lo: T, hi: T) -> T { return if (x < lo) { lo } else if (x > hi) { hi } else { x }; }
