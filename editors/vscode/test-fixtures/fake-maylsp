#!/usr/bin/env node
// Minimal stdio language server for the extension-host tests. It answers
// initialize/shutdown and appends one JSON line per lifecycle event to
// $FAKE_MAYLSP_LOG so tests can observe starts, settings and clean stops.
"use strict";
const fs = require("fs");

const log = (event, extra) =>
  fs.appendFileSync(process.env.FAKE_MAYLSP_LOG, JSON.stringify({ event, pid: process.pid, ...extra }) + "\n");
const send = (message) => {
  const body = Buffer.from(JSON.stringify({ jsonrpc: "2.0", ...message }));
  process.stdout.write(`Content-Length: ${body.length}\r\n\r\n`);
  process.stdout.write(body);
};

let buffer = Buffer.alloc(0);
process.stdin.on("data", (chunk) => {
  buffer = Buffer.concat([buffer, chunk]);
  for (;;) {
    const end = buffer.indexOf("\r\n\r\n");
    if (end < 0) return;
    const length = Number(/Content-Length: *(\d+)/i.exec(buffer.subarray(0, end).toString())[1]);
    if (buffer.length < end + 4 + length) return;
    const message = JSON.parse(buffer.subarray(end + 4, end + 4 + length).toString());
    buffer = buffer.subarray(end + 4 + length);
    if (message.method === "initialize") {
      log("initialize", { strict: message.params.initializationOptions?.strict });
      send({ id: message.id, result: { capabilities: {} } });
    } else if (message.method === "shutdown") {
      log("shutdown");
      send({ id: message.id, result: null });
    } else if (message.method === "exit") {
      log("exit");
      process.exit(0);
    } else if (message.id !== undefined && message.method) {
      send({ id: message.id, result: null });
    }
  }
});
process.stdin.on("end", () => process.exit(0));
