{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Maylang",
  "scopeName": "source.maylang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.maylang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.maylang",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.maylang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.maylang",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.maylang",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.maylang",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?[\\d_]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.maylang",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.maylang",
          "match": "\\b(if|else|unless|while|for|in|return|break|continue|match)\\b"
        },
        {
          "name": "keyword.other.maylang",
          "match": "\\b(fun|let|mut|struct|enum|import|from|as|pub|extern|may|otherwise|and|or|not)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.maylang"
            },
            "2": {
              "name": "entity.name.function.maylang"
            }
          }
        },
        {
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(<[^>]+>)",
          "captures": {
            "1": {
              "name": "storage.type.function.maylang"
            },
            "2": {
              "name": "entity.name.function.maylang"
            },
            "3": {
              "name": "storage.type.generic.maylang"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.maylang",
          "match": "\\b(print|str|str_of|int|int_to_str|float|to_float|bool|type|type_name|len|push|pop|range|keys|values|has|map_get|map_set|merge|remove|map|filter|reduce|any|all|sort|reverse|sum|product|count|find|slice|enumerate|zip|flatten|unique|range_step|pad_left|pad_right|split_lines|get|times|each|chr|ord|even|odd|assert|assert_eq|fail|clock|time|input|read_stdin|args|env|exit|spawn|yield|run|syscall|ptr|addr|cstr|load8|load16|load32|load64|store8|store16|store32|store64|ccall|extern_c|mkdir|read_dir|exec|wait|system|sleep|read_file|write_file|file_exists|json_parse|json_stringify|split|trim|to_upper|to_lower|contains|starts_with|ends_with|replace|index_of|chars|parse_int|parse_float|sin|cos|tan|ln|log2|log10|exp|sqrt|floor|ceil|round|trunc|abs|min|max|clamp|pow|hypot|cbrt|sign|pi|e|substring|char_at|char_from|read_dir|value_eq|map_keys|map_values|map_has|remove|system|wait|read_file|file_exists)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.maylang",
          "match": "\\b(Any|Bool|Str|Nil|Void|Never|Int|Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Byte|Float|Float32|Float64|F32|F64|Ptr|RawPtr|List|Map|Slice|Array|Optional|Option|Result|Tuple)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.maylang",
          "match": "\\|>|\\?\\?|\\?\\.|==|!=|<=|>=|&&|\\|\\||=>|->|\\*\\*|\\+=|-=|\\*=|/=|\\.\\.=|\\.\\.\\.|\\.\\.|[+\\-*/%<>=!?:|]"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.maylang"
            },
            "2": {
              "name": "entity.name.type.maylang"
            }
          }
        },
        {
          "match": "\\b(let|mut)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.variable.maylang"
            },
            "2": {
              "name": "variable.other.maylang"
            }
          }
        },
        {
          "match": "\\b(pub|extern)\\b",
          "name": "storage.modifier.maylang"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*)(?=[A-Za-z_\\[])",
          "captures": {
            "1": {
              "name": "variable.parameter.maylang"
            },
            "2": {
              "name": "punctuation.separator.type.maylang"
            }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.enum.variant.maylang"
            }
          }
        }
      ]
    }
  }
}
