{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Injects Maylang highlighting into ```may and ```maylang fences in Markdown files.",
  "scopeName": "markdown.maylang.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "fileTypes": [],
  "patterns": [
    {
      "include": "#maylang-code-block"
    }
  ],
  "repository": {
    "maylang-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(may|maylang)((\\s+|:|,|\\{|\\?)[^`~]*)?$)",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown"
        }
      },
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.maylang",
          "patterns": [
            {
              "include": "source.maylang"
            }
          ]
        }
      ]
    }
  }
}
