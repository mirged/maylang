mut COLOR: Bool = false;
mut FANCY: Bool = false;
mut LINES: Int = 0;
mut WIDTH: Int = 68;
mut SAVED: Ptr = ptr(0);
mut RAW: Bool = false;
mut COPIED: Int = 0;
mut TOTAL: Int = 0;

fun ensure_saved() -> Nil {
    if (int(SAVED) == 0) {
        SAVED = ptr(syscall(9, 0, 4096, 3, 34, -1, 0));
        if (int(SAVED) < 0) { fail("Cannot allocate terminal state."); }
    }
    return;
}

pub fun write(text: Str) -> Nil {
    let pointer: Ptr = cstr(text);
    mut bytes: Int = 0;
    while (load8(pointer + bytes) != 0) { bytes += 1; }
    mut offset: Int = 0;
    while (offset < bytes) {
        let count: Int = syscall(1, 1, pointer + offset, bytes - offset);
        if (count == -4) { continue; }
        if (count <= 0) { return; }
        offset += count;
    }
    return;
}

pub fun line(text: Str) -> Nil {
    write(text + "\n");
    LINES += 1;
    return;
}

fun escape(code: Str) -> Str { return chr(27) + "[" + code; }
fun paint(text: Str, color: Str) -> Str { return if (COLOR) { escape(color + "m") + text + escape("0m") } else { text }; }
fun muted(text: Str) -> Str { return paint(text, "38;5;244"); }
fun mint(text: Str) -> Str { return paint(text, "1;38;5;157"); }
fun bright(text: Str) -> Str { return paint(text, "1;38;5;231"); }

fun fit(text: Str, width: Int) -> Str {
    if (width <= 0) { return ""; }
    if (len(text) <= width) { return text; }
    if (width <= 3) { return substring(text, 0, width); }
    return substring(text, 0, width - 3) + "...";
}

pub fun configure(plain: Bool, no_color: Bool) -> Nil {
    ensure_saved();
    let stdin_tty: Bool = syscall(16, 0, 21505, SAVED) == 0;
    let stdout_tty: Bool = syscall(16, 1, 21505, SAVED + 64) == 0;
    let terminal: Bool = stdin_tty and stdout_tty;

    let term: Str = env("TERM") ?? "";
    let valid_term: Bool = term != "" and term != "dumb";

    let no_color_val: Str = env("NO_COLOR") ?? "";
    let has_no_color: Bool = no_color or no_color_val != "";

    FANCY = terminal and not plain and valid_term;
    COLOR = terminal and not plain and not has_no_color and valid_term;

    let size: Ptr = SAVED + 128;
    if (syscall(16, 1, 21523, size) == 0) {
        let cols: Int = load16(size + 2);
        let rows: Int = load16(size);
        if (cols > 0) { WIDTH = max(32, min(68, cols - 4)); }
        if (WIDTH < 46 or (rows > 0 and rows < 22)) { FANCY = false; }
    } else {
        WIDTH = 68;
    }
    return;
}

pub fun restore() -> Nil {
    if (RAW and int(SAVED) > 0) {
        syscall(16, 0, 21506, SAVED);
        RAW = false;
        write(escape("?25h"));
    }
    return;
}

fun raw_input() -> Nil {
    ensure_saved();
    if (syscall(16, 0, 21505, SAVED) != 0) { fail("Cannot read terminal settings. Try --plain."); }
    let next: Ptr = SAVED + 64;
    for i: Int in 0..64 { store8(next + i, load8(SAVED + i)); }

    mut flags: Int = load32(next + 12);
    for bit: Int in [1, 2, 8, 64] {
        if (flags / bit % 2 != 0) { flags -= bit; }
    }
    store32(next + 12, flags);

    store8(next + 22, 0);
    store8(next + 23, 1);

    if (syscall(16, 0, 21508, next) != 0 and syscall(16, 0, 21506, next) != 0) {
        fail("Cannot configure terminal input. Try --plain.");
    }
    RAW = true;
    write(escape("?25l"));
    return;
}

fun byte_ready(timeout_ms: Int) -> Bool {
    let pollfd: Ptr = SAVED + 280;
    store32(pollfd, 0);
    store16(pollfd + 4, 1);
    store16(pollfd + 6, 0);
    return syscall(7, pollfd, 1, timeout_ms) > 0;
}

fun byte() -> Int {
    let result: Int = syscall(0, 0, SAVED + 256, 1);
    if (result == -4) { return -2; }
    if (result <= 0) { fail("Terminal input ended."); }
    return load8(SAVED + 256);
}

fun key() -> Int {
    let value: Int = byte();
    if (value == 27) {
        if (not byte_ready(50)) { return -1; }
        let second: Int = byte();
        if (second == 91 or second == 79) {
            if (not byte_ready(50)) { return -2; }
            let third: Int = byte();
            if (third == 65) { return 1001; }
            if (third == 66) { return 1002; }
        }
        return -2;
    }
    if (value == 3 or value == 4) { return -1; }
    if (value == 107) { return 1001; }
    if (value == 106) { return 1002; }
    return value;
}

pub fun clear() -> Nil {
    if (FANCY and LINES > 0) { write(escape(str(LINES) + "A") + "\r" + escape("J")); }
    LINES = 0;
    return;
}

pub fun heading(version: Str, subtitle: Str) -> Nil {
    line("");
    if (not FANCY) {
        line("  Maylang " + version);
        line("  " + subtitle);
        line("");
        return;
    }
    let left: Str = "╭─ ◇ ─";
    let brand: Str = "  M A Y L A N G  ";
    let slogan: Str = "A little language. A lot of possibility.";
    let box_width: Int = max(len(slogan) + 6, WIDTH);

    line("  " + mint(left) + bright(brand) + mint(repeat("─", max(2, box_width - len(left) - len(brand) - 1)) + "╮"));
    line("  " + mint("│") + "  " + bright(slogan) + repeat(" ", max(0, box_width - 4 - len(slogan))) + mint("│"));
    line("  " + mint("╰") + mint(repeat("─", max(2, box_width - 2)) + "╯"));
    line("");
    line("  " + muted(fit(subtitle + "  /  " + version + "  /  Linux x86-64", box_width)));
    line("");
    return;
}

pub fun detail(name: Str, value: Str) -> Nil {
    line("  " + muted(name + repeat(" ", max(1, 12 - len(name)))) + bright(fit(value, max(1, WIDTH - 14))));
    return;
}

pub fun prompt(message: Str, fallback: Str) -> Str {
    ensure_saved();
    let hint_width: Int = WIDTH - len(message) - 8;
    let hint: Str = if (fallback != "" and hint_width > 3) {
        " " + muted("[" + fit(fallback, hint_width) + "]")
    } else {
        ""
    };
    write("  " + mint("? ") + bright(message) + hint + " ");

    let buffer: Ptr = SAVED + 512;
    mut count: Int = 0;
    mut too_long: Bool = false;

    while (true) {
        let read: Int = syscall(0, 0, SAVED + 256, 1);
        if (read == -4) { continue; }
        if (read <= 0) { fail("Input ended. Run again, or pass --yes for unattended setup."); }
        let value: Int = load8(SAVED + 256);
        if (value == 10 or value == 13) {
            if (value == 13 and byte_ready(10)) {
                let peek: Int = syscall(0, 0, SAVED + 257, 1);
                if (peek > 0 and load8(SAVED + 257) != 10) {
                    // Non-LF byte after CR; input complete
                }
            }
            break;
        }
        if (count < 3500) {
            store8(buffer + count, value);
            count += 1;
        } else {
            too_long = true;
        }
    }
    LINES += 1;
    if (too_long) { fail("That answer is too long. Keep paths and choices below 3500 bytes."); }

    let value: Str = repeat(chr(0), count);
    for i: Int in 0..count {
        store8(cstr(value) + i, load8(buffer + i));
    }
    let res: Str = trim(value);
    return if (res == "") { fallback } else { res };
}

pub fun pick(options: List<Str>, descriptions: List<Str>, initial: Int) -> Int {
    if (len(options) == 0) { return -1; }
    if (not FANCY) {
        for i: Int in 0..len(options) {
            line("  " + str(i + 1) + ") " + options[i] + " — " + descriptions[i]);
        }
        while (true) {
            let answer: Str = prompt("Choose", str(initial + 1));
            if (has(["q", "quit", "cancel"], to_lower(answer))) { return -1; }
            for i: Int in 0..len(options) {
                if (answer == str(i + 1)) { return i; }
            }
            line("  Choose a number from 1 to " + str(len(options)) + ", or q to cancel.");
        }
    }

    raw_input();
    return may {
        mut selected: Int = max(0, min(initial, len(options) - 1));
        mut drawn: Int = 0;
        mut result: Int = -1;
        mut redraw: Bool = true;

        while (true) {
            if (redraw) {
                if (drawn > 0) { write(escape(str(drawn) + "A") + "\r" + escape("J")); LINES -= drawn; }
                for i: Int in 0..len(options) {
                    let cursor: Str = if (i == selected) { mint("› ") } else { "  " };
                    let title: Str = if (i == selected) { bright(options[i]) } else { muted(options[i]) };
                    let desc: Str = if (descriptions[i] != "") {
                        muted("  ·  " + fit(descriptions[i], max(0, WIDTH - len(options[i]) - 8)))
                    } else {
                        ""
                    };
                    line("  " + cursor + title + desc);
                }
                line("");
                let max_num: Int = min(9, len(options));
                let num_hint: Str = if (max_num > 1) { "1–" + str(max_num) + " shortcut   " } else { "" };
                line("  " + muted("↑ ↓ move   enter choose   " + num_hint + "esc cancel"));
                drawn = len(options) + 2;
                redraw = false;
            }

            let pressed: Int = key();
            if (pressed == -1) { break; }
            if (pressed == 10 or pressed == 13) { result = selected; break; }
            if (pressed >= 49 and pressed <= min(57, 48 + len(options))) {
                result = pressed - 49;
                break;
            }
            if (pressed == 1001) {
                selected = (selected + len(options) - 1) % len(options);
                redraw = true;
            }
            if (pressed == 1002) {
                selected = (selected + 1) % len(options);
                redraw = true;
            }
        }
        restore();
        result
    } otherwise {
        restore();
        fail(err.message);
        -1
    };
}

pub fun tools(current: Str) -> Str {
    let names: List<Str> = ["may", "mayfmt", "maypkg", "maylsp"];
    let labels: List<Str> = ["Project runner", "Code formatter", "Package manager", "Editor support"];
    let selected: List<Bool> = [];
    for name: Str in names {
        push(selected, current == "all" or has(split(current, ","), name));
    }

    if (not FANCY) {
        let answer: Str = prompt("Tools: all, compiler, or comma-separated names", current);
        if (answer == "all" or answer == "compiler") { return answer; }
        let parts: List<Str> = split(answer, ",");
        let result: List<Str> = ["mayc"];
        for p: Str in parts {
            let item: Str = trim(p);
            if (item != "" and item != "mayc" and has(names, item)) { push(result, item); }
        }
        if (len(result) == len(names) + 1) { return "all"; }
        if (len(result) == 1) { return "compiler"; }
        return join(result, ",");
    }

    line("  " + mint("✓ ") + bright("mayc") + muted("  ·  Compiler (always included)"));
    line("");
    raw_input();

    return may {
        mut cursor: Int = 0;
        mut drawn: Int = 0;
        mut redraw: Bool = true;
        mut cancelled: Bool = false;

        while (true) {
            if (redraw) {
                if (drawn > 0) { write(escape(str(drawn) + "A") + "\r" + escape("J")); LINES -= drawn; }
                for i: Int in 0..len(names) {
                    let cursor_sym: Str = if (cursor == i) { mint("› ") } else { "  " };
                    let mark: Str = if (selected[i]) { mint("[✓] ") } else { muted("[ ] ") };
                    line("  " + cursor_sym + mark + bright(names[i]) + muted("  ·  " + labels[i]));
                }
                line("");
                line("  " + muted("↑ ↓ move   space toggle   enter done   esc back"));
                drawn = len(names) + 2;
                redraw = false;
            }

            let pressed: Int = key();
            if (pressed == -1) { cancelled = true; break; }
            if (pressed == 10 or pressed == 13) { break; }
            if (pressed == 32) { selected[cursor] = not selected[cursor]; redraw = true; }
            if (pressed == 1001) { cursor = (cursor + len(names) - 1) % len(names); redraw = true; }
            if (pressed == 1002) { cursor = (cursor + 1) % len(names); redraw = true; }
        }
        restore();

        if (cancelled) { return current; }
        mut count: Int = 0;
        let result: List<Str> = ["mayc"];
        for i: Int in 0..len(names) {
            if (selected[i]) { push(result, names[i]); count += 1; }
        }
        if (count == len(names)) { return "all"; }
        if (count == 0) { return "compiler"; }
        return join(result, ",");
    } otherwise {
        restore();
        fail(err.message);
        current
    };
}

pub struct Settings { prefix: Str, components: Str, modify: Bool, profile: Str, cancelled: Bool }

pub fun wizard(version: Str, prefix: Str, components: Str, modify: Bool, profile: Str, removing: Bool) -> Settings {
    let result: Settings = Settings(prefix, components, modify, profile, false);
    while (true) {
        clear();
        heading(version, if (removing) { "REMOVE TOOLCHAIN" } else { "TOOLCHAIN SETUP" });
        detail(if (removing) { "Toolchain" } else { "Install to" }, result.prefix);
        detail("Tools", if (result.components == "all") {
            "Complete toolkit · all five tools"
        } else if (result.components == "compiler") {
            "Compiler + standard library"
        } else {
            result.components
        });
        detail("Shell PATH", if (result.modify) { result.profile } else { "I'll configure it myself" });
        line("");

        let action: Int = if (removing) {
            pick(["Uninstall Maylang", "Keep Maylang"],
                 ["Remove this installation and its PATH entries", "Leave everything as it is"], 1)
        } else {
            pick(["Install Maylang", "Customize setup", "Cancel"],
                 ["Use these settings · recommended", "Choose a folder, tools and shell integration", "Leave everything as it is"], 0)
        };

        if (action < 0 or (removing and action == 1) or action == 2) {
            result.cancelled = true;
            return result;
        }
        if (action == 0) { return result; }

        mut editing: Bool = true;
        while (editing) {
            clear();
            heading(version, "MAKE IT YOURS");
            let field: Int = pick(["Installation folder", "Included tools", "Shell integration", "Back to review"],
                                  [result.prefix, result.components, if (result.modify) { result.profile } else { "Manual PATH setup" }, "Review your choices and install"], 3);

            if (field < 0 or field == 3) {
                editing = false;
            } else if (field == 0) {
                clear();
                heading(version, "INSTALLATION FOLDER");
                result.prefix = prompt("Install prefix", result.prefix);
            } else if (field == 1) {
                clear();
                heading(version, "YOUR TOOLKIT");
                let toolset: Int = pick(["Complete toolkit", "Compiler only", "Choose individual tools"],
                                        ["Compiler, project runner, formatter, packages, editor", "Compiler and standard library · smallest install", "Toggle the tools you want with space"], 0);
                if (toolset == 0) { result.components = "all"; }
                else if (toolset == 1) { result.components = "compiler"; }
                else if (toolset == 2) {
                    clear();
                    heading(version, "PICK YOUR TOOLS");
                    result.components = tools(result.components);
                }
            } else {
                clear();
                heading(version, "READY IN YOUR SHELL");
                let shell: Int = pick(["Configure PATH for me", "Set up PATH myself", "Choose a shell profile"],
                                      [result.profile + " · recommended", "Show me the command when setup finishes", "Use a different Bash, Zsh or POSIX profile"], if (result.modify) { 0 } else { 1 });
                if (shell == 0) { result.modify = true; }
                else if (shell == 1) { result.modify = false; }
                else if (shell == 2) {
                    clear();
                    heading(version, "SHELL INTEGRATION");
                    result.profile = prompt("Shell profile", result.profile);
                    result.modify = true;
                }
            }
        }
    }
    return result;
}

pub fun start(version: Str, prefix: Str) -> Nil {
    clear();
    heading(version, "LET'S GET YOU SET UP");
    detail("Destination", prefix);
    line("");
    return;
}

pub fun progress(message: Str, done: Int, total: Int) -> Nil {
    if (FANCY) {
        let t: Int = max(total, 1);
        let d: Int = max(0, min(done, t));
        let fill: Int = min(24, d * 24 / t);
        let empty: Int = max(0, 24 - fill);
        write("\r" + escape("2K") + "  " + mint(repeat("━", fill)) + muted(repeat("─", empty))
              + "  " + muted(fit(message, max(0, WIDTH - 31))));
    }
    return;
}

pub fun copied(name: Str) -> Nil {
    COPIED += 1;
    progress(str(COPIED) + " / " + str(TOTAL) + " files", COPIED, TOTAL);
    return;
}

pub fun copy_begin(total: Int) -> Nil {
    TOTAL = total;
    COPIED = 0;
    if (not FANCY) { line("  Copying toolchain and standard library..."); }
    return;
}

pub fun step(message: Str) -> Nil {
    if (FANCY) { write("\r" + escape("2K")); }
    line("  " + mint("✓ ") + bright(message));
    return;
}

pub fun checking() -> Nil {
    if (not FANCY) { line("  Checking your compiler..."); }
    return;
}

pub fun spin(frame: Int) -> Nil {
    if (FANCY) {
        let f: Int = (frame % 4 + 4) % 4;
        write("\r" + escape("2K") + "  " + mint(["◐", "◓", "◑", "◒"][f]) + " " + bright("Checking your compiler"));
    }
    return;
}

pub fun success(version: Str, activate: Str, complete: Bool, profile: Str, uninstall: Str) -> Nil {
    line("");
    line("  " + mint("◇ You're ready to May.") + muted("  " + version));
    line("");
    if (profile != "") { line("  " + muted("Open a new terminal and you're ready to go.")); }
    line("  " + muted("To use Maylang in this terminal:"));
    line("    " + bright(activate));
    line("");
    if (complete) {
        line("  " + muted("Make your first project:"));
        line("    " + bright("may new hello"));
        line("    " + bright("cd hello && may run"));
    } else {
        line("  " + muted("Compile a program:"));
        line("    " + bright("mayc hello.may -o hello"));
    }
    line("");
    line("  " + muted("Docs: github.com/mirged/maylang"));
    line("  " + muted("Uninstall: " + uninstall));
    line("");
    return;
}

pub fun error(message: Str) -> Nil {
    restore();
    write("\r" + if (FANCY) { escape("2K") } else { "" });
    line("  " + paint("× Setup stopped", "1;38;5;203"));
    line("  " + message);
    line("");
    return;
}

pub fun cancelled() -> Nil {
    restore();
    line("");
    line("  " + muted("Cancelled. Your current setup is unchanged."));
    line("");
    return;
}
