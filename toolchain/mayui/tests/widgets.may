import "ui" as ui;
import "test" as test;
let window: ui.Window = ui.open("UI regression", 640, 480, true);
let input: ui.Widget = ui.entry("input", "caféλ");
let root: ui.Widget = ui.spacing(ui.column([input, ui.button("go", "Go"), ui.checkbox("check", "Check", false), ui.scroller("list", ui.spacing(ui.column([ui.size(ui.button("first", "First"), 0, 60), ui.size(ui.spacer(1), 0, 600), ui.button("hidden", "Hidden")]), 0, 0))]), 16, 12);
ui.focus(window, "input"); ui.present(window, root);
test.assert_equal(ui.pixel(window, 0, 0), 16119803, "background raster");
test.assert_equal(ui.pixel(window, 20, 25), 16777215, "entry interior raster");
let deletion: ui.Event = ui.dispatch(window, 7, 65288, 0, 0, "");
test.assert_equal(deletion.text, "café", "backspace removes one Unicode codepoint");
input.text = deletion.text; ui.present(window, root);
let insertion: ui.Event = ui.dispatch(window, 7, 955, 0, 0, "λ");
test.assert_equal(insertion.text, "caféλ", "Unicode insertion");
input.text = insertion.text; ui.present(window, root);
ui.dispatch(window, 7, 65360, 0, 0, "");
let removal: ui.Event = ui.dispatch(window, 7, 65535, 0, 0, "");
test.assert_equal(removal.text, "aféλ", "Delete at Home");
ui.dispatch(window, 7, 97, 0, 4, "");
let replacement: ui.Event = ui.dispatch(window, 7, 120, 0, 0, "x");
test.assert_equal(replacement.text, "x", "Ctrl+A selection replacement");
ui.dispatch(window, 7, 65289, 0, 0, "");
test.assert_equal(window.focus, "go", "Tab moves focus");
test.assert_equal(ui.dispatch(window, 7, 65293, 0, 0, "").kind, "click", "Enter activates button");
test.assert_equal(ui.dispatch(window, 5, 24, 140, 1, "").kind, "toggle", "mouse toggles checkbox");
ui.dispatch(window, 4, 50, 250, 0, ""); ui.dispatch(window, 6, 3, 0, 0, "");
test.assert_equal(window.scroll["list"], 144, "wheel moves scroll offset");
ui.present(window, root);
let clipped: ui.Event = ui.dispatch(window, 5, 30, 180, 1, "");
test.assert_equal(clipped.kind, "idle", "offscreen button cannot receive clicks");
mut made: Int = 0;
let virtual: ui.Widget = ui.virtual_list(window, "virtual", 10000, 64, fun(index: Int) -> ui.Widget { made += 1; return ui.label(str(index)); });
test.assert_equal(made < 20, true, "virtual list builds only visible rows");
ui.present(window, virtual);
let duplicate: Bool = may { ui.present(window, ui.column([ui.button("same", "A"), ui.button("same", "B")])); false } otherwise { true };
test.assert_equal(duplicate, true, "duplicate action IDs rejected");
let second: Bool = may { ui.open("second", 200, 200, true); false } otherwise { true };
test.assert_equal(second, true, "one active native surface");
let plain: ui.Widget = ui.button("plain", "Untouched");
let disabled: ui.Widget = ui.enabled(ui.button("disabled", "Unavailable"), false);
ui.present(window, ui.column([disabled, plain, ui.primary(ui.button("enabled", "Continue"))]));
test.assert_equal(ui.dispatch(window, 5, 20, 20, 1, "").kind, "idle", "disabled widgets do not accept clicks");
ui.dispatch(window, 7, 65289, 0, 0, "");
test.assert_equal(window.focus, "plain", "keyboard focus skips disabled widgets without changing other controls");
ui.set_theme(window, ui.dark_theme());
ui.present(window, ui.spacing(ui.column([ui.card(ui.spacing(ui.column([ui.label("A smooth surface")]), 20, 12))]), 20, 12));
test.assert_equal(ui.pixel(window, 0, 0), ui.dark_theme().background, "dark palette background");
test.assert_equal(ui.renderer(window), "CPU / headless", "headless renderer is explicit");
test.assert_equal(ui.render_stats(window)["draw_calls"], 0, "headless path makes no GPU draw calls");
test.assert_equal(ui.render_stats(window)["vertices"] > 0, true, "frame records geometry for both renderers");
let invalid_border: Bool = may { ui.border(ui.label("x"), 0, 9); false } otherwise { true };
test.assert_equal(invalid_border, true, "invalid border rejected");
let invalid_timeout: Bool = may { ui.poll_for(window, -1); false } otherwise { true };
test.assert_equal(invalid_timeout, true, "invalid poll timeout rejected");
let changing: ui.Widget = ui.label("x");
let measured: ui.Widget = ui.row([changing, ui.button("follow", "Following")]);
ui.present(window, measured);
test.assert_equal(ui.dispatch(window, 5, 40, 20, 1, "").id, "follow", "initial measured position");
changing.text = "The label becomes much wider between presentations";
ui.present(window, measured);
test.assert_equal(ui.dispatch(window, 5, 40, 20, 1, "").kind, "idle", "layout updates after widget mutation");
ui.close(window); ui.close(window);
test.test_summary();
