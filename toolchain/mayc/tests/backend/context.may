import "../../src/emitter.may";
let a: Any = emitter_new({"alignment": 4096});
let b: Any = emitter_new({"alignment": 16384});
e8(a, 17); e32(b, 123456); e64(a, 987654);
let la: Any = newlab(a);
let lb: Any = newlab(b);
placelab(a, la); placelab(b, lb);
fx(a, 0, 1, la); fx(b, 1, 0, 10);
let da: Any = dalloc(a, 8); let db: Any = dalloc(b, 16);
store64(a.data.data + da, 999);
store64(b.data.data + db, 333);
store8(a.image.data, 7); store8(b.image.data, 9);
print(a.code.length == 9, b.code.length == 4, load8(a.code.data) == 17, load32(b.code.data) == 123456);
print(lab_off(a, la) == 9, lab_off(b, lb) == 4, len(a.fixups) == 1, len(b.fixups) == 1);
print(a.data.length == 8, b.data.length == 16, load64(a.data.data) == 999, load64(b.data.data) == 333);
print(load8(a.image.data) == 7, load8(b.image.data) == 9);
emitter_release(a);
print(a.code.data == 0, load32(b.code.data) == 123456);
emitter_release(b);
