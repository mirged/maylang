mut steps: Int = 0;
mut seed: Int = 1;
while seed <= 50000 {
    mut n: Int = seed;
    while n > 1 {
        if n % 2 == 0 { n = n / 2; } else { n = n * 3 + 1; }
        steps += 1;
    }
    seed += 1;
}
mut checksum: Int = 0;
mut i: Int = 0;
while i < 20000 {
    let xs: List<Int> = [i, i + 1, i + 2];
    checksum += xs[0] + xs[2];
    i += 1;
}
print(steps, checksum);
