import "../../src/backend/x86_64.may";
import "../../src/emitter.may";
import "../../src/ir.may";
import "../../src/lexer.may";
import "../../src/ast.may";
import "../../src/regalloc.may";

fun require(ok: Bool) -> Nil { if not ok { fail("x86 codegen invariant failed"); } return; }
fun value(slot: Any) -> Any { return IRValue(IR_TEMP, slot, 0, 0, 0, 0, 0); }

let ctx: Any = emitter_new({"alignment": 4096, "format": "elf"});
// Check short encodings at zero/sign-extension boundaries and imm64 fallback.
let cases: Any = [
    [0, [184, 0, 0, 0, 0]],
    [1, [184, 1, 0, 0, 0]],
    [2147483648, [184, 0, 0, 0, 128]],
    [4294967295, [184, 255, 255, 255, 255]],
    [-1, [72, 199, 192, 255, 255, 255, 255]],
    [-2147483648, [72, 199, 192, 0, 0, 0, 128]],
    [4294967296, [72, 184, 0, 0, 0, 0, 1, 0, 0, 0]],
    [-2147483649, [72, 184, 255, 255, 255, 127, 255, 255, 255, 255]],
    [1152921504606846975, [72, 184, 255, 255, 255, 255, 255, 255, 255, 15]],
    [-1152921504606846976, [72, 184, 0, 0, 0, 0, 0, 0, 0, 240]]
];
for test: Any in cases {
    ctx.code.length = 0;
    mov_imm(ctx, test[0]);
    require(ctx.code.length == len(test[1]));
    for index: Any in 0..len(test[1]) { require(load8(ctx.code.data + index) == test[1][index]); }
}
// The large-literal operand fallback uses r11 without clobbering rcx.
ctx.code.length = 0;
x86_mov_immediate(ctx, 11, 4294967296);
require(ctx.code.length == 10 and load8(ctx.code.data) == 73 and load8(ctx.code.data + 1) == 187);
require(load32(ctx.code.data + 2) == 0 and load32(ctx.code.data + 6) == 1);

// Every address flavor patches the zero-extended immediate directly into
// either low or extended destinations. High layouts retain all 64 bits.
let codeLabel: Any = newlab(ctx); ctx.labels[codeLabel] = 123;
for format: Any in ["elf", "pe"] {
    ctx.target.format = format;
    let base: Any = if (format == "elf") { 4194304 } else { 5368709120 };
    ctx.layout = ImageLayout(base, 4096, base + 4096, 8192, base + 8192, 4096);
    for register: Any in 0..16 {
        for kind: Any in [1, 3, 4, 5, 6] {
            ctx.code.length = 0; ctx.fixups = [];
            let target: Any = if (kind == 6) { codeLabel } else { 32 };
            x86_relocated_immediate(ctx, register, kind, target);
            patch_all(ctx);
            mut expected: Any = base + 8192 + 32;
            if (kind == 3) { expected += 1; }
            else if (kind == 4) { expected = (expected + 8) * 8; }
            else if (kind == 5) { expected += 5; }
            else if (kind == 6) { expected = base + 4096 + 123; }
            if (format == "elf") {
                require(ctx.code.length == if (register < 8) { 5 } else { 6 });
                require(load32(ctx.code.data + ctx.code.length - 4) == expected);
            } else {
                require(ctx.code.length == 10);
                require(load64(ctx.code.data + 2) == expected);
            }
        }
    }
}
ctx.target.format = "elf"; ctx.fixups = [];

// Independent arbitrary-precision oracle values for ceil(2^(64+s)/d).
// Include both signed multiplier encodings and tagged-integer boundary divisors.
let reciprocals: Any = [
    [3, 1431655766, 1431655765, 0],
    [5, 1717986919, 1717986918, 1],
    [7, 613566757, 1227133513, 1],
    [10, 1717986919, 1717986918, 2],
    [13, 3303820997, 1321528398, 2],
    [17, 2021161081, 2021161080, 3],
    [2147483647, 3, 2147483649, 30],
    [1000000007, 312643557, 2305842993, 29],
    [2147483649, 2147483649, 1073741823, 29],
    [576460752303423489, 4294967281, 2147483647, 58],
    [1152921504606846975, 9, 2147483648, 59]
];
for test: Any in reciprocals {
    let magic: Any = x86_signed_reciprocal(test[0]);
    require(magic != 0);
    require(magic.low == test[1] and magic.high == test[2] and magic.shift == test[3]);
}
for divisor: Any in [-7, -1, 0, 1, 2, 8, 2147483648, 576460752303423488] {
    require(x86_signed_reciprocal(divisor) == 0);
}

let a: Any = value(0); let b: Any = value(1); let result: Any = value(2); let unused: Any = value(3);
// Metadata-only literal intrinsics have no runtime string operand. A local
// declaration or parameter with the same name must preserve ordinary calls.
let text: Any = "xyz";
let literal: Any = IRValue(E_STR, 0, 0, 0, 3, SourceSpan(addr(text), 0, 3, 1, 1), 0);
let intrinsic: Any = Quad(E_CALL, b, 0, 0, {"name": addr("len"), "length": 3, "args": literal}, 0);
let literalBlock: Any = IRBlock([intrinsic], 2);
let folded: Any = x86_raw_allocation_block(ctx, literalBlock);
require(folded.code[0].op == E_INT and folded.code[0].extra.value == 3);
push(ctx.locals, [addr("len"), 3]);
require(x86_raw_allocation_block(ctx, literalBlock).code[0].op == E_CALL);
ctx.locals = [];
let shadow: Any = Quad(S_LET, 0, a, 0, {"name": addr("len"), "length": 3, "initializer": a, "global": 0}, 0);
require(x86_raw_allocation_block(ctx, IRBlock([shadow, intrinsic], 2)).code[1].op == E_CALL);

// Cascading deletion follows actual duplicate operand visits. Trapping
// division and multi-definition slots must remain in the allocation view.
let deadAdd: Any = Quad(E_BIN, b, a, a, {"op": TK_PLUS, "left": a, "right": a}, 0);
let deadBlock: Any = IRBlock([Quad(E_INT, a, 0, 0, {"value": 7}, 0), deadAdd], 2);
x86_discard_unused(deadBlock);
require(deadBlock.code[0].op == 0 and deadBlock.code[1].op == 0);
let trap: Any = Quad(E_BIN, b, a, a, {"op": TK_SLASH, "left": a, "right": a}, 0);
let trapBlock: Any = IRBlock([Quad(E_INT, a, 0, 0, {"value": 0}, 0), trap], 2);
x86_discard_unused(trapBlock);
require(trapBlock.code[0].op == E_INT and trapBlock.code[1].op == E_BIN);
let multi: Any = IRBlock([Quad(E_INT, a, 0, 0, {"value": 1}, 0), Quad(E_INT, a, 0, 0, {"value": 2}, 0)], 1);
x86_discard_unused(multi);
require(multi.code[0].op == E_INT and multi.code[1].op == E_INT);

// A second operand read cannot rely on the one-shot rax fact. Nor may an
// accumulator-only value cross a label where other predecessors can enter.
let producer: Any = Quad(E_INT, a, 0, 0, {"kind": E_INT, "value": 7}, 0);
let twice: Any = Quad(E_BIN, b, a, a, {"kind": E_BIN, "op": TK_PLUS, "left": a, "right": a}, 0);
let repeated: Any = IRBlock([producer, twice], 2);
ctx.allocation = lsra_allocate(repeated, [12, 13]); ctx.allocation.position = 0;
require(x86_accumulator_only(ctx, repeated, producer) == false);
let reader: Any = Quad(IR_RETURN, 0, a, 0, 0, 0);
let adjacent: Any = IRBlock([producer, reader], 1);
ctx.allocation = lsra_allocate(adjacent, [12]); ctx.allocation.position = 0;
require(x86_accumulator_only(ctx, adjacent, producer) == true);
let joined: Any = IRBlock([producer, Quad(IR_LABEL, 0, 0, 0, 50, 0), reader], 1);
ctx.allocation = lsra_allocate(joined, [12]); ctx.allocation.position = 0;
require(x86_accumulator_only(ctx, joined, producer) == false);
let localName: Any = "operand";
push(ctx.locals, [addr(localName), len(localName)]);
let variable: Any = Quad(E_VAR, a, 0, 0, {"name": addr(localName), "length": len(localName)}, 0);
let binary: Any = Quad(E_BIN, b, result, a, {"kind": E_BIN, "op": TK_PLUS, "left": result, "right": a}, 0);
let adjacentLocal: Any = IRBlock([variable, binary], 3);
ctx.allocation = lsra_allocate(adjacentLocal, [12, 13]);
require(x86_borrow_operand(ctx, adjacentLocal, variable) == true);
require(ctx.allocation.locations[0].borrowed == 8);
ctx.dynamic = 1;
require(x86_borrow_operand(ctx, adjacentLocal, variable) == false);
ctx.dynamic = 0;
let separatedLocal: Any = IRBlock([variable, Quad(IR_LABEL, 0, 0, 0, 50, 0), binary], 3);
ctx.allocation = lsra_allocate(separatedLocal, [12, 13]);
require(x86_borrow_operand(ctx, separatedLocal, variable) == false);
ctx.locals = [];
for direction: Any in [IR_FALSE, IR_TRUE] {
    for op: Any in [TK_EQ, TK_NE, TK_LT, TK_LE, TK_GT, TK_GE] {
        let target: Any = newlab(ctx);
        let compare: Any = Quad(E_BIN, result, a, b, {"kind": E_BIN, "op": op, "left": a, "right": b}, 0);
        let code: Any = [Quad(E_INT, a, 0, 0, {"kind": E_INT, "value": -1}, 0),
            Quad(E_INT, b, 0, 0, {"kind": E_INT, "value": 2}, 0), compare,
            Quad(IR_COPY, unused, result, 0, 0, 0), Quad(direction, 0, result, 0, target, 0)];
        let block: Any = IRBlock(code, 4);
        ctx.allocation = lsra_allocate(block, [12, 13, 14, 15]);
        ctx.allocation.position = 2;
        require(x86_branch_comparison(ctx, block, compare) == 4);
        require(x86_dead_copy(ctx, code[3]) == true);
        ctx.allocation.position = -1; ctx.code.length = 0;
        cg_ir(ctx, block);
        mut condition: Any = x86_comparison_condition(op);
        if direction == IR_FALSE { condition = if condition % 2 == 0 { condition + 1 } else { condition - 1 }; }
        // No materialization or copy after cmp: the last instruction is jcc.
        require(load8(ctx.code.data + ctx.code.length - 6) == 15);
        require(load8(ctx.code.data + ctx.code.length - 5) == condition);
        // An additional user must preserve materialization.
        push(code, Quad(IR_RETURN, 0, result, 0, 0, 0));
        ctx.allocation = lsra_allocate(block, [12, 13, 14, 15]); ctx.allocation.position = 2;
        require(x86_branch_comparison(ctx, block, compare) == -1);
        pop(code);
        // Copy observable through another result must also block fusion.
        push(code, Quad(IR_RETURN, 0, unused, 0, 0, 0));
        ctx.allocation = lsra_allocate(block, [12, 13, 14, 15]); ctx.allocation.position = 2;
        require(x86_branch_comparison(ctx, block, compare) == -1);
        pop(code);
        // Non-SSA definitions retain private homes and cannot be fused.
        push(code, Quad(IR_COPY, result, a, 0, 0, 0));
        ctx.allocation = lsra_allocate(block, [12, 13, 14, 15]); ctx.allocation.position = 2;
        require(ctx.allocation.locations[2].pinned == true);
        require(x86_branch_comparison(ctx, block, compare) == -1);
    }
}
emitter_release(ctx);
print("x86-codegen-ok");
