// Print x86_memory encodings for raw_codegen.py to decode with objdump.
// Each line: base index scale displacement wide hex-bytes.
import "../../src/backend/x86_64.may";
import "../../src/emitter.may";

let ctx: Any = emitter_new({"alignment": 4096, "format": "elf"});
let digits: Any = "0123456789abcdef";
for base: Any in [0, 1, 3, 5, 7, 8, 12, 13, 15] {
    for index: Any in [-1, 0, 5, 7, 8, 12, 13, 15] {
        for scale: Any in [1, 2, 4, 8] {
            if (index < 0 and scale != 1) { continue; }
            for displacement: Any in [0, 1, -1, 127, -128, 128, -129, 2147483647, -2147483648] {
                for wide: Any in [false, true] {
                    ctx.code.length = 0;
                    x86_memory(ctx, wide, [139], 1, base, index, scale, displacement);
                    mut text: Any = "";
                    for offset: Any in 0..ctx.code.length {
                        let byte: Any = load8(ctx.code.data + offset);
                        text = text + digits[byte / 16] + digits[byte % 16];
                    }
                    print("${base} ${index} ${scale} ${displacement} ${wide} ${text}");
                }
            }
        }
    }
}
emitter_release(ctx);
