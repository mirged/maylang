import "../emitter.may";
import "bytes.may";
// ARM64 Mach-O. macOS requires a PIE executable launched through dyld.
// The output must be ad-hoc signed on macOS before executing on Apple Silicon.
let MACH_HEADER_SIZE: Any = 32;
let MACH_SEGMENT_SIZE: Any = 72;
let MACH_THREAD_SIZE: Any = 288;

fun macho_layout(ctx: Any) -> Any {
    // ARM64's native loader requires an inaccessible lower 4 GiB page zero.
    let base: Any = 4294967296;
    let offset: Any = ctx.target.alignment;
    return ImageLayout(base, offset, base + offset, offset + ctx.code.length, base + offset + ctx.code.length, ctx.target.alignment);
}

fun macho_segment(header: Any, name: Any, address: Any, memory: Any, offset: Any, size: Any, protection: Any) -> Any {
    store32(header, 25); store32(header + 4, MACH_SEGMENT_SIZE); // LC_SEGMENT_64
    image_copy(header + 8, addr(name), len(name));
    store64(header + 24, address); store64(header + 32, memory);
    store64(header + 40, offset); store64(header + 48, size);
    store32(header + 56, protection); store32(header + 60, protection);
    return 0;
}

fun build_macho(ctx: Any) -> Any {
    let layout: Any = ctx.layout;
    let roOffset: Any = layout.dataOffset + ctx.rodataOffset;
    let roSize: Any = ctx.data.length - ctx.rodataOffset;
    // Apple's signer requires __LINKEDIT to end exactly at EOF. Reserve an
    // empty, page-aligned segment for codesign_allocate's signature payload.
    let linkeditOffset: Any = image_align(roOffset + roSize, layout.alignment);
    ctx.image.length = linkeditOffset;
    sink_require(ctx.image, ctx.image.length);
    let image: Any = ctx.image.data;
    store32(image, 4277009103); // MH_MAGIC_64
    store32(image + 4, ctx.target.machine); store32(image + 8, 0);
    store32(image + 12, 2); // MH_EXECUTE
    store32(image + 16, 10); store32(image + 20, MACH_SEGMENT_SIZE * 5 + MACH_THREAD_SIZE + 24 + 32 + 56 + 48);
    store32(image + 24, 2097157); // MH_NOUNDEFS | MH_DYLDLINK | MH_PIE
    let commands: Any = image + MACH_HEADER_SIZE;
    macho_segment(commands, "__PAGEZERO", 0, layout.base, 0, 0, 0);
    macho_segment(commands + MACH_SEGMENT_SIZE, "__TEXT", layout.base, layout.dataOffset, 0, layout.dataOffset, 5);
    macho_segment(commands + MACH_SEGMENT_SIZE * 2, "__DATA", layout.dataAddress, ctx.rodataOffset, layout.dataOffset, ctx.rodataOffset, 3);
    macho_segment(commands + MACH_SEGMENT_SIZE * 3, "__CONST", layout.base + roOffset, image_align(roSize, layout.alignment), roOffset, roSize, 1);
    macho_segment(commands + MACH_SEGMENT_SIZE * 4, "__LINKEDIT", layout.base + linkeditOffset, 0, linkeditOffset, 0, 1);
    let thread: Any = commands + MACH_SEGMENT_SIZE * 5;
    store32(thread, 5); store32(thread + 4, MACH_THREAD_SIZE); // LC_UNIXTHREAD
    store32(thread + 8, 6); store32(thread + 12, 68); // ARM_THREAD_STATE64
    store64(thread + 16 + 256, layout.codeAddress);
    // Identify a native macOS 11+ ARM64 executable to the loader and signer.
    let version: Any = thread + MACH_THREAD_SIZE;
    store32(version, 50); store32(version + 4, 24); // LC_BUILD_VERSION
    store32(version + 8, 1); // PLATFORM_MACOS
    store32(version + 12, 720896); store32(version + 16, 720896); // min/sdk 11.0
    let linker: Any = version + 24;
    store32(linker, 14); store32(linker + 4, 32); store32(linker + 8, 12); // LC_LOAD_DYLINKER
    image_copy(linker + 12, addr("/usr/lib/dyld"), 13);
    let library: Any = linker + 32;
    store32(library, 12); store32(library + 4, 56); store32(library + 8, 24); // LC_LOAD_DYLIB
    store32(library + 16, 65536); store32(library + 20, 65536);
    let systemLibrary: Any = "/usr/lib/libSystem.B.dylib";
    image_copy(library + 24, addr(systemLibrary), len(systemLibrary));
    // All references are PC-relative and there are no imported function slots.
    // Explicit empty dyld info avoids its legacy relocation-table fallback.
    let dyldInfo: Any = library + 56;
    store32(dyldInfo, 2147483682); store32(dyldInfo + 4, 48); // LC_DYLD_INFO_ONLY
    image_copy(image + layout.codeOffset, ctx.code.data, ctx.code.length);
    image_copy(image + layout.dataOffset, ctx.data.data, ctx.data.length);
    return 0;
}
