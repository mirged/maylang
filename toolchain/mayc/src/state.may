// state.may — frontend state and host file/source allocation helpers.
//
// Syntax, tokens, symbols and IR use GC-managed structs, maps and lists.
// Raw buffers below own source bytes only. Emission buffers and backend state
// belong to EmissionContext (emitter.may), passed explicitly through stages.

mut ARENA: Any = 0;
mut ARENAP: Any = 0;
mut SRC: Any = 0;
mut SRCLEN: Any = 0;
mut TOKS: Any = [];
mut NTOKS: Any = 0;
mut FUNC_HEAD: Any = [];
mut LOOPB: Any = [];
mut LOOPC: Any = [];
mut IN_FUN: Any = 0;
mut LASTLEN: Any = 0;
mut PARSE_RAW: Any = 0;
mut DYNMODE: Any = 0;
mut RUNTIME_BODY: Any = 0;
mut SOURCE_FILES: Any = {};
mut FOREIGN_DECLS: Any = [];
mut STRICT_TYPES: Any = true;

fun irt_init() -> Any {
    ARENA = syscall(9, 0, 268435456, 3, 34, 0 - 1, 0);
    ARENAP = ARENA;
    return 0;
}

fun irt_alloc(n: Any) -> Any {
    let p: Any = ARENAP;
    mut q: Any = p + n;
    let r: Any = q % 8;
    if (r != 0) { q = q + (8 - r); }
    ARENAP = q;
    return p;
}

fun die(p: Any, n: Any) -> Any {
    syscall(1, 2, p, n);
    syscall(60, 1);
    return 0;
}

// Print a (runtime) string to stderr and exit with failure.
fun die_str(s: Any) -> Any {
    syscall(1, 2, addr(s), len(s));
    syscall(60, 1);
    return 0;
}

// Compare two byte spans.
fun name_eq(p1: Any, l1: Any, p2: Any, l2: Any) -> Any {
    if (l1 != l2) { return 0; }
    mut i: Any = 0;
    while (i < l1) {
        if (load8(p1 + i) != load8(p2 + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Decoded length of a source string literal (span excludes the quotes).
fun declen(s: Any, st: Any, n: Any) -> Any {
    mut i: Any = 0;
    mut c: Any = 0;
    while (i < n) {
        let b: Any = load8(s + st + i);
        if (b == 92) {
            i = i + 2;
        } else {
            i = i + 1;
        }
        c = c + 1;
    }
    return c;
}

// Copy a source string literal into `d`, decoding escapes.
fun decopy(d: Any, s: Any, st: Any, n: Any) -> Any {
    mut i: Any = 0;
    mut o: Any = 0;
    while (i < n) {
        let b: Any = load8(s + st + i);
        if (b == 92) {
            let e: Any = load8(s + st + i + 1);
            mut v: Any = e;
            if (e == 110) {
                v = 10;
            } else if (e == 116) {
                v = 9;
            } else if (e == 114) {
                v = 13;
            } else if (e == 48) {
                v = 0;
            }
            store8(d + o, v);
            o = o + 1;
            i = i + 2;
        } else {
            store8(d + o, b);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

// Read a whole file into a fresh arena buffer; length in LASTLEN.
// `pp` must be NUL-terminated.
fun slurp(pp: Any, pl: Any) -> Any {
    let fd: Any = syscall(2, pp, 0, 0);
    if (fd < 0) {
        LASTLEN = 0;
        return 0;
    }
    let b: Any = irt_alloc(1048576);
    mut off: Any = 0;
    mut r: Any = 1;
    while (r > 0) {
        r = syscall(0, fd, b + off, 1048576 - off);
        if (r > 0) {
            off = off + r;
        }
    }
    syscall(3, fd);
    store8(b + off, 0);
    LASTLEN = off;
    return b;
}
