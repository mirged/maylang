import "sema.may";
import "emitter.may";
import "ffi.may";
import "state.may";
import "ast.may";
import "diagnostics.may";
import "lexer.may";
import "parser.may";
import "symbols.may";
import "platform.may";
// ir.may — linear three-address instructions with explicit control flow.
// Every evaluated value has a virtual temporary. Branches name labels; no
// syntax subtree survives in an instruction's operands.

let IR_TEMP: Any = 300;
let IR_COPY: Any = 301;
let IR_LABEL: Any = 302;
let IR_JUMP: Any = 303;
let IR_FALSE: Any = 304;
let IR_TRUE: Any = 305;
let IR_ISNIL: Any = 306;
let IR_NONNULL: Any = 307;
let IR_BOOL: Any = 308;
let IR_NIL: Any = 309;
let IR_RUNTIME: Any = 310;
let IR_RETURN: Any = 311;
let IR_TRY_BEGIN: Any = 312;
let IR_TRY_END: Any = 313;
let IR_TAILCALL: Any = 314;

struct IRValue { kind: Any, slot: Any, value: Any, start: Any, length: Any, span: Any, next: Any }
struct Quad { op: Any, result: Any, arg1: Any, arg2: Any, extra: Any, span: Any }
struct IRBlock { code: Any, temporaries: Any }
mut IR_CODE: Any = [];
mut IR_TEMPS: Any = 0;
mut IR_BREAKS: Any = [];
mut IR_CONTINUES: Any = [];
mut IR_HANDLERS: Any = 0;
mut IR_MAIN: Any = 0;
mut IR_RAW_MODE: Any = 0;
mut IR_FUNCTION: Any = 0;

fun ir_temp(span: Any) -> Any {
    let result: Any = IRValue(IR_TEMP, IR_TEMPS, 0, 0, 0, span, 0);
    IR_TEMPS = IR_TEMPS + 1;
    return result;
}

fun ir_emit(op: Any, result: Any, a: Any, b: Any, extra: Any, span: Any) -> Any {
    push(IR_CODE, Quad(op, result, a, b, extra, span));
    return result;
}

fun ir_use(value: Any) -> Any {
    return IRValue(value.kind, value.slot, value.value, value.start, value.length, value.span, 0);
}

fun ir_operation(kind: Any, payload: Any, span: Any) -> Any {
    payload.kind = kind;
    payload.span = span;
    return ir_emit(kind, ir_temp(span), 0, 0, payload, span);
}

fun ir_integer(value: Any, span: Any) -> Any {
    let result: Any = ir_operation(E_INT, {"value": value}, span);
    result.kind = E_INT; result.value = value;
    return result;
}

fun ir_nil(span: Any) -> Any { return ir_emit(IR_NIL, ir_temp(span), 0, 0, 0, span); }
fun ir_label(label: Any) -> Any { ir_emit(IR_LABEL, 0, 0, 0, label, 0); return 0; }
fun ir_jump(label: Any) -> Any { ir_emit(IR_JUMP, 0, 0, 0, label, 0); return 0; }
fun ir_copy(target: Any, value: Any) -> Any { ir_emit(IR_COPY, target, value, 0, 0, value.span); return target; }

fun ir_arguments(ctx: Any, head: Any) -> Any {
    mut result: Any = 0;
    mut last: Any = 0;
    mut node: Any = head;
    while (node != 0) {
        let value: Any = ir_use(ir_node(ctx, node));
        if (last == 0) { result = value; } else { last.next = value; }
        last = value;
        node = node.next;
    }
    return result;
}

fun ir_runtime(name: Any, values: Any, span: Any) -> Any {
    mut head: Any = 0;
    mut last: Any = 0;
    for value: Any in values {
        let operand: Any = ir_use(value);
        if (last == 0) { head = operand; } else { last.next = operand; }
        last = operand;
    }
    return ir_emit(IR_RUNTIME, ir_temp(span), head, 0, name, span);
}

fun ir_binary(op: Any, left: Any, right: Any, span: Any) -> Any {
    let payload: Any = {"op": op, "left": left, "right": right, "kind": E_BIN, "span": span};
    return ir_emit(E_BIN, ir_temp(span), left, right, payload, span);
}

fun ir_declare(name: Any, length: Any, value: Any, global: Any, span: Any) -> Any {
    ir_emit(S_LET, 0, value, 0, {"name": name, "length": length, "initializer": value, "global": global}, span);
    return value;
}

fun ir_pattern(pattern: Any, value: Any, global: Any) -> Any {
    mut entry: Any = pattern;
    while (entry != 0) {
        mut key: Any = 0;
        if (entry.patternKind == 0) { key = ir_integer(entry.key, entry.span); }
        else { key = ir_operation(E_STR, {"start": entry.key, "length": entry.keyLength}, entry.span); }
        let item: Any = ir_runtime("rt_index_get", [value, key], entry.span);
        if (entry.name != 0) { ir_declare(entry.name, entry.length, item, global, entry.span); }
        else { ir_pattern(entry.nested, item, global); }
        entry = entry.next;
    }
    return 0;
}

fun ir_unwind(depth: Any) -> Any {
    mut i: Any = IR_HANDLERS;
    while (i > depth) { ir_emit(IR_TRY_END, 0, 0, 0, 0, 0); i = i - 1; }
    return 0;
}

fun ir_loop(ctx: Any, node: Any) -> Any {
    let span: Any = node.span;
    let iterable: Any = ir_node(ctx, node.iterable);
    let count: Any = ir_runtime("rt_len", [iterable], span);
    let index: Any = ir_integer(0, span);
    let top: Any = newlab(ctx); let done: Any = newlab(ctx); let step: Any = newlab(ctx);
    mut result: Any = ir_nil(span);
    if (node.kind == E_COMP) { result = ir_runtime("rt_list_new", [ir_integer(0, span)], span); }
    push(IR_BREAKS, [done, IR_HANDLERS]); push(IR_CONTINUES, [step, IR_HANDLERS]);
    ir_label(top);
    let condition: Any = ir_binary(TK_LT, index, count, span);
    ir_emit(IR_FALSE, 0, condition, 0, done, span);
    let item: Any = ir_runtime("rt_index_get", [iterable, index], span);
    ir_declare(node.name, node.length, item, 0, span);
    if (node.kind == E_COMP) {
        if (node.condition != 0) { ir_emit(IR_FALSE, 0, ir_node(ctx, node.condition), 0, step, span); }
        ir_runtime("rt_push", [result, ir_node(ctx, node.element)], span);
    } else { ir_node(ctx, node.body); }
    ir_label(step);
    ir_copy(index, ir_binary(TK_PLUS, index, ir_integer(1, span), span));
    ir_jump(top); ir_label(done);
    pop(IR_BREAKS); pop(IR_CONTINUES);
    return result;
}

fun ir_node(ctx: Any, node: Any) -> Any {
    if (node == 0) { return ir_nil(0); }
    let kind: Any = node.kind;
    let span: Any = node.span;
    if (kind == E_INT) { return ir_integer(node.value, span); }
    if (kind == E_STR or kind == E_FLOAT) {
        let result: Any = ir_operation(kind, {"start": node.start, "length": node.length}, span);
        result.kind = kind; result.start = node.start; result.length = node.length;
        return result;
    }
    if (kind == E_STRB) { return ir_operation(kind, {"address": node.address, "length": node.length}, span); }
    if (kind == E_VAR) { return ir_operation(kind, {"name": node.name, "length": node.length}, span); }
    if (kind == E_CAPVAR) { return ir_operation(kind, {"index": node.index}, span); }
    if (kind == E_CLOSURE) { return ir_operation(kind, {"label": node.label, "captures": node.captures, "arity": node.arity}, span); }
    if (kind == E_BIN) { return ir_binary(node.op, ir_node(ctx, node.left), ir_node(ctx, node.right), span); }
    if (kind == E_UN) { return ir_operation(kind, {"op": node.op, "operand": ir_node(ctx, node.operand)}, span); }
    if (kind == E_POW) { return ir_operation(kind, {"left": ir_node(ctx, node.left), "right": ir_node(ctx, node.right)}, span); }
    if (kind == E_CALL) {
        return ir_operation(kind, {"name": node.name, "length": node.length, "args": ir_arguments(ctx, node.args)}, span);
    }
    if (kind == E_ICALL) {
        let callee: Any = ir_node(ctx, node.callee);
        let result: Any = ir_copy(ir_temp(span), callee);
        let done: Any = newlab(ctx);
        ir_emit(IR_ISNIL, 0, callee, 0, done, span);
        let args: Any = ir_arguments(ctx, node.args);
        ir_copy(result, ir_operation(kind, {"callee": callee, "args": args}, span));
        ir_label(done);
        return result;
    }
    if (kind == E_AND or kind == E_OR or kind == E_COALESCE) {
        let left: Any = ir_node(ctx, node.left);
        let result: Any = ir_copy(ir_temp(span), left);
        let done: Any = newlab(ctx);
        mut branch: Any = IR_FALSE;
        if (kind == E_OR) { branch = IR_TRUE; }
        if (kind == E_COALESCE) { branch = IR_NONNULL; }
        ir_emit(branch, 0, left, 0, done, span);
        ir_copy(result, ir_node(ctx, node.right));
        ir_label(done);
        if (IR_RAW_MODE == 1 and kind != E_COALESCE) { ir_emit(IR_BOOL, result, result, 0, 0, span); }
        return result;
    }
    if (kind == E_INDEX) {
        return ir_operation(kind, {"object": ir_node(ctx, node.object), "index": ir_node(ctx, node.index)}, span);
    }
    if (kind == E_GET or kind == E_SAFEGET) {
        let object: Any = ir_node(ctx, node.object);
        let result: Any = ir_copy(ir_temp(span), object);
        let done: Any = newlab(ctx);
        if (kind == E_SAFEGET) { ir_emit(IR_ISNIL, 0, object, 0, done, span); }
        ir_copy(result, ir_operation(E_GET, {"object": object, "start": node.start, "length": node.length}, span));
        ir_label(done);
        return result;
    }
    if (kind == E_RANGE) {
        return ir_operation(kind, {"start": ir_node(ctx, node.start), "end": ir_node(ctx, node.end), "inclusive": node.inclusive}, span);
    }
    if (kind == E_LIST) {
        let result: Any = ir_runtime("rt_list_new", [ir_integer(0, span)], span);
        mut item: Any = node.items;
        while (item != 0) {
            if (item.kind == E_SPREAD) { ir_runtime("rt_extend", [result, ir_node(ctx, item.operand)], span); }
            else { ir_runtime("rt_push", [result, ir_node(ctx, item)], span); }
            item = item.next;
        }
        return result;
    }
    if (kind == E_MAP) {
        let result: Any = ir_runtime("rt_map_new", [], span);
        mut entry: Any = node.entries;
        while (entry != 0) {
            if (entry.key == 0) { ir_runtime("rt_merge_into", [result, ir_node(ctx, entry.value)], span); }
            else { ir_runtime("rt_map_set", [result, ir_node(ctx, entry.key), ir_node(ctx, entry.value)], span); }
            entry = entry.next;
        }
        return result;
    }
    if (kind == S_BLOCK) {
        mut result: Any = ir_nil(span);
        mut statement: Any = node.statements;
        while (statement != 0) { result = ir_node(ctx, statement); statement = statement.next; }
        if (node.tail != 0) { result = ir_node(ctx, node.tail); }
        return result;
    }
    if (kind == S_EXPR) { return ir_node(ctx, node.expression); }
    if (kind == S_LET) { return ir_declare(node.name, node.length, ir_node(ctx, node.initializer), node.global, span); }
    if (kind == S_ASSIGN) {
        let value: Any = ir_node(ctx, node.value);
        ir_emit(kind, 0, value, 0, {"name": node.name, "length": node.length, "value": value}, span);
        return value;
    }
    if (kind == S_CASSIGN) {
        let value: Any = ir_node(ctx, node.value);
        ir_emit(kind, 0, value, 0, {"index": node.index, "value": value}, span);
        return value;
    }
    if (kind == S_SETIDX) {
        let object: Any = ir_node(ctx, node.object); let index: Any = ir_node(ctx, node.index);
        mut previous: Any = 0;
        if (node.compound != nil and node.compound != 0) { previous = ir_operation(E_INDEX, {"object": object, "index": index}, span); }
        mut value: Any = ir_node(ctx, node.value);
        if (previous != 0) { value = ir_operation(E_BIN, {"op": node.compound, "left": previous, "right": value}, span); }
        ir_emit(kind, 0, object, index, {"object": object, "index": index, "value": value}, span);
        return value;
    }
    if (kind == S_SETPROP) {
        let object: Any = ir_node(ctx, node.object);
        mut previous: Any = 0;
        if (node.compound != nil and node.compound != 0) { previous = ir_operation(E_GET, {"object": object, "start": node.start, "length": node.length, "span": span}, span); }
        mut value: Any = ir_node(ctx, node.value);
        if (previous != 0) { value = ir_operation(E_BIN, {"op": node.compound, "left": previous, "right": value}, span); }
        ir_emit(kind, 0, object, value, {"object": object, "start": node.start, "length": node.length, "value": value, "span": span}, span);
        return value;
    }
    if (kind == S_DESTRUCT) {
        let value: Any = ir_node(ctx, node.initializer);
        ir_pattern(node.pattern, value, node.global);
        return value;
    }
    if (kind == S_IF) {
        let condition: Any = ir_node(ctx, node.condition);
        let result: Any = ir_copy(ir_temp(span), condition);
        let elseLabel: Any = newlab(ctx); let done: Any = newlab(ctx);
        ir_emit(IR_FALSE, 0, condition, 0, elseLabel, span);
        ir_copy(result, ir_node(ctx, node.thenBranch)); ir_jump(done);
        ir_label(elseLabel);
        if (node.elseBranch != 0) { ir_copy(result, ir_node(ctx, node.elseBranch)); }
        ir_label(done);
        return result;
    }
    if (kind == S_WHILE) {
        let top: Any = newlab(ctx); let done: Any = newlab(ctx);
        push(IR_BREAKS, [done, IR_HANDLERS]); push(IR_CONTINUES, [top, IR_HANDLERS]);
        ir_label(top);
        ir_emit(IR_FALSE, 0, ir_node(ctx, node.condition), 0, done, span);
        ir_node(ctx, node.body); ir_jump(top); ir_label(done);
        pop(IR_BREAKS); pop(IR_CONTINUES);
        return ir_nil(span);
    }
    if (kind == S_FOR or kind == E_COMP) { return ir_loop(ctx, node); }
    if (kind == S_RETURN) {
        ir_return_node(ctx, node.value);
        return ir_nil(span);
    }
    if (kind == S_BREAK or kind == S_CONT) {
        mut target: Any = IR_BREAKS[len(IR_BREAKS) - 1];
        if (kind == S_CONT) { target = IR_CONTINUES[len(IR_CONTINUES) - 1]; }
        ir_unwind(target[1]); ir_jump(target[0]);
        return ir_nil(span);
    }
    if (kind == E_MAY) {
        let catchLabel: Any = newlab(ctx); let done: Any = newlab(ctx); let result: Any = ir_temp(span);
        ir_emit(IR_TRY_BEGIN, 0, 0, 0, catchLabel, span);
        IR_HANDLERS = IR_HANDLERS + 1;
        ir_copy(result, ir_node(ctx, node.body));
        IR_HANDLERS = IR_HANDLERS - 1;
        ir_emit(IR_TRY_END, 0, 0, 0, 0, span); ir_jump(done);
        ir_label(catchLabel); ir_emit(IR_TRY_END, 0, 0, 0, 0, span);
        ir_copy(result, ir_node(ctx, node.fallback)); ir_label(done);
        return result;
    }
    if (kind == E_TRY) {
        let value: Any = ir_node(ctx, node.operand);
        let okKey: Any = ir_operation(E_STRB, {"address": addr("ok"), "length": 2}, span);
        let ok: Any = ir_runtime("rt_map_get", [value, okKey], span);
        let success: Any = newlab(ctx);
        ir_emit(IR_TRUE, 0, ok, 0, success, span);
        ir_unwind(0); ir_emit(IR_RETURN, 0, value, 0, 0, span);
        ir_label(success);
        let valueKey: Any = ir_operation(E_STRB, {"address": addr("value"), "length": 5}, span);
        return ir_runtime("rt_map_get", [value, valueKey], span);
    }
    if (kind == E_MATCH) {
        let subject: Any = ir_node(ctx, node.subject);
        let result: Any = ir_nil(span); let done: Any = newlab(ctx);
        mut arm: Any = node.arms;
        while (arm != 0) {
            let nextArm: Any = newlab(ctx);
            if (arm.patternKind == 1) {
                let test: Any = ir_binary(TK_EQ, subject, ir_node(ctx, arm.pattern), span);
                ir_emit(IR_FALSE, 0, test, 0, nextArm, span);
            } else if (arm.patternKind == 2) { ir_declare(arm.pattern, arm.length, subject, 0, span); }
            else if (arm.patternKind == 3) {
                let key: Any = if (arm.resultPattern) { "ok" } else { "tag" };
                let actual: Any = ir_runtime("rt_map_get", [subject, ir_operation(E_STRB, {"address": addr(key), "length": len(key)}, span)], span);
                mut expected: Any = 0;
                if (arm.resultPattern) {
                    let name: Any = if (arm.variantTag == "Ok") { "true" } else { "false" };
                    expected = ir_operation(E_VAR, {"name": addr(name), "length": len(name)}, span);
                } else { expected = ir_operation(E_STRB, {"address": addr(arm.variantTag), "length": len(arm.variantTag)}, span); }
                ir_emit(IR_FALSE, 0, ir_binary(TK_EQ, actual, expected, span), 0, nextArm, span);
                for binding: Any in arm.nested {
                    if (binding.name != 0) {
                        let field: Any = ir_operation(E_STRB, {"address": addr(binding.fieldName), "length": len(binding.fieldName)}, binding.span);
                        ir_declare(binding.name, binding.length, ir_runtime("rt_map_get", [subject, field], span), 0, binding.span);
                    }
                }
            }
            if (arm.guard != 0) { ir_emit(IR_FALSE, 0, ir_node(ctx, arm.guard), 0, nextArm, span); }
            ir_copy(result, ir_node(ctx, arm.body)); ir_jump(done); ir_label(nextArm);
            arm = arm.next;
        }
        ir_label(done); return result;
    }
    diagnostic(span, "unsupported syntax in IR lowering");
    return 0;
}

fun ir_begin(raw: Any) -> Any {
    IR_CODE = []; IR_TEMPS = 0; IR_BREAKS = []; IR_CONTINUES = []; IR_HANDLERS = 0; IR_RAW_MODE = raw;
    return 0;
}

// A tail self-call rebinds parameters and jumps to the body. Captured
// parameters must keep their cells alive, so those functions are excluded.
fun ir_return_node(ctx: Any, node: Any) -> Any {
    if (node != 0) {
        if (node.kind == S_BLOCK) {
            mut statement: Any = node.statements;
            while (statement != 0) {
                if (statement.next == 0 and node.tail == 0) { return ir_return_node(ctx, statement); }
                ir_node(ctx, statement);
                statement = statement.next;
            }
            return ir_return_node(ctx, node.tail);
        }
        if (node.kind == S_EXPR) { return ir_return_node(ctx, node.expression); }
        if (node.kind == S_RETURN) { return ir_return_node(ctx, node.value); }
        if (node.kind == S_IF and node.elseBranch != 0) {
            let elseLabel: Any = newlab(ctx);
            ir_emit(IR_FALSE, 0, ir_node(ctx, node.condition), 0, elseLabel, node.span);
            ir_return_node(ctx, node.thenBranch);
            ir_label(elseLabel);
            return ir_return_node(ctx, node.elseBranch);
        }
        if (node.kind == E_CALL and IR_FUNCTION != 0 and IR_HANDLERS == 0) {
            let rec: Any = IR_FUNCTION;
            if (rec.cc == 0 and len(rec.boxed) == 0 and name_eq(node.name, node.length, rec.p, rec.l) == 1) {
                mut count: Any = 0;
                mut arg: Any = node.args;
                while (arg != 0) { count = count + 1; arg = arg.next; }
                if (count == rec.pc) {
                    ir_emit(IR_TAILCALL, 0, ir_arguments(ctx, node.args), 0, 0, node.span);
                    return 0;
                }
            }
        }
    }
    let value: Any = ir_node(ctx, node);
    ir_unwind(0);
    ir_emit(IR_RETURN, 0, value, 0, 0, value.span);
    return 0;
}

fun ir_program(ctx: Any) -> Any {
    glob_scan(ctx, RUNTIME_BODY); glob_scan(ctx, MAINBODY);
    ffi_prepare(ctx);
    platform_prepare(ctx);
    ctx.globalBytes = ctx.data.length;
    ctx.rodataOffset = ((ctx.data.length / ctx.target.alignment) + 1) * ctx.target.alignment;
    sink_require(ctx.data, ctx.rodataOffset);
    ctx.data.length = ctx.rodataOffset;
    ir_begin(1 - DYNMODE);
    IR_FUNCTION = 0;
    mut statement: Any = MAINBODY;
    while (statement != 0) { ir_node(ctx, statement); statement = statement.next; }
    IR_MAIN = IRBlock(IR_CODE, IR_TEMPS);
    // All declarations are checked earlier. Lower only functions reachable
    // through calls or function values; retain raw runtime and FFI entrypoints
    // for backend-generated calls which do not occur explicitly in source IR.
    let names: Any = {}; let labels: Any = [];
    let live: Any = []; let queue: Any = [];
    for index: Any in 0..len(ctx.labels) { push(labels, 0); push(live, false); }
    for rec: Any in FUNC_HEAD { names[symbol_name(rec.p, rec.l)] = rec; labels[rec.lab] = rec; }
    for rec: Any in FUNC_HEAD {
        if (rec.mode == 1 or rec.foreign == true or symbol_name(rec.p, rec.l) == "str") { ir_reachable(rec, live, queue); }
    }
    ir_dependencies(IR_MAIN, names, labels, live, queue);
    mut next: Any = 0;
    while (next < len(queue)) {
        let rec: Any = queue[next]; next += 1;
        mut raw: Any = rec.mode;
        if (DYNMODE == 0) { raw = 1; }
        ir_begin(raw);
        IR_FUNCTION = rec;
        ir_return_node(ctx, rec.body);
        rec.ir = IRBlock(IR_CODE, IR_TEMPS);
        ir_dependencies(rec.ir, names, labels, live, queue);
    }
    // Snapshot the emission inputs. Backend-private ABI labels live in copied
    // records, so separate contexts can emit this unit without mutating its AST.
    ctx.mainIR = IR_MAIN; ctx.dynamic = DYNMODE; ctx.mainBoxed = main_boxed();
    ctx.functions = []; ctx.foreign = [];
    for rec: Any in FUNC_HEAD {
        if (not live[rec.lab]) { continue; }
        let emitted: Any = {"p": rec.p, "l": rec.l, "pc": rec.pc, "parr": rec.parr,
            "ir": rec.ir, "mode": rec.mode, "lab": rec.lab, "abiLab": 0,
            "cc": rec.cc, "boxed": rec.boxed, "caparr": rec.caparr,
            "foreign": rec.foreign, "ffiArgs": rec.ffiArgs, "ffiResult": rec.ffiResult,
            "ffiSlot": rec.ffiSlot, "library": rec.library, "symbol": rec.symbol};
        push(ctx.functions, emitted);
        ctx.functionIndex[symbol_name(rec.p, rec.l)] = emitted;
        if (rec.foreign == true) { push(ctx.foreign, emitted); }
    }
    return 0;
}

fun ir_reachable(rec: Any, live: Any, queue: Any) -> Any {
    if (rec != 0 and rec != nil and not live[rec.lab]) { live[rec.lab] = true; push(queue, rec); }
    return 0;
}

fun ir_dependencies(block: Any, names: Any, labels: Any, live: Any, queue: Any) -> Any {
    for instruction: Any in block.code {
        if (instruction.op == E_CALL or instruction.op == E_VAR) {
            ir_reachable(names[symbol_name(instruction.extra.name, instruction.extra.length)], live, queue);
        } else if (instruction.op == E_CLOSURE) { ir_reachable(labels[instruction.extra.label], live, queue); }
    }
    return 0;
}

fun glob_scan_pattern(ctx: Any, p: Any) -> Any {
    mut cur: Any = p;
    while (cur != 0) {
        if (cur.name != 0) {
            if (glob_find(ctx, cur.name, cur.length) < 0) {
                glob_add(ctx, cur.name, cur.length);
            }
        }
        if (cur.nested != 0) { glob_scan_pattern(ctx, cur.nested); }
        cur = cur.next;
    }
    return 0;
}

fun glob_scan(ctx: Any, s: Any) -> Any {
    while (s != 0) {
        if (s.kind == S_LET) {
            if (s.global == 1) {
                glob_add(ctx, s.name, s.length);
            }
        }
        if (s.kind == S_DESTRUCT) {
            if (s.global == 1) { glob_scan_pattern(ctx, s.pattern); }
        }
        s = s.next;
    }
    return 0;
}
