import "state.may";
import "ast.may";
import "sema.may";
// Module loading, canonical paths, and import metadata.
mut EXPAND_SEEN: Any = {};
mut EXPAND_ORIGINS: Any = [];
mut MODULE_IMPORTS: Any = {};

// Keep source spelling intact; semantic resolution handles module aliases.
fun emit_line(t: Any, ls: Any, le: Any, buf: Any, off: Any) -> Any {
    mut i: Any = ls;
    while (i < le) { store8(buf + off, load8(t + i)); off += 1; i += 1; }
    store8(buf + off, 10);
    return off + 1;
}

fun module_path(path: Any) -> Any {
    let parts: Any = split(path, "/");
    let clean: Any = [];
    for part: Any in parts {
        if (part == ".." and len(clean) > 0 and clean[len(clean) - 1] != "..") { pop(clean); }
        else if (part != "." and part != "") { push(clean, part); }
    }
    let prefix: Any = if (starts_with(path, "/")) { "/" } else { "" };
    return prefix + join(clean, "/");
}

fun register_import(owner: Any, target: Any, text: Any, start: Any, end: Any, quote: Any) -> Any {
    let tail: Any = trim(symbol_name(text + quote + 1, end - quote - 1));
    let line: Any = trim(symbol_name(text + start, end - start));
    mut alias: Any = "";
    mut selected: Any = [];
    mut plain: Any = true;
    if (starts_with(tail, "as ")) {
        alias = trim(replace(substring(tail, 3, len(tail) - 3), ";", ""));
        plain = false;
    } else if (starts_with(line, "from ")) {
        let names: Any = trim(replace(substring(tail, 7, len(tail) - 7), ";", ""));
        for name: Any in split(names, ",") { push(selected, trim(name)); }
    } else {
        let parts: Any = split(target, "/");
        alias = replace(parts[len(parts) - 1], ".may", "");
    }
    push(MODULE_IMPORTS[owner], {"path": target, "alias": alias, "plain": plain, "selected": selected});
    return 0;
}

fun hash(pp: Any, pl: Any) -> Any {
    mut h: Any = 5381;
    mut i: Any = 0;
    while (i < pl) {
        h = (h * 131 + load8(pp + i)) % 2147483647;
        i = i + 1;
    }
    return h;
}

fun import_line(t: Any, ls: Any, le: Any) -> Any {
    mut i: Any = ls;
    while (i < le) {
        let b: Any = load8(t + i);
        if (b == 32  or  b == 9) { i = i + 1; } else { break; }
    }
    if (le - i < 4) { return 0; }
    if (name_eq(t + i, 6, addr("import"), len("import")) == 1) { return 1; }
    if (name_eq(t + i, 4, addr("from"), len("from")) == 1) { return 1; }
    return 0;
}

fun findq(t: Any, ls: Any, le: Any, which: Any) -> Any {
    mut i: Any = ls;
    if (which == 0) {
        while (i < le) {
            if (load8(t + i) == 34) { return i; }
            i = i + 1;
        }
    } else {
        mut last: Any = 0 - 1;
        while (i < le) {
            if (load8(t + i) == 34) { last = i; }
            i = i + 1;
        }
        return last;
    }
    return 0 - 1;
}

fun file_ok(p: Any) -> Any {
    let fd: Any = syscall(2, p, 0, 0);
    if (fd < 0) { return 0; }
    syscall(3, fd);
    return 1;
}

fun append_file(pp: Any, pl: Any, buf: Any, off: Any) -> Any {
    mut canonical: Any = module_path(symbol_name(pp, pl));

    // 1. If it's a stdlib module that doesn't exist in local CWD, make it absolute FIRST!
    if (starts_with(canonical, "stdlib/") and file_ok(addr(canonical)) == 0) {
        canonical = "/home/mirged/Projects/maylang/" + canonical;
    }

    // 2. Now register it under the final, correct canonical path!
    if (has(EXPAND_SEEN, canonical)) { return off; }
    EXPAND_SEEN[canonical] = true;
    MODULE_IMPORTS[canonical] = [];

    pp = addr(canonical);
    pl = len(canonical);
    let text: Any = slurp(pp, pl);
    let tn: Any = LASTLEN;

    if (text == 0) { die_str("mayc: cannot read ${symbol_name(pp, pl)}\n"); }

    let sourcePath: Any = canonical;
    mut sourceLine: Any = 1;
    mut dl: Any = 0;
    mut k: Any = 0;
    while (k < pl) {
        if (load8(pp + k) == 47) { dl = k + 1; } // '/'
        k = k + 1;
    }
    mut i: Any = 0;
    while (i < tn) {
        let ls: Any = i;
        while (i < tn) {
            if (load8(text + i) == 10) { break; } // '\n'
            i = i + 1;
        }
        let le: Any = i;
        if (import_line(text, ls, le) == 1) {
            let q1: Any = findq(text, ls, le, 0);
            let q2: Any = findq(text, ls, le, 1);
            let nl: Any = q2 - q1 - 1;
            let fp: Any = irt_alloc(pl + nl + 8);
            mut j: Any = 0;
            while (j < dl) {
                store8(fp + j, load8(pp + j));
                j = j + 1;
            }
            j = 0;
            while (j < nl) {
                store8(fp + dl + j, load8(text + q1 + 1 + j));
                j = j + 1;
            }
            mut fileLength: Any = dl + nl;
            mut hasExtension: Any = 0;
            j = 0;
            while (j < nl) {
                if (load8(text + q1 + 1 + j) == 46) { hasExtension = 1; } // '.'
                j = j + 1;
            }
            if (hasExtension == 0) {
                store8(fp + fileLength, 46); store8(fp + fileLength + 1, 109);
                store8(fp + fileLength + 2, 97); store8(fp + fileLength + 3, 121); // ".may"
                fileLength = fileLength + 4;
            }
            store8(fp + fileLength, 0);
            if (file_ok(fp) == 0) {
                let sp: Any = irt_alloc(nl + 16);
                store8(sp + 0, 115);
                store8(sp + 1, 116);
                store8(sp + 2, 100);
                store8(sp + 3, 108);
                store8(sp + 4, 105);
                store8(sp + 5, 98);
                store8(sp + 6, 47); // "stdlib/"
                mut q: Any = 0;
                while (q < nl) {
                    store8(sp + 7 + q, load8(text + q1 + 1 + q));
                    q = q + 1;
                }
                store8(sp + 7 + nl, 0);
                let fallback: Any = "stdlib/" + symbol_name(text + q1 + 1, nl) + if (hasExtension == 0) { ".may" } else { "" };
                register_import(sourcePath, module_path(fallback), text, ls, le, q2);
                off = append_file(addr(fallback), len(fallback), buf, off);
            } else {
                register_import(sourcePath, module_path(symbol_name(fp, fileLength)), text, ls, le, q2);
                off = append_file(fp, fileLength, buf, off);
            }
        } else {
            push(EXPAND_ORIGINS, SourceOrigin(off, sourcePath, sourceLine));
            off = emit_line(text, ls, le, buf, off);
        }
        i = i + 1;
        sourceLine = sourceLine + 1;
    }
    return off;
}

fun expand(pp: Any, pl: Any) -> Any {
    EXPAND_SEEN = {};
    MODULE_IMPORTS = {};
    EXPAND_ORIGINS = [];
    let buf: Any = irt_alloc(4194304);
    let off: Any = append_file(pp, pl, buf, 0);
    SRC = buf;
    SRCLEN = off;
    SOURCE_FILES[buf] = SourceFile(symbol_name(pp, pl), EXPAND_ORIGINS);
    return 0;
}
