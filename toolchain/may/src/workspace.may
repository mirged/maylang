import "../../maypkg/src/fs.may" as fs;
import "process.may" as proc;

pub fun absolute(root: Str, path: Str) -> Str {
    return fs.normpath(if (starts_with(path, "/")) { path } else { fs.join_path(root, path) });
}
fun strings(value: Any, label: Str) -> List<Str> {
    if (type(value) != "List") { fail("may: " + label + " must be an array of strings"); }
    let result: List<Str> = [];
    for item: Any in value {
        if (type(item) != "Str") { fail("may: " + label + " must contain strings"); }
        push(result, item);
    }
    return result;
}
pub fun valid_name(name: Str) -> Bool {
    if (name == "") { return false; }
    for c: Str in chars(name) {
        if (not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_" or c == "-")) { return false; }
    }
    return true;
}
fun fields(value: Any, allowed: List<Str>, label: Str) -> Nil {
    if (type(value) != "Map") { fail("may: " + label + " must be an object"); }
    for name: Str in keys(value) { if (not has(allowed, name)) { fail("may: unknown " + label + " field: " + name); } }
    return;
}
fun visit_target(config: Any, name: Str, seen: Any, stack: List<Str>) -> Nil {
    if (has(stack, name)) { fail("may: target cycle: " + join(stack + [name], " -> ")); }
    if (has(seen, name)) { return; }
    push(stack, name);
    for dependency: Str in config.targets[name].depends { visit_target(config, dependency, seen, stack); }
    pop(stack); seen[name] = true; return;
}
pub fun load() -> Any {
    mut root: Str = fs.cwd(); mut found: Bool = false;
    for depth: Int in 0..64 {
        if (file_exists(root + "/may.json")) { found = true; break; }
        let parent: Str = fs.dirname(root);
        if (parent == root) { break; }
        root = parent;
    }
    if (not found) { fail("may: no may.json found; use may new or may migrate"); }
    let config: Any = json_parse(read_file(root + "/may.json"));
    fields(config, ["schema", "name", "default", "compiler", "targets", "dependencies", "profiles"], "workspace");
    if (config.schema != 1 or type(config.name) != "Str" or config.name == "") { fail("may: workspace requires schema 1 and a name"); }
    if (type(config.targets) != "Map" or len(keys(config.targets)) == 0 or len(keys(config.targets)) > 128) { fail("may: targets must contain 1 to 128 named targets"); }
    config.dependencies = config.dependencies ?? ({});
    if (type(config.dependencies) != "Map") { fail("may: dependencies must be an object"); }
    config.profiles = config.profiles ?? ({"dev": {"flags": ["--debug"]}, "release": {"flags": []}});
    if (type(config.profiles) != "Map") { fail("may: profiles must be an object"); }
    for name: Str in keys(config.profiles) {
        if (not valid_name(name)) { fail("may: invalid profile name: " + name); }
        fields(config.profiles[name], ["flags"], "profile");
        config.profiles[name].flags = strings(config.profiles[name].flags ?? [], "profile flags");
    }
    for name: Str in keys(config.targets) {
        if (not valid_name(name)) { fail("may: invalid target name: " + name); }
        let spec: Any = config.targets[name];
        fields(spec, ["kind", "entry", "root", "depends", "inputs", "outputs", "command", "target", "runtime", "flags"], "target " + name);
        if (not has(["app", "test", "native", "task"], spec.kind)) { fail("may: target kind must be app, test, native or task: " + name); }
        spec.depends = strings(spec.depends ?? [], "target depends");
        spec.flags = strings(spec.flags ?? [], "target flags");
        spec.inputs = strings(spec.inputs ?? [], "target inputs");
        spec.outputs = strings(spec.outputs ?? [], "target outputs");
        spec.target = spec.target ?? "x86_64-linux"; spec.runtime = spec.runtime ?? "full";
        if (type(spec.target) != "Str" or type(spec.runtime) != "Str") { fail("may: target/runtime must be strings"); }
        if (spec.kind == "app" and (type(spec.entry) != "Str" or spec.entry == "")) { fail("may: app target needs an entry: " + name); }
        if (spec.kind == "test" and (type(spec.root) != "Str" or spec.root == "")) { fail("may: test target needs a root directory: " + name); }
        if (spec.kind == "native" or spec.kind == "task") {
            spec.command = strings(spec.command, "target command");
            if (len(spec.command) == 0) { fail("may: command cannot be empty: " + name); }
            if (spec.kind == "native" and len(spec.outputs) == 0) { fail("may: native target must declare outputs: " + name); }
        }
        for output: Str in spec.outputs {
            if (output == "" or has([".", "..", "artifact.json", "output-hashes"], output) or contains(output, "/")) { fail("may: outputs must be unreserved file names: " + name); }
        }
        for dependency: Str in spec.depends {
            if (not has(config.targets, dependency)) { fail("may: unknown target dependency: " + dependency); }
        }
    }
    let validated: Any = {};
    for name: Str in keys(config.targets) { visit_target(config, name, validated, []); }
    config.default = config.default ?? keys(config.targets)[0];
    if (type(config.default) != "Str" or not has(config.targets, config.default)) { fail("may: default must name a target"); }
    let chosen: Str = config.compiler ?? env("MAYC") ?? "";
    mut compiler_path: Str = chosen;
    if (chosen == "") {
        let adjacent: Str = fs.dirname(absolute(fs.cwd(), args()[0])) + "/mayc";
        compiler_path = if (file_exists(adjacent)) { adjacent } else { "mayc" };
    } else if (contains(chosen, "/")) { compiler_path = absolute(root, chosen); }
    compiler_path = proc.executable(compiler_path);
    fs.use_compiler(compiler_path, root);
    let stdlib: Str = fs.stdlib_path();
    if (stdlib == "") { fail("may: cannot locate stdlib beside the selected compiler; set MAYLANG_STDLIB"); }
    return {"root": root, "config": config, "compiler": compiler_path, "stdlib": stdlib, "module_paths": [stdlib], "built": {}, "visiting": [], "profile": "dev"};
}
fun scan_files(path: Str, depth: Int, output: List<Str>) -> Nil {
    if (depth > 32) { fail("may: directory nesting exceeds 32: " + path); }
    let descriptor: Int = syscall(2, cstr(path), 589824, 0);
    if (descriptor < 0) { push(output, path); return; }
    syscall(3, descriptor);
    let entries: List<Str> = read_dir(path);
    for name: Str in sort(entries) {
        if (starts_with(name, ".") or has(["build", "target", "node_modules"], name)) { continue; }
        scan_files(path + "/" + name, depth + 1, output);
    }
    return;
}
pub fun files(path: Str) -> List<Str> {
    if (not file_exists(path)) { fail("may: input does not exist: " + path); }
    let result: List<Str> = []; scan_files(path, 0, result); return result;
}
mut DIGEST_COUNTER: Int = 0;
pub fun digest(ws: Any, inputs: List<Str>, salt: Str) -> Str {
    fs.mkdirs(ws.root + "/.may/tmp"); DIGEST_COUNTER += 1;
    let temporary: Str = ws.root + "/.may/tmp/hash-" + str(syscall(39)) + "-" + str(DIGEST_COUNTER);
    let command: List<Str> = ["sha256sum", "--zero", "--"];
    for path: Str in sort(inputs) { push(command, path); }
    mut content: Str = salt;
    if (len(inputs) > 0) {
        if (proc.capture(command, ws.root, [], temporary) != 0) { fail("may: cannot hash build inputs"); }
        content += read_file(temporary);
    }
    write_file(temporary, content);
    if (proc.capture(["sha256sum", "--zero", "--", temporary], ws.root, [], temporary + ".result") != 0) { fail("may: cannot compute build identity"); }
    let hash: Str = substring(read_file(temporary + ".result"), 0, 64);
    syscall(87, cstr(temporary)); syscall(87, cstr(temporary + ".result"));
    return hash;
}
pub fun dependency_state(ws: Any) -> Any {
    let result: Any = {}; ws.module_paths = [];
    for name: Str in sort(keys(ws.config.dependencies)) {
        if (not valid_name(name)) { fail("may: invalid dependency name: " + name); }
        let dependency: Any = ws.config.dependencies[name];
        fields(dependency, ["path", "modules"], "dependency " + name);
        if (type(dependency.path) != "Str" or dependency.path == "") { fail("may: dependencies need explicit local paths: " + name); }
        let path: Str = absolute(ws.root, dependency.path);
        let modules: Str = absolute(path, dependency.modules ?? ".");
        if (not file_exists(modules)) { fail("may: dependency module directory missing: " + name); }
        DIGEST_COUNTER += 1; fs.mkdirs(ws.root + "/.may/tmp");
        let temporary: Str = ws.root + "/.may/tmp/dependency-" + str(syscall(39)) + "-" + str(DIGEST_COUNTER);
        let command: List<Str> = ["sha256sum", "--zero", "--"];
        for file: Str in files(path) { push(command, substring(file, len(path) + 1, len(file) - len(path) - 1)); }
        if (len(command) > 3) {
            if (proc.capture(command, path, [], temporary) != 0) { fail("may: cannot hash dependency: " + name); }
        } else { write_file(temporary, ""); }
        let content: Str = name + "\n" + read_file(temporary);
        write_file(temporary, content);
        if (proc.capture(["sha256sum", "--zero", "--", temporary], ws.root, [], temporary + ".result") != 0) { fail("may: cannot hash dependency identity"); }
        let hash: Str = substring(read_file(temporary + ".result"), 0, 64);
        syscall(87, cstr(temporary)); syscall(87, cstr(temporary + ".result"));
        result[name] = {"path": fs.normpath(dependency.path), "modules": fs.normpath(dependency.modules ?? "."), "sha256": hash};
        push(ws.module_paths, modules);
    }
    push(ws.module_paths, ws.stdlib);
    return result;
}
pub fun lock(ws: Any) -> Nil {
    fs.write_atomic(ws.root + "/may.lock", json_stringify({"schema": 1, "dependencies": dependency_state(ws)}) + "\n");
    print("locked", len(keys(ws.config.dependencies)), "local dependencies"); return;
}
pub fun verify_dependencies(ws: Any) -> Nil {
    let actual: Any = dependency_state(ws);
    if (len(keys(actual)) == 0) { return; }
    if (not file_exists(ws.root + "/may.lock")) { fail("may: missing may.lock; run may lock"); }
    let pinned: Any = json_parse(read_file(ws.root + "/may.lock"));
    if (pinned.schema != 1 or json_stringify(pinned.dependencies) != json_stringify(actual)) { fail("may: local dependencies changed; review them and run may lock"); }
    return;
}
