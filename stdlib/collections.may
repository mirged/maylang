// collections.may — stacks, queues and sets built from lists and maps.
//
// A stack is a `List<T>` whose end is the top. A queue is two stacks,
// `[inbox, outbox]`: pushes go to the inbox and pops drain the outbox, which is
// refilled from the reversed inbox, so each element moves once. A set is a
// `Map<T, Bool>`. Annotate the constructor's result, for example
// `let st: List<Int> = stack();`.

// --- Stack (LIFO) ---------------------------------------------------------

/// Create an empty stack.
fun stack<T>() -> List<T> { let items: List<T> = []; return items; }

/// Push `value` onto `st` and return it.
fun stack_push<T>(st: List<T>, value: T) -> List<T> { push(st, value); return st; }

/// Pop the top of `st`, or `nil` when empty.
fun stack_pop<T>(st: List<T>) -> Optional<T> {
    if (len(st) == 0) { return nil; }
    return pop(st);
}

/// Return the top of `st` without removing it, or `nil` when empty.
fun stack_peek<T>(st: List<T>) -> Optional<T> {
    if (len(st) == 0) { return nil; }
    return st[len(st) - 1];
}

/// Count the items on `st`.
fun stack_size<T>(st: List<T>) -> Int { return len(st); }

/// Report whether `st` is empty.
fun stack_empty<T>(st: List<T>) -> Bool { return len(st) == 0; }

// --- Queue (FIFO) ---------------------------------------------------------

/// Create an empty queue.
fun queue<T>() -> List<List<T>> {
    let inbox: List<T> = [];
    let outbox: List<T> = [];
    return [inbox, outbox];
}

/// Enqueue `value`.
fun queue_push<T>(q: List<List<T>>, value: T) -> List<List<T>> { push(q[0], value); return q; }

/// Dequeue the oldest value, or `nil` when empty.
fun queue_pop<T>(q: List<List<T>>) -> Optional<T> {
    let inbox: List<T> = q[0];
    let outbox: List<T> = q[1];
    let empty: List<T> = [];
    if (len(outbox) == 0) {
        mut i: Int = len(inbox) - 1;
        while (i >= 0) { push(outbox, inbox[i]); i -= 1; }
        q[0] = empty;
    }
    if (len(outbox) == 0) { return nil; }
    return pop(outbox);
}

/// Count the queued items.
fun queue_size<T>(q: List<List<T>>) -> Int { return len(q[0]) + len(q[1]); }

/// Report whether `q` is empty.
fun queue_empty<T>(q: List<List<T>>) -> Bool { return queue_size(q) == 0; }

// --- Set ------------------------------------------------------------------

/// Create an empty set.
fun set_new<T>() -> Map<T, Bool> { let members: Map<T, Bool> = {}; return members; }

/// Add `value` to `s` and return it.
fun set_add<T>(s: Map<T, Bool>, value: T) -> Map<T, Bool> { s[value] = true; return s; }

/// Report whether `value` is in `s`.
fun set_has<T>(s: Map<T, Bool>, value: T) -> Bool { return has(s, value); }

/// Return a copy of `s` without `value`.
fun set_remove<T>(s: Map<T, Bool>, value: T) -> Map<T, Bool> {
    let out: Map<T, Bool> = {};
    for key: T in keys(s) { if (key != value) { out[key] = true; } }
    return out;
}

/// Return the members of `s` in sorted order.
fun set_values<T>(s: Map<T, Bool>) -> List<T> { return sort(keys(s)); }

/// Count the members of `s`.
fun set_size<T>(s: Map<T, Bool>) -> Int { return len(keys(s)); }

/// Return the union of two sets.
fun set_union<T>(a: Map<T, Bool>, b: Map<T, Bool>) -> Map<T, Bool> {
    let out: Map<T, Bool> = {};
    for key: T in keys(a) { out[key] = true; }
    for key: T in keys(b) { out[key] = true; }
    return out;
}

/// Return the intersection of two sets.
fun set_intersect<T>(a: Map<T, Bool>, b: Map<T, Bool>) -> Map<T, Bool> {
    let out: Map<T, Bool> = {};
    for key: T in keys(a) {
        if (has(b, key)) { out[key] = true; }
    }
    return out;
}

/// Return the elements in `a` but not in `b`.
fun set_difference<T>(a: Map<T, Bool>, b: Map<T, Bool>) -> Map<T, Bool> {
    let out: Map<T, Bool> = {};
    for key: T in keys(a) {
        if (!has(b, key)) { out[key] = true; }
    }
    return out;
}
