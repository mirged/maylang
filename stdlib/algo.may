// algo.may — classic algorithms over lists.

/// Sort a list with a quicksort (pivot = first element). Returns a new list.
fun quick_sort<T>(xs: List<T>) -> List<T> {
    if (len(xs) <= 1) { return xs; }
    let pivot: T = xs[0];
    let less: List<T> = [];
    let equal: List<T> = [];
    let more: List<T> = [];
    for x: T in xs {
        if (x < pivot) { push(less, x); }
        else if (x > pivot) { push(more, x); }
        else { push(equal, x); }
    }
    return quick_sort(less) + equal + quick_sort(more);
}

/// Sort a list with a stable merge sort. Returns a new list.
fun merge_sort<T>(xs: List<T>) -> List<T> {
    let n: Int = len(xs);
    if (n <= 1) { return xs; }
    let mid: Int = n / 2;
    let left: List<T> = [xs[i] for i: Int in 0..mid];
    let right: List<T> = [xs[i] for i: Int in mid..n];
    return merge_sorted(merge_sort(left), merge_sort(right));
}

/// Merge two already-sorted lists into one sorted list.
fun merge_sorted<T>(a: List<T>, b: List<T>) -> List<T> {
    let out: List<T> = [];
    mut i: Int = 0;
    mut j: Int = 0;
    while (i < len(a) && j < len(b)) {
        if (a[i] <= b[j]) { push(out, a[i]); i = i + 1; }
        else { push(out, b[j]); j = j + 1; }
    }
    while (i < len(a)) { push(out, a[i]); i = i + 1; }
    while (j < len(b)) { push(out, b[j]); j = j + 1; }
    return out;
}

/// Return the index of `target` in a sorted list, or `-1`.
fun binary_search<T>(sorted: List<T>, target: T) -> Int {
    mut lo: Int = 0;
    mut hi: Int = len(sorted) - 1;
    while (lo <= hi) {
        let mid: Int = (lo + hi) / 2;
        if (sorted[mid] == target) { return mid; }
        if (sorted[mid] < target) { lo = mid + 1; } else { hi = mid - 1; }
    }
    return -1;
}

/// Remove duplicates, preserving the order of first appearance.
fun dedupe<T>(xs: List<T>) -> List<T> {
    let seen: Map<T, Bool> = {};
    let out: List<T> = [];
    for x: T in xs {
        if (!has(seen, x)) {
            seen[x] = true;
            push(out, x);
        }
    }
    return out;
}

// The pairs stay `List<Any>`: the language has no tuple values or generic
// structs, and the two lists may hold different element types.
/// Pair up the elements of two lists, stopping at the shorter one.
fun zip<A, B>(a: List<A>, b: List<B>) -> List<List<Any>> {
    let out: List<List<Any>> = [];
    for i: Int in 0..min(len(a), len(b)) {
        let pair: List<Any> = [a[i], b[i]];
        push(out, pair);
    }
    return out;
}

/// Concatenate a list of lists into a single list.
fun flatten<T>(xss: List<List<T>>) -> List<T> {
    let out: List<T> = [];
    for xs: List<T> in xss { for x: T in xs { push(out, x); } }
    return out;
}

/// Return the list `[a, a+1, ..., b-1]`.
fun range_list(a: Int, b: Int) -> List<Int> { return [i for i: Int in a..b]; }

/// Return the first `n` elements, or all of them when there are fewer.
fun take<T>(xs: List<T>, n: Int) -> List<T> { return [xs[i] for i: Int in 0..max(0, min(n, len(xs)))]; }

/// Drop the first `n` elements.
fun drop<T>(xs: List<T>, n: Int) -> List<T> { return [xs[i] for i: Int in max(0, n)..len(xs)]; }

/// Split a list into consecutive groups of `size`.
fun chunk<T>(xs: List<T>, size: Int) -> List<List<T>> {
    if (size <= 0) { fail("chunk size must be positive"); }
    let out: List<List<T>> = [];
    mut i: Int = 0;
    while (i < len(xs)) {
        let part: List<T> = [];
        mut j: Int = i;
        while (j < i + size && j < len(xs)) { push(part, xs[j]); j = j + 1; }
        push(out, part);
        i = i + size;
    }
    return out;
}

/// Split a list into `[matching, non-matching]` by `pred`.
fun partition<T>(xs: List<T>, pred: (T) -> Bool) -> List<List<T>> {
    let matching: List<T> = [];
    let rest: List<T> = [];
    for x: T in xs { if (pred(x)) { push(matching, x); } else { push(rest, x); } }
    return [matching, rest];
}

/// Group elements into a map keyed by `str(key_fn(x))`.
fun group_by<T, K>(xs: List<T>, key_fn: (T) -> K) -> Map<Str, List<T>> {
    let out: Map<Str, List<T>> = {};
    for x: T in xs {
        let key: Str = str(key_fn(x));
        let fresh: List<T> = [];
        let group: List<T> = out[key] ?? fresh;
        push(group, x);
        out[key] = group;
    }
    return out;
}

/// Count elements by `str(key_fn(x))`.
fun count_by<T, K>(xs: List<T>, key_fn: (T) -> K) -> Map<Str, Int> {
    let out: Map<Str, Int> = {};
    for x: T in xs {
        let key: Str = str(key_fn(x));
        out[key] = (out[key] ?? 0) + 1;
    }
    return out;
}
