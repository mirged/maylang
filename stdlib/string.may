// string.may — helpers built on the native string methods.

/// Report whether `s` has no characters.
pub fun is_empty(s: Any) -> Any { return len(s) == 0; }

/// Repeat `s` `n` times.
pub fun repeat(s: Any, n: Any) -> Any {
    mut out: Any = "";
    for _: Any in 1..=n { out = out + s; }
    return out;
}

/// Uppercase the first character, leaving the rest unchanged.
pub fun capitalize(s: Any) -> Any {
    let cs: Any = chars(s);
    if (len(cs) == 0) { return s; }
    mut out: Any = cs[0].to_upper();
    for i: Any in 1..len(cs) { out = out + cs[i]; }
    return out;
}

/// Split on ASCII space/tab/newline/carriage return, dropping empty pieces.
pub fun words(s: Any) -> Any {
    let normalized: Any = replace(replace(replace(s, "\t", " "), "\n", " "), "\r", " ");
    return filter(normalized.split(" "), |w: Any| -> Any { return len(w) > 0; });
}

/// Split `s` into lines.
pub fun lines(s: Any) -> Any { return s.split("\n"); }

/// Split a comma-separated line, trimming each field.
pub fun csv(s: Any) -> Any { return map(s.split(","), |part: Any| -> Any { return part.trim(); }); }

/// Return the characters of `s` in reverse order.
pub fun reverse_str(s: Any) -> Any { return reverse(s); }

/// Left-pad `s` with `ch` until it is `width` characters wide.
pub fun pad_left(s: Any, width: Any, ch: Any) -> Any {
    if (len(ch) == 0 and len(s) < width) { fail("padding must not be empty"); }
    mut out: Any = s;
    while (len(out) < width) { out = ch + out; }
    return out;
}

/// Right-pad `s` with `ch` until it is `width` characters wide.
pub fun pad_right(s: Any, width: Any, ch: Any) -> Any {
    if (len(ch) == 0 and len(s) < width) { fail("padding must not be empty"); }
    mut out: Any = s;
    while (len(out) < width) { out = out + ch; }
    return out;
}

/// Report whether `s` begins with any of `prefixes`.
pub fun starts_with_any(s: Any, prefixes: Any) -> Any {
    return any(prefixes, |p: Any| -> Any { return s.starts_with(p); });
}

/// Count non-overlapping occurrences of `needle` in `s`.
pub fun count_occurrences(s: Any, needle: Any) -> Any {
    if (len(needle) == 0) { return 0; }
    let parts: Any = s.split(needle);
    return len(parts) - 1;
}

/// Shorten `s` to `width` characters, appending `ellipsis` when truncated.
pub fun truncate(s: Any, width: Any, ellipsis: Any) -> Any {
    if (len(s) <= width) { return s; }
    let keep: Any = max(0, width - len(ellipsis));
    let cs: Any = chars(s);
    mut out: Any = "";
    for i: Any in 0..keep { out = out + cs[i]; }
    return out + ellipsis;
}
