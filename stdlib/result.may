// Typed Result helpers share the native {ok, value, error} representation.

/// A successful result wrapping `value`.
fun ok<T>(value: T) -> Result<T, Never> { return Ok(value); }

/// A failed result carrying `message`.
fun error<E>(message: E) -> Result<Never, E> { return Err(message); }

/// Whether `r` is a success.
fun is_ok<T, E>(r: Result<T, E>) -> Bool { return r.ok; }

/// Whether `r` is a failure.
fun is_err<T, E>(r: Result<T, E>) -> Bool { return !r.ok; }

/// Unwrap a success, or fault on a failure.
fun unwrap<T, E>(r: Result<T, E>) -> T {
    return match(r) { Ok(value) => value, Err(message) => fail("unwrap on error: " + str(message)) };
}

/// Unwrap a success, else return `fallback`.
fun unwrap_or<T, E>(r: Result<T, E>, fallback: T) -> T {
    return match(r) { Ok(value) => value, Err(_) => fallback };
}

/// Map the success value with `f`, passing failures through.
fun map_result<T, U, E>(r: Result<T, E>, f: (T) -> U) -> Result<U, E> {
    return match(r) { Ok(value) => Ok(f(value)), Err(message) => Err(message) };
}

/// Chain a fallible step: `f(value)` returns another Result.
fun and_then<T, U, E>(r: Result<T, E>, f: (T) -> Result<U, E>) -> Result<U, E> {
    return match(r) { Ok(value) => f(value), Err(message) => Err(message) };
}

/// Turn a list of Results into a Result of a list (the first failure wins).
fun collect<T, E>(results: List<Result<T, E>>) -> Result<List<T>, E> {
    let values: List<T> = [];
    for result in results { push(values, result?); }
    return Ok(values);
}

/// Turn a speculative block into a Result instead of a fallback.
fun attempt<T>(f: () -> T) -> Result<T, Str> {
    return may { Ok(f()) } otherwise { Err(str(err.message)) };
}
