// result.may — Result-style values (`{ok, value, error}`) using `may`.
//
// (The helper is named `error` rather than `err` to avoid shadowing the
// runtime's structured `err` object.)

/// A successful result wrapping `value`.
fun ok(value: Any) -> Any { return {"ok": true, "value": value, "error": nil}; }

/// A failed result carrying `message`.
fun error(message: Any) -> Any { return {"ok": false, "value": nil, "error": message}; }

/// Whether `r` is a success.
fun is_ok(r: Any) -> Any { return r.ok; }

/// Whether `r` is a failure.
fun is_err(r: Any) -> Any { return !r.ok; }

/// Unwrap a success, or fault on a failure.
fun unwrap(r: Any) -> Any {
    if (r.ok) { return r.value; }
    return fail("unwrap on error: " + str(r.error));
}

/// Unwrap a success, else return `fallback`.
fun unwrap_or(r: Any, fallback: Any) -> Any {
    return if (r.ok) { r.value } else { fallback };
}

/// Map the success value with `f`, passing failures through.
fun map_result(r: Any, f: Any) -> Any {
    return if (r.ok) { ok(f(r.value)) } else { r };
}

/// Chain a fallible step: `f(value)` returns another Result.
fun and_then(r: Any, f: Any) -> Any {
    return if (r.ok) { f(r.value) } else { r };
}

/// Turn a list of Results into a Result of a list (the first failure wins).
fun collect(results: Any) -> Any {
    mut values: Any = [];
    for r: Any in results {
        if (!r.ok) { return r; }
        push(values, r.value);
    }
    return ok(values);
}

/// Turn a speculative block into a Result instead of a fallback.
fun attempt(f: Any) -> Any {
    return may {
        ok(f())
    } otherwise {
        error(err.message)
    };
}
