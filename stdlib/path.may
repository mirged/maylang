// path.may — portable, lexical path manipulation (no filesystem access).

fun path_substr(s: Any, start: Any, stop: Any) -> Any { return join(slice(chars(s), start, stop), ""); }
fun path_is_absolute(p: Any) -> Any { return starts_with(p, "/") || (len(p) >= 3 && p[1] == ":" && (p[2] == "/" || p[2] == "\\")); }
fun path_normalize(p: Any) -> Any {
    let drive: Any = len(p) >= 3 && p[1] == ":" && (p[2] == "/" || p[2] == "\\");
    let absolute: Any = path_is_absolute(p);
    let source: Any = if (drive) { path_substr(p, 2, len(p)) } else { p };
    let parts: Any = split(replace(source, "\\", "/"), "/");
    mut stack: Any = [];
    for part: Any in parts {
        if (part == "" || part == ".") { continue; }
        if (part == ".." && len(stack) > 0 && stack[len(stack) - 1] != "..") { stack = slice(stack, 0, len(stack) - 1); }
        else if (part == ".." && !absolute) { push(stack, part); }
        else if (part != "..") { push(stack, part); }
    }
    let body: Any = join(stack, "/");
    return if (drive) { path_substr(p, 0, 2) + "/" + body }
    else if (absolute) { "/" + body }
    else if (body == "") { "." }
    else { body };
}
fun path_join(a: Any, b: Any) -> Any {
    if (b == "") { return path_normalize(a); }
    if (path_is_absolute(b)) { return path_normalize(b); }
    return path_normalize((if (a == "") { "." } else { a }) + "/" + b);
}
fun path_basename(p: Any) -> Any {
    let s: Any = path_normalize(p); let parts: Any = split(s, "/");
    return if (len(parts) == 0) { "" } else { parts[len(parts) - 1] };
}
fun path_dirname(p: Any) -> Any {
    let s: Any = path_normalize(p); let parts: Any = split(s, "/");
    if (s == "/" || (path_is_absolute(p) && len(parts) == 2 && parts[0] == "")) { return "/"; }
    if (len(p) >= 3 && p[1] == ":" && len(parts) == 2) { return path_substr(p, 0, 2) + "/"; }
    return if (len(parts) <= 1) { if (path_is_absolute(p)) { "/" } else { "." } }
    else { join(slice(parts, 0, len(parts) - 1), "/") };
}
fun path_extension(p: Any) -> Any {
    let base: Any = path_basename(p); let i: Any = index_of(reverse(base), ".");
    return if (i <= 0 || i == len(base) - 1) { "" } else { path_substr(base, len(base) - i, len(base)) };
}
fun path_stem(p: Any) -> Any {
    let base: Any = path_basename(p); let ext: Any = path_extension(p);
    return if (ext == "") { base } else { path_substr(base, 0, len(base) - len(ext) - 1) };
}
fun path_relative(base_path: Any, target_path: Any) -> Any {
    let a: Any = split(path_normalize(base_path), "/"); let b: Any = split(path_normalize(target_path), "/");
    mut i: Any = 0;
    while (i < len(a) && i < len(b) && a[i] == b[i]) { i = i + 1; }
    return join([".." for _: Any in i..len(a)] + slice(b, i, len(b)), "/");
}
