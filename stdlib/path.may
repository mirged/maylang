// path.may — portable, lexical path manipulation (no filesystem access).

/// Return characters from inclusive `start` to exclusive `stop` as a string.
fun path_substr(s: Str, start: Int, stop: Int) -> Str { return join(slice(chars(s), start, stop), ""); }
/// Recognize leading `/` or a drive letter followed by `:/` or `:\`.
fun path_is_absolute(p: Str) -> Bool { return starts_with(p, "/") || (len(p) >= 3 && p[1] == ":" && (p[2] == "/" || p[2] == "\\")); }
/// Replace backslashes with `/`, remove repeated separators and `.`, resolve lexical `..`, preserve
/// roots; empty relative paths become `.`.
fun path_normalize(p: Str) -> Str {
    let drive: Bool = len(p) >= 3 && p[1] == ":" && (p[2] == "/" || p[2] == "\\");
    let absolute: Bool = path_is_absolute(p);
    let source: Str = if (drive) { path_substr(p, 2, len(p)) } else { p };
    let parts: List<Str> = split(replace(source, "\\", "/"), "/");
    mut stack: List<Str> = [];
    for part: Str in parts {
        if (part == "" || part == ".") { continue; }
        if (part == ".." && len(stack) > 0 && stack[len(stack) - 1] != "..") { stack = slice(stack, 0, len(stack) - 1); }
        else if (part == ".." && !absolute) { push(stack, part); }
        else if (part != "..") { push(stack, part); }
    }
    let body: Str = join(stack, "/");
    return if (drive) { path_substr(p, 0, 2) + "/" + body }
    else if (absolute) { "/" + body }
    else if (body == "") { "." }
    else { body };
}
/// Join and normalize two paths; an absolute second path replaces the first.
fun path_join(a: Str, b: Str) -> Str {
    if (b == "") { return path_normalize(a); }
    if (path_is_absolute(b)) { return path_normalize(b); }
    return path_normalize((if (a == "") { "." } else { a }) + "/" + b);
}
/// Return the final component after normalization; the root `/` yields an empty string.
fun path_basename(p: Str) -> Str {
    let s: Str = path_normalize(p); let parts: List<Str> = split(s, "/");
    return if (len(parts) == 0) { "" } else { parts[len(parts) - 1] };
}
/// Return the normalized parent path, preserving roots; a lone relative component has parent `.`.
fun path_dirname(p: Str) -> Str {
    let s: Str = path_normalize(p); let parts: List<Str> = split(s, "/");
    if (s == "/" || (path_is_absolute(p) && len(parts) == 2 && parts[0] == "")) { return "/"; }
    if (len(p) >= 3 && p[1] == ":" && len(parts) == 2) { return path_substr(p, 0, 2) + "/"; }
    return if (len(parts) <= 1) { if (path_is_absolute(p)) { "/" } else { "." } }
    else { join(slice(parts, 0, len(parts) - 1), "/") };
}
/// Return the extension without its dot; dotfiles and trailing dots produce an empty string.
fun path_extension(p: Str) -> Str {
    let base: Str = path_basename(p); let i: Int = index_of(reverse(base), ".");
    return if (i <= 0 || i == len(base) - 1) { "" } else { path_substr(base, len(base) - i, len(base)) };
}
/// Return the basename without its final extension.
fun path_stem(p: Str) -> Str {
    let base: Str = path_basename(p); let ext: Str = path_extension(p);
    return if (ext == "") { base } else { path_substr(base, 0, len(base) - len(ext) - 1) };
}
/// Return a lexical relative path; equal paths produce `.` and mismatched roots raise a fault.
fun path_relative(base_path: Str, target_path: Str) -> Str {
    let base: Str = path_normalize(base_path); let target: Str = path_normalize(target_path);
    let base_root: Str = if (path_is_absolute(base)) { if (base[0] == "/") { "/" } else { path_substr(base, 0, 2) } } else { "" };
    let target_root: Str = if (path_is_absolute(target)) { if (target[0] == "/") { "/" } else { path_substr(target, 0, 2) } } else { "" };
    if (base_root != target_root) { fail("relative paths must have the same root"); }
    let a: List<Str> = filter(split(base, "/"), |part: Str| -> Bool { return part != "" and part != "."; });
    let b: List<Str> = filter(split(target, "/"), |part: Str| -> Bool { return part != "" and part != "."; });
    mut i: Int = 0;
    while (i < len(a) && i < len(b) && a[i] == b[i]) { i = i + 1; }
    let relative: Str = join([".." for _: Int in i..len(a)] + slice(b, i, len(b)), "/");
    return if (relative == "") { "." } else { relative };
}
