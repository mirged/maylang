// native_prelude.may — the native standard library.
//
// Compiled into every native build. It is written in Maylang on top of a small
// set of runtime primitives:
//   str_of, int_to_str, char_at, char_from, str_cmp, cmp, value_eq, value_tag,
//   map_get, map_set, map_keys, map_values, map_has, to_map, read_stdin,
//   raise, clock, time, input, exit, read_file, write_file, file_exists,
//   sin, cos, tan, asin, acos, atan, atan2, ln, log2, log10, exp, pow, powf
// plus the core built-ins len, push, pop and `print`.

// ----------------------------------------------------- results and options
//
// `Result` and `Option` are ordinary `{ok, value, error}` maps so the `?`
// operator can propagate failures structurally. `None` is simply `nil`.

/// Return a success map `{ok: true, value, error: nil}`.
fun Ok(value: Any) -> Any { return {"ok": true, "value": value, "error": nil}; }
/// Return a failure map `{ok: false, value: nil, error}`.
fun Err(error: Any) -> Any { return {"ok": false, "value": nil, "error": error}; }
/// Return the same success-map representation as `Ok`.
fun Some(value: Any) -> Any { return {"ok": true, "value": value, "error": nil}; }
/// Return `nil`; invoke as a zero-argument function.
fun None() -> Any { return nil; }

// ------------------------------------------------- operator overloading
//
// Binary arithmetic consults a method named after the operator on the left
// operand (when it is a map/struct). The method receives `(self, other)`.
// Returning `nil` means "not handled" and falls back to numeric semantics.

/// Dispatch a map/record `+` operator hook: call the left operand's method with
/// `(self, other)`, or return `nil` when it has none.
fun __op_add(a: Any, b: Any) -> Any { if (value_tag(a) != 7) { return nil; } let m: Any = a["+"]; if (m == nil) { return nil; } return m(a, b); }
/// Dispatch a map/record `-` operator hook: call the left operand's method with
/// `(self, other)`, or return `nil` when it has none.
fun __op_sub(a: Any, b: Any) -> Any { if (value_tag(a) != 7) { return nil; } let m: Any = a["-"]; if (m == nil) { return nil; } return m(a, b); }
/// Dispatch a map/record `*` operator hook: call the left operand's method with
/// `(self, other)`, or return `nil` when it has none.
fun __op_mul(a: Any, b: Any) -> Any { if (value_tag(a) != 7) { return nil; } let m: Any = a["*"]; if (m == nil) { return nil; } return m(a, b); }
/// Dispatch a map/record `/` operator hook: call the left operand's method with
/// `(self, other)`, or return `nil` when it has none.
fun __op_div(a: Any, b: Any) -> Any { if (value_tag(a) != 7) { return nil; } let m: Any = a["/"]; if (m == nil) { return nil; } return m(a, b); }

// ------------------------------------------------------------------ strings

/// Concatenate through the dynamic `+` operator.
fun str_concat(a: Any, b: Any) -> Any { return a + b; }

// All native runtimes store the UTF-8 byte count immediately before addr(s).
// Walk byte offsets once and copy into a fresh string; indexing s repeatedly
// rescans every preceding codepoint and makes long paths/environments quadratic.

/// Return the byte width of a valid UTF-8 leading byte; native prelude helper.
fun __native_utf8_width(byte: Any) -> Any {
    if (byte < 128) { return 1; }
    if (byte < 224) { return 2; }
    if (byte < 240) { return 3; }
    return 4;
}
/// Copy `count` bytes from `source` to `destination` and return the count; native prelude helper.
///
/// Its Int-only signature makes the full runtime compile it as a native-word loop; the source
/// bootstrap ignores the types.
fun __native_copy_bytes(destination: Int, source: Int, count: Int) -> Int {
    mut i: Int = 0;
    while (i + 8 <= count) { store64(destination + i, load64(source + i)); i += 8; }
    while (i < count) { store8(destination + i, load8(source + i)); i += 1; }
    return count;
}
/// Copy an in-range UTF-8 byte slice into a fresh string; native prelude helper.
///
/// The caller must preserve code point boundaries.
fun __native_string_bytes(s: Any, start: Any, count: Any) -> Any {
    let out: Any = repeat("\0", count);
    __native_copy_bytes(addr(out), addr(s) + start, count);
    return out;
}
/// Copy `count` code points of `s`, starting at code point index `start`.
///
/// The third argument is a count, not an end index, and the range must lie within `s`.
///
/// Params:
/// - `s`: The input string.
/// - `start`: The zero-based starting character index.
/// - `count`: The number of characters to copy.
///
/// Returns: A string.
///
/// Example:
/// ```may
/// print(substring("hello", 1, 3)); // ell
/// ```
fun substring(s: Any, start: Any, count: Any) -> Any {
    let bytes: Any = addr(s); let n: Any = load64(bytes - 8);
    mut offset: Any = 0; mut index: Any = 0;
    while (offset < n && index < start) {
        offset += __native_utf8_width(load8(bytes + offset)); index += 1;
    }
    let begin: Any = offset; mut copied: Any = 0;
    while (offset < n && copied < count) {
        offset += __native_utf8_width(load8(bytes + offset)); copied += 1;
    }
    return __native_string_bytes(s, begin, offset - begin);
}

/// Report whether a character code is ASCII space, tab, LF or CR.
fun is_space_code(c: Any) -> Any { return c == 32 || c == 9 || c == 10 || c == 13; }
/// Report whether a character code is an ASCII uppercase letter (65..90).
fun is_upper_code(c: Any) -> Any { return c >= 65 && c <= 90; }
/// Report whether a character code is an ASCII lowercase letter (97..122).
fun is_lower_code(c: Any) -> Any { return c >= 97 && c <= 122; }

/// Remove whitespace from the beginning and end of a string.
///
/// Params:
/// - `s`: The input string.
///
/// Returns: A string.
///
/// Example:
/// ```may
/// print(trim("  hello  "));
/// ```
fun trim(s: Any) -> Any {
    let n: Any = len(s);
    mut a: Any = 0;
    while (a < n && is_space_code(char_at(s, a))) { a = a + 1; }
    mut b: Any = n;
    while (b > a && is_space_code(char_at(s, b - 1))) { b = b - 1; }
    return substring(s, a, b - a);
}

/// Copy `s`, shifting the 26 ASCII letters starting at `low` by `delta`; native prelude helper.
///
/// Every other byte, including all bytes of multi-byte code points, is copied unchanged.
fun __native_ascii_case(s: Any, low: Any, delta: Any) -> Any {
    let n: Any = load64(addr(s) - 8);
    let out: Any = __native_string_bytes(s, 0, n);
    let bytes: Any = addr(out);
    for i: Any in 0..n {
        let c: Any = load8(bytes + i);
        if (c >= low && c <= low + 25) { store8(bytes + i, c + delta); }
    }
    return out;
}

/// Return an ASCII-lowercased string; other character codes pass through.
fun to_lower(s: Any) -> Any { return __native_ascii_case(s, 65, 32); }
/// Return an ASCII-uppercased string; other character codes pass through.
fun to_upper(s: Any) -> Any { return __native_ascii_case(s, 97, 0 - 32); }

/// Return the byte offset of the first `sub` in `s` at or after byte `offset`, or -1; native
/// prelude helper.
///
/// Valid UTF-8 needles only match at code point boundaries.
fun __native_find(s: Any, sub: Any, offset: Any) -> Any {
    let bytes: Any = addr(s); let needle: Any = addr(sub);
    let n: Any = load64(bytes - 8); let m: Any = load64(needle - 8);
    mut i: Any = offset;
    while (i + m <= n) {
        mut matched: Any = 0;
        while (matched < m && load8(bytes + i + matched) == load8(needle + matched)) { matched += 1; }
        if (matched == m) { return i; }
        i += 1;
    }
    return -1;
}

/// Return the first substring index or `-1`; an empty needle returns zero.
fun index_of(s: Any, sub: Any) -> Any {
    let at: Any = __native_find(s, sub, 0);
    if (at <= 0) { return at; }
    // Code points before the match: every byte that does not continue one.
    let bytes: Any = addr(s);
    mut index: Any = 0;
    for i: Any in 0..at {
        let c: Any = load8(bytes + i);
        if (c < 128 || c >= 192) { index += 1; }
    }
    return index;
}

/// Report whether the string contains the substring (`index_of` is nonnegative).
fun contains(s: Any, sub: Any) -> Any { return index_of(s, sub) >= 0; }

/// Report whether the string begins with the supplied prefix.
fun starts_with(s: Any, prefix: Any) -> Any {
    let n: Any = len(prefix);
    if (n > len(s)) { return false; }
    return substring(s, 0, n) == prefix;
}

/// Report whether the string ends with the supplied suffix.
fun ends_with(s: Any, suffix: Any) -> Any {
    let n: Any = len(suffix);
    if (n > len(s)) { return false; }
    return substring(s, len(s) - n, n) == suffix;
}

/// Split `s` at each occurrence of the literal `delim`, keeping empty fields.
///
/// An empty delimiter returns a one-element list containing `s`.
///
/// Params:
/// - `s`: The input string.
/// - `delim`: The separator string.
///
/// Returns: A list of string segments.
///
/// Example:
/// ```may
/// print(split("a,b,c", ","));
/// ```
fun split(s: Any, delim: Any) -> Any {
    mut out: Any = [];
    let bytes: Any = addr(s); let separator: Any = addr(delim);
    let n: Any = load64(bytes - 8); let m: Any = load64(separator - 8);
    if (m == 0) { push(out, s); return out; }
    mut start: Any = 0;
    mut i: Any = 0;
    while (i + m <= n) {
        mut matched: Any = 0;
        while (matched < m && load8(bytes + i + matched) == load8(separator + matched)) { matched += 1; }
        if (matched == m) {
            push(out, __native_string_bytes(s, start, i - start));
            start = i + m;
            i = start;
        } else {
            i = i + 1;
        }
    }
    push(out, __native_string_bytes(s, start, n - start));
    return out;
}

/// Replace non-overlapping occurrences; an empty needle returns the original string.
///
/// The matches are the same leftmost, non-overlapping ones that `split` finds.
fun replace(s: Any, needle: Any, replacement: Any) -> Any {
    if (load64(addr(needle) - 8) == 0) { return s; }
    return join(split(s, needle), replacement);
}

/// Return Unicode codepoints as one-character strings.
fun chars(s: Any) -> Any {
    let out: Any = []; let bytes: Any = addr(s); let n: Any = load64(bytes - 8);
    mut offset: Any = 0;
    while (offset < n) {
        let width: Any = __native_utf8_width(load8(bytes + offset));
        push(out, __native_string_bytes(s, offset, width)); offset += width;
    }
    return out;
}
/// Concatenate `n` copies of `s`; a nonpositive count gives an empty string.
///
/// Params:
/// - `s`: The string to repeat.
/// - `n`: The number of copies.
///
/// Returns: The repeated string.
///
/// Example:
/// ```may
/// print(repeat("ab", 3)); // ababab
/// ```
fun repeat(s: Any, n: Any) -> Any {
    mut out: Any = ""; mut part: Any = s; mut left: Any = n;
    while (left > 0) {
        if (left % 2 == 1) { out = out + part; }
        left = left / 2;
        if (left > 0) { part = part + part; }
    }
    return out;
}

/// Join a list's display texts with a string separator; native prelude helper.
///
/// The full runtime compiles calls to it as `rt_join` (`x86_64_fat.may` `fat_call`); this body
/// serves the source bootstrap with one allocation of the total byte length and one copy per part.
fun __join_list(xs: Any, separator: Any) -> Any {
    let n: Any = len(xs);
    let parts: Any = [];
    let separatorBytes: Any = load64(addr(separator) - 8);
    mut total: Any = 0;
    if (n > 1) { total = separatorBytes * (n - 1); }
    mut i: Any = 0;
    while (i < n) {
        let part: Any = str(xs[i]);
        push(parts, part);
        total += load64(addr(part) - 8);
        i += 1;
    }
    let out: Any = repeat("\0", total);
    mut at: Any = addr(out);
    i = 0;
    while (i < n) {
        if (i > 0) { at += __native_copy_bytes(at, addr(separator), separatorBytes); }
        let part: Any = parts[i];
        at += __native_copy_bytes(at, addr(part), load64(addr(part) - 8));
        i += 1;
    }
    return out;
}

/// Convert items to strings and combine them with a separator between neighboring items.
///
/// Params:
/// - `xs`: The values to combine.
/// - `sep`: The text inserted between items.
///
/// Returns: The combined string.
///
/// Example:
/// ```may
/// print(join(["a", "b"], ","));
/// ```
fun join(xs: Any, sep: Any) -> Any {
    if (value_tag(xs) == 5) { return __join_list(xs, str(sep)); }
    let n: Any = len(xs);
    if (n == 0) { return ""; }
    let parts: Any = [];
    mut i: Any = 0;
    while (i < n) { push(parts, xs[i]); i += 1; }
    return __join_list(parts, str(sep));
}

/// Convert an integer, float, or decimal string to an integer. Floats are truncated toward zero;
/// NaN, infinities and Floats outside the Int range raise an arithmetic fault, and invalid text
/// raises a catchable failure.
///
/// Params:
/// - `x`: A number or a trimmed decimal string with optional sign.
///
/// Returns: An integer.
///
/// Example:
/// ```may
/// print(int(" 42 "));
/// print(int(3.9));
/// ```
fun int(x: Any) -> Any {
    let t: Any = value_tag(x);
    if (t == 0) { return x; }
    if (t == 6) { return trunc(x); }
    if (t != 1) { return raise_error("runtime", "cannot convert to Int"); }
    let s: Any = trim(x);
    let n: Any = len(s);
    mut i: Any = 0;
    if (n > 0 && (char_at(s, 0) == 45 || char_at(s, 0) == 43)) { i = 1; }
    if (i >= n) { return raise_error("runtime", "cannot convert to Int"); }
    let start: Any = i;
    while (i < n) {
        let c: Any = char_at(s, i);
        if (c < 48 || c > 57) { return raise_error("runtime", "cannot convert to Int"); }
        i = i + 1;
    }
    mut sign: Any = 1;
    if (char_at(s, 0) == 45) { sign = -1; }
    mut v: Any = 0;
    mut k: Any = start;
    while (k < n) {
        // Accumulate negative input directly so the minimum Int is representable.
        v = v * 10 + (char_at(s, k) - 48) * sign;
        k = k + 1;
    }
    return v;
}

/// Convert a number or numeric string to a floating-point value.
///
/// Params:
/// - `x`: A number or numeric string.
///
/// Returns: A floating-point number.
///
/// Example:
/// ```may
/// print(float("3.5"));
/// ```
fun float(x: Any) -> Any {
    let t: Any = value_tag(x);
    if (t == 6) { return x; }
    if (t == 0) { return to_float(x); }
    if (t != 1) { return raise_error("runtime", "cannot convert to Float"); }
    // Correctly rounded; see __math_parse in runtime/math.may.
    let value: Any = __math_parse(trim(x));
    if (value == nil) { return raise_error("runtime", "cannot convert to Float"); }
    return value;
}

/// Format a boxed float with the shortest digits that parse back to the same value; spell nonfinite
/// values nan, inf and -inf and keep the sign of negative zero.
fun float_str(f: Any) -> Any { return __math_format(f); }

// ------------------------------------------------------------------ lists

/// Build a list with the input items in reverse order.
///
/// Params:
/// - `x`: The input list.
///
/// Returns: A new list.
///
/// Example:
/// ```may
/// print(reverse([1, 2, 3]));
/// ```
fun reverse(x: Any) -> Any {
    let n: Any = len(x);
    if (value_tag(x) == 1) {
        mut out: Any = "";
        for i: Any in 0..n { out = out + char_from(char_at(x, n - 1 - i)); }
        return out;
    }
    return [x[n - 1 - i] for i: Any in 0..n];
}

/// Build the list of integers from `a` (inclusive) to `b` (exclusive).
///
/// The function takes exactly two arguments; use `range_step` for other steps.
///
/// Params:
/// - `a`: The inclusive starting value.
/// - `b`: The exclusive stop value.
///
/// Returns: A list of integers.
///
/// Example:
/// ```may
/// print(range(1, 4)); // [1, 2, 3]
/// ```
fun range(a: Any, b: Any) -> Any { return [i for i: Any in a..b]; }

/// Add the numeric values in a list.
///
/// Params:
/// - `xs`: A list of numbers.
///
/// Returns: The total; zero for an empty list.
///
/// Example:
/// ```may
/// print(sum([1, 2, 3])); // 6
/// ```
fun sum(xs: Any) -> Any {
    mut total: Any = 0;
    for x: Any in xs { total = total + x; }
    return total;
}

/// Return the lesser of two comparable values.
///
/// Params:
/// - `a`: The first value.
/// - `b`: The second value.
///
/// Returns: One of the two values.
///
/// Example:
/// ```may
/// print(min(3, 8)); // 3
/// ```
fun min(a: Any, b: Any) -> Any { return if (cmp(a, b) <= 0) { a } else { b }; }
/// Return the greater of two comparable values.
///
/// Params:
/// - `a`: The first value.
/// - `b`: The second value.
///
/// Returns: One of the two values.
///
/// Example:
/// ```may
/// print(max(3, 8)); // 8
/// ```
fun max(a: Any, b: Any) -> Any { return if (cmp(a, b) >= 0) { a } else { b }; }
/// Return the nonnegative magnitude of a number.
///
/// Params:
/// - `x`: The input number.
///
/// Returns: A numeric absolute value.
///
/// Example:
/// ```may
/// print(abs(-4)); // 4
/// ```
fun abs(x: Any) -> Any { return if (cmp(x, 0) < 0) { 0 - x } else { x }; }

/// Return the items in ascending order using the standard comparison function. The input list is
/// preserved.
///
/// Params:
/// - `xs`: A list of comparable values.
///
/// Returns: A new sorted list.
///
/// Example:
/// ```may
/// print(sort([3, 1, 2]));
/// ```
fun sort(xs: Any) -> Any {
    let a: Any = [];
    for x: Any in xs { push(a, x); }
    let n: Any = len(a);
    for i: Any in 1..n {
        let key: Any = a[i];
        mut j: Any = i - 1;
        while (j >= 0 && cmp(a[j], key) > 0) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
    }
    return a;
}

// ------------------------------------------------------------------ maps

/// Collect the keys of a map.
///
/// Params:
/// - `m`: The input map.
///
/// Returns: A list of keys.
///
/// Example:
/// ```may
/// print(keys({"a": 1}));
/// ```
fun keys(m: Any) -> Any { return map_keys(m); }
/// Collect the values of a map.
///
/// Params:
/// - `m`: The input map.
///
/// Returns: A list of values.
///
/// Example:
/// ```may
/// print(values({"a": 1}));
/// ```
fun values(m: Any) -> Any { return map_values(m); }

/// Report whether `x` contains `key`: maps look up keys, lists scan for an equal item and strings
/// search for a substring.
///
/// This is the function behind the language's `has`.
///
/// Params:
/// - `x`: The map, list, or string to search.
/// - `key`: The key, item, or substring to find.
///
/// Returns: A boolean.
///
/// Example:
/// ```may
/// print(has({"name": "Ada"}, "name"));
/// ```
fun has(x: Any, key: Any) -> Any {
    let t: Any = value_tag(x);
    if (t == 7) { return map_has(x, key); }
    if (t == 1) { return index_of(x, str(key)) >= 0; }
    if (t == 5) {
        let n: Any = len(x);
        for i: Any in 0..n {
            if (value_eq(x[i], key)) { return true; }
        }
        return false;
    }
    return false;
}

/// Combine two maps into a new map. Entries from the second map replace matching keys from the
/// first.
///
/// Params:
/// - `a`: The first map.
/// - `b`: The second map, which takes precedence.
///
/// Returns: A new combined map.
///
/// Example:
/// ```may
/// print(merge({"a": 1}, {"a": 2, "b": 3}));
/// ```
fun merge(a: Any, b: Any) -> Any {
    let out: Any = to_map([]);
    for key: Any in map_keys(a) { map_set(out, key, map_get(a, key)); }
    for key: Any in map_keys(b) { map_set(out, key, map_get(b, key)); }
    return out;
}

/// Copy a map while omitting one key. The original map is preserved.
///
/// Params:
/// - `m`: The input map.
/// - `key`: The key to omit.
///
/// Returns: A new map.
///
/// Example:
/// ```may
/// let m: Any = {"a": 1, "b": 2};
/// let smaller: Any = remove(m, "a");
/// ```
fun remove(m: Any, key: Any) -> Any {
    let out: Any = to_map([]);
    for kk: Any in map_keys(m) {
        if (!value_eq(kk, key)) { map_set(out, kk, map_get(m, kk)); }
    }
    return out;
}

/// Convert a value to its textual representation.
///
/// Params:
/// - `x`: The value to format.
///
/// Returns: A string.
///
/// Example:
/// ```may
/// print(str(42));
/// ```
fun str(x: Any) -> Any {
    if (value_tag(x) == 6) { return float_str(x); }
    return str_of(x);
}

// ------------------------------------------------------------------ errors

/// Build the structured error object exposed to `otherwise` as `err`.
fun make_error(kind: Any, message: Any) -> Any {
    let e: Any = to_map([]);
    map_set(e, "kind", kind);
    map_set(e, "message", message);
    map_set(e, "stack", "");
    map_set(e, "__error__", true);
    return e;
}

/// Construct and raise a structured runtime error; does not return normally.
fun raise_error(kind: Any, message: Any) -> Any {
    rt_raise(make_error(kind, message));
    return nil;
}

/// Build and raise a fail-category error from displayable message items.
fun fail_list(items: Any) -> Any {
    mut msg: Any = "";
    let n: Any = len(items);
    for i: Any in 0..n {
        if (i > 0) { msg = msg + " "; }
        msg = msg + str(items[i]);
    }
    return raise_error("fail", msg);
}

/// Return the tagged runtime type name.
fun type_name(x: Any) -> Any {
    let t: Any = value_tag(x);
    if (t == 0) { return "Int"; }
    if (t == 1) { return "Str"; }
    if (t == 2) { return "Nil"; }
    if (t == 3) { return "Bool"; }
    if (t == 4) { return "Bool"; }
    if (t == 6) { return "Float"; }
    if (t == 7) { return "Map"; }
    return "List";
}

/// Raise an operator/type error describing both operands and the operator.
fun raise_binop_error(a: Any, b: Any, sym: Any) -> Any {
    return raise_error("type", "cannot apply `" + sym + "` to " + type_name(a) + " and " + type_name(b));
}

/// Raise the native addition operand-type error.
fun raise_add_error(a: Any, b: Any) -> Any {
    return raise_error("runtime", "cannot add " + type_name(a) + " and " + type_name(b));
}

/// Raise the native exponentiation operand-type error.
fun raise_exp_error(a: Any, b: Any) -> Any {
    return raise_error("type", "cannot exponentiate " + type_name(a) + " and " + type_name(b));
}

/// Raise the arithmetic division-by-zero fault.
fun raise_div_zero() -> Any {
    return raise_error("arithmetic", "division by zero");
}

/// Raise the arithmetic integer-overflow fault.
fun raise_overflow() -> Any {
    return raise_error("arithmetic", "integer overflow");
}

/// Raise an I/O-category error with the supplied message.
fun raise_io_error(message: Any) -> Any {
    return raise_error("io", message);
}

/// Return a raw pointer, which is just an integer holding a machine address.
fun ptr(n: Any) -> Any { return n; }

/// Print a structured error's category/message and available stack text.
fun print_error(e: Any) -> Any {
    let k: Any = e.kind;
    if (k == nil) { return print(str(e)); }
    mut m: Any = e.message;
    if (m == nil) { m = ""; }
    return print(str(k) + ": " + str(m));
}

/// Return a shallow concatenation of two lists.
fun concat_lists(a: Any, b: Any) -> Any {
    let out: Any = [];
    for x: Any in a { push(out, x); }
    for x: Any in b { push(out, x); }
    return out;
}

/// Format a value like the VM's `repr`: strings are quoted when nested.
fun string_repr(v: Any) -> Any {
    let t: Any = value_tag(v);
    if (t == 1 || t == 0 || t == 6) { return str(v); }
    if (t == 2) { return "nil"; }
    if (t == 3) { return "false"; }
    if (t == 4) { return "true"; }
    if (t == 5) {
        mut out: Any = "[";
        let n: Any = len(v);
        for i: Any in 0..n {
            if (i > 0) { out = out + ", "; }
            out = out + string_repr(v[i]);
        }
        return out + "]";
    }
    if (t == 7) {
        if (map_has(v, "__error__")) { return str(map_get(v, "message")); }
        mut out: Any = "{";
        let ks: Any = sort(map_keys(v));
        let n: Any = len(ks);
        for i: Any in 0..n {
            if (i > 0) { out = out + ", "; }
            out = out + "\"" + ks[i] + "\": " + string_repr(map_get(v, ks[i]));
        }
        return out + "}";
    }
    return "<fun>";
}

// ------------------------------------------------------------------ values

/// Convert a value to its truth value. Only `nil` and `false` are false; zero, empty strings, and
/// empty collections are true.
///
/// Params:
/// - `x`: The value whose truthiness is tested.
///
/// Returns: `true` or `false`.
///
/// Example:
/// ```may
/// print(bool(0)); // true
/// ```
fun bool(x: Any) -> Any { return if (x) { true } else { false }; }

/// Return the native runtime type name.
fun type(x: Any) -> Any { return type_name(x); }

/// Return -1, 0 or 1 according to comparison with zero.
fun sign(x: Any) -> Any {
    if (cmp(x, 0) > 0) { return 1; }
    if (cmp(x, 0) < 0) { return -1; }
    return 0;
}

/// Parse a trimmed integer string with range checking; propagate conversion faults.
fun parse_int(x: Any) -> Any {
    if (value_tag(x) == 0) { return x; }
    if (value_tag(x) == 6) { return trunc(x); }
    let s: Any = trim(x);
    let n: Any = len(s);
    if (n == 0) { return raise_error("parse", "cannot parse as Int"); }
    mut i: Any = 0;
    if (char_at(s, 0) == 45 || char_at(s, 0) == 43) { i = 1; }
    if (i >= n) { return raise_error("parse", "cannot parse as Int"); }
    while (i < n) {
        let c: Any = char_at(s, i);
        if (c < 48 || c > 57) { return raise_error("parse", "cannot parse as Int"); }
        i = i + 1;
    }
    return int(s);
}

/// Parse a trimmed floating-point string through native conversion.
fun parse_float(x: Any) -> Any {
    if (value_tag(x) == 6) { return x; }
    if (value_tag(x) == 0) { return float(x); }
    return float(trim(x));
}

/// Look up an environment variable of the current process.
///
/// On Linux the value is read from `/proc/self/environ`.
///
/// Params:
/// - `name`: The environment variable name.
///
/// Returns: The variable’s string value, or `nil` if missing.
///
/// Example:
/// ```may
/// print(env("HOME") ?? "unset");
/// ```
fun env(name: Any) -> Any {
    let blob: Any = may { read_file("/proc/self/environ") } otherwise { nil };
    if (blob == nil) { return nil; }
    let target: Any = name + "=";
    let m: Any = len(target);
    for entry: Any in split(blob, "\0") {
        // Match a complete name at the beginning of each environment entry.
        if (starts_with(entry, target)) {
            return substring(entry, m, len(entry) - m);
        }
    }
    return nil;
}

// ------------------------------------------------------------------ math

/// Return the binary64 approximation of π, 3.141592653589793.
fun pi() -> Any { return 3.141592653589793; }
/// Return the binary64 approximation of Euler's number, 2.718281828459045.
fun e() -> Any { return 2.718281828459045; }

/// Round to the nearest integral Float; halfway values round toward positive infinity
/// (`round(-2.5)` is `-2.0`).
///
/// Float return; halfway values, including negative ones, round toward positive infinity. Convert
/// with int() where an Int is needed.
fun round(x: Any) -> Any {
    // x - floor(x) is exact, unlike x + 0.5, which rounds 0.49999999999999994 up.
    let f: Any = to_float(x); let r: Any = floor(f);
    return if (f - r >= 0.5) { r + 1.0 } else { r };
}

/// Compute `(exp(x) - exp(-x)) / 2.0`.
fun sinh(x: Any) -> Any { return (exp(x) - exp(0.0 - x)) / 2.0; }
/// Compute `(exp(x) + exp(-x)) / 2.0`.
fun cosh(x: Any) -> Any { return (exp(x) + exp(0.0 - x)) / 2.0; }
/// Compute `(exp(2*x) - 1) / (exp(2*x) + 1)`; large inputs may overflow the exponential.
fun tanh(x: Any) -> Any { let e2: Any = exp(2.0 * x); return (e2 - 1.0) / (e2 + 1.0); }
/// Return `sqrt(x*x + y*y)` without an overflow-resistant scaling algorithm.
fun hypot(x: Any, y: Any) -> Any { return sqrt(x * x + y * y); }
/// Return a sign-preserving cube root computed with fractional powers.
fun cbrt(x: Any) -> Any {
    if (cmp(x, 0) == 0) { return 0.0; }
    if (cmp(x, 0) < 0) { return 0.0 - exp(ln(0.0 - x) / 3.0); }
    return exp(ln(x) / 3.0);
}

// ------------------------------------------------------------------ json

/// Report whether a code is JSON whitespace (space, tab, LF or CR); JSON parser helper.
fun jd_is_space(c: Any) -> Any { return c == 32 || c == 9 || c == 10 || c == 13; }
/// Skip JSON whitespace from index `i` and return the next index.
fun jd_skip(s: Any, i: Any) -> Any {
    mut j: Any = i;
    while (j < len(s) && jd_is_space(char_at(s, j))) { j = j + 1; }
    return j;
}

/// Decode one hexadecimal character or raise a parse fault; JSON parser helper.
fun jd_hex(c: Any) -> Any {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return raise_error("parse", "invalid JSON Unicode escape");
}

/// Decode a quoted JSON string and return the parsed value and next position.
fun jd_string(s: Any, i: Any) -> Any {
    mut out: Any = "";
    mut j: Any = i;
    while (j < len(s)) {
        let c: Any = char_at(s, j);
        if (c == 34) { return [out, j + 1]; }
        if (c == 92) {
            j = j + 1;
            let e: Any = char_at(s, j);
            if (e == 110) { out = out + char_from(10); }
            else if (e == 116) { out = out + char_from(9); }
            else if (e == 114) { out = out + char_from(13); }
            else if (e == 98) { out = out + char_from(8); }
            else if (e == 102) { out = out + char_from(12); }
            else if (e == 117) {
                if (j + 4 >= len(s)) { return raise_error("parse", "incomplete JSON Unicode escape"); }
                mut code: Any = 0;
                for k: Any in 1..=4 { code = code * 16 + jd_hex(char_at(s, j + k)); }
                j = j + 4;
                if (code >= 55296 && code <= 56319) {
                    if (j + 6 >= len(s) || char_at(s, j + 1) != 92 || char_at(s, j + 2) != 117) {
                        return raise_error("parse", "missing low surrogate");
                    }
                    mut low: Any = 0;
                    for k: Any in 3..=6 { low = low * 16 + jd_hex(char_at(s, j + k)); }
                    if (low < 56320 || low > 57343) { return raise_error("parse", "invalid low surrogate"); }
                    code = 65536 + (code - 55296) * 1024 + low - 56320;
                    j = j + 6;
                } else if (code >= 56320 && code <= 57343) { return raise_error("parse", "unexpected low surrogate"); }
                out = out + char_from(code);
            } else { out = out + char_from(e); }
        } else {
            out = out + char_from(c);
        }
        j = j + 1;
    }
    return [out, j];
}

/// Read a JSON number and return the parsed value and next position.
fun jd_number(s: Any, i: Any) -> Any {
    mut j: Any = i;
    if (j < len(s) && char_at(s, j) == 45) { j = j + 1; }
    mut is_float: Any = false;
    while (j < len(s)) {
        let c: Any = char_at(s, j);
        if (c >= 48 && c <= 57) { j = j + 1; }
        else if (c == 46) { is_float = true; j = j + 1; }
        else if (c == 101 || c == 69) { is_float = true; j = j + 1; }
        else if (c == 43 || c == 45) { j = j + 1; }
        else { break; }
    }
    let text: Any = substring(s, i, j - i);
    if (is_float) { return [float(text), j]; }
    return [int(text), j];
}

/// Read a JSON array and return the parsed list and next position.
fun jd_array(s: Any, i: Any) -> Any {
    mut out: Any = [];
    mut j: Any = jd_skip(s, i);
    if (j < len(s) && char_at(s, j) == 93) { return [out, j + 1]; }
    while (true) {
        let r: Any = jd_value(s, jd_skip(s, j));
        push(out, r[0]);
        j = jd_skip(s, r[1]);
        if (j < len(s) && char_at(s, j) == 44) { j = j + 1; }
        else { break; }
    }
    return [out, j + 1];
}

/// Read a JSON object and return the parsed map and next position.
fun jd_object(s: Any, i: Any) -> Any {
    let out: Any = to_map([]);
    mut j: Any = jd_skip(s, i);
    if (j < len(s) && char_at(s, j) == 125) { return [out, j + 1]; }
    while (true) {
        j = jd_skip(s, j);
        let kr: Any = jd_string(s, j + 1);
        j = jd_skip(s, kr[1]);
        j = j + 1; // ':'
        let vr: Any = jd_value(s, jd_skip(s, j));
        map_set(out, kr[0], vr[0]);
        j = jd_skip(s, vr[1]);
        if (j < len(s) && char_at(s, j) == 44) { j = j + 1; }
        else { break; }
    }
    return [out, j + 1];
}

/// Parse the JSON value at the next token and return the value and next position.
fun jd_value(s: Any, i: Any) -> Any {
    let j: Any = jd_skip(s, i);
    if (j >= len(s)) { return raise_error("parse", "unexpected end of JSON"); }
    let c: Any = char_at(s, j);
    if (c == 123) { return jd_object(s, j + 1); }
    if (c == 91) { return jd_array(s, j + 1); }
    if (c == 34) { return jd_string(s, j + 1); }
    if (c == 116) {
        if (j + 4 <= len(s) && substring(s, j, 4) == "true") { return [true, j + 4]; }
        return raise_error("parse", "invalid JSON literal");
    }
    if (c == 102) {
        if (j + 5 <= len(s) && substring(s, j, 5) == "false") { return [false, j + 5]; }
        return raise_error("parse", "invalid JSON literal");
    }
    if (c == 110) {
        if (j + 4 <= len(s) && substring(s, j, 4) == "null") { return [nil, j + 4]; }
        return raise_error("parse", "invalid JSON literal");
    }
    if (c == 45 || (c >= 48 && c <= 57)) { return jd_number(s, j); }
    return raise_error("parse", "invalid JSON");
}

/// Decode a JSON string into Maylang strings, numbers, booleans, lists, maps, and `nil`.
///
/// Returns dynamic maps/lists/scalars; rejects trailing content and malformed strings. See the
/// implementation for supported Unicode escape behavior.
///
/// Params:
/// - `s`: The JSON text.
///
/// Returns: The decoded value.
///
/// Example:
/// ```may
/// let value: Any = json_parse("{\"name\":\"Ada\"}");
/// print(value.name);
/// ```
fun json_parse(s: Any) -> Any {
    let r: Any = jd_value(s, 0);
    let end: Any = jd_skip(s, r[1]);
    if (end != len(s)) { return raise_error("parse", "trailing characters after JSON"); }
    return r[0];
}

/// Quote and escape a string for JSON, including control characters.
fun jq_escape(s: Any) -> Any {
    mut out: Any = "\"";
    for i: Any in 0..len(s) {
        let c: Any = char_at(s, i);
        if (c == 34) { out = out + "\\\""; }
        else if (c == 92) { out = out + "\\\\"; }
        else if (c == 10) { out = out + "\\n"; }
        else if (c == 9) { out = out + "\\t"; }
        else if (c == 13) { out = out + "\\r"; }
        else if (c < 32) {
            let hex: Any = "0123456789abcdef";
            out = out + "\\u00" + hex[c / 16] + hex[c % 16];
        }
        else { out = out + char_from(c); }
    }
    return out + "\"";
}

/// Encode a value as JSON text. Strings are quoted and escaped; lists and maps are encoded
/// recursively.
///
/// Object keys are sorted before serialization and must be strings. Cyclic collections are not
/// valid JSON trees; do not pass self-referential values.
///
/// Params:
/// - `v`: The value to encode.
///
/// Returns: A JSON string.
///
/// Example:
/// ```may
/// print(json_stringify({"name": "Ada", "ready": true}));
/// ```
fun json_stringify(v: Any) -> Any {
    let t: Any = value_tag(v);
    if (t == 2) { return "null"; }
    if (t == 3) { return "false"; }
    if (t == 4) { return "true"; }
    if (t == 0) { return str(v); }
    if (t == 6) { return str(v); }
    if (t == 1) { return jq_escape(v); }
    if (t == 5) {
        mut out: Any = "[";
        let n: Any = len(v);
        for i: Any in 0..n {
            if (i > 0) { out = out + ","; }
            out = out + json_stringify(v[i]);
        }
        return out + "]";
    }
    if (t == 7) {
        mut out: Any = "{";
        let ks: Any = sort(map_keys(v));
        let n: Any = len(ks);
        for i: Any in 0..n {
            if (i > 0) { out = out + ","; }
            out = out + jq_escape(ks[i]) + ":" + json_stringify(map_get(v, ks[i]));
        }
        return out + "}";
    }
    return "null";
}


// ------------------------------------------------------------------ extras

/// Return `max(lo, min(x, hi))`.
fun clamp(x: Any, lo: Any, hi: Any) -> Any {
    if (cmp(x, lo) < 0) { return lo; }
    if (cmp(x, hi) > 0) { return hi; }
    return x;
}

/// Return a one-character string from a character code.
fun chr(n: Any) -> Any { return char_from(n); }
/// Return the first character's codepoint; require a nonempty string.
fun ord(s: Any) -> Any { return char_at(s, 0); }
/// Report whether `n` is even (`n % 2 == 0`).
fun even(n: Any) -> Any { return n % 2 == 0; }
/// Report whether `n` is odd (`n % 2 != 0`).
fun odd(n: Any) -> Any { return n % 2 != 0; }

/// Multiply a numeric list, starting at one.
fun product(xs: Any) -> Any {
    mut p: Any = 1;
    for x: Any in xs { p = p * x; }
    return p;
}

/// Return the count of values equal to the supplied value.
fun count(xs: Any, x: Any) -> Any {
    mut c: Any = 0;
    for e: Any in xs { if (e == x) { c = c + 1; } }
    return c;
}

/// Return the first element satisfying the unary predicate, or `nil`.
fun find(xs: Any, x: Any) -> Any {
    let n: Any = len(xs);
    mut i: Any = 0;
    while (i < n) {
        if (xs[i] == x) { return i; }
        i = i + 1;
    }
    return -1;
}

/// Copy a contiguous section of a list. Bounds are clamped to the list length; the stop index is
/// exclusive.
///
/// Params:
/// - `xs`: The input list.
/// - `start`: The zero-based inclusive starting index.
/// - `stop`: The exclusive ending index.
///
/// Returns: A new list; empty if stop is not greater than start.
///
/// Example:
/// ```may
/// print(slice([10, 20, 30, 40], 1, 3)); // [20, 30]
/// ```
fun slice(xs: Any, start: Any, stop: Any) -> Any {
    let n: Any = len(xs);
    let a: Any = clamp(start, 0, n);
    let b: Any = clamp(stop, 0, n);
    let out: Any = [];
    mut i: Any = a;
    while (i < b) {
        push(out, xs[i]);
        i = i + 1;
    }
    return out;
}

/// Return `[index, value]` pairs in input order.
fun enumerate(xs: Any) -> Any {
    let out: Any = [];
    let n: Any = len(xs);
    for i: Any in 0..n { push(out, [i, xs[i]]); }
    return out;
}

/// Return paired elements, stopping at the shorter list.
fun zip(a: Any, b: Any) -> Any {
    let out: Any = [];
    let n: Any = min(len(a), len(b));
    for i: Any in 0..n { push(out, [a[i], b[i]]); }
    return out;
}

/// Return a one-level concatenation of nested lists.
fun flatten(xss: Any) -> Any {
    let out: Any = [];
    for xs: Any in xss { for x: Any in xs { push(out, x); } }
    return out;
}

/// Return distinct list values in first-occurrence order.
fun unique(xs: Any) -> Any {
    let out: Any = [];
    for x: Any in xs { if (!has(out, x)) { push(out, x); } }
    return out;
}

/// Return an exclusive-end arithmetic progression in either direction; step zero returns an empty
/// list.
///
/// Step zero returns an empty list; the stop is exclusive in either direction.
fun range_step(a: Any, b: Any, step: Any) -> Any {
    let out: Any = [];
    if (step == 0) { return out; }
    if (step > 0) {
        mut i: Any = a;
        while (i < b) { push(out, i); i = i + step; }
    } else {
        mut i: Any = a;
        while (i > b) { push(out, i); i = i + step; }
    }
    return out;
}

/// Prepend whole padding strings until the code-point width is reached; empty padding faults when
/// more text is needed.
fun pad_left(s: Any, width: Any, ch: Any) -> Any {
    mut out: Any = s;
    while (len(out) < width) { out = ch + out; }
    return out;
}

/// Append whole padding strings until the code-point width is reached; empty padding faults when
/// more text is needed.
fun pad_right(s: Any, width: Any, ch: Any) -> Any {
    mut out: Any = s;
    while (len(out) < width) { out = out + ch; }
    return out;
}

/// Split on LF, preserving empty fields.
fun split_lines(s: Any) -> Any { return split(s, "\n"); }

/// Look up `key` in a map, returning `fallback` when it is missing.
///
/// The implementation treats a nil lookup as absent, so a present nil value returns the fallback.
fun get(m: Any, key: Any, fallback: Any) -> Any {
    let v: Any = map_get(m, key);
    return if (v == nil) { fallback } else { v };
}

/// Call unary `f(i)` over integers `0..n`; return `nil`.
fun times(n: Any, f: Any) -> Any {
    for i: Any in 0..n { f(i); }
    return nil;
}

/// Call unary `f(x)` for every input element; return `nil`.
fun each(xs: Any, f: Any) -> Any {
    for x: Any in xs { f(x); }
    return nil;
}

/// Raise an assertion error if actual and expected values differ.
fun assert_eq(a: Any, b: Any) -> Any {
    if (value_eq(a, b)) { return nil; }
    raise_error("assert", "assertion failed: " + str(a) + " != " + str(b));
    return nil;
}

// -------------------------------------------------------------- C ABI
//
// `ccall(fn, args)` invokes machine code at a raw address with up to six
// integer arguments; `extern_c(fn)` wraps such an address as a callable value.

/// Call machine code at a raw address with up to six integer arguments using the native calling
/// convention.
///
/// Params:
/// - `fn`: The native function address.
/// - `args`: A list of at most six integer arguments.
///
/// Returns: The native integer return value.
///
/// Example:
/// ```may
/// // fn must be a valid native function address.
/// let result: Any = ccall(fn, [1, 2]);
/// ```
fun ccall(fn: Any, args: Any) -> Any {
    let n: Any = len(args);
    let a0: Any = if (n > 0) { args[0] } else { 0 };
    let a1: Any = if (n > 1) { args[1] } else { 0 };
    let a2: Any = if (n > 2) { args[2] } else { 0 };
    let a3: Any = if (n > 3) { args[3] } else { 0 };
    let a4: Any = if (n > 4) { args[4] } else { 0 };
    let a5: Any = if (n > 5) { args[5] } else { 0 };
    return __ccall6(fn, a0, a1, a2, a3, a4, a5);
}

/// Wrap a native function address as a callable Maylang function accepting six integer arguments.
///
/// The wrapper has six positional parameters and returns a raw integer C result; use ccall for a
/// list of up to six integer arguments.
///
/// Params:
/// - `fn`: The native function address.
///
/// Returns: A callable wrapper.
///
/// Example:
/// ```may
/// // fn must be a valid native function address.
/// let call: Any = extern_c(fn);
/// let result: Any = call(1, 2, 0, 0, 0, 0);
/// ```
fun extern_c(fn: Any) -> Any {
    fun tramp(a0: Any, a1: Any, a2: Any, a3: Any, a4: Any, a5: Any) -> Any {
        return __ccall6(fn, a0, a1, a2, a3, a4, a5);
    }
    return tramp;
}

// Trigonometry uses the shared portable implementation in runtime/math.may:
// x87 FSIN/FCOS/FPTAN reduce with a 66-bit pi, losing accuracy near multiples
// of pi/2, and return arguments above 2^63 unchanged. The portable reduction
// is exact for every finite input, and results match the core runtime bit for
// bit. Logarithms, exp and pow keep the faster x87 sequences (within one ulp).

/// Return the sine of `value`, an angle in radians.
///
/// Any finite argument is reduced exactly, and the result is within one ulp.
///
/// Params:
/// - `value`: The angle in radians.
///
/// Returns: A floating-point result.
///
/// Example:
/// ```may
/// print(sin(0.0));
/// ```
fun sin(value: Any) -> Any { return __math_trig(value, 0); }
/// Return the cosine of `value`, an angle in radians.
///
/// Any finite argument is reduced exactly, and the result is within one ulp.
///
/// Params:
/// - `value`: The angle in radians.
///
/// Returns: A floating-point result.
///
/// Example:
/// ```may
/// print(cos(0.0));
/// ```
fun cos(value: Any) -> Any { return __math_trig(value, 1); }
/// Return the tangent of `value`, an angle in radians.
///
/// Any finite argument is reduced exactly, and the result is within one ulp.
///
/// Params:
/// - `value`: The angle in radians.
///
/// Returns: A floating-point result.
///
/// Example:
/// ```may
/// print(tan(0.0));
/// ```
fun tan(value: Any) -> Any { return __math_trig(value, 2); }
