// stats.may — descriptive statistics and simple regression.
//
// Inputs are lists of Int or Float; every value is converted with to_float, so
// results are Floats. Functions that are undefined for short input return nil.

/// A least-squares line `y = slope * x + intercept`, with the correlation `r`, or nil when the y
/// values are constant.
struct Regression { slope: Float, intercept: Float, r: Optional<Float> }

/// Convert each Int or Float input to Float; internal stats helper.
fun stats_floats<T>(xs: List<T>) -> List<Float> { return [to_float(x) for x: T in xs]; }
/// Return the mean of nonempty Floats; internal stats helper.
fun stats_float_mean(xs: List<Float>) -> Float {
    mut total: Float = 0.0;
    for x: Float in xs { total += x; }
    return total / to_float(len(xs));
}
/// Return the sum of squared Floats; internal stats helper.
fun stats_float_sum_squares(xs: List<Float>) -> Float {
    mut total: Float = 0.0;
    for x: Float in xs { total += x * x; }
    return total;
}
/// Return the sample variance of two or more Floats; internal stats helper.
fun stats_float_sample_variance(xs: List<Float>) -> Float {
    let mu: Float = stats_float_mean(xs);
    return stats_float_sum_squares([x - mu for x: Float in xs]) / to_float(len(xs) - 1);
}

/// Return the floating arithmetic mean, or `nil` for empty input.
fun stats_mean<T>(xs: List<T>) -> Optional<Float> {
    if (len(xs) == 0) { return nil; }
    return stats_float_mean(stats_floats(xs));
}
/// Return the sum of squared values, starting at `0.0`.
fun stats_sum_squares<T>(xs: List<T>) -> Float { return stats_float_sum_squares(stats_floats(xs)); }
/// Return population variance (divide by `n`), or `nil` when empty.
fun stats_variance<T>(xs: List<T>) -> Optional<Float> {
    let n: Int = len(xs);
    if (n == 0) { return nil; }
    let values: List<Float> = stats_floats(xs);
    let mu: Float = stats_float_mean(values);
    return stats_float_sum_squares([x - mu for x: Float in values]) / to_float(n);
}
/// Return sample variance (divide by `n - 1`), or `nil` for fewer than two inputs.
fun stats_sample_variance<T>(xs: List<T>) -> Optional<Float> {
    if (len(xs) < 2) { return nil; }
    return stats_float_sample_variance(stats_floats(xs));
}
/// Return the square root of population variance, or `nil` when empty.
fun stats_stddev<T>(xs: List<T>) -> Optional<Float> {
    if (len(xs) == 0) { return nil; }
    return sqrt(stats_variance(xs) ?? 0.0);
}
/// Return standardized values using population deviation; empty/constant inputs produce zeros.
fun stats_zscores<T>(xs: List<T>) -> List<Float> {
    let values: List<Float> = stats_floats(xs);
    if (len(values) == 0) { return []; }
    let mu: Float = stats_float_mean(values);
    let sd: Float = stats_stddev(values) ?? 0.0;
    if (sd == 0.0) { return [0.0 for _: Float in values]; }
    return [(x - mu) / sd for x: Float in values];
}
/// Sort and linearly interpolate at `q * (n - 1)`; empty input returns `nil`; nonempty input
/// requires `q` in `[0, 1]`.
fun stats_quantile<T>(xs: List<T>, q: Float) -> Optional<Float> {
    if (len(xs) == 0) { return nil; }
    if (q < 0.0 || q > 1.0) { fail("quantile must be in [0, 1]"); }
    let s: List<Float> = sort(stats_floats(xs));
    let p: Float = q * to_float(len(s) - 1);
    let lo: Int = int(floor(p)); let hi: Int = int(ceil(p));
    return s[lo] + (s[hi] - s[lo]) * (p - to_float(lo));
}
/// Return `stats_quantile(xs, 0.5)`.
fun stats_median<T>(xs: List<T>) -> Optional<Float> { return stats_quantile(xs, 0.5); }
/// Return a most frequent original value, or `nil`; counts use stringified keys.
fun stats_mode<T>(xs: List<T>) -> Optional<T> {
    if (len(xs) == 0) { return nil; }
    let counts: Map<Str, Int> = {}; mut best: T = xs[0]; mut best_count: Int = 0;
    for x: T in xs {
        let k: Str = str(x);
        let count: Int = (counts[k] ?? 0) + 1;
        counts[k] = count;
        if (count > best_count) { best = x; best_count = count; }
    }
    return best;
}
/// Return sample covariance of the common prefix, or `nil` for fewer than two pairs.
fun stats_covariance<T, U>(xs: List<T>, ys: List<U>) -> Optional<Float> {
    let n: Int = min(len(xs), len(ys));
    if (n < 2) { return nil; }
    let x: List<Float> = stats_floats(slice(xs, 0, n)); let y: List<Float> = stats_floats(slice(ys, 0, n));
    let xm: Float = stats_float_mean(x); let ym: Float = stats_float_mean(y);
    mut accum: Float = 0.0;
    for i: Int in 0..n { accum += (x[i] - xm) * (y[i] - ym); }
    return accum / to_float(n - 1);
}
/// Return covariance divided by the two sample deviations; return `nil` for insufficient/constant
/// data. Use equal input lengths for consistent normalization.
fun stats_correlation<T, U>(xs: List<T>, ys: List<U>) -> Optional<Float> {
    if (min(len(xs), len(ys)) < 2) { return nil; }
    let cov: Float = stats_covariance(xs, ys) ?? 0.0;
    let sx: Float = sqrt(stats_float_sample_variance(stats_floats(xs)));
    let sy: Float = sqrt(stats_float_sample_variance(stats_floats(ys)));
    if (sx == 0.0 || sy == 0.0) { return nil; }
    return cov / (sx * sy);
}
/// Return the least-squares line through the common prefix; require at least two points and
/// varying x values.
fun stats_linear_regression<T, U>(xs: List<T>, ys: List<U>) -> Regression {
    let n: Int = min(len(xs), len(ys));
    if (n < 2) { fail("linear regression needs at least two points"); }
    let x: List<Float> = stats_floats(slice(xs, 0, n)); let y: List<Float> = stats_floats(slice(ys, 0, n));
    let vx: Float = stats_float_sample_variance(x);
    if (vx == 0.0) { fail("linear regression x values must vary"); }
    let slope: Float = (stats_covariance(x, y) ?? 0.0) / vx;
    return Regression(slope, stats_float_mean(y) - slope * stats_float_mean(x), stats_correlation(x, y));
}
