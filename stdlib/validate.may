// validate.may — reusable input predicates and structured validation.
//
// Predicates that inspect a value's runtime type (`validate_nonempty`,
// `validate_in_range`, the string-syntax checks and the rules) take `Any`:
// they exist to validate data whose type is not known statically, such as
// decoded JSON.

/// One validation rule: a predicate and the message reported when it fails.
struct ValidationRule { check: (Any) -> Bool, message: Str }

/// The outcome of `validate_all`: whether every rule passed, the failed rules' messages, and the
/// value that was checked.
struct Validation { ok: Bool, errors: List<Str>, value: Any }

/// The outcome of `validate_required_fields`: whether every field is present, and the missing
/// ones.
struct RequiredFields { ok: Bool, missing: List<Str> }

/// Report whether a value is a string with non-whitespace content after trimming.
fun validate_nonempty(s: Any) -> Bool { return type(s) == "Str" && len(trim(str(s))) > 0; }
/// Report whether an Int/Float lies within the inclusive bounds; false for other types.
fun validate_in_range(x: Any, lo: Float, hi: Float) -> Bool {
    if (type(x) != "Int" && type(x) != "Float") { return false; }
    let value: Float = to_float(x);
    return value >= lo && value <= hi;
}
/// Apply a simple @/domain-dot heuristic; this is not a complete email parser.
fun validate_email(s: Str) -> Bool {
    let at: Int = index_of(s, "@");
    if (at <= 0 || at >= len(s) - 3) { return false; }
    let domain: Str = join(slice(chars(s), at + 1, len(s)), "");
    let dot: Int = index_of(domain, ".");
    return dot > 0 && dot < len(domain) - 1 && index_of(domain, "@") < 0;
}
/// Report whether a string begins with `http://` or `https://`.
fun validate_url(s: Str) -> Bool { return starts_with(s, "https://") || starts_with(s, "http://"); }
/// Apply each rule to `value` and collect the messages of the rules that fail.
fun validate_all(value: Any, rules: List<ValidationRule>) -> Validation {
    let errors: List<Str> = [];
    for rule: ValidationRule in rules {
        let check: (Any) -> Bool = rule.check;
        if (!check(value)) { push(errors, rule.message); }
    }
    return Validation(len(errors) == 0, errors, value);
}
/// Report which `fields` are missing from `value`; absent keys and nil-valued fields are missing.
fun validate_required_fields(value: Map<Str, Any>, fields: List<Str>) -> RequiredFields {
    let missing: List<Str> = [];
    for field: Str in fields { if (!has(value, field) || value[field] == nil) { push(missing, field); } }
    return RequiredFields(len(missing) == 0, missing);
}
/// Check a nonempty string by attempting trimmed integer conversion and catching faults.
fun validate_int_string(s: Any) -> Bool {
    if (type(s) != "Str" || len(trim(str(s))) == 0) { return false; }
    let n: Int = may { int(trim(str(s))) } otherwise { return false; };
    return true;
}
/// Validate signed decimal syntax with optional dot and exponent; exponent digits are required.
fun validate_float_string(s: Any) -> Bool {
    if (type(s) != "Str" || len(trim(str(s))) == 0) { return false; }
    let cs: List<Str> = chars(trim(str(s))); let n: Int = len(cs); mut i: Int = 0;
    if (cs[i] == "+" || cs[i] == "-") { i = i + 1; }
    mut digits: Int = 0; mut dot: Bool = false;
    while (i < n) {
        let c: Str = cs[i];
        if (c >= "0" && c <= "9") { digits = digits + 1; i = i + 1; }
        else if (c == "." && !dot) { dot = true; i = i + 1; }
        else if ((c == "e" || c == "E") && digits > 0) {
            i = i + 1;
            if (i < n && (cs[i] == "+" || cs[i] == "-")) { i = i + 1; }
            let exponent_start: Int = i;
            while (i < n && cs[i] >= "0" && cs[i] <= "9") { i = i + 1; }
            return i == n && i > exponent_start;
        } else { return false; }
    }
    return digits > 0;
}
