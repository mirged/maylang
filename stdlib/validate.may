// validate.may — reusable input predicates and structured validation.

fun validate_nonempty(s: Any) -> Any { return type(s) == "Str" && len(trim(s)) > 0; }
fun validate_in_range(x: Any, lo: Any, hi: Any) -> Any {
    if (type(x) != "Int" && type(x) != "Float") { return false; }
    return x >= lo && x <= hi;
}
fun validate_email(s: Any) -> Any {
    let at: Any = index_of(s, "@");
    if (at <= 0 || at >= len(s) - 3) { return false; }
    let domain: Any = join(slice(chars(s), at + 1, len(s)), "");
    let dot: Any = index_of(domain, ".");
    return dot > 0 && dot < len(domain) - 1 && index_of(join(slice(chars(s), at + 1, len(s)), ""), "@") < 0;
}
fun validate_url(s: Any) -> Any { return starts_with(s, "https://") || starts_with(s, "http://"); }
fun validate_all(value: Any, rules: Any) -> Any {
    mut errors: Any = [];
    for rule: Any in rules {
        let predicate: Any = rule["check"];
        if (!predicate(value)) { push(errors, rule.message); }
    }
    return {"ok": len(errors) == 0, "errors": errors, "value": value};
}
fun validate_required_fields(value: Any, fields: Any) -> Any {
    mut missing: Any = [];
    for field: Any in fields { if (!has(value, field) || value[field] == nil) { push(missing, field); } }
    return {"ok": len(missing) == 0, "missing": missing};
}
fun validate_int_string(s: Any) -> Any {
    if (type(s) != "Str" || len(trim(s)) == 0) { return false; }
    let n: Any = may { int(trim(s)) } otherwise { return false; };
    return true;
}
fun validate_float_string(s: Any) -> Any {
    if (type(s) != "Str" || len(trim(s)) == 0) { return false; }
    let cs: Any = chars(trim(s)); let n: Any = len(cs); mut i: Any = 0;
    if (cs[i] == "+" || cs[i] == "-") { i = i + 1; }
    mut digits: Any = 0; mut dot: Any = false;
    while (i < n) {
        let c: Any = cs[i];
        if (c >= "0" && c <= "9") { digits = digits + 1; i = i + 1; }
        else if (c == "." && !dot) { dot = true; i = i + 1; }
        else if ((c == "e" || c == "E") && digits > 0) {
            i = i + 1;
            if (i < n && (cs[i] == "+" || cs[i] == "-")) { i = i + 1; }
            let exponent_start: Any = i;
            while (i < n && cs[i] >= "0" && cs[i] <= "9") { i = i + 1; }
            return i == n && i > exponent_start;
        } else { return false; }
    }
    return digits > 0;
}
