// csv.may — small RFC-4180-style CSV reader/writer.
// Supports commas/newlines and escaped quotes inside quoted cells.

/// Return rows of string cells; handle quoted commas/newlines, doubled quotes and CRLF; reject
/// unterminated quotes; skip blank unquoted lines.
fun csv_parse(text: Str) -> List<List<Str>> {
    let cs: List<Str> = chars(text); let n: Int = len(cs);
    mut rows: List<List<Str>> = []; mut row: List<Str> = []; mut cell: Str = ""; mut quoted: Bool = false; mut started: Bool = false; mut i: Int = 0;
    while (i < n) {
        let c: Str = cs[i];
        if (quoted) {
            if (c == "\"" && i + 1 < n && cs[i + 1] == "\"") { cell = cell + "\""; started = true; i = i + 2; continue; }
            if (c == "\"") { quoted = false; }
            else { cell = cell + c; }
        } else if (c == "\"" && len(cell) == 0) { quoted = true; started = true; }
        else if (c == ",") { push(row, cell); cell = ""; started = true; }
        else if (c == "\n" || c == "\r") {
            push(row, cell); cell = "";
            if (started || len(row) > 1) { push(rows, row); }
            row = []; started = false;
            if (c == "\r" && i + 1 < n && cs[i + 1] == "\n") { i = i + 1; }
        } else { cell = cell + c; started = true; }
        i = i + 1;
    }
    if (quoted) { fail("unterminated quoted CSV field"); }
    if (started || len(row) > 0) { push(row, cell); push(rows, row); }
    return rows;
}
/// Stringify and quote empty cells or cells containing commas, quotes or line breaks; double
/// embedded quotes.
fun csv_escape<T>(cell: T) -> Str {
    let s: Str = str(cell);
    return if (len(s) == 0 || contains(s, ",") || contains(s, "\"") || contains(s, "\n") || contains(s, "\r")) {
        "\"" + replace(s, "\"", "\"\"") + "\""
    } else { s };
}
/// Serialize row lists with commas and LF between rows, without a final newline.
fun csv_stringify<T>(rows: List<List<T>>) -> Str {
    let lines: List<Str> = [join([csv_escape(cell) for cell: T in row], ",") for row: List<T> in rows];
    return join(lines, "\n");
}
/// Return a list of maps keyed by headers; short rows fill with empty strings and extra cells are
/// ignored.
fun csv_records(headers: List<Str>, rows: List<List<Str>>) -> List<Map<Str, Str>> {
    let out: List<Map<Str, Str>> = [];
    for row: List<Str> in rows {
        let item: Map<Str, Str> = {};
        for i: Int in 0..len(headers) { item[headers[i]] = if (i < len(row)) { row[i] } else { "" }; }
        push(out, item);
    }
    return out;
}
