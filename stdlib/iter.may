// iter.may — composable list iteration helpers.

// The pairs stay `List<Any>`: an index and a value of another type cannot share
// one element type without tuple values.
/// Return `[index, value]` pairs in input order.
fun enumerate<T>(xs: List<T>) -> List<List<Any>> {
    let out: List<List<Any>> = [];
    for i: Int in 0..len(xs) { let pair: List<Any> = [i, xs[i]]; push(out, pair); }
    return out;
}
/// Return `f(a[i], b[i])` for each pair, stopping at the shorter list.
fun zip_with<A, B, C>(a: List<A>, b: List<B>, f: (A, B) -> C) -> List<C> {
    return [f(a[i], b[i]) for i: Int in 0..min(len(a), len(b))];
}
/// Return the first index satisfying `pred`, or `-1`.
fun find_index<T>(xs: List<T>, pred: (T) -> Bool) -> Int {
    mut i: Int = 0;
    while (i < len(xs)) { if (pred(xs[i])) { return i; } i = i + 1; }
    return -1;
}
/// Return the first value satisfying `pred`, or `fallback`.
fun find_value<T>(xs: List<T>, pred: (T) -> Bool, fallback: T) -> T {
    for x: T in xs { if (pred(x)) { return x; } }
    return fallback;
}
/// Return the longest initial prefix satisfying `pred`.
fun take_while<T>(xs: List<T>, pred: (T) -> Bool) -> List<T> {
    let out: List<T> = [];
    mut i: Int = 0;
    while (i < len(xs) && pred(xs[i])) { push(out, xs[i]); i = i + 1; }
    return out;
}
/// Return the suffix after the initial prefix satisfying `pred`.
fun drop_while<T>(xs: List<T>, pred: (T) -> Bool) -> List<T> {
    mut i: Int = 0;
    while (i < len(xs) && pred(xs[i])) { i = i + 1; }
    return slice(xs, i, len(xs));
}
/// Return `[seed, f(seed, x0), ...]`, including the initial accumulator.
fun scan<T, A>(xs: List<T>, seed: A, f: (A, T) -> A) -> List<A> {
    let out: List<A> = [seed];
    mut acc: A = seed;
    for x: T in xs { acc = f(acc, x); push(out, acc); }
    return out;
}
/// Return all overlapping consecutive windows of positive `width`; return `[]` when width exceeds
/// length.
fun windows<T>(xs: List<T>, width: Int) -> List<List<T>> {
    if (width <= 0) { fail("windows width must be positive"); }
    let out: List<List<T>> = [];
    if (width > len(xs)) { return out; }
    for i: Int in 0..(len(xs) - width + 1) { push(out, slice(xs, i, i + width)); }
    return out;
}
/// Return overlapping adjacent value pairs; fewer than two inputs produce `[]`.
fun pairwise<T>(xs: List<T>) -> List<List<T>> {
    let out: List<List<T>> = [];
    for i: Int in 1..len(xs) { push(out, [xs[i - 1], xs[i]]); }
    return out;
}
/// Sum the integer scores `f(x)` over inputs, starting at zero.
fun sum_by<T>(xs: List<T>, f: (T) -> Int) -> Int {
    mut total: Int = 0;
    for x: T in xs { total += f(x); }
    return total;
}
/// Return the element with the smallest `f(x)` score; `nil` for empty input; ties retain the
/// earliest element.
fun min_by<T, K>(xs: List<T>, f: (T) -> K) -> Optional<T> {
    if (len(xs) == 0) { return nil; }
    mut best: T = xs[0]; mut score: K = f(best);
    for x: T in slice(xs, 1, len(xs)) { let s: K = f(x); if (s < score) { best = x; score = s; } }
    return best;
}
/// Return the element with the largest `f(x)` score; `nil` for empty input; ties retain the
/// earliest element.
fun max_by<T, K>(xs: List<T>, f: (T) -> K) -> Optional<T> {
    if (len(xs) == 0) { return nil; }
    mut best: T = xs[0]; mut score: K = f(best);
    for x: T in slice(xs, 1, len(xs)) { let s: K = f(x); if (s > score) { best = x; score = s; } }
    return best;
}
/// Return occurrence counts keyed by `str(x)`.
fun frequencies<T>(xs: List<T>) -> Map<Str, Int> {
    let counts: Map<Str, Int> = {};
    for x: T in xs { let k: Str = str(x); counts[k] = (counts[k] ?? 0) + 1; }
    return counts;
}
// The pairs stay `List<Any>` because `a` and `b` may hold different types.
/// Return all `[x, y]` pairs, with `a` as the outer iteration.
fun cartesian<A, B>(a: List<A>, b: List<B>) -> List<List<Any>> {
    let out: List<List<Any>> = [];
    for x: A in a { for y: B in b { let pair: List<Any> = [x, y]; push(out, pair); } }
    return out;
}
