// math.may — integer and floating point helpers.
//
// The transcendental functions (sin/cos/tan/ln/...) are runtime built-ins; the
// combinatorial helpers are written here in Maylang.
//
// `square`, `cube`, `average` and `median` work on Int and Float alike and keep
// `Any`: strict typing has no numeric type bound, arithmetic on a type
// parameter is rejected, and Int is not implicitly widened to Float.

/// Return `x * x`.
fun square(x: Any) -> Any { return x * x; }

/// Return `x * x * x`.
fun cube(x: Any) -> Any { return x * x * x; }

/// Restrict `x` to the closed range `[lo, hi]`.
fun clamp<T>(x: T, lo: T, hi: T) -> T { return max(lo, min(x, hi)); }

/// Return the greatest common divisor of `a` and `b` (always non-negative).
fun gcd(a: Int, b: Int) -> Int {
    mut x: Int = abs(a);
    mut y: Int = abs(b);
    while (y != 0) {
        let t: Int = y;
        y = x % y;
        x = t;
    }
    return x;
}

/// Return the least common multiple of `a` and `b` (`0` when either is `0`).
fun lcm(a: Int, b: Int) -> Int {
    if (a == 0 || b == 0) { return 0; }
    return abs(a * b) / gcd(a, b);
}

/// Report whether `n` is prime, by trial division up to `sqrt(n)`.
fun is_prime(n: Int) -> Bool {
    if (n < 2) { return false; }
    if (n % 2 == 0) { return n == 2; }
    mut i: Int = 3;
    while (i * i <= n) {
        if (n % i == 0) { return false; }
        i = i + 2;
    }
    return true;
}

/// Return `n!`; `0!` and `1!` are `1`.
fun factorial(n: Int) -> Int {
    mut acc: Int = 1;
    for i: Int in 2..=n { acc = acc * i; }
    return acc;
}

/// Return the `n`th Fibonacci number, with `fibonacci(0) == 0`.
fun fibonacci(n: Int) -> Int {
    mut a: Int = 0;
    mut b: Int = 1;
    for _: Int in 1..=n {
        let t: Int = a + b;
        a = b;
        b = t;
    }
    return a;
}

/// Return the arithmetic mean of a list (`0` when empty).
fun average(xs: Any) -> Any {
    if (len(xs) == 0) { return 0; }
    return sum(xs) / len(xs);
}

/// Return the median of a list (`nil` when empty), sorting a copy.
fun median(xs: Any) -> Any {
    let sorted: Any = sort(xs);
    let n: Int = len(sorted);
    if (n == 0) { return nil; }
    if (n % 2 == 1) { return sorted[(n - 1) / 2]; }
    return (sorted[n / 2 - 1] + sorted[n / 2]) / 2;
}

/// Convert `radians` to degrees.
fun degrees(radians_of: Float) -> Float { return radians_of * 180.0 / pi(); }

/// Convert `degrees` to radians.
fun radians(degrees_of: Float) -> Float { return degrees_of * pi() / 180.0; }

/// Return the Euclidean distance between `(x1, y1)` and `(x2, y2)`.
fun distance(x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
    return sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2);
}

/// Report whether `n` is a power of two (`n > 0`).
fun is_power_of_two(n: Int) -> Bool {
    if (n <= 0) { return false; }
    mut v: Int = n;
    while (v > 1 && v % 2 == 0) { v = v / 2; }
    return v == 1;
}
