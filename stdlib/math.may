// math.may — integer and floating point helpers.
//
// The transcendental functions (sin/cos/tan/ln/...) are provided by the Rust
// runtime; the combinatorial helpers are written here in Maylang.

/// `x * x`.
fun square(x: Any) -> Any { return x * x; }

/// `x * x * x`.
fun cube(x: Any) -> Any { return x * x * x; }

/// Restrict `x` to the closed range `[lo, hi]`.
fun clamp(x: Any, lo: Any, hi: Any) -> Any { return max(lo, min(x, hi)); }

/// Greatest common divisor of `a` and `b` (always non-negative).
fun gcd(a: Any, b: Any) -> Any {
    mut x: Any = abs(a);
    mut y: Any = abs(b);
    while (y != 0) {
        let t: Any = y;
        y = x % y;
        x = t;
    }
    return x;
}

/// Least common multiple of `a` and `b` (`0` when either is `0`).
fun lcm(a: Any, b: Any) -> Any {
    if (a == 0 || b == 0) { return 0; }
    return abs(a * b) / gcd(a, b);
}

/// Whether `n` is prime. Trial division up to `sqrt(n)`.
fun is_prime(n: Any) -> Any {
    if (n < 2) { return false; }
    if (n % 2 == 0) { return n == 2; }
    mut i: Any = 3;
    while (i * i <= n) {
        if (n % i == 0) { return false; }
        i = i + 2;
    }
    return true;
}

/// `n!`. `0!` and `1!` are `1`.
fun factorial(n: Any) -> Any {
    mut acc: Any = 1;
    for i: Any in 2..=n { acc = acc * i; }
    return acc;
}

/// The `n`th Fibonacci number, with `fibonacci(0) == 0`.
fun fibonacci(n: Any) -> Any {
    mut a: Any = 0;
    mut b: Any = 1;
    for _: Any in 1..=n {
        let t: Any = a + b;
        a = b;
        b = t;
    }
    return a;
}

/// Arithmetic mean of a list (`0` when empty).
fun average(xs: Any) -> Any {
    if (len(xs) == 0) { return 0; }
    return sum(xs) / len(xs);
}

/// Median of a list (`nil` when empty). Sorts a copy.
fun median(xs: Any) -> Any {
    let sorted: Any = sort(xs);
    let n: Any = len(sorted);
    if (n == 0) { return nil; }
    if (n % 2 == 1) { return sorted[(n - 1) / 2]; }
    return (sorted[n / 2 - 1] + sorted[n / 2]) / 2;
}

/// Convert `radians` to degrees.
fun degrees(radians_of: Any) -> Any { return radians_of * 180.0 / pi(); }

/// Convert `degrees` to radians.
fun radians(degrees_of: Any) -> Any { return degrees_of * pi() / 180.0; }

/// Euclidean distance between `(x1, y1)` and `(x2, y2)`.
fun distance(x1: Any, y1: Any, x2: Any, y2: Any) -> Any {
    return sqrt(square(x2 - x1) + square(y2 - y1));
}

/// Whether `n` is a power of two (`n > 0`).
fun is_power_of_two(n: Any) -> Any {
    if (n <= 0) { return false; }
    mut v: Any = n;
    while (v > 1 && v % 2 == 0) { v = v / 2; }
    return v == 1;
}
