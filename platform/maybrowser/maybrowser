#!/bin/sh
browser_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$browser_dir/build/maybrowser" ]; then
    echo "maybrowser: run make -C $browser_dir build first" >&2
    exit 1
fi
export LD_LIBRARY_PATH="$browser_dir/build${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$browser_dir/build/maybrowser" "$@"
