// Portable core runtime: the common tagged scalar/collection ABI on all targets.
// Heap chunks live until process exit. This runtime has no collector,
// FFI or operating-system libraries.
mut CORE_HP: Any = 0;
mut CORE_END: Any = 0;
mut CORE_RETAINED: Any = 0;
mut STACKTOP: Any = 0;
mut HDEPTH: Any = 0;
mut HSTACK: Any = 0;
mut ERRFLAG: Any = 0;
mut ERRVAL: Any = 2;
fun rt_init() -> Any { HSTACK = rt_alloc(64 * 256); return 0; }
fun rt_gc_root(address: Any) -> Any { return 0; }
fun rt_exit(status: Any) -> Any { __host_exit(status / 8); return 2; }
fun __core_alloc(bytes: Any) -> Any { return rt_alloc(bytes / 8) * 8; }
fun __core_copy(destination: Any, source: Any, bytes: Any) -> Any { rt_copy(destination / 8, source / 8, bytes / 8); return 2; }
fun rt_alloc(n: Any) -> Any {
    if (n < 0 or n > 268435456) { __host_exit(70); }
    let need: Any = (n + 7) / 8 * 8 + 8;
    if (CORE_HP + need > CORE_END) {
        mut size: Any = 1048576;
        if (need > size) { size = (need + 4095) / 4096 * 4096; }
        if (CORE_RETAINED + size > 268435456) {
            rt_write(addr("core heap limit exceeded\n"), 25); __host_exit(70);
        }
        CORE_HP = __host_alloc(size);
        if (CORE_HP <= 0) { __host_exit(70); }
        CORE_END = CORE_HP + size;
        CORE_RETAINED += size;
    }
    let pointer: Any = CORE_HP;
    CORE_HP += need;
    return pointer;
}

// Owned scratch arena: the handle and backing bytes live for the process,
// while reset invalidates every returned pointer without allocating a chunk.
// Layout: [capacity, cursor, payload...]. Values are raw bytes, not GC objects.
fun __core_arena_new(bytes: Any) -> Any {
    let requested: Any = bytes / 8;
    if (requested < 0 or requested > 268435432) {
        rt_write(addr("invalid arena capacity\n"), 23); __host_exit(70);
    }
    let capacity: Any = (requested + 7) / 8 * 8;
    let arena: Any = rt_alloc(capacity + 16);
    store64(arena, capacity); store64(arena + 8, 0);
    return arena * 8;
}
fun __core_arena_alloc(handle: Any, bytes: Any) -> Any {
    let arena: Any = handle / 8;
    let count: Any = bytes / 8;
    let cursor: Any = load64(arena + 8);
    let capacity: Any = load64(arena);
    if (count < 0 or count > capacity - cursor) {
        rt_write(addr("arena capacity exceeded\n"), 24); __host_exit(70);
    }
    // Keep every pointer eight-byte aligned, including after odd-sized requests.
    let next: Any = (cursor + count + 7) / 8 * 8;
    if (next > capacity) {
        rt_write(addr("arena capacity exceeded\n"), 24); __host_exit(70);
    }
    store64(arena + 8, next);
    return (arena + 16 + cursor) * 8;
}
fun __core_arena_reset(handle: Any) -> Any { store64(handle / 8 + 8, 0); return 2; }
fun __core_arena_used(handle: Any) -> Any { return load64(handle / 8 + 8) * 8; }
fun __core_arena_capacity(handle: Any) -> Any { return load64(handle / 8) * 8; }
fun __core_heap_retained() -> Any { return CORE_RETAINED * 8; }

fun rt_write(pointer: Any, count: Any) -> Any {
    mut offset: Any = 0;
    while (offset < count) {
        let written: Any = __host_write(pointer + offset, count - offset);
        if (written <= 0) { __host_exit(70); }
        offset += written;
    }
    return 0;
}
fun __core_raise(kind: Any, length: Any, message: Any) -> Any {
    ERRFLAG = 1; ERRVAL = rt_map_new();
    rt_map_set(ERRVAL, rt_from(addr("__err"), 5), 4);
    rt_map_set(ERRVAL, rt_from(addr("kind"), 4), rt_from(kind, length));
    rt_map_set(ERRVAL, rt_from(addr("message"), 7), message);
    rt_map_set(ERRVAL, rt_from(addr("stack"), 5), rt_trace_snapshot());
    if (HDEPTH == 0) { return rt_die_uncaught(); }
    __longjmp(); return 2;
}
fun rt_fail(s: Any) -> Any { return __core_raise(addr("fail"), 4, s); }
fun rt_failtype(s: Any) -> Any { return __core_raise(addr("type"), 4, s); }
fun rt_failarith(s: Any) -> Any { return __core_raise(addr("arithmetic"), 10, s); }
fun rt_failstr(s: Any) -> Any { return __core_raise(addr("runtime"), 7, s); }
fun rt_handler_limit() -> Any {
    if (HDEPTH >= 64) { return rt_failstr(rt_from(addr("exception handler limit exceeded"), 32)); }
    return 0;
}
fun rt_int_contract(value: Any, low: Any, high: Any) -> Any {
    if (value % 8 != 0) { return rt_failtype(rt_from(addr("expected an integer"), 19)); }
    if (value < low or value > high) { return rt_failarith(rt_from(addr("integer outside annotated bounds"), 32)); }
    return value;
}
fun rt_die_uncaught() -> Any {
    let message: Any = rt_map_get(ERRVAL, rt_from(addr("message"), 7));
    rt_write(message + 7, rt_slen(message)); rt_write(addr("\n"), 1);
    let trace: Any = rt_map_get(ERRVAL, rt_from(addr("stack"), 5));
    if (trace % 8 == 1 and rt_slen(trace) > 0) { rt_write(trace + 7, rt_slen(trace)); }
    __host_exit(70); return 2;
}
fun rt_copy(d: Any, s: Any, n: Any) -> Any {
    mut i: Any = 0;
    while (i < n) {
        store8(d + i, load8(s + i));
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- strings

fun rt_strnew(ln: Any) -> Any {
    let p: Any = rt_alloc(ln + 9);
    store64(p, ln);
    store8(p + 8 + ln, 0);
    return p + 1;
}

fun rt_from(srcp: Any, srcl: Any) -> Any {
    let s: Any = rt_strnew(srcl);
    rt_copy(s + 7, srcp, srcl);
    return s;
}

fun rt_slen(v: Any) -> Any {
    return load64(v - 1);
}

// Tagged pointer to the string's bytes.

fun rt_addr(v: Any) -> Any {
    let t: Any = v % 8;
    if (t == 1) { return (v + 7) * 8; }
    if (t == 6) { return (v - 6) * 8; }
    return v;
}

// Fresh NUL-terminated copy, returned as a tagged address.

fun rt_cstr(v: Any) -> Any {
    let t: Any = v % 8;
    if (t == 1) {
        let ln: Any = rt_slen(v);
        let p: Any = rt_alloc(ln + 1);
        rt_copy(p, v + 7, ln);
        store8(p + ln, 0);
        return p * 8;
    }
    return v;
}

fun rt_concat(a: Any, b: Any) -> Any {
    let la: Any = rt_slen(a);
    let lb: Any = rt_slen(b);
    let s: Any = rt_strnew(la + lb);
    rt_copy(s + 7, a + 7, la);
    rt_copy(s + 7 + la, b + 7, lb);
    return s;
}

fun rt_str_eq(a: Any, b: Any) -> Any {
    let la: Any = rt_slen(a);
    let lb: Any = rt_slen(b);
    if (la != lb) { return 0; }
    mut i: Any = 0;
    while (i < la) {
        if (load8(a + 7 + i) != load8(b + 7 + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fun rt_str_lt(a: Any, b: Any) -> Any {
    let la: Any = rt_slen(a);
    let lb: Any = rt_slen(b);
    mut n: Any = la;
    if (lb < n) { n = lb; }
    mut i: Any = 0;
    while (i < n) {
        let ca: Any = load8(a + 7 + i);
        let cb: Any = load8(b + 7 + i);
        if (ca < cb) { return 1; }
        if (ca > cb) { return 0; }
        i = i + 1;
    }
    if (la < lb) { return 1; }
    return 0;
}

fun rt_str_cmp(a: Any, b: Any) -> Any {
    if (rt_str_eq(a, b) == 1) { return 0; }
    if (rt_str_lt(a, b) == 1) { return 0 - 8; }
    return 8;
}

fun rt_int_str(v: Any) -> Any {
    let n: Any = v / 8;
    let tmp: Any = rt_alloc(32);
    mut x: Any = n;
    mut neg: Any = 0;
    if (x < 0) { neg = 1; x = 0 - x; }
    mut d: Any = 0;
    if (x == 0) {
        store8(tmp, 48);
        d = 1;
    }
    while (x > 0) {
        store8(tmp + d, (x % 10) + 48);
        x = x / 10;
        d = d + 1;
    }
    mut ln: Any = d;
    if (neg == 1) { ln = d + 1; }
    let s: Any = rt_strnew(ln);
    mut o: Any = 0;
    if (neg == 1) { store8(s + 7, 45); o = 1; }
    mut k: Any = 0;
    while (k < d) {
        store8(s + 7 + o + k, load8(tmp + (d - 1 - k)));
        k = k + 1;
    }
    return s;
}

// Quoted form of a value, for nesting inside lists and maps.

fun rt_list_new(cap: Any) -> Any {
    let p: Any = rt_alloc(24);
    let d: Any = rt_alloc(cap * 8);
    store64(p, 0);
    store64(p + 8, cap);
    store64(p + 16, d);
    return p + 5;
}

fun rt_list_len(v: Any) -> Any {
    if (v % 8 != 5) { return rt_failtype(rt_from(addr("expected List"), 13)); }
    return load64(v - 5);
}

fun rt_list_set(l: Any, i: Any, x: Any) -> Any {
    let n: Any = rt_list_len(l);
    if (i % 8 != 0 or i < 0 or i / 8 >= n) { return rt_failtype(rt_from(addr("invalid list assignment"), 23)); }
    let p: Any = l - 5;
    let d: Any = load64(p + 16);
    store64(d + i, x);
    return x;
}

fun rt_list_get(l: Any, i: Any) -> Any {
    let n: Any = rt_list_len(l);
    if (i % 8 != 0 or i < 0 or i / 8 >= n) { return rt_failtype(rt_from(addr("invalid list index"), 18)); }
    let d: Any = load64(l - 5 + 16);
    return load64(d + i);
}

fun rt_push(l: Any, x: Any) -> Any {
    let len: Any = rt_list_len(l);
    let p: Any = l - 5;
    let cap: Any = load64(p + 8);
    if (len >= cap) {
        mut nc: Any = cap * 2;
        if (nc < 4) { nc = 4; }
        let nd: Any = rt_alloc(nc * 8);
        rt_copy(nd, load64(p + 16), len * 8);
        store64(p + 16, nd);
        store64(p + 8, nc);
    }
    let d: Any = load64(p + 16);
    store64(d + len * 8, x);
    store64(p, len + 1);
    return l;
}

fun utf8_seq(b: Any) -> Any {
    if (b < 128) { return 1; }
    if (b < 224) { return 2; }
    if (b < 240) { return 3; }
    return 4;
}

fun utf8_cplen(s: Any) -> Any {
    let n: Any = rt_slen(s);
    mut i: Any = 0;
    mut c: Any = 0;
    while (i < n) {
        i = i + utf8_seq(load8(s + 7 + i));
        c = c + 1;
    }
    return c;
}

fun utf8_off(s: Any, cp: Any) -> Any {
    let n: Any = rt_slen(s);
    mut i: Any = 0;
    mut k: Any = 0;
    while (i < n and k < cp) {
        i = i + utf8_seq(load8(s + 7 + i));
        k = k + 1;
    }
    return i;
}

fun utf8_decode(s: Any, off: Any) -> Any {
    let b0: Any = load8(s + 7 + off);
    if (b0 < 128) { return b0; }
    if (b0 < 224) {
        return (b0 - 192) * 64 + (load8(s + 8 + off) - 128);
    }
    if (b0 < 240) {
        return (b0 - 224) * 4096 + (load8(s + 8 + off) - 128) * 64 + (load8(s + 9 + off) - 128);
    }
    return (b0 - 240) * 262144 + (load8(s + 8 + off) - 128) * 4096 + (load8(s + 9 + off) - 128) * 64 + (load8(s + 10 + off) - 128);
}

fun utf8_encode(c: Any) -> Any {
    if (c < 128) {
        let s: Any = rt_strnew(1);
        store8(s + 7, c);
        return s;
    }
    if (c < 2048) {
        let s: Any = rt_strnew(2);
        store8(s + 7, 192 + c / 64);
        store8(s + 8, 128 + c % 64);
        return s;
    }
    if (c < 65536) {
        let s: Any = rt_strnew(3);
        store8(s + 7, 224 + c / 4096);
        store8(s + 8, 128 + (c / 64) % 64);
        store8(s + 9, 128 + c % 64);
        return s;
    }
    let s: Any = rt_strnew(4);
    store8(s + 7, 240 + c / 262144);
    store8(s + 8, 128 + (c / 4096) % 64);
    store8(s + 9, 128 + (c / 64) % 64);
    store8(s + 10, 128 + c % 64);
    return s;
}

fun rt_char_at(s: Any, i: Any) -> Any {
    return utf8_decode(s, utf8_off(s, i / 8)) * 8;
}

fun rt_char_from(c: Any) -> Any {
    return utf8_encode(c / 8);
}

fun rt_substr(s: Any, a: Any, b: Any) -> Any {
    let bo: Any = utf8_off(s, a);
    let eo: Any = utf8_off(s, b);
    mut ln: Any = eo - bo;
    if (ln < 0) { ln = 0; }
    let r: Any = rt_strnew(ln);
    rt_copy(r + 7, s + 7 + bo, ln);
    return r;
}

fun rt_sub_eq(s: Any, off: Any, sep: Any) -> Any {
    let m: Any = rt_slen(sep);
    mut j: Any = 0;
    while (j < m) {
        if (load8(s + 7 + off + j) != load8(sep + 7 + j)) { return 0; }
        j = j + 1;
    }
    return 1;
}

fun rt_contains(s: Any, sub: Any) -> Any {
    let n: Any = rt_slen(s);
    let m: Any = rt_slen(sub);
    if (m == 0) { return 4; }
    mut i: Any = 0;
    while (i + m <= n) {
        if (rt_sub_eq(s, i, sub) == 1) { return 4; }
        i = i + 1;
    }
    return 3;
}

fun rt_starts_with(s: Any, sub: Any) -> Any {
    if (rt_slen(sub) > rt_slen(s)) { return 3; }
    if (rt_sub_eq(s, 0, sub) == 1) { return 4; }
    return 3;
}

fun rt_ends_with(s: Any, sub: Any) -> Any {
    let n: Any = rt_slen(s);
    let m: Any = rt_slen(sub);
    if (m > n) { return 3; }
    if (rt_sub_eq(s, n - m, sub) == 1) { return 4; }
    return 3;
}

fun rt_index_of(s: Any, sub: Any) -> Any {
    let n: Any = rt_slen(s);
    let m: Any = rt_slen(sub);
    mut i: Any = 0;
    while (i + m <= n) {
        if (rt_sub_eq(s, i, sub) == 1) { return i * 8; }
        i = i + 1;
    }
    return 0 - 8;
}

fun rt_split(s: Any, sep: Any) -> Any {
    let n: Any = rt_slen(s);
    let m: Any = rt_slen(sep);
    let l: Any = rt_list_new(4);
    if (m == 0) {
        rt_push(l, s);
        return l;
    }
    mut start: Any = 0;
    mut i: Any = 0;
    while (i + m <= n) {
        if (rt_sub_eq(s, i, sep) == 1) {
            rt_push(l, rt_from(s + 7 + start, i - start));
            start = i + m;
            i = start;
        } else {
            i = i + 1;
        }
    }
    rt_push(l, rt_from(s + 7 + start, n - start));
    return l;
}

fun rt_repeat(s: Any, nv: Any) -> Any {
    let k: Any = nv / 8;
    let ln: Any = rt_slen(s);
    let r: Any = rt_strnew(ln * k);
    mut i: Any = 0;
    while (i < k) {
        rt_copy(r + 7 + i * ln, s + 7, ln);
        i = i + 1;
    }
    return r;
}

fun rt_join(l: Any, sep: Any) -> Any {
    let n: Any = rt_list_len(l);
    if (n == 0) { return rt_from(addr(""), 0); }
    mut r: Any = rt_list_get(l, 0);
    mut i: Any = 1;
    while (i < n) {
        r = rt_concat(rt_concat(r, sep), rt_list_get(l, i * 8));
        i = i + 1;
    }
    return r;
}

fun rt_pop(l: Any) -> Any {
    let n: Any = rt_list_len(l);
    let p: Any = l - 5;
    if (n == 0) { return 2; }
    let d: Any = load64(p + 16);
    let x: Any = load64(d + (n - 1) * 8);
    store64(p, n - 1);
    return x;
}

fun rt_range(a: Any, b: Any, incl: Any) -> Any {
    let s: Any = a / 8;
    let e: Any = b / 8;
    let l: Any = rt_list_new(4);
    if (s <= e) {
        mut i: Any = s;
        while (i < e) { rt_push(l, i * 8); i = i + 1; }
        if (incl == 4) { rt_push(l, e * 8); }
    }
    return l;
}

fun rt_newline() -> Any {
    rt_write(addr("\n"), 1);
    return 0;
}

fun rt_space() -> Any {
    rt_write(addr(" "), 1);
    return 0;
}

// Scalar C-ABI conversion used only by declared extern wrappers.

fun rt_print_str(v: Any) -> Any {
    rt_write(v + 7, rt_slen(v));
    return 0;
}

fun rt_not(a: Any) -> Any {
    let t: Any = a % 8;
    if (t == 2) { return 4; }
    if (t == 3) { return 4; }
    return 3;
}

fun rt_chr(v: Any) -> Any {
    return utf8_encode(v / 8);
}

fun rt_ord(v: Any) -> Any {
    let t: Any = v % 8;
    if (t == 1) { return load8(v + 7) * 8; }
    return 0;
}

// ---------------------------------------------------------------- maps

fun rt_map_new() -> Any {
    // Keep insertion-ordered pairs at the original offsets. The optional
    // string-key index accelerates records/symbol tables without changing
    // equality for non-string keys or iteration order.
    let p: Any = rt_alloc(40);
    let d: Any = rt_alloc(8);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, d);
    store64(p + 24, 0);
    store64(p + 32, 0);
    return p + 7;
}

fun rt_key_hash(k: Any) -> Any {
    let n: Any = rt_slen(k);
    mut h: Any = 5381;
    mut i: Any = 0;
    while (i < n) { h = (h * 131 + load8(k + 7 + i)) % 2147483647; i += 1; }
    return h;
}

fun rt_map_index(m: Any, index: Any) -> Any {
    let p: Any = m - 7;
    let d: Any = load64(p + 16);
    let k: Any = load64(d + index * 16);
    if (k % 8 != 1) { return 0; }
    let cap: Any = load64(p + 32);
    let table: Any = load64(p + 24);
    mut slot: Any = rt_key_hash(k) % cap;
    while (load64(table + slot * 8) != 0) { slot = (slot + 1) % cap; }
    store64(table + slot * 8, index + 1);
    return 0;
}

fun rt_map_rehash(m: Any) -> Any {
    let p: Any = m - 7;
    let n: Any = load64(p);
    mut cap: Any = 16;
    while (cap < n * 2) { cap *= 2; }
    let table: Any = rt_alloc(cap * 8);
    mut i: Any = 0;
    while (i < cap) { store64(table + i * 8, 0); i += 1; }
    store64(p + 24, table); store64(p + 32, cap);
    i = 0;
    while (i < n) { rt_map_index(m, i); i += 1; }
    return 0;
}

fun rt_map_find(m: Any, k: Any) -> Any {
    if (m % 8 != 7) { return 0 - 1; }
    let p: Any = m - 7;
    let n: Any = load64(p);
    let d: Any = load64(p + 16);
    let cap: Any = load64(p + 32);
    if (cap != 0 and k % 8 == 1) {
        let table: Any = load64(p + 24);
        mut slot: Any = rt_key_hash(k) % cap;
        mut entry: Any = load64(table + slot * 8);
        while (entry != 0) {
            if (rt_eq(load64(d + (entry - 1) * 16), k) == 4) { return entry - 1; }
            slot = (slot + 1) % cap;
            entry = load64(table + slot * 8);
        }
        return 0 - 1;
    }
    mut i: Any = 0;
    while (i < n) {
        if (rt_eq(load64(d + i * 16), k) == 4) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fun rt_map_set(m: Any, k: Any, v: Any) -> Any {
    if (m % 8 != 7) { return v; }
    let p: Any = m - 7;
    let idx: Any = rt_map_find(m, k);
    if (idx >= 0) {
        let d: Any = load64(p + 16);
        store64(d + idx * 16 + 8, v);
        return v;
    }
    let n: Any = load64(p);
    let cap: Any = load64(p + 8);
    if (n >= cap) {
        mut nc: Any = cap * 2;
        if (nc < 4) { nc = 4; }
        let nd: Any = rt_alloc(nc * 16);
        rt_copy(nd, load64(p + 16), n * 16);
        store64(p + 16, nd);
        store64(p + 8, nc);
    }
    let d: Any = load64(p + 16);
    store64(d + n * 16, k);
    store64(d + n * 16 + 8, v);
    store64(p, n + 1);
    let hashcap: Any = load64(p + 32);
    if (n + 1 >= 8 and (hashcap == 0 or (n + 1) * 4 >= hashcap * 3)) { rt_map_rehash(m); }
    else if (hashcap != 0) { rt_map_index(m, n); }
    return v;
}

fun rt_map_get(m: Any, k: Any) -> Any {
    let idx: Any = rt_map_find(m, k);
    if (idx < 0) { return 2; }
    let d: Any = load64(m - 7 + 16);
    return load64(d + idx * 16 + 8);
}

fun rt_map_len(m: Any) -> Any {
    return load64(m - 7);
}


fun rt_keys(m: Any) -> Any {
    let n: Any = rt_map_len(m);
    let d: Any = load64(m - 7 + 16);
    let l: Any = rt_list_new(n);
    mut i: Any = 0;
    while (i < n) {
        rt_push(l, load64(d + i * 16));
        i = i + 1;
    }
    return l;
}

fun rt_values(m: Any) -> Any {
    let n: Any = rt_map_len(m);
    let d: Any = load64(m - 7 + 16);
    let l: Any = rt_list_new(n);
    mut i: Any = 0;
    while (i < n) {
        rt_push(l, load64(d + i * 16 + 8));
        i = i + 1;
    }
    return l;
}

fun rt_merge_into(dst: Any, src: Any) -> Any {
    let n: Any = rt_map_len(src);
    let d: Any = load64(src - 7 + 16);
    mut i: Any = 0;
    while (i < n) {
        rt_map_set(dst, load64(d + i * 16), load64(d + i * 16 + 8));
        i = i + 1;
    }
    return dst;
}

fun rt_merge(a: Any, b: Any) -> Any {
    let r: Any = rt_map_new();
    mut n: Any = rt_map_len(a);
    mut d: Any = load64(a - 7 + 16);
    mut i: Any = 0;
    while (i < n) {
        rt_map_set(r, load64(d + i * 16), load64(d + i * 16 + 8));
        i = i + 1;
    }
    n = rt_map_len(b);
    d = load64(b - 7 + 16);
    i = 0;
    while (i < n) {
        rt_map_set(r, load64(d + i * 16), load64(d + i * 16 + 8));
        i = i + 1;
    }
    return r;
}

fun rt_has(m: Any, key: Any) -> Any {
    if (m % 8 == 7) { if (rt_map_find(m, key) >= 0) { return 4; } return 3; }
    if (m % 8 == 1) { return rt_contains(m, key); }
    if (m % 8 == 5) {
        mut i: Any = 0;
        while (i < rt_list_len(m)) {
            if (rt_eq(rt_list_get(m, i * 8), key) == 4) { return 4; }
            i += 1;
        }
    }
    return 3;
}

fun rt_len(v: Any) -> Any {
    if (v % 8 == 1) { return utf8_cplen(v) * 8; }
    if (v % 8 == 5) { return rt_list_len(v) * 8; }
    if (v % 8 == 7) { return rt_map_len(v) * 8; }
    return rt_failtype(rt_from(addr("len requires a string, list or map"), 33));
}

fun rt_index_get(v: Any, index: Any) -> Any {
    if (v % 8 == 7) { return rt_map_get(v, index); }
    if (index % 8 != 0) { return rt_failtype(rt_from(addr("index requires an integer"), 25)); }
    if (v % 8 == 5) {
        if (index < 0 or index / 8 >= rt_list_len(v)) { return 2; }
        return rt_list_get(v, index);
    }
    if (v % 8 == 1) {
        if (index < 0 or index / 8 >= utf8_cplen(v)) { return 2; }
        return utf8_encode(utf8_decode(v, utf8_off(v, index / 8)));
    }
    return rt_failtype(rt_from(addr("index requires a string or list"), 31));
}

fun rt_index_set(v: Any, index: Any, item: Any) -> Any {
    if (v % 8 == 7) { return rt_map_set(v, index, item); }
    if (v % 8 != 5 or index % 8 != 0 or index < 0 or index / 8 >= rt_list_len(v)) {
        return rt_failtype(rt_from(addr("invalid list assignment"), 23));
    }
    return rt_list_set(v, index, item);
}

fun rt_extend(target: Any, source: Any) -> Any {
    mut index: Any = 0; let count: Any = rt_list_len(source);
    while (index < count) { rt_push(target, rt_list_get(source, index * 8)); index += 1; }
    return target;
}

fun rt_slice(v: Any, begin: Any, end: Any) -> Any {
    let n: Any = rt_list_len(v);
    mut a: Any = begin / 8; mut b: Any = end / 8;
    if (a < 0) { a = 0; } if (b > n) { b = n; } if (b < a) { b = a; }
    let out: Any = rt_list_new(0);
    while (a < b) { rt_push(out, rt_list_get(v, a * 8)); a += 1; }
    return out;
}

fun __core_substring(s: Any, begin: Any, count: Any) -> Any {
    mut a: Any = begin / 8; mut n: Any = count / 8;
    if (a < 0) { a = 0; } if (n < 0) { n = 0; }
    return rt_substr(s, a, a + n);
}

fun rt_eq(a: Any, b: Any) -> Any {
    if (a % 8 == 6 and b % 8 == 6) { return __fcmp(0, a, b); }
    if (a == b) { return 4; }
    if (a % 8 == 1 and b % 8 == 1 and rt_str_eq(a, b) == 1) { return 4; }
    if (a % 8 == 5 and b % 8 == 5) { return __core_equal(a, b, rt_list_new(0)); }
    return 3;
}
fun __core_equal(a: Any, b: Any, path: Any) -> Any {
    if (a == b) { return 4; }
    if (a % 8 != 5 or b % 8 != 5) { return rt_eq(a, b); }
    let count: Any = rt_list_len(a);
    if (count != rt_list_len(b)) { return 3; }
    mut i: Any = 0;
    while (i < rt_list_len(path)) {
        if (rt_list_get(path, i * 8) == a and rt_list_get(path, (i + 1) * 8) == b) { return 4; }
        i += 2;
    }
    rt_push(path, a); rt_push(path, b); i = 0;
    while (i < count) {
        if (__core_equal(rt_list_get(a, i * 8), rt_list_get(b, i * 8), path) != 4) { rt_pop(path); rt_pop(path); return 3; }
        i += 1;
    }
    rt_pop(path); rt_pop(path); return 4;
}
fun rt_ne(a: Any, b: Any) -> Any { if (a % 8 == 6 or b % 8 == 6) { return __fcmp(1, rt_to_f(a), rt_to_f(b)); } return rt_not(rt_eq(a, b)); }
fun rt_lt(a: Any, b: Any) -> Any {
    if (a % 8 == 6 or b % 8 == 6) { return __fcmp(2, rt_to_f(a), rt_to_f(b)); }
    if (a % 8 == 1 and b % 8 == 1) { if (rt_str_lt(a, b) == 1) { return 4; } return 3; }
    if (a < b) { return 4; } return 3;
}
fun rt_le(a: Any, b: Any) -> Any { if (rt_lt(a, b) == 4) { return 4; } return rt_eq(a, b); }
fun rt_gt(a: Any, b: Any) -> Any { return rt_lt(b, a); }
fun rt_ge(a: Any, b: Any) -> Any { return rt_le(b, a); }
fun rt_bool(v: Any) -> Any { if (v == 2 or v == 3) { return 3; } return 4; }
fun rt_min(a: Any, b: Any) -> Any { if (rt_lt(a, b) == 4) { return a; } return b; }
fun rt_max(a: Any, b: Any) -> Any { if (rt_lt(a, b) == 4) { return b; } return a; }

fun rt_add(a: Any, b: Any) -> Any {
    if (a % 8 == 7) {
        let method: Any = rt_map_get(a, rt_from(addr("+"), 1));
        if (method != 2) { return method(a, b); }
    }
    if (a % 8 == 1 and b % 8 == 1) { return rt_concat(a, b); }
    if (a % 8 == 5 and b % 8 == 5) { let result: Any = rt_list_new(0); rt_extend(result, a); rt_extend(result, b); return result; }
    if (a % 8 == 6 or b % 8 == 6) { return __fbin(0, rt_to_f(a), rt_to_f(b)); }
    if (a % 8 != 0 or b % 8 != 0) { return rt_failtype(rt_from(addr("expected integers or strings"), 28)); }
    let sum: Any = a + b;
    if ((a >= 0 and b >= 0 and sum < 0) or (a < 0 and b < 0 and sum >= 0)) { return rt_failarith(rt_from(addr("integer overflow"), 16)); }
    return sum;
}
fun rt_sub(a: Any, b: Any) -> Any {
    if (a % 8 == 7) {
        let method: Any = rt_map_get(a, rt_from(addr("-"), 1));
        if (method != 2) { return method(a, b); }
    }
    if (a % 8 == 6 or b % 8 == 6) { return __fbin(1, rt_to_f(a), rt_to_f(b)); }
    if (a % 8 != 0 or b % 8 != 0) { return rt_failtype(rt_from(addr("expected integers"), 17)); }
    let difference: Any = a - b;
    if ((a >= 0 and b < 0 and difference < 0) or (a < 0 and b >= 0 and difference >= 0)) { return rt_failarith(rt_from(addr("integer overflow"), 16)); }
    return difference;
}
fun rt_mul(a: Any, b: Any) -> Any {
    if (a % 8 == 7) {
        let method: Any = rt_map_get(a, rt_from(addr("*"), 1));
        if (method != 2) { return method(a, b); }
    }
    if (a % 8 == 6 or b % 8 == 6) { return __fbin(2, rt_to_f(a), rt_to_f(b)); }
    if (a % 8 != 0 or b % 8 != 0) { return rt_failtype(rt_from(addr("expected integers"), 17)); }
    if (a == 0 or b == 0) { return 0; }
    let product: Any = (a / 8) * b;
    if (product / b != a / 8) { return rt_failarith(rt_from(addr("integer overflow"), 16)); }
    return product;
}
fun rt_div(a: Any, b: Any) -> Any {
    if (a % 8 == 7) {
        let method: Any = rt_map_get(a, rt_from(addr("/"), 1));
        if (method != 2) { return method(a, b); }
    }
    if (a % 8 == 6 or b % 8 == 6) {
        let divisor: Any = rt_to_f(b);
        if (__fcmp(0, divisor, rt_box(0)) == 4) { return rt_failarith(rt_from(addr("division by zero"), 16)); }
        return __fbin(3, rt_to_f(a), divisor);
    }
    if (a % 8 != 0 or b % 8 != 0) { return rt_failtype(rt_from(addr("expected integers"), 17)); }
    if (b == 0) { return rt_failarith(rt_from(addr("division by zero"), 16)); }
    if (a / 8 == -1152921504606846976 and b == -8) { return rt_failarith(rt_from(addr("integer overflow"), 16)); }
    return (a / b) * 8;
}
fun rt_mod(a: Any, b: Any) -> Any {
    if (a % 8 == 7) {
        let method: Any = rt_map_get(a, rt_from(addr("%"), 1));
        if (method != 2) { return method(a, b); }
    }
    if (a % 8 != 0 or b % 8 != 0) { return rt_failtype(rt_from(addr("expected integers"), 17)); }
    if (b == 0) { return rt_failarith(rt_from(addr("division by zero"), 16)); }
    return ((a / 8) % (b / 8)) * 8;
}
fun rt_neg(a: Any) -> Any {
    if (a % 8 == 6) { return __fbin(2, a, rt_const_hi_lo(3220176896, 0)); }
    return rt_sub(0, a);
}
fun rt_abs(a: Any) -> Any { if (a % 8 == 6) { return __fabs(a); } if (a < 0) { return rt_neg(a); } return a; }
fun rt_pow(a: Any, b: Any) -> Any {
    if (a % 8 == 6 or b % 8 == 6) { return rt_failtype(rt_from(addr("floating-point powers require the full runtime"), 46)); }
    if (b < 0) { return rt_failarith(rt_from(addr("negative integer exponent"), 25)); }
    mut out: Any = 8; mut base: Any = a; mut exponent: Any = b / 8;
    while (exponent > 0) {
        if (exponent % 2 == 1) { out = rt_mul(out, base); }
        exponent /= 2; if (exponent > 0) { base = rt_mul(base, base); }
    }
    return out;
}
fun rt_int(s: Any) -> Any {
    if (s % 8 == 6) { return __ftrunc(load64(s - 6)) * 8; }
    if (s % 8 == 0) { return s; }
    if (s % 8 != 1) { return rt_failtype(rt_from(addr("int requires a string"), 21)); }
    let n: Any = rt_slen(s); mut i: Any = 0; mut negative: Any = 0; mut value: Any = 0;
    if (n > 0 and load8(s + 7) == 45) { negative = 1; i = 1; }
    let limit: Any = if (negative == 1) { -1152921504606846976 } else { -1152921504606846975 };
    while (i < n) {
        let digit: Any = load8(s + 7 + i) - 48;
        if (digit < 0 or digit > 9) { break; }
        if (value < (limit + digit) / 10) { return rt_failarith(rt_from(addr("integer overflow"), 16)); }
        value = value * 10 - digit; i += 1;
    }
    if (negative == 0) { value = 0 - value; }
    return value * 8;
}

fun rt_repr_elem(v: Any, path: Any) -> Any {
    let t: Any = v % 8;
    if (t == 1) {
        let n: Any = rt_slen(v);
        let q: Any = rt_strnew(n + 2);
        store8(q + 7, 34);
        rt_copy(q + 8, v + 7, n);
        store8(q + 8 + n, 34);
        return q;
    }
    return rt_repr_value(v, path);
}

fun rt_repr_list(v: Any, path: Any) -> Any {
    mut out: Any = rt_from(addr("["), 1);
    let n: Any = rt_list_len(v);
    mut i: Any = 0;
    while (i < n) {
        if (i > 0) { out = rt_concat(out, rt_from(addr(", "), 2)); }
        out = rt_concat(out, rt_repr_elem(rt_list_get(v, i * 8), path));
        i = i + 1;
    }
    return rt_concat(out, rt_from(addr("]"), 1));
}

fun rt_repr_map(v: Any, path: Any) -> Any {
    let p: Any = v - 7;
    let n: Any = load64(p);
    let d: Any = load64(p + 16);
    let idx: Any = rt_alloc(n * 8 + 8);
    mut i: Any = 0;
    while (i < n) {
        store64(idx + i * 8, i * 16);
        i = i + 1;
    }
    mut a: Any = 1;
    while (a < n) {
        let key: Any = load64(idx + a * 8);
        mut j: Any = a;
        while (j > 0) {
            let pk: Any = load64(idx + (j - 1) * 8);
            if (rt_lt(load64(d + key), load64(d + pk)) == 4) {
                store64(idx + j * 8, pk);
                j = j - 1;
            } else {
                break;
            }
        }
        store64(idx + j * 8, key);
        a = a + 1;
    }
    mut out: Any = rt_from(addr("{"), 1);
    i = 0;
    while (i < n) {
        if (i > 0) { out = rt_concat(out, rt_from(addr(", "), 2)); }
        let o: Any = load64(idx + i * 8);
        out = rt_concat(out, rt_repr_elem(load64(d + o), path));
        out = rt_concat(out, rt_from(addr(": "), 2));
        out = rt_concat(out, rt_repr_elem(load64(d + o + 8), path));
        i = i + 1;
    }
    return rt_concat(out, rt_from(addr("}"), 1));
}

fun rt_to_str(v: Any) -> Any { return rt_repr_value(v, 0); }

// fun str(v) { return rt_to_str(v); }

fun rt_repr_value(v: Any, path: Any) -> Any {
    if (v % 8 == 5 or v % 8 == 7) {
        mut parent: Any = path;
        while (parent != 0) {
            if (load64(parent) == v) { return rt_from(addr("<cycle>"), 7); }
            parent = load64(parent + 8);
        }
        let link: Any = rt_alloc(16);
        store64(link, v); store64(link + 8, path); path = link;
    }
    let t: Any = v % 8;
    if (t == 7) {
        if (rt_map_find(v, rt_from(addr("__err"), 5)) >= 0) {
            return rt_map_get(v, rt_from(addr("message"), 7));
        }
    }
    if (t == 1) { return v; }
    if (t == 0) { return rt_int_str(v); }
    if (t == 6) { return rt_fstr(v); }
    if (t == 2) { return rt_from(addr("nil"), 3); }
    if (t == 3) { return rt_from(addr("false"), 5); }
    if (t == 4) { return rt_from(addr("true"), 4); }
    if (t == 5) { return rt_repr_list(v, path); }
    if (t == 7) { return rt_repr_map(v, path); }
    return rt_from(addr("?"), 1);
}


fun rt_lower(s: Any) -> Any {
    let n: Any = rt_slen(s); let result: Any = rt_strnew(n); mut i: Any = 0;
    while (i < n) {
        mut c: Any = load8(s + 7 + i); if (c >= 65 and c <= 90) { c += 32; }
        store8(result + 7 + i, c); i += 1;
    }
    return result;
}
fun rt_upper(s: Any) -> Any {
    let n: Any = rt_slen(s); let result: Any = rt_strnew(n); mut i: Any = 0;
    while (i < n) {
        mut c: Any = load8(s + 7 + i); if (c >= 97 and c <= 122) { c -= 32; }
        store8(result + 7 + i, c); i += 1;
    }
    return result;
}
fun rt_cmp(a: Any, b: Any) -> Any {
    if (rt_eq(a, b) == 4) { return 0; } if (rt_lt(a, b) == 4) { return -8; } return 8;
}

// ---------------------------------------------------------------- printing

// ---------------------------------------------------------------- callables

mut CORE_CALLABLES: Any = 0;

fun rt_env_new(n: Any) -> Any {
    return rt_alloc(n * 8);
}

fun rt_closure(code: Any, env: Any) -> Any {
    let p: Any = rt_alloc(40);
    store64(p + 32, CORE_CALLABLES); CORE_CALLABLES = p;
    store64(p + 24, 1296128323);
    store64(p, code);
    store64(p + 8, env);
    store64(p + 16, 0);
    return p;
}

// Closure with an explicit arity (word at +16), used to pad short argument
// lists when a closure is applied with fewer arguments than it declares.
fun rt_closure3(code: Any, env: Any, arity: Any) -> Any {
    let p: Any = rt_alloc(40);
    store64(p + 32, CORE_CALLABLES); CORE_CALLABLES = p;
    store64(p + 24, 1296128323);
    store64(p, code);
    store64(p + 8, env);
    store64(p + 16, arity);
    return p;
}

// Validate before reading the closure payload; ordinary integers are also tag 0.
fun rt_box_val(v: Any) -> Any {
    let p: Any = rt_alloc(8);
    store64(p, v);
    return p;
}

// Validate identity before dereferencing a value: tagged integers are also
// tag zero. The process-lifetime registry contains only allocated closures.
fun rt_require_callable(value: Any) -> Any {
    mut entry: Any = CORE_CALLABLES;
    while (entry != 0) {
        if (entry == value) { return value; }
        entry = load64(entry + 32);
    }
    return rt_failtype(rt_from(addr("value is not callable"), 21));
}
fun rt_mapf(xs: Any, f: Any) -> Any {
    let n: Any = rt_list_len(xs);
    let d: Any = load64(xs - 5 + 16);
    let r: Any = rt_list_new(n);
    mut i: Any = 0;
    while (i < n) {
        rt_push(r, f(load64(d + i * 8)));
        i = i + 1;
    }
    return r;
}

fun rt_filter(xs: Any, f: Any) -> Any {
    let n: Any = rt_list_len(xs);
    let d: Any = load64(xs - 5 + 16);
    let r: Any = rt_list_new(n);
    mut i: Any = 0;
    while (i < n) {
        let x: Any = load64(d + i * 8);
        if (f(x) == 4) { rt_push(r, x); }
        i = i + 1;
    }
    return r;
}

fun rt_reduce(xs: Any, f: Any, init: Any) -> Any {
    let n: Any = rt_list_len(xs);
    let d: Any = load64(xs - 5 + 16);
    mut acc: Any = init;
    mut i: Any = 0;
    while (i < n) {
        acc = f(acc, load64(d + i * 8));
        i = i + 1;
    }
    return acc;
}

fun rt_any(xs: Any, f: Any) -> Any {
    let n: Any = rt_list_len(xs);
    let d: Any = load64(xs - 5 + 16);
    mut i: Any = 0;
    while (i < n) {
        if (f(load64(d + i * 8)) == 4) { return 4; }
        i = i + 1;
    }
    return 3;
}

fun rt_all(xs: Any, f: Any) -> Any {
    let n: Any = rt_list_len(xs);
    let d: Any = load64(xs - 5 + 16);
    mut i: Any = 0;
    while (i < n) {
        if (f(load64(d + i * 8)) != 4) { return 3; }
        i = i + 1;
    }
    return 4;
}

fun rt_count(xs: Any, f: Any) -> Any {
    let n: Any = rt_list_len(xs);
    let d: Any = load64(xs - 5 + 16);
    mut c: Any = 0;
    mut i: Any = 0;
    while (i < n) {
        if (f(load64(d + i * 8)) == 4) { c = c + 1; }
        i = i + 1;
    }
    return c * 8;
}

fun rt_each(xs: Any, f: Any) -> Any {
    let n: Any = rt_list_len(xs);
    let d: Any = load64(xs - 5 + 16);
    mut i: Any = 0;
    while (i < n) {
        f(load64(d + i * 8));
        i = i + 1;
    }
    return 2;
}

fun rt_times(n: Any, f: Any) -> Any {
    let k: Any = n / 8;
    mut i: Any = 0;
    while (i < k) {
        f(i * 8);
        i = i + 1;
    }
    return 2;
}

// -------------------------------------------------------------- source traces

mut TRACE_STACK: Any = 0;
mut TRACE_DEPTH: Any = 0;

fun rt_trace_push(frame: Any) -> Any {
    if (TRACE_STACK == 0) { TRACE_STACK = rt_alloc(8192); }
    if (TRACE_DEPTH < 1024) { store64(TRACE_STACK + TRACE_DEPTH * 8, frame); }
    TRACE_DEPTH += 1; return 2;
}
fun rt_trace_pop() -> Any {
    if (TRACE_DEPTH > 0) {
        TRACE_DEPTH -= 1;
        if (TRACE_DEPTH < 1024) { store64(TRACE_STACK + TRACE_DEPTH * 8, 0); }
    }
    return 2;
}
fun rt_trace_depth() -> Any { return TRACE_DEPTH * 8; }
fun rt_trace_restore(depth: Any) -> Any {
    while (TRACE_DEPTH > depth / 8) { rt_trace_pop(); }
    return 2;
}
fun rt_trace_snapshot() -> Any {
    mut text: Any = rt_from(addr(""), 0);
    mut index: Any = TRACE_DEPTH - 1;
    if (index >= 1024) { index = 1023; text = rt_from(addr("  ... trace truncated\n"), 22); }
    mut frames: Any = 0;
    while (index >= 0 and frames < 64) {
        text = rt_concat(text, rt_concat(rt_from(addr("  at "), 5), rt_concat(load64(TRACE_STACK + index * 8), rt_from(addr("\n"), 1))));
        index -= 1; frames += 1;
    }
    return text;
}

// ---------------------------------------------------------- cooperative fibers

mut CSTOP: Any = 0;
mut FIB_TAB: Any = 0;
mut FIB_N: Any = 0;
mut FIB_CUR: Any = 0;
mut FIB_SAVE0: Any = 0;
mut FIB_TRACE0: Any = 0;
mut FIB_TRACE_DEPTH0: Any = 0;
mut FIB_HSTACK0: Any = 0;
mut FIB_HDEPTH0: Any = 0;
mut FIB_ERRVAL0: Any = 2;
mut FIB_ERRFLAG0: Any = 0;

fun rt_spawn(fn: Any) -> Any {
    if (FIB_N >= 128) { return rt_failstr(rt_from(addr("fiber limit exceeded"), 20)); }
    if (FIB_TAB == 0) { FIB_TAB = rt_alloc(1024); }
    if (FIB_SAVE0 == 0) { FIB_SAVE0 = rt_alloc(8); }
    let rec: Any = rt_alloc(80);
    store64(rec + 32, 0); store64(rec + 40, 0);
    store64(rec + 48, rt_alloc(64 * 256)); store64(rec + 56, 0);
    store64(rec + 64, 2); store64(rec + 72, 0);
    store64(rec + 8, fn);
    store64(rec + 16, 1);
    let size: Any = 262144;
    let base: Any = __host_alloc(size);
    if (base <= 0) { return rt_failstr(rt_from(addr("cannot allocate fiber stack"), 27)); }
    let top: Any = base + size;
    store64(rec + 24, top);
    let sp: Any = __fiber_stack(top);
    store64(rec, sp);
    store64(FIB_TAB + FIB_N * 8, rec);
    FIB_N = FIB_N + 1;
    return rec;
}

fun rt_yield() -> Any {
    if (FIB_CUR == 0) { return 2; }
    CSTOP = load64(FIB_CUR + 24);
    store64(FIB_CUR + 32, TRACE_STACK); store64(FIB_CUR + 40, TRACE_DEPTH);
    store64(FIB_CUR + 48, HSTACK); store64(FIB_CUR + 56, HDEPTH);
    store64(FIB_CUR + 64, ERRVAL); store64(FIB_CUR + 72, ERRFLAG);
    TRACE_STACK = FIB_TRACE0; TRACE_DEPTH = FIB_TRACE_DEPTH0;
    HSTACK = FIB_HSTACK0; HDEPTH = FIB_HDEPTH0;
    ERRVAL = FIB_ERRVAL0; ERRFLAG = FIB_ERRFLAG0;
    __fib_switch(FIB_CUR, FIB_SAVE0);
    TRACE_STACK = load64(FIB_CUR + 32); TRACE_DEPTH = load64(FIB_CUR + 40);
    HSTACK = load64(FIB_CUR + 48); HDEPTH = load64(FIB_CUR + 56);
    ERRVAL = load64(FIB_CUR + 64); ERRFLAG = load64(FIB_CUR + 72);
    CSTOP = load64(FIB_CUR + 24);
    return 2;
}

fun rt_run() -> Any {
    if (FIB_TAB == 0) { FIB_TAB = rt_alloc(1024); }
    if (FIB_SAVE0 == 0) { FIB_SAVE0 = rt_alloc(8); }
    FIB_TRACE0 = TRACE_STACK; FIB_TRACE_DEPTH0 = TRACE_DEPTH;
    FIB_HSTACK0 = HSTACK; FIB_HDEPTH0 = HDEPTH;
    FIB_ERRVAL0 = ERRVAL; FIB_ERRFLAG0 = ERRFLAG;
    mut again: Any = 1;
    while (again == 1) {
        again = 0;
        mut i: Any = 0;
        while (i < FIB_N) {
            let rec: Any = load64(FIB_TAB + i * 8);
            if (load64(rec + 16) == 1) {
                again = 1;
                FIB_CUR = rec;
                CSTOP = load64(rec + 24);
                TRACE_STACK = load64(rec + 32); TRACE_DEPTH = load64(rec + 40);
                HSTACK = load64(rec + 48); HDEPTH = load64(rec + 56);
                ERRVAL = load64(rec + 64); ERRFLAG = load64(rec + 72);
                __fib_switch(FIB_SAVE0, rec);
                TRACE_STACK = FIB_TRACE0; TRACE_DEPTH = FIB_TRACE_DEPTH0;
                HSTACK = FIB_HSTACK0; HDEPTH = FIB_HDEPTH0;
                ERRVAL = FIB_ERRVAL0; ERRFLAG = FIB_ERRFLAG0;
                CSTOP = STACKTOP;
                FIB_CUR = 0;
            }
            i = i + 1;
        }
    }
    return 2;
}

fun rt_fiber_entry() -> Any {
    let rec: Any = FIB_CUR;
    CSTOP = load64(rec + 24);
    let fn: Any = load64(rec + 8);
    fn();
    store64(rec + 16, 0);
    store64(rec + 32, TRACE_STACK); store64(rec + 40, TRACE_DEPTH);
    TRACE_STACK = FIB_TRACE0; TRACE_DEPTH = FIB_TRACE_DEPTH0;
    HSTACK = FIB_HSTACK0; HDEPTH = FIB_HDEPTH0;
    ERRVAL = FIB_ERRVAL0; ERRFLAG = FIB_ERRFLAG0;
    __fib_switch(rec, FIB_SAVE0);
    return 0;
}

// Boxed binary64 helpers use the same bits and parser as the full runtime.

fun rt_box(bits: Any) -> Any {
    let p: Any = rt_alloc(8);
    store64(p, bits);
    return p + 6;
}

fun power2(k: Any) -> Any {
    mut r: Any = 1;
    mut i: Any = 0;
    while (i < k) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

// Positive integer -> IEEE754 double bit pattern, exponent shifted by `extra`.

fun u64_to_bits(P: Any, extra: Any) -> Any {
    if (P == 0) { return 0; }
    mut h: Any = 0;
    mut x: Any = P;
    while (x > 1) {
        x = x / 2;
        h = h + 1;
    }
    mut mant: Any = 0;
    if (h <= 52) { mant = (P - power2(h)) * power2(52 - h); }
    else { mant = P / power2(h - 52) - power2(52); }
    let ef: Any = 1023 + h + extra;
    return ef * 4503599627370496 + mant;
}

fun rt_parse_float2(p: Any, n: Any) -> Any {
    mut i: Any = 0;
    mut neg: Any = 0;
    if (load8(p) == 45) {
        neg = 1;
        i = 1;
    }
    let ten: Any = rt_box(u64_to_bits(10, 0));
    let sign1: Any = rt_const_hi_lo(3220176896, 0);
    mut val: Any = rt_box(u64_to_bits(0, 0));
    mut fd: Any = 0;
    mut seen: Any = 0;
    mut dot: Any = 0;
    mut exp: Any = 0;
    while (i < n) {
        let c: Any = load8(p + i);
        if (c == 46) {
            dot = 1;
            i = i + 1;
            continue;
        }
        if (c == 101  or  c == 69) {
            i = i + 1;
            mut es: Any = 0;
            if (i < n) {
                if (load8(p + i) == 43) { i = i + 1; }
                else if (load8(p + i) == 45) { es = 1; i = i + 1; }
            }
            mut ev: Any = 0;
            while (i < n) {
                let dd: Any = load8(p + i) - 48;
                if (dd < 0) { break; }
                if (dd > 9) { break; }
                ev = ev * 10 + dd;
                i = i + 1;
            }
            if (es == 1) { ev = 0 - ev; }
            exp = exp + ev;
            break;
        }
        let d: Any = c - 48;
        if (d >= 0) {
            if (d <= 9) {
                val = __fbin(0, __fbin(2, val, ten), rt_to_f(d * 8));
                if (dot == 1) { fd = fd + 1; }
                seen = 1;
            }
        }
        i = i + 1;
    }
    let e: Any = exp - fd;
    let one: Any = rt_box(u64_to_bits(1, 0));
    if (e > 0) {
        mut p: Any = one;
        mut k: Any = 0;
        while (k < e) { p = __fbin(2, p, ten); k = k + 1; }
        val = __fbin(2, val, p);
    } else if (e < 0) {
        mut p: Any = one;
        mut k: Any = 0;
        let ne: Any = 0 - e;
        while (k < ne) { p = __fbin(2, p, ten); k = k + 1; }
        val = __fbin(3, val, p);
    }
    if (neg == 1) { val = __fbin(2, val, sign1); }
    return val;
}

fun rt_to_f(v: Any) -> Any {
    let t: Any = v % 8;
    if (t == 6) { return v; }
    if (t == 0) {
        let n: Any = v / 8;
        if (n < 0) {
            return __fbin(2, rt_box(u64_to_bits(0 - n, 0)), rt_const_hi_lo(3220176896, 0));
        }
        return rt_box(u64_to_bits(n, 0));
    }
    return v;
}

fun rt_fstr(v: Any) -> Any {
    let bits: Any = load64(v - 6);
    let buf: Any = rt_alloc(64);
    mut o: Any = 0;
    if (__fsign(bits) == 1) {
        store8(buf, 45);
        o = 1;
    }
    let ip: Any = __ftrunc(bits);
    mut x: Any = ip;
    if (x < 0) { x = 0 - x; }
    let tmp: Any = rt_alloc(32);
    mut d: Any = 0;
    if (x == 0) {
        store8(tmp, 48);
        d = 1;
    }
    while (x > 0) {
        store8(tmp + d, (x % 10) + 48);
        x = x / 10;
        d = d + 1;
    }
    mut k: Any = d;
    while (k > 0) {
        store8(buf + o, load8(tmp + k - 1));
        o = o + 1;
        k = k - 1;
    }
    store8(buf + o, 46);
    o = o + 1;
    let fd7: Any = __ffrac(bits, 10000000);
    let fd: Any = (fd7 + 5) / 10;
    mut f: Any = fd;
    if (f < 0) { f = 0 - f; }
    let ft: Any = rt_alloc(16);
    mut j: Any = 5;
    while (j >= 0) {
        store8(ft + j, (f % 10) + 48);
        f = f / 10;
        j = j - 1;
    }
    mut fl: Any = 6;
    while (fl > 1) {
        if (load8(ft + fl - 1) == 48) { fl = fl - 1; } else { break; }
    }
    k = 0;
    while (k < fl) {
        store8(buf + o, load8(ft + k));
        o = o + 1;
        k = k + 1;
    }
    let s: Any = rt_strnew(o);
    rt_copy(s + 7, buf, o);
    return s;
}

fun rt_const_hi_lo(hi: Any, lo: Any) -> Any {
    let p: Any = rt_alloc(8);
    store32(p, lo);
    store32(p + 4, hi);
    return p + 6;
}

fun rt_pi() -> Any { return rt_const_hi_lo(1074340347, 1413754136); }

fun rt_e() -> Any { return rt_const_hi_lo(1074118410, 2333366121); }

fun rt_float32(value: Any) -> Any {
    if (value % 8 != 6) { return rt_failtype(rt_from(addr("expected a float"), 16)); }
    return rt_box(__f32(load64(value - 6)));
}

fun rt_value_tag(value: Any) -> Any { return (value % 8) * 8; }
fun __core_float_error() -> Any { return __core_raise(addr("runtime"), 7, rt_from(addr("cannot convert to Float"), 23)); }
fun rt_core_sqrt(value: Any) -> Any { return sqrt(rt_to_f(value)); }
fun rt_core_floor(value: Any) -> Any { return floor(rt_to_f(value)); }
fun rt_core_ceil(value: Any) -> Any { return ceil(rt_to_f(value)); }
fun rt_core_trunc(value: Any) -> Any { return trunc(rt_to_f(value)); }
