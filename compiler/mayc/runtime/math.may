    if (__math_high(ax) < 1048576) { ax = ax * 9007199254740992.0; n = -53; }
    let high: Any = __math_high(ax);
    n += high / 1048576 - 1023;
    let j: Any = high % 1048576;
    mut ix: Any = j + 1072693248;
    mut k: Any = 0;
    if (j <= 235662) { k = 0; } else if (j < 767610) { k = 1; } else { k = 0; n += 1; ix -= 1048576; }
    ax = __math_bits(__math_low(ax), ix);
    let bp: Any = if (k == 1) { 1.5 } else { 1.0 };
