/// x^y for positive finite x and finite nonzero y; within one ulp (fdlibm e_pow.c).
fun __math_pow_positive(x: Any, y: Any) -> Any {
    if (y == 1.0) { return x; }
    if (y == 2.0) { return x * x; }
    if (y == -1.0) { return 1.0 / x; }
    if (y == 0.5) { return sqrt(x); }
    let ay: Any = if (y < 0.0) { 0.0 - y } else { y };
    let xhigh: Any = __math_high(x);
    mut t1: Any = 0.0; mut t2: Any = 0.0;
    if (ay > 2147483648.0) {
        // Every finite |y| above 2^64 overflows or underflows unless x == 1.
        if (ay > 18446744073709551616.0 or xhigh < 1072693247 or xhigh > 1072693248) {
            if ((x > 1.0) == (y > 0.0)) { return __math_inf(false); }
            return 0.0;
        }
        let t: Any = x - 1.0;
        let w: Any = (t * t) * (0.5 - t * (0.3333333333333333 - t * 0.25));
        let u: Any = 1.4426950216293335 * t;
        let v: Any = t * 1.9259629911266175e-08 - w * 1.4426950408889634;
        t1 = __math_clear_low(u + v);
        t2 = v - (t1 - u);
    } else {
        let parts: Any = __math_log2_split(x);
        t1 = parts[0]; t2 = parts[1];
    }
    // (y1 + y2) * (t1 + t2) with y1 holding the high half of y.
    let y1: Any = __math_clear_low(y);
    let p_l: Any = (y - y1) * t1 + y * t2;
    mut p_h: Any = y1 * t1;
    let z: Any = p_l + p_h;
    if (z >= 1024.0) { if (z > 1024.0 or p_l + 8.008566259537294e-17 > z - p_h) { return __math_inf(false); } }
    if (z <= -1075.0) { if (z < -1075.0 or p_l <= z - p_h) { return 0.0; } }
    mut n: Any = 0;
    if (z > 0.5 or z < -0.5) {
        n = trunc(z + if (z < 0.0) { -0.5 } else { 0.5 });
        p_h = p_h - to_float(n);
    }
    let t: Any = __math_clear_low(p_l + p_h);
    let u: Any = t * 0.6931471824645996;
    let v: Any = (p_l - (t - p_h)) * 0.6931471805599453 + t * -1.904654299957768e-09;
    let zz: Any = u + v;
    let w: Any = v - (zz - u);
    let tt: Any = zz * zz;
    let c: Any = zz - tt * (0.16666666666666602 + tt * (-0.0027777777777015593 + tt * (6.613756321437934e-05 + tt * (-1.6533902205465252e-06 + tt * 4.1381367970572385e-08))));
    let r: Any = (zz * c) / (c - 2.0) - (w + zz * w);
    return __math_scale(1.0 - (r - zz), n);
}
/// Portable ln; see the public wrapper for its contract.
fun __math_ln(value: Any) -> Any {
    let x: Any = to_float(value);
    let special: Any = __math_log_special(x);
    if (special != nil) { return special; }
    let parts: Any = __math_split(x);
    let k: Any = to_float(parts[0]);
    let r: Any = __math_log_kernel(parts[1]);
    return k * 0.6931471803691238 + (r[0] + (r[1] + k * 1.9082149292705877e-10));
}
/// Portable log2; see the public wrapper for its contract.
fun __math_log2(value: Any) -> Any {
    let x: Any = to_float(value);
    let special: Any = __math_log_special(x);
    if (special != nil) { return special; }
    let parts: Any = __math_split(x);
    let r: Any = __math_log_kernel(parts[1]);
    return to_float(parts[0]) + (r[0] * 1.4426950408889634 + r[1] * 1.4426950408889634);
}
/// Portable log10; see the public wrapper for its contract.
fun __math_log10(value: Any) -> Any {
    let x: Any = to_float(value);
    let special: Any = __math_log_special(x);
    if (special != nil) { return special; }
    let parts: Any = __math_split(x);
    let k: Any = to_float(parts[0]);
    let r: Any = __math_log_kernel(parts[1]);
    let y: Any = k * 3.694239077158931e-13 + (r[0] + r[1]) * 0.4342944819032518;
    return y + k * 0.30102999566361177;
}
/// Portable exp; see the public wrapper for its contract.
fun __math_exp(value: Any) -> Any {
    let x: Any = to_float(value);
    let kind: Any = __math_kind(x);
    if (kind == 3) { return x; }
    if (kind == 2) { if (__math_negative(x)) { return 0.0; } return x; }
    if (x > 709.782712893384) { return __math_inf(false); }
    if (x < -745.1332191019411) { return 0.0; }
    if (x > -3.725290298461914e-09 and x < 3.725290298461914e-09) { return 1.0 + x; }
    let k: Any = trunc(x * 1.4426950408889634 + if (x < 0.0) { -0.5 } else { 0.5 });
    let fk: Any = to_float(k);
    return __math_exp_kernel(x - fk * 0.6931471803691238, fk * 1.9082149292705877e-10, k);
}

// ------------------------------------------------- decimal text <-> binary64
// Parsing is correctly rounded (round half to even) and formatting prints the
// shortest digit string that parses back to the same bits.

/// Drop high zero limbs from a base-2^30 magnitude; internal math helper.
fun __math_big_trim(a: Any) -> Any {
    while (len(a) > 1 and a[len(a) - 1] == 0) { pop(a); }
    return a;
}
/// Return a * factor + addend for a base-2^30 magnitude; internal math helper.
fun __math_big_mul_add(a: Any, factor: Any, addend: Any) -> Any {
    let out: Any = [];
    mut carry: Any = addend;
    for limb: Any in a {
        let value: Any = limb * factor + carry;
        push(out, value % 1073741824);
        carry = value / 1073741824;
    }
    while (carry > 0) { push(out, carry % 1073741824); carry = carry / 1073741824; }
    return __math_big_trim(out);
}
/// Multiply a base-2^30 magnitude by 2^bits; internal math helper.
fun __math_big_shift(a: Any, bits: Any) -> Any {
    let out: Any = [];
    mut k: Any = 0;
    while (k < bits / 30) { push(out, 0); k += 1; }
    for limb: Any in a { push(out, limb); }
    let left: Any = bits % 30;
    if (left == 0) { return __math_big_trim(out); }
    mut factor: Any = 1; k = 0;
    while (k < left) { factor = factor * 2; k += 1; }
    return __math_big_mul_add(out, factor, 0);
}
/// Multiply a base-2^30 magnitude by 10^count, nine digits at a time; internal math helper.
fun __math_big_pow10(a: Any, count: Any) -> Any {
    mut out: Any = a; mut left: Any = count;
    while (left >= 9) { out = __math_big_mul_add(out, 1000000000, 0); left -= 9; }
    mut factor: Any = 1;
    while (left > 0) { factor = factor * 10; left -= 1; }
    if (factor > 1) { out = __math_big_mul_add(out, factor, 0); }
    return out;
}
/// Compare two base-2^30 magnitudes, returning -1, 0 or 1; internal math helper.
fun __math_big_cmp(a: Any, b: Any) -> Any {
    if (len(a) != len(b)) { return if (len(a) < len(b)) { -1 } else { 1 }; }
    mut i: Any = len(a) - 1;
    while (i >= 0) {
        if (a[i] != b[i]) { return if (a[i] < b[i]) { -1 } else { 1 }; }
        i -= 1;
    }
    return 0;
}
/// Return a - b for base-2^30 magnitudes with a >= b; internal math helper.
fun __math_big_sub(a: Any, b: Any) -> Any {
    let out: Any = [];
    mut borrow: Any = 0; mut i: Any = 0;
    while (i < len(a)) {
        mut value: Any = a[i] - borrow - (if (i < len(b)) { b[i] } else { 0 });
        borrow = 0;
        if (value < 0) { value += 1073741824; borrow = 1; }
        push(out, value);
        i += 1;
    }
    return __math_big_trim(out);
}
/// Count significant bits of a base-2^30 magnitude; internal math helper.
fun __math_big_bits(a: Any) -> Any {
    mut top: Any = a[len(a) - 1];
    mut bits: Any = (len(a) - 1) * 30;
    while (top > 0) { bits += 1; top = top / 2; }
    return bits;
}
/// Return digits * 10^scale correctly rounded to a Float, given the digits as a base-2^30 magnitude; internal math helper.
fun __math_decimal_big(digits: Any, scale: Any, negative: Any) -> Any {
    if (len(digits) == 1 and digits[0] == 0) { return __math_zero(negative); }
    if (scale > 310) { return __math_inf(negative); }
    if (scale + len(digits) * 10 < -400) { return __math_zero(negative); }
    let numerator: Any = if (scale > 0) { __math_big_pow10(digits, scale) } else { digits };
    let denominator: Any = if (scale < 0) { __math_big_pow10([1], 0 - scale) } else { [1] };
    mut k: Any = 0;
    // Choose e so that 2^52 <= numerator / (denominator * 2^e) < 2^53.
    mut e: Any = __math_big_bits(numerator) - __math_big_bits(denominator) - 53;
    if (e < -1074) { e = -1074; }
    mut top: Any = numerator; mut bottom: Any = denominator;
    while (true) {
        top = if (e < 0) { __math_big_shift(numerator, 0 - e) } else { numerator };
        bottom = if (e > 0) { __math_big_shift(denominator, e) } else { denominator };
        if (e > -1074 and __math_big_cmp(top, __math_big_shift(bottom, 52)) < 0) { e -= 1; continue; }
        if (__math_big_cmp(top, __math_big_shift(bottom, 53)) >= 0) { e += 1; continue; }
        break;
    }
    let multiples: Any = [bottom];
    k = 1;
    while (k <= 53) { push(multiples, __math_big_shift(multiples[k - 1], 1)); k += 1; }
    mut remainder: Any = top; mut quotient: Any = 0;
    mut bit: Any = 53; mut weight: Any = 9007199254740992;
    while (bit >= 0) {
        if (__math_big_cmp(remainder, multiples[bit]) >= 0) {
            remainder = __math_big_sub(remainder, multiples[bit]);
            quotient += weight;
        }
        bit -= 1; weight = weight / 2;
    }
    let half: Any = __math_big_cmp(__math_big_shift(remainder, 1), bottom);
    if (half > 0 or (half == 0 and quotient % 2 == 1)) { quotient += 1; }
    if (quotient == 9007199254740992) { quotient = 4503599627370496; e += 1; }
    if (e + 1075 >= 2047) { return __math_inf(negative); }
    mut biased: Any = 0; mut mantissa: Any = quotient;
    if (quotient >= 4503599627370496) { biased = e + 1075; mantissa = quotient - 4503599627370496; }
    let sign: Any = if (negative) { 2147483648 } else { 0 };
    return __math_bits(mantissa % 4294967296, sign + biased * 1048576 + mantissa / 4294967296);
}
/// Return 10^k as an exact Float for 0 <= k <= 22; internal math helper.
fun __math_ten(k: Any) -> Any {
    mut p: Any = 1.0; mut i: Any = 0;
    while (i < k) { p = p * 10.0; i += 1; }
    return p;
}
/// Convert a decimal digit string times 10^scale to the nearest Float; internal math helper.
fun __math_decimal(text: Any, scale: Any, negative: Any) -> Any {
    mut start: Any = 0;
    while (start < len(text) - 1 and char_at(text, start) == 48) { start += 1; }
    let count: Any = len(text) - start;
    if (count <= 15 and scale >= -22 and scale <= 22) {
        // Exact significand and power of ten: one IEEE operation rounds correctly.
        mut n: Any = 0; mut i: Any = start;
        while (i < len(text)) { n = n * 10 + char_at(text, i) - 48; i += 1; }
        mut v: Any = to_float(n);
        if (scale > 0) { v = v * __math_ten(scale); } else if (scale < 0) { v = v / __math_ten(0 - scale); }
        if (negative) { return v * -1.0; }
        return v;
    }
    mut digits: Any = [0]; mut i: Any = start;
    while (i < len(text)) {
        mut chunk: Any = 0; mut factor: Any = 1;
        while (i < len(text) and factor < 1000000000) { chunk = chunk * 10 + char_at(text, i) - 48; factor = factor * 10; i += 1; }
        digits = __math_big_mul_add(digits, factor, chunk);
    }
    return __math_decimal_big(digits, scale, negative);
}
/// Parse optional sign, digits, optional fraction and optional exponent into the nearest Float, or nil when the text is not a number; internal math helper.
fun __math_parse(text: Any) -> Any {
    let n: Any = len(text);
    mut i: Any = 0; mut negative: Any = false;
    if (n > 0 and char_at(text, 0) == 45) { negative = true; i = 1; }
    else if (n > 0 and char_at(text, 0) == 43) { i = 1; }
    mut digits: Any = ""; mut fraction: Any = 0; mut seen: Any = false;
    let parts: Any = [];
    while (i < n and char_at(text, i) >= 48 and char_at(text, i) <= 57) { push(parts, char_from(char_at(text, i))); seen = true; i += 1; }
    if (i < n and char_at(text, i) == 46) {
        i += 1;
        while (i < n and char_at(text, i) >= 48 and char_at(text, i) <= 57) { push(parts, char_from(char_at(text, i))); fraction += 1; seen = true; i += 1; }
    }
    if (not seen) { return nil; }
    mut exponent: Any = 0;
    if (i < n and (char_at(text, i) == 101 or char_at(text, i) == 69)) {
        i += 1;
        mut sign: Any = 1;
        if (i < n and char_at(text, i) == 45) { sign = -1; i += 1; }
        else if (i < n and char_at(text, i) == 43) { i += 1; }
        while (i < n and char_at(text, i) >= 48 and char_at(text, i) <= 57) {
            if (exponent < 100000000) { exponent = exponent * 10 + char_at(text, i) - 48; }
            i += 1;
        }
        exponent = sign * exponent;
    }
    if (i != n) { return nil; }
    digits = join(parts, "");
    return __math_decimal(digits, exponent - fraction, negative);
}
/// Return a + b for base-2^30 magnitudes; internal math helper.
fun __math_big_add(a: Any, b: Any) -> Any {
    let out: Any = [];
    mut carry: Any = 0; mut i: Any = 0;
    let n: Any = if (len(a) > len(b)) { len(a) } else { len(b) };
    while (i < n) {
        let value: Any = (if (i < len(a)) { a[i] } else { 0 }) + (if (i < len(b)) { b[i] } else { 0 }) + carry;
        push(out, value % 1073741824);
        carry = value / 1073741824;
        i += 1;
    }
    if (carry > 0) { push(out, carry); }
    return out;
}
/// Format a Float with the shortest digits that parse back to the same value (Steele-White/Burger-Dybvig free-format digit generation, closest digit on ties); internal math helper.
fun __math_format(value: Any) -> Any {
    let kind: Any = __math_kind(value);
    let negative: Any = __math_negative(value);
    let sign: Any = if (negative) { "-" } else { "" };
    if (kind == 3) { return "nan"; }
    if (kind == 2) { return sign + "inf"; }
    if (kind == 0) { return sign + "0.0"; }
    let high: Any = __math_high(value) % 2147483648;
    let biased: Any = high / 1048576;
    mut f: Any = (high % 1048576) * 4294967296 + __math_low(value);
    mut e: Any = -1074;
    if (biased > 0) { f += 4503599627370496; e = biased - 1075; }
    let even: Any = f % 2 == 0;
    let fbig: Any = [f % 1073741824, f / 1073741824];
    // value = r / s; the rounding interval is (r - mm, r + mp) / s.
    mut r: Any = [0]; mut s: Any = [1]; mut mp: Any = [1]; mut mm: Any = [1];
    if (e >= 0) {
        let be: Any = __math_big_shift([1], e);
        if (f != 4503599627370496) { r = __math_big_shift(fbig, e + 1); s = [2]; mp = be; mm = be; }
        else { r = __math_big_shift(fbig, e + 2); s = [4]; mp = __math_big_shift(be, 1); mm = be; }
    } else if (biased <= 1 or f != 4503599627370496) {
        r = __math_big_shift(fbig, 1); s = __math_big_shift([1], 1 - e);
    } else {
        r = __math_big_shift(fbig, 2); s = __math_big_shift([1], 2 - e); mp = [2];
    }
    r = __math_big_trim(r);
    // Estimate k = ceil(log10(value)) from the binary exponent; it is never too high.
    let top: Any = e + 52 - (if (biased == 0) { 52 - __math_big_bits(__math_big_trim(fbig)) + 1 } else { 0 });
    mut k: Any = trunc(to_float(top) * 0.30102999566398114 - 0.0000000001);
    if (to_float(top) * 0.30102999566398114 - 0.0000000001 > to_float(k)) { k += 1; }
    if (k >= 0) { s = __math_big_pow10(s, k); }
    else { r = __math_big_pow10(r, 0 - k); mp = __math_big_pow10(mp, 0 - k); mm = __math_big_pow10(mm, 0 - k); }
    while (true) {
        let c: Any = __math_big_cmp(__math_big_add(r, mp), s);
        if (c > 0 or (even and c == 0)) { s = __math_big_mul_add(s, 10, 0); k += 1; } else { break; }
    }
    let parts: Any = [];
    while (true) {
        r = __math_big_mul_add(r, 10, 0); mp = __math_big_mul_add(mp, 10, 0); mm = __math_big_mul_add(mm, 10, 0);
        mut d: Any = 0;
        while (__math_big_cmp(r, s) >= 0) { r = __math_big_sub(r, s); d += 1; }
        let low: Any = __math_big_cmp(r, mm);
        let up: Any = __math_big_cmp(__math_big_add(r, mp), s);
        let tc1: Any = low < 0 or (even and low == 0);
        let tc2: Any = up > 0 or (even and up == 0);
        if (not tc1 and not tc2) { push(parts, char_from(48 + d)); continue; }
        if (tc1 and tc2) {
            let twice: Any = __math_big_cmp(__math_big_shift(r, 1), s);
            if (twice > 0 or (twice == 0 and d % 2 == 1)) { d += 1; }
        } else if (tc2) { d += 1; }
        push(parts, char_from(48 + d));
        break;
    }
    let digits: Any = join(parts, "");
    let point: Any = k - 1;
    if (point >= 16 or point < -4) {
        if (len(digits) == 1) { return sign + digits + "e" + str_of(point); }
        return sign + substring(digits, 0, 1) + "." + substring(digits, 1, len(digits) - 1) + "e" + str_of(point);
    }
    if (point < 0) { return sign + "0." + repeat("0", 0 - point - 1) + digits; }
    if (len(digits) <= point + 1) { return sign + digits + repeat("0", point + 1 - len(digits)) + ".0"; }
    return sign + substring(digits, 0, point + 1) + "." + substring(digits, point + 1, len(digits) - point - 1);
}
