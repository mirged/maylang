// Small portable libraries. These functions use the common core runtime ABI.
fun str(value: Any) -> Str { if (value_tag(value) == 6) { return float_str(value); } return str_of(value); }
fun alloc(bytes: Int) -> Ptr { return __core_alloc(bytes); }
fun arena_new(bytes: Int) -> Ptr { return __core_arena_new(bytes); }
fun arena_alloc(arena: Ptr, bytes: Int) -> Ptr { return __core_arena_alloc(arena, bytes); }
fun arena_reset(arena: Ptr) -> Nil { __core_arena_reset(arena); return; }
fun arena_used(arena: Ptr) -> Int { return __core_arena_used(arena); }
fun arena_capacity(arena: Ptr) -> Int { return __core_arena_capacity(arena); }
fun core_heap_retained() -> Int { return __core_heap_retained(); }
fun memcpy(destination: Ptr, source: Ptr, bytes: Int) -> Nil { __core_copy(destination, source, bytes); return; }
fun substring(s: Str, start: Int, count: Int) -> Str { return __core_substring(s, start, count); }
fun str_concat(a: Str, b: Str) -> Str { return a + b; }
fun range(start: Int, stop: Int) -> List<Int> {
    let values: List<Int> = []; mut n: Int = start;
    while (n < stop) { push(values, n); n += 1; }
    return values;
}
fun sum(values: Any) -> Int {
    mut result: Int = 0;
    for value: Any in values { result += value; }
    return result;
}
fun clamp(value: Int, low: Int, high: Int) -> Int { return min(max(value, low), high); }
fun gcd(a: Int, b: Int) -> Int {
    mut x: Int = abs(a); mut y: Int = abs(b);
    while (y != 0) { let remainder: Int = x % y; x = y; y = remainder; }
    return x;
}
fun lcm(a: Int, b: Int) -> Int { if (a == 0 or b == 0) { return 0; } return abs((a / gcd(a, b)) * b); }
fun is_space_code(c: Int) -> Bool { return c == 32 or c == 9 or c == 10 or c == 13; }
fun trim(s: Str) -> Str {
    mut start: Int = 0; mut stop: Int = len(s);
    while (start < stop and is_space_code(char_at(s, start))) { start += 1; }
    while (stop > start and is_space_code(char_at(s, stop - 1))) { stop -= 1; }
    return substring(s, start, stop - start);
}
fun repeat(s: Str, n: Int) -> Str {
    mut out: Str = ""; mut part: Str = s; mut left: Int = n;
    while (left > 0) {
        if (left % 2 == 1) { out = out + part; }
        left /= 2; if (left > 0) { part = part + part; }
    }
    return out;
}

fun float(x: Any) -> Any {
    let t: Any = value_tag(x);
    if (t == 6) { return x; }
    if (t == 0) { return to_float(x); }
    if (t != 1) { return __core_float_error(); }
    // Correctly rounded; see __math_parse in runtime/math.may.
    let top: Any = __core_heap_top(); let end: Any = __core_heap_end();
    let value: Any = __math_parse(trim(x));
    if (value == nil) { return __core_float_error(); }
    return __math_keep(top, end, value);
}


/// Format a boxed float with the shortest digits that parse back to the same value; spell nonfinite values nan, inf and -inf and keep the sign of negative zero.
fun float_str(f: Any) -> Any {
    let top: Any = __core_heap_top(); let end: Any = __core_heap_end();
    return __math_keep_text(top, end, __math_format(f));
}

// ------------------------------------------------------------------ lists

fun round(value: Any) -> Any {
    // x - floor(x) is exact, unlike x + 0.5, which rounds 0.49999999999999994 up.
    let f: Any = to_float(value); let r: Any = floor(f);
    return if (f - r >= 0.5) { r + 1.0 } else { r };
}

// ------------------------------------------------------------------ math
// Transcendentals come from runtime/math.may. Core never frees memory, so each
// call records the heap top and releases its temporaries before boxing the
// result.

/// Return a Float with the bits of `result` after releasing the heap above `top`; internal math helper.
fun __math_keep(top: Any, end: Any, result: Any) -> Any {
    let low: Any = __math_low(result); let high: Any = __math_high(result);
    __core_heap_release(top, end);
    return __math_bits(low, high);
}
/// Return a copy of short ASCII text after releasing the heap above `top`; the bytes travel in four Ints. Longer text is returned without releasing; internal math helper.
fun __math_keep_text(top: Any, end: Any, text: Any) -> Any {
    let n: Any = len(text);
    if (n > 24) { return text; }
    mut a: Any = 0; mut b: Any = 0; mut c: Any = 0; mut d: Any = 0; mut i: Any = 0;
    while (i < n) {
        let code: Any = char_at(text, i);
        if (i < 6) { a = a * 256 + code; } else if (i < 12) { b = b * 256 + code; } else if (i < 18) { c = c * 256 + code; } else { d = d * 256 + code; }
        i += 1;
    }
    __core_heap_release(top, end);
    let words: Any = [a, b, c, d];
    let out: Any = [];
    i = 0;
    while (i < n) {
        let size: Any = if (n - i < 6) { n - i } else { 6 };
        mut word: Any = words[i / 6]; mut j: Any = size - 1;
        let chars: Any = [];
        while (j >= 0) { push(chars, 0); j -= 1; }
        j = size - 1;
        while (j >= 0) { chars[j] = char_from(word % 256); word = word / 256; j -= 1; }
        for ch: Any in chars { push(out, ch); }
        i += size;
    }
    return join(out, "");
}
/// Return the natural logarithm; zero gives -inf and negative input NaN. Within one ulp.
fun ln(value: Any) -> Any { let top: Any = __core_heap_top(); let end: Any = __core_heap_end(); return __math_keep(top, end, __math_ln(value)); }
/// Return the base-2 logarithm; exact for powers of two. Within one ulp.
fun log2(value: Any) -> Any { let top: Any = __core_heap_top(); let end: Any = __core_heap_end(); return __math_keep(top, end, __math_log2(value)); }
/// Return the base-10 logarithm. Within one ulp.
fun log10(value: Any) -> Any { let top: Any = __core_heap_top(); let end: Any = __core_heap_end(); return __math_keep(top, end, __math_log10(value)); }
/// Return e raised to a number; overflows to inf above about 709.78 and underflows to zero. Within one ulp.
fun exp(value: Any) -> Any { let top: Any = __core_heap_top(); let end: Any = __core_heap_end(); return __math_keep(top, end, __math_exp(value)); }
/// Return the sine of an angle in radians, reducing any finite argument exactly. Within one ulp.
fun sin(value: Any) -> Any { let top: Any = __core_heap_top(); let end: Any = __core_heap_end(); return __math_keep(top, end, __math_trig(value, 0)); }
/// Return the cosine of an angle in radians, reducing any finite argument exactly. Within one ulp.
fun cos(value: Any) -> Any { let top: Any = __core_heap_top(); let end: Any = __core_heap_end(); return __math_keep(top, end, __math_trig(value, 1)); }
/// Return the tangent of an angle in radians, reducing any finite argument exactly. Within one ulp.
fun tan(value: Any) -> Any { let top: Any = __core_heap_top(); let end: Any = __core_heap_end(); return __math_keep(top, end, __math_trig(value, 2)); }
/// Convert both operands to Float and raise the first to the second; used by `pow` and floating `**`.
fun __core_pow(a: Any, b: Any) -> Any { let top: Any = __core_heap_top(); let end: Any = __core_heap_end(); return __math_keep(top, end, __math_powf(to_float(a), to_float(b))); }
