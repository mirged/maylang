    if (ay >= 9007199254740992.0) { return 0; }
    let t: Any = trunc(ay);
    if (to_float(t) != ay) { return -1; }
    return t % 2;
}
/// Raise one Float to another with C99 special cases for zeros, infinities, NaN and negative bases; internal math helper.
fun __math_powf(x: Any, y: Any) -> Any {
    let kx: Any = __math_kind(x); let ky: Any = __math_kind(y);
    if (ky == 0) { return 1.0; }
    if (__math_high(x) == 1072693248 and __math_low(x) == 0) { return 1.0; }
    if (kx == 3 or ky == 3) { return __math_nan(); }
