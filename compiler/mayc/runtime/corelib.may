    let fraction_limbs: Any = 8;
    let acc: List<Int> = [];
    k = 0;
    while (k <= fraction_limbs) { push(acc, 0); k += 1; }
    mut a: Any = 0;
    while (a < 4) {
        mut i: Any = 0;
        while (i < len(two_over_pi)) {
            let index: Any = a + e24 - (i + 1);
