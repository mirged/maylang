// Small portable libraries. These functions use the common core runtime ABI.
fun str(value: Any) -> Str { if (value_tag(value) == 6) { return float_str(value); } return str_of(value); }
fun alloc(bytes: Int) -> Ptr { return __core_alloc(bytes); }
fun arena_new(bytes: Int) -> Ptr { return __core_arena_new(bytes); }
fun arena_alloc(arena: Ptr, bytes: Int) -> Ptr { return __core_arena_alloc(arena, bytes); }
fun arena_reset(arena: Ptr) -> Nil { __core_arena_reset(arena); return; }
fun arena_used(arena: Ptr) -> Int { return __core_arena_used(arena); }
fun arena_capacity(arena: Ptr) -> Int { return __core_arena_capacity(arena); }
fun core_heap_retained() -> Int { return __core_heap_retained(); }
fun memcpy(destination: Ptr, source: Ptr, bytes: Int) -> Nil { __core_copy(destination, source, bytes); return; }
fun substring(s: Str, start: Int, count: Int) -> Str { return __core_substring(s, start, count); }
fun str_concat(a: Str, b: Str) -> Str { return a + b; }
fun range(start: Int, stop: Int) -> List<Int> {
    let values: List<Int> = []; mut n: Int = start;
    while (n < stop) { push(values, n); n += 1; }
    return values;
}
fun sum(values: Any) -> Int {
    mut result: Int = 0;
    for value: Any in values { result += value; }
    return result;
}
fun clamp(value: Int, low: Int, high: Int) -> Int { return min(max(value, low), high); }
fun gcd(a: Int, b: Int) -> Int {
    mut x: Int = abs(a); mut y: Int = abs(b);
    while (y != 0) { let remainder: Int = x % y; x = y; y = remainder; }
    return x;
}
fun lcm(a: Int, b: Int) -> Int { if (a == 0 or b == 0) { return 0; } return abs((a / gcd(a, b)) * b); }
fun is_space_code(c: Int) -> Bool { return c == 32 or c == 9 or c == 10 or c == 13; }
fun trim(s: Str) -> Str {
    mut start: Int = 0; mut stop: Int = len(s);
    while (start < stop and is_space_code(char_at(s, start))) { start += 1; }
    while (stop > start and is_space_code(char_at(s, stop - 1))) { stop -= 1; }
    return substring(s, start, stop - start);
}
fun repeat(s: Str, n: Int) -> Str {
    mut out: Str = ""; mut part: Str = s; mut left: Int = n;
    while (left > 0) {
        if (left % 2 == 1) { out = out + part; }
        left /= 2; if (left > 0) { part = part + part; }
    }
    return out;
}

fun float(x: Any) -> Any {
    let t: Any = value_tag(x);
    if (t == 6) { return x; }
    if (t == 0) { return to_float(x); }
    if (t != 1) { return __core_float_error(); }
    let s: Any = trim(x);
    let n: Any = len(s);
    mut i: Any = 0;
    mut sign: Any = 1.0;
    if (n > 0 && char_at(s, 0) == 45) { sign = 0.0 - 1.0; i = 1; }
    else if (n > 0 && char_at(s, 0) == 43) { i = 1; }
    mut val: Any = 0.0;
    mut fd: Any = 0;
    mut seen: Any = false;
    while (i < n) {
        let c: Any = char_at(s, i);
        if (c >= 48 && c <= 57) { val = val * 10.0 + to_float(c - 48); seen = true; i = i + 1; }
        else { break; }
    }
    if (i < n && char_at(s, i) == 46) {
        i = i + 1;
        while (i < n) {
            let c: Any = char_at(s, i);
            if (c >= 48 && c <= 57) {
                val = val * 10.0 + to_float(c - 48);
                fd = fd + 1;
                seen = true;
                i = i + 1;
            } else { break; }
        }
    }
    if (!seen) { return __core_float_error(); }
    mut ex: Any = 0;
    mut esign: Any = 1;
    if (i < n && (char_at(s, i) == 101 || char_at(s, i) == 69)) {
        i = i + 1;
        if (i < n && char_at(s, i) == 45) { esign = -1; i = i + 1; }
        else if (i < n && char_at(s, i) == 43) { i = i + 1; }
        while (i < n) {
            let c: Any = char_at(s, i);
            if (c >= 48 && c <= 57) { ex = ex * 10 + (c - 48); i = i + 1; }
            else { break; }
        }
    }
    if (i != n) { return __core_float_error(); }
    let e: Any = esign * ex - fd;
    if (e > 0) {
        mut p: Any = 1.0;
        mut k: Any = 0;
        while (k < e) { p = p * 10.0; k = k + 1; }
        val = val * p;
    } else if (e < 0) {
        mut p: Any = 1.0;
        mut k: Any = 0;
        let ne: Any = 0 - e;
        while (k < ne) { p = p * 10.0; k = k + 1; }
        val = val / p;
    }
    return sign * val;
}


fun bump(s: Any) -> Any {
    mut out: Any = s;
    mut i: Any = len(out) - 1;
    mut carry: Any = 1;
    while (i >= 0 && carry == 1) {
        let c: Any = char_at(out, i);
        if (c == 57) {
            out = substring(out, 0, i) + "0" + substring(out, i + 1, len(out) - i - 1);
        } else {
            out = substring(out, 0, i) + char_from(c + 1) + substring(out, i + 1, len(out) - i - 1);
            carry = 0;
        }
        i = i - 1;
    }
    return [carry, out];
}

/// Decompose a positive finite float into `[leading_digit, digits, exponent]`
/// so the value is `leading.digits * 10^exponent`. A single scaling division
/// keeps the mantissa close to exact (repeated division accumulates error).

// Normalize without depending on a platform libm. Scale the exponent in
// decades, then extract digits with the same formatter as the full runtime.
fun float_norm(v: Any) -> Any {
    mut e: Any = 0;
    mut m: Any = v;
    while (m >= 10.0 && e < 308) { m = m / 10.0; e += 1; }
    while (m < 1.0 && e > -324) { m = m * 10.0; e -= 1; }
    let whole: Any = floor(m);
    mut digits: Any = "";
    mut fr: Any = m - to_float(whole);
    mut i: Any = 0;
    while (i < 18 && cmp(fr, 0.000000000000000001) > 0) {
        fr = fr * 10.0;
        let d: Any = floor(fr);
        digits = digits + str(d);
        fr = fr - to_float(d);
        i += 1;
    }
    return [str(whole), digits, e];
}

fun float_sci(value: Any) -> Any {
    let n: Any = float_norm(value);
    let whole: Any = n[0];
    mut digits: Any = n[1];
    mut e: Any = n[2];
    // Whole digit plus at most 14 fractional digits = 15 significant digits.
    let extra: Any = if (len(digits) > 14) { 14 } else { len(digits) };
    mut mant: Any = whole + substring(digits, 0, extra);
    if (len(digits) > 14 && char_at(digits, 14) >= 53) {
        let r: Any = bump(mant);
        mant = r[1];
        if (r[0] == 1) { mant = "1" + mant; e = e + 1; }
    }
    // Trim trailing zeros, keeping at least the leading digit.
    mut end: Any = len(mant);
    while (end > 1 && char_at(mant, end - 1) == 48) { end = end - 1; }
    mant = substring(mant, 0, end);
    let lead: Any = substring(mant, 0, 1);
    let rest: Any = substring(mant, 1, len(mant) - 1);
    if (len(rest) == 0) { return lead + "e" + str(e); }
    return lead + "." + rest + "e" + str(e);
}

/// Format a boxed float, choosing the shortest rounded decimal that round-trips.

fun float_str(f: Any) -> Any {
    let payload: Any = addr(f);
    let high: Any = load32(payload + 4);
    if (high % 2147483648 >= 2146435072) {
        if (high % 1048576 != 0 || load32(payload) != 0) { return "nan"; }
        if (high >= 2147483648) { return "-inf"; }
        return "inf";
    }
    mut sign: Any = "";
    mut value: Any = f;
    if (cmp(value, 0.0) < 0) {
        sign = "-";
        value = 0.0 - value;
    }
    if (cmp(value, 0.0) == 0) { return sign + "0.0"; }
    if (cmp(value, 10000000000000000.0) >= 0 || cmp(value, 0.0001) < 0) {
        return sign + float_sci(value);
    }
    let whole: Any = floor(value);
    let frac: Any = value - to_float(whole);
    mut digits: Any = "";
    mut fr: Any = frac;
    mut i: Any = 0;
    while (i < 18 && fr > 0.000000000000001) {
        fr = fr * 10.0;
        mut d: Any = floor(fr);
        digits = digits + str(d);
        fr = fr - to_float(d);
        i = i + 1;
    }
    let nd: Any = len(digits);
    mut d: Any = 0;
    mut fb: Any = str(whole) + ".0";
    while (d <= nd) {
        mut prefix: Any = substring(digits, 0, d);
        mut carry: Any = 0;
        if (d < nd && char_at(digits, d) >= 53) {
            let r: Any = bump(prefix);
            carry = r[0];
            prefix = r[1];
        }
        let w: Any = whole + carry;
        mut end: Any = len(prefix);
        while (end > 0 && char_at(prefix, end - 1) == 48) { end = end - 1; }
        let kept: Any = substring(prefix, 0, end);
        mut cand: Any = str(w);
        if (len(kept) > 0) { cand = cand + "." + kept; }
        if (d <= 15) { fb = cand; }
        if (cmp(float(cand), value) == 0) {
            if (len(kept) == 0) { return sign + str(w) + ".0"; }
            return sign + str(w) + "." + kept;
        }
        d = d + 1;
    }
    return sign + fb;
}

// ------------------------------------------------------------------ lists

fun round(value: Any) -> Any { return floor(value + 0.5); }

// ------------------------------------------------------------------ math
// Portable transcendental functions use only binary64 arithmetic, so every
// core target produces the same bits. The kernels follow fdlibm/musl and stay
// within one ulp of a correctly rounded result for every finite input.

/// Read the high 32 bits of a Float; internal math helper.
fun __math_high(x: Any) -> Any { return load32(addr(x) + 4); }
/// Read the low 32 bits of a Float; internal math helper.
fun __math_low(x: Any) -> Any { return load32(addr(x)); }
/// Build a fresh Float from its low and high 32-bit words; internal math helper.
fun __math_bits(low: Any, high: Any) -> Any {
    let v: Any = to_float(high);
    let p: Any = addr(v);
    store32(p, low); store32(p + 4, high);
    return v;
}
/// Return a quiet NaN; internal math helper.
fun __math_nan() -> Any { return __math_bits(0, 2146959360); }
/// Return positive or negative infinity; internal math helper.
fun __math_inf(negative: Any) -> Any { return __math_bits(0, if (negative) { 4293918720 } else { 2146435072 }); }
/// Return positive or negative zero; internal math helper.
fun __math_zero(negative: Any) -> Any { return __math_bits(0, if (negative) { 2147483648 } else { 0 }); }
/// Test the sign bit of a Float, including negative zero; internal math helper.
fun __math_negative(x: Any) -> Any { return __math_high(x) >= 2147483648; }
/// 0 zero, 1 finite, 2 infinite, 3 NaN.
fun __math_kind(x: Any) -> Any {
    let high: Any = __math_high(x) % 2147483648;
    let low: Any = __math_low(x);
    if (high >= 2146435072) { if (high == 2146435072 and low == 0) { return 2; } return 3; }
    if (high == 0 and low == 0) { return 0; }
    return 1;
}
/// Exact 2^k for normal exponents -1022..1023.
fun __math_pow2(k: Any) -> Any { return __math_bits(0, (k + 1023) * 1048576); }
/// Multiply by 2^k for any integer k, saturating to infinity or zero; internal math helper.
fun __math_scale(x: Any, k: Any) -> Any {
    mut y: Any = x; mut n: Any = k;
    if (n > 1023) { y = y * __math_pow2(1023); n -= 1023; if (n > 1023) { y = y * __math_pow2(1023); n -= 1023; if (n > 1023) { n = 1023; } } }
    if (n < -1022) { y = y * __math_pow2(-969); n += 969; if (n < -1022) { y = y * __math_pow2(-969); n += 969; if (n < -1022) { n = -1022; } } }
    return y * __math_pow2(n);
}
/// Split a positive finite x into [k, m] with x = m * 2^k and sqrt(2)/2 <= m < sqrt(2).
fun __math_split(x: Any) -> Any {
    mut v: Any = x; mut bias: Any = 0;
    if (__math_high(v) < 1048576) { v = v * __math_pow2(54); bias = 54; }
    let high: Any = __math_high(v);
    mut k: Any = high / 1048576 - 1023;
    mut m: Any = __math_bits(__math_low(v), high % 1048576 + 1072693248);
    if (m > 1.4142135623730951) { m = m * 0.5; k += 1; }
    return [k - bias, m];
}
/// ln(m) for sqrt(2)/2 <= m < sqrt(2) as an unevaluated sum [hi, lo].
fun __math_log_kernel(m: Any) -> Any {
    let f: Any = m - 1.0;
    let s: Any = f / (2.0 + f);
    let z: Any = s * s; let w: Any = z * z;
    let t1: Any = w * (0.3999999999940942 + w * (0.22222198432149784 + w * 0.15313837699209373));
    let t2: Any = z * (0.6666666666666735 + w * (0.2857142874366239 + w * (0.1818357216161805 + w * 0.14798198605116586)));
    let hfsq: Any = 0.5 * f * f;
    let tail: Any = s * (hfsq + t1 + t2);
    let hi: Any = f - hfsq;
    let lo: Any = ((f - hi) - hfsq) + tail;
    return [hi + lo, lo - ((hi + lo) - hi)];
}
/// Return the result of ln/log2/log10 for zero, negative, infinite or NaN input, or nil for positive finite input; internal math helper.
fun __math_log_special(x: Any) -> Any {
    let kind: Any = __math_kind(x);
    if (kind == 3) { return x; }
    if (kind == 0) { return __math_inf(true); }
    if (__math_negative(x)) { return __math_nan(); }
    if (kind == 2) { return x; }
    return nil;
}
/// Return the natural logarithm; zero gives -inf and negative input NaN. Within one ulp.
fun ln(value: Any) -> Any {
    let x: Any = to_float(value);
    let special: Any = __math_log_special(x);
    if (special != nil) { return special; }
    let parts: Any = __math_split(x);
    let k: Any = to_float(parts[0]);
    let r: Any = __math_log_kernel(parts[1]);
    return k * 0.6931471803691238 + (r[0] + (r[1] + k * 1.9082149292705877e-10));
}
/// Return the base-2 logarithm; exact for powers of two. Within one ulp.
fun log2(value: Any) -> Any {
    let x: Any = to_float(value);
    let special: Any = __math_log_special(x);
    if (special != nil) { return special; }
    let parts: Any = __math_split(x);
    let r: Any = __math_log_kernel(parts[1]);
    return to_float(parts[0]) + (r[0] * 1.4426950408889634 + r[1] * 1.4426950408889634);
}
/// Return the base-10 logarithm. Within one ulp.
fun log10(value: Any) -> Any {
    let x: Any = to_float(value);
    let special: Any = __math_log_special(x);
    if (special != nil) { return special; }
    let parts: Any = __math_split(x);
    let k: Any = to_float(parts[0]);
    let r: Any = __math_log_kernel(parts[1]);
    let y: Any = k * 3.694239077158931e-13 + (r[0] + r[1]) * 0.4342944819032518;
    return y + k * 0.30102999566361177;
}
/// exp(hi - lo) * 2^k for |hi - lo| <= ln(2)/2. The Taylor tail is added to
/// 1 + hi with compensation, which rounds correctly far more often than
/// fdlibm's rational kernel.
fun __math_exp_kernel(hi: Any, lo: Any, k: Any) -> Any {
    let r: Any = hi - lo;
    let q: Any = r * r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * (0.001388888888888889 + r * (0.0001984126984126984 + r * (2.48015873015873e-05 + r * (2.7557319223985893e-06 + r * (2.755731922398589e-07 + r * (2.505210838544172e-08 + r * (2.08767569878681e-09 + r * (1.6059043836821613e-10 + r * (1.1470745597729725e-11)))))))))))));
    let s: Any = 1.0 + hi;
    let y: Any = s + (((1.0 - s) + hi) + (q - lo));
    if (k == 0) { return y; }
    return __math_scale(y, k);
}
/// Return e raised to a number; overflows to inf above about 709.78 and underflows to zero. Within one ulp.
fun exp(value: Any) -> Any {
    let x: Any = to_float(value);
    let kind: Any = __math_kind(x);
    if (kind == 3) { return x; }
    if (kind == 2) { if (__math_negative(x)) { return 0.0; } return x; }
    if (x > 709.782712893384) { return __math_inf(false); }
    if (x < -745.1332191019411) { return 0.0; }
    if (x > -3.725290298461914e-09 and x < 3.725290298461914e-09) { return 1.0 + x; }
    let k: Any = trunc(x * 1.4426950408889634 + if (x < 0.0) { -0.5 } else { 0.5 });
    let fk: Any = to_float(k);
    return __math_exp_kernel(x - fk * 0.6931471803691238, fk * 1.9082149292705877e-10, k);
}
/// Evaluate sin(x + y) for |x + y| <= pi/4 (fdlibm kernel); internal math helper.
fun __math_sin_kernel(x: Any, y: Any, tail: Any) -> Any {
    let z: Any = x * x; let w: Any = z * z;
    let r: Any = 0.00833333333332249 + z * (-1.9841269829857949e-4 + z * 2.7557313707070068e-06) + z * w * (-2.5050760253406863e-08 + z * 1.58969099521155e-10);
    let v: Any = z * x;
    if (not tail) { return x + v * (-0.16666666666666632 + z * r); }
    return x - ((z * (0.5 * y - v * r) - y) - v * -0.16666666666666632);
}
/// Evaluate cos(x + y) for |x + y| <= pi/4 (fdlibm kernel); internal math helper.
fun __math_cos_kernel(x: Any, y: Any) -> Any {
    let z: Any = x * x; let w: Any = z * z;
    let r: Any = z * (0.0416666666666666 + z * (-0.001388888888887411 + z * 2.480158728947673e-05)) + w * w * (-2.7557314351390663e-07 + z * (2.087572321298175e-09 + z * -1.1359647557788195e-11));
    let hz: Any = 0.5 * z;
    let c: Any = 1.0 - hz;
    return c + (((1.0 - c) - hz) + (z * r - x * y));
}
/// tan(x + y) for |x + y| <= pi/4, or -1/tan when odd (musl __tan).
fun __math_tan_kernel(x0: Any, y0: Any, odd: Any) -> Any {
    mut x: Any = x0; mut y: Any = y0;
    let big: Any = __math_high(x) % 2147483648 >= 1072010280;
    let negative: Any = __math_negative(x);
    if (big) {
        if (negative) { x = x * -1.0; y = y * -1.0; }
        x = (0.7853981633974483 - x) + (3.061616997868383e-17 - y);
        y = 0.0;
    }
    let z: Any = x * x; let w: Any = z * z;
    mut r: Any = 0.13333333333320124 + w * (0.021869488294859542 + w * (0.0035920791075913124 + w * (0.0005880412408202641 + w * (7.817944429395571e-05 + w * -1.8558637485527546e-05))));
    let v: Any = z * (0.05396825397622605 + w * (0.0088632398235993 + w * (0.0014562094543252903 + w * (0.0002464631348184699 + w * (7.140724913826082e-05 + w * 2.590730518636337e-05)))));
    let s: Any = z * x;
    r = y + z * (s * (r + v) + y) + s * 0.3333333333333341;
    let t: Any = x + r;
    if (big) {
        let sign: Any = if (odd) { -1.0 } else { 1.0 };
        let u: Any = sign - 2.0 * (x + (r - t * t / (t + sign)));
        if (negative) { return 0.0 - u; }
        return u;
    }
    if (not odd) { return t; }
    // -1/(x + r) has up to 2 ulp error, so compute it with split operands.
    let t0: Any = __math_bits(0, __math_high(t));
    let rest: Any = r - (t0 - x);
    let a: Any = -1.0 / t;
    let a0: Any = __math_bits(0, __math_high(a));
    return a0 + a * (1.0 + a0 * t0 + a0 * rest);
}
/// Read the biased binary exponent of a Float; internal math helper.
fun __math_exponent(x: Any) -> Any { return __math_high(x) % 2147483648 / 1048576; }
/// Reduce x to [n mod 4, y0, y1] with x = n*pi/2 + y0 + y1 (fdlibm medium
/// path). Extra rounds run only after cancellation, where they are exact.
fun __math_reduce(x: Any) -> Any {
    let n: Any = trunc(x * 0.6366197723675814 + if (x < 0.0) { -0.5 } else { 0.5 });
    let fn: Any = to_float(n);
    let j: Any = __math_exponent(x);
    mut r: Any = x - fn * 1.5707963267341256;
    mut w: Any = fn * 6.077100506506192e-11;
    mut y0: Any = r - w;
    if (j - __math_exponent(y0) > 16) {
        mut t: Any = r;
        w = fn * 6.077100506303966e-11;
        r = t - w;
        w = fn * 2.0222662487959506e-21 - ((t - r) - w);
        y0 = r - w;
        if (j - __math_exponent(y0) > 49) {
            t = r;
            w = fn * 2.0222662487111665e-21;
            r = t - w;
            w = fn * 8.4784276603689e-32 - ((t - r) - w);
            y0 = r - w;
        }
    }
    return [((n % 4) + 4) % 4, y0, (r - y0) - w];
}
/// Payne-Hanek reduction for |x| >= 2^20 * pi/2: multiply the 53-bit
/// significand by 24-bit limbs of 2/pi, keep the value modulo 4 with 192
/// fraction bits, then multiply the fraction by pi/2 in exact 24-bit pieces.
fun __math_reduce_large(x: Any) -> Any {
    let two_over_pi: List<Int> = [
        10680707, 7228996, 1387004, 2578385, 16069853, 12639074, 9804092, 4427841, 16666979, 11263675,
        12935607, 2387514, 4345298, 14681673, 3074569, 13734428, 16653803, 1880361, 10960616, 8533493,
        3062596, 8710556, 7349940, 6258241, 3772886, 3769171, 3798172, 8675211, 12450088, 3874808,
        9961438, 366607, 15675153, 9132554, 7151469, 3571407, 2607881, 12013382, 4155038, 6285869,
        7677882, 13102053, 15825725, 473591, 9065106, 15363067, 6271263, 9264392, 5636912, 4652155,
        7056368, 13614112, 10155062, 1944035, 9527646, 15080200, 6658437, 6231200, 6832269, 16767104];
    let pio2: List<Float> = [1.570796251296997, 7.549789415861596e-08, 5.390302529957765e-15, 3.282003415807913e-22, 1.270655753080676e-29, 1.2293330898111133e-36, 2.7337005381646456e-44, 2.1674168387780482e-51];
    let negative: Any = x < 0.0;
    let ax: Any = if (negative) { 0.0 - x } else { x };
    let high: Any = __math_high(ax);
    let e0: Any = high / 1048576 - 1075;
    let mantissa: Any = (high % 1048576 + 1048576) * 4294967296 + __math_low(ax);
    let shift: Any = ((e0 % 24) + 24) % 24;
    let e24: Any = (e0 - shift) / 24;
    mut scale: Any = 1; mut k: Any = 0;
    while (k < shift) { scale = scale * 2; k += 1; }
    let limbs: List<Int> = [];
    mut carry: Any = 0; mut rest: Any = mantissa;
    k = 0;
    while (k < 3) {
        let v: Any = (rest % 16777216) * scale + carry;
