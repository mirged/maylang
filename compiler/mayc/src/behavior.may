import "parser.may";
import "sema.may";
import "state.may";
import "symbols.may";
import "diagnostics.may";
import "ast.may";
import "strict.may";
// Closed scalar effect fragment. Unsupported operations are unknown, never
// evidence of an empty effect row. This pass precedes closure conversion.
mut BEHAVIOR_EXPLAIN: Any = false;
mut BEHAVIOR_PATH: Any = [];
mut BEHAVIOR_STATES: Any = {};
mut BEHAVIOR_GRAPHS: Any = [];
mut BEHAVIOR_CURRENT: Any = 0;
mut BEHAVIOR_ISSUE: Any = nil;
fun behavior_error(span: Any, reason: Any) -> Any {
    if (BEHAVIOR_CURRENT != 0) { BEHAVIOR_ISSUE = {"span": span, "reason": reason}; }
    diagnostic(span, "MB-EFFECT-001: behavior contract: " + reason + " [call path: " + join(BEHAVIOR_PATH, " -> ") + "]");
    return 0;
}
fun behavior_value_type(annotation: Any, span: Any) -> Any {
    if (annotation != nil and annotation != 0 and annotation.name == "Function") {
        if (annotation.behaviorEffects == nil) { return behavior_error(span, "callable type requires an explicit effect row"); }
        for argument: Any in annotation.arguments { behavior_value_type(argument, span); }
        return behavior_value_type(annotation.result, span);
    }
    return behavior_scalar(annotation, span);
}
fun behavior_add_effects(effects: Any, span: Any, name: Any) -> Any {
    for effect: Any in effects {
        if (not has(BEHAVIOR_CURRENT.effects, effect)) {
            BEHAVIOR_CURRENT.effects[effect] = {"span": span, "path": [BEHAVIOR_CURRENT.name, name]};
        }
    }
    return 0;
}
fun behavior_scalar(annotation: Any, span: Any) -> Any {
    if (annotation == nil or annotation == 0) { return behavior_error(span, "requires explicit Int, Bool or Float types"); }
    if (not has(["Int", "Bool", "Float"], annotation.name) or len(annotation.arguments) != 0) {
        return behavior_error(span, "only Int, Bool and Float types are supported");
    }
    return 0;
}
fun behavior_scope(locals: Any) -> Any {
    let scope: Any = {}; for name: Any in keys(locals) { scope[name] = locals[name]; }
    return scope;
}
fun behavior_node(node: Any, locals: Any, functions: Any) -> Any {
    if (node == 0) { return 0; }
    let k: Any = node.kind;
    if (k == E_INT or k == E_FLOAT) { return 0; }
    if (k == E_VAR) {
        let name: Any = symbol_name(node.name, node.length);
        if (has(locals, name)) { return 0; }
        if (has(["true", "false"], name)) {
            let shadow: Any = may { st_export_name(source_module(node.span), name, node.span, functions) } otherwise { nil };
            if (shadow == nil) { return 0; }
        }
        if (BEHAVIOR_CALLABLES) {
            if (node.moduleObject != nil) {
                let alias: Any = symbol_name(node.moduleObject.name, node.moduleObject.length);
                if (has(locals, alias) or has(functions, source_module(node.span) + "::" + alias)) {
                    return behavior_error(node.span, "shadowed module alias has unknown behavior");
                }
            }
            let key: Any = may { st_export_name(source_module(node.span), replace(name, "::", "."), node.span, functions) } otherwise { nil };
            if (key != nil) {
                let rec: Any = functions[key];
                if (rec.lab != nil and rec.behaviorUnknown != true and source_module(rec.moduleSpan ?? rec.body.span) != "") { return 0; }
            }
        }
        return behavior_error(node.span, "global or captured value `" + name + "` is not permitted");
    }
    if (k == E_BIN or k == E_AND or k == E_OR) {
        behavior_node(node.left, locals, functions); behavior_node(node.right, locals, functions); return 0;
    }
    if (k == E_UN) { return behavior_node(node.operand, locals, functions); }
    if (k == E_CALL or k == E_ICALL) {
        mut target: Any = node;
        if (k == E_ICALL) {
            target = node.callee;
            if (target.kind != E_VAR) { return behavior_error(node.span, "indirect calls are not supported"); }
            if (target.moduleObject != nil) {
                let alias: Any = symbol_name(target.moduleObject.name, target.moduleObject.length);
                if (has(locals, alias) or has(functions, source_module(target.span) + "::" + alias)) {
                    return behavior_error(node.span, "shadowed module alias has unknown behavior");
                }
            }
        }
        let name: Any = symbol_name(target.name, target.length);
        if (has(locals, name)) {
            let binding: Any = locals[name];
            if (binding.annotation.name != "Function" or binding.annotation.behaviorEffects == nil) {
                return behavior_error(node.span, "indirect calls are not supported");
            }
            behavior_add_effects(binding.annotation.behaviorEffects, node.span, name);
            mut argument: Any = node.args;
            while (argument != 0) { behavior_node(argument, locals, functions); argument = argument.next; }
            return 0;
        }
        let key: Any = may { st_export_name(source_module(node.span), replace(name, "::", "."), node.span, functions) } otherwise { behavior_error(node.span, "unresolved or primitive call `" + name + "`: " + err.message); "" };
        let callee: Any = functions[key];
        if (callee.behaviorUnknown == true) { return behavior_error(node.span, "call to `" + name + "` has unknown behavior through a global binding"); }
        if (callee.primitiveEffects != nil) {
            behavior_add_effects(callee.primitiveEffects, node.span, name);
        } else {
            push(BEHAVIOR_CURRENT.calls, {"target": callee.lab});
            behavior_function(callee, functions);
        }
        mut arg: Any = node.args;
        while (arg != 0) { behavior_node(arg, locals, functions); arg = arg.next; }
        return 0;
    }
    if (k == S_RETURN or k == S_EXPR) { return behavior_node(if (k == S_RETURN) { node.value } else { node.expression }, locals, functions); }
    if (k == S_BLOCK) {
        let scope: Any = behavior_scope(locals);
        mut statement: Any = node.statements;
        while (statement != 0) { behavior_node(statement, scope, functions); statement = statement.next; }
        return behavior_node(node.tail, scope, functions);
    }
    if (k == S_IF) {
        behavior_node(node.condition, locals, functions);
        behavior_node(node.thenBranch, behavior_scope(locals), functions);
        behavior_node(node.elseBranch, behavior_scope(locals), functions);
        return 0;
    }
    if (k == S_WHILE) {
        behavior_node(node.condition, locals, functions);
        BEHAVIOR_CURRENT.loopDepth += 1;
        behavior_node(node.body, behavior_scope(locals), functions);
        BEHAVIOR_CURRENT.loopDepth -= 1;
        return 0;
    }
    if (k == S_FOR) {
        // Only literal Int ranges: their private list never escapes the loop,
        // and the binding is an immutable Int. Collections remain unknown.
        let range: Any = node.iterable;
        if (range == 0 or range.kind != E_RANGE) { return behavior_error(node.span, "for loops must iterate over an Int range `a..b` or `a..=b`"); }
        behavior_node(range.start, locals, functions);
        behavior_node(range.end, locals, functions);
        if (node.annotation != nil and node.annotation != 0) {
            behavior_scalar(node.annotation, node.span);
            if (node.annotation.name != "Int") { return behavior_error(node.span, "range loop variable must be Int"); }
        }
        let scope: Any = behavior_scope(locals);
        scope[symbol_name(node.name, node.length)] = {"mutable": false, "annotation": {"name": "Int", "arguments": []}};
        BEHAVIOR_CURRENT.loopDepth += 1;
        behavior_node(node.body, scope, functions);
        BEHAVIOR_CURRENT.loopDepth -= 1;
        return 0;
    }
    if (k == S_BREAK or k == S_CONT) {
        if (BEHAVIOR_CURRENT.loopDepth == 0) { return behavior_error(node.span, "loop control requires an enclosing while or for loop"); }
        return 0;
    }
    if (k == S_LET) {
        behavior_value_type(node.annotation, node.span);
        behavior_node(node.initializer, locals, functions);
        locals[symbol_name(node.name, node.length)] = {"mutable": node.mutable, "annotation": node.annotation};
        return 0;
    }
    if (k == S_ASSIGN) {
        let name: Any = symbol_name(node.name, node.length);
        if (not has(locals, name)) { return behavior_error(node.span, "assignment to global or captured value `" + name + "` is not permitted"); }
        if (not locals[name].mutable) { return behavior_error(node.span, "cannot assign to immutable local `" + name + "`"); }
        return behavior_node(node.value, locals, functions);
    }
    return behavior_error(node.span, "operation is outside the supported scalar behavior subset");
}
// Global value bindings can shadow function declarations during name resolution.
// Keep them in this registry as unknown behavior, including destructuring.
fun behavior_global(functions: Any, name: Any, span: Any) -> Any {
    let module: Any = source_module(span);
    functions[if (module == "") { name } else { module + "::" + name }] = {"behaviorUnknown": true};
    return 0;
}
fun behavior_pattern(functions: Any, pattern: Any, span: Any) -> Any {
    mut entry: Any = pattern;
    while (entry != 0) {
        if (entry.nested != 0) { behavior_pattern(functions, entry.nested, span); }
        else { behavior_global(functions, symbol_name(entry.name, entry.length), span); }
        entry = entry.next;
    }
    return 0;
}
// Queue each reachable body once. Breadth-first discovery gives unknown
// operations a shortest path from the current explicit contract, including
// when an earlier call takes a longer route to the same unsupported body.
fun behavior_function(rec: Any, functions: Any) -> Any {
    if (has(BEHAVIOR_STATES, rec.lab)) { return 0; }
    let name: Any = symbol_name(rec.p, rec.l);
    let graph: Any = {"record": rec, "name": name, "effects": {}, "calls": [], "path": BEHAVIOR_PATH + [name], "loopDepth": 0};
    BEHAVIOR_STATES[rec.lab] = graph;
    push(BEHAVIOR_GRAPHS, graph);
    return 0;
}
fun behavior_body(graph: Any, functions: Any) -> Any {
    let rec: Any = graph.record;
    BEHAVIOR_CURRENT = graph;
    BEHAVIOR_PATH = graph.path;
    if (rec.foreign == true or source_module(rec.moduleSpan ?? rec.body.span) == "") {
        return behavior_error(rec.body.span, "native and runtime calls have unknown behavior");
    }
    if (len(rec.typeParameters ?? []) != 0 or rec.nested != 0) { return behavior_error(rec.body.span, "generic and nested contracts are not supported"); }
    behavior_value_type(rec.returnType, rec.body.span);
    let locals: Any = {};
    for param: Any in rec.parr {
        behavior_value_type(param.annotation, param.span);
        locals[symbol_name(param.name, param.length)] = {"mutable": true, "annotation": param.annotation};
    }
    behavior_node(rec.body, locals, functions);
    BEHAVIOR_PATH = []; BEHAVIOR_CURRENT = 0;
    return 0;
}
fun behavior_discover(graph: Any, functions: Any) -> Any {
    let previous_span: Any = DIAGNOSTIC_SPAN;
    BEHAVIOR_ISSUE = nil;
    may { behavior_body(graph, functions); } otherwise {
        if (BEHAVIOR_ISSUE == nil) { fail(err.message); }
        graph.unknown = {"span": BEHAVIOR_ISSUE.span, "reason": BEHAVIOR_ISSUE.reason, "path": [graph.name]};
    }
    BEHAVIOR_CURRENT = 0; BEHAVIOR_PATH = []; BEHAVIOR_ISSUE = nil;
    DIAGNOSTIC_SPAN = previous_span;
    return 0;
}
fun behavior_analysis_scope() -> Any {
    return if (BEHAVIOR_CALLABLES) { "scalar_callable_effects_v1" } else { "scalar_effects_v1" };
}
fun behavior_solve() -> Any {
    mut changed: Any = true;
    while (changed) {
        changed = false;
        for graph: Any in BEHAVIOR_GRAPHS {
            for edge: Any in graph.calls {
                let callee: Any = BEHAVIOR_STATES[edge.target];
                if (callee.unknown != nil and (graph.unknown == nil or len(callee.unknown.path) + 1 < len(graph.unknown.path))) {
                    graph.unknown = {"span": callee.unknown.span, "reason": callee.unknown.reason, "path": [graph.name] + callee.unknown.path};
                    changed = true;
                }
                for effect: Any in sort(keys(callee.effects)) {
                    let witness: Any = callee.effects[effect];
                    // Relax witness distances as well as effect membership.
                    // A later edge or iteration can reveal a shorter path;
                    // strict improvement terminates even for recursive graphs.
                    if (not has(graph.effects, effect) or len(witness.path) + 1 < len(graph.effects[effect].path)) {
                        graph.effects[effect] = {"span": witness.span, "path": [graph.name] + witness.path};
                        changed = true;
                    }
                }
            }
        }
    }
    for graph: Any in BEHAVIOR_GRAPHS {
        let rec: Any = graph.record;
        if (graph.unknown != nil) {
            rec.behaviorSummary = nil; rec.inferredPure = false;
            if (rec.behaviorContract == true) {
                BEHAVIOR_PATH = graph.unknown.path;
                return behavior_error(graph.unknown.span, graph.unknown.reason);
            }
            continue;
        }
        let effects: Any = sort(keys(graph.effects));
        rec.behaviorSummary = {"effects": effects, "classification": "proven", "scope": behavior_analysis_scope(), "name": graph.name};
        rec.inferredPure = len(effects) == 0;
        if (rec.behaviorContract == true) {
            for effect: Any in effects {
                if (not has(rec.behaviorEffects, effect)) {
                    let witness: Any = graph.effects[effect]; BEHAVIOR_PATH = witness.path;
                    return behavior_error(witness.span, "effect `" + effect + "` exceeds declared ceiling [" + join(rec.behaviorEffects, ", ") + "] of `" + graph.name + "`");
                }
            }
        }
    }
    return 0;
}
fun behavior_program() -> Any {
    mut enabled: Any = BEHAVIOR_CALLABLES;
    for rec: Any in FUNC_HEAD { if (rec.behaviorContract == true) { enabled = true; } }
    if (not enabled) { return 0; }
    if (BEHAVIOR_CALLABLES and not STRICT_TYPES) { return behavior_error(BEHAVIOR_CALLABLE_SPAN, "requires strict type checking; remove --legacy"); }
    BEHAVIOR_PATH = []; BEHAVIOR_STATES = {}; BEHAVIOR_GRAPHS = []; BEHAVIOR_CURRENT = 0;
    let functions: Any = {};
    for rec: Any in FUNC_HEAD {
        if (rec.nested == 0) {
            let module: Any = source_module(rec.moduleSpan ?? rec.body.span);
            let name: Any = symbol_name(rec.p, rec.l);
            functions[if (module == "") { name } else { module + "::" + name }] = rec;
        }
    }
    // These names are runtime primitives in the existing resolver. User module
    // functions and globals still take precedence over these unqualified names.
    functions["print"] = {"primitiveEffects": ["output"]};
    functions["time"] = {"primitiveEffects": ["clock"]};
    functions["clock"] = {"primitiveEffects": ["clock"]};
    // Explicit empty rows are audited rules, never a fallback for unknown calls.
    functions["pi"] = {"primitiveEffects": []};
    functions["e"] = {"primitiveEffects": []};
    for head: Any in [RUNTIME_BODY, MAINBODY] {
        mut statement: Any = head;
        while (statement != 0) {
            if (statement.kind == S_LET and statement.global == 1) { behavior_global(functions, symbol_name(statement.name, statement.length), statement.span); }
            if (statement.kind == S_DESTRUCT and statement.global == 1) { behavior_pattern(functions, statement.pattern, statement.span); }
            statement = statement.next;
        }
    }
    for rec: Any in FUNC_HEAD {
        if (rec.behaviorContract == true) {
            if (not STRICT_TYPES) { return behavior_error(rec.body.span, "requires strict type checking; remove --legacy"); }
            mut pending: Any = len(BEHAVIOR_GRAPHS);
            behavior_function(rec, functions);
            while (pending < len(BEHAVIOR_GRAPHS)) {
                behavior_discover(BEHAVIOR_GRAPHS[pending], functions);
                pending += 1;
            }
        }
    }
    if (BEHAVIOR_CALLABLES) {
        // Infer source function values without confusing value creation with
        // execution. Unknown unannotated bodies do not acquire finite rows.
        for rec: Any in FUNC_HEAD {
            if (rec.nested == 0 and source_module(rec.moduleSpan ?? rec.body.span) != "") {
                mut pending: Any = len(BEHAVIOR_GRAPHS);
                behavior_function(rec, functions);
                while (pending < len(BEHAVIOR_GRAPHS)) {
                    behavior_discover(BEHAVIOR_GRAPHS[pending], functions);
                    pending += 1;
                }
            }
        }
    }
    behavior_solve();
    BEHAVIOR_PATH = []; BEHAVIOR_STATES = {}; BEHAVIOR_GRAPHS = []; BEHAVIOR_CURRENT = 0;
    return 0;
}

// Report only successfully checked functions rooted at explicit contracts.
// An omitted function has no summary, rather than an implicit pure summary.
fun behavior_report() -> Any {
    let entries: Any = [];
    for rec: Any in FUNC_HEAD {
        let summary: Any = rec.behaviorSummary;
        if (summary != nil) {
            let location: Any = diagnostic_record(rec.moduleSpan ?? rec.body.span, "");
            push(entries, {"name": summary.name, "file": location.file, "range": location.range,
                "declared_effects": if (rec.behaviorContract == true) { rec.behaviorEffects } else { nil },
                "inferred_effects": summary.effects, "classification": summary.classification});
        }
    }
    return {"schema_version": 1, "scope": behavior_analysis_scope(),
        "analysis_roots": if (BEHAVIOR_CALLABLES) { "all_source_functions" } else { "explicit_contracts" }, "functions": entries};
}

// Emission owns normalized values, never a frontend graph/body or mutable row.
// Missing summaries stay unknown; do not manufacture an empty row for them.
fun behavior_ir_summary(rec: Any) -> Any {
    let summary: Any = rec.behaviorSummary;
    if (summary == nil) { return nil; }
    let inferred: Any = [];
    for effect: Any in summary.effects { push(inferred, effect); }
    mut declared: Any = nil;
    if (rec.behaviorContract == true) {
        declared = [];
        for effect: Any in rec.behaviorEffects { push(declared, effect); }
    }
    return {"schema_version": 1, "scope": summary.scope, "classification": summary.classification,
        "name": summary.name, "symbol": symbol_name(rec.p, rec.l),
        "declared_effects": declared, "inferred_effects": inferred};
}
