import "state.may";
import "ast.may";
import "lexer.may";
import "symbols.may";
import "sema.may";
import "diagnostics.may";
import "emitter.may";
// words.may — native-word lowering for strictly typed integer functions (#92).
//
// A user function whose parameters and result are all `Int`, `Ptr` or `Bool`,
// and whose body only computes with such locals and globals, raw memory access
// (`load8`..`load64`, `store8`..`store64`), `syscall` and integer externs, compiles as native
// 64-bit machine words, so loads and syscall results keep all 64 bits until
// the result returns to tagged code.
// Its tagged-ABI entry untags arguments and retags the result, raising the
// ordinary `integer overflow` fault when the result leaves the tagged range.
// Bool is 0/1 in native code (tagged 3/4). Calls between native-word
// functions pass machine words directly. A call to a tagged function with an
// Int/Ptr/Bool signature goes through that function's word adapter, which
// tags the arguments (faulting outside the 61-bit range) and untags the
// result. Calls to `extern` functions whose C types are all integers,
// pointers or Bool (`word_foreign`) pass words to C; their native entry only
// range-checks UInt. Globals keep tagged values, so the
// scan marks global reads and writes (`wordGlobal`) for IR to convert.

let WORD_ARITHMETIC: Any = [TK_PLUS, TK_MINUS, TK_STAR, TK_SLASH, TK_PCT, TK_BITAND, TK_PIPE, TK_XOR, TK_SHL, TK_SHR];
let WORD_ORDERING: Any = [TK_EQ, TK_NE, TK_LT, TK_LE, TK_GT, TK_GE];
// Builtins lowered natively, with their minimum and maximum argument counts.
// `syscall` takes the raw path.
let WORD_BUILTINS: Any = {"load8": [1, 1], "load16": [1, 1], "load32": [1, 1], "load64": [1, 1],
    "store8": [2, 2], "store16": [2, 2], "store32": [2, 2], "store64": [2, 2], "syscall": [1, 7]};

fun word_builtin(scan: Any, node: Any, name: Any) -> Any {
    return has(WORD_BUILTINS, name) and not has(scan.names, name) and glob_find(scan.ctx, node.name, node.length) < 0;
}

// FFI kinds (ffi.may) a native-word call passes as words: Int, UInt, Ptr and
// Bool, and Void results. Int32 and UInt32 values carry strict range
// contracts, which keep their users tagged. Only targets with a native extern
// bridge (x86-64 Linux ELF), at most six arguments.
fun word_foreign(ctx: Any, rec: Any) -> Any {
    // Fat values call externs through their fat entry (x86_64_fat.may) for now.
    if (rec.foreign != true or rec.pc > 6 or DYNMODE == 1) { return false; }
    if (not (ctx.target.arch == "x86_64" and ctx.target.os == "linux")) { return false; }
    for kind: Any in rec.ffiArgs { if (not has([0, 1, 6, 8], kind)) { return false; } }
    return has([0, 1, 6, 8, 9], rec.ffiResult);
}

// A call to a word-compatible extern. `expected` is "Nil" for a statement.
fun word_foreign_call(scan: Any, node: Any, callee: Any, expected: Any) -> Any {
    if (callee.wordForeign != true) { return word_reject(scan); }
    let result: Any = callee.ffiResult;
    let wanted: Any = if (result == 9) { "Nil" } else if (result == 8) { "Bool" } else { "Int" };
    if (wanted != expected) { return word_reject(scan); }
    mut count: Any = 0;
    mut arg: Any = node.args;
    while (arg != 0) {
        if (count >= callee.pc) { return word_reject(scan); }
        if (not word_value(scan, arg, if (callee.ffiArgs[count] == 8) { "Bool" } else { "Int" })) { return false; }
        count += 1; arg = arg.next;
    }
    return count == callee.pc or word_reject(scan);
}

// The extern a call node names, or 0.
fun word_extern(scan: Any, node: Any) -> Any {
    if (node == 0 or node.kind != E_CALL) { return 0; }
    let name: Any = symbol_name(node.name, node.length);
    if (word_local(scan, name) or not has(scan.names, name)) { return 0; }
    let callee: Any = scan.names[name];
    return if (callee.foreign == true) { callee } else { 0 };
}

// Outlined bitwise expressions: the function name table from words_mark,
// functions created since ir_program last registered them, and name storage.
mut WORD_NAMES: Any = {};
mut WORD_PENDING: Any = [];
mut WORD_LABELS: Any = [];

struct WordScan { ctx: Any, rec: Any, result: Any, names: Any, scopes: Any, calls: Any, valid: Any }

fun word_type(t: Any, name: Any) -> Any {
    return t != nil and t != 0 and t.name == name and len(t.arguments ?? []) == 0;
}

// Ptr shares the tagged Int representation, so it untags and retags the same way.
fun word_int(t: Any) -> Any { return word_type(t, "Int") or word_type(t, "Ptr"); }

// The native kind of a parameter, result or local: "Int" (also Ptr), "Bool" or nil.
fun word_kind(t: Any) -> Any {
    if (word_int(t)) { return "Int"; }
    if (word_type(t, "Bool")) { return "Bool"; }
    return nil;
}

// A value whose kind follows its static type; folded literals have none and are Int.
fun word_typed(scan: Any, node: Any) -> Any {
    if (node == 0) { return word_reject(scan); }
    return word_value(scan, node, word_kind(node.strictType) ?? "Int");
}

fun word_plain(node: Any) -> Any { return node.contract == nil or node.contract == 0; }

fun word_local(scan: Any, name: Any) -> Any {
    for scope: Any in scan.scopes { if (has(scope, name)) { return true; } }
    return false;
}

fun word_reject(scan: Any) -> Any { scan.valid = false; return false; }

// Every value must be an uncontracted Int or Ptr (or Bool, for control flow only).
fun word_value(scan: Any, node: Any, expected: Any) -> Any {
    if (not scan.valid) { return false; }
    // Name resolution folds small literal arithmetic into untyped literals.
    if (node != 0 and node.kind == E_INT and expected == "Int" and word_plain(node) and node.strictType == nil) { return true; }
    if (node == 0 or not word_plain(node)) { return word_reject(scan); }
    // Extern results carry their C binding type (Int32, Nil, ...).
    let foreign: Any = word_extern(scan, node);
    if (foreign != 0) { return word_foreign_call(scan, node, foreign, expected); }
    if (not (if (expected == "Int") { word_int(node.strictType) } else { word_type(node.strictType, expected) })) { return word_reject(scan); }
    let kind: Any = node.kind;
    if (kind == E_INT) { return true; }
    if (kind == E_VAR) {
        let name: Any = symbol_name(node.name, node.length);
        if (expected == "Bool" and (name == "true" or name == "false") and not word_local(scan, name)) { return true; }
        if (word_local(scan, name)) { return true; }
        if (glob_find(scan.ctx, node.name, node.length) < 0) { return word_reject(scan); }
        node.wordGlobal = expected;
        return true;
    }
    if (kind == E_BIN) {
        if (has(WORD_ARITHMETIC, node.op)) {
            return expected == "Int" and word_value(scan, node.left, "Int") and word_value(scan, node.right, "Int");
        }
        if (has(WORD_ORDERING, node.op) and expected == "Bool") {
            let operand: Any = if (word_type(node.left.strictType, "Bool") and (node.op == TK_EQ or node.op == TK_NE)) { "Bool" } else { "Int" };
            return word_value(scan, node.left, operand) and word_value(scan, node.right, operand);
        }
        return word_reject(scan);
    }
    if (kind == E_UN) {
        if (node.op == TK_MINUS or node.op == TK_BITNOT) { return expected == "Int" and word_value(scan, node.operand, "Int"); }
        if (node.op == TK_NOT) { return expected == "Bool" and word_value(scan, node.operand, "Bool"); }
        return word_reject(scan);
    }
    if (kind == E_AND or kind == E_OR) {
        return expected == "Bool" and word_value(scan, node.left, "Bool") and word_value(scan, node.right, "Bool");
    }
    if (kind == E_CALL) {
        let name: Any = symbol_name(node.name, node.length);
        if (word_local(scan, name)) { return word_reject(scan); }
        if (word_builtin(scan, node, name)) {
            mut operands: Any = 0;
            mut operand: Any = node.args;
            while (operand != 0) {
                if (not word_value(scan, operand, "Int")) { return false; }
                operands += 1; operand = operand.next;
            }
            let arity: Any = WORD_BUILTINS[name];
            return (expected == "Int" and operands >= arity[0] and operands <= arity[1]) or word_reject(scan);
        }
        if (not has(scan.names, name)) { return word_reject(scan); }
        let callee: Any = scan.names[name];
        if (callee.wordCallable != true) { return word_reject(scan); }
        mut count: Any = 0;
        mut arg: Any = node.args;
        while (arg != 0) {
            if (not word_typed(scan, arg)) { return false; }
            count += 1; arg = arg.next;
        }
        if (count != callee.pc) { return word_reject(scan); }
        push(scan.calls, callee);
        return true;
    }
    return word_reject(scan);
}

fun word_block(scan: Any, node: Any) -> Any {
    if (node.kind != S_BLOCK) { return word_statement(scan, node); }
    if (node.tail != 0 or not word_plain(node)) { return word_reject(scan); }
    push(scan.scopes, {});
    mut statement: Any = node.statements;
    while (statement != 0 and scan.valid) { word_statement(scan, statement); statement = statement.next; }
    pop(scan.scopes);
    return scan.valid;
}

fun word_statement(scan: Any, node: Any) -> Any {
    if (not scan.valid) { return false; }
    if (node == 0 or not word_plain(node)) { return word_reject(scan); }
    let kind: Any = node.kind;
    if (kind == S_BLOCK) { return word_block(scan, node); }
    if (kind == S_LET) {
        if (node.global != 0 or not word_typed(scan, node.initializer)) { return word_reject(scan); }
        scan.scopes[len(scan.scopes) - 1][symbol_name(node.name, node.length)] = true;
        return true;
    }
    if (kind == S_ASSIGN) {
        if (not word_typed(scan, node.value)) { return false; }
        if (word_local(scan, symbol_name(node.name, node.length))) { return true; }
        if (glob_find(scan.ctx, node.name, node.length) < 0) { return word_reject(scan); }
        node.wordGlobal = word_kind(node.value.strictType) ?? "Int";
        return true;
    }
    if (kind == S_EXPR) {
        let expression: Any = node.expression;
        if (expression != 0 and expression.kind == S_IF) { return word_statement(scan, expression); }
        let foreign: Any = word_extern(scan, expression);
        if (foreign != 0 and foreign.ffiResult == 9 and word_plain(expression)) { return word_foreign_call(scan, expression, foreign, "Nil"); }
        return word_typed(scan, expression);
    }
    if (kind == S_IF) {
        if (not word_value(scan, node.condition, "Bool") or not word_block(scan, node.thenBranch)) { return false; }
        if (node.elseBranch != 0) { return word_block(scan, node.elseBranch); }
        return true;
    }
    if (kind == S_WHILE) { return word_value(scan, node.condition, "Bool") and word_block(scan, node.body); }
    if (kind == S_FOR) {
        // Only `a..b` / `a..=b` with an Int binding; raw lowering counts directly.
        let range: Any = node.iterable;
        let contract: Any = node.bindingContract;
        if (range == 0 or range.kind != E_RANGE or not word_plain(range) or (contract != nil and contract != 0 and not word_type(contract, "Int"))) { return word_reject(scan); }
        if (not word_value(scan, range.start, "Int") or not word_value(scan, range.end, "Int")) { return false; }
        let binding: Any = {};
        binding[symbol_name(node.name, node.length)] = true;
        push(scan.scopes, binding);
        word_block(scan, node.body);
        pop(scan.scopes);
        return scan.valid;
    }
    if (kind == S_RETURN) { return word_value(scan, node.value, scan.result); }
    if (kind == S_BREAK or kind == S_CONT) { return true; }
    return word_reject(scan);
}

// Whether `rec` has a word signature: a strict top-level user function whose
// parameters (at most six) and result are Int, Ptr or Bool. Native-word
// code may call any such function; one that stays tagged is reached through
// its word adapter, which tags the arguments and untags the result.
fun word_signature(ctx: Any, rec: Any) -> Any {
    if (rec.mode != 0 or rec.nested != 0 or rec.foreign == true or rec.strictChecked != true) { return false; }
    if (rec.cc != 0 or rec.pc > 6) { return false; }
    if (source_module(rec.moduleSpan ?? rec.body.span) == "") { return false; }
    let signature: Any = rec.strictSignature;
    if (signature == nil or signature == 0 or len(signature.variables ?? []) > 0) { return false; }
    let result: Any = word_kind(signature.result);
    if (result == nil or len(signature.arguments) != rec.pc) { return false; }
    let kinds: Any = [];
    for index: Any in 0..rec.pc {
        let parameter: Any = word_kind(signature.arguments[index]);
        if (parameter == nil) { return false; }
        push(kinds, parameter);
    }
    // Entry stubs and adapters convert Bool parameters and results.
    rec.nativeKinds = kinds; rec.nativeResult = result;
    return true;
}

fun word_candidate(ctx: Any, rec: Any, names: Any) -> Any {
    if (not word_signature(ctx, rec) or len(rec.boxed) != 0) { return 0; }
    let parameters: Any = {};
    for index: Any in 0..rec.pc { parameters[symbol_name(rec.parr[index].name, rec.parr[index].length)] = true; }
    let scan: Any = WordScan(ctx, rec, rec.nativeResult, names, [parameters], [], true);
    word_block(scan, rec.body);
    return if (scan.valid) { scan } else { 0 };
}

// Tagged callees of a native-word function need a word adapter.
fun word_adapt(scan: Any) -> Any {
    for callee: Any in scan.calls { if (callee.native != true) { callee.wordCalled = true; } }
    return 0;
}

// Mark `rec.native` on qualifying functions, and `rec.wordCallable` on every
// function native-word code may call.
fun words_mark(ctx: Any, functions: Any, names: Any) -> Any {
    // --debug keeps the same arithmetic; native frames add no trace entries.
    if (DYNMODE == 0 or ctx.target.arch != "x86_64") { return 0; }
    WORD_NAMES = names; WORD_PENDING = [];
    for rec: Any in functions {
        rec.wordForeign = word_foreign(ctx, rec);
        rec.native = false; rec.wordCalled = false;
        // A global of the same name shadows the function in every backend lookup.
        rec.wordCallable = glob_find(ctx, rec.p, rec.l) < 0 and word_signature(ctx, rec);
    }
    let scans: Any = [];
    for rec: Any in functions {
        if (rec.wordCallable != true) { continue; }
        let scan: Any = word_candidate(ctx, rec, names);
        if (scan != 0) { rec.native = true; push(scans, scan); }
    }
    // Debug traces omit native frames, so under --debug a function stays
    // native only while every function it calls is native (a fixpoint).
    mut changed: Any = DEBUG_TRACES;
    while (changed) {
        changed = false;
        for scan: Any in scans {
            if (not scan.rec.native) { continue; }
            for callee: Any in scan.calls {
                if (callee.native != true) { scan.rec.native = false; changed = true; break; }
            }
        }
    }
    for scan: Any in scans { if (scan.rec.native) { word_adapt(scan); } }
    return 0;
}

// ------------------------------------------------------------- outlining
//
// In tagged code, a maximal Int or Bool expression that contains a bitwise
// operator, and that a native-word function could compute, is outlined into
// one: its variables (at most six) become parameters, read as ordinary tagged
// values at the original position. The expression then computes with 64-bit
// words, so `(1 << 63) & x` works and only the final value has to fit the
// tagged range.

fun word_bitwise(node: Any) -> Any {
    if (node == 0) { return false; }
    let kind: Any = node.kind;
    if (kind == E_BIN) {
        if (has([TK_BITAND, TK_PIPE, TK_XOR, TK_SHL, TK_SHR], node.op)) { return true; }
        return word_bitwise(node.left) or word_bitwise(node.right);
    }
    if (kind == E_AND or kind == E_OR) { return word_bitwise(node.left) or word_bitwise(node.right); }
    if (kind == E_UN) { return node.op == TK_BITNOT or word_bitwise(node.operand); }
    if (kind == E_CALL) {
        mut arg: Any = node.args;
        while (arg != 0) { if (word_bitwise(arg)) { return true; } arg = arg.next; }
    }
    return false;
}

// Collect free variables in first-use order; false when one is not a word.
fun word_free(node: Any, names: Any, order: Any) -> Any {
    if (node == 0) { return true; }
    let kind: Any = node.kind;
    if (kind == E_VAR) {
        let name: Any = symbol_name(node.name, node.length);
        if (name == "true" or name == "false" or has(names, name)) { return true; }
        if (word_kind(node.strictType) == nil) { return false; }
        names[name] = true; push(order, node);
        return true;
    }
    if (kind == E_BIN or kind == E_AND or kind == E_OR) { return word_free(node.left, names, order) and word_free(node.right, names, order); }
    if (kind == E_UN) { return word_free(node.operand, names, order); }
    if (kind == E_CALL) {
        mut arg: Any = node.args;
        while (arg != 0) { if (not word_free(arg, names, order)) { return false; } arg = arg.next; }
    }
    return true;
}

fun word_calls(node: Any) -> Any {
    if (node == 0) { return false; }
    let kind: Any = node.kind;
    if (kind == E_CALL) { return true; }
    if (kind == E_BIN or kind == E_AND or kind == E_OR) { return word_calls(node.left) or word_calls(node.right); }
    if (kind == E_UN) { return word_calls(node.operand); }
    return false;
}

// The call that replaces `node`, or 0 when it stays tagged.
fun words_outline(ctx: Any, node: Any) -> Any {
    if (DYNMODE == 0 or node == 0 or (node.kind != E_BIN and node.kind != E_UN)) { return 0; }
    if (ctx.target.arch != "x86_64" or not word_plain(node)) { return 0; }
    let result: Any = word_kind(node.strictType);
    if (result == nil or not word_bitwise(node) or source_module(node.span) == "") { return 0; }
    let order: Any = [];
    if (not word_free(node, {}, order) or len(order) > 6) { return 0; }
    // Parameters are read before the body runs, so a call that assigns a
    // global would otherwise be ordered after that global's read.
    if (word_calls(node)) {
        for variable: Any in order { if (glob_find(ctx, variable.name, variable.length) >= 0) { return 0; } }
    }
    let span: Any = node.span;
    let name: Any = "__word${len(WORD_LABELS)}";
    push(WORD_LABELS, name);
    let parameters: Any = []; let types: Any = [];
    for variable: Any in order {
        push(parameters, Parameter(variable.name, variable.length, 0, span));
        push(types, variable.strictType);
    }
    let body: Any = Block(S_BLOCK, span, 0, Return(S_RETURN, span, 0, node), 0);
    let rec: Any = FuncDecl(addr(name), len(name), len(order), parameters, body, newlab(ctx), 0, 0, 0, []);
    rec.nested = 0; rec.analyzed = 0; rec.returnType = 0; rec.foreign = false;
    rec.strictChecked = true; rec.moduleSpan = span;
    let signature: Any = TypeRef("Function", types, node.strictType, 0);
    signature.variables = [];
    rec.strictSignature = signature;
    let scan: Any = word_candidate(ctx, rec, WORD_NAMES);
    if (scan == 0) { return 0; }
    if (DEBUG_TRACES) {
        for callee: Any in scan.calls { if (callee.native != true) { return 0; } }
    }
    rec.native = true; rec.wordCallable = true;
    word_adapt(scan);
    push(FUNC_HEAD, rec); WORD_NAMES[name] = rec; push(WORD_PENDING, rec);
    mut args: Any = 0; mut last: Any = 0;
    for variable: Any in order {
        let argument: Any = NameExpr(E_VAR, variable.span, 0, variable.name, variable.length);
        argument.strictType = variable.strictType;
        if (last == 0) { args = argument; } else { last.next = argument; }
        last = argument;
    }
    let call: Any = Call(E_CALL, span, 0, rec.p, rec.l, args);
    call.strictType = node.strictType;
    return call;
}
