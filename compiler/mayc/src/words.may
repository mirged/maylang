import "state.may";
import "ast.may";
import "lexer.may";
import "symbols.may";
import "sema.may";
import "diagnostics.may";
// words.may — native-word lowering for strictly typed integer functions (#92).
//
// A user function whose parameters and result are all `Int`, `Ptr` or `Bool`,
// and whose body only computes with such locals and globals, raw memory access
// (`load8`..`load64`, `store8`..`store64`) and `syscall`, compiles as native
// 64-bit machine words, so loads and syscall results keep all 64 bits until
// the result returns to tagged code.
// Its tagged-ABI entry untags arguments and retags the result, raising the
// ordinary `integer overflow` fault when the result leaves the tagged range.
// Bool is 0/1 in native code (tagged 3/4). Calls between native-word
// functions pass machine words directly. Globals keep tagged values, so the
// scan marks global reads and writes (`wordGlobal`) for IR to convert.

let WORD_ARITHMETIC: Any = [TK_PLUS, TK_MINUS, TK_STAR, TK_SLASH, TK_PCT, TK_BITAND, TK_PIPE, TK_XOR, TK_SHL, TK_SHR];
let WORD_ORDERING: Any = [TK_EQ, TK_NE, TK_LT, TK_LE, TK_GT, TK_GE];
// Builtins lowered natively, with their minimum and maximum argument counts.
// `syscall` takes the raw path, which x86-64 supports on Linux and NodeOS only.
let WORD_BUILTINS: Any = {"load8": [1, 1], "load16": [1, 1], "load32": [1, 1], "load64": [1, 1],
    "store8": [2, 2], "store16": [2, 2], "store32": [2, 2], "store64": [2, 2], "syscall": [1, 7]};

fun word_builtin(scan: Any, node: Any, name: Any) -> Any {
    if (not has(WORD_BUILTINS, name) or has(scan.names, name) or glob_find(scan.ctx, node.name, node.length) >= 0) { return false; }
    return name != "syscall" or has(["linux", "nodeos"], scan.ctx.target.os);
}

struct WordScan { ctx: Any, rec: Any, result: Any, names: Any, scopes: Any, calls: Any, valid: Any }

fun word_type(t: Any, name: Any) -> Any {
    return t != nil and t != 0 and t.name == name and len(t.arguments ?? []) == 0;
}

// Ptr shares the tagged Int representation, so it untags and retags the same way.
fun word_int(t: Any) -> Any { return word_type(t, "Int") or word_type(t, "Ptr"); }

// The native kind of a parameter, result or local: "Int" (also Ptr), "Bool" or nil.
fun word_kind(t: Any) -> Any {
    if (word_int(t)) { return "Int"; }
    if (word_type(t, "Bool")) { return "Bool"; }
    return nil;
}

// A value whose kind follows its static type; folded literals have none and are Int.
fun word_typed(scan: Any, node: Any) -> Any {
    if (node == 0) { return word_reject(scan); }
    return word_value(scan, node, word_kind(node.strictType) ?? "Int");
}

fun word_plain(node: Any) -> Any { return node.contract == nil or node.contract == 0; }

fun word_local(scan: Any, name: Any) -> Any {
    for scope: Any in scan.scopes { if (has(scope, name)) { return true; } }
    return false;
}

fun word_reject(scan: Any) -> Any { scan.valid = false; return false; }

// Every value must be an uncontracted Int or Ptr (or Bool, for control flow only).
fun word_value(scan: Any, node: Any, expected: Any) -> Any {
    if (not scan.valid) { return false; }
    // Name resolution folds small literal arithmetic into untyped literals.
    if (node != 0 and node.kind == E_INT and expected == "Int" and word_plain(node) and node.strictType == nil) { return true; }
    if (node == 0 or not word_plain(node)) { return word_reject(scan); }
    if (not (if (expected == "Int") { word_int(node.strictType) } else { word_type(node.strictType, expected) })) { return word_reject(scan); }
    let kind: Any = node.kind;
    if (kind == E_INT) { return true; }
    if (kind == E_VAR) {
        let name: Any = symbol_name(node.name, node.length);
        if (expected == "Bool" and (name == "true" or name == "false") and not word_local(scan, name)) { return true; }
        if (word_local(scan, name)) { return true; }
        if (glob_find(scan.ctx, node.name, node.length) < 0) { return word_reject(scan); }
        node.wordGlobal = expected;
        return true;
    }
    if (kind == E_BIN) {
        if (has(WORD_ARITHMETIC, node.op)) {
            return expected == "Int" and word_value(scan, node.left, "Int") and word_value(scan, node.right, "Int");
        }
        if (has(WORD_ORDERING, node.op) and expected == "Bool") {
            let operand: Any = if (word_type(node.left.strictType, "Bool") and (node.op == TK_EQ or node.op == TK_NE)) { "Bool" } else { "Int" };
            return word_value(scan, node.left, operand) and word_value(scan, node.right, operand);
        }
        return word_reject(scan);
    }
    if (kind == E_UN) {
        if (node.op == TK_MINUS or node.op == TK_BITNOT) { return expected == "Int" and word_value(scan, node.operand, "Int"); }
        if (node.op == TK_NOT) { return expected == "Bool" and word_value(scan, node.operand, "Bool"); }
        return word_reject(scan);
    }
    if (kind == E_AND or kind == E_OR) {
        return expected == "Bool" and word_value(scan, node.left, "Bool") and word_value(scan, node.right, "Bool");
    }
    if (kind == E_CALL) {
        let name: Any = symbol_name(node.name, node.length);
        if (word_local(scan, name)) { return word_reject(scan); }
        if (word_builtin(scan, node, name)) {
            mut operands: Any = 0;
            mut operand: Any = node.args;
            while (operand != 0) {
                if (not word_value(scan, operand, "Int")) { return false; }
                operands += 1; operand = operand.next;
            }
            let arity: Any = WORD_BUILTINS[name];
            return (expected == "Int" and operands >= arity[0] and operands <= arity[1]) or word_reject(scan);
        }
        if (not has(scan.names, name)) { return word_reject(scan); }
        let callee: Any = scan.names[name];
        mut count: Any = 0;
        mut arg: Any = node.args;
        while (arg != 0) {
            if (not word_typed(scan, arg)) { return false; }
            count += 1; arg = arg.next;
        }
        if (count != callee.pc) { return word_reject(scan); }
        push(scan.calls, callee);
        return true;
    }
    return word_reject(scan);
}

fun word_block(scan: Any, node: Any) -> Any {
    if (node.kind != S_BLOCK) { return word_statement(scan, node); }
    if (node.tail != 0 or not word_plain(node)) { return word_reject(scan); }
    push(scan.scopes, {});
    mut statement: Any = node.statements;
    while (statement != 0 and scan.valid) { word_statement(scan, statement); statement = statement.next; }
    pop(scan.scopes);
    return scan.valid;
}

fun word_statement(scan: Any, node: Any) -> Any {
    if (not scan.valid) { return false; }
    if (node == 0 or not word_plain(node)) { return word_reject(scan); }
    let kind: Any = node.kind;
    if (kind == S_BLOCK) { return word_block(scan, node); }
    if (kind == S_LET) {
        if (node.global != 0 or not word_typed(scan, node.initializer)) { return word_reject(scan); }
        scan.scopes[len(scan.scopes) - 1][symbol_name(node.name, node.length)] = true;
        return true;
    }
    if (kind == S_ASSIGN) {
        if (not word_typed(scan, node.value)) { return false; }
        if (word_local(scan, symbol_name(node.name, node.length))) { return true; }
        if (glob_find(scan.ctx, node.name, node.length) < 0) { return word_reject(scan); }
        node.wordGlobal = word_kind(node.value.strictType) ?? "Int";
        return true;
    }
    if (kind == S_EXPR) {
        let expression: Any = node.expression;
        if (expression != 0 and expression.kind == S_IF) { return word_statement(scan, expression); }
        return word_typed(scan, expression);
    }
    if (kind == S_IF) {
        if (not word_value(scan, node.condition, "Bool") or not word_block(scan, node.thenBranch)) { return false; }
        if (node.elseBranch != 0) { return word_block(scan, node.elseBranch); }
        return true;
    }
    if (kind == S_WHILE) { return word_value(scan, node.condition, "Bool") and word_block(scan, node.body); }
    if (kind == S_FOR) {
        // Only `a..b` / `a..=b` with an Int binding; raw lowering counts directly.
        let range: Any = node.iterable;
        let contract: Any = node.bindingContract;
        if (range == 0 or range.kind != E_RANGE or not word_plain(range) or (contract != nil and contract != 0 and not word_type(contract, "Int"))) { return word_reject(scan); }
        if (not word_value(scan, range.start, "Int") or not word_value(scan, range.end, "Int")) { return false; }
        let binding: Any = {};
        binding[symbol_name(node.name, node.length)] = true;
        push(scan.scopes, binding);
        word_block(scan, node.body);
        pop(scan.scopes);
        return scan.valid;
    }
    if (kind == S_RETURN) { return word_value(scan, node.value, scan.result); }
    if (kind == S_BREAK or kind == S_CONT) { return true; }
    return word_reject(scan);
}

fun word_candidate(ctx: Any, rec: Any, names: Any) -> Any {
    if (rec.mode != 0 or rec.nested != 0 or rec.foreign == true or rec.strictChecked != true) { return 0; }
    if (rec.cc != 0 or len(rec.boxed) != 0 or rec.pc > 6) { return 0; }
    if (source_module(rec.moduleSpan ?? rec.body.span) == "") { return 0; }
    let signature: Any = rec.strictSignature;
    if (signature == nil or signature == 0 or len(signature.variables ?? []) > 0) { return 0; }
    let result: Any = word_kind(signature.result);
    if (result == nil or len(signature.arguments) != rec.pc) { return 0; }
    let parameters: Any = {};
    let kinds: Any = [];
    for index: Any in 0..rec.pc {
        let parameter: Any = word_kind(signature.arguments[index]);
        if (parameter == nil) { return 0; }
        push(kinds, parameter);
        parameters[symbol_name(rec.parr[index].name, rec.parr[index].length)] = true;
    }
    // Entry stubs convert Bool parameters and results at the tagged boundary.
    rec.nativeKinds = kinds; rec.nativeResult = result;
    let scan: Any = WordScan(ctx, rec, result, names, [parameters], [], true);
    word_block(scan, rec.body);
    return if (scan.valid) { scan } else { 0 };
}

// Mark `rec.native` on qualifying functions. A function stays native only
// while every function it calls is native, so iterate to a fixpoint.
fun words_mark(ctx: Any, functions: Any, names: Any) -> Any {
    // --debug keeps the same arithmetic; native frames add no trace entries.
    if (DYNMODE == 0 or not has(["x86_64", "arm64", "riscv64", "llvm"], ctx.target.arch)) { return 0; }
    let scans: Any = [];
    for rec: Any in functions {
        rec.native = false;
        // A global of the same name shadows the function in every backend lookup.
        if (glob_find(ctx, rec.p, rec.l) >= 0) { continue; }
        let scan: Any = word_candidate(ctx, rec, names);
        if (scan != 0) { rec.native = true; push(scans, scan); }
    }
    mut changed: Any = true;
    while (changed) {
        changed = false;
        for scan: Any in scans {
            if (not scan.rec.native) { continue; }
            for callee: Any in scan.calls {
                if (callee.native != true) { scan.rec.native = false; changed = true; break; }
            }
        }
    }
    return 0;
}
