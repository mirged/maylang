// state.may — frontend state and host file/source allocation helpers.
//
// Syntax, tokens, symbols and IR use GC-managed structs, maps and lists.
// Raw buffers below own source bytes only. Emission buffers and backend state
// belong to EmissionContext (emitter.may), passed explicitly through stages.

mut ARENA: Any = 0;
mut ARENAP: Any = 0;
mut ARENA_END: Any = 0;
mut SRC: Any = 0;
mut SRCLEN: Any = 0;
mut TOKS: Any = [];
mut NTOKS: Any = 0;
mut FUNC_HEAD: Any = [];
mut LOOPB: Any = [];
mut LOOPC: Any = [];
mut IN_FUN: Any = 0;
mut LASTLEN: Any = 0;
mut PARSE_RAW: Any = 0;
mut DYNMODE: Any = 0;
mut RUNTIME_BODY: Any = 0;
mut SOURCE_FILES: Any = {};
mut FOREIGN_DECLS: Any = [];
mut STRICT_TYPES: Any = true;
mut BEHAVIOR_CALLABLES: Any = false;
mut BEHAVIOR_CALLABLE_SPAN: Any = 0;
mut DEBUG_TRACES: Any = false;

// The source arena defaults to 256 MiB; MAYC_ARENA_BYTES overrides it.
fun arena_size() -> Any {
    let configured: Any = env("MAYC_ARENA_BYTES") ?? "";
    if (configured == "") { return 268435456; }
    mut size: Any = 0;
    for c: Any in chars(configured) {
        if (c < "0" or c > "9" or size > 109951162777) { die_str("mayc: MAYC_ARENA_BYTES must be a byte count from 4096 to 1099511627776\n"); }
        size = size * 10 + ord(c) - 48;
    }
    if (size < 4096 or size > 1099511627776) { die_str("mayc: MAYC_ARENA_BYTES must be a byte count from 4096 to 1099511627776\n"); }
    return size - size % 8;
}

fun irt_init() -> Any {
    let size: Any = arena_size();
    let mapped: Any = syscall(9, 0, size, 3, 34, 0 - 1, 0);
    if (mapped < 0) { die_str("mayc: cannot map the ${size}-byte source arena; free memory, raise the address-space limit or set MAYC_ARENA_BYTES\n"); }
    ARENA = mapped;
    ARENAP = ARENA;
    ARENA_END = ARENA + size;
    return 0;
}

fun irt_alloc(n: Any) -> Any {
    let p: Any = ARENAP;
    // Checking against the remaining space cannot overflow; the end is 8-aligned.
    if (n < 0 or n > ARENA_END - p) { die_str("mayc: source arena exhausted (${ARENA_END - ARENA} bytes); set MAYC_ARENA_BYTES to a larger size\n"); }
    mut q: Any = p + n;
    let r: Any = q % 8;
    if (r != 0) { q = q + (8 - r); }
    ARENAP = q;
    return p;
}

fun irt_align(q: Any) -> Any {
    let r: Any = q % 8;
    return if (r != 0) { q + (8 - r) } else { q };
}

// Return the unused tail of an allocation of `size` bytes to the arena,
// provided nothing has been allocated after it.
fun irt_trim(p: Any, size: Any, used: Any) -> Any {
    if (irt_align(p + size) == ARENAP and used >= 0 and used <= size) { ARENAP = irt_align(p + used); }
    return p;
}

fun die(p: Any, n: Any) -> Any {
    syscall(1, 2, p, n);
    syscall(60, 1);
    return 0;
}

// Print a (runtime) string to stderr and exit with failure.
fun die_str(s: Any) -> Any {
    // Compiler messages are NUL-terminated UTF-8. len counts code points,
    // whereas write requires bytes; keep this portable to the C bootstrap.
    let pointer: Any = addr(s);
    mut count: Any = 0;
    while (load8(pointer + count) != 0) { count += 1; }
    mut offset: Any = 0;
    while (offset < count) {
        let written: Any = syscall(1, 2, pointer + offset, count - offset);
        if (written == -4) { continue; }
        if (written <= 0) { break; }
        offset += written;
    }
    syscall(60, 1);
    return 0;
}

// Compare two byte spans.
fun name_eq(p1: Any, l1: Any, p2: Any, l2: Any) -> Any {
    if (l1 != l2) { return 0; }
    mut i: Any = 0;
    while (i < l1) {
        if (load8(p1 + i) != load8(p2 + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Decoded length of a source string literal (span excludes the quotes).
fun declen(s: Any, st: Any, n: Any) -> Any {
    mut i: Any = 0;
    mut c: Any = 0;
    while (i < n) {
        let b: Any = load8(s + st + i);
        if (b == 92) {
            i = i + 2;
        } else {
            i = i + 1;
        }
        c = c + 1;
    }
    return c;
}

// Copy a source string literal into `d`, decoding escapes.
fun decopy(d: Any, s: Any, st: Any, n: Any) -> Any {
    mut i: Any = 0;
    mut o: Any = 0;
    while (i < n) {
        let b: Any = load8(s + st + i);
        if (b == 92) {
            let e: Any = load8(s + st + i + 1);
            mut v: Any = e;
            if (e == 110) {
                v = 10;
            } else if (e == 116) {
                v = 9;
            } else if (e == 114) {
                v = 13;
            } else if (e == 48) {
                v = 0;
            }
            store8(d + o, v);
            o = o + 1;
            i = i + 2;
        } else {
            store8(d + o, b);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

// Read a whole file into a fresh arena buffer; length in LASTLEN.
// `pp` must be NUL-terminated.
fun slurp(pp: Any, pl: Any) -> Any {
    let fd: Any = syscall(2, pp, 0, 0);
    if (fd < 0) {
        LASTLEN = 0;
        return 0;
    }
    // Reserve a terminator byte and probe past a full buffer before accepting EOF.
    let b: Any = irt_alloc(1048577);
    mut off: Any = 0;
    while (true) {
        let remaining: Any = if (off < 1048576) { 1048576 - off } else { 1 };
        let r: Any = syscall(0, fd, b + off, remaining);
        if (r == -4) { continue; } // EINTR: retry without losing buffered bytes.
        if (r < 0) {
            syscall(3, fd);
            LASTLEN = 0;
            return 0;
        }
        if (r == 0) { break; }
        off = off + r;
        if (off > 1048576) {
            syscall(3, fd);
            die_str("mayc: input file exceeds 1 MiB limit\n");
        }
    }
    syscall(3, fd);
    store8(b + off, 0);
    LASTLEN = off;
    // Only the bytes read and the terminator stay reserved.
    return irt_trim(b, 1048577, off + 1);
}
