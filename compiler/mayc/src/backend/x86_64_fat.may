import "../emitter.may";
import "../symbols.may";
import "../state.may";
import "../ast.may";
import "../lexer.may";
import "../ir.may";
import "../literals.may";
import "../sema.may";
import "../regalloc.may";
import "x86_64.may";
// backend/x86_64_fat.may — x86-64 code for `--values fat` (#92).
//
// See docs/design/FAT_VALUES.md. Every IR temporary and local has a 16-byte
// frame slot: the type word at the lower address and the payload 8 bytes
// above it. An expression leaves its value in RDX (type) and RAX (payload).
// Compiled functions find their arguments as 16-byte values above the return
// address, receive a closure environment in R10 and return RAX/RDX. Runtime
// functions are raw: each value is pushed as two words, type first, and the
// result's type word comes back in the RTAG global. Temporaries occupy slots
// 0 to `fatBase - 1`, locals the slots after them.

fun fat_disp(k: Any) -> Any { return 16 * (k + 1); }

// The slot whose value RDX/RAX still hold, and the code length before and
// after its store. A load of that slot with no code emitted in between (so
// no label either: fat_forget runs where one is placed) is skipped, and a
// temporary with one definition and that one reader loses the store too.
mut FAT_HELD_SLOT: Any = -1;
mut FAT_HELD_START: Any = -1;
mut FAT_HELD_AT: Any = -1;
// Live intervals per temporary (regalloc.may): definition and reader
// counts (readers conservatively, never too few) and a frame home. FAT_SLOTS
// maps each temporary to its slot.
mut FAT_INTERVALS: Any = [];
mut FAT_SLOTS: Any = [];
// Forwarded temporaries (#96). FAT_FORWARDABLE[t] is 1 when temporary t is
// a constant defined once (a literal, nil, true or false) and 2 when it is
// one read of a variable that nothing can change before t's last reader.
// Such a definition emits no code: FAT_FORWARD[t] records where the value
// is ([0, type, payload], [1, Float bits], [2, string data offset], [3,
// frame slot] or [4, global offset]) and each reader loads it from there,
// straight into the registers it needs.
mut FAT_FORWARDABLE: Any = [];
mut FAT_FORWARD: Any = [];
// FAT_DEAD[position] is true for an IR_COPY whose target nothing reads
// (an `if` statement's unused value, say); it emits no code and does not
// count as a reader of its source.
mut FAT_DEAD: Any = [];
// Register homes for hot locals (#96): FAT_HOME_NAMES maps a chosen local's
// name to a callee-saved register pair [type, payload]; FAT_HOMES[k] is the
// pair of frame slot k, or nil (the list grows as locals are declared). FAT_SAVES lists the code offsets
// of the prologue's register saves, whose displacements fat_epilogue fills.
mut FAT_HOME_NAMES: Any = {};
mut FAT_HOME_ORDER: Any = [];
mut FAT_HOMES: Any = [];
mut FAT_SAVES: Any = [];
let FAT_HOME_PAIRS: Any = [[3, 12], [13, 14]];                             // rbx/r12, r13/r14
// Slow paths moved after the function's code, so that fast paths fall
// through (fat_emit_deferred): ["binary", notInt, slow, op, done, right] or
// ["branch", slow, op, label, truthy, done, right]. `right` is the forwarded
// right operand when the fast path used it as an immediate (nil otherwise);
// the slow path loads it into RDX/RAX first.
mut FAT_DEFERRED: Any = [];

fun fat_forget() -> Any { FAT_HELD_SLOT = -1; FAT_HELD_AT = -1; return 0; }

fun fat_constant_name(p: Any, l: Any) -> Bool {
    return name_eq(p, l, addr("nil"), 3) == 1 or name_eq(p, l, addr("true"), 4) == 1 or name_eq(p, l, addr("false"), 5) == 1;
}

// True when nothing between positions `start` and `end` of `code` can change
// the variable `name` that a temporary read at `start` and last used at
// `end`: no declaration or assignment of that name before `end` (the one at
// `end` reads the temporary first), no tail call, and no call, runtime call
// or closure before `end`, as a call can assign a global.
fun fat_variable_stable(code: Any, start: Any, end: Any, name: Any, length: Any) -> Bool {
    mut position: Any = start + 1;
    while (position <= end) {
        let instruction: Any = code[position];
        let op: Any = instruction.op;
        if (op == IR_TAILCALL) { return false; }
        if (position < end) {
            if (op == E_CALL or op == E_ICALL or op == IR_RUNTIME or op == E_CLOSURE) { return false; }
            if ((op == S_LET or op == S_ASSIGN) and name_eq(instruction.extra.name, instruction.extra.length, name, length) == 1) { return false; }
        }
        position += 1;
    }
    return true;
}

// Exact reader counts. lsra_operands counts conservatively: operations
// whose payload names their operands also carry them in arg1/arg2, and are
// counted twice. Fat code reads such an operation's operands only through
// the payload, so only those are counted here.
let FAT_PAYLOAD_OPS: Any = [E_BIN, E_POW, E_UN, E_CALL, E_ICALL, S_LET, S_ASSIGN, S_CASSIGN, E_INDEX, S_SETIDX, E_GET, S_SETPROP, E_RANGE];

fun fat_count_use(intervals: Any, value: Any) -> Any {
    if (value != 0 and value != nil) { intervals[value.slot].uses += 1; }
    return 0;
}

fun fat_count_list(intervals: Any, values: Any) -> Any {
    mut value: Any = values;
    while (value != 0 and value != nil) { intervals[value.slot].uses += 1; value = value.next; }
    return 0;
}

fun fat_exact_uses(block: Any, intervals: Any) -> Any {
    for interval: Any in intervals { interval.uses = 0; }
    for instruction: Any in block.code {
        let op: Any = instruction.op;
        let n: Any = instruction.extra;
        if (has(FAT_PAYLOAD_OPS, op)) {
            if (op == E_BIN or op == E_POW) { fat_count_use(intervals, n.left); fat_count_use(intervals, n.right); }
            else if (op == E_UN) { fat_count_use(intervals, n.operand); }
            else if (op == S_LET) { fat_count_use(intervals, n.initializer); }
            else if (op == S_ASSIGN or op == S_CASSIGN) { fat_count_use(intervals, n.value); }
            else if (op == E_INDEX or op == S_SETIDX) {
                fat_count_use(intervals, n.object); fat_count_use(intervals, n.index);
                if (op == S_SETIDX) { fat_count_use(intervals, n.value); }
            } else if (op == E_GET) { fat_count_use(intervals, n.object); }
            else if (op == S_SETPROP) { fat_count_use(intervals, n.object); fat_count_use(intervals, n.value); }
            else if (op == E_RANGE) { fat_count_use(intervals, n.start); fat_count_use(intervals, n.end); }
            else if (op == E_ICALL) { fat_count_use(intervals, n.callee); }
            if (op == E_CALL or op == E_ICALL) { fat_count_list(intervals, n.args); }
        } else {
            fat_count_list(intervals, instruction.arg1);
            fat_count_list(intervals, instruction.arg2);
        }
    }
    return 0;
}

fun fat_plan_dead_copies(block: Any, intervals: Any) -> Any {
    FAT_DEAD = [];
    for instruction: Any in block.code { push(FAT_DEAD, false); }
    mut changed: Any = true;
    while (changed) {
        changed = false;
        mut position: Any = 0;
        for instruction: Any in block.code {
            if (not FAT_DEAD[position] and instruction.op == IR_COPY and intervals[instruction.result.slot].uses == 0) {
                FAT_DEAD[position] = true; changed = true;
                if (instruction.arg1 != 0) { intervals[instruction.arg1.slot].uses -= 1; }
            }
            position += 1;
        }
    }
    return 0;
}

fun fat_plan_forwarding(block: Any, intervals: Any) -> Any {
    fat_exact_uses(block, intervals);
    fat_plan_dead_copies(block, intervals);
    FAT_FORWARDABLE = []; FAT_FORWARD = [];
    for interval: Any in intervals { push(FAT_FORWARDABLE, 0); push(FAT_FORWARD, nil); }
    mut position: Any = 0;
    for instruction: Any in block.code {
        let result: Any = instruction.result;
        if (result != 0 and intervals[result.slot].definitions == 1) {
            let interval: Any = intervals[result.slot];
            let op: Any = instruction.op;
            if (op == E_INT or op == E_FLOAT or op == E_STR or op == E_STRB or op == IR_NIL) { FAT_FORWARDABLE[result.slot] = 1; }
            else if (op == E_VAR) {
                let payload: Any = instruction.extra;
                if (fat_constant_name(payload.name, payload.length)) { FAT_FORWARDABLE[result.slot] = 1; }
                else if (not interval.pinned and fat_variable_stable(block.code, position, interval.end, payload.name, payload.length)) {
                    FAT_FORWARDABLE[result.slot] = 2;
                }
            }
        }
        position += 1;
    }
    return 0;
}

// Choose up to two locals for register homes (#96): names declared once in
// the function (a parameter or one `let`, so that no shadowing local
// shares the pair), not captured, and used inside a loop, ranked by uses
// weighted 8x per loop level. A function with a handler gets none: a fault
// restores callee-saved registers to their values at the handler's start.
// The collector marks the callee-saved registers (rt_gc), so a pair needs
// no spilling around calls.
fun fat_plan_homes(ctx: Any, block: Any, parameters: Any, count: Any) -> Any {
    let code: Any = block.code;
    let labels: Any = {};
    mut position: Any = 0;
    for instruction: Any in code {
        if (instruction.op == IR_TRY_BEGIN) { return 0; }
        if (instruction.op == IR_LABEL) { labels[instruction.extra] = position; }
        position += 1;
    }
    // Loop depth per position, from backward jumps.
    let steps: Any = [];
    mut loops: Any = false;
    for index: Any in 0..(len(code) + 1) { push(steps, 0); }
    position = 0;
    for instruction: Any in code {
        if (instruction.op == IR_JUMP or instruction.op == IR_FALSE or instruction.op == IR_TRUE) {
            let target: Any = labels[instruction.extra];
            if (target != nil and target < position) { steps[target] += 1; steps[position + 1] -= 1; loops = true; }
        }
        position += 1;
    }
    if (not loops) { return 0; }
    // Names in order of first weighted use, so that ties do not depend on
    // map iteration order (the bootstrap's stages must choose alike).
    let declared: Any = {};
    let weights: Any = {};
    let names: Any = [];
    for index: Any in 0..count {
        let name: Any = symbol_name(parameters[index].name, parameters[index].length);
        declared[name] = (declared[name] ?? 0) + 1;
    }
    mut depth: Any = 0;
    position = 0;
    for instruction: Any in code {
        depth += steps[position];
        let op: Any = instruction.op;
        if ((op == E_VAR or op == S_LET or op == S_ASSIGN) and (depth > 0 or op == S_LET)) {
            let n: Any = instruction.extra;
            if (not fat_constant_name(n.name, n.length) and is_boxed(ctx, n.name, n.length) != 1) {
                let name: Any = symbol_name(n.name, n.length);
                if (op == S_LET) { declared[name] = (declared[name] ?? 0) + if (n.global == 1) { 2 } else { 1 }; }
                if (depth > 0) {
                    mut weight: Any = 1;
                    for level: Any in 0..(if (depth > 4) { 4 } else { depth }) { weight = weight * 8; }
                    if (weights[name] == nil) { push(names, name); }
                    weights[name] = (weights[name] ?? 0) + weight;
                }
            }
        }
        position += 1;
    }
    let chosen: Any = [];
    for pair: Any in FAT_HOME_PAIRS {
        mut best: Any = nil;
        for name: Any in names {
            if ((declared[name] ?? 0) == 1 and not has(chosen, name) and (best == nil or weights[name] > weights[best])) { best = name; }
        }
        if (best != nil) { push(chosen, best); FAT_HOME_NAMES[best] = pair; push(FAT_HOME_ORDER, best); }
    }
    return 0;
}

// Give the temporaries of `block` frame slots and return how many there
// are. A temporary defined once and read before the next label, branch or
// handler boundary shares a slot with others whose intervals do not overlap;
// those few hot slots come first, where an 8-bit displacement reaches them.
// The others keep private slots, as liveness across loops is not tracked.
fun fat_plan_slots(block: Any) -> Any {
    let intervals: Any = lsra_plan(block, [], false).locations;
    mut shared: Any = 0; mut pinned: Any = 0;
    for interval: Any in intervals {
        if (interval.home >= 0 and interval.pinned) { pinned += 1; }
        else if (interval.home >= 0 and interval.home + 1 > shared) { shared = interval.home + 1; }
    }
    // lsra_plan numbers pinned homes from 0 and shared homes after them.
    shared = shared - pinned;
    if (shared < 0) { shared = 0; }
    let slots: Any = [];
    mut extra: Any = shared + pinned;
    for interval: Any in intervals {
        if (interval.home < 0) { push(slots, extra); extra += 1; }
        else if (interval.pinned) { push(slots, shared + interval.home); }
        else { push(slots, interval.home - pinned); }
    }
    FAT_INTERVALS = intervals; FAT_SLOTS = slots;
    fat_plan_forwarding(block, intervals);
    FAT_DEFERRED = [];
    return extra;
}

// mov reg, [rbp - d] or mov [rbp - d], reg (opcode 139 or 137), with an
// 8-bit displacement when it fits.
fun fat_frame(ctx: Any, opcode: Any, register: Any, displacement: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, opcode);
    if (displacement <= 128) { e8(ctx, 69 + (register % 8) * 8); e8(ctx, 256 - displacement); }
    else { e8(ctx, 133 + (register % 8) * 8); e32(ctx, 0 - displacement); }
    return 0;
}

// mov [rsp + d], reg, with an 8-bit displacement when it fits.
fun fat_outgoing(ctx: Any, register: Any, displacement: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 137);
    if (displacement < 128) { e8(ctx, 68 + (register % 8) * 8); e8(ctx, 36); e8(ctx, displacement); }
    else { e8(ctx, 132 + (register % 8) * 8); e8(ctx, 36); e32(ctx, displacement); }
    return 0;
}

// Load frame slot `k` (or its register home) into registers `t` and `p`.
fun fat_home(k: Any) -> Any {
    if (k >= len(FAT_HOMES)) { return nil; }
    return FAT_HOMES[k];
}

fun fat_load_pair(ctx: Any, k: Any, t: Any, p: Any) -> Any {
    let home: Any = fat_home(k);
    if (home != nil) { x86_move_register(ctx, t, home[0]); x86_move_register(ctx, p, home[1]); return 0; }
    fat_frame(ctx, 139, t, fat_disp(k)); fat_frame(ctx, 139, p, fat_disp(k) - 8);
    return 0;
}

fun fat_load_slot(ctx: Any, k: Any) -> Any {
    if (k == FAT_HELD_SLOT and ctx.code.length == FAT_HELD_AT) { return 0; }
    return fat_load_pair(ctx, k, 2, 0);
}

fun fat_store_slot(ctx: Any, k: Any) -> Any {
    FAT_HELD_START = ctx.code.length;
    let home: Any = fat_home(k);
    if (home != nil) { x86_move_register(ctx, home[0], 2); x86_move_register(ctx, home[1], 0); }
    else { fat_frame(ctx, 137, 2, fat_disp(k)); fat_frame(ctx, 137, 0, fat_disp(k) - 8); }
    FAT_HELD_SLOT = k; FAT_HELD_AT = ctx.code.length;
    return 0;
}

// Declare a local; a name chosen by fat_plan_homes gets its register pair.
fun fat_declare(ctx: Any, p: Any, l: Any) -> Any {
    let index: Any = loc_add(ctx, p, l);
    if (len(FAT_HOME_ORDER) == 0) { return index; }
    let home: Any = FAT_HOME_NAMES[symbol_name(p, l)];
    if (home != nil) {
        let k: Any = fat_local_slot(ctx, index);
        while (len(FAT_HOMES) <= k) { push(FAT_HOMES, nil); }
        FAT_HOMES[k] = home;
    }
    return index;
}

fun fat_local_slot(ctx: Any, index: Any) -> Any { return ctx.fatBase + index; }

// mov reg, [disp32] for a data offset.
fun fat_abs_register(ctx: Any, register: Any, off: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 139); e8(ctx, 4 + (register % 8) * 8); e8(ctx, 37);
    let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 2, o, off);
    return 0;
}

// Load forwarded value `d` (FAT_FORWARD) into registers `t` (type) and `p`.
fun fat_materialize(ctx: Any, d: Any, t: Any, p: Any) -> Any {
    let kind: Any = d[0];
    if (kind == 0) { x86_mov_immediate(ctx, t, d[1]); x86_mov_immediate(ctx, p, d[2]); }
    else if (kind == 1) {
        x86_mov_immediate(ctx, t, 3);
        e8(ctx, if (p >= 8) { 73 } else { 72 }); e8(ctx, 184 + p % 8); e32(ctx, d[1][0]); e32(ctx, d[1][1]); // movabs p, bits
    } else if (kind == 2) { x86_mov_immediate(ctx, t, 4); x86_relocated_immediate(ctx, p, 1, d[1]); }
    else if (kind == 3) {
        if (t == 2 and p == 0) { fat_load_slot(ctx, d[1]); }
        else { fat_load_pair(ctx, d[1], t, p); }
    } else { fat_abs_register(ctx, t, d[1]); fat_abs_register(ctx, p, d[1] + 8); }
    return 0;
}

// The type of a forwarded constant, or -1 when it is not known here.
fun fat_known_type(value: Any) -> Any {
    let d: Any = FAT_FORWARD[value.slot];
    if (d == nil) { return -1; }
    if (d[0] == 0) { return d[1]; }
    if (d[0] == 1) { return 3; }
    if (d[0] == 2) { return 4; }
    return -1;
}

// Record where a forwardable definition's value is instead of computing
// it. Returns false (and nothing is recorded) when the variable turns out
// to be boxed, a function or unknown here; the definition then runs.
fun fat_forward(ctx: Any, instruction: Any) -> Bool {
    let op: Any = instruction.op;
    let n: Any = instruction.extra;
    mut d: Any = nil;
    if (op == IR_NIL) { d = [0, 0, 0]; }
    else if (op == E_INT) { d = [0, 2, n.value]; }
    else if (op == E_FLOAT) { d = [1, float_literal_bits(str(symbol_name(n.span.source + n.start, n.length)))]; }
    else if (op == E_STR) { d = [2, fat_key(ctx, n.span.source, n.start, n.length)]; }
    else if (op == E_STRB) { d = [2, intern_obj2(ctx, n.address, n.length)]; }
    else if (op == E_VAR) {
        let p: Any = n.name; let l: Any = n.length;
        if (name_eq(p, l, addr("nil"), 3) == 1) { d = [0, 0, 0]; }
        else if (name_eq(p, l, addr("true"), 4) == 1) { d = [0, 1, 1]; }
        else if (name_eq(p, l, addr("false"), 5) == 1) { d = [0, 1, 0]; }
        else if (FAT_FORWARDABLE[instruction.result.slot] == 2 and name_eq(p, l, addr("err"), 3) != 1) {
            let li: Any = loc_find(ctx, p, l);
            if (li >= 0) { if (is_boxed(ctx, p, l) != 1) { d = [3, fat_local_slot(ctx, li)]; } }
            else {
                let gi: Any = glob_find(ctx, p, l);
                if (gi >= 0) { d = [4, glob_off(ctx, gi)]; }
            }
        }
    }
    if (d == nil) { return false; }
    FAT_FORWARD[instruction.result.slot] = d;
    return true;
}

// Load `value` into registers `t` and `p` (not RDX/RAX).
fun fat_get_into(ctx: Any, value: Any, t: Any, p: Any) -> Any {
    let d: Any = FAT_FORWARD[value.slot];
    if (d != nil) { return fat_materialize(ctx, d, t, p); }
    fat_get(ctx, value);
    x86_move_register(ctx, t, 2); x86_move_register(ctx, p, 0);
    return 0;
}

// A temporary read only here, right after its one definition, needs no store.
fun fat_get(ctx: Any, value: Any) -> Any {
    let d: Any = FAT_FORWARD[value.slot];
    if (d != nil) { return fat_materialize(ctx, d, 2, 0); }
    let k: Any = FAT_SLOTS[value.slot];
    let interval: Any = FAT_INTERVALS[value.slot];
    if (k == FAT_HELD_SLOT and ctx.code.length == FAT_HELD_AT and interval.uses == 1 and interval.definitions == 1) {
        ctx.code.length = FAT_HELD_START;
        fat_forget();
        return 0;
    }
    return fat_load_slot(ctx, k);
}
fun fat_put(ctx: Any, value: Any) -> Any { return fat_store_slot(ctx, FAT_SLOTS[value.slot]); }

fun fat_set(ctx: Any, tag: Any, payload: Any) -> Any {
    x86_mov_immediate(ctx, 2, tag); x86_mov_immediate(ctx, 0, payload);
    return 0;
}

// mov reg, [disp32] / mov [disp32], reg for data offsets (rax 4, rdx 20).
fun fat_abs(ctx: Any, opcode: Any, modrm: Any, off: Any) -> Any {
    e8(ctx, 72); e8(ctx, opcode); e8(ctx, modrm); e8(ctx, 37);
    let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 2, o, off);
    return 0;
}
fun fat_abs_load(ctx: Any, off: Any) -> Any { fat_abs(ctx, 139, 20, off); fat_abs(ctx, 139, 4, off + 8); return 0; }
fun fat_abs_store(ctx: Any, off: Any) -> Any { fat_abs(ctx, 137, 20, off); fat_abs(ctx, 137, 4, off + 8); return 0; }

fun fat_push(ctx: Any) -> Any { e8(ctx, 82); e8(ctx, 80); return 0; }   // push rdx; push rax

fun fat_global(ctx: Any, name: Any) -> Any {
    let index: Any = glob_find(ctx, addr(name), len(name));
    if (index < 0) { die_str("mayc: runtime/fat.may lacks ${name}\n"); }
    return glob_off(ctx, index);
}

// add rsp, bytes (modrm 196) or sub rsp, bytes (modrm 236).
fun fat_rsp(ctx: Any, modrm: Any, bytes: Any) -> Any {
    if (bytes <= 0) { return 0; }
    if (bytes < 128) { e8(ctx, 72); e8(ctx, 131); e8(ctx, modrm); e8(ctx, bytes); }
    else { e8(ctx, 72); e8(ctx, 129); e8(ctx, modrm); e32(ctx, bytes); }
    return 0;
}

fun fat_release(ctx: Any, bytes: Any) -> Any { return fat_rsp(ctx, 196, bytes); }

// Call a raw runtime function whose `words` arguments are already pushed.
// Its trampoline returns the RTAG global in RDX (x86_call_trampoline).
fun fat_rt_call(ctx: Any, name: Any, words: Any) -> Any {
    let rec: Any = backend_find_func(ctx, addr(name), len(name));
    if (rec == 0) { die_str("mayc: --values fat runtime lacks `${name}`\n"); }
    if (rec.native == true) { die_str("mayc: --values fat runtime function `${name}` must not be native\n"); }
    call(ctx, rec.lab);
    fat_release(ctx, words * 8);
    return 0;
}

// Slow paths shared by every site: [runtime name, operator or -1, label].
// A site calls the stub with its operands in R9/R8 (left) and RDX/RAX.
mut FAT_STUBS: Any = [];

fun fat_stub_label(ctx: Any, name: Any, op: Any) -> Any {
    for stub: Any in FAT_STUBS { if (stub[0] == name and stub[1] == op) { return stub[2]; } }
    let label: Any = newlab(ctx);
    push(FAT_STUBS, [name, op, label]);
    return label;
}

fun fat_stub_call(ctx: Any, name: Any, op: Any) -> Any {
    let label: Any = fat_stub_label(ctx, name, op);
    e8(ctx, 232); let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 0, o, label);
    return 0;
}

// Emit the stubs that sites referenced, after the functions. The runtime
// functions they call join the reachability queue, so the caller drains it
// again. Returns how many stubs were emitted.
mut FAT_STUBS_EMITTED: Any = 0;
fun fat_emit_stubs(ctx: Any) -> Any {
    let start: Any = FAT_STUBS_EMITTED;
    while (FAT_STUBS_EMITTED < len(FAT_STUBS)) {
        let stub: Any = FAT_STUBS[FAT_STUBS_EMITTED]; FAT_STUBS_EMITTED += 1;
        placelab(ctx, stub[2]);
        if (stub[0] == "float") {
            // Not Float operands leave through the operator's rt_binary stub.
            fat_float_binary(ctx, stub[1], fat_stub_label(ctx, "rt_binary", stub[1]));
            continue;
        }
        mut extra: Any = 0;
        if (stub[1] >= 0) { e8(ctx, 106); e8(ctx, 2); e8(ctx, 106); e8(ctx, stub[1]); extra = 2; } // push 2; push op
        fat_operands_call(ctx, stub[0], extra);
        e8(ctx, 195);                                                         // ret
    }
    return FAT_STUBS_EMITTED - start;
}

// Call a runtime function on a linked list of IR values.
fun fat_rt(ctx: Any, name: Any, args: Any) -> Any {
    mut count: Any = 0;
    mut arg: Any = args;
    while (arg != 0) { fat_get(ctx, arg); fat_push(ctx); count += 1; arg = arg.next; }
    return fat_rt_call(ctx, name, count * 2);
}

// One data object per distinct literal text, so that struct constructors,
// map literals and field accesses share their key strings (#98). Strings
// are immutable, so sharing is not observable through equality.
mut FAT_KEYS: Any = {};
fun fat_key(ctx: Any, source: Any, start: Any, length: Any) -> Any {
    let text: Any = symbol_name(source + start, length);
    let known: Any = FAT_KEYS[text];
    if (known != nil) { return known; }
    let off: Any = intern_obj(ctx, source, start, length);
    FAT_KEYS[text] = off;
    return off;
}

// The inline field cache check (#98): with the map's type word in `t` and
// payload in `p` (registers 2/0 or 10/11), leave the cached entry's address
// in RCX, or jump to `miss` unless the value is a map holding the site's
// key object at that entry. Clobbers R8.
fun fat_field_probe(ctx: Any, register: Any, cache: Any, key: Any, miss: Any) -> Any {
    let high: Any = register >= 8;
    let rex: Any = if (high) { 73 } else { 72 };
    let length: Any = if (high) { [77, 139, 3] } else { [76, 139, 0] };
    let entries: Any = if (high) { [73, 3, 75, 16] } else { [72, 3, 72, 16] };
    for byte: Any in [rex, 131, 250, 6] { e8(ctx, byte); }                             // cmp rdx/r10, 6
    jcc(ctx, 133, miss);
    fat_abs(ctx, 139, 12, cache);                                                      // mov rcx, [cache]
    for byte: Any in length { e8(ctx, byte); }                                         // mov r8, [rax/r11]
    for byte: Any in [73, 193, 224, 5, 76, 57, 193] { e8(ctx, byte); }                 // shl r8, 5; cmp rcx, r8
    jcc(ctx, 131, miss);                                                               // jae: past the entries
    for byte: Any in entries { e8(ctx, byte); }                                        // add rcx, [rax/r11 + 16]
    for byte: Any in [72, 131, 57, 4] { e8(ctx, byte); }                               // cmp qword [rcx], 4
    jcc(ctx, 133, miss);
    x86_relocated_immediate(ctx, 8, 1, key);                                           // mov r8, key
    for byte: Any in [76, 57, 65, 8] { e8(ctx, byte); }                                // cmp [rcx + 8], r8
    jcc(ctx, 133, miss);
    return 0;
}

// Push the site's key and cache address as two values.
fun fat_field_operands(ctx: Any, cache: Any, key: Any) -> Any {
    e8(ctx, 106); e8(ctx, 4); x86_relocated_immediate(ctx, 0, 1, key); e8(ctx, 80);      // push 4; push key
    e8(ctx, 106); e8(ctx, 2); x86_relocated_immediate(ctx, 0, 1, cache); e8(ctx, 80);    // push 2; push cache
    return 0;
}

// `object.name` through the site's cache (a writable word reserved by
// ir_field_cache), else rt_field_get.
fun fat_field_get(ctx: Any, object: Any, cache: Any, source: Any, start: Any, length: Any) -> Any {
    let key: Any = fat_key(ctx, source, start, length);
    let miss: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_get(ctx, object);
    fat_field_probe(ctx, 2, cache, key, miss);
    for byte: Any in [72, 139, 81, 16, 72, 139, 65, 24] { e8(ctx, byte); }             // mov rdx, [rcx + 16]; mov rax, [rcx + 24]
    jmp(ctx, done);
    placelab(ctx, miss);
    fat_push(ctx);
    fat_field_operands(ctx, cache, key);
    fat_rt_call(ctx, "rt_field_get", 6);
    placelab(ctx, done);
    return 0;
}

// `object.name = value` through the site's cache, else rt_field_set.
fun fat_field_set(ctx: Any, object: Any, value: Any, cache: Any, source: Any, start: Any, length: Any) -> Any {
    let key: Any = fat_key(ctx, source, start, length);
    let miss: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_get(ctx, object);
    for byte: Any in [73, 137, 210, 73, 137, 195] { e8(ctx, byte); }                   // mov r10, rdx; mov r11, rax
    fat_field_probe(ctx, 10, cache, key, miss);
    fat_get(ctx, value);
    for byte: Any in [72, 137, 81, 16, 72, 137, 65, 24] { e8(ctx, byte); }             // mov [rcx + 16], rdx; mov [rcx + 24], rax
    jmp(ctx, done);
    placelab(ctx, miss);
    for byte: Any in [65, 82, 65, 83] { e8(ctx, byte); }                               // push r10; push r11
    e8(ctx, 106); e8(ctx, 4); x86_relocated_immediate(ctx, 0, 1, key); e8(ctx, 80);      // push 4; push key
    fat_get(ctx, value); fat_push(ctx);
    e8(ctx, 106); e8(ctx, 2); x86_relocated_immediate(ctx, 0, 1, cache); e8(ctx, 80);    // push 2; push cache
    fat_rt_call(ctx, "rt_field_set", 8);
    placelab(ctx, done);
    return 0;
}

// The literal string `text` as a value in RDX/RAX.
fun fat_literal(ctx: Any, off: Any) -> Any {
    x86_mov_immediate(ctx, 2, 4); x86_relocated_immediate(ctx, 0, 1, off);
    return 0;
}

// Jump to `label` when RDX/RAX is falsy (nil or false), or truthy.
fun fat_branch(ctx: Any, label: Any, truthy: Any) -> Any {
    let skip: Any = newlab(ctx);
    e8(ctx, 72); e8(ctx, 133); e8(ctx, 210);                        // test rdx, rdx
    jcc(ctx, 132, if (truthy) { skip } else { label });
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 250); e8(ctx, 1);            // cmp rdx, 1
    jcc(ctx, 133, if (truthy) { label } else { skip });
    e8(ctx, 72); e8(ctx, 133); e8(ctx, 192);                        // test rax, rax
    jcc(ctx, if (truthy) { 133 } else { 132 }, label);
    placelab(ctx, skip);
    return 0;
}

// Cell pointer in RCX: load or store its value.
fun fat_cell_load(ctx: Any) -> Any {
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 17);                         // mov rdx, [rcx]
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 65); e8(ctx, 8);             // mov rax, [rcx + 8]
    return 0;
}
fun fat_cell_store(ctx: Any) -> Any {
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 17);                         // mov [rcx], rdx
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 65); e8(ctx, 8);             // mov [rcx + 8], rax
    return 0;
}

// RCX = the closure environment (payload of the environment slot).
fun fat_env(ctx: Any) -> Any { x86_load_register(ctx, 1, fat_disp(fat_local_slot(ctx, ctx.envSlot)) - 8); return 0; }

// RCX = environment entry `index`, a cell pointer.
fun fat_env_cell(ctx: Any, index: Any) -> Any {
    fat_env(ctx);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 137); e32(ctx, 8 * index);   // mov rcx, [rcx + disp32]
    return 0;
}

fun fat_var(ctx: Any, n: Any) -> Any {
    let p: Any = n.name; let l: Any = n.length;
    if (name_eq(p, l, addr("nil"), 3) == 1) { return fat_set(ctx, 0, 0); }
    if (name_eq(p, l, addr("true"), 4) == 1) { return fat_set(ctx, 1, 1); }
    if (name_eq(p, l, addr("false"), 5) == 1) { return fat_set(ctx, 1, 0); }
    if (name_eq(p, l, addr("err"), 3) == 1) {
        ld_abs(ctx, fat_global(ctx, "ERRVAL")); x86_mov_immediate(ctx, 2, 6);
        return 0;
    }
    let li: Any = loc_find(ctx, p, l);
    if (li >= 0) {
        fat_load_slot(ctx, fat_local_slot(ctx, li));
        if (is_boxed(ctx, p, l) == 1) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 193); fat_cell_load(ctx); } // mov rcx, rax
        return 0;
    }
    let gi: Any = glob_find(ctx, p, l);
    if (gi >= 0) { return fat_abs_load(ctx, glob_off(ctx, gi)); }
    let fr: Any = backend_find_func(ctx, p, l);
    if (fr != 0 and fr.mode != 1) { return fat_function_value(ctx, fr.lab, false, fr.pc); }
    die_str("mayc: unknown variable `${symbol_name(p, l)}`\n");
    return 0;
}

// A closure over code `label`; RCX holds the environment when `env` is true.
fun fat_function_value(ctx: Any, label: Any, env: Bool, arity: Any) -> Any {
    x86_relocated_immediate(ctx, 0, 6, label); e8(ctx, 80);         // push code
    if (env) { e8(ctx, 81); } else { xor_eax(ctx); e8(ctx, 80); }  // push rcx / push 0
    mov_imm(ctx, arity); e8(ctx, 80);
    call_rt0(ctx, addr("rt_closure3"), len("rt_closure3"));
    fat_release(ctx, 24);
    x86_mov_immediate(ctx, 2, 7);
    return 0;
}

fun fat_closure(ctx: Any, n: Any) -> Any {
    mut count: Any = 0;
    mut capture: Any = n.captures;
    while (capture != 0) { count += 1; capture = capture.next; }
    if (count == 0) { return fat_function_value(ctx, n.label, false, n.arity); }
    mov_imm(ctx, count); call_rt1(ctx, addr("rt_env_new"), len("rt_env_new"));
    e8(ctx, 80);                                                     // push env
    capture = n.captures;
    mut index: Any = 0;
    while (capture != 0) {
        mut found: Any = -1;
        for i: Any in 0..ctx.envCount {
            let c: Any = ctx.envCaptures[i];
            if (found < 0 and name_eq(capture.name, capture.length, c[0], c[1]) == 1) { found = i; }
        }
        if (found >= 0) { fat_env_cell(ctx, found); e8(ctx, 72); e8(ctx, 137); e8(ctx, 200); } // mov rax, rcx
        else {
            let li: Any = loc_find(ctx, capture.name, capture.length);
            if (li < 0) { die_str("mayc: unknown capture `${symbol_name(capture.name, capture.length)}`\n"); }
            x86_load_register(ctx, 0, fat_disp(fat_local_slot(ctx, li)) - 8);
        }
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 12); e8(ctx, 36);          // mov rcx, [rsp]
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 129); e32(ctx, 8 * index); // mov [rcx + disp32], rax
        capture = capture.next; index += 1;
    }
    e8(ctx, 89);                                                     // pop rcx
    return fat_function_value(ctx, n.label, true, n.arity);
}

// Store argument values at [rsp + 16 i], padding to `size` with nil.
fun fat_store_arguments(ctx: Any, args: Any) -> Any {
    mut index: Any = 0;
    mut arg: Any = args;
    while (arg != 0) {
        fat_get(ctx, arg);
        fat_outgoing(ctx, 2, 16 * index); fat_outgoing(ctx, 0, 16 * index + 8);
        index += 1; arg = arg.next;
    }
    return index;
}

fun fat_count(args: Any) -> Any {
    mut count: Any = 0;
    mut arg: Any = args;
    while (arg != 0) { count += 1; arg = arg.next; }
    return count;
}

fun fat_direct(ctx: Any, rec: Any, args: Any) -> Any {
    let count: Any = fat_count(args);
    let size: Any = if (count > rec.pc) { count } else { rec.pc };
    fat_rsp(ctx, 236, 16 * size);
    if (count < size) {
        // Missing arguments are nil.
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 231);                                 // mov rdi, rsp
        mov_imm(ctx, 0); x86_mov_immediate(ctx, 1, 2 * size);
        e8(ctx, 243); e8(ctx, 72); e8(ctx, 171);                                 // rep stosq
    }
    fat_store_arguments(ctx, args);
    call(ctx, rec.lab);
    fat_release(ctx, 16 * size);
    return 0;
}

// The local holding the callee during fat_apply, followed by the one holding
// its argument area's size in values; one pair per function. Locals never
// shrink within a fat function, so no variable reuses them.
mut FAT_APPLY_LOCAL: Any = -1;

// Apply the closure value in RDX/RAX to `args`, padding to its arity.
fun fat_apply(ctx: Any, args: Any) -> Any {
    let callable: Any = newlab(ctx);
    for byte: Any in [72, 131, 250, 7] { e8(ctx, byte); }                    // cmp rdx, 7 (Closure)
    jcc(ctx, 132, callable);
    fat_push(ctx); fat_rt_call(ctx, "rt_require_callable", 2);              // raises a type fault
    placelab(ctx, callable);
    if (FAT_APPLY_LOCAL < 0) { FAT_APPLY_LOCAL = loc_add(ctx, addr("0cl"), 3); loc_add(ctx, addr("0sz"), 3); }
    let closure: Any = fat_local_slot(ctx, FAT_APPLY_LOCAL);
    let size: Any = closure + 1;
    fat_frame(ctx, 137, 0, fat_disp(closure) - 8);
    let count: Any = fat_count(args);
    let enough: Any = newlab(ctx); let filled: Any = newlab(ctx);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 72); e8(ctx, 16);                     // mov rcx, [rax + 16]
    e8(ctx, 72); e8(ctx, 129); e8(ctx, 249); e32(ctx, count);                // cmp rcx, count
    jcc(ctx, 141, enough);                                                    // jge
    x86_mov_immediate(ctx, 1, count);
    placelab(ctx, enough);
    fat_frame(ctx, 137, 1, fat_disp(size) - 8);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 225); e8(ctx, 4);                     // shl rcx, 4
    e8(ctx, 72); e8(ctx, 41); e8(ctx, 204);                                  // sub rsp, rcx
    // Only parameters beyond the arguments need nil.
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 233); e8(ctx, 4);                     // shr rcx, 4
    e8(ctx, 72); e8(ctx, 129); e8(ctx, 233); e32(ctx, count);                // sub rcx, count
    jcc(ctx, 142, filled);                                                    // jle
    e8(ctx, 72); e8(ctx, 141); e8(ctx, 188); e8(ctx, 36); e32(ctx, 16 * count); // lea rdi, [rsp + 16 count]
    e8(ctx, 72); e8(ctx, 209); e8(ctx, 225);                                 // shl rcx, 1
    xor_eax(ctx); e8(ctx, 243); e8(ctx, 72); e8(ctx, 171);                   // rep stosq
    placelab(ctx, filled);
    fat_store_arguments(ctx, args);
    fat_frame(ctx, 139, 0, fat_disp(closure) - 8);
    e8(ctx, 76); e8(ctx, 139); e8(ctx, 80); e8(ctx, 8);                      // mov r10, [rax + 8]
    e8(ctx, 255); e8(ctx, 16);                                               // call [rax]
    fat_frame(ctx, 139, 1, fat_disp(size) - 8);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 225); e8(ctx, 4);                     // shl rcx, 4
    e8(ctx, 72); e8(ctx, 1); e8(ctx, 204);                                   // add rsp, rcx
    return 0;
}

// Builtins implemented by a runtime function of the same arity.
let FAT_BUILTINS: Any = {"str": "rt_to_str", "str_of": "rt_to_str", "len": "rt_len", "push": "rt_push",
    "pop": "rt_pop", "fail": "rt_fail", "rt_raise": "rt_raise", "map_get": "rt_map_get", "map_set": "rt_map_set",
    "map_has": "rt_has", "has": "rt_has", "map_keys": "rt_keys", "keys": "rt_keys", "map_values": "rt_values",
    "values": "rt_values", "to_map": "rt_to_map", "value_eq": "rt_eq", "value_tag": "rt_value_tag",
    "cmp": "rt_cmp", "char_at": "rt_char_at", "char_from": "rt_char_from", "to_float": "rt_to_f",
    "read_file": "rt_read_file", "write_file": "rt_write_file", "addr": "rt_addr", "cstr": "rt_cstr",
    "sqrt": "rt_sqrt", "floor": "rt_floor", "ceil": "rt_ceil", "trunc": "rt_trunc", "pow": "rt_powf",
    "map": "rt_mapf", "filter": "rt_filter", "reduce": "rt_reduce", "any": "rt_any", "all": "rt_all",
    "args": "rt_args", "env": "rt_env", "file_exists": "rt_file_exists",
    "spawn": "rt_spawn", "yield": "rt_yield", "run": "rt_run", "time": "rt_time", "clock": "rt_clock",
    "sleep": "rt_sleep", "mkdir": "rt_mkdir", "read_dir": "rt_read_dir", "read_stdin": "rt_read_stdin",
    "input": "rt_input", "int_to_str": "rt_int_str", "str_cmp": "rt_str_cmp", "wait": "rt_wait",
    "exec": "rt_exec", "system": "rt_system", "remove": "rt_remove"};

// Transcendentals use the portable binary64 kernels, as the core runtime does.
let FAT_MATH: Any = {"ln": "__math_ln", "log2": "__math_log2", "log10": "__math_log10", "exp": "__math_exp"};

// Raw memory access on Int addresses; loads return full machine words.
let FAT_LOADS: Any = {"load8": [15, 182, 0], "load16": [15, 183, 0], "load32": [139, 0], "load64": [72, 139, 0]};
let FAT_STORES: Any = {"store8": [136, 8], "store16": [102, 137, 8], "store32": [137, 8], "store64": [72, 137, 8]};

// runtime/math.may reads and builds Floats through `addr`, which unboxed
// Floats do not have; these read the payload instead.
fun fat_math_bits(ctx: Any, name: Any, args: Any) -> Any {
    if (name == "__math_bits") {
        fat_get(ctx, args.next);
        e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 32);               // shl rax, 32
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 193);                            // mov rcx, rax
        fat_get(ctx, args);
        e8(ctx, 137); e8(ctx, 192);                                         // mov eax, eax
        e8(ctx, 72); e8(ctx, 9); e8(ctx, 200);                              // or rax, rcx
        x86_mov_immediate(ctx, 2, 3);
        return 0;
    }
    fat_get(ctx, args);
    if (name == "__math_high") { e8(ctx, 72); e8(ctx, 193); e8(ctx, 232); e8(ctx, 32); } // shr rax, 32
    else { e8(ctx, 137); e8(ctx, 192); }                                    // mov eax, eax
    x86_mov_immediate(ctx, 2, 2);
    return 0;
}

fun fat_builtin(ctx: Any, name: Any, args: Any) -> Any {
    if (name == "print") {
        mut arg: Any = args;
        mut first: Any = true;
        while (arg != 0) {
            if (not first) { fat_rt_call(ctx, "rt_space", 0); }
            fat_get(ctx, arg); fat_push(ctx); fat_rt_call(ctx, "rt_print1", 2);
            first = false; arg = arg.next;
        }
        fat_rt_call(ctx, "rt_newline", 0);
        // The tagged backend leaves rt_newline's result, so `print` evaluates to 0.
        return fat_set(ctx, 2, 0);
    }
    if (name == "exit") {
        fat_get(ctx, args);
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 199);                             // mov rdi, rax
        mov_imm(ctx, 60); x86_syscall_instruction(ctx);
        return 0;
    }
    if (name == "syscall") {
        // Number and arguments are Int payloads; the result is an Int.
        let count: Any = fat_count(args);
        let values: Any = [];
        mut arg: Any = args;
        while (arg != 0) { push(values, arg); arg = arg.next; }
        mut index: Any = count - 1;
        while (index >= 0) { fat_get(ctx, values[index]); e8(ctx, 80); index -= 1; }
        let pops: Any = [[88], [95], [94], [90], [65, 90], [65, 88], [65, 89]]; // rax rdi rsi rdx r10 r8 r9
        for i: Any in 0..count { for byte: Any in pops[i] { e8(ctx, byte); } }
        x86_syscall_instruction(ctx);
        x86_mov_immediate(ctx, 2, 2);
        return 0;
    }
    if (name == "__ccall6") {
        // C call through an address; arguments and result are Int payloads.
        let values: Any = [];
        mut arg: Any = args;
        while (arg != 0) { push(values, arg); arg = arg.next; }
        mut index: Any = len(values) - 1;
        while (index >= 0) { fat_get(ctx, values[index]); e8(ctx, 80); index -= 1; }
        let pops: Any = [[65, 91], [95], [94], [90], [89], [65, 88], [65, 89]]; // r11 rdi rsi rdx rcx r8 r9
        for i: Any in 0..len(values) { for byte: Any in pops[i] { e8(ctx, byte); } }
        xor_eax(ctx);
        e8(ctx, 65); e8(ctx, 255); e8(ctx, 211);                             // call r11
        x86_mov_immediate(ctx, 2, 2);
        return 0;
    }
    if (has(FAT_LOADS, name)) {
        fat_get(ctx, args);
        for byte: Any in FAT_LOADS[name] { e8(ctx, byte); }
        x86_mov_immediate(ctx, 2, 2);
        return 0;
    }
    if (has(FAT_STORES, name)) {
        fat_get(ctx, args.next); e8(ctx, 72); e8(ctx, 137); e8(ctx, 193);  // mov rcx, rax
        fat_get(ctx, args);
        for byte: Any in FAT_STORES[name] { e8(ctx, byte); }                  // mov [rax], cl/cx/ecx/rcx
        return fat_set(ctx, 0, 0);
    }
    if (has(FAT_BUILTINS, name)) { return fat_rt(ctx, FAT_BUILTINS[name], args); }
    if (has(FAT_MATH, name)) {
        let kernel: Any = FAT_MATH[name];
        let rec: Any = backend_find_func(ctx, addr(kernel), len(kernel));
        if (rec != 0) { return fat_direct(ctx, rec, args); }
    }
    die_str("mayc: --values fat does not support `${name}` yet\n");
    return 0;
}

fun fat_call(ctx: Any, n: Any) -> Any {
    let p: Any = n.name; let l: Any = n.length;
    if (loc_find(ctx, p, l) < 0 and glob_find(ctx, p, l) < 0) {
        let name: Any = symbol_name(p, l);
        if (name == "__math_high" or name == "__math_low" or name == "__math_bits") { return fat_math_bits(ctx, name, n.args); }
        // native.may's portable join body, replaced by the runtime's (#99).
        if (name == "__join_list") { return fat_rt(ctx, "rt_join", n.args); }
        let rec: Any = backend_find_func(ctx, p, l);
        if (rec != 0 and rec.mode != 1) { return fat_direct(ctx, rec, n.args); }
        return fat_builtin(ctx, symbol_name(p, l), n.args);
    }
    fat_var(ctx, n);
    return fat_apply(ctx, n.args);
}

fun fat_operation(ctx: Any, n: Any) -> Any {
    let k: Any = n.kind;
    if (k == E_INT) { return fat_set(ctx, 2, n.value); }
    if (k == E_STR) { return fat_literal(ctx, fat_key(ctx, n.span.source, n.start, n.length)); }
    if (k == E_STRB) { return fat_literal(ctx, intern_obj2(ctx, n.address, n.length)); }
    if (k == E_FLOAT) {
        let bits: Any = float_literal_bits(str(symbol_name(n.span.source + n.start, n.length)));
        e8(ctx, 72); e8(ctx, 184); e32(ctx, bits[0]); e32(ctx, bits[1]);   // movabs rax, bits
        x86_mov_immediate(ctx, 2, 3);
        return 0;
    }
    if (k == E_VAR) { return fat_var(ctx, n); }
    if (k == E_CAPVAR) { fat_env_cell(ctx, n.index); return fat_cell_load(ctx); }
    if (k == E_CLOSURE) { return fat_closure(ctx, n); }
    if (k == E_INDEX) { return fat_index(ctx, n); }
    if (k == E_GET) { return fat_field_get(ctx, n.object, n.cache, n.span.source, n.start, n.length); }
    if (k == E_ICALL) { fat_get(ctx, n.callee); return fat_apply(ctx, n.args); }
    if (k == E_RANGE) {
        fat_get(ctx, n.start); fat_push(ctx); fat_get(ctx, n.end); fat_push(ctx);
        fat_set(ctx, 1, if (n.inclusive == 1) { 1 } else { 0 }); fat_push(ctx);
        return fat_rt_call(ctx, "rt_range", 6);
    }
    if (k == E_POW) {
        fat_get(ctx, n.left); fat_push(ctx); fat_get(ctx, n.right); fat_push(ctx);
        return fat_rt_call(ctx, "rt_pow", 4);
    }
    if (k == E_BIN) { return fat_binary(ctx, n); }
    if (k == E_UN) {
        fat_set(ctx, 2, n.op); fat_push(ctx); fat_get(ctx, n.operand); fat_push(ctx);
        return fat_rt_call(ctx, "rt_unary", 4);
    }
    if (k == E_CALL) { return fat_call(ctx, n); }
    die_str("mayc: --values fat does not support IR operation ${k}\n");
    return 0;
}

// Load `left` into R9 (type) and R8 (payload) and `right` into RDX/RAX.
// A forwarded left operand loads after the right one, so that a right
// operand computed just before still skips its store (fat_get); loads have
// no effects, so the order is not observable.
fun fat_operands(ctx: Any, left: Any, right: Any) -> Any {
    if (FAT_FORWARD[left.slot] != nil and FAT_FORWARD[right.slot] == nil) {
        fat_get(ctx, right);
        return fat_get_into(ctx, left, 9, 8);
    }
    fat_get_into(ctx, left, 9, 8);
    fat_get(ctx, right);
    return 0;
}

// Fall back to `name`(left, right) with the operands from fat_operands
// (after `extra` already pushed words).
fun fat_operands_call(ctx: Any, name: Any, extra: Any) -> Any {
    for byte: Any in [65, 81, 65, 80, 82, 80] { e8(ctx, byte); }             // push r9; push r8; push rdx; push rax
    return fat_rt_call(ctx, name, extra + 4);
}

// Int arithmetic, bitwise operators and comparisons run inline, as do Float
// arithmetic and comparisons; mixed types, overflow and division by zero (to
// raise the runtime's fault) and other operators call rt_binary.
let FAT_INLINE_ARITH: Any = {"20": [73, 1, 194], "21": [73, 41, 194], "22": [76, 15, 175, 208],
    "64": [73, 33, 194], "45": [73, 9, 194], "63": [73, 49, 194]};
let FAT_INLINE_COMPARE: Any = {"25": 148, "26": 149, "27": 156, "28": 158, "29": 159, "30": 157};

// The body of a "float" stub: Float + - * / and comparisons on two Float
// operands (fat_operands), as rt_binary computes them: IEEE results,
// ordering and == false for NaN. Other operands and a zero divisor (either
// sign, for the arithmetic fault) jump to `slow`, which returns for the stub.
fun fat_float_binary(ctx: Any, op: Any, slow: Any) -> Any {
    for byte: Any in [73, 131, 249, 3] { e8(ctx, byte); }                    // cmp r9, 3
    jcc(ctx, 133, slow);
    for byte: Any in [72, 131, 250, 3] { e8(ctx, byte); }                    // cmp rdx, 3
    jcc(ctx, 133, slow);
    if (op == TK_SLASH) {
        for byte: Any in [76, 141, 20, 0, 77, 133, 210] { e8(ctx, byte); }   // lea r10, [rax + rax]; test r10, r10
        jcc(ctx, 132, slow);                                                  // je: +0.0 or -0.0
    }
    for byte: Any in [102, 73, 15, 110, 192, 102, 72, 15, 110, 200] { e8(ctx, byte); } // movq xmm0, r8; movq xmm1, rax
    if (op >= TK_PLUS and op <= TK_SLASH) {
        for byte: Any in [242, 15, [88, 92, 89, 94][op - TK_PLUS], 193] { e8(ctx, byte); } // addsd/subsd/mulsd/divsd xmm0, xmm1
        for byte: Any in [102, 72, 15, 126, 192] { e8(ctx, byte); }         // movq rax, xmm0
        x86_mov_immediate(ctx, 2, 3);
    } else {
        // ucomisd orders the operands so that only seta/setae are needed.
        let swapped: Any = op == TK_LT or op == TK_LE;
        for byte: Any in [102, 15, 46, if (swapped) { 200 } else { 193 }] { e8(ctx, byte); }
        if (op == TK_EQ) { for byte: Any in [15, 148, 192, 15, 155, 193, 32, 200] { e8(ctx, byte); } }       // sete; setnp; and
        else if (op == TK_NE) { for byte: Any in [15, 149, 192, 15, 154, 193, 8, 200] { e8(ctx, byte); } } // setne; setp; or
        else if (op == TK_LT or op == TK_GT) { for byte: Any in [15, 151, 192] { e8(ctx, byte); } }          // seta
        else { for byte: Any in [15, 147, 192] { e8(ctx, byte); } }                                          // setae
        for byte: Any in [15, 182, 192] { e8(ctx, byte); }                   // movzx eax, al
        x86_mov_immediate(ctx, 2, 1);
    }
    e8(ctx, 195);                                                             // ret
    return 0;
}

// Jump to `notInt` unless both operands (fat_operands) are Ints; a
// forwarded Int constant needs no check.
fun fat_int_checks(ctx: Any, n: Any, notInt: Any) -> Any {
    if (fat_known_type(n.left) != 2) {
        for byte: Any in [73, 131, 249, 2] { e8(ctx, byte); }                // cmp r9, 2
        jcc(ctx, 133, notInt);
    }
    if (fat_known_type(n.right) != 2) {
        for byte: Any in [72, 131, 250, 2] { e8(ctx, byte); }                // cmp rdx, 2
        jcc(ctx, 133, notInt);
    }
    return 0;
}

// The slow paths deferred by fat_binary and fat_branch_compare.
fun fat_emit_deferred(ctx: Any) -> Any {
    for item: Any in FAT_DEFERRED {
        if (item[0] == "binary") {
            for index: Any in [1, 2] {
                if (item[index] >= 0) {
                    placelab(ctx, item[index]);
                    if (item[5] != nil) { fat_materialize(ctx, item[5], 2, 0); }
                    fat_stub_call(ctx, if (index == 1) { "float" } else { "rt_binary" }, item[3]); jmp(ctx, item[4]);
                }
            }
        } else {
            placelab(ctx, item[1]);
            if (item[6] != nil) { fat_materialize(ctx, item[6], 2, 0); }
            fat_stub_call(ctx, "float", item[2]);
            fat_branch(ctx, item[3], item[4]); jmp(ctx, item[5]);
        }
    }
    FAT_DEFERRED = [];
    return 0;
}

// The value of a forwarded Int constant that fits a sign-extended imm32,
// or nil.
fun fat_imm32(value: Any) -> Any {
    let d: Any = FAT_FORWARD[value.slot];
    if (d == nil or d[0] != 0 or d[1] != 2 or d[2] < -2147483648 or d[2] > 2147483647) { return nil; }
    return d[2];
}

// ALU operation /digit on `register` with an immediate (83 ib or 81 id).
fun fat_alu_immediate(ctx: Any, digit: Any, register: Any, value: Any) -> Any {
    e8(ctx, if (register >= 8) { 73 } else { 72 });
    if (value >= -128 and value <= 127) { e8(ctx, 131); e8(ctx, 192 + digit * 8 + register % 8); e8(ctx, (value + 256) % 256); }
    else { e8(ctx, 129); e8(ctx, 192 + digit * 8 + register % 8); e32(ctx, value); }
    return 0;
}

// Load the left operand into R9/R8 and jump to `notInt` unless it is an Int,
// for a right operand used as an immediate.
fun fat_left_int(ctx: Any, n: Any, notInt: Any) -> Any {
    fat_get_into(ctx, n.left, 9, 8);
    if (fat_known_type(n.left) != 2) {
        for byte: Any in [73, 131, 249, 2] { e8(ctx, byte); }                // cmp r9, 2
        jcc(ctx, 133, notInt);
    }
    return 0;
}

// The power of two that Int constant `value` is (2 to 2^31), or 0.
fun fat_power_of_two(value: Any) -> Any {
    if (value == nil or value < 2) { return 0; }
    mut k: Any = 1; mut power: Any = 2;
    while (power < value and k < 31) { power = power * 2; k += 1; }
    return if (power == value) { k } else { 0 };
}

// `left op c` for an Int constant right operand `c` that fits an imm32:
// comparisons, + - * and / % by a power of two use it as an immediate.
// Returns false, emitting nothing, for other operators and constants.
fun fat_binary_immediate(ctx: Any, n: Any) -> Bool {
    let value: Any = fat_imm32(n.right);
    if (value == nil) { return false; }
    let op: Any = n.op;
    let key: Any = str(op);
    let shift: Any = if (op == TK_SLASH or op == TK_PCT) { fat_power_of_two(value) } else { 0 };
    if (not has(FAT_INLINE_COMPARE, key) and op != TK_PLUS and op != TK_MINUS and op != TK_STAR and shift == 0) { return false; }
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    let floats: Any = op != TK_PCT;
    let notInt: Any = if (floats) { newlab(ctx) } else { slow };
    mut slowUsed: Any = not floats;
    fat_left_int(ctx, n, notInt);
    if (has(FAT_INLINE_COMPARE, key)) {
        fat_alu_immediate(ctx, 7, 8, value);                                   // cmp r8, c
        for byte: Any in [15, FAT_INLINE_COMPARE[key], 192, 15, 182, 192] { e8(ctx, byte); } // setcc al; movzx eax, al
        x86_mov_immediate(ctx, 2, 1);
    } else if (shift > 0) {
        // Truncating division: add 2^k - 1 to a negative dividend first.
        for byte: Any in [76, 137, 192, 76, 137, 193, 72, 193, 249, 63, 72, 193, 233, 64 - shift, 72, 1, 200] { e8(ctx, byte); } // mov rax, r8; mov rcx, r8; sar rcx, 63; shr rcx, 64-k; add rax, rcx
        if (op == TK_SLASH) { for byte: Any in [72, 193, 248, shift] { e8(ctx, byte); } }        // sar rax, k
        else {
            fat_alu_immediate(ctx, 4, 0, 0 - value);                          // and rax, -2^k
            for byte: Any in [76, 137, 193, 72, 41, 193, 72, 137, 200] { e8(ctx, byte); }       // mov rcx, r8; sub rcx, rax; mov rax, rcx
        }
        x86_mov_immediate(ctx, 2, 2);
    } else {
        if (op == TK_STAR) {
            // imul r10, r8, c (6B ib or 69 id)
            if (value >= -128 and value <= 127) { for byte: Any in [77, 107, 208, (value + 256) % 256] { e8(ctx, byte); } }
            else { for byte: Any in [77, 105, 208] { e8(ctx, byte); } e32(ctx, value); }
        } else {
            for byte: Any in [77, 137, 194] { e8(ctx, byte); }                // mov r10, r8
            fat_alu_immediate(ctx, if (op == TK_PLUS) { 0 } else { 5 }, 10, value); // add/sub r10, c
        }
        jcc(ctx, 128, slow); slowUsed = true;                                  // jo
        for byte: Any in [76, 137, 208] { e8(ctx, byte); }                    // mov rax, r10
        x86_mov_immediate(ctx, 2, 2);
    }
    placelab(ctx, done);
    push(FAT_DEFERRED, ["binary", if (floats) { notInt } else { -1 }, if (slowUsed) { slow } else { -1 }, op, done, FAT_FORWARD[n.right.slot]]);
    return true;
}

// `left op right` steering a branch (IR_TRUE when `truthy`, else IR_FALSE)
// whose condition is used nowhere else: Ints compare and jump directly;
// other operands take the operator's float stub (which falls back to
// rt_binary) and branch on the Bool it returns, out of line.
fun fat_branch_compare(ctx: Any, n: Any, label: Any, truthy: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    let jump: Any = FAT_INLINE_COMPARE[str(n.op)] - 16;                      // setcc -> jcc
    let condition: Any = if (truthy) { jump } else if (jump % 2 == 0) { jump + 1 } else { jump - 1 };
    let value: Any = fat_imm32(n.right);
    if (value != nil) {
        fat_left_int(ctx, n, slow);
        fat_alu_immediate(ctx, 7, 8, value);                                   // cmp r8, c
        jcc(ctx, condition, label);
        placelab(ctx, done);
        push(FAT_DEFERRED, ["branch", slow, n.op, label, truthy, done, FAT_FORWARD[n.right.slot]]);
        return 0;
    }
    fat_operands(ctx, n.left, n.right);
    if (fat_float_hint(n)) {
        fat_float_operands(ctx, n, slow);
        fat_float_compare(ctx, n.op);
        fat_float_jump(ctx, n.op, label, truthy);
        placelab(ctx, done);
        push(FAT_DEFERRED, ["branch", slow, n.op, label, truthy, done, nil]);
        return 0;
    }
    fat_int_checks(ctx, n, slow);
    for byte: Any in [73, 57, 192] { e8(ctx, byte); }                        // cmp r8, rax
    jcc(ctx, condition, label);
    placelab(ctx, done);
    push(FAT_DEFERRED, ["branch", slow, n.op, label, truthy, done, nil]);
    return 0;
}

// True when an operand is statically a Float (its checked type, or a Float
// constant). Only a hint for code layout: the type words are still checked.
fun fat_float_value(value: Any) -> Bool {
    if (fat_known_type(value) == 3) { return true; }
    let t: Any = value.valueType;
    return t != nil and t != 0 and t.name == "Float";
}

fun fat_float_hint(n: Any) -> Bool { return fat_float_value(n.left) or fat_float_value(n.right); }

// Jump to `slow` unless both operands are Floats, and for `/` unless the
// divisor is nonzero (either sign: the runtime raises the fault); then
// move the payloads into XMM0 (left) and XMM1.
fun fat_float_operands(ctx: Any, n: Any, slow: Any) -> Any {
    if (fat_known_type(n.left) != 3) {
        for byte: Any in [73, 131, 249, 3] { e8(ctx, byte); }                // cmp r9, 3
        jcc(ctx, 133, slow);
    }
    if (fat_known_type(n.right) != 3) {
        for byte: Any in [72, 131, 250, 3] { e8(ctx, byte); }                // cmp rdx, 3
        jcc(ctx, 133, slow);
    }
    if (n.op == TK_SLASH) {
        for byte: Any in [76, 141, 20, 0, 77, 133, 210] { e8(ctx, byte); }   // lea r10, [rax + rax]; test r10, r10
        jcc(ctx, 132, slow);                                                  // je: +0.0 or -0.0
    }
    for byte: Any in [102, 73, 15, 110, 192, 102, 72, 15, 110, 200] { e8(ctx, byte); } // movq xmm0, r8; movq xmm1, rax
    return 0;
}

// ucomisd for comparison `op`, with the operands swapped for < and <= so
// that "above" means the comparison holds.
fun fat_float_compare(ctx: Any, op: Any) -> Any {
    let swapped: Any = op == TK_LT or op == TK_LE;
    for byte: Any in [102, 15, 46, if (swapped) { 200 } else { 193 }] { e8(ctx, byte); }
    return 0;
}

// Float arithmetic or comparison inline, for operands hinted Float; any
// other operands, and a zero divisor, call rt_binary out of line.
fun fat_float_inline(ctx: Any, n: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_operands(ctx, n.left, n.right);
    fat_float_operands(ctx, n, slow);
    let op: Any = n.op;
    if (op >= TK_PLUS and op <= TK_SLASH) {
        for byte: Any in [242, 15, [88, 92, 89, 94][op - TK_PLUS], 193] { e8(ctx, byte); } // addsd/subsd/mulsd/divsd xmm0, xmm1
        for byte: Any in [102, 72, 15, 126, 192] { e8(ctx, byte); }         // movq rax, xmm0
        x86_mov_immediate(ctx, 2, 3);
    } else {
        fat_float_compare(ctx, op);
        if (op == TK_EQ) { for byte: Any in [15, 148, 192, 15, 155, 193, 32, 200] { e8(ctx, byte); } }       // sete; setnp; and
        else if (op == TK_NE) { for byte: Any in [15, 149, 192, 15, 154, 193, 8, 200] { e8(ctx, byte); } } // setne; setp; or
        else if (op == TK_LT or op == TK_GT) { for byte: Any in [15, 151, 192] { e8(ctx, byte); } }          // seta
        else { for byte: Any in [15, 147, 192] { e8(ctx, byte); } }                                          // setae
        for byte: Any in [15, 182, 192] { e8(ctx, byte); }                   // movzx eax, al
        x86_mov_immediate(ctx, 2, 1);
    }
    placelab(ctx, done);
    push(FAT_DEFERRED, ["binary", -1, slow, op, done, nil]);
    return 0;
}

// Jump to `label` when Float comparison `op` (flags from fat_float_compare)
// is `truthy`. NaN compares unordered: only != holds.
fun fat_float_jump(ctx: Any, op: Any, label: Any, truthy: Any) -> Any {
    if (op == TK_EQ or op == TK_NE) {
        if ((op == TK_EQ) == truthy) {
            let skip: Any = newlab(ctx);
            jcc(ctx, 138, skip); jcc(ctx, 132, label); placelab(ctx, skip);  // jp skip; je label
        } else { jcc(ctx, 138, label); jcc(ctx, 133, label); }              // jp label; jne label
        return 0;
    }
    let strict: Any = op == TK_LT or op == TK_GT;
    if (truthy) { jcc(ctx, if (strict) { 135 } else { 131 }, label); }      // ja / jae
    else { jcc(ctx, if (strict) { 134 } else { 130 }, label); }             // jbe / jb
    return 0;
}

fun fat_binary(ctx: Any, n: Any) -> Any {
    let key: Any = str(n.op);
    if (fat_float_hint(n) and ((n.op >= TK_PLUS and n.op <= TK_SLASH) or has(FAT_INLINE_COMPARE, key))) { return fat_float_inline(ctx, n); }
    if (fat_binary_immediate(ctx, n)) { return 0; }
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    let floats: Any = (n.op >= TK_PLUS and n.op <= TK_SLASH) or has(FAT_INLINE_COMPARE, key);
    let notInt: Any = if (floats) { newlab(ctx) } else { slow };
    // Whether any jump reaches `slow` (overflow, a divisor of 0 or -1, or
    // operands that are not Ints when there is no Float path).
    mut slowUsed: Any = not floats;
    fat_operands(ctx, n.left, n.right);
    if (has(FAT_INLINE_ARITH, key) or has(FAT_INLINE_COMPARE, key)) {
        fat_int_checks(ctx, n, notInt);
        if (has(FAT_INLINE_ARITH, key)) {
            for byte: Any in [77, 137, 194] { e8(ctx, byte); }                // mov r10, r8
            for byte: Any in FAT_INLINE_ARITH[key] { e8(ctx, byte); }         // op r10, rax
            if (n.op == TK_PLUS or n.op == TK_MINUS or n.op == TK_STAR) { jcc(ctx, 128, slow); slowUsed = true; } // jo
            for byte: Any in [76, 137, 208] { e8(ctx, byte); }                // mov rax, r10
        } else {
            for byte: Any in [73, 57, 192, 15, FAT_INLINE_COMPARE[key], 192, 15, 182, 192] { e8(ctx, byte); } // cmp r8, rax; setcc; movzx
            x86_mov_immediate(ctx, 2, 1);
        }
    } else if (n.op == TK_SLASH or n.op == TK_PCT) {
        // idiv truncates toward zero and leaves the dividend's sign on the
        // remainder, as Maylang's / and % do. Divisors 0 and -1 (division by
        // zero, and the -2^63 / -1 overflow) take the runtime's path.
        fat_int_checks(ctx, n, notInt);
        for byte: Any in [72, 137, 193] { e8(ctx, byte); }                   // mov rcx, rax
        let divisor: Any = FAT_FORWARD[n.right.slot];
        if (divisor == nil or divisor[0] != 0 or divisor[1] != 2 or divisor[2] == 0 or divisor[2] == -1) {
            for byte: Any in [76, 141, 81, 1, 73, 131, 250, 1] { e8(ctx, byte); } // lea r10, [rcx + 1]; cmp r10, 1
            jcc(ctx, 134, slow);                                              // jbe: divisor 0 or -1
            slowUsed = true;
        }
        for byte: Any in [76, 137, 192, 72, 153, 72, 247, 249] { e8(ctx, byte); } // mov rax, r8; cqo; idiv rcx
        if (n.op == TK_PCT) { for byte: Any in [72, 137, 208] { e8(ctx, byte); } } // mov rax, rdx
        x86_mov_immediate(ctx, 2, 2);
    } else {
        // No inline form: every operand takes the runtime's path.
        fat_stub_call(ctx, "rt_binary", n.op);
        return 0;
    }
    placelab(ctx, done);
    push(FAT_DEFERRED, ["binary", if (floats) { notInt } else { -1 }, if (slowUsed) { slow } else { -1 }, n.op, done, nil]);
    return 0;
}

// List elements in range load inline; everything else calls rt_index_get.
// `object[index] = value`: a List with an in-range Int index is stored
// inline (#99); anything else calls rt_index_set, which also reports errors.
fun fat_index_set(ctx: Any, n: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_get(ctx, n.object);
    for byte: Any in [73, 137, 210, 73, 137, 195] { e8(ctx, byte); }         // mov r10, rdx; mov r11, rax
    fat_get(ctx, n.index);
    for byte: Any in [73, 131, 250, 5] { e8(ctx, byte); }                    // cmp r10, 5
    jcc(ctx, 133, slow);
    for byte: Any in [72, 131, 250, 2] { e8(ctx, byte); }                    // cmp rdx, 2
    jcc(ctx, 133, slow);
    for byte: Any in [73, 139, 11, 72, 57, 200] { e8(ctx, byte); }           // mov rcx, [r11]; cmp rax, rcx
    jcc(ctx, 131, slow);                                                      // jae (also negative)
    for byte: Any in [73, 139, 75, 16, 72, 193, 224, 4, 72, 1, 193] { e8(ctx, byte); } // mov rcx, [r11 + 16]; shl rax, 4; add rcx, rax
    fat_get(ctx, n.value);
    for byte: Any in [72, 137, 17, 72, 137, 65, 8] { e8(ctx, byte); }        // mov [rcx], rdx; mov [rcx + 8], rax
    jmp(ctx, done);
    placelab(ctx, slow);
    for byte: Any in [65, 82, 65, 83] { e8(ctx, byte); }                     // push r10; push r11
    fat_push(ctx);
    fat_get(ctx, n.value); fat_push(ctx);
    fat_rt_call(ctx, "rt_index_set", 6);
    placelab(ctx, done);
    return 0;
}

fun fat_index(ctx: Any, n: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_operands(ctx, n.object, n.index);
    for byte: Any in [73, 131, 249, 5] { e8(ctx, byte); }                    // cmp r9, 5
    jcc(ctx, 133, slow);
    for byte: Any in [72, 131, 250, 2] { e8(ctx, byte); }                    // cmp rdx, 2
    jcc(ctx, 133, slow);
    for byte: Any in [77, 139, 16, 76, 57, 208] { e8(ctx, byte); }           // mov r10, [r8]; cmp rax, r10
    jcc(ctx, 131, slow);                                                      // jae (also negative)
    for byte: Any in [77, 139, 80, 16, 72, 193, 224, 4, 73, 1, 194,          // mov r10, [r8 + 16]; shl rax, 4; add r10, rax
        73, 139, 18, 73, 139, 66, 8] { e8(ctx, byte); }                      // mov rdx, [r10]; mov rax, [r10 + 8]
    jmp(ctx, done);
    placelab(ctx, slow);
    fat_stub_call(ctx, "rt_index_get", -1);
    placelab(ctx, done);
    return 0;
}

fun fat_let(ctx: Any, s: Any) -> Any {
    fat_get(ctx, s.initializer);
    if (s.global == 1) { return fat_abs_store(ctx, glob_off(ctx, glob_find(ctx, s.name, s.length))); }
    if (is_boxed(ctx, s.name, s.length) == 1) { fat_push(ctx); fat_rt_call(ctx, "rt_cell", 2); }
    return fat_store_slot(ctx, fat_local_slot(ctx, fat_declare(ctx, s.name, s.length)));
}

fun fat_assign(ctx: Any, s: Any) -> Any {
    fat_get(ctx, s.value);
    let li: Any = loc_find(ctx, s.name, s.length);
    if (li >= 0) {
        let slot: Any = fat_local_slot(ctx, li);
        if (is_boxed(ctx, s.name, s.length) == 1) {
            x86_load_register(ctx, 1, fat_disp(slot) - 8);
            return fat_cell_store(ctx);
        }
        return fat_store_slot(ctx, slot);
    }
    let gi: Any = glob_find(ctx, s.name, s.length);
    if (gi < 0) { die_str("mayc: assign to unknown\n"); }
    return fat_abs_store(ctx, glob_off(ctx, gi));
}

// A comparison whose only reader is the branch right after it (#96).
// Dead copies in between (fat_plan_dead_copies) emit nothing. Returns the
// branch's position, or -1.
fun fat_fusable(block: Any, position: Any) -> Any {
    let instruction: Any = block.code[position];
    if (instruction.op != E_BIN or not has(FAT_INLINE_COMPARE, str(instruction.extra.op))) { return -1; }
    mut following: Any = position + 1;
    while (following < len(block.code) and FAT_DEAD[following]) { following += 1; }
    if (following >= len(block.code)) { return -1; }
    let next: Any = block.code[following];
    if (next.op != IR_FALSE and next.op != IR_TRUE) { return -1; }
    let interval: Any = FAT_INTERVALS[instruction.result.slot];
    if (next.arg1 != 0 and next.arg1.slot == instruction.result.slot and interval.uses == 1 and interval.definitions == 1) { return following; }
    return -1;
}

fun fat_ir(ctx: Any, block: Any) -> Any {
    mut position: Any = 0;
    while (position < len(block.code)) {
        let instruction: Any = block.code[position];
        position += 1;
        if (FAT_DEAD[position - 1]) { continue; }
        let op: Any = instruction.op;
        let payload: Any = instruction.extra;
        if (instruction.result != 0 and FAT_FORWARDABLE[instruction.result.slot] > 0 and fat_forward(ctx, instruction)) { continue; }
        let fused: Any = fat_fusable(block, position - 1);
        if (fused >= 0) {
            let branch: Any = block.code[fused];
            position = fused + 1;
            fat_branch_compare(ctx, payload, branch.extra, branch.op == IR_TRUE);
            continue;
        }
        if (op == IR_LABEL) { placelab(ctx, payload); fat_forget(); }
        else if (op == IR_JUMP) { jmp(ctx, payload); }
        else if (op == IR_COPY) { fat_get(ctx, instruction.arg1); }
        else if (op == IR_NIL) { fat_set(ctx, 0, 0); }
        else if (op == IR_BOOL) {
            let falsy: Any = newlab(ctx); let done: Any = newlab(ctx);
            fat_get(ctx, instruction.arg1); fat_branch(ctx, falsy, false);
            fat_set(ctx, 1, 1); jmp(ctx, done);
            placelab(ctx, falsy); fat_set(ctx, 1, 0); placelab(ctx, done);
        }
        else if (op == IR_FALSE or op == IR_TRUE) { fat_get(ctx, instruction.arg1); fat_branch(ctx, payload, op == IR_TRUE); }
        else if (op == IR_ISNIL or op == IR_NONNULL) {
            fat_get(ctx, instruction.arg1);
            e8(ctx, 72); e8(ctx, 133); e8(ctx, 210);                        // test rdx, rdx
            jcc(ctx, if (op == IR_ISNIL) { 132 } else { 133 }, payload);
        }
        else if (op == IR_RUNTIME) { fat_rt(ctx, payload, instruction.arg1); }
        else if (op == IR_RETURN) { fat_get(ctx, instruction.arg1); jmp(ctx, ctx.returnLabel); }
        else if (op == IR_TAILCALL) {
            mut arg: Any = instruction.arg1;
            mut i: Any = 0;
            while (arg != 0) { fat_get(ctx, arg); fat_store_slot(ctx, fat_local_slot(ctx, i)); i += 1; arg = arg.next; }
            jmp(ctx, ctx.restartLabel);
        }
        else if (op == IR_TRY_BEGIN) { x86_handler_begin(ctx, payload); }
        else if (op == IR_TRY_END) { x86_handler_end(ctx); }
        else if (op == S_LET) { fat_let(ctx, payload); }
        else if (op == S_ASSIGN) { fat_assign(ctx, payload); }
        else if (op == S_CASSIGN) { fat_get(ctx, payload.value); fat_env_cell(ctx, payload.index); fat_cell_store(ctx); }
        else if (op == S_SETIDX) { fat_index_set(ctx, payload); } else if (op == S_SETPROP) {
            fat_field_set(ctx, payload.object, payload.value, payload.cache, payload.span.source, payload.start, payload.length);
        } else { fat_operation(ctx, payload); }
        // A result nothing reads (lsra counts readers, never too few) needs no store.
        if (instruction.result != 0 and FAT_INTERVALS[instruction.result.slot].uses > 0) { fat_put(ctx, instruction.result); }
    }
    return 0;
}

// push rbp; mov rbp, rsp; sub rsp, imm32. Returns the immediate's offset.
// The registers of the function's homes, saved below its slots (#96).
fun fat_home_registers() -> Any {
    let registers: Any = [];
    for name: Any in FAT_HOME_ORDER { for register: Any in FAT_HOME_NAMES[name] { push(registers, register); } }
    return registers;
}

fun fat_prologue(ctx: Any) -> Any {
    e8(ctx, 85); e8(ctx, 72); e8(ctx, 137); e8(ctx, 229);
    e8(ctx, 72); e8(ctx, 129); e8(ctx, 236);
    let fp: Any = ctx.code.length; e32(ctx, 0);
    // mov [rbp - disp32], reg; fat_epilogue fills in the displacements.
    FAT_SAVES = [];
    for register: Any in fat_home_registers() {
        e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 137); e8(ctx, 133 + (register % 8) * 8);
        push(FAT_SAVES, ctx.code.length); e32(ctx, 0);
    }
    return fp;
}

// Nil falls off the end; IR_RETURN jumps to the return label with a value.
fun fat_epilogue(ctx: Any, fp: Any) -> Any {
    fat_set(ctx, 0, 0);
    placelab(ctx, ctx.returnLabel);
    let slots: Any = 16 * (ctx.fatBase + ctx.maxLocals);
    let registers: Any = fat_home_registers();
    for index: Any in 0..len(registers) {
        let displacement: Any = slots + 8 * (index + 1);
        store32(ctx.code.data + FAT_SAVES[index], 0 - displacement);
        x86_load_register(ctx, registers[index], displacement);
    }
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 236); e8(ctx, 93); e8(ctx, 195);     // mov rsp, rbp; pop rbp; ret
    // Saves round up to whole 16-byte slots, keeping the stack aligned.
    store32(ctx.code.data + fp, slots + 16 * ((len(registers) + 1) / 2));
    fat_emit_deferred(ctx);
    return 0;
}

fun fat_begin(ctx: Any, block: Any, boxed: Any) -> Any {
    ctx.mode = 1; ctx.native = false; ctx.allocation = 0;
    loc_reset(ctx);
    bx_use_list(ctx, boxed);
    ctx.fatBase = fat_plan_slots(block); fat_forget(); FAT_APPLY_LOCAL = -1;
    FAT_HOME_NAMES = {}; FAT_HOME_ORDER = []; FAT_HOMES = [];
    ctx.envCount = 0; ctx.envCaptures = [];
    return 0;
}

// The fat entry of a native-word function (#92): check each argument's type
// word, pass the payloads as machine words and give the result its type.
// Fat Int and Bool payloads are the native words, so nothing is converted.
fun fat_native_entry(ctx: Any, rec: Any) -> Any {
    if (rec.nativeLab == 0) { rec.nativeLab = newlab(ctx); }
    let fault: Any = newlab(ctx);
    placelab(ctx, rec.lab);
    e8(ctx, 85); e8(ctx, 72); e8(ctx, 137); e8(ctx, 229);                    // push rbp; mov rbp, rsp
    let registers: Any = [7, 6, 2, 1, 8, 9];
    for index: Any in 0..rec.pc {
        x86_load_register(ctx, 0, 0 - (16 + 16 * index));
        e8(ctx, 72); e8(ctx, 131); e8(ctx, 248); e8(ctx, if (rec.nativeKinds[index] == "Bool") { 1 } else { 2 }); // cmp rax, type
        jcc(ctx, 133, fault);
    }
    for index: Any in 0..rec.pc { x86_load_register(ctx, registers[index], 0 - (24 + 16 * index)); }
    call(ctx, rec.nativeLab);
    x86_mov_immediate(ctx, 2, if (rec.nativeResult == "Bool") { 1 } else { 2 });
    e8(ctx, 93); e8(ctx, 195);                                                // pop rbp; ret
    placelab(ctx, fault);
    call_rt0(ctx, addr("rt_word_type_fault"), len("rt_word_type_fault"));
    return 0;
}

// Native-word code calls this function's word adapter: the machine-word
// arguments in the SysV registers become Int or Bool values for its fat
// entry, and the result's payload is the word.
fun fat_word_adapter(ctx: Any, rec: Any) -> Any {
    if (rec.wordLab == 0) { rec.wordLab = newlab(ctx); }
    placelab(ctx, rec.wordLab);
    e8(ctx, 85); e8(ctx, 72); e8(ctx, 137); e8(ctx, 229);                    // push rbp; mov rbp, rsp
    let size: Any = (rec.pc + rec.pc % 2) * 16;
    fat_rsp(ctx, 236, size);
    let registers: Any = [7, 6, 2, 1, 8, 9];
    for index: Any in 0..rec.pc {
        let register: Any = registers[index];
        e8(ctx, 72); e8(ctx, 199); e8(ctx, 132); e8(ctx, 36); e32(ctx, 16 * index); // mov qword [rsp + d], type
        e32(ctx, if (rec.nativeKinds[index] == "Bool") { 1 } else { 2 });
        e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 137);            // mov [rsp + d], reg
        e8(ctx, 132 + (register % 8) * 8); e8(ctx, 36); e32(ctx, 16 * index + 8);
    }
    call(ctx, rec.lab);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 236); e8(ctx, 93); e8(ctx, 195);      // mov rsp, rbp; pop rbp; ret
    return 0;
}

// A typed extern: convert each argument value (rt_ffi_arg) into a frame
// word, place integers in the SysV registers and floats in XMM0-7 (the rest
// on the stack, in order), call the resolved slot and convert the result.
fun fat_foreign(ctx: Any, rec: Any) -> Any {
    fat_begin(ctx, rec.ir, rec.boxed);
    placelab(ctx, rec.lab);
    let fp: Any = fat_prologue(ctx);
    for i: Any in 0..rec.pc {
        x86_load_register(ctx, 2, 0 - (16 + 16 * i)); x86_load_register(ctx, 0, 0 - (24 + 16 * i));
        fat_push(ctx); fat_set(ctx, 2, rec.ffiArgs[i]); fat_push(ctx);
        fat_rt_call(ctx, "rt_ffi_arg", 4);
        // movq xmm0, rax; cvtsd2ss xmm0, xmm0; movd eax, xmm0 for Float32.
        if (rec.ffiArgs[i] == 5) { for byte: Any in [102, 72, 15, 110, 192, 242, 15, 90, 192, 102, 15, 126, 192] { e8(ctx, byte); } }
        x86_store_register(ctx, 0, fat_disp(i) - 8);
    }
    mut integer: Any = 0; mut floating: Any = 0;
    let locations: Any = []; let stacked: Any = [];
    for i: Any in 0..rec.pc {
        let kind: Any = rec.ffiArgs[i];
        if (kind == 4 or kind == 5) {
            if (floating < 8) { push(locations, [1, floating]); floating += 1; } else { push(locations, [2, 0]); push(stacked, i); }
        } else if (integer < 6) { push(locations, [0, integer]); integer += 1; }
        else { push(locations, [2, 0]); push(stacked, i); }
    }
    if (len(stacked) % 2 == 1) { e8(ctx, 72); e8(ctx, 131); e8(ctx, 236); e8(ctx, 8); }
    mut i: Any = len(stacked) - 1;
    while (i >= 0) { x86_load_register(ctx, 0, fat_disp(stacked[i]) - 8); e8(ctx, 80); i -= 1; }
    for index: Any in 0..rec.pc {
        let location: Any = locations[index];
        if (location[0] != 2) {
            x86_load_register(ctx, 0, fat_disp(index) - 8);
            if (location[0] == 0) { mov_argreg(ctx, location[1]); }
            else { e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 110); e8(ctx, 192 + location[1] * 8); }
        }
    }
    ld_abs(ctx, rec.ffiSlot);
    e8(ctx, 73); e8(ctx, 137); e8(ctx, 195);                                 // mov r11, rax
    mov_imm(ctx, floating);
    e8(ctx, 65); e8(ctx, 255); e8(ctx, 211);                                 // call r11
    fat_release(ctx, ((len(stacked) + 1) / 2) * 16);
    let result: Any = rec.ffiResult;
    if (result == 2) { e8(ctx, 72); e8(ctx, 99); e8(ctx, 192); }             // movsxd rax, eax
    if (result == 3) { e8(ctx, 137); e8(ctx, 192); }                         // mov eax, eax
    if (result == 8) { e8(ctx, 15); e8(ctx, 182); e8(ctx, 192); }           // movzx eax, al
    if (result == 5) { e8(ctx, 243); e8(ctx, 15); e8(ctx, 90); e8(ctx, 192); } // cvtss2sd xmm0, xmm0
    if (result == 4 or result == 5) { e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 126); e8(ctx, 192); } // movq rax, xmm0
    x86_mov_immediate(ctx, 2, 2); fat_push(ctx); fat_set(ctx, 2, result); fat_push(ctx);
    fat_rt_call(ctx, "rt_ffi_result", 4);
    ctx.returnLabel = newlab(ctx);
    jmp(ctx, ctx.returnLabel);
    ctx.maxLocals = rec.pc;
    fat_epilogue(ctx, fp);
    return 0;
}

fun fat_func(ctx: Any, rec: Any) -> Any {
    if (rec.foreign == true) { return fat_foreign(ctx, rec); }
    fat_begin(ctx, rec.ir, rec.boxed);
    fat_plan_homes(ctx, rec.ir, rec.parr, rec.pc);
    for i: Any in 0..rec.pc { fat_declare(ctx, rec.parr[i].name, rec.parr[i].length); }
    ctx.envCaptures = rec.caparr; ctx.envCount = rec.cc;
    if (rec.cc > 0) { ctx.envSlot = loc_add(ctx, addr("0env"), 4); }
    placelab(ctx, rec.lab);
    let fp: Any = fat_prologue(ctx);
    if (rec.cc > 0) { x86_store_register(ctx, 10, fat_disp(fat_local_slot(ctx, ctx.envSlot)) - 8); }
    for i: Any in 0..rec.pc {
        x86_load_register(ctx, 2, 0 - (16 + 16 * i)); x86_load_register(ctx, 0, 0 - (24 + 16 * i));
        if (is_boxed(ctx, rec.parr[i].name, rec.parr[i].length) == 1) { fat_push(ctx); fat_rt_call(ctx, "rt_cell", 2); }
        fat_store_slot(ctx, fat_local_slot(ctx, i));
    }
    ctx.returnLabel = newlab(ctx); ctx.restartLabel = newlab(ctx);
    placelab(ctx, ctx.restartLabel); fat_forget();
    fat_ir(ctx, rec.ir);
    fat_epilogue(ctx, fp);
    if (rec.wordCalled == true) { fat_word_adapter(ctx, rec); }
    ctx.allocation = 0;
    return 0;
}

// Top-level statements (label 1), called from _start.
fun fat_main(ctx: Any) -> Any {
    fat_begin(ctx, ctx.mainIR, ctx.mainBoxed);
    fat_plan_homes(ctx, ctx.mainIR, [], 0);
    placelab(ctx, 1);
    let fp: Any = fat_prologue(ctx);
    call_rt0(ctx, addr("rt_init"), len("rt_init"));
    for gi: Any in 0..len(ctx.globals) {
        addr_of(ctx, glob_off(ctx, gi));
        call_rt1(ctx, addr("rt_gc_root"), len("rt_gc_root"));
    }
    ctx.returnLabel = newlab(ctx);
    fat_ir(ctx, ctx.mainIR);
    fat_epilogue(ctx, fp);
    ctx.allocation = 0;
    return 0;
}
