import "../emitter.may";
import "../symbols.may";
import "../state.may";
import "../ast.may";
import "../lexer.may";
import "../ir.may";
import "../literals.may";
import "../sema.may";
import "../regalloc.may";
import "x86_64.may";
// backend/x86_64_fat.may — x86-64 code for `--values fat` (#92).
//
// See docs/design/FAT_VALUES.md. Every IR temporary and local has a 16-byte
// frame slot: the type word at the lower address and the payload 8 bytes
// above it. An expression leaves its value in RDX (type) and RAX (payload).
// Compiled functions find their arguments as 16-byte values above the return
// address, receive a closure environment in R10 and return RAX/RDX. Runtime
// functions are raw: each value is pushed as two words, type first, and the
// result's type word comes back in the RTAG global. Temporaries occupy slots
// 0 to `fatBase - 1`, locals the slots after them.

fun fat_disp(k: Any) -> Any { return 16 * (k + 1); }

// The slot whose value RDX/RAX still hold, and the code length before and
// after its store. A load of that slot with no code emitted in between (so
// no label either: fat_forget runs where one is placed) is skipped, and a
// temporary with one definition and that one reader loses the store too.
mut FAT_HELD_SLOT: Any = -1;
mut FAT_HELD_START: Any = -1;
mut FAT_HELD_AT: Any = -1;
// Live intervals per temporary (regalloc.may): definition and reader
// counts (readers conservatively, never too few) and a frame home. FAT_SLOTS
// maps each temporary to its slot.
mut FAT_INTERVALS: Any = [];
mut FAT_SLOTS: Any = [];
// Forwarded temporaries (#96). FAT_FORWARDABLE[t] is 1 when temporary t is
// a constant defined once (a literal, nil, true or false) and 2 when it is
// one read of a variable that nothing can change before t's last reader.
// Such a definition emits no code: FAT_FORWARD[t] records where the value
// is ([0, type, payload], [1, Float bits], [2, string data offset], [3,
// frame slot] or [4, global offset]) and each reader loads it from there,
// straight into the registers it needs.
mut FAT_FORWARDABLE: Any = [];
mut FAT_FORWARD: Any = [];
// FAT_DEAD[position] is true for an IR_COPY whose target nothing reads
// (an `if` statement's unused value, say); it emits no code and does not
// count as a reader of its source.
mut FAT_DEAD: Any = [];
// Register homes for hot locals (#96): FAT_HOME_NAMES maps a chosen local's
// name to a callee-saved register pair [type, payload]; FAT_HOMES[k] is the
// pair of frame slot k, or nil (the list grows as locals are declared). FAT_SAVES lists the code offsets
// of the prologue's register saves, whose displacements fat_epilogue fills.
mut FAT_HOME_NAMES: Any = {};
mut FAT_HOME_ORDER: Any = [];
mut FAT_HOMES: Any = [];
mut FAT_SAVES: Any = [];
let FAT_HOME_REGISTERS: Any = [3, 12, 13, 14, 15];                         // rbx, r12-r15
// Slow paths moved after the function's code, so that fast paths fall
// through (fat_emit_deferred): ["binary", notInt, slow, op, done, right] or
// ["branch", slow, op, label, truthy, done, right]. `right` is the forwarded
// right operand when the fast path used it as an immediate (nil otherwise);
// the slow path loads it into RDX/RAX first.
mut FAT_DEFERRED: Any = [];
// IR labels of the specialized body of a versioned function (fat_func) map
// to fresh labels, as the generic body places the originals; nil otherwise.
mut FAT_LABEL_MAP: Any = nil;

fun fat_forget() -> Any { FAT_HELD_SLOT = -1; FAT_HELD_AT = -1; return 0; }

// The label that IR label `label` is emitted as.
fun fat_lab(ctx: Any, label: Any) -> Any {
    if (FAT_LABEL_MAP == nil) { return label; }
    let mapped: Any = FAT_LABEL_MAP[label];
    if (mapped != nil) { return mapped; }
    let fresh: Any = newlab(ctx);
    FAT_LABEL_MAP[label] = fresh;
    return fresh;
}

fun fat_constant_name(p: Any, l: Any) -> Bool {
    return name_eq(p, l, addr("nil"), 3) == 1 or name_eq(p, l, addr("true"), 4) == 1 or name_eq(p, l, addr("false"), 5) == 1;
}

// True when nothing between positions `start` and `end` of `code` can change
// the variable `name` that a temporary read at `start` and last used at
// `end`: no declaration or assignment of that name before `end` (the one at
// `end` reads the temporary first), no tail call, and no call, runtime call
// or closure before `end`, as a call can assign a global.
fun fat_variable_stable(code: Any, start: Any, end: Any, name: Any, length: Any) -> Bool {
    mut position: Any = start + 1;
    while (position <= end) {
        let instruction: Any = code[position];
        let op: Any = instruction.op;
        if (op == IR_TAILCALL) { return false; }
        if (position < end) {
            if (op == E_CALL or op == E_ICALL or op == IR_RUNTIME or op == E_CLOSURE) { return false; }
            if ((op == S_LET or op == S_ASSIGN) and name_eq(instruction.extra.name, instruction.extra.length, name, length) == 1) { return false; }
        }
        position += 1;
    }
    return true;
}

// Exact reader counts. lsra_operands counts conservatively: operations
// whose payload names their operands also carry them in arg1/arg2, and are
// counted twice. Fat code reads such an operation's operands only through
// the payload, so only those are counted here.
let FAT_PAYLOAD_OPS: Any = [E_BIN, E_POW, E_UN, E_CALL, E_ICALL, S_LET, S_ASSIGN, S_CASSIGN, E_INDEX, S_SETIDX, E_GET, S_SETPROP, E_RANGE];

fun fat_count_use(intervals: Any, value: Any) -> Any {
    if (value != 0 and value != nil) { intervals[value.slot].uses += 1; }
    return 0;
}

fun fat_count_list(intervals: Any, values: Any) -> Any {
    mut value: Any = values;
    while (value != 0 and value != nil) { intervals[value.slot].uses += 1; value = value.next; }
    return 0;
}

fun fat_exact_uses(block: Any, intervals: Any) -> Any {
    for interval: Any in intervals { interval.uses = 0; }
    for instruction: Any in block.code {
        let op: Any = instruction.op;
        let n: Any = instruction.extra;
        if (has(FAT_PAYLOAD_OPS, op)) {
            if (op == E_BIN or op == E_POW) { fat_count_use(intervals, n.left); fat_count_use(intervals, n.right); }
            else if (op == E_UN) { fat_count_use(intervals, n.operand); }
            else if (op == S_LET) { fat_count_use(intervals, n.initializer); }
            else if (op == S_ASSIGN or op == S_CASSIGN) { fat_count_use(intervals, n.value); }
            else if (op == E_INDEX or op == S_SETIDX) {
                fat_count_use(intervals, n.object); fat_count_use(intervals, n.index);
                if (op == S_SETIDX) { fat_count_use(intervals, n.value); }
            } else if (op == E_GET) { fat_count_use(intervals, n.object); }
            else if (op == S_SETPROP) { fat_count_use(intervals, n.object); fat_count_use(intervals, n.value); }
            else if (op == E_RANGE) { fat_count_use(intervals, n.start); fat_count_use(intervals, n.end); }
            else if (op == E_ICALL) { fat_count_use(intervals, n.callee); }
            if (op == E_CALL or op == E_ICALL) { fat_count_list(intervals, n.args); }
        } else {
            fat_count_list(intervals, instruction.arg1);
            fat_count_list(intervals, instruction.arg2);
        }
    }
    return 0;
}

fun fat_plan_dead_copies(block: Any, intervals: Any) -> Any {
    FAT_DEAD = [];
    for instruction: Any in block.code { push(FAT_DEAD, false); }
    mut changed: Any = true;
    while (changed) {
        changed = false;
        mut position: Any = 0;
        for instruction: Any in block.code {
            if (not FAT_DEAD[position] and instruction.op == IR_COPY and intervals[instruction.result.slot].uses == 0) {
                FAT_DEAD[position] = true; changed = true;
                if (instruction.arg1 != 0) { intervals[instruction.arg1.slot].uses -= 1; }
            }
            position += 1;
        }
    }
    return 0;
}

fun fat_plan_forwarding(block: Any, intervals: Any) -> Any {
    fat_exact_uses(block, intervals);
    fat_plan_dead_copies(block, intervals);
    FAT_FORWARDABLE = []; FAT_FORWARD = [];
    for interval: Any in intervals { push(FAT_FORWARDABLE, 0); push(FAT_FORWARD, nil); }
    if (NO_OPT) { return 0; }
    mut position: Any = 0;
    for instruction: Any in block.code {
        let result: Any = instruction.result;
        if (result != 0 and intervals[result.slot].definitions == 1) {
            let interval: Any = intervals[result.slot];
            let op: Any = instruction.op;
            if (op == E_INT or op == E_FLOAT or op == E_STR or op == E_STRB or op == IR_NIL) { FAT_FORWARDABLE[result.slot] = 1; }
            else if (op == E_VAR) {
                let payload: Any = instruction.extra;
                if (fat_constant_name(payload.name, payload.length)) { FAT_FORWARDABLE[result.slot] = 1; }
                else if (not interval.pinned and fat_variable_stable(block.code, position, interval.end, payload.name, payload.length)) {
                    FAT_FORWARDABLE[result.slot] = 2;
                }
            }
        }
        position += 1;
    }
    return 0;
}

// Choose locals for register homes in RBX and R12-R15 (#96): names declared
// once in the function (a parameter or one `let`, so that no shadowing
// local shares the registers), not captured, and used inside a loop,
// ranked by uses weighted 8x per loop level. A local of a proven type
// (fat_plan_types) keeps only its payload in one register, a Float in one
// of XMM8-15 while they last; others take a pair. A function with a
// handler gets none: a fault restores callee-saved registers to their
// values at the handler's start. The collector marks the callee-saved
// registers (rt_gc), so general-register homes need no spilling around
// calls; XMM homes are spilled (fat_xmm_spill).
fun fat_plan_homes(ctx: Any, block: Any, parameters: Any, count: Any) -> Any {
    if (NO_OPT) { return 0; }
    let code: Any = block.code;
    let labels: Any = {};
    mut position: Any = 0;
    for instruction: Any in code {
        if (instruction.op == IR_TRY_BEGIN) { return 0; }
        if (instruction.op == IR_LABEL) { labels[instruction.extra] = position; }
        position += 1;
    }
    // Loop depth per position, from backward jumps.
    let steps: Any = [];
    mut loops: Any = false;
    for index: Any in 0..(len(code) + 1) { push(steps, 0); }
    position = 0;
    for instruction: Any in code {
        if (instruction.op == IR_JUMP or instruction.op == IR_FALSE or instruction.op == IR_TRUE) {
            let target: Any = labels[instruction.extra];
            if (target != nil and target < position) { steps[target] += 1; steps[position + 1] -= 1; loops = true; }
        }
        position += 1;
    }
    if (not loops) { return 0; }
    // Names in order of first weighted use, so that ties do not depend on
    // map iteration order (the bootstrap's stages must choose alike).
    let declared: Any = {};
    let weights: Any = {};
    let names: Any = [];
    for index: Any in 0..count {
        let name: Any = symbol_name(parameters[index].name, parameters[index].length);
        declared[name] = (declared[name] ?? 0) + 1;
    }
    mut depth: Any = 0;
    position = 0;
    for instruction: Any in code {
        depth += steps[position];
        let op: Any = instruction.op;
        if ((op == E_VAR or op == S_LET or op == S_ASSIGN) and (depth > 0 or op == S_LET)) {
            let n: Any = instruction.extra;
            if (not fat_constant_name(n.name, n.length) and is_boxed(ctx, n.name, n.length) != 1) {
                let name: Any = symbol_name(n.name, n.length);
                if (op == S_LET) { declared[name] = (declared[name] ?? 0) + if (n.global == 1) { 2 } else { 1 }; }
                if (depth > 0) {
                    mut weight: Any = 1;
                    for level: Any in 0..(if (depth > 4) { 4 } else { depth }) { weight = weight * 8; }
                    if (weights[name] == nil) { push(names, name); }
                    weights[name] = (weights[name] ?? 0) + weight;
                }
            }
        }
        position += 1;
    }
    // A local of a proven type (fat_plan_types) needs only a payload
    // register, an XMM register for a Float while one is free; any other
    // needs a pair. Take the heaviest that still fits.
    let chosen: Any = [];
    mut free: Any = 0;
    mut floats: Any = 0;
    mut searching: Any = true;
    while (searching) {
        mut best: Any = nil;
        for name: Any in names {
            let known: Any = FAT_PROVEN_VARS[name] ?? -1;
            let fits: Any = (known == 3 and floats < len(FAT_XMM_HOME_REGISTERS)) or free + (if (known > 0) { 1 } else { 2 }) <= len(FAT_HOME_REGISTERS);
            if ((declared[name] ?? 0) == 1 and not has(chosen, name) and fits and (best == nil or weights[name] > weights[best])) { best = name; }
        }
        if (best == nil) { searching = false; }
        else {
            push(chosen, best); push(FAT_HOME_ORDER, best);
            let known: Any = FAT_PROVEN_VARS[best] ?? -1;
            if (known == 3 and floats < len(FAT_XMM_HOME_REGISTERS)) { FAT_HOME_NAMES[best] = [-1, FAT_XMM_HOME_REGISTERS[floats], 3, true]; floats += 1; }
            else if (known > 0) { FAT_HOME_NAMES[best] = [-1, FAT_HOME_REGISTERS[free], known]; free += 1; }
            else { FAT_HOME_NAMES[best] = [FAT_HOME_REGISTERS[free], FAT_HOME_REGISTERS[free + 1], -1]; free += 2; }
        }
    }
    return 0;
}

// Proven types. FAT_PROVEN[slot] is the type word that temporary `slot`
// holds whenever it is read (1 Bool, 2 Int, 3 Float, 4 Str), or -1. The
// proof comes from the operations themselves, not from annotations, which
// dynamic aliases can bypass: literals; comparisons, which give a Bool or
// fault; Int arithmetic on two Ints, which gives an Int or faults; Float
// arithmetic with a Float operand; `len`, `str` and `to_float` of a number;
// and variables whose every assignment is proven. A variable qualifies when
// every read of its name must reach the same binding: a local declared once
// (no parameter, not captured, no global or function of that name), or a
// global declared once at top level that no function assigns.
mut FAT_PROVEN: Any = [];
mut FAT_PROVEN_VARS: Any = {};
mut FAT_GLOBAL_WRITES: Any = {};
let FAT_PROVEN_TOP: Any = -2;

// Names assigned by any function: globals they name lose their proofs.
fun fat_plan_global_writes(ctx: Any) -> Any {
    FAT_GLOBAL_WRITES = {};
    for rec: Any in ctx.functions {
        if (rec.ir == nil or rec.ir == 0) { continue; }
        for instruction: Any in rec.ir.code {
            if (instruction.op == S_ASSIGN) { FAT_GLOBAL_WRITES[symbol_name(instruction.extra.name, instruction.extra.length)] = true; }
        }
    }
    return 0;
}

fun fat_meet(a: Any, b: Any) -> Any {
    if (a == FAT_PROVEN_TOP) { return b; }
    if (b == FAT_PROVEN_TOP or a == b) { return a; }
    return -1;
}

// The type an operation's result is proven to have, from its operands'.
// `variable` is the operation's variable id (E_VAR) and `call` the type a
// builtin call gives (fat_plan_types resolves both once).
fun fat_proven_result(instruction: Any, variable: Any, call: Any, variables: Any) -> Any {
    let op: Any = instruction.op;
    let n: Any = instruction.extra;
    if (op == E_INT) { return 2; }
    if (op == E_FLOAT) { return 3; }
    if (op == E_STR or op == E_STRB) { return 4; }
    if (op == IR_BOOL) { return 1; }
    if (op == IR_COPY) { return if (instruction.arg1 == 0) { -1 } else { FAT_PROVEN[instruction.arg1.slot] }; }
    if (op == E_VAR) { return if (variable >= 0) { variables[variable] } else { call }; }
    if (op == E_BIN) {
        let o: Any = n.op;
        if (o >= TK_EQ and o <= 30) { return 1; }
        let l: Any = FAT_PROVEN[n.left.slot]; let r: Any = FAT_PROVEN[n.right.slot];
        if (l == FAT_PROVEN_TOP or r == FAT_PROVEN_TOP) { return FAT_PROVEN_TOP; }
        if (o >= TK_PLUS and o <= TK_SLASH) {
            if (l == 2 and r == 2) { return 2; }
            if ((l == 2 or l == 3) and (r == 2 or r == 3)) { return 3; }
            return -1;
        }
        if (o == TK_PCT or o == TK_BITAND or o == TK_PIPE or o == TK_XOR or o == TK_SHL or o == TK_SHR) {
            return if (l == 2 and r == 2) { 2 } else { -1 };
        }
        return -1;
    }
    if (op == E_UN) {
        if (n.op == TK_NOT) { return 1; }
        let v: Any = FAT_PROVEN[n.operand.slot];
        if (v == FAT_PROVEN_TOP) { return v; }
        if (n.op == TK_MINUS and (v == 2 or v == 3)) { return v; }
        if (n.op == TK_BITNOT and v == 2) { return 2; }
        return -1;
    }
    if (op == E_CALL) {
        if (call != 0) { return call; }
        // to_float: a Float for an Int or Float argument.
        let v: Any = FAT_PROVEN[n.args.slot];
        if (v == FAT_PROVEN_TOP) { return v; }
        return if (v == 2 or v == 3) { 3 } else { -1 };
    }
    return -1;
}

// The type a call to builtin `name` with one argument gives: 2 for len, 4
// for str, 0 for to_float (it depends on the argument), else -1. A local,
// global or function of that name hides the builtin.
fun fat_builtin_type(ctx: Any, n: Any, locals: Any) -> Any {
    if (n.args == 0 or n.args.next != 0) { return -1; }
    let name: Any = symbol_name(n.name, n.length);
    if (name != "len" and name != "str" and name != "to_float") { return -1; }
    if (has(locals, name) or glob_find(ctx, n.name, n.length) >= 0 or backend_find_func(ctx, n.name, n.length) != 0) { return -1; }
    if (name == "len") { return 2; }
    if (name == "str") { return 4; }
    return 0;
}

// `assumed` gives a type for each parameter that the specialized body of a
// versioned function (fat_func) may rely on, or -1; it is empty otherwise.
// Such a parameter starts at that type instead of qualifying never.
fun fat_plan_types(ctx: Any, block: Any, parameters: Any, count: Any, main: Bool, assumed: Any) -> Any {
    FAT_PROVEN = [];
    FAT_PROVEN_VARS = {};
    for interval: Any in FAT_INTERVALS { push(FAT_PROVEN, if (NO_OPT) { -1 } else { FAT_PROVEN_TOP }); }
    if (NO_OPT) { return 0; }
    let code: Any = block.code;
    // Name ids, declarations per id; parameters and captured names never
    // qualify. A read before the declaration (in code order) sees another
    // binding, or an unset global. Names are resolved once here, so that
    // the iteration below allocates nothing.
    let ids: Any = {};
    let names: Any = [];
    let declared: Any = [];
    let isLocal: Any = [];
    let at: Any = [];
    let calls: Any = [];
    let locals: Any = {};
    let initial: Any = [];
    for index: Any in 0..count {
        let parameter: Any = parameters[index];
        let name: Any = symbol_name(parameter.name, parameter.length);
        locals[name] = true;
        let assumption: Any = if (index < len(assumed)) { assumed[index] } else { -1 };
        if (ids[name] == nil) {
            ids[name] = len(names); push(names, name); push(isLocal, true);
            let open: Any = assumption > 0 and is_boxed(ctx, parameter.name, parameter.length) != 1;
            push(declared, if (open) { 1 } else { 2 }); push(initial, assumption);
        } else { declared[ids[name]] = 2; }
    }
    for instruction: Any in code {
        let op: Any = instruction.op;
        mut id: Any = -1;
        mut call: Any = -1;
        if (op == S_LET or op == S_ASSIGN or op == E_VAR) {
            let n: Any = instruction.extra;
            let name: Any = symbol_name(n.name, n.length);
            id = ids[name] ?? -1;
            if (id < 0) {
                id = len(names); ids[name] = id; push(names, name);
                // First seen at a read or an assignment: not a declared binding.
                push(declared, if (op == S_LET) { 0 } else { 2 }); push(isLocal, false); push(initial, FAT_PROVEN_TOP);
            }
            if (op == S_LET) {
                if (n.global == 1) { declared[id] = declared[id] + if (main) { 1 } else { 2 }; }
                else {
                    isLocal[id] = true; locals[name] = true;
                    let hidden: Any = is_boxed(ctx, n.name, n.length) == 1 or glob_find(ctx, n.name, n.length) >= 0 or backend_find_func(ctx, n.name, n.length) != 0;
                    declared[id] = declared[id] + if (hidden) { 2 } else { 1 };
                }
            } else if (op == E_VAR and (name == "true" or name == "false")) { call = 1; id = -1; }
        }
        push(at, id); push(calls, call);
    }
    // Builtin calls resolve once all locals are known.
    mut position: Any = 0;
    for instruction: Any in code {
        if (instruction.op == E_CALL) { calls[position] = fat_builtin_type(ctx, instruction.extra, locals); }
        position += 1;
    }
    let variables: Any = [];
    mut id: Any = 0;
    while (id < len(names)) {
        let name: Any = names[id];
        let global: Any = main and not isLocal[id];
        push(variables, if (declared[id] == 1 and name != "err" and not (global and has(FAT_GLOBAL_WRITES, name))) { initial[id] } else { -1 });
        id += 1;
    }
    // Optimistic iteration: types only fall (top, a type, -1), so it ends.
    mut changed: Any = true;
    while (changed) {
        changed = false;
        position = 0;
        for instruction: Any in code {
            let op: Any = instruction.op;
            let variable: Any = at[position];
            if ((op == S_LET or op == S_ASSIGN) and variable >= 0) {
                let current: Any = variables[variable];
                if (current != -1) {
                    let n: Any = instruction.extra;
                    let value: Any = if (op == S_LET) { n.initializer } else { n.value };
                    let next: Any = fat_meet(current, if (value == 0 or value == nil) { -1 } else { FAT_PROVEN[value.slot] });
                    if (next != current) { variables[variable] = next; changed = true; }
                }
            }
            let result: Any = instruction.result;
            if (result != 0 and result != nil) {
                let current: Any = FAT_PROVEN[result.slot];
                if (current != -1) {
                    let next: Any = fat_meet(current, fat_proven_result(instruction, variable, calls[position], variables));
                    if (next != current) { FAT_PROVEN[result.slot] = next; changed = true; }
                }
            }
            position += 1;
        }
    }
    // A temporary or variable that is never defined stays top; it proves nothing.
    id = 0;
    while (id < len(names)) {
        let v: Any = variables[id];
        if (v > 0) { FAT_PROVEN_VARS[names[id]] = v; }
        id += 1;
    }
    mut index: Any = 0;
    while (index < len(FAT_PROVEN)) { if (FAT_PROVEN[index] == FAT_PROVEN_TOP) { FAT_PROVEN[index] = -1; } index += 1; }
    return 0;
}

// Give the temporaries of `block` frame slots and return how many there
// are. A temporary defined once and read before the next label, branch or
// handler boundary shares a slot with others whose intervals do not overlap;
// those few hot slots come first, where an 8-bit displacement reaches them.
// The others keep private slots, as liveness across loops is not tracked.
fun fat_plan_slots(block: Any) -> Any {
    let intervals: Any = lsra_plan(block, [], false).locations;
    mut shared: Any = 0; mut pinned: Any = 0;
    for interval: Any in intervals {
        if (interval.home >= 0 and interval.pinned) { pinned += 1; }
        else if (interval.home >= 0 and interval.home + 1 > shared) { shared = interval.home + 1; }
    }
    // lsra_plan numbers pinned homes from 0 and shared homes after them.
    shared = shared - pinned;
    if (shared < 0) { shared = 0; }
    let slots: Any = [];
    mut extra: Any = shared + pinned;
    for interval: Any in intervals {
        if (interval.home < 0) { push(slots, extra); extra += 1; }
        else if (interval.pinned) { push(slots, shared + interval.home); }
        else { push(slots, interval.home - pinned); }
    }
    FAT_INTERVALS = intervals; FAT_SLOTS = slots;
    fat_plan_forwarding(block, intervals);
    FAT_DEFERRED = [];
    return extra;
}

// mov reg, [rbp - d] or mov [rbp - d], reg (opcode 139 or 137), with an
// 8-bit displacement when it fits.
fun fat_frame(ctx: Any, opcode: Any, register: Any, displacement: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, opcode);
    if (displacement <= 128) { e8(ctx, 69 + (register % 8) * 8); e8(ctx, 256 - displacement); }
    else { e8(ctx, 133 + (register % 8) * 8); e32(ctx, 0 - displacement); }
    return 0;
}

// mov [rsp + d], reg, with an 8-bit displacement when it fits.
fun fat_outgoing(ctx: Any, register: Any, displacement: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 137);
    if (displacement < 128) { e8(ctx, 68 + (register % 8) * 8); e8(ctx, 36); e8(ctx, displacement); }
    else { e8(ctx, 132 + (register % 8) * 8); e8(ctx, 36); e32(ctx, displacement); }
    return 0;
}

// Load frame slot `k` (or its register home) into registers `t` and `p`.
fun fat_home(k: Any) -> Any {
    if (k >= len(FAT_HOMES)) { return nil; }
    return FAT_HOMES[k];
}

// A home of a proven type keeps only the payload; its type is home[2].
fun fat_load_pair(ctx: Any, k: Any, t: Any, p: Any) -> Any {
    let home: Any = fat_home(k);
    if (home != nil) {
        if (home[0] < 0) { x86_mov_immediate(ctx, t, home[2]); } else { x86_move_register(ctx, t, home[0]); }
        if (fat_xmm_home(home)) { fat_movq_from_xmm(ctx, p, home[1]); } else { x86_move_register(ctx, p, home[1]); }
        return 0;
    }
    fat_frame(ctx, 139, t, fat_disp(k)); fat_frame(ctx, 139, p, fat_disp(k) - 8);
    return 0;
}

fun fat_load_slot(ctx: Any, k: Any) -> Any {
    if (k == FAT_HELD_SLOT and ctx.code.length == FAT_HELD_AT) { return 0; }
    return fat_load_pair(ctx, k, 2, 0);
}

fun fat_store_slot(ctx: Any, k: Any) -> Any {
    FAT_HELD_START = ctx.code.length;
    let home: Any = fat_home(k);
    if (home != nil) {
        if (home[0] >= 0) { x86_move_register(ctx, home[0], 2); }
        if (fat_xmm_home(home)) { fat_movq_to_xmm(ctx, home[1], 0); } else { x86_move_register(ctx, home[1], 0); }
    } else { fat_frame(ctx, 137, 2, fat_disp(k)); fat_frame(ctx, 137, 0, fat_disp(k) - 8); }
    FAT_HELD_SLOT = k; FAT_HELD_AT = ctx.code.length;
    return 0;
}

// ------------------------------------------------------------ XMM values
//
// Proven Floats (#101) stay in XMM registers instead of moving through RAX
// for every operation: locals in XMM8-15 (homes from fat_plan_homes, marked
// by home[3]) and temporaries in XMM2-7 (fat_plan_xmm) between a definition
// and readers that no call, branch or label separates. XMM0 and XMM1 stay
// scratch. The SysV ABI saves no XMM register and called code may run any
// function, so every call from a body spills the homes to their frame slots
// and reloads them afterwards (fat_xmm_spill); temporaries never live across
// one. Float payloads are never pointers, so the collector needs neither.
let FAT_XMM_HOME_REGISTERS: Any = [8, 9, 10, 11, 12, 13, 14, 15];
let FAT_XMM_TEMP_REGISTERS: Any = [2, 3, 4, 5, 6, 7];
// FAT_XMM[t] is the XMM register of temporary t, or -1.
mut FAT_XMM: Any = [];
// True while a function body is emitted, so that stubs emitted between
// bodies spill nothing.
mut FAT_IN_BODY: Bool = false;

fun fat_xmm_home(home: Any) -> Bool { return home != nil and len(home) > 3 and home[3] == true; }

// prefix [REX] 0F opcode with ModRM reg = `reg`, rm = register `rm`. `wide`
// sets REX.W (movq between XMM and general registers).
fun fat_sse(ctx: Any, prefix: Any, opcode: Any, reg: Any, rm: Any, wide: Bool) -> Any {
    e8(ctx, prefix);
    let rex: Any = (if (wide) { 8 } else { 0 }) + (if (reg >= 8) { 4 } else { 0 }) + (if (rm >= 8) { 1 } else { 0 });
    if (rex != 0) { e8(ctx, 64 + rex); }
    e8(ctx, 15); e8(ctx, opcode); e8(ctx, 192 + (reg % 8) * 8 + rm % 8);
    return 0;
}

fun fat_movq_to_xmm(ctx: Any, xmm: Any, register: Any) -> Any { return fat_sse(ctx, 102, 110, xmm, register, true); }   // movq xmm, r64
fun fat_movq_from_xmm(ctx: Any, register: Any, xmm: Any) -> Any { return fat_sse(ctx, 102, 126, xmm, register, true); } // movq r64, xmm
fun fat_movapd(ctx: Any, target: Any, source: Any) -> Any {
    if (target != source) { fat_sse(ctx, 102, 40, target, source, false); }
    return 0;
}

// movsd [rbp - d], xmm (opcode 17) or movsd xmm, [rbp - d] (16).
fun fat_xmm_frame(ctx: Any, opcode: Any, xmm: Any, displacement: Any) -> Any {
    e8(ctx, 242);
    if (xmm >= 8) { e8(ctx, 68); }
    e8(ctx, 15); e8(ctx, opcode);
    if (displacement <= 128) { e8(ctx, 69 + (xmm % 8) * 8); e8(ctx, 256 - displacement); }
    else { e8(ctx, 133 + (xmm % 8) * 8); e32(ctx, 0 - displacement); }
    return 0;
}

// Store (opcode 17) or reload (16) every XMM home of the body around a
// call. A home declared later in code order holds no live value yet.
fun fat_xmm_spill(ctx: Any, opcode: Any) -> Any {
    if (not FAT_IN_BODY) { return 0; }
    mut k: Any = 0;
    while (k < len(FAT_HOMES)) {
        let home: Any = FAT_HOMES[k];
        if (fat_xmm_home(home)) { fat_xmm_frame(ctx, opcode, home[1], fat_disp(k) - 8); }
        k += 1;
    }
    return 0;
}
fun fat_call_begin(ctx: Any) -> Any { return fat_xmm_spill(ctx, 17); }
fun fat_call_end(ctx: Any) -> Any { return fat_xmm_spill(ctx, 16); }

// Whether `n` is Float arithmetic or a comparison on two proven Floats,
// which fat_xmm_binary computes in XMM registers. `/` keeps its check of
// the divisor in fat_binary.
fun fat_xmm_operation(n: Any) -> Bool {
    let op: Any = n.op;
    if (not (op == TK_PLUS or op == TK_MINUS or op == TK_STAR or has(FAT_INLINE_COMPARE, str(op)))) { return false; }
    return FAT_PROVEN[n.left.slot] == 3 and FAT_PROVEN[n.right.slot] == 3;
}

// An instruction that emits no call, so that a temporary may stay in an
// XMM register across it: constants, copies, variable reads and stores
// that need no cell, and arithmetic on proven numbers, whose slow paths
// only raise faults.
fun fat_xmm_safe(ctx: Any, instruction: Any) -> Bool {
    let op: Any = instruction.op;
    if (op == E_INT or op == E_FLOAT or op == E_STR or op == E_STRB or op == IR_NIL or op == IR_COPY) { return true; }
    let n: Any = instruction.extra;
    if (op == E_VAR or op == S_LET or op == S_ASSIGN) {
        return is_boxed(ctx, n.name, n.length) != 1 and backend_find_func(ctx, n.name, n.length) == 0;
    }
    if (op == E_BIN) {
        if (fat_xmm_operation(n)) { return true; }
        let o: Any = n.op;
        return (o == TK_PLUS or o == TK_MINUS or o == TK_STAR or has(FAT_INLINE_COMPARE, str(o)))
            and FAT_PROVEN[n.left.slot] == 2 and FAT_PROVEN[n.right.slot] == 2;
    }
    return false;
}

// Give XMM2-7 to proven Float results of fat_xmm_binary that are defined
// once and read only before any instruction that is not fat_xmm_safe, in
// order of definition; a register is free again after its last reader.
// A body with a handler keeps every temporary in its slot.
fun fat_plan_xmm(ctx: Any, block: Any) -> Any {
    FAT_XMM = [];
    for interval: Any in FAT_INTERVALS { push(FAT_XMM, -1); }
    if (NO_OPT) { return 0; }
    let code: Any = block.code;
    for instruction: Any in code { if (instruction.op == IR_TRY_BEGIN) { return 0; } }
    let busy: Any = [];
    for register: Any in FAT_XMM_TEMP_REGISTERS { push(busy, -1); }
    mut position: Any = 0;
    for instruction: Any in code {
        let result: Any = instruction.result;
        if (instruction.op == E_BIN and result != 0 and result != nil and fat_xmm_operation(instruction.extra)) {
            let slot: Any = result.slot;
            let interval: Any = FAT_INTERVALS[slot];
            // Comparisons give Bools, which stay in RDX/RAX.
            if (interval.definitions == 1 and interval.uses > 0 and interval.start == position and FAT_FORWARDABLE[slot] == 0 and FAT_PROVEN[slot] == 3) {
                mut clear: Bool = true;
                mut between: Any = position + 1;
                while (clear and between < interval.end) {
                    if (not FAT_DEAD[between] and not fat_xmm_safe(ctx, code[between])) { clear = false; }
                    between += 1;
                }
                if (clear) {
                    mut index: Any = 0;
                    while (index < len(busy) and busy[index] > position) { index += 1; }
                    if (index < len(busy)) { FAT_XMM[slot] = FAT_XMM_TEMP_REGISTERS[index]; busy[index] = interval.end; }
                }
            }
        }
        position += 1;
    }
    return 0;
}

// The XMM register that already holds `value` (an XMM temporary or a read
// of a local with an XMM home), or -1. Emits nothing.
fun fat_xmm_source(value: Any) -> Any {
    let register: Any = FAT_XMM[value.slot];
    if (register >= 0) { return register; }
    let d: Any = FAT_FORWARD[value.slot];
    if (d != nil and d[0] == 3) {
        let home: Any = fat_home(d[1]);
        if (fat_xmm_home(home)) { return home[1]; }
    }
    return -1;
}

// The XMM register holding proven Float `value`, loading it into `scratch`
// when no register holds it yet.
fun fat_xmm_operand(ctx: Any, value: Any, scratch: Any) -> Any {
    let register: Any = fat_xmm_source(value);
    if (register >= 0) { return register; }
    let d: Any = FAT_FORWARD[value.slot];
    if (d != nil and d[0] == 1) {
        if (d[1][0] == 0 and d[1][1] == 0) { fat_sse(ctx, 102, 87, scratch, scratch, false); return scratch; } // xorpd: +0.0
        e8(ctx, 73); e8(ctx, 186); e32(ctx, d[1][0]); e32(ctx, d[1][1]);    // movabs r10, bits
        fat_movq_to_xmm(ctx, scratch, 10);
        return scratch;
    }
    if (d != nil and d[0] == 3 and fat_home(d[1]) == nil) {
        fat_xmm_frame(ctx, 16, scratch, fat_disp(d[1]) - 8);                  // movsd scratch, payload
        return scratch;
    }
    fat_get(ctx, value);
    fat_movq_to_xmm(ctx, scratch, 0);
    return scratch;
}

// fat_xmm_operation `n` with result `result`: arithmetic leaves the value
// in the result's XMM register, or as a Float in RDX/RAX; a comparison
// leaves a Bool in RDX/RAX. NaN orders false and compares unequal, as in
// rt_binary.
fun fat_xmm_binary(ctx: Any, n: Any, result: Any) -> Any {
    let left: Any = fat_xmm_operand(ctx, n.left, 0);
    let right: Any = fat_xmm_operand(ctx, n.right, 1);
    let op: Any = n.op;
    if (op == TK_PLUS or op == TK_MINUS or op == TK_STAR) {
        let target: Any = if (result != 0 and result != nil) { FAT_XMM[result.slot] } else { -1 };
        // Compute in the target unless it holds the right operand.
        let accumulator: Any = if (target >= 0 and target != right) { target } else { 0 };
        fat_movapd(ctx, accumulator, left);
        fat_sse(ctx, 242, [88, 92, 89][op - TK_PLUS], accumulator, right, false); // addsd/subsd/mulsd acc, right
        if (target >= 0) { fat_movapd(ctx, target, accumulator); }
        else { fat_movq_from_xmm(ctx, 0, accumulator); x86_mov_immediate(ctx, 2, 3); }
        fat_forget();
        return 0;
    }
    fat_xmm_compare(ctx, op, left, right);
    if (op == TK_EQ) { for byte: Any in [15, 148, 192, 15, 155, 193, 32, 200] { e8(ctx, byte); } }       // sete; setnp; and
    else if (op == TK_NE) { for byte: Any in [15, 149, 192, 15, 154, 193, 8, 200] { e8(ctx, byte); } } // setne; setp; or
    else if (op == TK_LT or op == TK_GT) { for byte: Any in [15, 151, 192] { e8(ctx, byte); } }          // seta
    else { for byte: Any in [15, 147, 192] { e8(ctx, byte); } }                                          // setae
    for byte: Any in [15, 182, 192] { e8(ctx, byte); }                       // movzx eax, al
    x86_mov_immediate(ctx, 2, 1);
    fat_forget();
    return 0;
}

// ucomisd for comparison `op` on XMM registers, swapped for < and <= so
// that "above" means the comparison holds (fat_float_jump reads it).
fun fat_xmm_compare(ctx: Any, op: Any, left: Any, right: Any) -> Any {
    if (op == TK_LT or op == TK_LE) { fat_sse(ctx, 102, 46, right, left, false); }
    else { fat_sse(ctx, 102, 46, left, right, false); }
    return 0;
}

// Declare a local; a name chosen by fat_plan_homes gets its register pair.
fun fat_declare(ctx: Any, p: Any, l: Any) -> Any {
    let index: Any = loc_add(ctx, p, l);
    if (len(FAT_HOME_ORDER) == 0) { return index; }
    let home: Any = FAT_HOME_NAMES[symbol_name(p, l)];
    if (home != nil) {
        let k: Any = fat_local_slot(ctx, index);
        while (len(FAT_HOMES) <= k) { push(FAT_HOMES, nil); }
        FAT_HOMES[k] = home;
    }
    return index;
}

fun fat_local_slot(ctx: Any, index: Any) -> Any { return ctx.fatBase + index; }

// mov reg, [disp32] for a data offset.
fun fat_abs_register(ctx: Any, register: Any, off: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 139); e8(ctx, 4 + (register % 8) * 8); e8(ctx, 37);
    let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 2, o, off);
    return 0;
}

// Load forwarded value `d` (FAT_FORWARD) into registers `t` (type) and `p`.
fun fat_materialize(ctx: Any, d: Any, t: Any, p: Any) -> Any {
    let kind: Any = d[0];
    if (kind == 0) { x86_mov_immediate(ctx, t, d[1]); x86_mov_immediate(ctx, p, d[2]); }
    else if (kind == 1) {
        x86_mov_immediate(ctx, t, 3);
        e8(ctx, if (p >= 8) { 73 } else { 72 }); e8(ctx, 184 + p % 8); e32(ctx, d[1][0]); e32(ctx, d[1][1]); // movabs p, bits
    } else if (kind == 2) { x86_mov_immediate(ctx, t, 4); x86_relocated_immediate(ctx, p, 1, d[1]); }
    else if (kind == 3) {
        if (t == 2 and p == 0) { fat_load_slot(ctx, d[1]); }
        else { fat_load_pair(ctx, d[1], t, p); }
    } else { fat_abs_register(ctx, t, d[1]); fat_abs_register(ctx, p, d[1] + 8); }
    return 0;
}

// The type of a forwarded constant or a proven temporary (fat_plan_types),
// or -1 when it is not known here.
fun fat_known_type(value: Any) -> Any {
    let d: Any = FAT_FORWARD[value.slot];
    if (d == nil) { return FAT_PROVEN[value.slot]; }
    if (d[0] == 0) { return d[1]; }
    if (d[0] == 1) { return 3; }
    if (d[0] == 2) { return 4; }
    return FAT_PROVEN[value.slot];
}

// Record where a forwardable definition's value is instead of computing
// it. Returns false (and nothing is recorded) when the variable turns out
// to be boxed, a function or unknown here; the definition then runs.
fun fat_forward(ctx: Any, instruction: Any) -> Bool {
    let op: Any = instruction.op;
    let n: Any = instruction.extra;
    mut d: Any = nil;
    if (op == IR_NIL) { d = [0, 0, 0]; }
    else if (op == E_INT) { d = [0, 2, n.value]; }
    else if (op == E_FLOAT) { d = [1, float_literal_bits(str(symbol_name(n.span.source + n.start, n.length)))]; }
    else if (op == E_STR) { d = [2, fat_key(ctx, n.span.source, n.start, n.length)]; }
    else if (op == E_STRB) { d = [2, fat_key_text(ctx, n.address, n.length)]; }
    else if (op == E_VAR) {
        let p: Any = n.name; let l: Any = n.length;
        if (name_eq(p, l, addr("nil"), 3) == 1) { d = [0, 0, 0]; }
        else if (name_eq(p, l, addr("true"), 4) == 1) { d = [0, 1, 1]; }
        else if (name_eq(p, l, addr("false"), 5) == 1) { d = [0, 1, 0]; }
        else if (FAT_FORWARDABLE[instruction.result.slot] == 2 and name_eq(p, l, addr("err"), 3) != 1) {
            let li: Any = loc_find(ctx, p, l);
            if (li >= 0) { if (is_boxed(ctx, p, l) != 1) { d = [3, fat_local_slot(ctx, li)]; } }
            else {
                let gi: Any = glob_find(ctx, p, l);
                if (gi >= 0) { d = [4, glob_off(ctx, gi)]; }
            }
        }
    }
    if (d == nil) { return false; }
    FAT_FORWARD[instruction.result.slot] = d;
    return true;
}

// Load `value` into registers `t` and `p` (not RDX/RAX).
fun fat_get_into(ctx: Any, value: Any, t: Any, p: Any) -> Any {
    let d: Any = FAT_FORWARD[value.slot];
    if (d != nil) { return fat_materialize(ctx, d, t, p); }
    fat_get(ctx, value);
    x86_move_register(ctx, t, 2); x86_move_register(ctx, p, 0);
    return 0;
}

// A temporary read only here, right after its one definition, needs no store.
fun fat_get(ctx: Any, value: Any) -> Any {
    let d: Any = FAT_FORWARD[value.slot];
    if (d != nil) { return fat_materialize(ctx, d, 2, 0); }
    let xmm: Any = FAT_XMM[value.slot];
    if (xmm >= 0) { fat_movq_from_xmm(ctx, 0, xmm); x86_mov_immediate(ctx, 2, 3); fat_forget(); return 0; }
    let k: Any = FAT_SLOTS[value.slot];
    let interval: Any = FAT_INTERVALS[value.slot];
    if (k == FAT_HELD_SLOT and ctx.code.length == FAT_HELD_AT and interval.uses == 1 and interval.definitions == 1) {
        ctx.code.length = FAT_HELD_START;
        fat_forget();
        return 0;
    }
    return fat_load_slot(ctx, k);
}
fun fat_put(ctx: Any, value: Any) -> Any { return fat_store_slot(ctx, FAT_SLOTS[value.slot]); }

fun fat_set(ctx: Any, tag: Any, payload: Any) -> Any {
    x86_mov_immediate(ctx, 2, tag); x86_mov_immediate(ctx, 0, payload);
    return 0;
}

// mov reg, [disp32] / mov [disp32], reg for data offsets (rax 4, rdx 20).
fun fat_abs(ctx: Any, opcode: Any, modrm: Any, off: Any) -> Any {
    e8(ctx, 72); e8(ctx, opcode); e8(ctx, modrm); e8(ctx, 37);
    let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 2, o, off);
    return 0;
}
fun fat_abs_load(ctx: Any, off: Any) -> Any { fat_abs(ctx, 139, 20, off); fat_abs(ctx, 139, 4, off + 8); return 0; }
fun fat_abs_store(ctx: Any, off: Any) -> Any { fat_abs(ctx, 137, 20, off); fat_abs(ctx, 137, 4, off + 8); return 0; }

fun fat_push(ctx: Any) -> Any { e8(ctx, 82); e8(ctx, 80); return 0; }   // push rdx; push rax

fun fat_global(ctx: Any, name: Any) -> Any {
    let index: Any = glob_find(ctx, addr(name), len(name));
    if (index < 0) { die_str("mayc: runtime/fat.may lacks ${name}\n"); }
    return glob_off(ctx, index);
}

// add rsp, bytes (modrm 196) or sub rsp, bytes (modrm 236).
fun fat_rsp(ctx: Any, modrm: Any, bytes: Any) -> Any {
    if (bytes <= 0) { return 0; }
    if (bytes < 128) { e8(ctx, 72); e8(ctx, 131); e8(ctx, modrm); e8(ctx, bytes); }
    else { e8(ctx, 72); e8(ctx, 129); e8(ctx, modrm); e32(ctx, bytes); }
    return 0;
}

fun fat_release(ctx: Any, bytes: Any) -> Any { return fat_rsp(ctx, 196, bytes); }

// Call a raw runtime function whose `words` arguments are already pushed.
// Its trampoline returns the RTAG global in RDX (x86_call_trampoline).
fun fat_rt_call(ctx: Any, name: Any, words: Any) -> Any {
    let rec: Any = backend_find_func(ctx, addr(name), len(name));
    if (rec == 0) { die_str("mayc: --values fat runtime lacks `${name}`\n"); }
    if (rec.native == true) { die_str("mayc: --values fat runtime function `${name}` must not be native\n"); }
    fat_call_begin(ctx); call(ctx, rec.lab); fat_call_end(ctx);
    fat_release(ctx, words * 8);
    return 0;
}

// Slow paths shared by every site: [runtime name, operator or -1, label].
// A site calls the stub with its operands in R9/R8 (left) and RDX/RAX.
mut FAT_STUBS: Any = [];

fun fat_stub_label(ctx: Any, name: Any, op: Any) -> Any {
    for stub: Any in FAT_STUBS { if (stub[0] == name and stub[1] == op) { return stub[2]; } }
    let label: Any = newlab(ctx);
    push(FAT_STUBS, [name, op, label]);
    return label;
}

fun fat_stub_call(ctx: Any, name: Any, op: Any) -> Any {
    let label: Any = fat_stub_label(ctx, name, op);
    fat_call_begin(ctx);
    e8(ctx, 232); let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 0, o, label);
    fat_call_end(ctx);
    return 0;
}

// Emit the stubs that sites referenced, after the functions. The runtime
// functions they call join the reachability queue, so the caller drains it
// again. Returns how many stubs were emitted.
mut FAT_STUBS_EMITTED: Any = 0;
fun fat_emit_stubs(ctx: Any) -> Any {
    let start: Any = FAT_STUBS_EMITTED;
    while (FAT_STUBS_EMITTED < len(FAT_STUBS)) {
        let stub: Any = FAT_STUBS[FAT_STUBS_EMITTED]; FAT_STUBS_EMITTED += 1;
        placelab(ctx, stub[2]);
        if (stub[0] == "float") {
            // Not Float operands leave through the operator's rt_binary stub.
            fat_float_binary(ctx, stub[1], fat_stub_label(ctx, "rt_binary", stub[1]));
            continue;
        }
        mut extra: Any = 0;
        if (stub[1] >= 0) { e8(ctx, 106); e8(ctx, 2); e8(ctx, 106); e8(ctx, stub[1]); extra = 2; } // push 2; push op
        fat_operands_call(ctx, stub[0], extra);
        e8(ctx, 195);                                                         // ret
    }
    return FAT_STUBS_EMITTED - start;
}

// Call a runtime function on a linked list of IR values.
fun fat_rt(ctx: Any, name: Any, args: Any) -> Any {
    mut count: Any = 0;
    mut arg: Any = args;
    while (arg != 0) { fat_get(ctx, arg); fat_push(ctx); count += 1; arg = arg.next; }
    return fat_rt_call(ctx, name, count * 2);
}

// One data object per distinct literal text, so that struct constructors,
// map literals and field accesses share their key strings (#98). Strings
// are immutable, so sharing is not observable through equality.
mut FAT_KEYS: Any = {};
fun fat_key(ctx: Any, source: Any, start: Any, length: Any) -> Any {
    let text: Any = symbol_name(source + start, length);
    let known: Any = FAT_KEYS[text];
    if (known != nil) { return known; }
    let off: Any = intern_obj(ctx, source, start, length);
    FAT_KEYS[text] = off;
    return off;
}

// Like fat_key, for a synthesized literal whose address is given directly.
// Interning by text makes a match payload's field name the same key object the
// variant constructor wrote (#134 step 4).
fun fat_key_text(ctx: Any, address: Any, length: Any) -> Any {
    let text: Any = symbol_name(address, length);
    let known: Any = FAT_KEYS[text];
    if (known != nil) { return known; }
    let off: Any = intern_obj2(ctx, address, length);
    FAT_KEYS[text] = off;
    return off;
}

// The inline field cache check (#98): with the map's type word in `t` and
// payload in `p` (registers 2/0 or 10/11), leave the cached entry's address
// in RCX, or jump to `miss` unless the value is a map holding the site's
// key object at that entry. Clobbers R8.
fun fat_field_probe(ctx: Any, register: Any, cache: Any, key: Any, miss: Any) -> Any {
    let high: Any = register >= 8;
    let rex: Any = if (high) { 73 } else { 72 };
    let length: Any = if (high) { [77, 139, 3] } else { [76, 139, 0] };
    let entries: Any = if (high) { [73, 3, 75, 16] } else { [72, 3, 72, 16] };
    for byte: Any in [rex, 131, 250, 6] { e8(ctx, byte); }                             // cmp rdx/r10, 6
    jcc(ctx, 133, miss);
    fat_abs(ctx, 139, 12, cache);                                                      // mov rcx, [cache]
    for byte: Any in length { e8(ctx, byte); }                                         // mov r8, [rax/r11]
    for byte: Any in [73, 193, 224, 5, 76, 57, 193] { e8(ctx, byte); }                 // shl r8, 5; cmp rcx, r8
    jcc(ctx, 131, miss);                                                               // jae: past the entries
    for byte: Any in entries { e8(ctx, byte); }                                        // add rcx, [rax/r11 + 16]
    for byte: Any in [72, 131, 57, 4] { e8(ctx, byte); }                               // cmp qword [rcx], 4
    jcc(ctx, 133, miss);
    x86_relocated_immediate(ctx, 8, 1, key);                                           // mov r8, key
    for byte: Any in [76, 57, 65, 8] { e8(ctx, byte); }                                // cmp [rcx + 8], r8
    jcc(ctx, 133, miss);
    return 0;
}

// Push the site's key and cache address as two values.
fun fat_field_operands(ctx: Any, cache: Any, key: Any) -> Any {
    e8(ctx, 106); e8(ctx, 4); x86_relocated_immediate(ctx, 0, 1, key); e8(ctx, 80);      // push 4; push key
    e8(ctx, 106); e8(ctx, 2); x86_relocated_immediate(ctx, 0, 1, cache); e8(ctx, 80);    // push 2; push cache
    return 0;
}

// A record whose entries are still inside its own block has every field at a
// fixed slot (#134): `entries == p + 48` and slot `field - 1` holds the site's
// key object. Leave that entry's address in RCX, or jump to `miss`. A record
// that grew its entries out (a dynamic field write) or was compacted by
// `remove` fails the first or the second check and falls back to the field
// cache, so the fast path never assumes a layout the runtime did not build.
// Clobbers R8; RDX/RAX keep the receiver so a fallback can reuse them.
fun fat_field_slot_check(ctx: Any, key: Any, field: Any, miss: Any) -> Any {
    let disp: Any = 48 + 32 * (field - 1);
    for byte: Any in [72, 131, 250, 6] { e8(ctx, byte); }                             // cmp rdx, 6
    jcc(ctx, 133, miss);
    for byte: Any in [72, 139, 72, 16] { e8(ctx, byte); }                            // mov rcx, [rax + 16]
    for byte: Any in [76, 141, 64, 48] { e8(ctx, byte); }                            // lea r8, [rax + 48]
    for byte: Any in [76, 57, 193] { e8(ctx, byte); }                                // cmp rcx, r8
    jcc(ctx, 133, miss);
    x86_relocated_immediate(ctx, 8, 1, key);                                         // mov r8, key object
    for byte: Any in [76, 57, 128] { e8(ctx, byte); } e32(ctx, disp + 8);            // cmp [rax + disp + 8], r8
    jcc(ctx, 133, miss);
    for byte: Any in [72, 141, 136] { e8(ctx, byte); } e32(ctx, disp);               // lea rcx, [rax + disp]
    return 0;
}

// `object.name` through the site's cache (a writable word reserved by
// ir_field_cache), else rt_field_get. `key` is the site's key object and
// `field` its 1-based fixed slot when the receiver's type is known, else 0.
fun fat_field_get(ctx: Any, object: Any, cache: Any, key: Any, field: Any) -> Any {
    let miss: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_get(ctx, object);
    // A statically known struct field: read the fixed slot without the cache
    // when the record is still in its fixed layout, else use the cache probe.
    if (field > 0 and not NO_OPT) {
        let fallback: Any = newlab(ctx);
        fat_field_slot_check(ctx, key, field, fallback);
        for byte: Any in [72, 139, 81, 16, 72, 139, 65, 24] { e8(ctx, byte); }        // mov rdx, [rcx + 16]; mov rax, [rcx + 24]
        jmp(ctx, done);
        placelab(ctx, fallback);
    }
    fat_field_probe(ctx, 2, cache, key, miss);
    for byte: Any in [72, 139, 81, 16, 72, 139, 65, 24] { e8(ctx, byte); }             // mov rdx, [rcx + 16]; mov rax, [rcx + 24]
    jmp(ctx, done);
    placelab(ctx, miss);
    fat_push(ctx);
    fat_field_operands(ctx, cache, key);
    fat_rt_call(ctx, "rt_field_get", 6);
    placelab(ctx, done);
    return 0;
}

// `object.name = value` through the site's cache, else rt_field_set.
fun fat_field_set(ctx: Any, object: Any, value: Any, cache: Any, source: Any, start: Any, length: Any, field: Any) -> Any {
    let key: Any = fat_key(ctx, source, start, length);
    let miss: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_get(ctx, object);
    // A statically known struct field: write the fixed slot while the record
    // is still in its fixed layout, else use the cache probe.
    if (field > 0 and not NO_OPT) {
        let fallback: Any = newlab(ctx);
        fat_field_slot_check(ctx, key, field, fallback);
        fat_get(ctx, value);
        for byte: Any in [72, 137, 81, 16, 72, 137, 65, 24] { e8(ctx, byte); }        // mov [rcx + 16], rdx; mov [rcx + 24], rax
        jmp(ctx, done);
        placelab(ctx, fallback);
    }
    for byte: Any in [73, 137, 210, 73, 137, 195] { e8(ctx, byte); }                   // mov r10, rdx; mov r11, rax
    fat_field_probe(ctx, 10, cache, key, miss);
    fat_get(ctx, value);
    for byte: Any in [72, 137, 81, 16, 72, 137, 65, 24] { e8(ctx, byte); }             // mov [rcx + 16], rdx; mov [rcx + 24], rax
    jmp(ctx, done);
    placelab(ctx, miss);
    for byte: Any in [65, 82, 65, 83] { e8(ctx, byte); }                               // push r10; push r11
    e8(ctx, 106); e8(ctx, 4); x86_relocated_immediate(ctx, 0, 1, key); e8(ctx, 80);      // push 4; push key
    fat_get(ctx, value); fat_push(ctx);
    e8(ctx, 106); e8(ctx, 2); x86_relocated_immediate(ctx, 0, 1, cache); e8(ctx, 80);    // push 2; push cache
    fat_rt_call(ctx, "rt_field_set", 8);
    placelab(ctx, done);
    return 0;
}

// The literal string `text` as a value in RDX/RAX.
fun fat_literal(ctx: Any, off: Any) -> Any {
    x86_mov_immediate(ctx, 2, 4); x86_relocated_immediate(ctx, 0, 1, off);
    return 0;
}

// Jump to `label` when RDX/RAX is falsy (nil or false), or truthy.
fun fat_branch(ctx: Any, label: Any, truthy: Any) -> Any {
    let skip: Any = newlab(ctx);
    e8(ctx, 72); e8(ctx, 133); e8(ctx, 210);                        // test rdx, rdx
    jcc(ctx, 132, if (truthy) { skip } else { label });
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 250); e8(ctx, 1);            // cmp rdx, 1
    jcc(ctx, 133, if (truthy) { label } else { skip });
    e8(ctx, 72); e8(ctx, 133); e8(ctx, 192);                        // test rax, rax
    jcc(ctx, if (truthy) { 133 } else { 132 }, label);
    placelab(ctx, skip);
    return 0;
}

// Cell pointer in RCX: load or store its value.
fun fat_cell_load(ctx: Any) -> Any {
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 17);                         // mov rdx, [rcx]
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 65); e8(ctx, 8);             // mov rax, [rcx + 8]
    return 0;
}
fun fat_cell_store(ctx: Any) -> Any {
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 17);                         // mov [rcx], rdx
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 65); e8(ctx, 8);             // mov [rcx + 8], rax
    return 0;
}

// RCX = the closure environment (payload of the environment slot).
fun fat_env(ctx: Any) -> Any { x86_load_register(ctx, 1, fat_disp(fat_local_slot(ctx, ctx.envSlot)) - 8); return 0; }

// RCX = environment entry `index`, a cell pointer.
fun fat_env_cell(ctx: Any, index: Any) -> Any {
    fat_env(ctx);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 137); e32(ctx, 8 * index);   // mov rcx, [rcx + disp32]
    return 0;
}

fun fat_var(ctx: Any, n: Any) -> Any {
    let p: Any = n.name; let l: Any = n.length;
    if (name_eq(p, l, addr("nil"), 3) == 1) { return fat_set(ctx, 0, 0); }
    if (name_eq(p, l, addr("true"), 4) == 1) { return fat_set(ctx, 1, 1); }
    if (name_eq(p, l, addr("false"), 5) == 1) { return fat_set(ctx, 1, 0); }
    if (name_eq(p, l, addr("err"), 3) == 1) {
        ld_abs(ctx, fat_global(ctx, "ERRVAL")); x86_mov_immediate(ctx, 2, 6);
        return 0;
    }
    let li: Any = loc_find(ctx, p, l);
    if (li >= 0) {
        fat_load_slot(ctx, fat_local_slot(ctx, li));
        if (is_boxed(ctx, p, l) == 1) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 193); fat_cell_load(ctx); } // mov rcx, rax
        return 0;
    }
    let gi: Any = glob_find(ctx, p, l);
    if (gi >= 0) { return fat_abs_load(ctx, glob_off(ctx, gi)); }
    let fr: Any = backend_find_func(ctx, p, l);
    if (fr != 0 and fr.mode != 1) { return fat_function_value(ctx, fr.lab, false, fr.pc); }
    die_str("mayc: unknown variable `${symbol_name(p, l)}`\n");
    return 0;
}

// A closure over code `label`; RCX holds the environment when `env` is true.
fun fat_function_value(ctx: Any, label: Any, env: Bool, arity: Any) -> Any {
    x86_relocated_immediate(ctx, 0, 6, label); e8(ctx, 80);         // push code
    if (env) { e8(ctx, 81); } else { xor_eax(ctx); e8(ctx, 80); }  // push rcx / push 0
    mov_imm(ctx, arity); e8(ctx, 80);
    fat_call_begin(ctx); call_rt0(ctx, addr("rt_closure3"), len("rt_closure3")); fat_call_end(ctx);
    fat_release(ctx, 24);
    x86_mov_immediate(ctx, 2, 7);
    return 0;
}

fun fat_closure(ctx: Any, n: Any) -> Any {
    mut count: Any = 0;
    mut capture: Any = n.captures;
    while (capture != 0) { count += 1; capture = capture.next; }
    if (count == 0) { return fat_function_value(ctx, n.label, false, n.arity); }
    mov_imm(ctx, count); fat_call_begin(ctx); call_rt1(ctx, addr("rt_env_new"), len("rt_env_new")); fat_call_end(ctx);
    e8(ctx, 80);                                                     // push env
    capture = n.captures;
    mut index: Any = 0;
    while (capture != 0) {
        mut found: Any = -1;
        for i: Any in 0..ctx.envCount {
            let c: Any = ctx.envCaptures[i];
            if (found < 0 and name_eq(capture.name, capture.length, c[0], c[1]) == 1) { found = i; }
        }
        if (found >= 0) { fat_env_cell(ctx, found); e8(ctx, 72); e8(ctx, 137); e8(ctx, 200); } // mov rax, rcx
        else {
            let li: Any = loc_find(ctx, capture.name, capture.length);
            if (li < 0) { die_str("mayc: unknown capture `${symbol_name(capture.name, capture.length)}`\n"); }
            x86_load_register(ctx, 0, fat_disp(fat_local_slot(ctx, li)) - 8);
        }
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 12); e8(ctx, 36);          // mov rcx, [rsp]
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 129); e32(ctx, 8 * index); // mov [rcx + disp32], rax
        capture = capture.next; index += 1;
    }
    e8(ctx, 89);                                                     // pop rcx
    return fat_function_value(ctx, n.label, true, n.arity);
}

// Store argument values at [rsp + 16 i], padding to `size` with nil.
fun fat_store_arguments(ctx: Any, args: Any) -> Any {
    mut index: Any = 0;
    mut arg: Any = args;
    while (arg != 0) {
        fat_get(ctx, arg);
        fat_outgoing(ctx, 2, 16 * index); fat_outgoing(ctx, 0, 16 * index + 8);
        index += 1; arg = arg.next;
    }
    return index;
}

fun fat_count(args: Any) -> Any {
    mut count: Any = 0;
    mut arg: Any = args;
    while (arg != 0) { count += 1; arg = arg.next; }
    return count;
}

// ---------------------------------------------------- direct calls (#132)
//
// A call to a function known at compile time with matching arity passes its
// arguments in registers instead of building the 16-byte argument vector:
// argument 0 in RDX/RAX (the result registers), argument 1 in RDI/RSI and
// argument 2 in R8/R9. A fat function with one to three parameters has one body
// that stores its parameters from those registers; its vector entry, which
// closures and function values use, copies the vector into the registers
// first. A native-word body takes its payloads in the SysV argument registers.
//
// fat_plan_direct_calls marks the callees of such calls before emission, from
// every direct call site in the IR, so a callee emits its register entry
// whenever a call site uses it, regardless of emission order.

let FAT_ARG_PAIRS: Any = [[2, 0], [7, 6], [8, 9]];
let FAT_WORD_ARGUMENTS: Any = [7, 6, 2, 1, 8, 9];

// One out-of-line "expected Int or Bool" fault stub per body.
mut FAT_WORD_FAULT: Any = nil;

// Whether calls to `rec` can use the register convention: a fat body with one
// to three parameters and no closure environment. The vector entry keeps
// working for every other caller.
fun fat_register_callable(rec: Any) -> Bool {
    if (NO_OPT or rec == 0) { return false; }
    if (rec.foreign == true or rec.mode == 1 or rec.native == true or rec.cc != 0) { return false; }
    return rec.pc >= 1 and rec.pc <= 3;
}

// The register entry of `rec`; the first user allocates the label, so a caller
// and the callee agree on it whatever the emission order.
fun fat_register_label(ctx: Any, rec: Any) -> Any {
    if (rec.regLab == nil) { rec.regLab = newlab(ctx); }
    return rec.regLab;
}

// The `expected Int or Bool` fault stub of the body being emitted.
fun fat_word_fault(ctx: Any) -> Any {
    if (FAT_WORD_FAULT == nil) { FAT_WORD_FAULT = newlab(ctx); }
    return FAT_WORD_FAULT;
}

fun fat_cmp_immediate(ctx: Any, register: Any, value: Any) -> Any {
    e8(ctx, if (register >= 8) { 73 } else { 72 }); e8(ctx, 131); e8(ctx, 248 + register % 8); e8(ctx, value);
    return 0;
}

// Mark the callees of direct calls with matching arity that can take their
// arguments in registers. Called once, before any body is emitted.
fun fat_plan_direct_calls(ctx: Any) -> Any {
    if (NO_OPT) { return 0; }
    fat_plan_direct_block(ctx, ctx.mainIR);
    for rec: Any in ctx.functions {
        if (rec.mode == 1 or rec.native == true or rec.foreign == true) { continue; }
        fat_plan_direct_block(ctx, rec.ir);
    }
    return 0;
}

fun fat_plan_direct_block(ctx: Any, block: Any) -> Any {
    if (block == nil or block == 0) { return 0; }
    for instruction: Any in block.code {
        if (instruction.op != E_CALL) { continue; }
        let n: Any = instruction.extra;
        if (n == 0) { continue; }
        let name: Any = symbol_name(n.name, n.length);
        mut callee: Any = ctx.functionIndex[name];
        // `ln` and friends lower to the portable math kernels (fat_builtin).
        if (callee == nil and has(FAT_MATH, name)) { callee = ctx.functionIndex[FAT_MATH[name]]; }
        if (callee == nil or fat_count(n.args) != callee.pc) { continue; }
        if (fat_register_callable(callee)) { callee.regWanted = true; }
        else if (callee.native == true and callee.pc <= 6) { callee.wordWanted = true; }
    }
    return 0;
}

// mov reg, [rsp + displacement], for the vector entry before the prologue.
fun fat_incoming(ctx: Any, register: Any, displacement: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 139);
    e8(ctx, 68 + (register % 8) * 8); e8(ctx, 36); e8(ctx, displacement);
    return 0;
}

// Copy the argument vector at [rsp + 8] into the register convention.
fun fat_arguments_to_registers(ctx: Any, count: Any) -> Any {
    for index: Any in 0..count {
        let pair: Any = FAT_ARG_PAIRS[index];
        fat_incoming(ctx, pair[0], 8 + 16 * index);
        fat_incoming(ctx, pair[1], 16 + 16 * index);
    }
    return 0;
}

// Load arguments right to left, so argument 0 is loaded last and stays in
// RDX/RAX. A load has no effects, so the order is not observable.
fun fat_register_arguments(ctx: Any, args: Any, index: Any) -> Any {
    if (args == 0) { return 0; }
    fat_register_arguments(ctx, args.next, index + 1);
    fat_get(ctx, args);
    if (index > 0) {
        let pair: Any = FAT_ARG_PAIRS[index];
        x86_move_register(ctx, pair[0], 2); x86_move_register(ctx, pair[1], 0);
    }
    return 0;
}

// A direct call to a known fat function: arguments travel in registers, so no
// argument vector is built and the stack pointer is not adjusted.
fun fat_direct_registers(ctx: Any, rec: Any, args: Any) -> Any {
    fat_register_arguments(ctx, args, 0);
    // The register entry is a label created after emission_begin registered the
    // function's own label, so queue the function explicitly.
    emission_reference(ctx, rec.lab);
    fat_call_begin(ctx); call(ctx, fat_register_label(ctx, rec)); fat_call_end(ctx);
    return 0;
}

// Load parameter `index` of a native-word callee: check its type word unless it
// is proven, then move the payload into its SysV argument register.
fun fat_native_argument(ctx: Any, rec: Any, arg: Any, index: Any) -> Any {
    fat_get(ctx, arg);
    let expected: Any = if (rec.nativeKinds[index] == "Bool") { 1 } else { 2 };
    if (fat_known_type(arg) != expected) {
        fat_cmp_immediate(ctx, 2, expected);
        jcc(ctx, 133, fat_word_fault(ctx));
    }
    x86_move_register(ctx, FAT_WORD_ARGUMENTS[index], 0);
    return 0;
}

// `wanted` is an argument index to load, or -1 for every index but 2: RDX is
// both parameter 2's register and the scratch register of a load, so it is
// loaded last.
fun fat_native_arguments(ctx: Any, rec: Any, args: Any, wanted: Any) -> Any {
    mut arg: Any = args; mut index: Any = 0;
    while (arg != 0) {
        if (wanted < 0) { if (index != 2) { fat_native_argument(ctx, rec, arg, index); } }
        else if (index == wanted) { fat_native_argument(ctx, rec, arg, index); }
        index += 1; arg = arg.next;
    }
    return 0;
}

// A direct call to a native-word function: payloads in the argument registers,
// result word tagged here. Its fat entry (rec.lab) stays for closures.
fun fat_direct_native(ctx: Any, rec: Any, args: Any) -> Any {
    fat_native_arguments(ctx, rec, args, -1);
    fat_native_arguments(ctx, rec, args, 2);
    if (rec.nativeLab == 0) { rec.nativeLab = newlab(ctx); }
    emission_reference(ctx, rec.lab);
    fat_call_begin(ctx); call(ctx, rec.nativeLab); fat_call_end(ctx);
    x86_mov_immediate(ctx, 2, if (rec.nativeResult == "Bool") { 1 } else { 2 });
    return 0;
}

// A direct call to a function known at compile time with matching arity:
// arguments in registers where the callee has an entry for that, otherwise the
// argument-vector path (padding, extra arguments) as before.
fun fat_call_known(ctx: Any, rec: Any, args: Any) -> Any {
    if (not NO_OPT and fat_count(args) == rec.pc) {
        if (rec.regWanted == true) { return fat_direct_registers(ctx, rec, args); }
        if (rec.wordWanted == true and rec.native == true and rec.pc <= 6) { return fat_direct_native(ctx, rec, args); }
    }
    return fat_direct(ctx, rec, args);
}

fun fat_direct(ctx: Any, rec: Any, args: Any) -> Any {
    let count: Any = fat_count(args);
    let size: Any = if (count > rec.pc) { count } else { rec.pc };
    fat_rsp(ctx, 236, 16 * size);
    if (count < size) {
        // Missing arguments are nil.
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 231);                                 // mov rdi, rsp
        mov_imm(ctx, 0); x86_mov_immediate(ctx, 1, 2 * size);
        e8(ctx, 243); e8(ctx, 72); e8(ctx, 171);                                 // rep stosq
    }
    fat_store_arguments(ctx, args);
    fat_call_begin(ctx); call(ctx, rec.lab); fat_call_end(ctx);
    fat_release(ctx, 16 * size);
    return 0;
}

// The local holding the callee during fat_apply, followed by the one holding
// its argument area's size in values; one pair per function. Locals never
// shrink within a fat function, so no variable reuses them.
mut FAT_APPLY_LOCAL: Any = -1;

// Apply the closure value in RDX/RAX to `args`, padding to its arity.
fun fat_apply(ctx: Any, args: Any) -> Any {
    let callable: Any = newlab(ctx);
    for byte: Any in [72, 131, 250, 7] { e8(ctx, byte); }                    // cmp rdx, 7 (Closure)
    jcc(ctx, 132, callable);
    fat_push(ctx); fat_rt_call(ctx, "rt_require_callable", 2);              // raises a type fault
    placelab(ctx, callable);
    if (FAT_APPLY_LOCAL < 0) { FAT_APPLY_LOCAL = loc_add(ctx, addr("0cl"), 3); loc_add(ctx, addr("0sz"), 3); }
    let closure: Any = fat_local_slot(ctx, FAT_APPLY_LOCAL);
    let size: Any = closure + 1;
    fat_frame(ctx, 137, 0, fat_disp(closure) - 8);
    let count: Any = fat_count(args);
    let enough: Any = newlab(ctx); let filled: Any = newlab(ctx);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 72); e8(ctx, 16);                     // mov rcx, [rax + 16]
    e8(ctx, 72); e8(ctx, 129); e8(ctx, 249); e32(ctx, count);                // cmp rcx, count
    jcc(ctx, 141, enough);                                                    // jge
    x86_mov_immediate(ctx, 1, count);
    placelab(ctx, enough);
    fat_frame(ctx, 137, 1, fat_disp(size) - 8);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 225); e8(ctx, 4);                     // shl rcx, 4
    e8(ctx, 72); e8(ctx, 41); e8(ctx, 204);                                  // sub rsp, rcx
    // Only parameters beyond the arguments need nil.
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 233); e8(ctx, 4);                     // shr rcx, 4
    e8(ctx, 72); e8(ctx, 129); e8(ctx, 233); e32(ctx, count);                // sub rcx, count
    jcc(ctx, 142, filled);                                                    // jle
    e8(ctx, 72); e8(ctx, 141); e8(ctx, 188); e8(ctx, 36); e32(ctx, 16 * count); // lea rdi, [rsp + 16 count]
    e8(ctx, 72); e8(ctx, 209); e8(ctx, 225);                                 // shl rcx, 1
    xor_eax(ctx); e8(ctx, 243); e8(ctx, 72); e8(ctx, 171);                   // rep stosq
    placelab(ctx, filled);
    fat_store_arguments(ctx, args);
    fat_frame(ctx, 139, 0, fat_disp(closure) - 8);
    e8(ctx, 76); e8(ctx, 139); e8(ctx, 80); e8(ctx, 8);                      // mov r10, [rax + 8]
    fat_call_begin(ctx);
    e8(ctx, 255); e8(ctx, 16);                                               // call [rax]
    fat_call_end(ctx);
    fat_frame(ctx, 139, 1, fat_disp(size) - 8);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 225); e8(ctx, 4);                     // shl rcx, 4
    e8(ctx, 72); e8(ctx, 1); e8(ctx, 204);                                   // add rsp, rcx
    return 0;
}

// Builtins implemented by a runtime function of the same arity.
let FAT_BUILTINS: Any = {"str": "rt_to_str", "str_of": "rt_to_str", "len": "rt_len", "push": "rt_push",
    "pop": "rt_pop", "fail": "rt_fail", "rt_raise": "rt_raise", "map_get": "rt_map_get", "map_set": "rt_map_set",
    "map_has": "rt_has", "has": "rt_has", "map_keys": "rt_keys", "keys": "rt_keys", "map_values": "rt_values",
    "values": "rt_values", "to_map": "rt_to_map", "value_eq": "rt_eq", "value_tag": "rt_value_tag",
    "cmp": "rt_cmp", "char_at": "rt_char_at", "char_from": "rt_char_from", "to_float": "rt_to_f",
    "read_file": "rt_read_file", "write_file": "rt_write_file", "addr": "rt_addr", "cstr": "rt_cstr",
    "sqrt": "rt_sqrt", "floor": "rt_floor", "ceil": "rt_ceil", "trunc": "rt_trunc", "pow": "rt_powf",
    "map": "rt_mapf", "filter": "rt_filter", "reduce": "rt_reduce", "any": "rt_any", "all": "rt_all",
    "args": "rt_args", "env": "rt_env", "file_exists": "rt_file_exists",
    "spawn": "rt_spawn", "yield": "rt_yield", "run": "rt_run", "time": "rt_time", "clock": "rt_clock",
    "sleep": "rt_sleep", "mkdir": "rt_mkdir", "read_dir": "rt_read_dir", "read_stdin": "rt_read_stdin",
    "input": "rt_input", "int_to_str": "rt_int_str", "str_cmp": "rt_str_cmp", "wait": "rt_wait",
    "exec": "rt_exec", "system": "rt_system", "remove": "rt_remove"};

// Transcendentals use the portable binary64 kernels, as the core runtime does.
let FAT_MATH: Any = {"ln": "__math_ln", "log2": "__math_log2", "log10": "__math_log10", "exp": "__math_exp"};

// Raw memory access on Int addresses; loads return full machine words.
let FAT_LOADS: Any = {"load8": [15, 182, 0], "load16": [15, 183, 0], "load32": [139, 0], "load64": [72, 139, 0]};
let FAT_STORES: Any = {"store8": [136, 8], "store16": [102, 137, 8], "store32": [137, 8], "store64": [72, 137, 8]};

// runtime/math.may reads and builds Floats through `addr`, which unboxed
// Floats do not have; these read the payload instead.
fun fat_math_bits(ctx: Any, name: Any, args: Any) -> Any {
    if (name == "__math_bits") {
        fat_get(ctx, args.next);
        e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 32);               // shl rax, 32
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 193);                            // mov rcx, rax
        fat_get(ctx, args);
        e8(ctx, 137); e8(ctx, 192);                                         // mov eax, eax
        e8(ctx, 72); e8(ctx, 9); e8(ctx, 200);                              // or rax, rcx
        x86_mov_immediate(ctx, 2, 3);
        return 0;
    }
    fat_get(ctx, args);
    if (name == "__math_high") { e8(ctx, 72); e8(ctx, 193); e8(ctx, 232); e8(ctx, 32); } // shr rax, 32
    else { e8(ctx, 137); e8(ctx, 192); }                                    // mov eax, eax
    x86_mov_immediate(ctx, 2, 2);
    return 0;
}

// len(list) and len(map) read the header's count inline; strings count code
// points, so they keep the runtime call (#101 phase 3 inline fast paths).
fun fat_len_fast(ctx: Any, args: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx); let counted: Any = newlab(ctx);
    if (args == 0) { return fat_rt(ctx, "rt_len", args); }
    fat_get(ctx, args);
    for byte: Any in [72, 131, 250, 5] { e8(ctx, byte); }                    // cmp rdx, 5
    jcc(ctx, 132, counted);                                                   // je counted
    for byte: Any in [72, 131, 250, 6] { e8(ctx, byte); }                    // cmp rdx, 6
    jcc(ctx, 133, slow);                                                      // jne slow
    placelab(ctx, counted);
    for byte: Any in [72, 139, 0] { e8(ctx, byte); }                         // mov rax, [rax]
    x86_mov_immediate(ctx, 2, 2);
    jmp(ctx, done);
    placelab(ctx, slow);
    for byte: Any in [82, 80] { e8(ctx, byte); }                             // push rdx; push rax
    fat_rt_call(ctx, "rt_len", 2);
    placelab(ctx, done);
    return 0;
}

// push(list, value) with spare capacity stores inline (#101 phase 3). Both
// operands take the stack slots the runtime call would use, so the slow path
// is that call unchanged and no value is read after code is emitted (the
// held-slot trap). A specialized list (kind 1 Int, 2 Float, 3 Bool) stores
// only a value of its declared type; anything else falls back to rt_push,
// which widens the list when a value of another type arrives.
fun fat_push_fast(ctx: Any, args: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx); let stored: Any = newlab(ctx);
    let typed: Any = newlab(ctx); let bytes: Any = newlab(ctx);
    fat_get(ctx, args); fat_push(ctx);                                     // list
    fat_get(ctx, args.next); fat_push(ctx);                                // value
    // [rsp] value payload, [rsp + 8] value type, [rsp + 16] list, [rsp + 24] list type
    for byte: Any in [72, 131, 124, 36, 24, 5] { e8(ctx, byte); }          // cmp qword [rsp + 24], 5
    jcc(ctx, 133, slow);
    for byte: Any in [76, 139, 68, 36, 16] { e8(ctx, byte); }              // mov r8, [rsp + 16]
    for byte: Any in [73, 139, 8] { e8(ctx, byte); }                       // mov rcx, [r8]      len
    for byte: Any in [73, 139, 80, 8] { e8(ctx, byte); }                   // mov rdx, [r8 + 8]  cap
    for byte: Any in [72, 57, 209] { e8(ctx, byte); }                      // cmp rcx, rdx
    jcc(ctx, 131, slow);                                                   // jae: no spare capacity
    for byte: Any in [77, 139, 88, 24] { e8(ctx, byte); }                  // mov r11, [r8 + 24] kind
    for byte: Any in [77, 133, 219] { e8(ctx, byte); }                     // test r11, r11
    jcc(ctx, 133, typed);                                                  // jne typed
    // Fat values: data + len * 16.
    for byte: Any in [77, 139, 80, 16] { e8(ctx, byte); }                  // mov r10, [r8 + 16]
    for byte: Any in [72, 137, 202] { e8(ctx, byte); }                     // mov rdx, rcx
    for byte: Any in [72, 193, 226, 4] { e8(ctx, byte); }                  // shl rdx, 4
    for byte: Any in [73, 1, 210] { e8(ctx, byte); }                       // add r10, rdx
    for byte: Any in [72, 139, 84, 36, 8] { e8(ctx, byte); }               // mov rdx, [rsp + 8]
    for byte: Any in [72, 139, 4, 36] { e8(ctx, byte); }                   // mov rax, [rsp]
    for byte: Any in [73, 137, 18] { e8(ctx, byte); }                      // mov [r10], rdx
    for byte: Any in [73, 137, 66, 8] { e8(ctx, byte); }                   // mov [r10 + 8], rax
    jmp(ctx, stored);
    placelab(ctx, typed);
    for byte: Any in [73, 131, 251, 3] { e8(ctx, byte); }                  // cmp r11, 3
    jcc(ctx, 132, bytes);
    // Int (kind 1) and Float (kind 2): the value type must be kind + 1.
    for byte: Any in [72, 139, 84, 36, 8] { e8(ctx, byte); }               // mov rdx, [rsp + 8]
    for byte: Any in [77, 141, 75, 1] { e8(ctx, byte); }                   // lea r9, [r11 + 1]
    for byte: Any in [76, 57, 202] { e8(ctx, byte); }                      // cmp rdx, r9
    jcc(ctx, 133, slow);
    for byte: Any in [72, 139, 4, 36] { e8(ctx, byte); }                   // mov rax, [rsp]
    for byte: Any in [77, 139, 80, 16] { e8(ctx, byte); }                  // mov r10, [r8 + 16]
    for byte: Any in [72, 137, 202] { e8(ctx, byte); }                     // mov rdx, rcx
    for byte: Any in [72, 193, 226, 3] { e8(ctx, byte); }                  // shl rdx, 3
    for byte: Any in [73, 1, 210] { e8(ctx, byte); }                       // add r10, rdx
    for byte: Any in [73, 137, 2] { e8(ctx, byte); }                       // mov [r10], rax
    jmp(ctx, stored);
    placelab(ctx, bytes);
    // Bool (kind 3): one byte, and only a Bool fits.
    for byte: Any in [72, 131, 124, 36, 8, 1] { e8(ctx, byte); }           // cmp qword [rsp + 8], 1
    jcc(ctx, 133, slow);
    for byte: Any in [72, 139, 4, 36] { e8(ctx, byte); }                   // mov rax, [rsp]
    for byte: Any in [77, 139, 80, 16] { e8(ctx, byte); }                  // mov r10, [r8 + 16]
    for byte: Any in [73, 1, 202] { e8(ctx, byte); }                       // add r10, rcx
    for byte: Any in [65, 136, 2] { e8(ctx, byte); }                       // mov [r10], al
    placelab(ctx, stored);
    for byte: Any in [73, 131, 0, 1] { e8(ctx, byte); }                    // add qword [r8], 1
    for byte: Any in [72, 131, 196, 32] { e8(ctx, byte); }                 // add rsp, 32
    x86_mov_immediate(ctx, 2, 5);
    x86_move_register(ctx, 0, 8);                                          // mov rax, r8
    jmp(ctx, done);
    placelab(ctx, slow);
    fat_rt_call(ctx, "rt_push", 4);
    placelab(ctx, done);
    return 0;
}

fun fat_builtin(ctx: Any, name: Any, args: Any) -> Any {
    if (name == "print") {
        mut arg: Any = args;
        mut first: Any = true;
        while (arg != 0) {
            if (not first) { fat_rt_call(ctx, "rt_space", 0); }
            fat_get(ctx, arg); fat_push(ctx); fat_rt_call(ctx, "rt_print1", 2);
            first = false; arg = arg.next;
        }
        fat_rt_call(ctx, "rt_newline", 0);
        // The tagged backend leaves rt_newline's result, so `print` evaluates to 0.
        return fat_set(ctx, 2, 0);
    }
    if (name == "exit") {
        fat_get(ctx, args);
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 199);                             // mov rdi, rax
        mov_imm(ctx, 60); x86_syscall_instruction(ctx);
        return 0;
    }
    if (name == "syscall") {
        // Number and arguments are Int payloads; the result is an Int.
        let count: Any = fat_count(args);
        let values: Any = [];
        mut arg: Any = args;
        while (arg != 0) { push(values, arg); arg = arg.next; }
        mut index: Any = count - 1;
        while (index >= 0) { fat_get(ctx, values[index]); e8(ctx, 80); index -= 1; }
        let pops: Any = [[88], [95], [94], [90], [65, 90], [65, 88], [65, 89]]; // rax rdi rsi rdx r10 r8 r9
        for i: Any in 0..count { for byte: Any in pops[i] { e8(ctx, byte); } }
        x86_syscall_instruction(ctx);
        x86_mov_immediate(ctx, 2, 2);
        return 0;
    }
    if (name == "__ccall6") {
        // C call through an address; arguments and result are Int payloads.
        let values: Any = [];
        mut arg: Any = args;
        while (arg != 0) { push(values, arg); arg = arg.next; }
        mut index: Any = len(values) - 1;
        while (index >= 0) { fat_get(ctx, values[index]); e8(ctx, 80); index -= 1; }
        let pops: Any = [[65, 91], [95], [94], [90], [89], [65, 88], [65, 89]]; // r11 rdi rsi rdx rcx r8 r9
        for i: Any in 0..len(values) { for byte: Any in pops[i] { e8(ctx, byte); } }
        xor_eax(ctx);
        fat_call_begin(ctx);
        e8(ctx, 65); e8(ctx, 255); e8(ctx, 211);                             // call r11
        fat_call_end(ctx);
        x86_mov_immediate(ctx, 2, 2);
        return 0;
    }
    if (has(FAT_LOADS, name)) {
        fat_get(ctx, args);
        for byte: Any in FAT_LOADS[name] { e8(ctx, byte); }
        x86_mov_immediate(ctx, 2, 2);
        return 0;
    }
    if (has(FAT_STORES, name)) {
        fat_get(ctx, args.next); e8(ctx, 72); e8(ctx, 137); e8(ctx, 193);  // mov rcx, rax
        fat_get(ctx, args);
        for byte: Any in FAT_STORES[name] { e8(ctx, byte); }                  // mov [rax], cl/cx/ecx/rcx
        return fat_set(ctx, 0, 0);
    }
    if (name == "len") { return fat_len_fast(ctx, args); }
    if (name == "push" and not NO_OPT and fat_count(args) == 2) { return fat_push_fast(ctx, args); }
    if (has(FAT_BUILTINS, name)) { return fat_rt(ctx, FAT_BUILTINS[name], args); }
    if (has(FAT_MATH, name)) {
        let kernel: Any = FAT_MATH[name];
        let rec: Any = backend_find_func(ctx, addr(kernel), len(kernel));
        if (rec != 0) { return fat_call_known(ctx, rec, args); }
    }
    die_str("mayc: --values fat does not support `${name}` yet\n");
    return 0;
}

fun fat_call(ctx: Any, n: Any) -> Any {
    let p: Any = n.name; let l: Any = n.length;
    if (loc_find(ctx, p, l) < 0 and glob_find(ctx, p, l) < 0) {
        let name: Any = symbol_name(p, l);
        if (name == "__math_high" or name == "__math_low" or name == "__math_bits") { return fat_math_bits(ctx, name, n.args); }
        // native.may's portable join body, replaced by the runtime's (#99).
        if (name == "__join_list") { return fat_rt(ctx, "rt_join", n.args); }
        let rec: Any = backend_find_func(ctx, p, l);
        if (rec != 0 and rec.mode != 1) { return fat_call_known(ctx, rec, n.args); }
        return fat_builtin(ctx, symbol_name(p, l), n.args);
    }
    fat_var(ctx, n);
    return fat_apply(ctx, n.args);
}

fun fat_operation(ctx: Any, n: Any) -> Any {
    let k: Any = n.kind;
    if (k == E_INT) { return fat_set(ctx, 2, n.value); }
    if (k == E_STR) { return fat_literal(ctx, fat_key(ctx, n.span.source, n.start, n.length)); }
    if (k == E_STRB) { return fat_literal(ctx, fat_key_text(ctx, n.address, n.length)); }
    if (k == E_FLOAT) {
        let bits: Any = float_literal_bits(str(symbol_name(n.span.source + n.start, n.length)));
        e8(ctx, 72); e8(ctx, 184); e32(ctx, bits[0]); e32(ctx, bits[1]);   // movabs rax, bits
        x86_mov_immediate(ctx, 2, 3);
        return 0;
    }
    if (k == E_VAR) { return fat_var(ctx, n); }
    if (k == E_CAPVAR) { fat_env_cell(ctx, n.index); return fat_cell_load(ctx); }
    if (k == E_CLOSURE) { return fat_closure(ctx, n); }
    if (k == E_INDEX) { return fat_index(ctx, n); }
    if (k == E_GET) {
        let address: Any = n.keyAddress;
        mut key: Any = 0;
        if (address != nil and address != 0) { key = fat_key_text(ctx, address, n.keyLength); }
        else { key = fat_key(ctx, n.span.source, n.start, n.length); }
        return fat_field_get(ctx, n.object, n.cache, key, n.field ?? 0);
    }
    if (k == E_ICALL) { fat_get(ctx, n.callee); return fat_apply(ctx, n.args); }
    if (k == E_RANGE) {
        fat_get(ctx, n.start); fat_push(ctx); fat_get(ctx, n.end); fat_push(ctx);
        fat_set(ctx, 1, if (n.inclusive == 1) { 1 } else { 0 }); fat_push(ctx);
        return fat_rt_call(ctx, "rt_range", 6);
    }
    if (k == E_POW) {
        fat_get(ctx, n.left); fat_push(ctx); fat_get(ctx, n.right); fat_push(ctx);
        return fat_rt_call(ctx, "rt_pow", 4);
    }
    if (k == E_BIN) { return fat_binary(ctx, n); }
    if (k == E_UN) {
        fat_set(ctx, 2, n.op); fat_push(ctx); fat_get(ctx, n.operand); fat_push(ctx);
        return fat_rt_call(ctx, "rt_unary", 4);
    }
    if (k == E_CALL) { return fat_call(ctx, n); }
    die_str("mayc: --values fat does not support IR operation ${k}\n");
    return 0;
}

// Load `left` into R9 (type) and R8 (payload) and `right` into RDX/RAX.
// A forwarded left operand loads after the right one, so that a right
// operand computed just before still skips its store (fat_get); loads have
// no effects, so the order is not observable.
fun fat_operands(ctx: Any, left: Any, right: Any) -> Any {
    if (FAT_FORWARD[left.slot] != nil and FAT_FORWARD[right.slot] == nil) {
        fat_get(ctx, right);
        return fat_get_into(ctx, left, 9, 8);
    }
    fat_get_into(ctx, left, 9, 8);
    fat_get(ctx, right);
    return 0;
}

// Fall back to `name`(left, right) with the operands from fat_operands
// (after `extra` already pushed words).
fun fat_operands_call(ctx: Any, name: Any, extra: Any) -> Any {
    for byte: Any in [65, 81, 65, 80, 82, 80] { e8(ctx, byte); }             // push r9; push r8; push rdx; push rax
    return fat_rt_call(ctx, name, extra + 4);
}

// Int arithmetic, bitwise operators and comparisons run inline, as do Float
// arithmetic and comparisons; mixed types, overflow and division by zero (to
// raise the runtime's fault) and other operators call rt_binary.
let FAT_INLINE_ARITH: Any = {"20": [73, 1, 194], "21": [73, 41, 194], "22": [76, 15, 175, 208],
    "64": [73, 33, 194], "45": [73, 9, 194], "63": [73, 49, 194]};
let FAT_INLINE_COMPARE: Any = {"25": 148, "26": 149, "27": 156, "28": 158, "29": 159, "30": 157};

// The body of a "float" stub: Float + - * / and comparisons on two Float
// operands (fat_operands), as rt_binary computes them: IEEE results,
// ordering and == false for NaN. Other operands and a zero divisor (either
// sign, for the arithmetic fault) jump to `slow`, which returns for the stub.
fun fat_float_binary(ctx: Any, op: Any, slow: Any) -> Any {
    for byte: Any in [73, 131, 249, 3] { e8(ctx, byte); }                    // cmp r9, 3
    jcc(ctx, 133, slow);
    for byte: Any in [72, 131, 250, 3] { e8(ctx, byte); }                    // cmp rdx, 3
    jcc(ctx, 133, slow);
    if (op == TK_SLASH) {
        for byte: Any in [76, 141, 20, 0, 77, 133, 210] { e8(ctx, byte); }   // lea r10, [rax + rax]; test r10, r10
        jcc(ctx, 132, slow);                                                  // je: +0.0 or -0.0
    }
    for byte: Any in [102, 73, 15, 110, 192, 102, 72, 15, 110, 200] { e8(ctx, byte); } // movq xmm0, r8; movq xmm1, rax
    if (op >= TK_PLUS and op <= TK_SLASH) {
        for byte: Any in [242, 15, [88, 92, 89, 94][op - TK_PLUS], 193] { e8(ctx, byte); } // addsd/subsd/mulsd/divsd xmm0, xmm1
        for byte: Any in [102, 72, 15, 126, 192] { e8(ctx, byte); }         // movq rax, xmm0
        x86_mov_immediate(ctx, 2, 3);
    } else {
        // ucomisd orders the operands so that only seta/setae are needed.
        let swapped: Any = op == TK_LT or op == TK_LE;
        for byte: Any in [102, 15, 46, if (swapped) { 200 } else { 193 }] { e8(ctx, byte); }
        if (op == TK_EQ) { for byte: Any in [15, 148, 192, 15, 155, 193, 32, 200] { e8(ctx, byte); } }       // sete; setnp; and
        else if (op == TK_NE) { for byte: Any in [15, 149, 192, 15, 154, 193, 8, 200] { e8(ctx, byte); } } // setne; setp; or
        else if (op == TK_LT or op == TK_GT) { for byte: Any in [15, 151, 192] { e8(ctx, byte); } }          // seta
        else { for byte: Any in [15, 147, 192] { e8(ctx, byte); } }                                          // setae
        for byte: Any in [15, 182, 192] { e8(ctx, byte); }                   // movzx eax, al
        x86_mov_immediate(ctx, 2, 1);
    }
    e8(ctx, 195);                                                             // ret
    return 0;
}

// Jump to `notInt` unless both operands (fat_operands) are Ints; a
// forwarded Int constant needs no check.
fun fat_int_checks(ctx: Any, n: Any, notInt: Any) -> Any {
    if (fat_known_type(n.left) != 2) {
        for byte: Any in [73, 131, 249, 2] { e8(ctx, byte); }                // cmp r9, 2
        jcc(ctx, 133, notInt);
    }
    if (fat_known_type(n.right) != 2) {
        for byte: Any in [72, 131, 250, 2] { e8(ctx, byte); }                // cmp rdx, 2
        jcc(ctx, 133, notInt);
    }
    return 0;
}

// The slow paths deferred by fat_binary and fat_branch_compare.
fun fat_emit_deferred(ctx: Any) -> Any {
    for item: Any in FAT_DEFERRED {
        if (item[0] == "binary") {
            for index: Any in [1, 2] {
                if (item[index] >= 0) {
                    placelab(ctx, item[index]);
                    if (item[5] != nil) { fat_materialize(ctx, item[5], 2, 0); }
                    fat_stub_call(ctx, if (index == 1) { "float" } else { "rt_binary" }, item[3]); jmp(ctx, item[4]);
                }
            }
        } else {
            placelab(ctx, item[1]);
            if (item[6] != nil) { fat_materialize(ctx, item[6], 2, 0); }
            fat_stub_call(ctx, "float", item[2]);
            fat_branch(ctx, item[3], item[4]); jmp(ctx, item[5]);
        }
    }
    FAT_DEFERRED = [];
    return 0;
}

// The value of a forwarded Int constant that fits a sign-extended imm32,
// or nil.
fun fat_imm32(value: Any) -> Any {
    let d: Any = FAT_FORWARD[value.slot];
    if (d == nil or d[0] != 0 or d[1] != 2 or d[2] < -2147483648 or d[2] > 2147483647) { return nil; }
    return d[2];
}

// ALU operation /digit on `register` with an immediate (83 ib or 81 id).
fun fat_alu_immediate(ctx: Any, digit: Any, register: Any, value: Any) -> Any {
    e8(ctx, if (register >= 8) { 73 } else { 72 });
    if (value >= -128 and value <= 127) { e8(ctx, 131); e8(ctx, 192 + digit * 8 + register % 8); e8(ctx, (value + 256) % 256); }
    else { e8(ctx, 129); e8(ctx, 192 + digit * 8 + register % 8); e32(ctx, value); }
    return 0;
}

// Load the left operand into R9/R8 and jump to `notInt` unless it is an Int,
// for a right operand used as an immediate.
fun fat_left_int(ctx: Any, n: Any, notInt: Any) -> Any {
    fat_get_into(ctx, n.left, 9, 8);
    if (fat_known_type(n.left) != 2) {
        for byte: Any in [73, 131, 249, 2] { e8(ctx, byte); }                // cmp r9, 2
        jcc(ctx, 133, notInt);
    }
    return 0;
}

// The power of two that Int constant `value` is (2 to 2^31), or 0.
fun fat_power_of_two(value: Any) -> Any {
    if (value == nil or value < 2) { return 0; }
    mut k: Any = 1; mut power: Any = 2;
    while (power < value and k < 31) { power = power * 2; k += 1; }
    return if (power == value) { k } else { 0 };
}

// `left op c` for an Int constant right operand `c` that fits an imm32:
// comparisons, + - * and / % by a power of two use it as an immediate.
// Returns false, emitting nothing, for other operators and constants.
fun fat_binary_immediate(ctx: Any, n: Any) -> Bool {
    let value: Any = fat_imm32(n.right);
    if (value == nil) { return false; }
    let op: Any = n.op;
    let key: Any = str(op);
    let shift: Any = if (op == TK_SLASH or op == TK_PCT) { fat_power_of_two(value) } else { 0 };
    if (not has(FAT_INLINE_COMPARE, key) and op != TK_PLUS and op != TK_MINUS and op != TK_STAR and shift == 0) { return false; }
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    // A proven Int needs no type check, so neither path for other types.
    let checked: Any = fat_known_type(n.left) != 2;
    let floats: Any = checked and op != TK_PCT;
    let notInt: Any = if (floats) { newlab(ctx) } else { slow };
    mut slowUsed: Any = checked and not floats;
    fat_left_int(ctx, n, notInt);
    if (has(FAT_INLINE_COMPARE, key)) {
        fat_alu_immediate(ctx, 7, 8, value);                                   // cmp r8, c
        for byte: Any in [15, FAT_INLINE_COMPARE[key], 192, 15, 182, 192] { e8(ctx, byte); } // setcc al; movzx eax, al
        x86_mov_immediate(ctx, 2, 1);
    } else if (shift > 0) {
        // Truncating division: add 2^k - 1 to a negative dividend first.
        for byte: Any in [76, 137, 192, 76, 137, 193, 72, 193, 249, 63, 72, 193, 233, 64 - shift, 72, 1, 200] { e8(ctx, byte); } // mov rax, r8; mov rcx, r8; sar rcx, 63; shr rcx, 64-k; add rax, rcx
        if (op == TK_SLASH) { for byte: Any in [72, 193, 248, shift] { e8(ctx, byte); } }        // sar rax, k
        else {
            fat_alu_immediate(ctx, 4, 0, 0 - value);                          // and rax, -2^k
            for byte: Any in [76, 137, 193, 72, 41, 193, 72, 137, 200] { e8(ctx, byte); }       // mov rcx, r8; sub rcx, rax; mov rax, rcx
        }
        x86_mov_immediate(ctx, 2, 2);
    } else {
        if (op == TK_STAR) {
            // imul r10, r8, c (6B ib or 69 id)
            if (value >= -128 and value <= 127) { for byte: Any in [77, 107, 208, (value + 256) % 256] { e8(ctx, byte); } }
            else { for byte: Any in [77, 105, 208] { e8(ctx, byte); } e32(ctx, value); }
        } else {
            for byte: Any in [77, 137, 194] { e8(ctx, byte); }                // mov r10, r8
            fat_alu_immediate(ctx, if (op == TK_PLUS) { 0 } else { 5 }, 10, value); // add/sub r10, c
        }
        jcc(ctx, 128, slow); slowUsed = true;                                  // jo
        for byte: Any in [76, 137, 208] { e8(ctx, byte); }                    // mov rax, r10
        x86_mov_immediate(ctx, 2, 2);
    }
    placelab(ctx, done);
    push(FAT_DEFERRED, ["binary", if (floats) { notInt } else { -1 }, if (slowUsed) { slow } else { -1 }, op, done, FAT_FORWARD[n.right.slot]]);
    return true;
}

// `left op right` steering a branch (IR_TRUE when `truthy`, else IR_FALSE)
// whose condition is used nowhere else: Ints compare and jump directly;
// other operands take the operator's float stub (which falls back to
// rt_binary) and branch on the Bool it returns, out of line.
fun fat_branch_compare(ctx: Any, n: Any, label: Any, truthy: Any) -> Any {
    if (fat_xmm_operation(n)) {
        // Two proven Floats: compare in XMM registers, with no slow path.
        let left: Any = fat_xmm_operand(ctx, n.left, 0);
        let right: Any = fat_xmm_operand(ctx, n.right, 1);
        fat_xmm_compare(ctx, n.op, left, right);
        fat_float_jump(ctx, n.op, label, truthy);
        fat_forget();
        return 0;
    }
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    let jump: Any = FAT_INLINE_COMPARE[str(n.op)] - 16;                      // setcc -> jcc
    let condition: Any = if (truthy) { jump } else if (jump % 2 == 0) { jump + 1 } else { jump - 1 };
    let value: Any = fat_imm32(n.right);
    if (value != nil) {
        fat_left_int(ctx, n, slow);
        fat_alu_immediate(ctx, 7, 8, value);                                   // cmp r8, c
        jcc(ctx, condition, label);
        placelab(ctx, done);
        push(FAT_DEFERRED, ["branch", slow, n.op, label, truthy, done, FAT_FORWARD[n.right.slot]]);
        return 0;
    }
    fat_operands(ctx, n.left, n.right);
    if (fat_float_hint(n)) {
        fat_float_operands(ctx, n, slow);
        fat_float_compare(ctx, n.op);
        fat_float_jump(ctx, n.op, label, truthy);
        placelab(ctx, done);
        push(FAT_DEFERRED, ["branch", slow, n.op, label, truthy, done, nil]);
        return 0;
    }
    fat_int_checks(ctx, n, slow);
    for byte: Any in [73, 57, 192] { e8(ctx, byte); }                        // cmp r8, rax
    jcc(ctx, condition, label);
    placelab(ctx, done);
    push(FAT_DEFERRED, ["branch", slow, n.op, label, truthy, done, nil]);
    return 0;
}

// True when an operand is statically a Float (its checked type, or a Float
// constant). Only a hint for code layout: the type words are still checked.
fun fat_float_value(value: Any) -> Bool {
    if (fat_known_type(value) == 3) { return true; }
    let t: Any = value.valueType;
    return t != nil and t != 0 and t.name == "Float";
}

fun fat_float_hint(n: Any) -> Bool { return fat_float_value(n.left) or fat_float_value(n.right); }

// Jump to `slow` unless both operands are Floats, and for `/` unless the
// divisor is nonzero (either sign: the runtime raises the fault); then
// move the payloads into XMM0 (left) and XMM1.
fun fat_float_operands(ctx: Any, n: Any, slow: Any) -> Any {
    if (fat_known_type(n.left) != 3) {
        for byte: Any in [73, 131, 249, 3] { e8(ctx, byte); }                // cmp r9, 3
        jcc(ctx, 133, slow);
    }
    if (fat_known_type(n.right) != 3) {
        for byte: Any in [72, 131, 250, 3] { e8(ctx, byte); }                // cmp rdx, 3
        jcc(ctx, 133, slow);
    }
    if (n.op == TK_SLASH) {
        for byte: Any in [76, 141, 20, 0, 77, 133, 210] { e8(ctx, byte); }   // lea r10, [rax + rax]; test r10, r10
        jcc(ctx, 132, slow);                                                  // je: +0.0 or -0.0
    }
    for byte: Any in [102, 73, 15, 110, 192, 102, 72, 15, 110, 200] { e8(ctx, byte); } // movq xmm0, r8; movq xmm1, rax
    return 0;
}

// ucomisd for comparison `op`, with the operands swapped for < and <= so
// that "above" means the comparison holds.
fun fat_float_compare(ctx: Any, op: Any) -> Any {
    let swapped: Any = op == TK_LT or op == TK_LE;
    for byte: Any in [102, 15, 46, if (swapped) { 200 } else { 193 }] { e8(ctx, byte); }
    return 0;
}

// Float arithmetic or comparison inline, for operands hinted Float; any
// other operands, and a zero divisor, call rt_binary out of line.
fun fat_float_inline(ctx: Any, n: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_operands(ctx, n.left, n.right);
    fat_float_operands(ctx, n, slow);
    let op: Any = n.op;
    if (op >= TK_PLUS and op <= TK_SLASH) {
        for byte: Any in [242, 15, [88, 92, 89, 94][op - TK_PLUS], 193] { e8(ctx, byte); } // addsd/subsd/mulsd/divsd xmm0, xmm1
        for byte: Any in [102, 72, 15, 126, 192] { e8(ctx, byte); }         // movq rax, xmm0
        x86_mov_immediate(ctx, 2, 3);
    } else {
        fat_float_compare(ctx, op);
        if (op == TK_EQ) { for byte: Any in [15, 148, 192, 15, 155, 193, 32, 200] { e8(ctx, byte); } }       // sete; setnp; and
        else if (op == TK_NE) { for byte: Any in [15, 149, 192, 15, 154, 193, 8, 200] { e8(ctx, byte); } } // setne; setp; or
        else if (op == TK_LT or op == TK_GT) { for byte: Any in [15, 151, 192] { e8(ctx, byte); } }          // seta
        else { for byte: Any in [15, 147, 192] { e8(ctx, byte); } }                                          // setae
        for byte: Any in [15, 182, 192] { e8(ctx, byte); }                   // movzx eax, al
        x86_mov_immediate(ctx, 2, 1);
    }
    placelab(ctx, done);
    push(FAT_DEFERRED, ["binary", -1, slow, op, done, nil]);
    return 0;
}

// Jump to `label` when Float comparison `op` (flags from fat_float_compare)
// is `truthy`. NaN compares unordered: only != holds.
fun fat_float_jump(ctx: Any, op: Any, label: Any, truthy: Any) -> Any {
    if (op == TK_EQ or op == TK_NE) {
        if ((op == TK_EQ) == truthy) {
            let skip: Any = newlab(ctx);
            jcc(ctx, 138, skip); jcc(ctx, 132, label); placelab(ctx, skip);  // jp skip; je label
        } else { jcc(ctx, 138, label); jcc(ctx, 133, label); }              // jp label; jne label
        return 0;
    }
    let strict: Any = op == TK_LT or op == TK_GT;
    if (truthy) { jcc(ctx, if (strict) { 135 } else { 131 }, label); }      // ja / jae
    else { jcc(ctx, if (strict) { 134 } else { 130 }, label); }             // jbe / jb
    return 0;
}

// Two Str operands of different byte lengths are unequal, so `==`/`!=` answers
// without entering rt_eq (which compares content). Registers hold the operands
// as fat_operands left them; other operand types fall through to `other`.
fun fat_str_length_shortcut(ctx: Any, n: Any, done: Any) -> Any {
    let other: Any = newlab(ctx);
    for byte: Any in [73, 131, 249, 4] { e8(ctx, byte); }                    // cmp r9, 4
    jcc(ctx, 133, other);
    for byte: Any in [72, 131, 250, 4] { e8(ctx, byte); }                    // cmp rdx, 4
    jcc(ctx, 133, other);
    for byte: Any in [77, 139, 16] { e8(ctx, byte); }                        // mov r10, [r8]   byte length
    for byte: Any in [76, 139, 24] { e8(ctx, byte); }                        // mov r11, [rax]
    for byte: Any in [77, 57, 218] { e8(ctx, byte); }                        // cmp r10, r11
    jcc(ctx, 132, other);                                                     // je: same length
    x86_mov_immediate(ctx, 0, if (n.op == TK_NE) { 1 } else { 0 });
    x86_mov_immediate(ctx, 2, 1);
    jmp(ctx, done);
    placelab(ctx, other);
    return 0;
}

fun fat_binary(ctx: Any, n: Any) -> Any {
    let key: Any = str(n.op);
    if (fat_float_hint(n) and ((n.op >= TK_PLUS and n.op <= TK_SLASH) or has(FAT_INLINE_COMPARE, key))) { return fat_float_inline(ctx, n); }
    if (fat_binary_immediate(ctx, n)) { return 0; }
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    let checked: Any = fat_known_type(n.left) != 2 or fat_known_type(n.right) != 2;
    let floats: Any = checked and ((n.op >= TK_PLUS and n.op <= TK_SLASH) or has(FAT_INLINE_COMPARE, key));
    let notInt: Any = if (floats) { newlab(ctx) } else { slow };
    // Whether any jump reaches `slow` (overflow, a divisor of 0 or -1, or
    // operands that are not Ints when there is no Float path).
    mut slowUsed: Any = checked and not floats;
    fat_operands(ctx, n.left, n.right);
    if ((n.op == TK_EQ or n.op == TK_NE) and not NO_OPT) { fat_str_length_shortcut(ctx, n, done); }
    if (has(FAT_INLINE_ARITH, key) or has(FAT_INLINE_COMPARE, key)) {
        fat_int_checks(ctx, n, notInt);
        if (has(FAT_INLINE_ARITH, key)) {
            for byte: Any in [77, 137, 194] { e8(ctx, byte); }                // mov r10, r8
            for byte: Any in FAT_INLINE_ARITH[key] { e8(ctx, byte); }         // op r10, rax
            if (n.op == TK_PLUS or n.op == TK_MINUS or n.op == TK_STAR) { jcc(ctx, 128, slow); slowUsed = true; } // jo
            for byte: Any in [76, 137, 208] { e8(ctx, byte); }                // mov rax, r10
        } else {
            for byte: Any in [73, 57, 192, 15, FAT_INLINE_COMPARE[key], 192, 15, 182, 192] { e8(ctx, byte); } // cmp r8, rax; setcc; movzx
            x86_mov_immediate(ctx, 2, 1);
        }
    } else if (n.op == TK_SLASH or n.op == TK_PCT) {
        // idiv truncates toward zero and leaves the dividend's sign on the
        // remainder, as Maylang's / and % do. Divisors 0 and -1 (division by
        // zero, and the -2^63 / -1 overflow) take the runtime's path.
        fat_int_checks(ctx, n, notInt);
        for byte: Any in [72, 137, 193] { e8(ctx, byte); }                   // mov rcx, rax
        let divisor: Any = FAT_FORWARD[n.right.slot];
        if (divisor == nil or divisor[0] != 0 or divisor[1] != 2 or divisor[2] == 0 or divisor[2] == -1) {
            for byte: Any in [76, 141, 81, 1, 73, 131, 250, 1] { e8(ctx, byte); } // lea r10, [rcx + 1]; cmp r10, 1
            jcc(ctx, 134, slow);                                              // jbe: divisor 0 or -1
            slowUsed = true;
        }
        for byte: Any in [76, 137, 192, 72, 153, 72, 247, 249] { e8(ctx, byte); } // mov rax, r8; cqo; idiv rcx
        if (n.op == TK_PCT) { for byte: Any in [72, 137, 208] { e8(ctx, byte); } } // mov rax, rdx
        x86_mov_immediate(ctx, 2, 2);
    } else {
        // No inline form: every operand takes the runtime's path.
        fat_stub_call(ctx, "rt_binary", n.op);
        return 0;
    }
    placelab(ctx, done);
    push(FAT_DEFERRED, ["binary", if (floats) { notInt } else { -1 }, if (slowUsed) { slow } else { -1 }, n.op, done, nil]);
    return 0;
}

// List elements in range load inline; everything else calls rt_index_get.
// `object[index] = value`: a List with an in-range Int index is stored
// inline (#99); anything else calls rt_index_set, which also reports errors.
fun fat_index_set(ctx: Any, n: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    fat_get(ctx, n.object);
    for byte: Any in [73, 137, 210, 73, 137, 195] { e8(ctx, byte); }         // mov r10, rdx; mov r11, rax
    fat_get(ctx, n.index);
    for byte: Any in [73, 131, 250, 5] { e8(ctx, byte); }                    // cmp r10, 5
    jcc(ctx, 133, slow);
    for byte: Any in [72, 131, 250, 2] { e8(ctx, byte); }                    // cmp rdx, 2
    jcc(ctx, 133, slow);
    for byte: Any in [73, 139, 11, 72, 57, 200] { e8(ctx, byte); }           // mov rcx, [r11]; cmp rax, rcx
    jcc(ctx, 131, slow);                                                      // jae (also negative)
    // A specialized list stores elements elsewhere; the runtime converts or
    // widens as its kind asks (#101 phase 2).
    for byte: Any in [73, 131, 123, 24, 0] { e8(ctx, byte); }                // cmp qword [r11 + 24], 0
    jcc(ctx, 133, slow);                                                      // jne slow
    for byte: Any in [73, 139, 75, 16, 72, 193, 224, 4, 72, 1, 193] { e8(ctx, byte); } // mov rcx, [r11 + 16]; shl rax, 4; add rcx, rax
    fat_get(ctx, n.value);
    for byte: Any in [72, 137, 17, 72, 137, 65, 8] { e8(ctx, byte); }        // mov [rcx], rdx; mov [rcx + 8], rax
    jmp(ctx, done);
    placelab(ctx, slow);
    for byte: Any in [65, 82, 65, 83] { e8(ctx, byte); }                     // push r10; push r11
    fat_push(ctx);
    fat_get(ctx, n.value); fat_push(ctx);
    fat_rt_call(ctx, "rt_index_set", 6);
    placelab(ctx, done);
    return 0;
}

// ---- inline map probe (#133) ---------------------------------------------
//
// `m[k]` with a receiver the checker proved `Map<K, V>` and a key proved Str or
// Int probes the runtime's hash table inline instead of calling rt_index_get.
// The walk is rt_map_find's exactly: the same key hash, the same three linear
// steps then CPython's perturb sequence, and the same 32-byte entries (key type,
// key, value type, value). Anything else - a receiver that is not a map, a key
// of another type, a map below the hash-table threshold (rt_map_find scans those
// linearly), a non-list non-map receiver - falls back to the runtime call, which
// keeps growth, faults and dynamic values out of the inline code.
//
// rsp-relative words used by the probe (96 bytes, released on every exit):
//   0 map payload   8 key type   16 key payload   24 step
//   32 table   40 mask   48 perturb   56 slot   64 entries   72 key   80 entry
// The runtime's map header holds count, capacity, entries, hash table and hash
// capacity at offsets 0, 8, 16, 24 and 32 (runtime/fat.may).

// A REX prefix (0x40 + W*8 + R*4 + X*2 + B), or nothing when all bits are
// clear, then a helper for each instruction form the probe emits.
fun fat_rex(ctx: Any, w: Any, r: Any, x: Any, b: Any) -> Any {
    let rex: Any = 64 + w * 8 + r * 4 + x * 2 + b;
    if (rex != 64) { e8(ctx, rex); }
    return 0;
}

// One instruction: `mov reg, [base + disp8]` (opcode 139) or
// `mov [base + disp8], reg` (opcode 137). `base` may be RSP.
fun fat_rm(ctx: Any, opcode: Any, reg: Any, base: Any, disp: Any) -> Any {
    fat_rex(ctx, 1, if (reg >= 8) { 1 } else { 0 }, 0, if (base >= 8) { 1 } else { 0 });
    e8(ctx, opcode); e8(ctx, 64 + (reg % 8) * 8 + base % 8);
    if (base % 8 == 4) { e8(ctx, 36); }                                      // SIB: [rsp], no index
    e8(ctx, disp);
    return 0;
}
fun fat_stack_store(ctx: Any, reg: Any, disp: Any) -> Any { return fat_rm(ctx, 137, reg, 4, disp); }
fun fat_stack_load(ctx: Any, reg: Any, disp: Any) -> Any { return fat_rm(ctx, 139, reg, 4, disp); }

// mov reg, [base + index * 8].
fun fat_rm_index8(ctx: Any, reg: Any, base: Any, index: Any) -> Any {
    fat_rex(ctx, 1, if (reg >= 8) { 1 } else { 0 }, if (index >= 8) { 1 } else { 0 },
        if (base >= 8) { 1 } else { 0 });
    e8(ctx, 139); e8(ctx, (reg % 8) * 8 + 4);
    e8(ctx, 192 + (index % 8) * 8 + base % 8);                               // scale 8
    return 0;
}

// lea reg, [base + disp]; the displacement is the 8-bit form when it fits.
fun fat_lea(ctx: Any, reg: Any, base: Any, disp: Any) -> Any {
    fat_rex(ctx, 1, if (reg >= 8) { 1 } else { 0 }, 0, if (base >= 8) { 1 } else { 0 });
    e8(ctx, 141);
    if (disp >= 0 and disp <= 127) { e8(ctx, 64 + (reg % 8) * 8 + base % 8); }
    else { e8(ctx, 128 + (reg % 8) * 8 + base % 8); }
    if (base % 8 == 4) { e8(ctx, 36); }
    if (disp >= 0 and disp <= 127) { e8(ctx, disp); } else { e32(ctx, disp); }
    return 0;
}
// lea reg, [base + index + disp8]; lea reg, [base + index * scale] (scale as
// the SIB field, 0-3).
fun fat_lea_index(ctx: Any, reg: Any, base: Any, index: Any, disp: Any) -> Any {
    fat_rex(ctx, 1, if (reg >= 8) { 1 } else { 0 }, if (index >= 8) { 1 } else { 0 },
        if (base >= 8) { 1 } else { 0 });
    e8(ctx, 141); e8(ctx, 64 + (reg % 8) * 8 + 4);
    e8(ctx, (index % 8) * 8 + base % 8); e8(ctx, disp);
    return 0;
}
fun fat_lea_scale(ctx: Any, reg: Any, base: Any, index: Any, scale: Any) -> Any {
    fat_rex(ctx, 1, if (reg >= 8) { 1 } else { 0 }, if (index >= 8) { 1 } else { 0 },
        if (base >= 8) { 1 } else { 0 });
    e8(ctx, 141); e8(ctx, (reg % 8) * 8 + 4);
    e8(ctx, scale * 64 + (index % 8) * 8 + base % 8);
    return 0;
}

// `op dst, src` for 1 add, 33 and, 41 sub (0x29), 49 xor (0x31), 57 cmp
// (0x39) and 137 mov (0x89).
fun fat_alu_reg(ctx: Any, opcode: Any, dst: Any, src: Any) -> Any {
    fat_rex(ctx, 1, if (src >= 8) { 1 } else { 0 }, 0, if (dst >= 8) { 1 } else { 0 });
    e8(ctx, opcode); e8(ctx, 192 + (src % 8) * 8 + dst % 8);
    return 0;
}
// shl/shr/sar reg, imm8 (ext 4, 5, 7).
fun fat_shift_imm(ctx: Any, ext: Any, reg: Any, imm: Any) -> Any {
    fat_rex(ctx, 1, 0, 0, if (reg >= 8) { 1 } else { 0 });
    e8(ctx, 193); e8(ctx, 192 + ext * 8 + reg % 8); e8(ctx, imm);
    return 0;
}
// imul reg, reg, imm32 and imul dst, src.
fun fat_imul_imm(ctx: Any, reg: Any, imm: Any) -> Any {
    fat_rex(ctx, 1, if (reg >= 8) { 1 } else { 0 }, 0, if (reg >= 8) { 1 } else { 0 });
    e8(ctx, 105); e8(ctx, 192 + (reg % 8) * 8 + reg % 8); e32(ctx, imm);
    return 0;
}
// movzx reg32, byte [base].
fun fat_movzx8(ctx: Any, reg: Any, base: Any) -> Any {
    fat_rex(ctx, 0, if (reg >= 8) { 1 } else { 0 }, 0, if (base >= 8) { 1 } else { 0 });
    e8(ctx, 15); e8(ctx, 182); e8(ctx, (reg % 8) * 8 + base % 8);
    return 0;
}
fun fat_test(ctx: Any, reg: Any) -> Any {
    fat_rex(ctx, 1, 0, 0, 0); e8(ctx, 133); e8(ctx, 192 + (reg % 8) * 8 + reg % 8);
    return 0;
}
// inc (ext 0) or dec (ext 1) reg.
fun fat_incdec(ctx: Any, ext: Any, reg: Any) -> Any {
    fat_rex(ctx, 1, 0, 0, if (reg >= 8) { 1 } else { 0 });
    e8(ctx, 255); e8(ctx, 192 + ext * 8 + reg % 8);
    return 0;
}
fun fat_stack_inc(ctx: Any, disp: Any) -> Any {
    e8(ctx, 72); e8(ctx, 255); e8(ctx, 68); e8(ctx, 36); e8(ctx, disp);
    return 0;
}
// movabs reg, imm64.
fun fat_movabs(ctx: Any, reg: Any, value: Any) -> Any {
    fat_rex(ctx, 1, 0, 0, if (reg >= 8) { 1 } else { 0 });
    e8(ctx, 184 + reg % 8); e64(ctx, value);
    return 0;
}
fun fat_push_reg(ctx: Any, reg: Any) -> Any {
    if (reg >= 8) { e8(ctx, 65); }
    e8(ctx, 80 + reg % 8);
    return 0;
}
// cmp reg, imm8.
fun fat_cmp_imm8(ctx: Any, reg: Any, imm: Any) -> Any {
    fat_rex(ctx, 1, 0, 0, if (reg >= 8) { 1 } else { 0 });
    e8(ctx, 131); e8(ctx, 248 + reg % 8); e8(ctx, imm);
    return 0;
}
// cmp qword [base + disp8], imm8.
fun fat_cmp_mem8(ctx: Any, base: Any, disp: Any, imm: Any) -> Any {
    fat_rex(ctx, 1, 0, 0, if (base >= 8) { 1 } else { 0 });
    e8(ctx, 131); e8(ctx, 120 + base % 8); e8(ctx, disp); e8(ctx, imm);
    return 0;
}

// The runtime's Str key hash (runtime/fat.may rt_key_hash): a wrapping
// polynomial over the bytes. Leaves the key in R9 and the hash in RSI.
fun fat_map_str_hash(ctx: Any) -> Any {
    let top: Any = newlab(ctx); let done: Any = newlab(ctx);
    x86_move_register(ctx, 9, 0);                                            // mov r9, rax
    e8(ctx, 69); e8(ctx, 49); e8(ctx, 210);                                  // xor r10d, r10d
    fat_rm(ctx, 139, 7, 0, 0);                                               // mov rdi, [rax]     length
    fat_lea(ctx, 6, 0, 8);                                                   // lea rsi, [rax + 8]
    fat_alu_reg(ctx, 1, 7, 6);                                               // add rdi, rsi       end
    placelab(ctx, top);
    fat_alu_reg(ctx, 57, 6, 7);                                              // cmp rsi, rdi
    jcc(ctx, 131, done);                                                      // jae done
    fat_imul_imm(ctx, 10, 131);                                              // imul r10, r10, 131
    fat_movzx8(ctx, 1, 6);                                                   // movzx ecx, byte [rsi]
    fat_alu_reg(ctx, 1, 10, 1);                                              // add r10, rcx
    fat_incdec(ctx, 0, 6);                                                   // inc rsi
    jmp(ctx, top);
    placelab(ctx, done);
    fat_alu_reg(ctx, 137, 6, 10);                                            // mov rsi, r10
    return 0;
}

// The runtime's Int key hash: fold the high words into the low ones. Leaves the
// key in R9 and the hash in RSI.
fun fat_map_int_hash(ctx: Any) -> Any {
    x86_move_register(ctx, 9, 0);                                            // mov r9, rax
    fat_alu_reg(ctx, 137, 6, 0);                                             // mov rsi, rax
    fat_shift_imm(ctx, 5, 6, 32);                                            // shr rsi, 32
    fat_alu_reg(ctx, 137, 1, 0);                                             // mov rcx, rax
    fat_alu_reg(ctx, 49, 6, 1);                                              // xor rsi, rcx
    fat_shift_imm(ctx, 5, 1, 48);                                            // shr rcx, 48
    fat_alu_reg(ctx, 49, 6, 1);                                              // xor rsi, rcx
    return 0;
}

// The walk over the runtime hash table; see the block comment above for the
// frame. RSI holds the hash, R9 the key; a hit leaves the entry's value in
// RDX/RAX, a miss leaves nil in both. Releases the probe frame and jumps to
// `done`.
fun fat_map_probe(ctx: Any, keyType: Any, done: Any) -> Any {
    let probe: Any = newlab(ctx); let next: Any = newlab(ctx);
    let linear: Any = newlab(ctx); let miss: Any = newlab(ctx);
    let found: Any = newlab(ctx); let called: Any = newlab(ctx);
    fat_stack_load(ctx, 1, 0);                                               // mov rcx, [rsp]         map
    fat_rm(ctx, 139, 11, 1, 32);                                             // mov r11, [rcx + 32]    hash capacity
    fat_rm(ctx, 139, 10, 1, 24);                                             // mov r10, [rcx + 24]    table
    fat_rm(ctx, 139, 8, 1, 16);                                              // mov r8, [rcx + 16]     entries
    fat_incdec(ctx, 1, 11);                                                  // dec r11                mask
    fat_alu_reg(ctx, 137, 7, 6);                                             // mov rdi, rsi
    fat_alu_reg(ctx, 33, 7, 11);                                             // and rdi, r11           slot
    x86_mov_immediate(ctx, 2, 0);                                            // mov edx, 0
    fat_stack_store(ctx, 2, 24);                                             // step = 0
    placelab(ctx, probe);
    fat_rm_index8(ctx, 1, 10, 7);                                            // mov rcx, [r10 + rdi*8]
    fat_test(ctx, 1);                                                        // test rcx, rcx
    jcc(ctx, 132, miss);                                                     // je miss
    fat_alu_reg(ctx, 137, 2, 1);                                             // mov rdx, rcx
    fat_shift_imm(ctx, 4, 2, 5);                                             // shl rdx, 5
    fat_lea_index(ctx, 0, 8, 2, -32);                                        // lea rax, [r8 + rdx - 32]
    fat_cmp_mem8(ctx, 0, 0, keyType);                                        // cmp qword [rax], keyType
    jcc(ctx, 133, next);                                                     // jne next
    if (keyType == 4) {
        fat_rm(ctx, 139, 2, 0, 8);                                           // mov rdx, [rax + 8]
        fat_alu_reg(ctx, 57, 2, 9);                                          // cmp rdx, r9
        jcc(ctx, 132, found);                                                // je found
        fat_stack_store(ctx, 0, 80);                                         // save the walk across the call
        fat_stack_store(ctx, 10, 32);
        fat_stack_store(ctx, 11, 40);
        fat_stack_store(ctx, 6, 48);
        fat_stack_store(ctx, 7, 56);
        fat_stack_store(ctx, 8, 64);
        fat_stack_store(ctx, 9, 72);
        fat_push_reg(ctx, 2);                                                // push stored key
        fat_push_reg(ctx, 9);                                                // push lookup key
        fat_rt_call(ctx, "rt_str_eq", 2);                                    // keys equal?
        fat_stack_load(ctx, 10, 32);
        fat_stack_load(ctx, 11, 40);
        fat_stack_load(ctx, 6, 48);
        fat_stack_load(ctx, 7, 56);
        fat_stack_load(ctx, 8, 64);
        fat_stack_load(ctx, 9, 72);
        fat_test(ctx, 0);                                                    // test rax, rax
        jcc(ctx, 133, called);                                               // jne called
    } else {
        fat_rm(ctx, 139, 2, 0, 8);                                           // mov rdx, [rax + 8]
        fat_alu_reg(ctx, 57, 2, 9);                                          // cmp rdx, r9
        jcc(ctx, 132, found);                                                // je found
    }
    placelab(ctx, next);
    fat_stack_load(ctx, 2, 24);                                              // step
    fat_stack_inc(ctx, 24);
    fat_cmp_imm8(ctx, 2, 3);                                                 // cmp rdx, 3
    jcc(ctx, 130, linear);                                                   // jb: the three linear steps
    fat_alu_reg(ctx, 137, 2, 6);                                             // mov rdx, rsi
    fat_shift_imm(ctx, 5, 2, 5);                                             // shr rdx, 5
    fat_movabs(ctx, 1, 576460752303423487);                                  // mov rcx, 2^59 - 1
    fat_alu_reg(ctx, 33, 2, 1);                                              // and rdx, rcx
    fat_alu_reg(ctx, 137, 6, 2);                                             // mov rsi, rdx   perturb
    fat_lea_scale(ctx, 2, 7, 7, 2);                                          // lea rdx, [rdi + rdi*4]
    fat_alu_immediate(ctx, 0, 2, 1);                                         // add rdx, 1
    fat_alu_reg(ctx, 1, 2, 6);                                               // add rdx, rsi
    fat_alu_reg(ctx, 137, 7, 2);                                             // mov rdi, rdx
    fat_alu_reg(ctx, 33, 7, 11);                                             // and rdi, r11
    jmp(ctx, probe);
    placelab(ctx, linear);
    fat_incdec(ctx, 0, 7);                                                   // inc rdi
    fat_alu_reg(ctx, 33, 7, 11);                                             // and rdi, r11
    jmp(ctx, probe);
    placelab(ctx, miss);
    e8(ctx, 49); e8(ctx, 192);                                               // xor eax, eax
    e8(ctx, 49); e8(ctx, 210);                                               // xor edx, edx
    fat_release(ctx, 96);
    jmp(ctx, done);
    placelab(ctx, found);
    fat_rm(ctx, 139, 2, 0, 16);                                              // mov rdx, [rax + 16]
    fat_rm(ctx, 139, 0, 0, 24);                                              // mov rax, [rax + 24]
    fat_release(ctx, 96);
    jmp(ctx, done);
    placelab(ctx, called);
    fat_stack_load(ctx, 0, 80);                                              // mov rax, [rsp + 80]
    jmp(ctx, found);
    return 0;
}

// Load `object[index]` into RDX/RAX: a list element or, for a receiver the
// checker proved a Map with a Str/Int key, an inline probe. Everything else
// calls rt_index_get.
fun fat_index_load(ctx: Any, n: Any) -> Any {
    let slow: Any = newlab(ctx); let done: Any = newlab(ctx);
    let typed: Any = newlab(ctx); let bytes: Any = newlab(ctx);
    let mapcheck: Any = newlab(ctx);
    let probe: Any = if (NO_OPT) { 0 } else { n.mapProbe ?? 0 };
    fat_operands(ctx, n.object, n.index);
    for byte: Any in [73, 131, 249, 5] { e8(ctx, byte); }                    // cmp r9, 5
    jcc(ctx, 133, if (probe == 4 or probe == 2) { mapcheck } else { slow });
    for byte: Any in [72, 131, 250, 2] { e8(ctx, byte); }                    // cmp rdx, 2
    jcc(ctx, 133, slow);
    for byte: Any in [77, 139, 16, 76, 57, 208] { e8(ctx, byte); }           // mov r10, [r8]; cmp rax, r10
    jcc(ctx, 131, slow);                                                      // jae (also negative)
    // Specialized element storage (#101 phase 2): the header's kind word
    // selects fat values, Int/Float words or Bool bytes.
    for byte: Any in [77, 139, 88, 24] { e8(ctx, byte); }                    // mov r11, [r8 + 24]
    for byte: Any in [77, 133, 219] { e8(ctx, byte); }                       // test r11, r11
    jcc(ctx, 133, typed);                                                     // jne typed
    for byte: Any in [77, 139, 80, 16, 72, 193, 224, 4, 73, 1, 194,          // mov r10, [r8 + 16]; shl rax, 4; add r10, rax
        73, 139, 18, 73, 139, 66, 8] { e8(ctx, byte); }                      // mov rdx, [r10]; mov rax, [r10 + 8]
    jmp(ctx, done);
    placelab(ctx, typed);
    for byte: Any in [77, 139, 80, 16] { e8(ctx, byte); }                    // mov r10, [r8 + 16]
    for byte: Any in [73, 131, 251, 3] { e8(ctx, byte); }                    // cmp r11, 3
    jcc(ctx, 132, bytes);                                                     // je bytes
    for byte: Any in [72, 193, 224, 3] { e8(ctx, byte); }                    // shl rax, 3
    for byte: Any in [73, 139, 4, 2] { e8(ctx, byte); }                      // mov rax, [r10 + rax]
    for byte: Any in [73, 141, 83, 1] { e8(ctx, byte); }                     // lea rdx, [r11 + 1]  (Int, Float)
    jmp(ctx, done);
    placelab(ctx, bytes);
    for byte: Any in [65, 15, 182, 4, 2] { e8(ctx, byte); }                  // movzx eax, byte [r10 + rax]
    for byte: Any in [186, 1, 0, 0, 0] { e8(ctx, byte); }                    // mov edx, 1  (Bool)
    jmp(ctx, done);
    if (probe == 4 or probe == 2) {
        placelab(ctx, mapcheck);
        for byte: Any in [73, 131, 249, 6] { e8(ctx, byte); }                // cmp r9, 6
        jcc(ctx, 133, slow);                                                  // jne slow (not a map)
        for byte: Any in [73, 131, 120, 32, 0] { e8(ctx, byte); }            // cmp qword [r8 + 32], 0
        jcc(ctx, 132, slow);                                                  // je slow (linear scan)
        for byte: Any in [72, 131, 250, probe] { e8(ctx, byte); }            // cmp rdx, probe (key type)
        jcc(ctx, 133, slow);
        fat_rsp(ctx, 236, 96);                                                // sub rsp, 96
        fat_stack_store(ctx, 8, 0);                                           // map payload
        fat_stack_store(ctx, 2, 8);                                           // key type
        fat_stack_store(ctx, 0, 16);                                          // key payload
        if (probe == 4) { fat_map_str_hash(ctx); } else { fat_map_int_hash(ctx); }
        fat_map_probe(ctx, probe, done);
    }
    placelab(ctx, slow);
    fat_stub_call(ctx, "rt_index_get", -1);
    placelab(ctx, done);
    return 0;
}

fun fat_index(ctx: Any, n: Any) -> Any {
    fat_index_load(ctx, n);
    return 0;
}

// `m[k] ?? fallback` where the value's only readers are the copy into the
// coalesce result and the IR_NONNULL branch: decide the branch from the value
// the probe just loaded, so no temporary is stored and re-read and the branch
// reuses the probe's result. The nil test stays: a present entry whose value is
// nil (reachable through an `Any` alias) coalesces to the fallback.
fun fat_index_coalesce(ctx: Any, n: Any, result: Any, done: Any) -> Any {
    let fall: Any = newlab(ctx);
    fat_index_load(ctx, n);
    fat_test(ctx, 2);                                                        // test rdx, rdx
    jcc(ctx, 132, fall);                                                     // je fallback
    if (result != 0 and FAT_INTERVALS[result.slot].uses > 0) { fat_put(ctx, result); }
    jmp(ctx, done);
    placelab(ctx, fall);
    fat_forget();
    return 0;
}

// Store `value` in local slot `k` register to register when both are XMM
// registers; false (emitting nothing) otherwise.
fun fat_xmm_store(ctx: Any, k: Any, value: Any) -> Bool {
    let home: Any = fat_home(k);
    if (not fat_xmm_home(home)) { return false; }
    let source: Any = fat_xmm_source(value);
    if (source < 0) { return false; }
    fat_movapd(ctx, home[1], source);
    fat_forget();
    return true;
}

fun fat_let(ctx: Any, s: Any) -> Any {
    if (s.global != 1 and is_boxed(ctx, s.name, s.length) != 1) {
        let k: Any = fat_local_slot(ctx, fat_declare(ctx, s.name, s.length));
        if (fat_xmm_store(ctx, k, s.initializer)) { return 0; }
        fat_get(ctx, s.initializer);
        return fat_store_slot(ctx, k);
    }
    fat_get(ctx, s.initializer);
    if (s.global == 1) { return fat_abs_store(ctx, glob_off(ctx, glob_find(ctx, s.name, s.length))); }
    fat_push(ctx); fat_rt_call(ctx, "rt_cell", 2);
    return fat_store_slot(ctx, fat_local_slot(ctx, fat_declare(ctx, s.name, s.length)));
}

fun fat_assign(ctx: Any, s: Any) -> Any {
    let local: Any = loc_find(ctx, s.name, s.length);
    if (local >= 0 and is_boxed(ctx, s.name, s.length) != 1 and fat_xmm_store(ctx, fat_local_slot(ctx, local), s.value)) { return 0; }
    fat_get(ctx, s.value);
    let li: Any = loc_find(ctx, s.name, s.length);
    if (li >= 0) {
        let slot: Any = fat_local_slot(ctx, li);
        if (is_boxed(ctx, s.name, s.length) == 1) {
            x86_load_register(ctx, 1, fat_disp(slot) - 8);
            return fat_cell_store(ctx);
        }
        return fat_store_slot(ctx, slot);
    }
    let gi: Any = glob_find(ctx, s.name, s.length);
    if (gi < 0) { die_str("mayc: assign to unknown\n"); }
    return fat_abs_store(ctx, glob_off(ctx, gi));
}

// A comparison whose only reader is the branch right after it (#96).
// Dead copies in between (fat_plan_dead_copies) emit nothing. Returns the
// branch's position, or -1.
fun fat_fusable(block: Any, position: Any) -> Any {
    let instruction: Any = block.code[position];
    if (instruction.op != E_BIN or not has(FAT_INLINE_COMPARE, str(instruction.extra.op))) { return -1; }
    mut following: Any = position + 1;
    while (following < len(block.code) and FAT_DEAD[following]) { following += 1; }
    if (following >= len(block.code)) { return -1; }
    let next: Any = block.code[following];
    if (next.op != IR_FALSE and next.op != IR_TRUE) { return -1; }
    let interval: Any = FAT_INTERVALS[instruction.result.slot];
    if (next.arg1 != 0 and next.arg1.slot == instruction.result.slot and interval.uses == 1 and interval.definitions == 1) { return following; }
    return -1;
}

// `left ?? right` lowers to an E_INDEX, an IR_COPY of its value into the
// coalesce result and an IR_NONNULL branch on the indexed value. When those are
// the value's only two readers, the branch can be decided from the value the
// index load leaves in RDX/RAX: no temporary store and reload, and the probe's
// hit or miss is the branch condition. Returns [branch position, copy result or
// 0] when the instructions at `position` (after dead copies) are that copy and
// branch, else nil.
fun fat_coalesce_fusable(block: Any, position: Any) -> Any {
    let instruction: Any = block.code[position];
    if (instruction.op != E_INDEX or instruction.result == 0) { return nil; }
    let value: Any = instruction.result;
    let interval: Any = FAT_INTERVALS[value.slot];
    if (interval.definitions != 1) { return nil; }
    mut following: Any = position + 1;
    while (following < len(block.code) and FAT_DEAD[following]) { following += 1; }
    if (following >= len(block.code)) { return nil; }
    mut result: Any = 0;
    let next: Any = block.code[following];
    if (next.op == IR_COPY and next.result != 0 and next.result.slot != value.slot and
        next.arg1 != 0 and next.arg1.slot == value.slot) {
        result = next.result;
        following += 1;
        while (following < len(block.code) and FAT_DEAD[following]) { following += 1; }
        if (following >= len(block.code)) { return nil; }
    }
    let branch: Any = block.code[following];
    if (branch.op != IR_NONNULL or branch.arg1 == 0 or branch.arg1.slot != value.slot) { return nil; }
    let expected: Any = if (result == 0) { 1 } else { 2 };
    if (interval.uses != expected) { return nil; }
    return [following, result];
}

// ---- fixed-slot record construction (#135) --------------------------------
//
// A struct or enum constructor lowers to rt_struct_new(n) and one
// rt_struct_set per entry (#134). Its body is straight-line: the keys are
// interned string literals, the values are its parameters, and the record
// cannot be named before it is returned. When the size reaches the backend as a
// forwarded constant, the allocation's header writes and every slot write are
// emitted directly instead of one runtime call per slot. The allocation itself
// stays a runtime call (rt_alloc_record), so the block is the same kind-4
// record block of docs/design/STRUCT_LAYOUT.md: a 48-byte map header with the
// entries at p + 48, the hash table fields left zeroed and the entry bytes
// exactly those rt_struct_set writes. The collector is untouched. A shape this
// cannot prove keeps the runtime calls, and --no-opt keeps the old path.
//
// FAT_RECORD_STACK holds the records whose header this body wrote and whose
// slots are still being filled: [temporary slot, size, next slot, valid].
// Constructor bodies nest only through nested record constructors, and an inner
// record completes before the outer record's next slot write, so a stack
// matches the order.
mut FAT_RECORD_STACK: Any = [];

// The constant Int value of `value` when the backend forwarded one here.
fun fat_record_const(value: Any) -> Any {
    if (value == 0 or value == nil) { return nil; }
    let d: Any = FAT_FORWARD[value.slot];
    if (d == nil or d[0] != 0 or d[1] != 2) { return nil; }
    return d[2];
}

fun fat_record_pending(slot: Any) -> Any {
    mut i: Any = len(FAT_RECORD_STACK) - 1;
    while (i >= 0) {
        let entry: Any = FAT_RECORD_STACK[i];
        if (entry[0] == slot) { return entry; }
        i -= 1;
    }
    return nil;
}

// push rax.
fun fat_push_payload(ctx: Any) -> Any { e8(ctx, 80); return 0; }

// Allocate a `size`-slot record and write rt_struct_new's header: the count,
// the capacity in values (two per entry) and the entries pointer into the
// block at p + 48. rt_alloc_record zeroes the payload, so the hash table fields
// at 24 and 32 stay zero exactly as the runtime leaves them.
fun fat_record_new(ctx: Any, instruction: Any) -> Bool {
    let args: Any = instruction.arg1;
    if (args == 0 or args.next != 0 or instruction.result == 0) { return false; }
    let size: Any = fat_record_const(args);
    if (size == nil or size <= 0 or size > 4096) { return false; }
    x86_mov_immediate(ctx, 0, size); fat_push_payload(ctx);              // push size
    fat_rt_call(ctx, "rt_alloc_record", 1);                              // payload in rax
    x86_mov_immediate(ctx, 2, 6);                                        // type word: record
    x86_mov_immediate(ctx, 1, size);
    fat_rm(ctx, 137, 1, 0, 0);                                           // mov [rax], rcx        count
    x86_mov_immediate(ctx, 1, size * 2);
    fat_rm(ctx, 137, 1, 0, 8);                                           // mov [rax + 8], rcx    capacity
    fat_lea(ctx, 1, 0, 48);                                              // lea rcx, [rax + 48]
    fat_rm(ctx, 137, 1, 0, 16);                                          // mov [rax + 16], rcx   entries
    push(FAT_RECORD_STACK, [instruction.result.slot, size, 0, true]);
    return true;
}

// Write entry `slot` of the record whose header `fat_record_new` wrote: the
// key type and payload, then the value type and payload, at
// [record + 48 + 32 * slot]. Returns false to keep the runtime call.
fun fat_record_set(ctx: Any, instruction: Any) -> Bool {
    let record: Any = instruction.arg1;
    if (record == 0 or record.next == 0) { return false; }
    let slotValue: Any = record.next;
    if (slotValue.next == 0 or slotValue.next.next == 0) { return false; }
    let key: Any = slotValue.next;
    let value: Any = key.next;
    if (value.next != 0) { return false; }
    let entry: Any = fat_record_pending(record.slot);
    if (entry == nil or entry[3] != true) { return false; }
    let slot: Any = fat_record_const(slotValue);
    if (slot == nil or slot != entry[2] or slot >= entry[1]) {
        entry[3] = false;                                                // the rest keeps the runtime call
        return false;
    }
    fat_get(ctx, record); x86_move_register(ctx, 10, 0);                 // r10 = record payload
    fat_get(ctx, key); x86_move_register(ctx, 11, 0);                    // r11 = key payload
    fat_lea(ctx, 1, 10, 48 + 32 * slot);                                 // rcx = entry address
    fat_rm(ctx, 137, 2, 1, 0);                                           // mov [rcx], rdx        key type
    fat_rm(ctx, 137, 11, 1, 8);                                          // mov [rcx + 8], r11    key payload
    fat_get(ctx, value);
    fat_rm(ctx, 137, 2, 1, 16);                                          // mov [rcx + 16], rdx   value type
    fat_rm(ctx, 137, 0, 1, 24);                                          // mov [rcx + 24], rax   value payload
    entry[2] = slot + 1;
    if (entry[2] == entry[1]) {
        let top: Any = FAT_RECORD_STACK[len(FAT_RECORD_STACK) - 1];
        if (top[0] == entry[0]) { pop(FAT_RECORD_STACK); } else { entry[3] = false; }
    }
    return true;
}

fun fat_ir(ctx: Any, block: Any) -> Any {
    mut position: Any = 0;
    while (position < len(block.code)) {
        let instruction: Any = block.code[position];
        position += 1;
        if (FAT_DEAD[position - 1]) { continue; }
        let op: Any = instruction.op;
        let payload: Any = instruction.extra;
        if (instruction.result != 0 and FAT_FORWARDABLE[instruction.result.slot] > 0 and fat_forward(ctx, instruction)) { continue; }
        let fused: Any = fat_fusable(block, position - 1);
        if (fused >= 0) {
            let branch: Any = block.code[fused];
            position = fused + 1;
            fat_branch_compare(ctx, payload, fat_lab(ctx, branch.extra), branch.op == IR_TRUE);
            continue;
        }
        if (op == E_INDEX and not NO_OPT) {
            let coalesce: Any = fat_coalesce_fusable(block, position - 1);
            if (coalesce != nil) {
                let branch: Any = block.code[coalesce[0]];
                fat_index_coalesce(ctx, payload, coalesce[1], fat_lab(ctx, branch.extra));
                position = coalesce[0] + 1;
                continue;
            }
        }
        if (op == IR_LABEL) { placelab(ctx, fat_lab(ctx, payload)); fat_forget(); }
        else if (op == IR_JUMP) { jmp(ctx, fat_lab(ctx, payload)); }
        else if (op == IR_COPY) { fat_get(ctx, instruction.arg1); }
        else if (op == IR_NIL) { fat_set(ctx, 0, 0); }
        else if (op == IR_BOOL) {
            let falsy: Any = newlab(ctx); let done: Any = newlab(ctx);
            fat_get(ctx, instruction.arg1); fat_branch(ctx, falsy, false);
            fat_set(ctx, 1, 1); jmp(ctx, done);
            placelab(ctx, falsy); fat_set(ctx, 1, 0); placelab(ctx, done);
        }
        else if (op == IR_FALSE or op == IR_TRUE) {
            fat_get(ctx, instruction.arg1);
            if (fat_known_type(instruction.arg1) == 1) {
                e8(ctx, 72); e8(ctx, 133); e8(ctx, 192);                    // test rax, rax
                jcc(ctx, if (op == IR_TRUE) { 133 } else { 132 }, fat_lab(ctx, payload));
            } else { fat_branch(ctx, fat_lab(ctx, payload), op == IR_TRUE); }
        }
        else if (op == IR_ISNIL or op == IR_NONNULL) {
            fat_get(ctx, instruction.arg1);
            e8(ctx, 72); e8(ctx, 133); e8(ctx, 210);                        // test rdx, rdx
            jcc(ctx, if (op == IR_ISNIL) { 132 } else { 133 }, fat_lab(ctx, payload));
        }
        else if (op == IR_RUNTIME) {
            if (payload == "rt_push" and not NO_OPT and fat_count(instruction.arg1) == 2) { fat_push_fast(ctx, instruction.arg1); }
            else if (payload == "rt_struct_new" and not NO_OPT and fat_record_new(ctx, instruction)) { }
            else if (payload == "rt_struct_set" and not NO_OPT and fat_record_set(ctx, instruction)) { }
            else { fat_rt(ctx, payload, instruction.arg1); }
        }
        else if (op == IR_RETURN) { fat_get(ctx, instruction.arg1); jmp(ctx, ctx.returnLabel); }
        else if (op == IR_TAILCALL) {
            mut arg: Any = instruction.arg1;
            mut i: Any = 0;
            while (arg != 0) { fat_get(ctx, arg); fat_store_slot(ctx, fat_local_slot(ctx, i)); i += 1; arg = arg.next; }
            jmp(ctx, ctx.restartLabel);
        }
        else if (op == IR_TRY_BEGIN) { x86_handler_begin(ctx, fat_lab(ctx, payload)); }
        else if (op == IR_TRY_END) { x86_handler_end(ctx); }
        else if (op == E_BIN and fat_xmm_operation(payload)) {
            fat_xmm_binary(ctx, payload, instruction.result);
            if (instruction.result != 0 and FAT_XMM[instruction.result.slot] >= 0) { continue; }
        }
        else if (op == S_LET) { fat_let(ctx, payload); }
        else if (op == S_ASSIGN) { fat_assign(ctx, payload); }
        else if (op == S_CASSIGN) { fat_get(ctx, payload.value); fat_env_cell(ctx, payload.index); fat_cell_store(ctx); }
        else if (op == S_SETIDX) { fat_index_set(ctx, payload); } else if (op == S_SETPROP) {
            fat_field_set(ctx, payload.object, payload.value, payload.cache, payload.span.source, payload.start, payload.length, payload.field ?? 0);
        } else { fat_operation(ctx, payload); }
        // A result nothing reads (lsra counts readers, never too few) needs no store.
        if (instruction.result != 0 and FAT_INTERVALS[instruction.result.slot].uses > 0) { fat_put(ctx, instruction.result); }
    }
    return 0;
}

// push rbp; mov rbp, rsp; sub rsp, imm32. Returns the immediate's offset.
// The registers of the function's homes, saved below its slots (#96).
fun fat_home_registers() -> Any {
    let registers: Any = [];
    for name: Any in FAT_HOME_ORDER {
        let home: Any = FAT_HOME_NAMES[name];
        if (fat_xmm_home(home)) { continue; }
        if (home[0] >= 0) { push(registers, home[0]); }
        push(registers, home[1]);
    }
    return registers;
}

fun fat_prologue(ctx: Any) -> Any {
    e8(ctx, 85); e8(ctx, 72); e8(ctx, 137); e8(ctx, 229);
    e8(ctx, 72); e8(ctx, 129); e8(ctx, 236);
    let fp: Any = ctx.code.length; e32(ctx, 0);
    // mov [rbp - disp32], reg; fat_epilogue fills in the displacements.
    FAT_SAVES = [];
    for register: Any in fat_home_registers() {
        e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 137); e8(ctx, 133 + (register % 8) * 8);
        push(FAT_SAVES, ctx.code.length); e32(ctx, 0);
    }
    return fp;
}

// Nil falls off the end; IR_RETURN jumps to the return label with a value.
fun fat_epilogue(ctx: Any, fp: Any) -> Any {
    fat_set(ctx, 0, 0);
    placelab(ctx, ctx.returnLabel);
    let slots: Any = 16 * (ctx.fatBase + ctx.maxLocals);
    let registers: Any = fat_home_registers();
    for index: Any in 0..len(registers) {
        let displacement: Any = slots + 8 * (index + 1);
        store32(ctx.code.data + FAT_SAVES[index], 0 - displacement);
        x86_load_register(ctx, registers[index], displacement);
    }
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 236); e8(ctx, 93); e8(ctx, 195);     // mov rsp, rbp; pop rbp; ret
    // Saves round up to whole 16-byte slots, keeping the stack aligned.
    store32(ctx.code.data + fp, slots + 16 * ((len(registers) + 1) / 2));
    fat_emit_deferred(ctx);
    // The type-fault stub of a direct call to a native-word function.
    if (FAT_WORD_FAULT != nil) {
        placelab(ctx, FAT_WORD_FAULT);
        call_rt0(ctx, addr("rt_word_type_fault"), len("rt_word_type_fault"));
        FAT_WORD_FAULT = nil;
    }
    return 0;
}

fun fat_begin(ctx: Any, block: Any, boxed: Any) -> Any {
    ctx.mode = 1; ctx.native = false; ctx.allocation = 0;
    loc_reset(ctx);
    bx_use_list(ctx, boxed);
    ctx.fatBase = fat_plan_slots(block); fat_forget(); FAT_APPLY_LOCAL = -1;
    FAT_HOME_NAMES = {}; FAT_HOME_ORDER = []; FAT_HOMES = [];
    FAT_XMM = []; FAT_IN_BODY = false; FAT_WORD_FAULT = nil; FAT_RECORD_STACK = [];
    for interval: Any in FAT_INTERVALS { push(FAT_XMM, -1); }
    ctx.envCount = 0; ctx.envCaptures = [];
    return 0;
}

// The fat entry of a native-word function (#92): check each argument's type
// word, pass the payloads as machine words and give the result its type.
// Fat Int and Bool payloads are the native words, so nothing is converted.
fun fat_native_entry(ctx: Any, rec: Any) -> Any {
    if (rec.nativeLab == 0) { rec.nativeLab = newlab(ctx); }
    let fault: Any = newlab(ctx);
    placelab(ctx, rec.lab);
    e8(ctx, 85); e8(ctx, 72); e8(ctx, 137); e8(ctx, 229);                    // push rbp; mov rbp, rsp
    let registers: Any = [7, 6, 2, 1, 8, 9];
    for index: Any in 0..rec.pc {
        x86_load_register(ctx, 0, 0 - (16 + 16 * index));
        e8(ctx, 72); e8(ctx, 131); e8(ctx, 248); e8(ctx, if (rec.nativeKinds[index] == "Bool") { 1 } else { 2 }); // cmp rax, type
        jcc(ctx, 133, fault);
    }
    for index: Any in 0..rec.pc { x86_load_register(ctx, registers[index], 0 - (24 + 16 * index)); }
    call(ctx, rec.nativeLab);
    x86_mov_immediate(ctx, 2, if (rec.nativeResult == "Bool") { 1 } else { 2 });
    e8(ctx, 93); e8(ctx, 195);                                                // pop rbp; ret
    placelab(ctx, fault);
    call_rt0(ctx, addr("rt_word_type_fault"), len("rt_word_type_fault"));
    return 0;
}

// Native-word code calls this function's word adapter: the machine-word
// arguments in the SysV registers become Int or Bool values for its fat
// entry, and the result's payload is the word.
fun fat_word_adapter(ctx: Any, rec: Any) -> Any {
    if (rec.wordLab == 0) { rec.wordLab = newlab(ctx); }
    placelab(ctx, rec.wordLab);
    e8(ctx, 85); e8(ctx, 72); e8(ctx, 137); e8(ctx, 229);                    // push rbp; mov rbp, rsp
    let size: Any = (rec.pc + rec.pc % 2) * 16;
    fat_rsp(ctx, 236, size);
    let registers: Any = [7, 6, 2, 1, 8, 9];
    for index: Any in 0..rec.pc {
        let register: Any = registers[index];
        e8(ctx, 72); e8(ctx, 199); e8(ctx, 132); e8(ctx, 36); e32(ctx, 16 * index); // mov qword [rsp + d], type
        e32(ctx, if (rec.nativeKinds[index] == "Bool") { 1 } else { 2 });
        e8(ctx, if (register >= 8) { 76 } else { 72 }); e8(ctx, 137);            // mov [rsp + d], reg
        e8(ctx, 132 + (register % 8) * 8); e8(ctx, 36); e32(ctx, 16 * index + 8);
    }
    call(ctx, rec.lab);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 236); e8(ctx, 93); e8(ctx, 195);      // mov rsp, rbp; pop rbp; ret
    return 0;
}

// A typed extern: convert each argument value (rt_ffi_arg) into a frame
// word, place integers in the SysV registers and floats in XMM0-7 (the rest
// on the stack, in order), call the resolved slot and convert the result.
fun fat_foreign(ctx: Any, rec: Any) -> Any {
    fat_begin(ctx, rec.ir, rec.boxed);
    placelab(ctx, rec.lab);
    let fp: Any = fat_prologue(ctx);
    for i: Any in 0..rec.pc {
        x86_load_register(ctx, 2, 0 - (16 + 16 * i)); x86_load_register(ctx, 0, 0 - (24 + 16 * i));
        fat_push(ctx); fat_set(ctx, 2, rec.ffiArgs[i]); fat_push(ctx);
        fat_rt_call(ctx, "rt_ffi_arg", 4);
        // movq xmm0, rax; cvtsd2ss xmm0, xmm0; movd eax, xmm0 for Float32.
        if (rec.ffiArgs[i] == 5) { for byte: Any in [102, 72, 15, 110, 192, 242, 15, 90, 192, 102, 15, 126, 192] { e8(ctx, byte); } }
        x86_store_register(ctx, 0, fat_disp(i) - 8);
    }
    mut integer: Any = 0; mut floating: Any = 0;
    let locations: Any = []; let stacked: Any = [];
    for i: Any in 0..rec.pc {
        let kind: Any = rec.ffiArgs[i];
        if (kind == 4 or kind == 5) {
            if (floating < 8) { push(locations, [1, floating]); floating += 1; } else { push(locations, [2, 0]); push(stacked, i); }
        } else if (integer < 6) { push(locations, [0, integer]); integer += 1; }
        else { push(locations, [2, 0]); push(stacked, i); }
    }
    if (len(stacked) % 2 == 1) { e8(ctx, 72); e8(ctx, 131); e8(ctx, 236); e8(ctx, 8); }
    mut i: Any = len(stacked) - 1;
    while (i >= 0) { x86_load_register(ctx, 0, fat_disp(stacked[i]) - 8); e8(ctx, 80); i -= 1; }
    for index: Any in 0..rec.pc {
        let location: Any = locations[index];
        if (location[0] != 2) {
            x86_load_register(ctx, 0, fat_disp(index) - 8);
            if (location[0] == 0) { mov_argreg(ctx, location[1]); }
            else { e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 110); e8(ctx, 192 + location[1] * 8); }
        }
    }
    ld_abs(ctx, rec.ffiSlot);
    e8(ctx, 73); e8(ctx, 137); e8(ctx, 195);                                 // mov r11, rax
    mov_imm(ctx, floating);
    e8(ctx, 65); e8(ctx, 255); e8(ctx, 211);                                 // call r11
    fat_release(ctx, ((len(stacked) + 1) / 2) * 16);
    let result: Any = rec.ffiResult;
    if (result == 2) { e8(ctx, 72); e8(ctx, 99); e8(ctx, 192); }             // movsxd rax, eax
    if (result == 3) { e8(ctx, 137); e8(ctx, 192); }                         // mov eax, eax
    if (result == 8) { e8(ctx, 15); e8(ctx, 182); e8(ctx, 192); }           // movzx eax, al
    if (result == 5) { e8(ctx, 243); e8(ctx, 15); e8(ctx, 90); e8(ctx, 192); } // cvtss2sd xmm0, xmm0
    if (result == 4 or result == 5) { e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 126); e8(ctx, 192); } // movq rax, xmm0
    x86_mov_immediate(ctx, 2, 2); fat_push(ctx); fat_set(ctx, 2, result); fat_push(ctx);
    fat_rt_call(ctx, "rt_ffi_result", 4);
    ctx.returnLabel = newlab(ctx);
    jmp(ctx, ctx.returnLabel);
    ctx.maxLocals = rec.pc;
    fat_epilogue(ctx, fp);
    // Native-word callers (#94) pass machine words straight to C.
    if (rec.wordForeign == true) {
        ctx.nativeFaults = [0, 0, 0, 0, 0];
        x86_foreign_native(ctx, rec);
        for kind: Any in 0..len(ctx.nativeFaults) {
            if (ctx.nativeFaults[kind] != 0) { placelab(ctx, ctx.nativeFaults[kind]); x86_native_raise(ctx, kind); }
        }
    }
    return 0;
}

// Parameter types that a specialized body of `rec` may assume: the
// annotated Int (2), Float (3) or Bool (1) of each parameter, or -1. Empty
// when there is none, or `rec` has no strict signature or captures values.
// The entry checks the assumptions, so they only need to be likely.
fun fat_assumptions(rec: Any) -> Any {
    let assumed: Any = [];
    if (rec.cc != 0) { return assumed; }
    let signature: Any = rec.strictSignature;
    if (signature == nil or signature == 0 or len(signature.variables ?? []) > 0 or len(signature.arguments ?? []) != rec.pc) { return assumed; }
    mut useful: Bool = false;
    for index: Any in 0..rec.pc {
        let t: Any = signature.arguments[index];
        mut kind: Any = -1;
        if (t != nil and t != 0 and len(t.arguments ?? []) == 0) {
            if (t.name == "Int") { kind = 2; } else if (t.name == "Float") { kind = 3; } else if (t.name == "Bool") { kind = 1; }
        }
        push(assumed, kind);
        if (kind > 0) { useful = true; }
    }
    return if (useful) { assumed } else { [] };
}

// Proven temporaries (fat_plan_types).
fun fat_proven_count() -> Any {
    mut count: Any = 0;
    for known: Any in FAT_PROVEN { if (known > 0) { count += 1; } }
    return count;
}

// Whether `rec` gets a specialized body for its annotated parameter types:
// it has a loop, no tail call (which would store new arguments in place)
// and no handler, and the assumptions prove more temporaries.
let FAT_VERSION_LIMIT: Any = 4000;
fun fat_versioned(ctx: Any, rec: Any, assumed: Any) -> Bool {
    if (len(assumed) == 0 or len(rec.ir.code) > FAT_VERSION_LIMIT) { return false; }
    let labels: Any = {};
    mut loops: Bool = false;
    for instruction: Any in rec.ir.code {
        let op: Any = instruction.op;
        if (op == IR_TAILCALL or op == IR_TRY_BEGIN) { return false; }
        if (op == IR_LABEL) { labels[instruction.extra] = true; }
        if ((op == IR_JUMP or op == IR_FALSE or op == IR_TRUE) and labels[instruction.extra] == true) { loops = true; }
    }
    if (not loops) { return false; }
    fat_begin(ctx, rec.ir, rec.boxed);
    fat_plan_types(ctx, rec.ir, rec.parr, rec.pc, false, []);
    let generic: Any = fat_proven_count();
    fat_plan_types(ctx, rec.ir, rec.parr, rec.pc, false, assumed);
    return fat_proven_count() > generic;
}

// A function whose annotated Int, Float or Bool parameters let more of its
// values be proven (#101) gets two bodies. Annotations can be bypassed
// through `Any` aliases, so its entry compares each such argument's type
// word with the annotation and runs the generic body when one differs;
// otherwise it falls through to the body specialized for those types.
//
// A function whose callers use the register convention (#132) keeps its
// vector entry as an adapter that copies the argument vector into registers
// and then dispatches from them, so closures and function values still work.
fun fat_func(ctx: Any, rec: Any) -> Any {
    if (rec.foreign == true) { return fat_foreign(ctx, rec); }
    let assumed: Any = fat_assumptions(rec);
    let registers: Bool = rec.regWanted == true;
    if (fat_versioned(ctx, rec, assumed)) {
        let specialized: Any = newlab(ctx);
        let generic: Any = newlab(ctx);
        let genericRegister: Any = newlab(ctx);
        if (registers) {
            placelab(ctx, rec.lab);
            fat_arguments_to_registers(ctx, rec.pc);
            placelab(ctx, fat_register_label(ctx, rec));
        } else { placelab(ctx, rec.lab); }
        for index: Any in 0..rec.pc {
            if (assumed[index] > 0) {
                if (registers) { fat_cmp_immediate(ctx, FAT_ARG_PAIRS[index][0], assumed[index]); jcc(ctx, 133, genericRegister); }
                else {
                    let displacement: Any = 8 + 16 * index;                    // type word of argument `index`
                    if (displacement < 128) { for byte: Any in [72, 131, 124, 36, displacement] { e8(ctx, byte); } } // cmp qword [rsp + d8], type
                    else { for byte: Any in [72, 131, 188, 36] { e8(ctx, byte); } e32(ctx, displacement); }       // cmp qword [rsp + d32], type
                    e8(ctx, assumed[index]);
                    jcc(ctx, 133, generic);                                   // jne
                }
            }
        }
        if (registers) { jmp(ctx, specialized); placelab(ctx, genericRegister); jmp(ctx, generic); }
        FAT_LABEL_MAP = {};
        fat_body(ctx, rec, specialized, assumed, registers);
        FAT_LABEL_MAP = nil;
        fat_body(ctx, rec, generic, [], registers);
    } else if (registers) {
        // The vector entry stays for closures and function values; a direct
        // call jumps straight to the register body.
        placelab(ctx, rec.lab);
        fat_arguments_to_registers(ctx, rec.pc);
        fat_body(ctx, rec, fat_register_label(ctx, rec), [], true);
    } else { fat_body(ctx, rec, rec.lab, [], false); }
    if (rec.wordCalled == true) { fat_word_adapter(ctx, rec); }
    ctx.allocation = 0;
    return 0;
}

// One body of `rec` at `label`, relying on parameter types `assumed`. With
// `registers` the parameters arrive in the direct-call register convention
// (fat_direct_registers) instead of the argument vector.
fun fat_body(ctx: Any, rec: Any, label: Any, assumed: Any, registers: Bool) -> Any {
    fat_begin(ctx, rec.ir, rec.boxed);
    fat_plan_types(ctx, rec.ir, rec.parr, rec.pc, false, assumed);
    fat_plan_homes(ctx, rec.ir, rec.parr, rec.pc);
    fat_plan_xmm(ctx, rec.ir);
    FAT_IN_BODY = true;
    for i: Any in 0..rec.pc { fat_declare(ctx, rec.parr[i].name, rec.parr[i].length); }
    ctx.envCaptures = rec.caparr; ctx.envCount = rec.cc;
    if (rec.cc > 0) { ctx.envSlot = loc_add(ctx, addr("0env"), 4); }
    placelab(ctx, label);
    let fp: Any = fat_prologue(ctx);
    if (rec.cc > 0) { x86_store_register(ctx, 10, fat_disp(fat_local_slot(ctx, ctx.envSlot)) - 8); }
    if (registers) {
        // Store every parameter before boxing any: rt_cell clobbers the
        // caller-saved argument registers.
        for i: Any in 0..rec.pc {
            if (i == 1) { x86_move_register(ctx, 2, 7); x86_move_register(ctx, 0, 6); }
            else if (i == 2) { x86_move_register(ctx, 2, 8); x86_move_register(ctx, 0, 9); }
            fat_store_slot(ctx, fat_local_slot(ctx, i));
        }
        for i: Any in 0..rec.pc {
            if (is_boxed(ctx, rec.parr[i].name, rec.parr[i].length) == 1) {
                fat_load_slot(ctx, fat_local_slot(ctx, i));
                fat_push(ctx); fat_rt_call(ctx, "rt_cell", 2);
                fat_store_slot(ctx, fat_local_slot(ctx, i));
            }
        }
    } else {
        for i: Any in 0..rec.pc {
            x86_load_register(ctx, 2, 0 - (16 + 16 * i)); x86_load_register(ctx, 0, 0 - (24 + 16 * i));
            if (is_boxed(ctx, rec.parr[i].name, rec.parr[i].length) == 1) { fat_push(ctx); fat_rt_call(ctx, "rt_cell", 2); }
            fat_store_slot(ctx, fat_local_slot(ctx, i));
        }
    }
    ctx.returnLabel = newlab(ctx); ctx.restartLabel = newlab(ctx);
    placelab(ctx, ctx.restartLabel); fat_forget();
    fat_ir(ctx, rec.ir);
    fat_epilogue(ctx, fp);
    FAT_IN_BODY = false;
    return 0;
}

// Top-level statements (label 1), called from _start.
fun fat_main(ctx: Any) -> Any {
    // Mark direct-call callees before any body is emitted.
    fat_plan_direct_calls(ctx);
    fat_begin(ctx, ctx.mainIR, ctx.mainBoxed);
    fat_plan_global_writes(ctx);
    fat_plan_types(ctx, ctx.mainIR, [], 0, true, []);
    fat_plan_homes(ctx, ctx.mainIR, [], 0);
    fat_plan_xmm(ctx, ctx.mainIR);
    FAT_IN_BODY = true;
    placelab(ctx, 1);
    let fp: Any = fat_prologue(ctx);
    call_rt0(ctx, addr("rt_init"), len("rt_init"));
    for gi: Any in 0..len(ctx.globals) {
        addr_of(ctx, glob_off(ctx, gi));
        call_rt1(ctx, addr("rt_gc_root"), len("rt_gc_root"));
    }
    ctx.returnLabel = newlab(ctx);
    fat_ir(ctx, ctx.mainIR);
    fat_epilogue(ctx, fp);
    FAT_IN_BODY = false;
    ctx.allocation = 0;
    return 0;
}
