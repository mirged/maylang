import "../regalloc.may";
import "x86_64_ffi.may";
import "platform_x86.may";
import "../emitter.may";
import "../symbols.may";
import "../ffi.may";
import "../state.may";
import "../ast.may";
import "../lexer.may";
import "../sema.may";
import "../ir.may";
// backend/x86_64.may — x86-64 byte encoder for linear IR.
//
// Function bodies use the SysV integer ABI and aligned frames. Small entry
// trampolines adapt Maylang's dynamically sized argument vectors (also used
// by closures) to its six argument registers and stack overflow arguments.
// The closure environment is an internal, caller-saved r10 extension.


// Raw scalar locals may reserve RBX/r12-r15 for the whole function. Linear scan
// uses the remaining r12-r15 for temporaries; control-flow values keep private
// homes. Live register roots are synchronized to the stack before tagged calls.
struct X86Instruction { bytes: Any, immediate: Any, width: Any }

fun x86_encode(ctx: Any, instruction: Any) -> Any {
    for byte: Any in instruction.bytes { e8(ctx, byte); }
    if (instruction.width == 1) { e8(ctx, instruction.immediate); }
    else if (instruction.width == 4) { e32(ctx, instruction.immediate); }
    else if (instruction.width == 8) { e64(ctx, instruction.immediate); }
    return 0;
}

fun x86_argument_to_rax(ctx: Any, index: Any) -> Any {
    if (index < 4) {
        let registers: Any = [248, 240, 208, 200];
        x86_encode(ctx, X86Instruction([72, 137, registers[index]], 0, 0));
    } else if (index == 4) { x86_encode(ctx, X86Instruction([76, 137, 192], 0, 0)); }
    else if (index == 5) { x86_encode(ctx, X86Instruction([76, 137, 200], 0, 0)); }
    else { ld_pos(ctx, 16 + 8 * (index - 6)); }
    return 0;
}

fun x86_call_trampoline(ctx: Any, rec: Any) -> Any {
    if (rec.abiLab == 0) { rec.abiLab = newlab(ctx); }
    placelab(ctx, rec.lab);
    x86_encode(ctx, X86Instruction([85, 72, 137, 229], 0, 0));
    x86_encode(ctx, X86Instruction([72, 131, 228], 240, 1));
    mut overflow: Any = rec.pc - 6;
    if (overflow < 0) { overflow = 0; }
    if (overflow % 2 == 1) { x86_encode(ctx, X86Instruction([72, 131, 236], 8, 1)); }
    mut i: Any = rec.pc - 1;
    while (i >= 6) {
        ld_pos(ctx, 16 + 8 * (rec.pc - 1 - i));
        e8(ctx, 80);
        i = i - 1;
    }
    i = 0;
    let registers: Any = [7, 6, 2, 1, 8, 9];
    while (i < rec.pc and i < 6) {
        x86_load_register(ctx, registers[i], 0 - (16 + 8 * (rec.pc - 1 - i)));
        i = i + 1;
    }
    call(ctx, rec.abiLab);
    x86_encode(ctx, X86Instruction([72, 137, 236, 93, 195], 0, 0));
    return 0;
}

// RBX and r12-r15 are excluded from instruction-selection scratch/arguments.
fun x86_store_register(ctx: Any, register: Any, displacement: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 });
    e8(ctx, 137); e8(ctx, 133 + (register % 8) * 8); e32(ctx, 0 - displacement);
    return 0;
}

fun x86_load_register(ctx: Any, register: Any, displacement: Any) -> Any {
    e8(ctx, if (register >= 8) { 76 } else { 72 });
    e8(ctx, 139); e8(ctx, 133 + (register % 8) * 8); e32(ctx, 0 - displacement);
    return 0;
}

// Literal-only intrinsics consume source metadata, not the evaluated string
// pointer. Give allocation their actual operands without changing emitted IR
// or the evaluation of argument expressions. Track local declarations in the
// same order as code emission, including names that shadow builtins.
fun x86_raw_allocation_block(ctx: Any, block: Any) -> Any {
    let code: Any = [];
    let locals: Any = {};
    for local: Any in ctx.locals { locals[symbol_name(local[0], local[1])] = true; }
    for instruction: Any in block.code {
        let payload: Any = instruction.extra;
        mut planned: Any = instruction;
        if (instruction.op == S_LET and payload.global == 0) {
            locals[symbol_name(payload.name, payload.length)] = true;
        } else if (instruction.op == E_CALL and payload.args != 0 and payload.args.kind == E_STR) {
            let name: Any = symbol_name(payload.name, payload.length);
            if ((name == "addr" or name == "cstr" or name == "len") and not has(locals, name) and
                glob_find(ctx, payload.name, payload.length) < 0 and backend_find_func(ctx, payload.name, payload.length) == 0) {
                let argument: Any = payload.args;
                if (name == "len") {
                    planned = Quad(E_INT, instruction.result, 0, 0,
                        {"value": declen(argument.span.source, argument.start, argument.length)}, instruction.span);
                } else { planned = Quad(E_STR, instruction.result, 0, 0, argument, instruction.span); }
            }
        }
        push(code, planned);
    }
    return IRBlock(code, block.temporaries);
}

// Remove unused, nontrapping raw expressions backwards so their operands
// can become dead too. Calls, loads, stores and division/remainder stay live
// for their effects or faults. Only unread copies may have multiple definitions;
// every definition is removed separately, without changing CFG positions.
fun x86_discardable(instruction: Any) -> Any {
    let op: Any = instruction.op;
    if (op == E_INT or op == E_STR or op == IR_NIL or op == IR_COPY or op == IR_BOOL or op == E_UN) { return true; }
    if (op != E_BIN) { return false; }
    let binary: Any = instruction.extra.op;
    return binary == TK_PLUS or binary == TK_MINUS or binary == TK_STAR or x86_comparison_condition(binary) >= 0;
}

fun x86_drop_reads(intervals: Any, values: Any) -> Any {
    mut value: Any = values;
    while (value != 0 and value != nil) {
        intervals[value.slot].uses -= 1; value = value.next;
    }
    return 0;
}

fun x86_discard_unused(block: Any) -> Any {
    let intervals: Any = [];
    for slot: Any in 0..block.temporaries {
        push(intervals, LiveInterval(slot, len(block.code), -1, 0, -1, -1, false, 0, 0, nil, nil, nil, nil));
    }
    mut position: Any = 0;
    for instruction: Any in block.code {
        lsra_operands(intervals, instruction, position);
        lsra_touch(intervals, instruction.result, position, true);
        position += 1;
    }
    position = len(block.code) - 1;
    while (position >= 0) {
        let instruction: Any = block.code[position];
        if (instruction.result != 0) {
            let location: Any = intervals[instruction.result.slot];
            if ((location.definitions == 1 or instruction.op == IR_COPY) and location.uses == 0 and x86_discardable(instruction)) {
                x86_drop_reads(intervals, instruction.arg1); x86_drop_reads(intervals, instruction.arg2);
                if (instruction.op == E_BIN) {
                    intervals[instruction.extra.left.slot].uses -= 1;
                    intervals[instruction.extra.right.slot].uses -= 1;
                } else if (instruction.op == E_UN) { intervals[instruction.extra.operand.slot].uses -= 1; }
                // Preserve instruction positions/CFG boundaries for the real
                // block. A zero-definition slot identifies an omitted result.
                block.code[position] = Quad(0, 0, 0, 0, 0, instruction.span);
                location.definitions -= 1;
            }
        }
        position -= 1;
    }
    return block;
}

// RAW load/store addresses (#79). A pointer built from single-use additions,
// multiplications by 1, 2, 4 or 8, imm32 literals and local snapshots becomes
// one [base + index*scale + displacement] operand. The access then lists only
// the surviving temporaries as operands, so allocation extends their intervals
// to it; absorbed instructions lose their definitions and emit nothing. Local
// snapshots stay valid: the name is not written or redeclared before the
// access. The window has no CFG boundary and at most 16 instructions. Memory
// accesses keep their order, widths and faults; only pure arithmetic moves.
struct X86AddressTerm { value: Any, name: Any, length: Any, scale: Any, position: Any }
struct X86Address { base: Any, index: Any, scale: Any, displacement: Any, value: Any }
let X86_ADDRESS_WINDOW: Any = 16;

fun x86_memory_intrinsic(name: Any) -> Any {
    return name == "load8" or name == "load16" or name == "load32" or name == "load64" or
        name == "store8" or name == "store16" or name == "store32" or name == "store64";
}

fun x86_address_plan(ctx: Any, block: Any) -> Any {
    let addresses: Any = {};
    let count: Any = len(block.code);
    let intervals: Any = [];
    for slot: Any in 0..block.temporaries {
        push(intervals, LiveInterval(slot, count, -1, 0, -1, -1, false, 0, 0, nil, nil, nil, nil));
    }
    mut position: Any = 0;
    for instruction: Any in block.code {
        lsra_operands(intervals, instruction, position);
        lsra_touch(intervals, instruction.result, position, true);
        position += 1;
    }
    let locals: Any = {};
    for local: Any in ctx.locals { locals[symbol_name(local[0], local[1])] = true; }
    position = -1;
    for instruction: Any in block.code {
        position += 1;
        let payload: Any = instruction.extra;
        if (instruction.op == S_LET and payload.global == 0) { locals[symbol_name(payload.name, payload.length)] = true; continue; }
        if (instruction.op != E_CALL or payload.args == 0) { continue; }
        let name: Any = symbol_name(payload.name, payload.length);
        if (not x86_memory_intrinsic(name) or has(locals, name) or glob_find(ctx, payload.name, payload.length) >= 0 or
            backend_find_func(ctx, payload.name, payload.length) != 0) { continue; }
        let terms: Any = []; let absorbed: Any = [];
        let displacement: Any = x86_address_terms(ctx, block, intervals, locals, payload.args, position, 1, 1, terms, absorbed, 0);
        if (displacement == nil or len(absorbed) == 0) { continue; }
        mut base: Any = 0; mut index: Any = 0;
        for term: Any in terms {
            if (term.scale == 1 and base == 0) { base = term; }
            else if (index == 0) { index = term; }
            else { base = nil; }
        }
        if (base == 0 or base == nil or displacement < -2147483648 or displacement > 2147483647) { continue; }
        // A store value that only snapshots a local is read at the access too.
        mut stored: Any = 0;
        let value: Any = payload.args.next;
        if (value != 0) {
            let interval: Any = intervals[value.slot];
            let definition: Any = if (interval.definitions == 1 and interval.start < position) { block.code[interval.start] } else { 0 };
            if (definition != 0 and definition.op == E_VAR and interval.uses == 1 and position - interval.start <= X86_ADDRESS_WINDOW and
                has(locals, symbol_name(definition.extra.name, definition.extra.length)) and is_boxed(ctx, definition.extra.name, definition.extra.length) == 0) {
                stored = X86AddressTerm(0, definition.extra.name, definition.extra.length, 1, interval.start);
                push(terms, stored); push(absorbed, interval.start);
            }
        }
        // No boundary, write or redeclaration may separate absorbed
        // instructions or local snapshots from the access.
        mut first: Any = position;
        for at: Any in absorbed { if (at < first) { first = at; } }
        if (position - first > X86_ADDRESS_WINDOW) { continue; }
        mut valid: Any = true;
        for at: Any in first..position {
            let between: Any = block.code[at];
            if (lsra_boundary(between.op)) { valid = false; }
            if (between.op == S_LET or between.op == S_ASSIGN) {
                let written: Any = symbol_name(between.extra.name, between.extra.length);
                for term: Any in terms { if (term.value == 0 and term.position < at and symbol_name(term.name, term.length) == written) { valid = false; } }
            }
        }
        if (not valid) { continue; }
        // Rewrite the planned block: the access reads the remaining temporaries.
        mut operands: Any = 0; mut last: Any = 0;
        mut remaining: Any = [];
        for term: Any in [base, index] { if (term != 0 and term.value != 0) { push(remaining, term.value); } }
        if (payload.args.next != 0 and stored == 0) { push(remaining, payload.args.next); }
        for value: Any in remaining {
            let operand: Any = ir_use(value);
            if (last == 0) { operands = operand; } else { last.next = operand; }
            last = operand;
        }
        for at: Any in absorbed { block.code[at] = Quad(0, 0, 0, 0, 0, block.code[at].span); }
        block.code[position] = Quad(E_CALL, instruction.result, 0, 0,
            {"name": payload.name, "length": payload.length, "args": operands}, instruction.span);
        addresses[position] = X86Address(base, index, if (index == 0) { 1 } else { index.scale }, displacement, stored);
    }
    return addresses;
}

// Collect address terms for `value`, recording absorbed definitions. Returns
// the accumulated displacement, or nil when the address cannot be formed.
fun x86_address_terms(ctx: Any, block: Any, intervals: Any, locals: Any, value: Any, consumer: Any, scale: Any, visits: Any, terms: Any, absorbed: Any, depth: Any) -> Any {
    let interval: Any = intervals[value.slot];
    let definition: Any = if (interval.definitions == 1 and interval.start < consumer) { block.code[interval.start] } else { 0 };
    let exclusive: Any = definition != 0 and interval.uses == visits;
    if (exclusive and definition.op == E_INT and scale == 1) { push(absorbed, interval.start); return definition.extra.value; }
    if (exclusive and depth < 3 and definition.op == E_BIN and definition.extra.left.slot != definition.extra.right.slot) {
        let left: Any = definition.extra.left; let right: Any = definition.extra.right;
        if (definition.extra.op == TK_PLUS and scale == 1) {
            let low: Any = x86_address_terms(ctx, block, intervals, locals, left, consumer, 1, 2, terms, absorbed, depth + 1);
            if (low == nil) { return nil; }
            let high: Any = x86_address_terms(ctx, block, intervals, locals, right, consumer, 1, 2, terms, absorbed, depth + 1);
            if (high == nil) { return nil; }
            push(absorbed, interval.start);
            return low + high;
        }
        if (definition.extra.op == TK_STAR and scale == 1) {
            for pair: Any in [[right, left], [left, right]] {
                let factor: Any = x86_single_literal(block, intervals, pair[0]);
                if (factor == 1 or factor == 2 or factor == 4 or factor == 8) {
                    let before: Any = len(terms);
                    let offset: Any = x86_address_terms(ctx, block, intervals, locals, pair[1], consumer, factor, 2, terms, absorbed, depth + 1);
                    if (offset == nil or len(terms) != before + 1) { return nil; }
                    push(absorbed, interval.start); push(absorbed, intervals[pair[0].slot].start);
                    return offset;
                }
            }
        }
    }
    if (exclusive and definition.op == E_VAR) {
        let name: Any = definition.extra;
        if (has(locals, symbol_name(name.name, name.length)) and is_boxed(ctx, name.name, name.length) == 0) {
            push(absorbed, interval.start);
            push(terms, X86AddressTerm(0, name.name, name.length, scale, interval.start));
            return 0;
        }
    }
    push(terms, X86AddressTerm(value, 0, 0, scale, -1));
    return 0;
}

fun x86_single_literal(block: Any, intervals: Any, value: Any) -> Any {
    let interval: Any = intervals[value.slot];
    if (interval.definitions != 1 or interval.uses != 2 or interval.start < 0) { return nil; }
    let definition: Any = block.code[interval.start];
    return if (definition.op == E_INT) { definition.extra.value } else { nil };
}

fun x86_allocate_temps(ctx: Any, block: Any) -> Any {
    ctx.tempBase = len(ctx.locals);
    let planned: Any = if (ctx.mode == 0) { x86_raw_allocation_block(ctx, block) } else { block };
    if (ctx.mode == 0 and ctx.dynamic == 0) { x86_discard_unused(planned); }
    // Rank locals before address planning absorbs their reads.
    let locals: Any = if (ctx.mode == 0 and ctx.dynamic == 0) { x86_plan_local_registers(ctx, planned) } else { 0 };
    let addresses: Any = if (ctx.mode == 0 and ctx.dynamic == 0) { x86_address_plan(ctx, planned) } else { {} };
    ctx.allocation = if (locals != 0) { lsra_plan_calls(planned, locals.temporaries, ctx.mode == 0, locals.volatile, locals.calls) }
        else { lsra_plan(planned, [12, 13, 14, 15], ctx.mode == 0) };
    ctx.allocation.addresses = addresses;
    if (locals != 0) {
        ctx.allocation.localRegisters = locals.registers;
        for register: Any in locals.used { push(ctx.allocation.used, register); }
        ctx.allocation.induction = x86_induction_locals(ctx, planned);
        ctx.allocation.jumps = x86_label_jumps(block);
    }
    if (ctx.mode == 0) {
        for location: Any in ctx.allocation.locations {
            if (location.address != nil) {
                let literal: Any = location.address;
                location.address = if (location.uses > 0) { intern(ctx, literal.span.source, literal.start, literal.length) } else { 0 };
            }
        }
        x86_unsigned_ranges(ctx, block);
    }
    for index: Any in 0..ctx.allocation.stackSlots { loc_add(ctx, addr("0temporary"), 10); }
    for register: Any in ctx.allocation.used {
        if (register >= 8 and register <= 10) { continue; }
        let slot: Any = loc_add(ctx, addr("0saved"), 6);
        push(ctx.allocation.saves, [register, 8 * (slot + 1)]);
    }
    return 0;
}

fun x86_save_registers(ctx: Any) -> Any {
    for saved: Any in ctx.allocation.saves { x86_store_register(ctx, saved[0], saved[1]); }
    return 0;
}

fun x86_restore_registers(ctx: Any) -> Any {
    for saved: Any in ctx.allocation.saves { x86_load_register(ctx, saved[0], saved[1]); }
    return 0;
}

fun x86_root_registers(ctx: Any) -> Any {
    if (ctx.dynamic == 1 and ctx.allocation != 0 and ctx.allocation.position >= 0) {
        for interval: Any in ctx.allocation.roots[ctx.allocation.position] {
            x86_store_register(ctx, interval.register, 8 * (ctx.tempBase + interval.home + 1));
        }
    }
    return 0;
}

fun cg_expr(ctx: Any, value: Any) -> Any {
    return x86_get_temp(ctx, value, 0);
}

fun x86_move_register(ctx: Any, target: Any, source: Any) -> Any {
    if (target == source) { return 0; }
    e8(ctx, 72 + if (source >= 8) { 4 } else { 0 } + if (target >= 8) { 1 } else { 0 });
    e8(ctx, 137); e8(ctx, 192 + (source % 8) * 8 + target % 8);
    return 0;
}

fun x86_local_register(ctx: Any, p: Any, length: Any) -> Any {
    if (ctx.dynamic != 0 or ctx.mode != 0 or len(ctx.allocation.localRegisters) == 0) { return -1; }
    let name: Any = symbol_name(p, length);
    if (has(ctx.allocation.localRegisters, name)) { return ctx.allocation.localRegisters[name]; }
    return -1;
}

// Operands are already evaluated IR temporaries. Loading one cannot call,
// modify another home, or clobber the other scratch register (rax/rcx).
fun x86_get_temp(ctx: Any, value: Any, target: Any) -> Any {
    let accumulator: Any = ctx.allocation.accumulator;
    // Consume the forwarding fact once. Later scratch loads in the same
    // instruction may follow arithmetic, calls, untagging, or other clobbers.
    ctx.allocation.accumulator = -1;
    if (ctx.mode == 0 and target == 0 and accumulator == value.slot) { return 0; }
    let location: Any = ctx.allocation.locations[value.slot];
    if (location.literal != nil) { x86_mov_immediate(ctx, target, location.literal); return 0; }
    if (location.address != nil) { x86_relocated_immediate(ctx, target, 1, location.address); return 0; }
    if (location.borrowed != nil) {
        if (location.borrowed < 0) { x86_move_register(ctx, target, 0 - location.borrowed - 1); }
        else { x86_load_register(ctx, target, location.borrowed); }
        return 0;
    }
    if (location.register >= 0) {
        let rex: Any = 72 + if (location.register >= 8) { 4 } else { 0 };
        e8(ctx, rex + if (target >= 8) { 1 } else { 0 });
        e8(ctx, 137); e8(ctx, 192 + (location.register % 8) * 8 + target % 8);
    } else { x86_load_register(ctx, target, 8 * (ctx.tempBase + location.home + 1)); }
    return 0;
}

fun x86_put_temp(ctx: Any, value: Any) -> Any {
    let location: Any = ctx.allocation.locations[value.slot];
    if (location.register >= 0) { e8(ctx, 73); e8(ctx, 137); e8(ctx, 192 + location.register - 8); }
    else { st_local(ctx, 8 * (ctx.tempBase + location.home + 1)); }
    return 0;
}

fun x86_handler_begin(ctx: Any, label: Any) -> Any {
    call_rt0(ctx, addr("rt_handler_limit"), len("rt_handler_limit"));
    let hd: Any = glob_find(ctx, addr("HDEPTH"), 6);
    let hs: Any = glob_find(ctx, addr("HSTACK"), 6);
    ld_abs(ctx, glob_off(ctx, hd));
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 6);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 194);
    ld_abs(ctx, glob_off(ctx, hs));
    e8(ctx, 72); e8(ctx, 1); e8(ctx, 194);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 34);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 106); e8(ctx, 8);
    addr_lab(ctx, label, 6);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 66); e8(ctx, 16);
    for byte: Any in [72,137,90,24,76,137,98,32,76,137,106,40,76,137,114,48,76,137,122,56] { e8(ctx, byte); }
    ld_abs(ctx, glob_off(ctx, hd));
    e8(ctx, 72); e8(ctx, 5); e32(ctx, 1);
    st_abs(ctx, glob_off(ctx, hd));
    return 0;
}

fun x86_handler_end(ctx: Any) -> Any {
    let hd: Any = glob_find(ctx, addr("HDEPTH"), 6);
    ld_abs(ctx, glob_off(ctx, hd));
    e8(ctx, 72); e8(ctx, 45); e32(ctx, 1);
    st_abs(ctx, glob_off(ctx, hd));
    return 0;
}

// True when no bytes separate a jump at `position` from its target (#87).
// Instructions up to the next label are unreachable and emit nothing, and
// labels emit no bytes. The return label follows the block directly.
fun x86_falls_into(block: Any, position: Any, label: Any, toReturn: Any) -> Any {
    mut index: Any = position + 1;
    while (index < len(block.code) and block.code[index].op != IR_LABEL) { index += 1; }
    while (index < len(block.code) and block.code[index].op == IR_LABEL) {
        if (not toReturn and block.code[index].extra == label) { return true; }
        index += 1;
    }
    return toReturn and index >= len(block.code);
}

fun cg_ir(ctx: Any, block: Any) -> Any {
    mut fusedBranch: Any = -1;
    ctx.allocation.accumulator = -1;
    // RAW code after an unconditional jump or return is unreachable until the
    // next label (#87); only labels are jump targets.
    let raw: Any = ctx.mode == 0 and ctx.dynamic == 0;
    mut unreachable: Any = false;
    for instruction: Any in block.code {
        ctx.allocation.position += 1;
        if (ctx.allocation.position <= fusedBranch) { continue; }
        let op: Any = instruction.op;
        let payload: Any = instruction.extra;
        if (raw) {
            if (op == IR_LABEL) { unreachable = false; }
            else if (unreachable) { continue; }
        }
        if (ctx.mode == 0) {
            let selected: Any = x86_select_region(ctx, block, ctx.allocation.position);
            if (selected >= 0) {
                ctx.allocation.accumulator = -1;
                fusedBranch = selected;
                continue;
            }
            let localOperation: Any = x86_local_operation(ctx, block, instruction);
            if (localOperation >= 0) {
                ctx.allocation.accumulator = -1;
                fusedBranch = localOperation;
                continue;
            }
            let remainderBranch: Any = x86_remainder_branch(ctx, block, instruction);
            if (remainderBranch >= 0) {
                ctx.allocation.accumulator = -1;
                fusedBranch = remainderBranch;
                continue;
            }
            if (x86_omitted_instruction(ctx, block, instruction)) { continue; }
            if (not x86_forwardable(ctx, instruction)) { ctx.allocation.accumulator = -1; }
            let branch: Any = x86_branch_comparison(ctx, block, instruction);
            if (branch >= 0) {
                cg_expr(ctx, payload.left);
                x86_rax_operand(ctx, payload.right, 59, false); // cmp rax, r/m64
                let jump: Any = block.code[branch];
                mut condition: Any = x86_comparison_condition(payload.op);
                if (jump.op == IR_FALSE) {
                    condition = if (condition % 2 == 0) { condition + 1 } else { condition - 1 };
                }
                jcc(ctx, condition, jump.extra);
                fusedBranch = branch;
                continue;
            }
        }
        if (op == IR_LABEL) { placelab(ctx, payload); }
        else if (op == IR_JUMP) {
            if (not raw or not x86_falls_into(block, ctx.allocation.position, payload, false)) { jmp(ctx, payload); }
            unreachable = raw;
        }
        else if (op == IR_COPY) { cg_expr(ctx, instruction.arg1); }
        else if (op == IR_NIL) {
            if (ctx.mode == 0) { mov_imm(ctx, 0); } else { mov_imm(ctx, 2); }
        } else if (op == IR_BOOL) { cg_expr(ctx, instruction.arg1); test_rax(ctx); setcc(ctx, 149); }
        else if (op == IR_FALSE or op == IR_TRUE) {
            cg_expr(ctx, instruction.arg1);
            if (ctx.mode == 0) {
                test_rax(ctx);
                if (op == IR_FALSE) { jcc(ctx, 132, payload); } else { jcc(ctx, 133, payload); }
            } else {
                if (op == IR_FALSE) { jfalse(ctx, payload); } else { jtrue(ctx, payload); }
            }
        } else if (op == IR_ISNIL or op == IR_NONNULL) {
            cg_expr(ctx, instruction.arg1);
            e8(ctx, 72); e8(ctx, 131); e8(ctx, 248); e8(ctx, 2);
            if (op == IR_ISNIL) { jcc(ctx, 132, payload); } else { jcc(ctx, 133, payload); }
        } else if (op == IR_RUNTIME) { cg_calln(ctx, addr(payload), len(payload), instruction.arg1); }
        else if (op == IR_RETURN) {
            cg_expr(ctx, instruction.arg1);
            if (not raw or not x86_falls_into(block, ctx.allocation.position, 0, true)) { jmp(ctx, ctx.returnLabel); }
            unreachable = raw;
        }
        else if (op == IR_TAILCALL) {
            mut arg: Any = instruction.arg1;
            mut i: Any = 0;
            while (arg != 0) {
                cg_expr(ctx, arg); st_local(ctx, 8 * (i + 1));
                i = i + 1; arg = arg.next;
            }
            jmp(ctx, ctx.restartLabel);
        }
        else if (op == IR_TRY_BEGIN) { x86_handler_begin(ctx, payload); }
        else if (op == IR_TRY_END) { x86_handler_end(ctx); }
        else if (op == S_LET) { cg_let(ctx, payload); }
        else if (op == S_ASSIGN) { cg_assign(ctx, payload); }
        else if (op == S_SETIDX) { cg_setidx(ctx, payload); }
        else if (op == S_CASSIGN) {
            cg_expr(ctx, payload.value); e8(ctx, 80);
            ld_local(ctx, 8 * (ctx.envSlot + 1));
            e8(ctx, 72); e8(ctx, 139); e8(ctx, 136); e32(ctx, 8 * payload.index);
            e8(ctx, 88); e8(ctx, 72); e8(ctx, 137); e8(ctx, 1);
        } else if (op == S_SETPROP) {
            cg_expr(ctx, payload.object); e8(ctx, 80);
            let off: Any = intern_obj(ctx, payload.span.source, payload.start, payload.length);
            addr_tag(ctx, off, 3); e8(ctx, 80);
            cg_expr(ctx, payload.value); e8(ctx, 80);
            call_rt0(ctx, addr("rt_map_set"), len("rt_map_set"));
            e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 24);
        } else { cg_operation(ctx, payload); }
        if (instruction.result != 0) {
            if (ctx.mode != 0 or ctx.allocation.locations[instruction.result.slot].uses > 0) {
                if (ctx.dynamic != 0 or ctx.mode != 0 or not x86_accumulator_only(ctx, block, instruction)) {
                    x86_put_temp(ctx, instruction.result);
                }
            }
            if (ctx.mode == 0) { ctx.allocation.accumulator = instruction.result.slot; }
        } else {
            ctx.allocation.accumulator = -1;
        }
    }
    return 0;
}

// ---------------------------------------------------------------- byte emit

fun jmp(ctx: Any, lab: Any) -> Any { e8(ctx, 233); let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 0, o, lab); return 0; }
fun jcc(ctx: Any, op: Any, lab: Any) -> Any { e8(ctx, 15); e8(ctx, op); let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 0, o, lab); return 0; }
fun call(ctx: Any, lab: Any) -> Any { x86_root_registers(ctx); e8(ctx, 232); let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 0, o, lab); return 0; }

fun mov_imm(ctx: Any, v: Any) -> Any {
    return x86_mov_immediate(ctx, 0, v);
}

fun x86_mov_immediate(ctx: Any, register: Any, v: Any) -> Any {
    // mov eax zero-extends; C7 /0 sign-extends. Preserve flags, as the old
    // movabs did, and retain all 64 bits outside these two proven ranges.
    let extended: Any = if (register >= 8) { 1 } else { 0 };
    let low: Any = register % 8;
    if (v >= 0 and v <= 4294967295) {
        if (extended == 1) { e8(ctx, 65); }
        e8(ctx, 184 + low); e32(ctx, v);
    } else if (v >= -2147483648 and v < 0) {
        e8(ctx, 72 + extended); e8(ctx, 199); e8(ctx, 192 + low); e32(ctx, v);
    } else { e8(ctx, 72 + extended); e8(ctx, 184 + low); e64(ctx, v); }
    return 0;
}
// ELF's fixed 4 MiB base and bounded image fit in zero-extended imm32, even
// for tagged data pointers. Other layouts keep the full-width relocation.
fun x86_relocated_immediate(ctx: Any, register: Any, kind: Any, target: Any) -> Any {
    let compact: Any = ctx.target.format == "elf" and (4194304 + ctx.image.capacity) * 8 <= 4294967295;
    if (compact) {
        if (register >= 8) { e8(ctx, 65); }
        e8(ctx, 184 + register % 8);
        let off: Any = ctx.code.length; e32(ctx, 0); fx(ctx, kind + 20, off, target);
    } else {
        e8(ctx, if (register >= 8) { 73 } else { 72 }); e8(ctx, 184 + register % 8);
        let off: Any = ctx.code.length; e64(ctx, 0); fx(ctx, kind, off, target);
    }
    return 0;
}

fun addr_of(ctx: Any, off: Any) -> Any { return x86_relocated_immediate(ctx, 0, 1, off); }

fun ld_local(ctx: Any, d: Any) -> Any { e8(ctx, 72); e8(ctx, 139); e8(ctx, 133); e32(ctx, 0 - d); return 0; }
fun st_local(ctx: Any, d: Any) -> Any { e8(ctx, 72); e8(ctx, 137); e8(ctx, 133); e32(ctx, 0 - d); return 0; }
fun ld_pos(ctx: Any, d: Any) -> Any { e8(ctx, 72); e8(ctx, 139); e8(ctx, 133); e32(ctx, d); return 0; }
fun ld_abs(ctx: Any, off: Any) -> Any { e8(ctx, 72); e8(ctx, 139); e8(ctx, 4); e8(ctx, 37); let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 2, o, off); return 0; }
fun st_abs(ctx: Any, off: Any) -> Any { e8(ctx, 72); e8(ctx, 137); e8(ctx, 4); e8(ctx, 37); let o: Any = ctx.code.length; e32(ctx, 0); fx(ctx, 2, o, off); return 0; }

fun test_rax(ctx: Any) -> Any { e8(ctx, 72); e8(ctx, 133); e8(ctx, 192); return 0; }
fun cmp_rcx(ctx: Any) -> Any { e8(ctx, 72); e8(ctx, 57); e8(ctx, 200); return 0; }
fun xor_eax(ctx: Any) -> Any { e8(ctx, 49); e8(ctx, 192); return 0; }
fun setcc(ctx: Any, x: Any) -> Any { e8(ctx, 15); e8(ctx, x); e8(ctx, 192); e8(ctx, 15); e8(ctx, 182); e8(ctx, 192); return 0; }

// ------------------------------------------------------------- symbol tables

// ------------------------------------------------------------- expressions

fun cg_name(ctx: Any, p: Any, l: Any) -> Any {
    let li: Any = loc_find(ctx, p, l);
    if (li >= 0) {
        let register: Any = x86_local_register(ctx, p, l);
        if (register >= 0) { x86_move_register(ctx, 0, register); return 0; }
        ld_local(ctx, 8 * (li + 1));
        return 0;
    }
    let gi: Any = glob_find(ctx, p, l);
    if (gi >= 0) { ld_abs(ctx, glob_off(ctx, gi)); return 0; }
    let fr: Any = backend_find_func(ctx, p, l);
    if (fr != 0) { cg_closure_named(ctx, fr); return 0; }
    mut vname: Any = "";
    mut q: Any = 0;
    while (q < l) { vname = vname + chr(load8(p + q)); q = q + 1; }
    die_str("mayc: unknown variable `${vname}`\n");
    return 0;
}

fun cg_closure_named(ctx: Any, fr: Any) -> Any {
    addr_lab(ctx, fr.lab, 6);
    e8(ctx, 80);
    mov_imm(ctx, 0);
    e8(ctx, 80);
    mov_imm(ctx, fr.pc);
    e8(ctx, 80);
    call_rt0(ctx, addr("rt_closure3"), len("rt_closure3"));
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 24);
    return 0;
}

fun cg_var(ctx: Any, n: Any) -> Any {
    let p: Any = n.name;
    let l: Any = n.length;
    if (ctx.mode == 0) {
        if (name_eq(p, l, addr("true"), len("true")) == 1) { mov_imm(ctx, 1); return 0; }
        if (name_eq(p, l, addr("false"), len("false")) == 1) { mov_imm(ctx, 0); return 0; }
        if (name_eq(p, l, addr("nil"), len("nil")) == 1) { mov_imm(ctx, 0); return 0; }
    }
    if (ctx.mode != 0) {
        if (name_eq(p, l, addr("nil"), len("nil")) == 1) { mov_imm(ctx, 2); return 0; }
        if (name_eq(p, l, addr("true"), len("true")) == 1) { mov_imm(ctx, 4); return 0; }
        if (name_eq(p, l, addr("false"), len("false")) == 1) { mov_imm(ctx, 3); return 0; }
        if (name_eq(p, l, addr("err"), len("err")) == 1) {
            let ei: Any = glob_find(ctx, addr("ERRVAL"), len("ERRVAL"));
            ld_abs(ctx, glob_off(ctx, ei));
            return 0;
        }
    }
    let li: Any = loc_find(ctx, p, l);
    if (li >= 0) {
        let register: Any = x86_local_register(ctx, p, l);
        if (register >= 0) { x86_move_register(ctx, 0, register); return 0; }
        ld_local(ctx, 8 * (li + 1));
        if (is_boxed(ctx, p, l) == 1) { e8(ctx, 72); e8(ctx, 139); e8(ctx, 0); }
        return 0;
    }
    cg_name(ctx, p, l);
    return 0;
}

// Positive powers of two up to 2^59, the largest the compiler's own tagged
// integers represent (#84). Shifts above 30 cannot use an imm32 bias or mask.
fun x86_divisor_shift(value: Any) -> Any {
    if (value.kind != E_INT or value.value <= 0) { return -1; }
    mut power: Any = 1; mut shift: Any = 0;
    while (power < value.value and shift < 59) { power *= 2; shift += 1; }
    return if (power == value.value) { shift } else { -1 };
}

// Lowerings that encode divisor - 1 as a positive sign-extended imm32.
fun x86_compact_divisor_shift(value: Any) -> Any {
    let shift: Any = x86_divisor_shift(value);
    return if (shift <= 30) { shift } else { -1 };
}

// rax &= 2^shift - 1 for shift above 30: mov eax, eax or shl/shr.
fun x86_wide_mask_rax(ctx: Any, shift: Any) -> Any {
    if (shift == 32) { e8(ctx, 137); e8(ctx, 192); return 0; }
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 64 - shift);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 232); e8(ctx, 64 - shift);
    return 0;
}

fun x86_signed_power_divide(ctx: Any, divisor: Any, shift: Any, remainder: Any) -> Any {
    // rax is an untagged signed integer. Bias negatives so shifting truncates
    // toward zero; subtract the same bias to give remainder the dividend's sign.
    for byte: Any in [72,137,193,72,193] { e8(ctx, byte); }
    e8(ctx, if (shift == 1) { 233 } else { 249 }); e8(ctx, 63);
    if (shift > 30) { e8(ctx, 72); e8(ctx, 193); e8(ctx, 233); e8(ctx, 64 - shift); } // shr rcx: 2^shift - 1 or 0
    else if (shift != 1) { e8(ctx, 72); e8(ctx, 129); e8(ctx, 225); e32(ctx, divisor - 1); }
    e8(ctx, 72); e8(ctx, 1); e8(ctx, 200);
    if (remainder) {
        if (shift > 30) { x86_wide_mask_rax(ctx, shift); }
        else { e8(ctx, 72); e8(ctx, 37); e32(ctx, divisor - 1); }
        e8(ctx, 72); e8(ctx, 41); e8(ctx, 200);
    } else { e8(ctx, 72); e8(ctx, 193); e8(ctx, 248); e8(ctx, shift); }
    return 0;
}

// maximum != nil means the complete raw value is proven in [0, maximum].
// Facts belong to single-definition snapshots. Mutable locals require the
// separate inductive proof below; their allocation and private homes stay fixed.
fun x86_unsigned_ranges(ctx: Any, block: Any) -> Any {
    let recurrences: Any = if (ctx.dynamic == 0) { x86_local_recurrences(ctx, block) } else { {} };
    let shadowed: Any = {};
    for local: Any in ctx.locals { shadowed[symbol_name(local[0], local[1])] = true; }
    for instruction: Any in block.code {
        if (instruction.op == S_LET) { shadowed[symbol_name(instruction.extra.name, instruction.extra.length)] = true; }
    }
    mut position: Any = -1;
    for instruction: Any in block.code {
        position += 1;
        if (instruction.result == 0) { continue; }
        let location: Any = ctx.allocation.locations[instruction.result.slot];
        if (location.definitions != 1 or location.start != position) { continue; }
        let op: Any = instruction.op; let payload: Any = instruction.extra;
        if (op == E_INT and payload.value >= 0) { location.maximum = payload.value; }
        else if (op == E_VAR) {
            let name: Any = symbol_name(payload.name, payload.length);
            if (has(recurrences, name) and recurrences[name].valid) { location.maximum = recurrences[name].maximum; }
        } else if (op == IR_NIL) { location.maximum = 0; }
        else if (op == IR_BOOL or (op == E_UN and payload.op == TK_NOT)) { location.maximum = 1; }
        else if (op == IR_COPY) { location.maximum = ctx.allocation.locations[instruction.arg1.slot].maximum; }
        else if (op == E_CALL) {
            let name: Any = symbol_name(payload.name, payload.length);
            if (name != "load8" and name != "load16" and name != "load32") { continue; }
            if (shadowed[name] == true or glob_find(ctx, payload.name, payload.length) >= 0 or
                backend_find_func(ctx, payload.name, payload.length) != 0) { continue; }
            location.maximum = if (name == "load8") { 255 } else if (name == "load16") { 65535 } else { 4294967295 };
        } else if (op == E_BIN) {
            if (x86_comparison_condition(payload.op) >= 0) { location.maximum = 1; continue; }
            let left: Any = ctx.allocation.locations[payload.left.slot];
            let right: Any = ctx.allocation.locations[payload.right.slot];
            if (left.maximum == nil or right.maximum == nil) { continue; }
            let a: Any = left.maximum; let b: Any = right.maximum;
            // Stay within the compiler's tagged arithmetic range. This is a
            // conservative subset of the raw signed range and proves no wrap.
            if (payload.op == TK_PLUS and a <= 1152921504606846975 - b) { location.maximum = a + b; }
            else if (payload.op == TK_STAR and (b == 0 or a <= 1152921504606846975 / b)) { location.maximum = a * b; }
            else if (right.literal != nil and right.literal > 0) {
                if (payload.op == TK_SLASH) { location.maximum = a / right.literal; }
                else if (payload.op == TK_PCT) { location.maximum = if (a < right.literal) { a } else { right.literal - 1 }; }
            }
        }
    }
    return 0;
}

fun x86_single_definition(ctx: Any, block: Any, value: Any) -> Any {
    let location: Any = ctx.allocation.locations[value.slot];
    if (location.definitions != 1 or location.start < 0) { return 0; }
    return block.code[location.start];
}

fun x86_recurrence_step(ctx: Any, block: Any, value: Any, name: Any) -> Any {
    let remainder: Any = x86_single_definition(ctx, block, value);
    if (remainder == 0 or remainder.op != E_BIN or remainder.extra.op != TK_PCT) { return 0; }
    let divisor: Any = ctx.allocation.locations[remainder.extra.right.slot].literal;
    if (divisor == nil or divisor <= 0) { return 0; }
    let product: Any = x86_single_definition(ctx, block, remainder.extra.left);
    if (product == 0 or product.op != E_BIN or product.extra.op != TK_STAR) { return 0; }
    let factor: Any = ctx.allocation.locations[product.extra.right.slot].literal;
    if (factor == nil or factor < 0) { return 0; }
    let previous: Any = x86_single_definition(ctx, block, product.extra.left);
    if (previous == 0 or previous.op != E_VAR or
        symbol_name(previous.extra.name, previous.extra.length) != name) { return 0; }
    return [divisor - 1, factor];
}

struct X86LocalRecurrence { maximum: Any, factor: Any, valid: Any }

fun x86_scalar_instruction(op: Any) -> Any {
    return op == 0 or op == E_INT or op == E_VAR or op == E_BIN or op == E_UN or
        op == IR_COPY or op == IR_BOOL or op == IR_NIL or op == S_LET or op == S_ASSIGN or
        op == IR_LABEL or op == IR_JUMP or op == IR_FALSE or op == IR_TRUE or op == IR_RETURN;
}

struct X86LocalCandidate { name: Any, score: Any, valid: Any, register: Any }

// Loop nesting per IR position: the last backward jump to each label closes
// one loop, so continue edges do not count twice (#86).
fun x86_loop_depths(block: Any) -> Any {
    let labels: Any = {}; let ends: Any = {}; let depths: Any = [];
    mut position: Any = 0;
    for instruction: Any in block.code {
        if (instruction.op == IR_LABEL) { labels[instruction.extra] = position; }
        push(depths, 0); position += 1;
    }
    position = 0;
    for instruction: Any in block.code {
        let op: Any = instruction.op;
        if ((op == IR_JUMP or op == IR_FALSE or op == IR_TRUE) and has(labels, instruction.extra) and
            labels[instruction.extra] < position) { ends[instruction.extra] = position; }
        position += 1;
    }
    for label: Any in keys(ends) {
        for index: Any in labels[label]..(ends[label] + 1) { depths[index] += 1; }
    }
    return depths;
}

// RAW calls that keep RBX/r12-r15 and every local intact (#86): resolved,
// non-foreign user functions save the callee-saved registers they use, and
// syscall/exit clobber rax/rcx/r11 only. Builtins named __* are dispatched
// before user functions and stay excluded, including __sp.
fun x86_preserving_call(ctx: Any, payload: Any, name: Any) -> Any {
    if (name == "syscall" or name == "exit" or name == "addr" or name == "cstr" or name == "len" or name == "ptr") { return true; }
    if (starts_with(name, "__")) { return false; }
    let callee: Any = backend_find_func(ctx, payload.name, payload.length);
    return callee != 0 and callee.foreign != true;
}

// Reserve dedicated callee-saved registers for frequently used scalar locals
// and parameters (#86). Their homes last for the whole function, including
// every join/backedge. This does not relax virtual-temporary liveness:
// captures, closures and other non-scalar constructs exclude a body.
// Unshadowed RAW load/store intrinsics (#79) and preserving calls are allowed.
// Maylang has no address-of operator for locals, so no pointer can name a
// local's frame slot, and only __sp exposes the stack, which remains excluded.
// Promotion does not reorder memory accesses, calls or their faults.
fun x86_plan_local_registers(ctx: Any, block: Any) -> Any {
    if (ctx.envCount > 0 or len(ctx.boxed) > 0) { return 0; }
    let names: Any = {}; let seen: Any = {}; let ordered: Any = [];
    mut calls: Any = false;
    // Per position: 1 for a user call, 2 for syscall/exit (#87).
    let clobbers: Any = [];
    // Each visit weighs 8x per enclosing loop, up to three levels.
    let depths: Any = x86_loop_depths(block);
    mut position: Any = -1;
    // The prologue moves each promoted parameter from its ABI location.
    for local: Any in ctx.locals {
        let name: Any = symbol_name(local[0], local[1]);
        if (has(names, name)) { names[name].valid = false; continue; }
        let candidate: Any = X86LocalCandidate(name, 0, true, -1);
        names[name] = candidate; push(ordered, candidate); seen[name] = true;
    }
    for instruction: Any in block.code {
        let op: Any = instruction.op; let payload: Any = instruction.extra;
        position += 1;
        push(clobbers, 0);
        if (op == E_CALL) {
            let name: Any = symbol_name(payload.name, payload.length);
            if (has(seen, name) or glob_find(ctx, payload.name, payload.length) >= 0) { return 0; }
            if (x86_memory_intrinsic(name) and backend_find_func(ctx, payload.name, payload.length) == 0) { continue; }
            if (x86_preserving_call(ctx, payload, name)) {
                calls = true;
                if (name == "syscall" or name == "exit") { clobbers[position] = 2; }
                else if (name != "addr" and name != "cstr" and name != "len" and name != "ptr") { clobbers[position] = 1; }
                continue;
            }
            return 0;
        }
        if (not x86_scalar_instruction(op)) { return 0; }
        if (op == S_LET or op == S_ASSIGN or op == E_VAR) {
            let name: Any = symbol_name(payload.name, payload.length);
            let depth: Any = if (depths[position] > 3) { 3 } else { depths[position] };
            let weight: Any = if (depth == 0) { 1 } else if (depth == 1) { 8 } else if (depth == 2) { 64 } else { 512 };
            if (op == S_LET) {
                if (has(names, name)) { names[name].valid = false; continue; }
                let candidate: Any = X86LocalCandidate(name, weight, payload.global == 0 and
                    not has(seen, name) and is_boxed(ctx, payload.name, payload.length) == 0, -1);
                names[name] = candidate; push(ordered, candidate); seen[name] = true;
            } else if (has(names, name)) { names[name].score += weight; }
            else if (not has(seen, name)) { return 0; }
        }
    }
    let registers: Any = {}; let used: Any = [];
    for register: Any in [3, 12, 13, 14, 15] {
        mut best: Any = 0;
        for candidate: Any in ordered {
            if (candidate.valid and candidate.register < 0 and candidate.score >= 4 and
                (best == 0 or candidate.score > best.score)) { best = candidate; }
        }
        if (best == 0) { break; }
        best.register = register; registers[best.name] = register; push(used, register);
    }
    // Call-free bodies also hold temporaries in the volatile r8-r10 (#79).
    // With calls, intervals that no call clobbers use them (#87); calls and
    // syscalls take arguments there. Operand encodings require extended
    // registers; r11 remains the large-literal scratch.
    let temporaries: Any = if (calls) { [] } else { [10, 9, 8] };
    for register: Any in [12, 13, 14, 15] {
        mut reserved: Any = false;
        for local: Any in used { if (local == register) { reserved = true; } }
        if (not reserved) { push(temporaries, register); }
    }
    return {"registers": registers, "used": used, "temporaries": temporaries,
        "volatile": if (calls) { [10, 9, 8] } else { [] }, "calls": if (calls) { clobbers } else { [] }};
}

// Prove an inductive bound for x = x * c % d. Every write is checked;
// the initial value and every d-1 fit the bound, and bound*c cannot wrap.
// Only scalar functions without calls, memory operations, captures or aliasing
// constructs qualify. Duplicate declarations and reads before declaration
// exclude a name. This analysis never changes allocation or loop-cell homes.
fun x86_local_recurrences(ctx: Any, block: Any) -> Any {
    let locals: Any = {}; let seen: Any = {};
    for local: Any in ctx.locals { seen[symbol_name(local[0], local[1])] = true; }
    for instruction: Any in block.code {
        let op: Any = instruction.op; let payload: Any = instruction.extra;
        if (not x86_scalar_instruction(op)) { return {}; }
        if (op == E_VAR or op == S_LET or op == S_ASSIGN) {
            let name: Any = symbol_name(payload.name, payload.length);
            if (op == S_LET) {
                if (has(locals, name)) { locals[name].valid = false; continue; }
                let initial: Any = ctx.allocation.locations[payload.initializer.slot].literal;
                locals[name] = X86LocalRecurrence(initial, 0, initial != nil and initial >= 0 and
                    payload.global == 0 and not has(seen, name) and is_boxed(ctx, payload.name, payload.length) == 0);
                seen[name] = true;
            } else if (not has(locals, name)) { seen[name] = true; }
            else if (op == S_ASSIGN and locals[name].valid) {
                let step: Any = x86_recurrence_step(ctx, block, payload.value, name);
                if (step == 0) { locals[name].valid = false; continue; }
                if (step[0] > locals[name].maximum) { locals[name].maximum = step[0]; }
                if (step[1] > locals[name].factor) { locals[name].factor = step[1]; }
            }
        }
    }
    for name: Any in keys(locals) {
        let local: Any = locals[name];
        if (local.valid and local.factor > 0 and local.maximum > 1152921504606846975 / local.factor) { local.valid = false; }
    }
    return locals;
}

fun x86_unsigned_power_divide(ctx: Any, divisor: Any, shift: Any, remainder: Any) -> Any {
    if (remainder) {
        let mask: Any = divisor - 1;
        if (mask == 0) { mov_imm(ctx, 0); }
        else if (shift > 30) { x86_wide_mask_rax(ctx, shift); }
        else {
            e8(ctx, 72); e8(ctx, if (mask <= 127) { 131 } else { 129 }); e8(ctx, 224);
            if (mask <= 127) { e8(ctx, mask); } else { e32(ctx, mask); }
        }
    } else if (shift > 0) { e8(ctx, 72); e8(ctx, 193); e8(ctx, 232); e8(ctx, shift); }
    return 0;
}

struct X86SignedReciprocal { low: Any, high: Any, shift: Any }

fun x86_signed_reciprocal(divisor: Any) -> Any {
    if (divisor < 3) { return 0; }
    // Divide 2^64 by d, keeping the quotient in two unsigned 32-bit limbs.
    // Tagged compiler integers cannot hold a general 64-bit multiplier.
    mut low: Any = 0; mut high: Any = 0; mut rest: Any = 1;
    mut shift: Any = 0; mut bound: Any = 2;
    mut bits: Any = 0;
    while (bits < 64 or divisor - rest > bound) {
        // This form of 2*rest avoids tagged overflow even for d near 2^60.
        let carry: Any = if (rest >= divisor - rest) { 1 } else { 0 };
        rest = if (carry == 1) { rest - (divisor - rest) } else { rest * 2 };
        let doubled: Any = low * 2 + carry;
        high = high * 2 + doubled / 4294967296;
        low = doubled % 4294967296;
        if (bits >= 64) {
            shift += 1;
            bound = if (bound >= divisor - bound) { divisor } else { bound * 2 };
        }
        bits += 1;
    }
    // Exact reciprocals are powers of two. Keep their existing fast path or
    // idiv fallback: the signed rounding correction below assumes nonzero error.
    if (rest == 0) { return 0; }
    low += 1;
    if (low == 4294967296) { low = 0; high += 1; }
    // m = ceil(2^(64+shift)/d), with 0 < m*d - 2^(64+shift)
    // <= 2^(shift+1). This error bound makes floor(n*m/2^(64+shift))
    // exact for nonnegative signed n; adding n's sign bit truncates negatives.
    return X86SignedReciprocal(low, high, shift);
}

fun x86_signed_constant_divide(ctx: Any, n: Any, magic: Any, remainder: Any) -> Any {
    cg_expr(ctx, n.left);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 193); // mov rcx, rax: original dividend
    e8(ctx, 72); e8(ctx, 186); e32(ctx, magic.low); e32(ctx, magic.high);
    e8(ctx, 72); e8(ctx, 247); e8(ctx, 234); // imul rdx: signed high product
    if (magic.high >= 2147483648) {
        // The encoded multiplier is negative; restore the missing 2^64*n.
        e8(ctx, 72); e8(ctx, 1); e8(ctx, 202); // add rdx, rcx
    }
    if (magic.shift > 0) { e8(ctx, 72); e8(ctx, 193); e8(ctx, 250); e8(ctx, magic.shift); }
    if (ctx.allocation.locations[n.left.slot].maximum != nil) {
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 208); // mov rax, rdx: nonnegative quotient
    } else {
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 200); // mov rax, rcx
        e8(ctx, 72); e8(ctx, 193); e8(ctx, 232); e8(ctx, 63); // shr rax, 63
        e8(ctx, 72); e8(ctx, 1); e8(ctx, 208); // add rax, rdx: truncated quotient
    }
    if (remainder) {
        x86_rax_operand(ctx, n.right, 175, true); // q*d; operand home is untouched
        e8(ctx, 72); e8(ctx, 41); e8(ctx, 193); // sub rcx, rax
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 200); // mov rax, rcx
    }
    return 0;
}

fun x86_comparison_condition(op: Any) -> Any {
    if (op == TK_EQ) { return 132; }
    if (op == TK_NE) { return 133; }
    if (op == TK_LT) { return 140; }
    if (op == TK_LE) { return 142; }
    if (op == TK_GT) { return 143; }
    if (op == TK_GE) { return 141; }
    return -1;
}

fun x86_dead_copy(ctx: Any, instruction: Any) -> Any {
    return instruction.op == IR_COPY and ctx.allocation.locations[instruction.result.slot].uses == 0;
}

// These instructions emit nothing and cannot change a predicate. Keep this
// stricter than general omission: no deferred loads or control-flow edges.
fun x86_predicate_gap(ctx: Any, instruction: Any) -> Any {
    if (instruction.op == 0 or x86_dead_copy(ctx, instruction)) { return true; }
    return instruction.op == E_INT and ctx.allocation.locations[instruction.result.slot].literal != nil;
}

fun x86_local_reader(ctx: Any, block: Any, value: Any, visits: Any) -> Any {
    let location: Any = ctx.allocation.locations[value.slot];
    if (location.definitions != 1 or location.uses != visits or location.end <= location.start) { return -1; }
    for position: Any in (location.start + 1)..location.end {
        if (not x86_predicate_gap(ctx, block.code[position])) { return -1; }
    }
    return location.end;
}

// Exclusive local read/arithmetic/write chains operate on the dedicated local
// register. Observable intermediate values and every intervening effect retain
// snapshots. Branch predicates may compare that register without a rax copy.
fun x86_local_operation(ctx: Any, block: Any, instruction: Any) -> Any {
    if (ctx.dynamic != 0 or instruction.op != E_VAR) { return -1; }
    let name: Any = instruction.extra;
    let register: Any = x86_local_register(ctx, name.name, name.length);
    if (register < 0) { return -1; }
    let reader: Any = x86_local_reader(ctx, block, instruction.result, 2);
    if (reader < 0) { return -1; }
    let operation: Any = block.code[reader];
    if (operation.op != E_BIN or operation.extra.left.slot != instruction.result.slot) { return -1; }
    let op: Any = operation.extra.op;
    let literal: Any = ctx.allocation.locations[operation.extra.right.slot].literal;
    if (literal == nil or literal < -2147483648 or literal > 2147483647) { return -1; }
    let condition: Any = x86_comparison_condition(op);
    if (condition >= 0) {
        let branch: Any = x86_branch_comparison_at(ctx, block, operation, reader);
        if (branch < 0) { return -1; }
        x86_register_immediate(ctx, register, 7, literal);
        let jump: Any = block.code[branch];
        jcc(ctx, if (jump.op == IR_FALSE) { if (condition % 2 == 0) { condition + 1 } else { condition - 1 } } else { condition }, jump.extra);
        return branch;
    }
    let divide: Any = op == TK_SLASH or op == TK_PCT;
    let shift: Any = if (divide) { x86_compact_divisor_shift(operation.extra.right) } else { -1 };
    if (op != TK_PLUS and op != TK_MINUS and op != TK_STAR and (not divide or shift < 0)) { return -1; }
    mut result: Any = operation.result;
    mut offset: Any = 0;
    if (op == TK_STAR) {
        if (literal != 3 and literal != 5 and literal != 9) { return -1; }
        let next: Any = x86_local_reader(ctx, block, result, 2);
        if (next < 0) { return -1; }
        let add: Any = block.code[next];
        if (add.op == E_BIN and add.extra.op == TK_PLUS and add.extra.left.slot == result.slot) {
            offset = ctx.allocation.locations[add.extra.right.slot].literal;
            if (offset == nil or offset < -2147483648 or offset > 2147483647) { return -1; }
            result = add.result;
        }
    }
    let end: Any = x86_local_reader(ctx, block, result, 2);
    if (end < 0) { return -1; }
    let assignment: Any = block.code[end];
    if (assignment.op != S_ASSIGN or assignment.extra.value.slot != result.slot or
        symbol_name(assignment.extra.name, assignment.extra.length) != symbol_name(name.name, name.length)) { return -1; }
    if (divide) {
        x86_local_power_divide(ctx, register, literal, shift, op == TK_PCT,
            ctx.allocation.locations[instruction.result.slot].maximum != nil);
    } else if (op == TK_STAR) {
        let narrow: Any = offset >= -128 and offset <= 127;
        e8(ctx, if (register >= 8) { 79 } else { 72 }); e8(ctx, 141);
        e8(ctx, (if (narrow) { 64 } else { 128 }) + (register % 8) * 8 + 4);
        e8(ctx, (if (literal == 3) { 64 } else if (literal == 5) { 128 } else { 192 }) + (register % 8) * 8 + register % 8);
        if (narrow) { e8(ctx, offset); } else { e32(ctx, offset); }
    } else { x86_register_immediate(ctx, register, if (op == TK_PLUS) { 0 } else { 5 }, literal); }
    return end;
}

fun x86_local_power_divide(ctx: Any, register: Any, divisor: Any, shift: Any, remainder: Any, nonnegative: Any) -> Any {
    let rex: Any = if (register >= 8) { 73 } else { 72 };
    if (shift == 0 or nonnegative) {
        if (remainder) { x86_register_immediate(ctx, register, 4, divisor - 1); }
        else if (shift > 0) { e8(ctx, rex); e8(ctx, 193); e8(ctx, 232 + register % 8); e8(ctx, shift); }
        return 0;
    }
    x86_move_register(ctx, 1, register);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, if (shift == 1) { 233 } else { 249 }); e8(ctx, 63);
    if (shift != 1) { x86_register_immediate(ctx, 1, 4, divisor - 1); }
    e8(ctx, rex); e8(ctx, 1); e8(ctx, 200 + register % 8); // add local, rcx
    if (remainder) {
        x86_register_immediate(ctx, register, 4, divisor - 1);
        e8(ctx, rex); e8(ctx, 41); e8(ctx, 200 + register % 8); // sub local, rcx
    } else { e8(ctx, rex); e8(ctx, 193); e8(ctx, 248 + register % 8); e8(ctx, shift); }
    return 0;
}

fun x86_register_immediate(ctx: Any, register: Any, operation: Any, literal: Any) -> Any {
    let narrow: Any = literal >= -128 and literal <= 127;
    e8(ctx, if (register >= 8) { 73 } else { 72 });
    e8(ctx, if (narrow) { 131 } else { 129 }); e8(ctx, 192 + operation * 8 + register % 8);
    if (narrow) { e8(ctx, literal); } else { e32(ctx, literal); }
    return 0;
}

fun x86_omitted_instruction(ctx: Any, block: Any, instruction: Any) -> Any {
    let op: Any = instruction.op;
    if (instruction.result != 0) {
        let location: Any = ctx.allocation.locations[instruction.result.slot];
        if (location.definitions == 0 and location.uses == 0) { return true; }
        if (location.literal != nil or location.address != nil) { return true; }
        if (op == E_STR and location.uses == 0) { return true; }
        if (op == E_VAR and location.uses == 0 and ctx.dynamic == 0) {
            let name: Any = instruction.extra;
            if (is_boxed(ctx, name.name, name.length) == 0 and
                (loc_find(ctx, name.name, name.length) >= 0 or glob_find(ctx, name.name, name.length) >= 0)) { return true; }
        }
    }
    if (op == IR_NIL and ctx.allocation.locations[instruction.result.slot].uses == 0) { return true; }
    if (op == E_VAR and x86_borrow_operand(ctx, block, instruction)) { return true; }
    return x86_dead_copy(ctx, instruction);
}

fun x86_borrow_operand(ctx: Any, block: Any, instruction: Any) -> Any {
    if (ctx.dynamic != 0) { return false; }
    let location: Any = ctx.allocation.locations[instruction.result.slot];
    if (location.definitions != 1 or location.uses != 2 or location.end != location.start + 1) { return false; }
    let definition: Any = block.code[location.start];
    if (definition.op != E_VAR or definition.result.slot != instruction.result.slot) { return false; }
    let reader: Any = block.code[location.end];
    if (reader.op != E_BIN or reader.extra.right.slot != instruction.result.slot) { return false; }
    // Only the immediately following pure binary instruction can read this
    // snapshot. No call, assignment, memory store, or control-flow edge moves
    // between the variable read and its use. Boxed/global reads stay explicit.
    let payload: Any = instruction.extra;
    let local: Any = loc_find(ctx, payload.name, payload.length);
    if (local < 0 or is_boxed(ctx, payload.name, payload.length) == 1) { return false; }
    let register: Any = x86_local_register(ctx, payload.name, payload.length);
    location.borrowed = if (register >= 0) { 0 - register - 1 } else { 8 * (local + 1) };
    return true;
}

fun x86_accumulator_only(ctx: Any, block: Any, instruction: Any) -> Any {
    let location: Any = ctx.allocation.locations[instruction.result.slot];
    if (location.definitions != 1 or location.start != ctx.allocation.position) { return false; }
    mut next: Any = ctx.allocation.position + 1;
    while (next < len(block.code) and x86_omitted_instruction(ctx, block, block.code[next])) { next += 1; }
    if (next >= len(block.code) or location.end != next) { return false; }
    let reader: Any = block.code[next];
    if (not x86_forwardable(ctx, reader)) { return false; }
    let op: Any = reader.op;
    mut first: Any = reader.arg1;
    mut visits: Any = 1;
    // lsra_operands conservatively visits both arg1 and payload for these ops.
    if (op == E_BIN) { first = reader.extra.left; visits = 2; }
    else if (op == E_UN) { first = reader.extra.operand; }
    else if (op == S_LET) { first = reader.extra.initializer; visits = 2; }
    else if (op == S_ASSIGN) { first = reader.extra.value; visits = 2; }
    else if (op == E_CALL) { first = reader.extra.args; }
    return first != 0 and first.slot == instruction.result.slot and location.uses == visits;
}

fun x86_forwardable(ctx: Any, instruction: Any) -> Any {
    let op: Any = instruction.op;
    // Each allowed lowering reads its first IR operand before changing rax.
    // Labels/joins and all other operations invalidate the fact. In particular,
    // Windows __host_write calls GetStdHandle before loading its first operand.
    if (op == E_BIN or op == E_UN or op == IR_COPY or op == IR_RETURN or
        op == IR_BOOL or op == IR_FALSE or op == IR_TRUE or op == S_LET or op == S_ASSIGN) { return true; }
    if (op == E_CALL) {
        let payload: Any = instruction.extra;
        let name: Any = symbol_name(payload.name, payload.length);
        if (name != "ptr" and name != "load8" and name != "load16" and name != "load32" and name != "load64" and
            name != "store8" and name != "store16" and name != "store32" and name != "store64") { return false; }
        if (loc_find(ctx, payload.name, payload.length) >= 0 or glob_find(ctx, payload.name, payload.length) >= 0 or
            backend_find_func(ctx, payload.name, payload.length) != 0) { return false; }
        return name == "ptr" or name == "load8" or name == "load16" or name == "load32" or name == "load64" or
            name == "store8" or name == "store16" or name == "store32" or name == "store64";
    }
    return false;
}

fun x86_branch_comparison(ctx: Any, block: Any, instruction: Any) -> Any {
    return x86_branch_comparison_at(ctx, block, instruction, ctx.allocation.position);
}

fun x86_branch_comparison_at(ctx: Any, block: Any, instruction: Any, position: Any) -> Any {
    if (instruction.op != E_BIN or x86_comparison_condition(instruction.extra.op) < 0) { return -1; }
    let location: Any = ctx.allocation.locations[instruction.result.slot];
    if (location.definitions != 1 or location.start != position) { return -1; }
    mut next: Any = position + 1;
    // Statement ifs leave unused result copies between the comparison and
    // branch. Only copies with no readers anywhere in the block may be skipped.
    while (next < len(block.code) and x86_dead_copy(ctx, block.code[next])) { next += 1; }
    if (next >= len(block.code) or location.end != next) { return -1; }
    let branch: Any = block.code[next];
    if ((branch.op == IR_FALSE or branch.op == IR_TRUE) and branch.arg1.slot == instruction.result.slot) { return next; }
    return -1;
}

// Signed n % 2^k is zero exactly when n's low k bits are zero, including
// negative n and INT64_MIN. The remainder itself must remain unobservable.
fun x86_remainder_branch(ctx: Any, block: Any, instruction: Any) -> Any {
    if (ctx.dynamic != 0 or instruction.op != E_BIN or instruction.extra.op != TK_PCT) { return -1; }
    let payload: Any = instruction.extra;
    if (x86_compact_divisor_shift(payload.right) < 0) { return -1; }
    if (ctx.allocation.locations[payload.right.slot].literal != payload.right.value) { return -1; }
    let location: Any = ctx.allocation.locations[instruction.result.slot];
    if (location.definitions != 1 or location.uses != 2 or location.start != ctx.allocation.position or location.end <= location.start) { return -1; }
    for index: Any in (location.start + 1)..location.end {
        if (not x86_predicate_gap(ctx, block.code[index])) { return -1; }
    }
    let compare: Any = block.code[location.end];
    if (compare.op != E_BIN or (compare.extra.op != TK_EQ and compare.extra.op != TK_NE)) { return -1; }
    let left: Any = compare.extra.left; let right: Any = compare.extra.right;
    if (left.slot == instruction.result.slot) {
        if (ctx.allocation.locations[right.slot].literal != 0) { return -1; }
    } else if (right.slot == instruction.result.slot) {
        if (ctx.allocation.locations[left.slot].literal != 0) { return -1; }
    } else { return -1; }
    let branch: Any = x86_branch_comparison_at(ctx, block, compare, location.end);
    if (branch < 0) { return -1; }
    cg_expr(ctx, payload.left);
    e8(ctx, 72); e8(ctx, 169); e32(ctx, payload.right.value - 1); // test rax, imm32
    mut condition: Any = x86_comparison_condition(compare.extra.op);
    if (block.code[branch].op == IR_FALSE) {
        condition = if (condition % 2 == 0) { condition + 1 } else { condition - 1 };
    }
    jcc(ctx, condition, block.code[branch].extra);
    return branch;
}

// Short statement diamonds over dedicated local registers can run without
// branches (#78). Both arms are evaluated speculatively into caller-saved
// scratch registers; conditional moves then select each surviving value and
// the dedicated homes are written once. Only register arithmetic qualifies:
// it cannot call, touch memory or fault, and wraps exactly like the branch
// form. Division/remainder accept positive power-of-two literals only, which
// never trap. Observable if-results, temporaries that outlive the region or a
// nested diamond, frame/global names, other control flow and every
// unsupported instruction keep the branches. A rejected match rolls back the
// bytes it emitted; it adds no labels, fixups or relocations.
let X86_SELECT_SCRATCH: Any = [11, 10, 9, 8, 7, 6, 2, 1, 0];
let X86_SELECT_LIMIT: Any = 16;
let X86_SELECT_PREFIX: Any = 8;

// kind: 0 register, 1 literal, 2 lazy comparison, 3 lazy signed % 2^literal.
struct X86SelectValue { kind: Any, register: Any, literal: Any, op: Any, left: Any, right: Any }
struct X86Select { env: Any, values: Any, free: Any, cost: Any, valid: Any, data: Any }

fun x86_select_register(register: Any) -> Any { return X86SelectValue(0, register, nil, 0, 0, 0); }
fun x86_select_literal(literal: Any) -> Any { return X86SelectValue(1, -1, literal, 0, 0, 0); }

fun x86_select_scratch(plan: Any) -> Any {
    if (len(plan.free) == 0) { plan.valid = false; return -1; }
    return pop(plan.free);
}

fun x86_select_dedicated(register: Any) -> Any {
    return register == 3 or register >= 12;
}

fun x86_select_extended(reg: Any, rm: Any) -> Any {
    return 72 + if (reg >= 8) { 4 } else { 0 } + if (rm >= 8) { 1 } else { 0 };
}

// op r/m64, r64 for add (1), sub (41) and cmp (57).
fun x86_select_register_operation(ctx: Any, opcode: Any, target: Any, source: Any) -> Any {
    e8(ctx, x86_select_extended(source, target)); e8(ctx, opcode); e8(ctx, 192 + (source % 8) * 8 + target % 8);
    return 0;
}

fun x86_select_shift(ctx: Any, register: Any, extension: Any, count: Any) -> Any {
    e8(ctx, if (register >= 8) { 73 } else { 72 }); e8(ctx, 193); e8(ctx, 192 + extension * 8 + register % 8); e8(ctx, count);
    return 0;
}

// lea target, [base + index*scale + displacement]; index < 0 omits it.
fun x86_select_lea(ctx: Any, target: Any, base: Any, index: Any, scale: Any, displacement: Any) -> Any {
    e8(ctx, 72 + if (target >= 8) { 4 } else { 0 } + if (index >= 8) { 2 } else { 0 } + if (base >= 8) { 1 } else { 0 });
    e8(ctx, 141);
    let narrow: Any = displacement >= -128 and displacement <= 127;
    // [rbp]/[r13] has no displacement-free form.
    let mode: Any = if (displacement == 0 and base % 8 != 5) { 0 } else if (narrow) { 64 } else { 128 };
    if (index < 0 and base % 8 != 4) { e8(ctx, mode + (target % 8) * 8 + base % 8); }
    else {
        e8(ctx, mode + (target % 8) * 8 + 4);
        let bits: Any = if (scale == 8) { 192 } else if (scale == 4) { 128 } else if (scale == 2) { 64 } else { 0 };
        e8(ctx, bits + (if (index < 0) { 4 } else { index % 8 }) * 8 + base % 8);
    }
    if (mode == 64) { e8(ctx, displacement); } else if (mode == 128) { e32(ctx, displacement); }
    return 0;
}

fun x86_select_imm32(literal: Any) -> Any {
    return literal != nil and literal >= -2147483648 and literal <= 2147483647;
}

// Give a value a register. Literals and lazy remainders cost scratch; lazy
// comparisons are only branch predicates here.
fun x86_select_materialize(ctx: Any, plan: Any, value: Any) -> Any {
    if (value.kind == 0) { return value.register; }
    if (value.kind == 2) { plan.valid = false; return -1; }
    let target: Any = x86_select_scratch(plan);
    if (target < 0) { return -1; }
    plan.cost += 1;
    if (value.kind == 1) { x86_mov_immediate(ctx, target, value.literal); return target; }
    // Signed n % 2^k = n - ((n + bias) & -2^k), bias = 2^k-1 only for negative n.
    let source: Any = value.register; let shift: Any = value.literal;
    x86_move_register(ctx, target, source);
    if (shift == 1) { x86_select_shift(ctx, target, 5, 63); }
    else { x86_select_shift(ctx, target, 7, 63); x86_select_shift(ctx, target, 5, 64 - shift); }
    x86_select_register_operation(ctx, 1, target, source);
    x86_register_immediate(ctx, target, 4, 0 - x86_select_power(shift));
    e8(ctx, if (target >= 8) { 73 } else { 72 }); e8(ctx, 247); e8(ctx, 216 + target % 8); // neg
    x86_select_register_operation(ctx, 1, target, source);
    plan.cost += 5;
    return target;
}

fun x86_select_power(shift: Any) -> Any {
    mut power: Any = 1;
    for index: Any in 0..shift { power *= 2; }
    return power;
}

// Shift for a positive power-of-two imm32 multiplier, otherwise -1.
fun x86_select_log2(literal: Any) -> Any {
    mut power: Any = 1; mut shift: Any = 0;
    while (power < literal and shift < 31) { power *= 2; shift += 1; }
    return if (power == literal) { shift } else { -1 };
}

fun x86_select_binary(ctx: Any, plan: Any, instruction: Any) -> Any {
    let payload: Any = instruction.extra; let op: Any = payload.op;
    if (not has(plan.values, payload.left.slot) or not has(plan.values, payload.right.slot)) { return false; }
    mut a: Any = plan.values[payload.left.slot];
    mut b: Any = plan.values[payload.right.slot];
    let slot: Any = instruction.result.slot;
    if (x86_comparison_condition(op) >= 0) {
        plan.values[slot] = X86SelectValue(2, -1, nil, op, a, b);
        return true;
    }
    if (op == TK_PCT or op == TK_SLASH) {
        let shift: Any = x86_compact_divisor_shift(payload.right);
        if (shift < 0 or b.kind != 1 or b.literal != payload.right.value or a.kind == 1) { return false; }
        let source: Any = x86_select_materialize(ctx, plan, a);
        if (source < 0) { return false; }
        if (op == TK_PCT) {
            plan.values[slot] = if (shift == 0) { x86_select_literal(0) } else { X86SelectValue(3, source, shift, 0, 0, 0) };
            return true;
        }
        if (shift == 0) { plan.values[slot] = x86_select_register(source); return true; }
        let target: Any = x86_select_scratch(plan);
        if (target < 0) { return false; }
        // Truncate toward zero exactly as the branch form's signed division.
        x86_move_register(ctx, target, source);
        if (shift == 1) { x86_select_shift(ctx, target, 5, 63); }
        else { x86_select_shift(ctx, target, 7, 63); x86_select_shift(ctx, target, 5, 64 - shift); }
        x86_select_register_operation(ctx, 1, target, source);
        x86_select_shift(ctx, target, 7, shift);
        plan.cost += 4;
        plan.values[slot] = x86_select_register(target);
        return true;
    }
    if (op != TK_PLUS and op != TK_MINUS and op != TK_STAR) { return false; }
    if (a.kind == 1 and b.kind == 1) { return false; }
    if (op != TK_MINUS and a.kind == 1) { let swapped: Any = a; a = b; b = swapped; }
    if (b.kind != 1) {
        let right: Any = x86_select_materialize(ctx, plan, b);
        if (right < 0) { return false; }
        b = x86_select_register(right);
    }
    if (a.kind != 1) {
        let left: Any = x86_select_materialize(ctx, plan, a);
        if (left < 0) { return false; }
        a = x86_select_register(left);
    }
    if (op == TK_STAR and b.kind == 1 and (b.literal == 0 or b.literal == 1)) {
        plan.values[slot] = if (b.literal == 0) { x86_select_literal(0) } else { a };
        return true;
    }
    if (b.kind == 1 and not x86_select_imm32(b.literal)) { return false; }
    let target: Any = x86_select_scratch(plan);
    if (target < 0) { return false; }
    plan.cost += 1;
    if (op == TK_PLUS) {
        if (b.kind == 1) { x86_select_lea(ctx, target, a.register, -1, 1, b.literal); }
        else { x86_select_lea(ctx, target, a.register, b.register, 1, 0); }
    } else if (op == TK_MINUS) {
        if (b.kind == 1 and x86_select_imm32(0 - b.literal)) { x86_select_lea(ctx, target, a.register, -1, 1, 0 - b.literal); }
        else if (b.kind == 1) { return false; }
        else {
            if (a.kind == 1) { x86_mov_immediate(ctx, target, a.literal); }
            else { x86_move_register(ctx, target, a.register); }
            x86_select_register_operation(ctx, 41, target, b.register);
            plan.cost += 1;
        }
    } else if (b.kind == 1) {
        let literal: Any = b.literal;
        let shift: Any = x86_select_log2(literal);
        if (literal == 3 or literal == 5 or literal == 9) {
            x86_select_lea(ctx, target, a.register, a.register, literal - 1, 0);
        } else if (shift > 0) {
            x86_move_register(ctx, target, a.register); x86_select_shift(ctx, target, 4, shift);
            plan.cost += 1;
        } else {
            let narrow: Any = literal >= -128 and literal <= 127;
            e8(ctx, x86_select_extended(target, a.register)); e8(ctx, if (narrow) { 107 } else { 105 });
            e8(ctx, 192 + (target % 8) * 8 + a.register % 8);
            if (narrow) { e8(ctx, literal); } else { e32(ctx, literal); }
        }
    } else {
        x86_move_register(ctx, target, a.register);
        e8(ctx, x86_select_extended(target, b.register)); e8(ctx, 15); e8(ctx, 175);
        e8(ctx, 192 + (target % 8) * 8 + b.register % 8);
        plan.cost += 1;
    }
    plan.values[slot] = x86_select_register(target);
    return true;
}

// Locals written only as v = literal, v = v +/- literal or v = u +/- literal
// for another such local u (left = i - 1, #86). Their predicates follow
// periodic or monotone patterns that branch predictors learn, so diamonds
// testing only these values and literals keep the branch form.
fun x86_induction_locals(ctx: Any, block: Any) -> Any {
    let result: Any = {}; let sources: Any = {};
    for instruction: Any in block.code {
        let op: Any = instruction.op;
        if (op != S_LET and op != S_ASSIGN) { continue; }
        let payload: Any = instruction.extra;
        let name: Any = symbol_name(payload.name, payload.length);
        let value: Any = if (op == S_LET) { payload.initializer } else { payload.value };
        mut source: Any = nil;
        if (ctx.allocation.locations[value.slot].literal != nil) { source = name; }
        else {
            let step: Any = x86_single_definition(ctx, block, value);
            if (step != 0 and step.op == E_BIN and (step.extra.op == TK_PLUS or step.extra.op == TK_MINUS) and
                ctx.allocation.locations[step.extra.right.slot].literal != nil) {
                let previous: Any = x86_single_definition(ctx, block, step.extra.left);
                if (previous != 0 and previous.op == E_VAR) {
                    source = symbol_name(previous.extra.name, previous.extra.length);
                    // A declaration cannot step its own (outer) name.
                    if (op == S_LET and source == name) { source = nil; }
                }
            }
        }
        if (not has(sources, name)) { sources[name] = []; }
        push(sources[name], source);
        result[name] = source != nil and (not has(result, name) or result[name]);
    }
    mut changed: Any = true;
    while (changed) {
        changed = false;
        for name: Any in keys(result) {
            if (not result[name]) { continue; }
            for source: Any in sources[name] {
                if (source != name and (not has(result, source) or not result[source])) { result[name] = false; changed = true; }
            }
        }
    }
    return result;
}

// Speculate one non-control instruction. Every result is a scratch register,
// a dedicated local's current register, a literal or a lazy predicate.
fun x86_select_step(ctx: Any, block: Any, plan: Any, instruction: Any) -> Any {
    let op: Any = instruction.op; let payload: Any = instruction.extra;
    if (op == 0 or x86_dead_copy(ctx, instruction)) { return true; }
    if (instruction.result != 0) {
        // Track whether a value depends on data rather than only on
        // induction locals and literals; see x86_induction_locals.
        let slot: Any = instruction.result.slot;
        if (op == E_VAR) {
            let name: Any = symbol_name(payload.name, payload.length);
            if (has(plan.env, name) or not has(ctx.allocation.induction, name) or not ctx.allocation.induction[name]) { plan.data[slot] = true; }
        } else if (op == E_BIN and (has(plan.data, payload.left.slot) or has(plan.data, payload.right.slot))) { plan.data[slot] = true; }
        else if (op == E_UN and has(plan.data, payload.operand.slot)) { plan.data[slot] = true; }
    }
    if (instruction.result != 0) {
        // cg_ir walks the unplanned block: discarded results have no
        // definition and literal intrinsics are rematerialized E_INTs.
        let location: Any = ctx.allocation.locations[instruction.result.slot];
        if (location.definitions == 0 and location.uses == 0) { return true; }
        if (location.literal != nil) { plan.values[instruction.result.slot] = x86_select_literal(location.literal); return true; }
    }
    if (op == E_INT) { return false; }
    if (op == E_VAR) {
        let register: Any = x86_local_register(ctx, payload.name, payload.length);
        if (register < 0) { return false; }
        let name: Any = symbol_name(payload.name, payload.length);
        plan.values[instruction.result.slot] = x86_select_register(if (has(plan.env, name)) { plan.env[name] } else { register });
        return true;
    }
    if (op == E_BIN) { return x86_select_binary(ctx, plan, instruction); }
    if (op == E_UN and payload.op == TK_MINUS and has(plan.values, payload.operand.slot)) {
        let operand: Any = plan.values[payload.operand.slot];
        if (operand.kind == 1) { return false; }
        let source: Any = x86_select_materialize(ctx, plan, operand);
        let target: Any = x86_select_scratch(plan);
        if (source < 0 or target < 0) { return false; }
        x86_move_register(ctx, target, source);
        e8(ctx, if (target >= 8) { 73 } else { 72 }); e8(ctx, 247); e8(ctx, 216 + target % 8);
        plan.cost += 2;
        plan.values[instruction.result.slot] = x86_select_register(target);
        return true;
    }
    if (op == S_ASSIGN) {
        let own: Any = x86_local_register(ctx, payload.name, payload.length);
        if (own < 0 or not has(plan.values, payload.value.slot)) { return false; }
        mut register: Any = x86_select_materialize(ctx, plan, plan.values[payload.value.slot]);
        if (register < 0) { return false; }
        // Never alias another local's home: the final writes are then a
        // conflict-free set of moves from scratch registers.
        if (x86_select_dedicated(register) and register != own) {
            let copy: Any = x86_select_scratch(plan);
            if (copy < 0) { return false; }
            x86_move_register(ctx, copy, register); plan.cost += 1;
            register = copy;
        }
        plan.env[symbol_name(payload.name, payload.length)] = register;
        return true;
    }
    return false;
}

fun x86_select_copy(map: Any) -> Any {
    let result: Any = {};
    for key: Any in keys(map) { result[key] = map[key]; }
    return result;
}

// Emit the predicate's flags. Returns the condition code that holds when the
// then arm would run, or -1 for a predicate this lowering cannot test.
fun x86_select_condition(ctx: Any, plan: Any, value: Any) -> Any {
    if (value.kind == 0) {
        e8(ctx, x86_select_extended(value.register, value.register)); e8(ctx, 133);
        e8(ctx, 192 + (value.register % 8) * 9);
        return 133;
    }
    if (value.kind == 3) {
        e8(ctx, if (value.register >= 8) { 73 } else { 72 }); e8(ctx, 247); e8(ctx, 192 + value.register % 8);
        e32(ctx, x86_select_power(value.literal) - 1);
        return 133;
    }
    if (value.kind != 2) { return -1; }
    mut left: Any = value.left; mut right: Any = value.right; mut op: Any = value.op;
    // Signed n % 2^k is zero exactly when n's low k bits are zero.
    if ((op == TK_EQ or op == TK_NE) and (left.kind == 3 or right.kind == 3)) {
        let remainder: Any = if (left.kind == 3) { left } else { right };
        let other: Any = if (left.kind == 3) { right } else { left };
        if (other.kind == 1 and other.literal == 0) {
            e8(ctx, if (remainder.register >= 8) { 73 } else { 72 }); e8(ctx, 247); e8(ctx, 192 + remainder.register % 8);
            e32(ctx, x86_select_power(remainder.literal) - 1);
            return x86_comparison_condition(op);
        }
    }
    if (left.kind == 1 and right.kind == 1) { return -1; }
    if (left.kind == 1) {
        let swapped: Any = left; left = right; right = swapped;
        if (op == TK_LT) { op = TK_GT; } else if (op == TK_GT) { op = TK_LT; }
        else if (op == TK_LE) { op = TK_GE; } else if (op == TK_GE) { op = TK_LE; }
    }
    let register: Any = x86_select_materialize(ctx, plan, left);
    if (register < 0) { return -1; }
    if (right.kind == 1) {
        if (not x86_select_imm32(right.literal)) { return -1; }
        x86_register_immediate(ctx, register, 7, right.literal);
    } else {
        let other: Any = x86_select_materialize(ctx, plan, right);
        if (other < 0) { return -1; }
        x86_select_register_operation(ctx, 57, register, other);
    }
    return x86_comparison_condition(op);
}

fun x86_select_cmov(ctx: Any, condition: Any, target: Any, source: Any) -> Any {
    e8(ctx, x86_select_extended(target, source)); e8(ctx, 15); e8(ctx, condition - 64);
    e8(ctx, 192 + (target % 8) * 8 + source % 8);
    return 0;
}

// Parse and speculate one IR_FALSE diamond:
//   IR_FALSE c, else; then...; IR_JUMP done; IR_LABEL else; else...; IR_LABEL done
// Returns the done label's position, or -1 after marking the plan invalid.
fun x86_select_diamond(ctx: Any, block: Any, plan: Any, position: Any) -> Any {
    let branch: Any = block.code[position];
    let condition: Any = branch.arg1.slot;
    if (not has(plan.values, condition) or ctx.allocation.locations[condition].end != position) { plan.valid = false; return -1; }
    // No speculated temporary may stay live across the arms or the merge.
    for slot: Any in keys(plan.values) {
        if (slot != condition and ctx.allocation.locations[slot].end >= position) { plan.valid = false; return -1; }
    }
    let predicate: Any = plan.values[condition];
    if (not has(plan.data, condition)) { plan.valid = false; return -1; }
    let before: Any = x86_select_copy(plan.env);
    let available: Any = []; for register: Any in plan.free { push(available, register); }
    let arms: Any = [];
    mut done: Any = -1;
    mut cursor: Any = position + 1;
    for arm: Any in [0, 1] {
        plan.env = x86_select_copy(before);
        while (true) {
            if (cursor >= len(block.code) or not plan.valid) { plan.valid = false; return -1; }
            let instruction: Any = block.code[cursor];
            let op: Any = instruction.op;
            if (arm == 0 and op == IR_JUMP) {
                let next: Any = cursor + 1;
                if (next >= len(block.code) or block.code[next].op != IR_LABEL or block.code[next].extra != branch.extra) { plan.valid = false; return -1; }
                done = instruction.extra; cursor = next + 1;
                break;
            }
            if (arm == 1 and op == IR_LABEL and instruction.extra == done) { break; }
            if (op == IR_FALSE) {
                let nested: Any = x86_select_diamond(ctx, block, plan, cursor);
                if (nested < 0) { return -1; }
                cursor = nested + 1;
                continue;
            }
            if (lsra_boundary(op) or not x86_select_step(ctx, block, plan, instruction)) { plan.valid = false; return -1; }
            if (plan.cost > X86_SELECT_LIMIT) { plan.valid = false; return -1; }
            cursor += 1;
        }
        push(arms, plan.env);
    }
    let thenEnv: Any = arms[0]; let elseEnv: Any = arms[1];
    let names: Any = x86_select_copy(thenEnv);
    for name: Any in keys(elseEnv) { names[name] = true; }
    let born: Any = {}; for register: Any in available { born[register] = true; }
    let references: Any = {};
    for env: Any in arms {
        for name: Any in keys(env) {
            let register: Any = env[name];
            references[register] = if (has(references, register)) { references[register] + 1 } else { 1 };
        }
    }
    let merged: Any = x86_select_copy(before);
    let moves: Any = [];
    for name: Any in keys(names) {
        let own: Any = ctx.allocation.localRegisters[name];
        let fallback: Any = if (has(before, name)) { before[name] } else { own };
        let taken: Any = if (has(thenEnv, name)) { thenEnv[name] } else { fallback };
        let skipped: Any = if (has(elseEnv, name)) { elseEnv[name] } else { fallback };
        if (taken == skipped) { merged[name] = taken; continue; }
        // Reuse a register born in exactly one arm as the destination;
        // otherwise copy the else value into fresh scratch before the test.
        if (has(born, skipped) and references[skipped] == 1) { push(moves, [skipped, taken, false]); merged[name] = skipped; }
        else if (has(born, taken) and references[taken] == 1) { push(moves, [taken, skipped, true]); merged[name] = taken; }
        else {
            let target: Any = x86_select_scratch(plan);
            if (target < 0) { return -1; }
            x86_move_register(ctx, target, skipped); plan.cost += 1;
            push(moves, [target, taken, false]); merged[name] = target;
        }
    }
    if (len(moves) > 0) {
        let taken: Any = x86_select_condition(ctx, plan, predicate);
        if (taken < 0) { plan.valid = false; return -1; }
        let skipped: Any = if (taken % 2 == 0) { taken + 1 } else { taken - 1 };
        for move: Any in moves { x86_select_cmov(ctx, if (move[2]) { skipped } else { taken }, move[0], move[1]); }
    }
    // Arm-born scratch survives only as a merged value.
    let live: Any = {}; for name: Any in keys(merged) { live[merged[name]] = true; }
    let free: Any = [];
    for register: Any in available { if (not has(live, register)) { push(free, register); } }
    plan.free = free;
    plan.env = merged;
    return cursor;
}

// Jumps per label. Short-circuit chains (#85) can reach a diamond's labels
// from outside it, so a selected region must own every jump to its labels.
fun x86_label_jumps(block: Any) -> Any {
    let jumps: Any = {};
    for instruction: Any in block.code {
        let op: Any = instruction.op;
        if (op == IR_JUMP or op == IR_FALSE or op == IR_TRUE or op == IR_ISNIL or op == IR_NONNULL) {
            jumps[instruction.extra] = if (has(jumps, instruction.extra)) { jumps[instruction.extra] + 1 } else { 1 };
        }
    }
    return jumps;
}

fun x86_select_owns_labels(ctx: Any, block: Any, start: Any, end: Any) -> Any {
    let inside: Any = {};
    for index: Any in start..(end + 1) {
        let op: Any = block.code[index].op;
        if (op == IR_JUMP or op == IR_FALSE or op == IR_TRUE or op == IR_ISNIL or op == IR_NONNULL) {
            let label: Any = block.code[index].extra;
            inside[label] = if (has(inside, label)) { inside[label] + 1 } else { 1 };
        }
    }
    for index: Any in start..(end + 1) {
        if (block.code[index].op != IR_LABEL) { continue; }
        let label: Any = block.code[index].extra;
        let all: Any = if (has(ctx.allocation.jumps, label)) { ctx.allocation.jumps[label] } else { 0 };
        let own: Any = if (has(inside, label)) { inside[label] } else { 0 };
        if (all != own) { return false; }
    }
    return true;
}

// Try one top-level diamond whose predicate starts at `start`. Returns the
// last consumed position, or -1 with no bytes emitted.
fun x86_select_region(ctx: Any, block: Any, start: Any) -> Any {
    if (ctx.dynamic != 0 or ctx.mode != 0 or len(ctx.allocation.localRegisters) == 0) { return -1; }
    let first: Any = block.code[start].op;
    if (first != E_VAR and first != E_INT and first != E_BIN) { return -1; }
    let origin: Any = ctx.code.length;
    let plan: Any = X86Select({}, {}, [], 0, true, {});
    for register: Any in X86_SELECT_SCRATCH { push(plan.free, register); }
    mut position: Any = start;
    while (position < len(block.code) and block.code[position].op != IR_FALSE) {
        let instruction: Any = block.code[position];
        if (position - start >= X86_SELECT_PREFIX or lsra_boundary(instruction.op) or instruction.op == S_ASSIGN or
            not x86_select_step(ctx, block, plan, instruction)) { ctx.code.length = origin; return -1; }
        position += 1;
    }
    mut end: Any = -1;
    if (position < len(block.code) and plan.valid) { end = x86_select_diamond(ctx, block, plan, position); }
    if (end >= 0 and plan.valid) {
        for index: Any in start..(end + 1) {
            let result: Any = block.code[index].result;
            if (result != 0 and ctx.allocation.locations[result.slot].end > end) { plan.valid = false; }
        }
    }
    if (end >= 0 and plan.valid and not x86_select_owns_labels(ctx, block, start, end)) { plan.valid = false; }
    if (end < 0 or not plan.valid) { ctx.code.length = origin; return -1; }
    for name: Any in keys(plan.env) {
        x86_move_register(ctx, ctx.allocation.localRegisters[name], plan.env[name]);
    }
    return end;
}

// Emit op rax, r/m64 directly from an allocated register or spill home.
// rax is scratch; allocated callee-saved registers and spill homes stay intact.
fun x86_rax_operand(ctx: Any, value: Any, opcode: Any, extended: Any) -> Any {
    let location: Any = ctx.allocation.locations[value.slot];
    if (location.borrowed != nil) {
        let register: Any = 0 - location.borrowed - 1;
        e8(ctx, if (location.borrowed < 0 and register >= 8) { 73 } else { 72 });
        if (extended) { e8(ctx, 15); }
        e8(ctx, opcode);
        if (location.borrowed < 0) { e8(ctx, 192 + register % 8); }
        else { e8(ctx, 133); e32(ctx, 0 - location.borrowed); }
        return 0;
    }
    if (location.address != nil) {
        x86_relocated_immediate(ctx, 11, 1, location.address);
        e8(ctx, 73); if (extended) { e8(ctx, 15); }
        e8(ctx, opcode); e8(ctx, 195);
        return 0;
    }
    if (location.literal != nil) {
        let literal: Any = location.literal;
        if (literal >= -2147483648 and literal <= 2147483647) {
            let narrow: Any = literal >= -128 and literal <= 127;
            e8(ctx, 72);
            if (extended) { e8(ctx, if (narrow) { 107 } else { 105 }); e8(ctx, 192); }
            else {
                e8(ctx, if (narrow) { 131 } else { 129 });
                e8(ctx, if (opcode == 3) { 192 } else if (opcode == 43) { 232 } else { 248 });
            }
            if (narrow) { e8(ctx, literal); } else { e32(ctx, literal); }
        } else {
            // rcx can hold the original dividend during remainder lowering.
            x86_mov_immediate(ctx, 11, literal);
            e8(ctx, 73); if (extended) { e8(ctx, 15); }
            e8(ctx, opcode); e8(ctx, 195); // rax, r11
        }
        return 0;
    }
    e8(ctx, if (location.register >= 0) { 73 } else { 72 });
    if (extended) { e8(ctx, 15); }
    e8(ctx, opcode);
    if (location.register >= 0) { e8(ctx, 192 + location.register - 8); }
    else { e8(ctx, 133); e32(ctx, 0 - 8 * (ctx.tempBase + location.home + 1)); }
    return 0;
}

fun cg_bin(ctx: Any, n: Any) -> Any {
    let op: Any = n.op;
    // Signed power-of-two division/remainder: bias negatives before shifting.
    // `% 8` is especially common in the runtime's value tag checks.
    if ((op == TK_SLASH or op == TK_PCT) and n.right.kind == E_INT) {
        let shift: Any = x86_divisor_shift(n.right);
        if (shift >= 0) {
            cg_expr(ctx, n.left);
            if (shift == 0 or ctx.allocation.locations[n.left.slot].maximum != nil) {
                x86_unsigned_power_divide(ctx, n.right.value, shift, op == TK_PCT);
            } else { x86_signed_power_divide(ctx, n.right.value, shift, op == TK_PCT); }
            return 0;
        }
        let magic: Any = x86_signed_reciprocal(n.right.value);
        if (magic != 0) {
            x86_signed_constant_divide(ctx, n, magic, op == TK_PCT);
            return 0;
        }
    }
    cg_expr(ctx, n.left);
    if (op == TK_PLUS) { x86_rax_operand(ctx, n.right, 3, false); }
    else if (op == TK_MINUS) { x86_rax_operand(ctx, n.right, 43, false); }
    else if (op == TK_STAR) {
        let literal: Any = ctx.allocation.locations[n.right.slot].literal;
        if (literal == 0) { mov_imm(ctx, 0); }
        else if (literal == 1) { return 0; }
        else if (literal == 3 or literal == 5 or literal == 9) {
            e8(ctx, 72); e8(ctx, 141); e8(ctx, 4);
            e8(ctx, if (literal == 3) { 64 } else if (literal == 5) { 128 } else { 192 });
        } else {
            let shift: Any = x86_divisor_shift(n.right);
            if (literal != nil and shift > 0) { e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, shift); }
            else { x86_rax_operand(ctx, n.right, 175, true); }
        }
    }
    else if (op == TK_SLASH or op == TK_PCT) {
        x86_get_temp(ctx, n.right, 1);
        e8(ctx, 72); e8(ctx, 153); e8(ctx, 72); e8(ctx, 247); e8(ctx, 249);
        if (op == TK_PCT) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 208); }
    } else {
        x86_rax_operand(ctx, n.right, 59, false);
        setcc(ctx, x86_comparison_condition(op) + 16);
    }
    return 0;
}

fun cg_un(ctx: Any, n: Any) -> Any {
    let op: Any = n.op;
    cg_expr(ctx, n.operand);
    if (op == TK_MINUS) {
        e8(ctx, 72); e8(ctx, 247); e8(ctx, 216);  // neg rax
    } else {
        test_rax(ctx);
        setcc(ctx, 148);               // setz al; movzx
    }
    return 0;
}



// All arguments already have stable IR homes in r12-r15 or the frame.
// ABI destinations are disjoint, so loading one cannot destroy another source.
fun x86_syscall_arguments(ctx: Any, args: Any, tagged: Any) -> Any {
    let registers: Any = [0, 7, 6, 2, 10, 8, 9];
    mut index: Any = 0;
    mut cur: Any = args;
    while (cur != 0) {
        if (index >= len(registers)) { die_str("mayc: syscall accepts at most seven arguments\n"); }
        let target: Any = registers[index];
        x86_get_temp(ctx, cur, target);
        if (tagged) {
            e8(ctx, if (target >= 8) { 73 } else { 72 });
            e8(ctx, 193); e8(ctx, 248 + target % 8); e8(ctx, 3);
        }
        index += 1; cur = cur.next;
    }
    return 0;
}

fun cg_syscall(ctx: Any, args: Any) -> Any {
    if (ctx.target.os != "linux") { die_str("mayc: raw syscall is not supported for this target\n"); }
    x86_syscall_arguments(ctx, args, false);
    e8(ctx, 15); e8(ctx, 5);
    return 0;
}

// Encode ModRM/SIB/displacement for [base + index*scale + displacement].
// A REX prefix is emitted when required or for 64-bit operands.
fun x86_memory(ctx: Any, wide: Any, opcode: Any, register: Any, base: Any, index: Any, scale: Any, displacement: Any) -> Any {
    let rex: Any = (if (wide) { 8 } else { 0 }) + (if (register >= 8) { 4 } else { 0 }) +
        (if (index >= 8) { 2 } else { 0 }) + (if (base >= 8) { 1 } else { 0 });
    if (rex != 0) { e8(ctx, 64 + rex); }
    for byte: Any in opcode { e8(ctx, byte); }
    let narrow: Any = displacement >= -128 and displacement <= 127;
    // [rbp]/[r13] has no displacement-free form.
    let mode: Any = if (displacement == 0 and base % 8 != 5) { 0 } else if (narrow) { 64 } else { 128 };
    if (index < 0 and base % 8 != 4) { e8(ctx, mode + (register % 8) * 8 + base % 8); }
    else {
        e8(ctx, mode + (register % 8) * 8 + 4);
        let bits: Any = if (scale == 8) { 192 } else if (scale == 4) { 128 } else if (scale == 2) { 64 } else { 0 };
        e8(ctx, bits + (if (index < 0) { 4 } else { index % 8 }) * 8 + base % 8);
    }
    if (mode == 64) { e8(ctx, displacement); } else if (mode == 128) { e32(ctx, displacement); }
    return 0;
}

// Give an address term a register: temporaries in registers and dedicated
// locals are used in place; other homes, literals and frame locals load into
// the scratch register.
fun x86_address_register(ctx: Any, term: Any, scratch: Any) -> Any {
    if (term.value != 0) {
        let location: Any = ctx.allocation.locations[term.value.slot];
        if (location.register >= 0 and location.literal == nil and location.address == nil and location.borrowed == nil) { return location.register; }
        x86_get_temp(ctx, term.value, scratch);
        return scratch;
    }
    let register: Any = x86_local_register(ctx, term.name, term.length);
    if (register >= 0) { return register; }
    x86_load_register(ctx, scratch, 8 * (loc_find(ctx, term.name, term.length) + 1));
    return scratch;
}

fun x86_fused_access(ctx: Any, name: Any, args: Any) -> Any {
    let address: Any = ctx.allocation.addresses[ctx.allocation.position];
    let store: Any = starts_with(name, "store");
    // Store values load first: rax may still forward the base temporary.
    if (store and address.value != 0) {
        let register: Any = x86_address_register(ctx, address.value, 1);
        x86_move_register(ctx, 1, register);
    } else if (store) { x86_get_temp(ctx, args.next, 1); }
    let base: Any = x86_address_register(ctx, address.base, 0);
    let index: Any = if (address.index == 0) { -1 } else { x86_address_register(ctx, address.index, if (store) { 2 } else { 1 }) };
    let scale: Any = address.scale; let displacement: Any = address.displacement;
    if (name == "load8") { x86_memory(ctx, false, [15, 182], 0, base, index, scale, displacement); }
    else if (name == "load16") { x86_memory(ctx, false, [15, 183], 0, base, index, scale, displacement); }
    else if (name == "load32") { x86_memory(ctx, false, [139], 0, base, index, scale, displacement); }
    else if (name == "load64") { x86_memory(ctx, true, [139], 0, base, index, scale, displacement); }
    else if (name == "store8") { x86_memory(ctx, false, [136], 1, base, index, scale, displacement); }
    else if (name == "store16") { e8(ctx, 102); x86_memory(ctx, false, [137], 1, base, index, scale, displacement); }
    else if (name == "store32") { x86_memory(ctx, false, [137], 1, base, index, scale, displacement); }
    else if (name == "store64") { x86_memory(ctx, true, [137], 1, base, index, scale, displacement); }
    else { return false; }
    return true;
}

fun cg_store(ctx: Any, args: Any, width: Any) -> Any {
    cg_expr(ctx, args);
    x86_get_temp(ctx, args.next, 1);
    if (width == 1) { e8(ctx, 136); e8(ctx, 8); }
    else if (width == 2) { e8(ctx, 102); e8(ctx, 137); e8(ctx, 8); }
    else if (width == 4) { e8(ctx, 137); e8(ctx, 8); }
    else { e8(ctx, 72); e8(ctx, 137); e8(ctx, 8); }
    return 0;
}

fun untag_rax(ctx: Any) -> Any { e8(ctx, 72); e8(ctx, 193); e8(ctx, 248); e8(ctx, 3); return 0; }
fun tag_rax(ctx: Any) -> Any { e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 3); return 0; }

fun cg_store_dyn(ctx: Any, args: Any, width: Any) -> Any {
    cg_expr(ctx, args);
    untag_rax(ctx);
    e8(ctx, 80);
    cg_expr(ctx, args.next);
    untag_rax(ctx);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 193);
    e8(ctx, 88);
    if (width == 1) { e8(ctx, 136); e8(ctx, 8); }
    else if (width == 2) { e8(ctx, 102); e8(ctx, 137); e8(ctx, 8); }
    else if (width == 4) { e8(ctx, 137); e8(ctx, 8); }
    else { e8(ctx, 72); e8(ctx, 137); e8(ctx, 8); }
    return 0;
}

fun cg_builtin(ctx: Any, np: Any, nl: Any, args: Any) -> Any {
    let platformName: Any = symbol_name(np, nl);
    if (platformName == "__fiber_stack") { x86_core_fiber_stack(ctx, args); return 1; }
    if (platformName == "__host_write" or platformName == "__host_alloc" or platformName == "__host_exit") { x86_host(ctx, platformName, args); return 1; }
    if (ctx.runtime == "core" and ctx.mode == 1 and platformName == "exit") { cg_expr(ctx, args); call_rt1(ctx, addr("rt_exit"), 7); return 1; }
    if (ctx.runtime == "core" and ctx.mode == 1 and platformName == "pow") { cg_calln(ctx, addr("rt_pow"), 6, args); return 1; }
    if (name_eq(np, nl, addr("__ccall6"), len("__ccall6")) == 1) { cg_ccall6(ctx, args); return 1; }
    if (name_eq(np, nl, addr("__longjmp"), len("__longjmp")) == 1) { cg_longjmp(ctx); return 1; }
    if (name_eq(np, nl, addr("__sp"), len("__sp")) == 1) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 224); return 1; }
    if (name_eq(np, nl, addr("__f32"), 5) == 1) {
        cg_expr(ctx, args);
        x86_encode(ctx, X86Instruction([102, 72, 15, 110, 192, 242, 15, 90, 192, 243, 15, 90, 192, 102, 72, 15, 126, 192], 0, 0));
        return 1;
    }
    if (name_eq(np, nl, addr("__fbin"), len("__fbin")) == 1) { cg_fbin(ctx, args); return 1; }
    if (name_eq(np, nl, addr("__fcmp"), len("__fcmp")) == 1) { cg_fcmp(ctx, args); return 1; }
    if (name_eq(np, nl, addr("__ftrunc"), len("__ftrunc")) == 1) { cg_ftrunc(ctx, args); return 1; }
    if (name_eq(np, nl, addr("__ffrac"), len("__ffrac")) == 1) { cg_ffrac(ctx, args); return 1; }
    if (name_eq(np, nl, addr("__fsign"), len("__fsign")) == 1) { cg_fsign(ctx, args); return 1; }
    if (name_eq(np, nl, addr("__fabs"), len("__fabs")) == 1) { cg_f1op(ctx, 13, args); return 1; }
    if (name_eq(np, nl, addr("__fpow2"), len("__fpow2")) == 1) { cg_fpow2(ctx, args, args.next); return 1; }
    if (name_eq(np, nl, addr("__fiber_entry"), len("__fiber_entry")) == 1) {
        let fr: Any = backend_find_func(ctx, addr("rt_fiber_entry"), len("rt_fiber_entry"));
        addr_lab(ctx, fr.lab, 6);
        return 1;
    }
    if (name_eq(np, nl, addr("__fib_switch"), len("__fib_switch")) == 1) {
        cg_expr(ctx, args);
        e8(ctx, 80);
        cg_expr(ctx, args.next);
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 198);
        e8(ctx, 95);
        call(ctx, ctx.fiberLabel);
        return 1;
    }
    if (ctx.mode == 0) {
        if (name_eq(np, nl, addr("syscall"), len("syscall")) == 1) { cg_syscall(ctx, args); return 1; }
        if (name_eq(np, nl, addr("addr"), len("addr")) == 1) {
            let off: Any = intern(ctx, args.span.source, args.start, args.length);
            addr_of(ctx, off);
            return 1;
        }
        if (name_eq(np, nl, addr("cstr"), len("cstr")) == 1) {
            let off: Any = intern(ctx, args.span.source, args.start, args.length);
            addr_of(ctx, off);
            return 1;
        }
        if (name_eq(np, nl, addr("len"), len("len")) == 1) {
            let ln: Any = declen(args.span.source, args.start, args.length);
            mov_imm(ctx, ln);
            return 1;
        }
        if (name_eq(np, nl, addr("ptr"), len("ptr")) == 1) { cg_expr(ctx, args); return 1; }
        if (ctx.allocation != 0 and has(ctx.allocation.addresses, ctx.allocation.position) and x86_fused_access(ctx, platformName, args)) { return 1; }
        if (name_eq(np, nl, addr("load8"), len("load8")) == 1) { cg_expr(ctx, args); e8(ctx, 15); e8(ctx, 182); e8(ctx, 0); return 1; }
        if (name_eq(np, nl, addr("load16"), len("load16")) == 1) { cg_expr(ctx, args); e8(ctx, 15); e8(ctx, 183); e8(ctx, 0); return 1; }
        if (name_eq(np, nl, addr("load32"), len("load32")) == 1) { cg_expr(ctx, args); e8(ctx, 139); e8(ctx, 0); return 1; }
        if (name_eq(np, nl, addr("load64"), len("load64")) == 1) { cg_expr(ctx, args); e8(ctx, 72); e8(ctx, 139); e8(ctx, 0); return 1; }
        if (name_eq(np, nl, addr("store8"), len("store8")) == 1) { cg_store(ctx, args, 1); return 1; }
        if (name_eq(np, nl, addr("store16"), len("store16")) == 1) { cg_store(ctx, args, 2); return 1; }
        if (name_eq(np, nl, addr("store32"), len("store32")) == 1) { cg_store(ctx, args, 4); return 1; }
        if (name_eq(np, nl, addr("store64"), len("store64")) == 1) { cg_store(ctx, args, 8); return 1; }
        if (name_eq(np, nl, addr("exit"), len("exit")) == 1) {
            if (ctx.target.os != "linux") { die_str("mayc: raw exit requires a platform runtime on this target\n"); }
            cg_expr(ctx, args);
            e8(ctx, 72); e8(ctx, 137); e8(ctx, 199);
            mov_imm(ctx, 60);
            e8(ctx, 15); e8(ctx, 5);
            return 1;
        }
        return 0;
    }
    if (name_eq(np, nl, addr("print"), len("print")) == 1) { cg_print(ctx, args); return 1; }
    if (name_eq(np, nl, addr("fail"), len("fail")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_fail"), len("rt_fail")); return 1; }
    if (name_eq(np, nl, addr("syscall"), len("syscall")) == 1) { cg_syscall_dyn(ctx, args); return 1; }
    if (name_eq(np, nl, addr("addr"), len("addr")) == 1) {
        if (args.kind == E_STR) {
            let off: Any = intern_obj(ctx, args.span.source, args.start, args.length);
            addr_tag(ctx, off, 4);
        } else {
            cg_expr(ctx, args);
            call_rt1(ctx, addr("rt_addr"), len("rt_addr"));
        }
        return 1;
    }
    if (name_eq(np, nl, addr("cstr"), len("cstr")) == 1) {
        if (args.kind == E_STR) {
            let off: Any = intern_obj(ctx, args.span.source, args.start, args.length);
            addr_tag(ctx, off, 4);
        } else {
            cg_expr(ctx, args);
            call_rt1(ctx, addr("rt_cstr"), len("rt_cstr"));
        }
        return 1;
    }
    if (name_eq(np, nl, addr("len"), len("len")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_len"), len("rt_len")); return 1; }
    if (name_eq(np, nl, addr("str"), len("str")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_to_str"), len("rt_to_str")); return 1; }
    if (name_eq(np, nl, addr("chr"), len("chr")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_chr"), len("rt_chr")); return 1; }
    if (name_eq(np, nl, addr("ord"), len("ord")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_ord"), len("rt_ord")); return 1; }
    if (name_eq(np, nl, addr("push"), len("push")) == 1) {
        cg_expr(ctx, args);
        e8(ctx, 80);
        cg_expr(ctx, args.next);
        e8(ctx, 80);
        call_rt2(ctx, addr("rt_push"), len("rt_push"));
        return 1;
    }
    if (name_eq(np, nl, addr("ptr"), len("ptr")) == 1) { cg_expr(ctx, args); return 1; }
    if (name_eq(np, nl, addr("load8"), len("load8")) == 1) { cg_expr(ctx, args); untag_rax(ctx); e8(ctx, 15); e8(ctx, 182); e8(ctx, 0); tag_rax(ctx); return 1; }
    if (name_eq(np, nl, addr("load16"), len("load16")) == 1) { cg_expr(ctx, args); untag_rax(ctx); e8(ctx, 15); e8(ctx, 183); e8(ctx, 0); tag_rax(ctx); return 1; }
    if (name_eq(np, nl, addr("load32"), len("load32")) == 1) { cg_expr(ctx, args); untag_rax(ctx); e8(ctx, 139); e8(ctx, 0); tag_rax(ctx); return 1; }
    if (name_eq(np, nl, addr("load64"), len("load64")) == 1) { cg_expr(ctx, args); untag_rax(ctx); e8(ctx, 72); e8(ctx, 139); e8(ctx, 0); tag_rax(ctx); return 1; }
    if (name_eq(np, nl, addr("store8"), len("store8")) == 1) { cg_store_dyn(ctx, args, 1); return 1; }
    if (name_eq(np, nl, addr("store16"), len("store16")) == 1) { cg_store_dyn(ctx, args, 2); return 1; }
    if (name_eq(np, nl, addr("store32"), len("store32")) == 1) { cg_store_dyn(ctx, args, 4); return 1; }
    if (name_eq(np, nl, addr("store64"), len("store64")) == 1) { cg_store_dyn(ctx, args, 8); return 1; }
    if (name_eq(np, nl, addr("exit"), len("exit")) == 1) {
        cg_expr(ctx, args);
        untag_rax(ctx);
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 199);
        mov_imm(ctx, 60);
        e8(ctx, 15); e8(ctx, 5);
        return 1;
    }
    if (name_eq(np, nl, addr("map"), len("map")) == 1) { cg_calln(ctx, addr("rt_mapf"), len("rt_mapf"), args); return 1; }
    if (name_eq(np, nl, addr("filter"), len("filter")) == 1) { cg_calln(ctx, addr("rt_filter"), len("rt_filter"), args); return 1; }
    if (name_eq(np, nl, addr("sum"), len("sum")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_sum"), len("rt_sum")); return 1; }
    if (name_eq(np, nl, addr("reduce"), len("reduce")) == 1) { cg_calln(ctx, addr("rt_reduce"), len("rt_reduce"), args); return 1; }
    if (name_eq(np, nl, addr("any"), len("any")) == 1) { cg_calln(ctx, addr("rt_any"), len("rt_any"), args); return 1; }
    if (name_eq(np, nl, addr("all"), len("all")) == 1) { cg_calln(ctx, addr("rt_all"), len("rt_all"), args); return 1; }
    if (name_eq(np, nl, addr("count"), len("count")) == 1) { cg_calln(ctx, addr("rt_count"), len("rt_count"), args); return 1; }
    if (name_eq(np, nl, addr("each"), len("each")) == 1) { cg_calln(ctx, addr("rt_each"), len("rt_each"), args); return 1; }
    if (name_eq(np, nl, addr("times"), len("times")) == 1) { cg_calln(ctx, addr("rt_times"), len("rt_times"), args); return 1; }
    if (name_eq(np, nl, addr("char_at"), len("char_at")) == 1) { cg_calln(ctx, addr("rt_char_at"), len("rt_char_at"), args); return 1; }
    if (name_eq(np, nl, addr("char_from"), len("char_from")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_char_from"), len("rt_char_from")); return 1; }
    if (name_eq(np, nl, addr("to_lower"), len("to_lower")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_lower"), len("rt_lower")); return 1; }
    if (name_eq(np, nl, addr("to_upper"), len("to_upper")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_upper"), len("rt_upper")); return 1; }
    if (name_eq(np, nl, addr("trim"), len("trim")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_trim"), len("rt_trim")); return 1; }
    if (name_eq(np, nl, addr("split"), len("split")) == 1) { cg_calln(ctx, addr("rt_split"), len("rt_split"), args); return 1; }
    if (name_eq(np, nl, addr("repeat"), len("repeat")) == 1) { cg_calln(ctx, addr("rt_repeat"), len("rt_repeat"), args); return 1; }
    if (name_eq(np, nl, addr("join"), len("join")) == 1) { cg_calln(ctx, addr("rt_join"), len("rt_join"), args); return 1; }
    if (name_eq(np, nl, addr("contains"), len("contains")) == 1) { cg_calln(ctx, addr("rt_contains"), len("rt_contains"), args); return 1; }
    if (name_eq(np, nl, addr("starts_with"), len("starts_with")) == 1) { cg_calln(ctx, addr("rt_starts_with"), len("rt_starts_with"), args); return 1; }
    if (name_eq(np, nl, addr("ends_with"), len("ends_with")) == 1) { cg_calln(ctx, addr("rt_ends_with"), len("rt_ends_with"), args); return 1; }
    if (name_eq(np, nl, addr("index_of"), len("index_of")) == 1) { cg_calln(ctx, addr("rt_index_of"), len("rt_index_of"), args); return 1; }
    if (name_eq(np, nl, addr("cmp"), len("cmp")) == 1) { cg_calln(ctx, addr("rt_cmp"), len("rt_cmp"), args); return 1; }
    if (name_eq(np, nl, addr("min"), len("min")) == 1) { cg_calln(ctx, addr("rt_min"), len("rt_min"), args); return 1; }
    if (name_eq(np, nl, addr("max"), len("max")) == 1) { cg_calln(ctx, addr("rt_max"), len("rt_max"), args); return 1; }
    if (name_eq(np, nl, addr("abs"), len("abs")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_abs"), len("rt_abs")); return 1; }
    if (name_eq(np, nl, addr("to_map"), len("to_map")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_to_map"), len("rt_to_map")); return 1; }
    if (name_eq(np, nl, addr("map_get"), len("map_get")) == 1) { cg_calln(ctx, addr("rt_map_get"), len("rt_map_get"), args); return 1; }
    if (name_eq(np, nl, addr("map_set"), len("map_set")) == 1) { cg_calln(ctx, addr("rt_map_set"), len("rt_map_set"), args); return 1; }
    if (name_eq(np, nl, addr("keys"), len("keys")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_keys"), len("rt_keys")); return 1; }
    if (name_eq(np, nl, addr("values"), len("values")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_values"), len("rt_values")); return 1; }
    if (name_eq(np, nl, addr("has"), len("has")) == 1) { cg_calln(ctx, addr("rt_has"), len("rt_has"), args); return 1; }
    if (name_eq(np, nl, addr("read_stdin"), len("read_stdin")) == 1) { cg_calln(ctx, addr("rt_read_stdin"), len("rt_read_stdin"), args); return 1; }
    if (name_eq(np, nl, addr("pi"), len("pi")) == 1) { call_rt0(ctx, addr("rt_pi"), len("rt_pi")); return 1; }
    if (name_eq(np, nl, addr("e"), len("e")) == 1) { call_rt0(ctx, addr("rt_e"), len("rt_e")); return 1; }
    if (name_eq(np, nl, addr("sqrt"), len("sqrt")) == 1) { cg_f1op(ctx, 0, args); return 1; }
    if (name_eq(np, nl, addr("floor"), len("floor")) == 1) { cg_f1op(ctx, 1, args); return 1; }
    if (name_eq(np, nl, addr("ceil"), len("ceil")) == 1) { cg_f1op(ctx, 2, args); return 1; }
    if (name_eq(np, nl, addr("round"), len("round")) == 1) { cg_f1op(ctx, 3, args); return 1; }
    if (name_eq(np, nl, addr("trunc"), len("trunc")) == 1) { cg_f1op(ctx, 4, args); return 1; }
    if (name_eq(np, nl, addr("sin"), len("sin")) == 1) { cg_f1op(ctx, 5, args); return 1; }
    if (name_eq(np, nl, addr("cos"), len("cos")) == 1) { cg_f1op(ctx, 6, args); return 1; }
    if (name_eq(np, nl, addr("tan"), len("tan")) == 1) { cg_f1op(ctx, 7, args); return 1; }
    if (name_eq(np, nl, addr("ln"), len("ln")) == 1) { cg_f1op(ctx, 8, args); return 1; }
    if (name_eq(np, nl, addr("log2"), len("log2")) == 1) { cg_f1op(ctx, 9, args); return 1; }
    if (name_eq(np, nl, addr("log10"), len("log10")) == 1) { cg_f1op(ctx, 10, args); return 1; }
    if (name_eq(np, nl, addr("exp"), len("exp")) == 1) { cg_f1op(ctx, 11, args); return 1; }
    if (name_eq(np, nl, addr("pow"), len("pow")) == 1) {
        if (ctx.runtime == "core") { cg_calln(ctx, addr("rt_pow"), len("rt_pow"), args); }
        else { cg_fpow2(ctx, args, args.next); }
        return 1;
    }
    if (name_eq(np, nl, addr("chars"), len("chars")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_chars"), len("rt_chars")); return 1; }
    if (name_eq(np, nl, addr("reverse"), len("reverse")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_reverse"), len("rt_reverse")); return 1; }
    if (name_eq(np, nl, addr("sort"), len("sort")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_sort"), len("rt_sort")); return 1; }
    if (name_eq(np, nl, addr("env"), len("env")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_env"), len("rt_env")); return 1; }
    if (name_eq(np, nl, addr("file_exists"), len("file_exists")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_file_exists"), len("rt_file_exists")); return 1; }
    if (name_eq(np, nl, addr("read_file"), len("read_file")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_read_file"), len("rt_read_file")); return 1; }
    if (name_eq(np, nl, addr("write_file"), len("write_file")) == 1) { cg_calln(ctx, addr("rt_write_file"), len("rt_write_file"), args); return 1; }
    if (name_eq(np, nl, addr("time"), len("time")) == 1) { call_rt0(ctx, addr("rt_time"), len("rt_time")); return 1; }
    if (name_eq(np, nl, addr("clock"), len("clock")) == 1) { call_rt0(ctx, addr("rt_clock"), len("rt_clock")); return 1; }
    if (name_eq(np, nl, addr("sleep"), len("sleep")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_sleep"), len("rt_sleep")); return 1; }
    if (name_eq(np, nl, addr("mkdir"), len("mkdir")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_mkdir"), len("rt_mkdir")); return 1; }
    if (name_eq(np, nl, addr("read_dir"), len("read_dir")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_read_dir"), len("rt_read_dir")); return 1; }
    if (name_eq(np, nl, addr("system"), len("system")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_system"), len("rt_system")); return 1; }
    if (name_eq(np, nl, addr("exec"), len("exec")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_exec"), len("rt_exec")); return 1; }
    if (name_eq(np, nl, addr("wait"), len("wait")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_wait"), len("rt_wait")); return 1; }
    if (name_eq(np, nl, addr("pop"), len("pop")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_pop"), len("rt_pop")); return 1; }
    if (name_eq(np, nl, addr("remove"), len("remove")) == 1) { cg_calln(ctx, addr("rt_remove"), len("rt_remove"), args); return 1; }
    if (name_eq(np, nl, addr("merge"), len("merge")) == 1) { cg_calln(ctx, addr("rt_merge"), len("rt_merge"), args); return 1; }
    if (name_eq(np, nl, addr("slice"), len("slice")) == 1) { cg_calln(ctx, addr("rt_slice"), len("rt_slice"), args); return 1; }
    if (name_eq(np, nl, addr("unique"), len("unique")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_unique"), len("rt_unique")); return 1; }
    if (name_eq(np, nl, addr("pad_left"), len("pad_left")) == 1) { cg_calln(ctx, addr("rt_pad_left"), len("rt_pad_left"), args); return 1; }
    if (name_eq(np, nl, addr("pad_right"), len("pad_right")) == 1) { cg_calln(ctx, addr("rt_pad_right"), len("rt_pad_right"), args); return 1; }
    if (name_eq(np, nl, addr("int"), len("int")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_int"), len("rt_int")); return 1; }
    if (name_eq(np, nl, addr("str_of"), len("str_of")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_to_str"), len("rt_to_str")); return 1; }
    if (name_eq(np, nl, addr("int_to_str"), len("int_to_str")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_int_str"), len("rt_int_str")); return 1; }
    if (name_eq(np, nl, addr("str_cmp"), len("str_cmp")) == 1) { cg_calln(ctx, addr("rt_str_cmp"), len("rt_str_cmp"), args); return 1; }
    if (name_eq(np, nl, addr("value_eq"), len("value_eq")) == 1) { cg_calln(ctx, addr("rt_eq"), len("rt_eq"), args); return 1; }
    if (name_eq(np, nl, addr("map_keys"), len("map_keys")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_keys"), len("rt_keys")); return 1; }
    if (name_eq(np, nl, addr("map_values"), len("map_values")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_values"), len("rt_values")); return 1; }
    if (name_eq(np, nl, addr("map_has"), len("map_has")) == 1) { cg_calln(ctx, addr("rt_has"), len("rt_has"), args); return 1; }
    if (name_eq(np, nl, addr("to_float"), len("to_float")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_to_f"), len("rt_to_f")); return 1; }
    if (name_eq(np, nl, addr("rt_raise"), len("rt_raise")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_raise"), len("rt_raise")); return 1; }
    if (name_eq(np, nl, addr("json_parse"), len("json_parse")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_json_parse"), len("rt_json_parse")); return 1; }
    if (name_eq(np, nl, addr("json_stringify"), len("json_stringify")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_json_stringify"), len("rt_json_stringify")); return 1; }
    if (name_eq(np, nl, addr("args"), len("args")) == 1) { call_rt0(ctx, addr("rt_args"), len("rt_args")); return 1; }
    if (name_eq(np, nl, addr("input"), len("input")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_input"), len("rt_input")); return 1; }
    if (name_eq(np, nl, addr("spawn"), len("spawn")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_spawn"), len("rt_spawn")); return 1; }
    if (name_eq(np, nl, addr("yield"), len("yield")) == 1) { call_rt0(ctx, addr("rt_yield"), len("rt_yield")); return 1; }
    if (name_eq(np, nl, addr("run"), len("run")) == 1) { call_rt0(ctx, addr("rt_run"), len("rt_run")); return 1; }
    if (name_eq(np, nl, addr("bool"), len("bool")) == 1) { cg_expr(ctx, args); call_rt1(ctx, addr("rt_bool"), len("rt_bool")); return 1; }
    if (name_eq(np, nl, addr("value_tag"), len("value_tag")) == 1) {
        cg_expr(ctx, args);
        e8(ctx, 72); e8(ctx, 131); e8(ctx, 224); e8(ctx, 7);
        e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 3);
        return 1;
    }
    return 0;
}

// Statically resolved calls enter the register ABI body directly. Only
// arguments beyond the six integer registers need stack slots, in ABI order.
// Keep the vector trampoline for closures and runtime helpers with a dynamic
// argument count; it also adapts callers that have an unaligned scratch stack.
fun x86_call_direct(ctx: Any, rec: Any, args: Any) -> Any {
    let registers: Any = [7, 6, 2, 1, 8, 9];
    let values: Any = [];
    mut cur: Any = args;
    while (cur != 0 and len(values) < rec.pc) { push(values, cur); cur = cur.next; }
    mut overflow: Any = rec.pc - 6;
    if (overflow < 0) { overflow = 0; }
    let total: Any = (overflow + overflow % 2) * 8;
    if (overflow % 2 == 1) { e8(ctx, 72); e8(ctx, 131); e8(ctx, 236); e8(ctx, 8); }
    mut index: Any = rec.pc - 1;
    while (index >= 6) {
        if (index < len(values)) { cg_expr(ctx, values[index]); }
        else { mov_imm(ctx, if (ctx.mode == 0) { 0 } else { 2 }); }
        e8(ctx, 80); index -= 1;
    }
    index = 0;
    while (index < rec.pc and index < 6) {
        if (index < len(values)) { x86_get_temp(ctx, values[index], registers[index]); }
        else { x86_mov_immediate(ctx, registers[index], if (ctx.mode == 0) { 0 } else { 2 }); }
        index += 1;
    }
    if (rec.abiLab == 0) { rec.abiLab = newlab(ctx); }
    // The body label is internal; retain the owning source function too.
    emission_reference(ctx, rec.lab);
    call(ctx, rec.abiLab);
    if (total > 0) {
        e8(ctx, 72); e8(ctx, 129); e8(ctx, 196); e32(ctx, total);
    }
    return 0;
}

fun cg_calln(ctx: Any, name: Any, sl: Any, args: Any) -> Any {
    let rec: Any = backend_find_func(ctx, name, sl);
    if (rec == 0) { die_str("mayc: missing runtime fn\n"); }
    return x86_call_direct(ctx, rec, args);
}

// Apply a closure value held in local slot `cv` to a linked list of argument
// values. IR lowering has already evaluated them left to right into stable
// homes. Push them in vector order, then pad with nil to the declared arity
// so a short argument list still binds its parameters correctly.
fun cg_apply(ctx: Any, cv: Any, args: Any) -> Any {
    ld_local(ctx, 8 * (cv + 1));
    call_rt1(ctx, addr("rt_require_callable"), len("rt_require_callable"));
    mut cnt: Any = 0;
    mut cur: Any = args;
    while (cur != 0) {
        cnt = cnt + 1;
        cur = cur.next;
    }
    cur = args;
    while (cur != 0) {
        cg_expr(ctx, cur); e8(ctx, 80);
        cur = cur.next;
    }
    let lskip: Any = newlab(ctx);
    let ltop: Any = newlab(ctx);
    let lsmall: Any = newlab(ctx);
    let ldone: Any = newlab(ctx);
    let rv: Any = loc_add(ctx, addr("0r"), 3);
    ld_local(ctx, 8 * (cv + 1));
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 16);
    e8(ctx, 72); e8(ctx, 61); e32(ctx, cnt);
    jcc(ctx, 142, lskip);
    e8(ctx, 72); e8(ctx, 45); e32(ctx, cnt);
    let pv: Any = loc_add(ctx, addr("0p"), 3);
    st_local(ctx, 8 * (pv + 1));
    placelab(ctx, ltop);
    ld_local(ctx, 8 * (pv + 1));
    e8(ctx, 72); e8(ctx, 133); e8(ctx, 192);
    jcc(ctx, 132, lskip);
    mov_imm(ctx, 2);
    e8(ctx, 80);
    ld_local(ctx, 8 * (pv + 1));
    e8(ctx, 72); e8(ctx, 45); e32(ctx, 1);
    st_local(ctx, 8 * (pv + 1));
    jmp(ctx, ltop);
    placelab(ctx, lskip);
    ld_local(ctx, 8 * (cv + 1));
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 16);
    e8(ctx, 76); e8(ctx, 139); e8(ctx, 80); e8(ctx, 8);
    x86_root_registers(ctx);
    e8(ctx, 255); e8(ctx, 210);
    st_local(ctx, 8 * (rv + 1));
    ld_local(ctx, 8 * (cv + 1));
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 16);
    e8(ctx, 72); e8(ctx, 61); e32(ctx, cnt);
    jcc(ctx, 142, lsmall);
    ld_local(ctx, 8 * (cv + 1));
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 16);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 3);
    e8(ctx, 72); e8(ctx, 1); e8(ctx, 196);
    jmp(ctx, ldone);
    placelab(ctx, lsmall);
    if (cnt > 0) {
        if (cnt * 8 < 128) { e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, cnt * 8); }
        else { e8(ctx, 72); e8(ctx, 129); e8(ctx, 196); e32(ctx, cnt * 8); }
    }
    placelab(ctx, ldone);
    ld_local(ctx, 8 * (rv + 1));
    return 0;
}

fun cg_call(ctx: Any, n: Any) -> Any {
    let np: Any = n.name;
    let nl: Any = n.length;
    let args: Any = n.args;
    let li: Any = loc_find(ctx, np, nl);
    let gi: Any = glob_find(ctx, np, nl);
    if (li < 0  and  gi < 0) {
        let fr: Any = backend_find_func(ctx, np, nl);
        if (fr != 0) {
            x86_call_direct(ctx, fr, args);
            return 0;
        }
        if (cg_builtin(ctx, np, nl, args) == 1) { return 0; }
        mut fname: Any = "";
        mut q: Any = 0;
        while (q < nl) { fname = fname + chr(load8(np + q)); q = q + 1; }
        die_str("mayc: unknown function `${fname}`\n");
    }
    if (li < 0) {
        ld_abs(ctx, glob_off(ctx, gi));
    } else {
        ld_local(ctx, 8 * (li + 1));
    }
    let cv: Any = loc_add(ctx, addr("0cl"), 3);
    st_local(ctx, 8 * (cv + 1));
    cg_apply(ctx, cv, args);
    return 0;
}

fun call_rt0(ctx: Any, s: Any, sl: Any) -> Any {
    let fr: Any = backend_find_func(ctx, s, sl);
    if (fr == 0) { die_str("mayc: missing runtime fn\n"); }
    call(ctx, fr.lab);
    return 0;
}

fun call_rt1(ctx: Any, s: Any, sl: Any) -> Any {
    e8(ctx, 80);
    call_rt0(ctx, s, sl);
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 8);
    return 0;
}

fun call_rt2(ctx: Any, s: Any, sl: Any) -> Any {
    call_rt0(ctx, s, sl);
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 16);
    return 0;
}

fun intern_obj(ctx: Any, s: Any, st: Any, n: Any) -> Any {
    mut off: Any = ctx.data.length;
    let r: Any = off % 8;
    if (r != 0) { off = off + (8 - r); ctx.data.length = off; }
    let ln: Any = declen(s, st, n);
    dalloc(ctx, ln + 9);
    store64(ctx.data.data + off, ln);
    decopy(ctx.data.data + off + 8, s, st, n);
    store8(ctx.data.data + off + 8 + ln, 0);
    return off;
}

fun addr_tag(ctx: Any, off: Any, tag: Any) -> Any {
    return x86_relocated_immediate(ctx, 0, tag, off);
}

fun jfalse(ctx: Any, lab: Any) -> Any {
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 248); e8(ctx, 2);
    jcc(ctx, 132, lab);
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 248); e8(ctx, 3);
    jcc(ctx, 132, lab);
    return 0;
}

fun jtrue(ctx: Any, lab: Any) -> Any {
    let l1: Any = newlab(ctx);
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 248); e8(ctx, 2);
    jcc(ctx, 132, l1);
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 248); e8(ctx, 3);
    jcc(ctx, 132, l1);
    jmp(ctx, lab);
    placelab(ctx, l1);
    return 0;
}

fun set_true(ctx: Any) -> Any { e8(ctx, 184); e32(ctx, 4); return 0; }
fun set_false(ctx: Any) -> Any { e8(ctx, 184); e32(ctx, 3); return 0; }

fun cg_bin_dyn(ctx: Any, n: Any) -> Any {
    let op: Any = n.op;
    cg_expr(ctx, n.left);
    e8(ctx, 80);
    cg_expr(ctx, n.right);
    e8(ctx, 80);
    let fallback: Any = newlab(ctx); let done: Any = newlab(ctx);
    // Keep both original tagged operands on the stack as GC roots and for the
    // runtime fallback. Only integers use the inline path.
    for byte: Any in [72,139,68,36,8,72,139,12,36,72,137,194,72,9,202,246,194,7] { e8(ctx, byte); }
    jcc(ctx, 133, fallback);
    if (op == TK_PLUS or op == TK_MINUS or op == TK_STAR) {
        if (op == TK_PLUS) { e8(ctx, 72); e8(ctx, 1); e8(ctx, 200); }
        else if (op == TK_MINUS) { e8(ctx, 72); e8(ctx, 41); e8(ctx, 200); }
        else { untag_rax(ctx); e8(ctx, 72); e8(ctx, 15); e8(ctx, 175); e8(ctx, 193); }
        jcc(ctx, 128, fallback); // overflow uses the existing error path
    } else if (op == TK_SLASH or op == TK_PCT) {
        let shift: Any = x86_divisor_shift(n.right);
        if (shift >= 0) {
            untag_rax(ctx);
            x86_signed_power_divide(ctx, n.right.value, shift, op == TK_PCT);
            tag_rax(ctx);
        } else {
            e8(ctx, 72); e8(ctx, 133); e8(ctx, 201); jcc(ctx, 132, fallback);
            e8(ctx, 72); e8(ctx, 153); e8(ctx, 72); e8(ctx, 247); e8(ctx, 249);
            if (op == TK_PCT) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 208); }
            else {
                e8(ctx, 72); e8(ctx, 137); e8(ctx, 194); // save quotient
                tag_rax(ctx);
                for byte: Any in [73,137,195,73,193,251,3,73,57,211] { e8(ctx, byte); }
                jcc(ctx, 133, fallback); // tagged integer range overflow
            }
        }
    } else {
        cmp_rcx(ctx);
        if (op == TK_EQ) { setcc(ctx, 148); }
        else if (op == TK_NE) { setcc(ctx, 149); }
        else if (op == TK_LT) { setcc(ctx, 156); }
        else if (op == TK_LE) { setcc(ctx, 158); }
        else if (op == TK_GT) { setcc(ctx, 159); }
        else { setcc(ctx, 157); }
        e8(ctx, 72); e8(ctx, 131); e8(ctx, 192); e8(ctx, 3);
    }
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 16);
    jmp(ctx, done);
    placelab(ctx, fallback);
    if (op == TK_PLUS) { call_rt2(ctx, addr("rt_add"), len("rt_add")); }
    else if (op == TK_MINUS) { call_rt2(ctx, addr("rt_sub"), len("rt_sub")); }
    else if (op == TK_STAR) { call_rt2(ctx, addr("rt_mul"), len("rt_mul")); }
    else if (op == TK_SLASH) { call_rt2(ctx, addr("rt_div"), len("rt_div")); }
    else if (op == TK_PCT) { call_rt2(ctx, addr("rt_mod"), len("rt_mod")); }
    else if (op == TK_EQ) { call_rt2(ctx, addr("rt_eq"), len("rt_eq")); }
    else if (op == TK_NE) { call_rt2(ctx, addr("rt_ne"), len("rt_ne")); }
    else if (op == TK_LT) { call_rt2(ctx, addr("rt_lt"), len("rt_lt")); }
    else if (op == TK_LE) { call_rt2(ctx, addr("rt_le"), len("rt_le")); }
    else if (op == TK_GT) { call_rt2(ctx, addr("rt_gt"), len("rt_gt")); }
    else { call_rt2(ctx, addr("rt_ge"), len("rt_ge")); }
    placelab(ctx, done);
    return 0;
}

fun cg_un_dyn(ctx: Any, n: Any) -> Any {
    let op: Any = n.op;
    cg_expr(ctx, n.operand);
    if (op == TK_MINUS) {
        call_rt1(ctx, addr("rt_neg"), len("rt_neg"));
    } else {
        call_rt1(ctx, addr("rt_not"), len("rt_not"));
    }
    return 0;
}



fun cg_print(ctx: Any, args: Any) -> Any {
    mut cnt: Any = 0;
    mut cur: Any = args;
    while (cur != 0) {
        cg_expr(ctx, cur);
        e8(ctx, 80);
        cnt = cnt + 1;
        cur = cur.next;
    }
    mut i: Any = 0;
    while (i < cnt) {
        if (i > 0) { call_rt0(ctx, addr("rt_space"), len("rt_space")); }
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 132); e8(ctx, 36); e32(ctx, 8 * (cnt - 1 - i));
        call_rt1(ctx, addr("str"), len("str"));
        call_rt1(ctx, addr("rt_print_str"), len("rt_print_str"));
        i = i + 1;
    }
    call_rt0(ctx, addr("rt_newline"), len("rt_newline"));
    let total: Any = cnt * 8;
    if (total > 0) {
        if (total < 128) { e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, total); }
        else { e8(ctx, 72); e8(ctx, 129); e8(ctx, 196); e32(ctx, total); }
    }
    return 0;
}

fun cg_syscall_dyn(ctx: Any, args: Any) -> Any {
    x86_syscall_arguments(ctx, args, true);
    e8(ctx, 15); e8(ctx, 5);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 3);       // shl rax, 3
    return 0;
}



fun cg_icall(ctx: Any, n: Any) -> Any {
    cg_expr(ctx, n.callee);
    let cv: Any = loc_add(ctx, addr("0ic"), 3);
    st_local(ctx, 8 * (cv + 1));
    let lnil: Any = newlab(ctx);
    let lend: Any = newlab(ctx);
    ld_local(ctx, 8 * (cv + 1));
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 248); e8(ctx, 2);
    jcc(ctx, 132, lnil);
    cg_apply(ctx, cv, n.args);
    jmp(ctx, lend);
    placelab(ctx, lnil);
    mov_imm(ctx, 2);
    placelab(ctx, lend);
    return 0;
}

fun mov_argreg(ctx: Any, i: Any) -> Any {
    if (i == 0) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 199); }
    else if (i == 1) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 198); }
    else if (i == 2) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 194); }
    else if (i == 3) { e8(ctx, 72); e8(ctx, 137); e8(ctx, 193); }
    else if (i == 4) { e8(ctx, 73); e8(ctx, 137); e8(ctx, 192); }
    else { e8(ctx, 73); e8(ctx, 137); e8(ctx, 193); }
    return 0;
}

fun cg_ccall6(ctx: Any, args: Any) -> Any {
    cg_expr(ctx, args);
    untag_rax(ctx);
    let fs: Any = loc_add(ctx, addr("0cc"), 3);
    st_local(ctx, 8 * (fs + 1));
    mut cur: Any = args.next;
    mut i: Any = 0;
    while (cur != 0) {
        cg_expr(ctx, cur);
        untag_rax(ctx);
        let si: Any = loc_add(ctx, addr("0cr"), 3);
        st_local(ctx, 8 * (si + 1));
        ld_local(ctx, 8 * (si + 1));
        mov_argreg(ctx, i);
        i = i + 1;
        cur = cur.next;
    }
    ld_local(ctx, 8 * (fs + 1));
    e8(ctx, 73); e8(ctx, 137); e8(ctx, 195);
    xor_eax(ctx);
    x86_root_registers(ctx);
    e8(ctx, 65); e8(ctx, 255); e8(ctx, 211);
    tag_rax(ctx);
    return 0;
}

fun cg_capval(ctx: Any, p: Any, l: Any) -> Any {
    mut i: Any = 0;
    while (i < ctx.envCount) {
        let c: Any = ctx.envCaptures[i];
        if (name_eq(p, l, c[0], c[1]) == 1) {
            ld_local(ctx, 8 * (ctx.envSlot + 1));
            e8(ctx, 72); e8(ctx, 139); e8(ctx, 128); e32(ctx, 8 * i);
            return 0;
        }
        i = i + 1;
    }
    cg_name(ctx, p, l);
    return 0;
}

fun cg_closure(ctx: Any, n: Any) -> Any {
    let lab: Any = n.label;
    let caps: Any = n.captures;
    let pc: Any = n.arity;
    addr_lab(ctx, lab, 6);
    e8(ctx, 80);
    mut cnt: Any = 0;
    mut cur0: Any = caps;
    while (cur0 != 0) {
        cnt = cnt + 1;
        cur0 = cur0.next;
    }
    if (cnt > 0) {
        mov_imm(ctx, cnt);
        call_rt1(ctx, addr("rt_env_new"), len("rt_env_new"));
        e8(ctx, 80);
        mut cur: Any = caps;
        mut i: Any = 0;
        while (cur != 0) {
            cg_capval(ctx, cur.name, cur.length);
            e8(ctx, 72); e8(ctx, 137); e8(ctx, 194);
            e8(ctx, 72); e8(ctx, 139); e8(ctx, 12); e8(ctx, 36);
            e8(ctx, 72); e8(ctx, 137); e8(ctx, 145); e32(ctx, 8 * i);
            cur = cur.next;
            i = i + 1;
        }
    } else {
        mov_imm(ctx, 0);
        e8(ctx, 80);
    }
    mov_imm(ctx, pc);
    e8(ctx, 80);
    call_rt0(ctx, addr("rt_closure3"), len("rt_closure3"));
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 24);
    return 0;
}

fun cg_operation(ctx: Any, n: Any) -> Any {
    let k: Any = n.kind;
    if (k == E_INT) {
        if (ctx.mode == 0) { mov_imm(ctx, n.value); }
        else { mov_imm(ctx, n.value); e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 3); }
    }
    else if (k == E_STR) {
        if (ctx.mode == 0) {
            let off: Any = intern(ctx, n.span.source, n.start, n.length);
            addr_of(ctx, off);
        } else {
            let off: Any = intern_obj(ctx, n.span.source, n.start, n.length);
            addr_tag(ctx, off, 3);
        }
    }
    else if (k == E_VAR) { cg_var(ctx, n); }
    else if (k == E_INDEX) {
        if (ctx.mode == 0) { die_str("mayc: index in raw mode\n"); }
        cg_expr(ctx, n.object);
        e8(ctx, 80);
        cg_expr(ctx, n.index);
        e8(ctx, 80);
        call_rt2(ctx, addr("rt_index_get"), len("rt_index_get"));
    }
    else if (k == E_GET) {
        if (ctx.mode == 0) { die_str("mayc: get in raw mode\n"); }
        cg_expr(ctx, n.object);
        e8(ctx, 80);
        let off: Any = intern_obj(ctx, n.span.source, n.start, n.length);
        addr_tag(ctx, off, 3);
        e8(ctx, 80);
        call_rt2(ctx, addr("rt_map_get"), len("rt_map_get"));
    }
    else if (k == E_CLOSURE) {
        if (ctx.mode == 0) { die_str("mayc: closure in raw mode\n"); }
        cg_closure(ctx, n);
    }
    else if (k == E_CAPVAR) {
        if (ctx.mode == 0) { die_str("mayc: capvar in raw mode\n"); }
        ld_local(ctx, 8 * (ctx.envSlot + 1));
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 128); e32(ctx, 8 * n.index);
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 0);
    }
    else if (k == E_ICALL) {
        if (ctx.mode == 0) { die_str("mayc: icall in raw mode\n"); }
        cg_icall(ctx, n);
    }
    else if (k == E_FLOAT) {
        if (ctx.mode == 0) { die_str("mayc: float in raw mode\n"); }
        // Parse literals once in the compiler. Emit their exact binary64 bits
        // and allocate a fresh runtime box, rather than reparsing every use.
        let value: Any = float(symbol_name(n.span.source + n.start, n.length));
        let address: Any = addr(value);
        e8(ctx, 72); e8(ctx, 184); e32(ctx, load32(address)); e32(ctx, load32(address + 4));
        call_rt1(ctx, addr("rt_box"), len("rt_box"));
    }
    else if (k == E_STRB) {
        if (ctx.mode == 0) { die_str("mayc: strb in raw mode\n"); }
        let off: Any = intern_obj2(ctx, n.address, n.length);
        addr_tag(ctx, off, 3);
    }
    else if (k == E_RANGE) {
        if (ctx.mode == 0) { die_str("mayc: range in raw mode\n"); }
        cg_range(ctx, n);
    }
    else if (k == E_POW) {
        if (ctx.mode == 0) { die_str("mayc: pow in raw mode\n"); }
        cg_expr(ctx, n.left);
        e8(ctx, 80);
        cg_expr(ctx, n.right);
        e8(ctx, 80);
        call_rt2(ctx, addr("rt_pow"), len("rt_pow"));
    }
    else if (k == E_BIN) {
        if (ctx.mode == 0) { cg_bin(ctx, n); } else { cg_bin_dyn(ctx, n); }
    }
    else if (k == E_UN) {
        if (ctx.mode == 0) { cg_un(ctx, n); } else { cg_un_dyn(ctx, n); }
    }
    else if (k == E_CALL) { cg_call(ctx, n); }
    else { die_str("mayc: unsupported IR operation\n"); }
    return 0;
}

// -------------------------------------------------------------- statements


fun addr_lab(ctx: Any, lab: Any, tag: Any) -> Any {
    return x86_relocated_immediate(ctx, 0, 6, lab);
}

fun align8(ctx: Any) -> Any {
    let r: Any = ctx.code.length % 8;
    if (r != 0) {
        mut k: Any = 8 - r;
        while (k > 0) {
            e8(ctx, 0);
            k = k - 1;
        }
    }
    return 0;
}

fun cg_range(ctx: Any, n: Any) -> Any {
    cg_expr(ctx, n.start);
    e8(ctx, 80);
    cg_expr(ctx, n.end);
    e8(ctx, 80);
    if (n.inclusive == 1) { mov_imm(ctx, 4); } else { mov_imm(ctx, 3); }
    e8(ctx, 80);
    call_rt0(ctx, addr("rt_range"), len("rt_range"));
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 24);
    return 0;
}

fun fxmm0_from_rax(ctx: Any) -> Any { e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 110); e8(ctx, 192); return 0; }
fun fxmm1_from_rax(ctx: Any) -> Any { e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 110); e8(ctx, 200); return 0; }

fun cg_fbin(ctx: Any, args: Any) -> Any {
    let op: Any = args.value;
    let a: Any = args.next;
    let b: Any = a.next;
    cg_expr(ctx, a);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 250);
    fxmm0_from_rax(ctx);
    cg_expr(ctx, b);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 250);
    fxmm1_from_rax(ctx);
    if (op == 0) { e8(ctx, 242); e8(ctx, 15); e8(ctx, 88); e8(ctx, 193); }
    else if (op == 1) { e8(ctx, 242); e8(ctx, 15); e8(ctx, 92); e8(ctx, 193); }
    else if (op == 2) { e8(ctx, 242); e8(ctx, 15); e8(ctx, 89); e8(ctx, 193); }
    else { e8(ctx, 242); e8(ctx, 15); e8(ctx, 94); e8(ctx, 193); }
    e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 126); e8(ctx, 192);
    call_rt1(ctx, addr("rt_box"), len("rt_box"));
    return 0;
}

fun cg_fcmp(ctx: Any, args: Any) -> Any {
    let op: Any = args.value;
    let a: Any = args.next;
    let b: Any = a.next;
    cg_expr(ctx, a);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 250);
    fxmm0_from_rax(ctx);
    cg_expr(ctx, b);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 250);
    fxmm1_from_rax(ctx);
    e8(ctx, 102); e8(ctx, 15); e8(ctx, 47); e8(ctx, 193);
    if (op == 0) { setcc(ctx, 148); }
    else if (op == 1) { setcc(ctx, 149); }
    else if (op == 2) { setcc(ctx, 146); }
    else if (op == 3) { setcc(ctx, 150); }
    else if (op == 4) { setcc(ctx, 151); }
    else { setcc(ctx, 147); }
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 192); e8(ctx, 3);
    return 0;
}

fun cg_ftrunc(ctx: Any, args: Any) -> Any {
    cg_expr(ctx, args);
    fxmm0_from_rax(ctx);
    e8(ctx, 242); e8(ctx, 72); e8(ctx, 15); e8(ctx, 44); e8(ctx, 192);
    return 0;
}

fun cg_ffrac(ctx: Any, args: Any) -> Any {
    let b: Any = args.next;
    cg_expr(ctx, args);
    fxmm0_from_rax(ctx);
    e8(ctx, 242); e8(ctx, 72); e8(ctx, 15); e8(ctx, 44); e8(ctx, 208);
    e8(ctx, 242); e8(ctx, 72); e8(ctx, 15); e8(ctx, 42); e8(ctx, 202);
    e8(ctx, 242); e8(ctx, 15); e8(ctx, 92); e8(ctx, 193);
    cg_expr(ctx, b);
    e8(ctx, 242); e8(ctx, 72); e8(ctx, 15); e8(ctx, 42); e8(ctx, 208);
    e8(ctx, 242); e8(ctx, 15); e8(ctx, 89); e8(ctx, 194);
    e8(ctx, 242); e8(ctx, 72); e8(ctx, 15); e8(ctx, 44); e8(ctx, 192);
    return 0;
}

fun cg_fsign(ctx: Any, args: Any) -> Any {
    cg_expr(ctx, args);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 194);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 234); e8(ctx, 63);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 208);
    return 0;
}

fun cg_pow2_seq(ctx: Any) -> Any {
    e8(ctx, 217); e8(ctx, 192);
    e8(ctx, 217); e8(ctx, 252);
    e8(ctx, 220); e8(ctx, 233);
    e8(ctx, 217); e8(ctx, 201);
    e8(ctx, 217); e8(ctx, 240);
    e8(ctx, 217); e8(ctx, 232);
    e8(ctx, 222); e8(ctx, 193);
    e8(ctx, 217); e8(ctx, 253);
    e8(ctx, 221); e8(ctx, 217);
    e8(ctx, 221); e8(ctx, 92); e8(ctx, 36); e8(ctx, 248);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 68); e8(ctx, 36); e8(ctx, 248);
    return 0;
}

fun cg_f1op(ctx: Any, op: Any, x: Any) -> Any {
    cg_expr(ctx, x);
    mut boxed: Any = 1;
    if (op == 0) {
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 250);
        fxmm0_from_rax(ctx);
        e8(ctx, 242); e8(ctx, 15); e8(ctx, 81); e8(ctx, 192);
        e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 126); e8(ctx, 192);
    } else if (op == 1  or  op == 2  or  op == 3  or  op == 4) {
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 250);
        fxmm0_from_rax(ctx);
        e8(ctx, 102); e8(ctx, 15); e8(ctx, 58); e8(ctx, 11); e8(ctx, 192);
        if (op == 1) { e8(ctx, 1); }
        else if (op == 2) { e8(ctx, 2); }
        else if (op == 3) { e8(ctx, 0); }
        else { e8(ctx, 3); }
        e8(ctx, 102); e8(ctx, 72); e8(ctx, 15); e8(ctx, 126); e8(ctx, 192);
        if (op != 3) {
            boxed = 0;
            e8(ctx, 242); e8(ctx, 72); e8(ctx, 15); e8(ctx, 44); e8(ctx, 192);
            e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 3);
        }
    } else if (op == 12) {
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 64); e8(ctx, 250);
        e8(ctx, 72); e8(ctx, 15); e8(ctx, 186); e8(ctx, 240); e8(ctx, 63);
    } else if (op == 11) {
        e8(ctx, 221); e8(ctx, 64); e8(ctx, 250);
        e8(ctx, 217); e8(ctx, 234);
        e8(ctx, 222); e8(ctx, 201);
        cg_pow2_seq(ctx);
    } else if (op == 13) {
        e8(ctx, 221); e8(ctx, 64); e8(ctx, 250);
        e8(ctx, 217); e8(ctx, 225);
        e8(ctx, 221); e8(ctx, 92); e8(ctx, 36); e8(ctx, 248);
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 68); e8(ctx, 36); e8(ctx, 248);
    } else {
        if (op == 8) { e8(ctx, 217); e8(ctx, 237); }
        else if (op == 9) { e8(ctx, 217); e8(ctx, 232); }
        else if (op == 10) { e8(ctx, 217); e8(ctx, 236); }
        e8(ctx, 221); e8(ctx, 64); e8(ctx, 250);
        if (op == 5) { e8(ctx, 217); e8(ctx, 254); }
        else if (op == 6) { e8(ctx, 217); e8(ctx, 255); }
        else if (op == 7) { e8(ctx, 217); e8(ctx, 242); e8(ctx, 221); e8(ctx, 216); }
        else { e8(ctx, 217); e8(ctx, 241); }
        e8(ctx, 221); e8(ctx, 92); e8(ctx, 36); e8(ctx, 248);
        e8(ctx, 72); e8(ctx, 139); e8(ctx, 68); e8(ctx, 36); e8(ctx, 248);
    }
    if (boxed == 1) { call_rt1(ctx, addr("rt_box"), len("rt_box")); }
    return 0;
}

fun cg_fpow2(ctx: Any, x: Any, y: Any) -> Any {
    cg_expr(ctx, x);
    e8(ctx, 80);
    cg_expr(ctx, y);
    e8(ctx, 221); e8(ctx, 64); e8(ctx, 250);
    e8(ctx, 88);
    e8(ctx, 221); e8(ctx, 64); e8(ctx, 250);
    e8(ctx, 217); e8(ctx, 241);
    cg_pow2_seq(ctx);
    call_rt1(ctx, addr("rt_box"), len("rt_box"));
    return 0;
}

fun cg_let(ctx: Any, s: Any) -> Any {
    let p: Any = s.name;
    let l: Any = s.length;
    let e: Any = s.initializer;
    let g: Any = s.global;
    if (g == 1) {
        let gi: Any = glob_find(ctx, p, l);
        cg_expr(ctx, e);
        st_abs(ctx, glob_off(ctx, gi));
    } else {
        cg_expr(ctx, e);
        if (is_boxed(ctx, p, l) == 1) { call_rt1(ctx, addr("rt_box_val"), len("rt_box_val")); }
        let slot: Any = loc_add(ctx, p, l);
        let register: Any = x86_local_register(ctx, p, l);
        if (register >= 0) { x86_move_register(ctx, register, 0); }
        else { st_local(ctx, 8 * (slot + 1)); }
    }
    return 0;
}



fun cg_assign(ctx: Any, s: Any) -> Any {
    let p: Any = s.name;
    let l: Any = s.length;
    cg_expr(ctx, s.value);
    let li: Any = loc_find(ctx, p, l);
    if (li >= 0) {
        if (is_boxed(ctx, p, l) == 1) {
            e8(ctx, 80);
            ld_local(ctx, 8 * (li + 1));
            e8(ctx, 89);
            e8(ctx, 72); e8(ctx, 137); e8(ctx, 8);
        } else {
            let register: Any = x86_local_register(ctx, p, l);
            if (register >= 0) { x86_move_register(ctx, register, 0); }
            else { st_local(ctx, 8 * (li + 1)); }
        }
    } else {
        let gi: Any = glob_find(ctx, p, l);
        if (gi < 0) { die_str("mayc: assign to unknown\n"); }
        st_abs(ctx, glob_off(ctx, gi));
    }
    return 0;
}


fun cg_longjmp(ctx: Any) -> Any {
    let hd: Any = glob_find(ctx, addr("HDEPTH"), 6);
    let hs: Any = glob_find(ctx, addr("HSTACK"), 6);
    ld_abs(ctx, glob_off(ctx, hd));
    e8(ctx, 72); e8(ctx, 133); e8(ctx, 192);
    let live: Any = newlab(ctx);
    jcc(ctx, 133, live);
    call_rt0(ctx, addr("rt_die_uncaught"), len("rt_die_uncaught"));
    placelab(ctx, live);
    ld_abs(ctx, glob_off(ctx, hd));
    e8(ctx, 72); e8(ctx, 45); e32(ctx, 1);
    e8(ctx, 72); e8(ctx, 193); e8(ctx, 224); e8(ctx, 6);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 194);
    ld_abs(ctx, glob_off(ctx, hs));
    e8(ctx, 72); e8(ctx, 1); e8(ctx, 194);
    for byte: Any in [72,139,90,24,76,139,98,32,76,139,106,40,76,139,114,48,76,139,122,56] { e8(ctx, byte); }
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 66); e8(ctx, 16);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 34);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 106); e8(ctx, 8);
    e8(ctx, 255); e8(ctx, 224);
    return 0;
}







fun intern_obj2(ctx: Any, p: Any, n: Any) -> Any {
    mut off: Any = ctx.data.length;
    let r: Any = off % 8;
    if (r != 0) { off = off + (8 - r); ctx.data.length = off; }
    dalloc(ctx, n + 9);
    store64(ctx.data.data + off, n);
    mut j: Any = 0;
    while (j < n) {
        store8(ctx.data.data + off + 8 + j, load8(p + j));
        j = j + 1;
    }
    store8(ctx.data.data + off + 8 + n, 0);
    return off;
}

fun cg_setidx(ctx: Any, s: Any) -> Any {
    cg_expr(ctx, s.object);
    e8(ctx, 80);
    cg_expr(ctx, s.index);
    e8(ctx, 80);
    cg_expr(ctx, s.value);
    e8(ctx, 80);
    call_rt0(ctx, addr("rt_index_set"), len("rt_index_set"));
    e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 24);
    return 0;
}


// ------------------------------------------------------------------ driver

fun cg_func(ctx: Any, rec: Any) -> Any {
    if (ctx.dynamic == 0) { ctx.mode = 0; }
    else if (rec.mode == 1) { ctx.mode = 0; }
    else { ctx.mode = 1; }
    loc_reset(ctx);
    bx_use_list(ctx, rec.boxed);
    let pc: Any = rec.pc;
    let parr: Any = rec.parr;
    mut i: Any = 0;
    while (i < pc) {
        loc_add(ctx, parr[i].name, parr[i].length);
        i = i + 1;
    }
    let cc: Any = rec.cc;
    ctx.envCaptures = rec.caparr;
    ctx.envCount = cc;
    mut es: Any = 0;
    if (cc > 0) { es = loc_add(ctx, addr("0env"), 4); }
    ctx.envSlot = es;
    x86_allocate_temps(ctx, rec.ir);
    align8(ctx);
    x86_call_trampoline(ctx, rec);
    placelab(ctx, rec.abiLab);
    e8(ctx, 85);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 229);
    e8(ctx, 72); e8(ctx, 129); e8(ctx, 236);
    let fp: Any = ctx.code.length;
    e32(ctx, 0);
    x86_save_registers(ctx);
    if (cc > 0) { e8(ctx, 76); e8(ctx, 137); e8(ctx, 149); e32(ctx, 0 - 8 * (es + 1)); }
    xor_eax(ctx);
    i = 0;
    while (i < pc) {
        let promoted: Any = x86_local_register(ctx, parr[i].name, parr[i].length);
        if (i < 6) {
            let registers: Any = [7, 6, 2, 1, 8, 9];
            if (promoted >= 0) { x86_move_register(ctx, promoted, registers[i]); }
            else { x86_store_register(ctx, registers[i], 8 * (i + 1)); }
        } else {
            x86_argument_to_rax(ctx, i);
            if (promoted >= 0) { x86_move_register(ctx, promoted, 0); } else { st_local(ctx, 8 * (i + 1)); }
        }
        i = i + 1;
    }
    i = 0;
    while (i < pc) {
        if (is_boxed(ctx, parr[i].name, parr[i].length) == 1) {
            ld_local(ctx, 8 * (i + 1));
            call_rt1(ctx, addr("rt_box_val"), len("rt_box_val"));
            st_local(ctx, 8 * (i + 1));
        }
        i = i + 1;
    }
    ctx.returnLabel = newlab(ctx);
    ctx.restartLabel = newlab(ctx);
    placelab(ctx, ctx.restartLabel);
    if (rec.foreign == true) { ffi_emit_call(ctx, rec); }
    else { cg_ir(ctx, rec.ir); }
    placelab(ctx, ctx.returnLabel);
    x86_restore_registers(ctx);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 236);
    e8(ctx, 93);
    e8(ctx, 195);
    mut frame: Any = ctx.maxLocals * 8;
    let fr: Any = frame % 16;
    if (fr != 0) { frame = frame + (16 - fr); }
    store32(ctx.code.data + fp, frame);
    ctx.allocation = 0;
    return 0;
}

fun cg_program(ctx: Any) -> Any {


    // _start
    placelab(ctx, 0);
    if (ctx.target.os == "windows") { e8(ctx, 87); e8(ctx, 86); }
    if (ctx.dynamic == 1) {
        let st: Any = glob_find(ctx, addr("STACKTOP"), 8);
        e8(ctx, 72); e8(ctx, 137); e8(ctx, 224);      // mov rax, rsp
        st_abs(ctx, glob_off(ctx, st));
    }
    if (len(ctx.foreign) > 0) { ffi_start(ctx); }
    else if (ctx.target.os == "windows") {
        e8(ctx, 72); e8(ctx, 131); e8(ctx, 236); e8(ctx, 40);
        call(ctx, 1);
        e8(ctx, 72); e8(ctx, 131); e8(ctx, 196); e8(ctx, 40);
    } else { call(ctx, 1); }
    if (ctx.target.os == "windows") { xor_eax(ctx); e8(ctx, 94); e8(ctx, 95); e8(ctx, 195); }
    else {
        e8(ctx, 49); e8(ctx, 255); // xor edi, edi
        mov_imm(ctx, 60); e8(ctx, 15); e8(ctx, 5);
    }

    // main (top-level statements)
    ctx.mode = ctx.dynamic;
    loc_reset(ctx);
    bx_use_list(ctx, ctx.mainBoxed);
    x86_allocate_temps(ctx, ctx.mainIR);
    placelab(ctx, 1);
    e8(ctx, 85);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 229);
    e8(ctx, 72); e8(ctx, 129); e8(ctx, 236);
    let fp: Any = ctx.code.length;
    e32(ctx, 0);
    x86_save_registers(ctx);
    xor_eax(ctx);
    if (ctx.dynamic == 1) {
        call_rt0(ctx, addr("rt_init"), len("rt_init"));
        mut gi: Any = 0;
        while (gi < len(ctx.globals)) {
            addr_of(ctx, glob_off(ctx, gi));
            call_rt1(ctx, addr("rt_gc_root"), len("rt_gc_root"));
            gi = gi + 1;
        }
    }
    ctx.returnLabel = newlab(ctx);
    cg_ir(ctx, ctx.mainIR);
    placelab(ctx, ctx.returnLabel);
    if (len(ctx.foreign) > 0) { xor_eax(ctx); }
    x86_restore_registers(ctx);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 236);
    e8(ctx, 93);
    e8(ctx, 195);
    mut frame: Any = ctx.maxLocals * 8;
    let fr: Any = frame % 16;
    if (fr != 0) { frame = frame + (16 - fr); }
    store32(ctx.code.data + fp, frame);
    ctx.allocation = 0;

    return 0;
}

fun x86_emit_fiber(ctx: Any) -> Any {
    // Only programs using fibers need the context-switch routine.
    placelab(ctx, ctx.fiberLabel);
    e8(ctx, 85);
    e8(ctx, 83);
    e8(ctx, 65); e8(ctx, 84);
    e8(ctx, 65); e8(ctx, 85);
    e8(ctx, 65); e8(ctx, 86);
    e8(ctx, 65); e8(ctx, 87);
    e8(ctx, 72); e8(ctx, 137); e8(ctx, 39);
    e8(ctx, 72); e8(ctx, 139); e8(ctx, 38);
    e8(ctx, 65); e8(ctx, 95);
    e8(ctx, 65); e8(ctx, 94);
    e8(ctx, 65); e8(ctx, 93);
    e8(ctx, 65); e8(ctx, 92);
    e8(ctx, 91);
    e8(ctx, 93);
    e8(ctx, 195);
    return 0;
}

fun patch_all(ctx: Any) -> Any {
    let base: Any = ctx.layout.dataAddress;
    for chunk: Any in ctx.fixups.chunks {
        for index: Any in 0..(len(chunk) / 3) {
            let kind: Any = chunk[index * 3];
            let off: Any = chunk[index * 3 + 1];
            let tgt: Any = chunk[index * 3 + 2];
            if (kind == 0) {
                store32(ctx.code.data + off, lab_off(ctx, tgt) - (off + 4));
            } else if (kind >= 21 and kind <= 26) {
                mut value: Any = base + tgt;
                if (kind == 23) { value += 1; }
                else if (kind == 24) { value = (value + 8) * 8; }
                else if (kind == 25) { value += 5; }
                else if (kind == 26) { value = ctx.layout.codeAddress + lab_off(ctx, tgt); }
                if (value < 0 or value > 4294967295) { die_str("mayc: compact x86 address exceeds 32 bits\n"); }
                store32(ctx.code.data + off, value);
            } else if (kind == 1) {
                store64(ctx.code.data + off, base + tgt);
            } else if (kind == 3) {
                store64(ctx.code.data + off, base + tgt + 1);
            } else if (kind == 4) {
                store64(ctx.code.data + off, (base + tgt + 8) * 8);
            } else if (kind == 5) {
                store64(ctx.code.data + off, base + tgt + 5);
            } else if (kind == 6) {
                store64(ctx.code.data + off, ctx.layout.codeAddress + lab_off(ctx, tgt));
            } else if (kind == 7) {
                store32(ctx.code.data + off, base + tgt - (ctx.layout.codeAddress + off + 4));
            } else {
                store32(ctx.code.data + off, base + tgt);
            }
        }
    }
    return 0;
}

fun x86_emit(ctx: Any) -> Any {
    emission_begin(ctx);
    if (ctx.dynamic == 1) {
        ctx.fiberLabel = newlab(ctx);
    }
    cg_program(ctx);
    mut next: Any = 0;
    while (next < len(ctx.reachability.queue)) {
        let rec: Any = ctx.reachability.queue[next]; next += 1;
        cg_func(ctx, rec);
    }
    if (ctx.reachability.fiber) { x86_emit_fiber(ctx); }
    emission_finish(ctx);
    return 0;
}
