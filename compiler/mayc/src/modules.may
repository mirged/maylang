import "state.may";
import "ast.may";
import "sema.may";
// Module loading, canonical paths, and import metadata.
mut EXPAND_SEEN: Any = {};
mut EXPAND_ORIGINS: Any = [];
mut MODULE_IMPORTS: Any = {};
// Expansion order identifies modules independently of their filesystem roots.
mut MODULE_SYMBOLS: Any = {};
// The expanded import closure shares one buffer; one byte stays for the terminator.
let EXPAND_CAPACITY: Any = 4194304;
// Import directives being expanded, outermost first, as "path:line".
mut EXPAND_CHAIN: Any = [];

// Keep source spelling intact; semantic resolution handles module aliases.
fun emit_line(t: Any, ls: Any, le: Any, buf: Any, off: Any) -> Any {
    mut i: Any = ls;
    while (i < le) { store8(buf + off, load8(t + i)); off += 1; i += 1; }
    store8(buf + off, 10);
    return off + 1;
}

fun expand_room(off: Any, needed: Any, path: Any, line: Any) -> Any {
    if (needed <= EXPAND_CAPACITY - 1 - off) { return 0; }
    mut message: Any = "${path}:${line}: imported sources exceed the 4 MiB expansion limit\n";
    mut index: Any = len(EXPAND_CHAIN) - 1;
    while (index >= 0) { message = message + "  imported from ${EXPAND_CHAIN[index]}\n"; index -= 1; }
    die_str(message);
    return 0;
}

fun module_path(path: Any) -> Any {
    // Relative and absolute spellings must share one module identity.
    if (not starts_with(path, "/")) {
        let cwd: Any = irt_alloc(4096);
        let size: Any = syscall(79, cwd, 4096);
        if (size <= 0) { die_str("mayc: cannot resolve current directory\n"); }
        irt_trim(cwd, 4096, size);
        path = symbol_name(cwd, size - 1) + "/" + path;
    }
    let parts: Any = split(path, "/");
    let clean: Any = [];
    for part: Any in parts {
        if (part == "..") { if (len(clean) > 0) { pop(clean); } }
        else if (part != "." and part != "") { push(clean, part); }
    }
    return "/" + join(clean, "/");
}

fun module_file(path: Any) -> Any {
    if (starts_with(path, "stdlib/")) {
        let configured: Any = env("MAYLANG_STDLIB") ?? "";
        for directory: Any in split(configured, ":") {
            if (directory != "") {
                let candidate: Any = directory + "/" + substring(path, 7, len(path) - 7);
                if (file_ok(addr(candidate)) == 1) { return module_path(candidate); }
            }
        }
    }
    if (starts_with(path, "stdlib/") and file_ok(addr(path)) == 0) {
        // Find an installed sidecar or the checkout containing this compiler.
        let buffer: Any = irt_alloc(4096);
        let size: Any = syscall(89, addr("/proc/self/exe"), buffer, 4096);
        irt_trim(buffer, 4096, if (size > 0) { size } else { 0 });
        if (size > 0 and size < 4096) {
            let parts: Any = split(symbol_name(buffer, size), "/");
            pop(parts);
            while (len(parts) > 0) {
                let candidate: Any = join(parts, "/") + "/" + path;
                if (file_ok(addr(candidate)) == 1) { return module_path(candidate); }
                pop(parts);
            }
        }
    }
    return module_path(path);
}

fun register_import(owner: Any, target: Any, text: Any, start: Any, end: Any, quote: Any) -> Any {
    // Comments are outside the import grammar, including quoted comments.
    let tail: Any = trim(replace(split(symbol_name(text + quote + 1, end - quote - 1), "//")[0], "\t", " "));
    let line: Any = trim(replace(symbol_name(text + start, end - start), "\t", " "));
    mut alias: Any = "";
    mut selected: Any = [];
    mut plain: Any = true;
    if (starts_with(tail, "as ")) {
        alias = trim(replace(substring(tail, 3, len(tail) - 3), ";", ""));
        plain = false;
    } else if (starts_with(line, "from ") or starts_with(line, "from\"")) {
        let names: Any = trim(replace(substring(tail, 7, len(tail) - 7), ";", ""));
        for name: Any in split(names, ",") { push(selected, trim(name)); }
    } else {
        let parts: Any = split(target, "/");
        alias = replace(parts[len(parts) - 1], ".may", "");
    }
    push(MODULE_IMPORTS[owner], {"path": target, "alias": alias, "plain": plain, "selected": selected});
    return 0;
}

fun hash(pp: Any, pl: Any) -> Any {
    mut h: Any = 5381;
    mut i: Any = 0;
    while (i < pl) {
        h = (h * 131 + load8(pp + i)) % 2147483647;
        i = i + 1;
    }
    return h;
}

fun import_line(t: Any, ls: Any, le: Any) -> Any {
    mut i: Any = ls;
    while (i < le) {
        let b: Any = load8(t + i);
        if (b == 32  or  b == 9) { i = i + 1; } else { break; }
    }
    if (le - i >= 6 and name_eq(t + i, 6, addr("import"), 6) == 1 and (le - i == 6 or has([32, 9, 34], load8(t + i + 6)))) { return 1; }
    if (le - i >= 4 and name_eq(t + i, 4, addr("from"), 4) == 1 and (le - i == 4 or has([32, 9, 34], load8(t + i + 4)))) { return 1; }
    return 0;
}

fun findq(t: Any, ls: Any, le: Any, which: Any) -> Any {
    mut i: Any = ls;
    if (which == 0) {
        while (i < le) {
            if (load8(t + i) == 34) { return i; }
            i = i + 1;
        }
    } else {
        mut first: Any = false;
        while (i < le) {
            if (load8(t + i) == 34) {
                if (first) { return i; }
                first = true;
            }
            i = i + 1;
        }
    }
    return 0 - 1;
}

fun file_ok(p: Any) -> Any {
    let fd: Any = syscall(2, p, 0, 0);
    if (fd < 0) { return 0; }
    syscall(3, fd);
    return 1;
}

// Import-looking lines inside comments or multiline/interpolated strings are
// source text, not module directives. Carry lexical context across lines.
fun module_scan_line(text: Any, start: Any, end: Any, scan_state: Any) -> Any {
    mut i: Any = start;
    while (i < end) {
        let c: Any = load8(text + i);
        let next: Any = if (i + 1 < end) { load8(text + i + 1) } else { 0 };
        if (scan_state.block > 0) {
            if (c == 47 and next == 42) { scan_state.block += 1; i += 2; }
            else if (c == 42 and next == 47) { scan_state.block -= 1; i += 2; }
            else { i += 1; }
            continue;
        }
        let context: Any = if (len(scan_state.stack) > 0) { scan_state.stack[len(scan_state.stack) - 1] } else { nil };
        if (context != nil and context.kind == "string") {
            if (c == 92) { i += 2; continue; }
            if (c == 34) { pop(scan_state.stack); }
            else if (c == 36 and next == 123) { push(scan_state.stack, {"kind": "code", "depth": 1}); i += 2; continue; }
        } else {
            if (c == 47 and next == 47) { break; }
            if (c == 47 and next == 42) { scan_state.block = 1; i += 2; continue; }
            if (c == 34) { push(scan_state.stack, {"kind": "string"}); }
            else if (context != nil) {
                if (c == 123) { context.depth += 1; }
                if (c == 125) { context.depth -= 1; if (context.depth == 0) { pop(scan_state.stack); } }
            }
        }
        i += 1;
    }
    return 0;
}

// A semicolon terminates only the import; following source stays on its line.
fun module_import_end(text: Any, start: Any, end: Any) -> Any {
    mut i: Any = start; mut depth: Any = 0;
    while (i < end) {
        let c: Any = load8(text + i);
        let next: Any = if (i + 1 < end) { load8(text + i + 1) } else { 0 };
        if (depth > 0) {
            if (c == 47 and next == 42) { depth += 1; i += 2; }
            else if (c == 42 and next == 47) { depth -= 1; i += 2; }
            else { i += 1; }
        } else {
            if (c == 47 and next == 47) { return end; }
            if (c == 47 and next == 42) { depth = 1; i += 2; continue; }
            if (c == 59) { return i + 1; }
            i += 1;
        }
    }
    return end;
}

fun append_file(pp: Any, pl: Any, buf: Any, off: Any) -> Any {
    let canonical: Any = module_file(symbol_name(pp, pl));
    // Imports, source origins and visibility maps use this same final path.
    if (has(EXPAND_SEEN, canonical)) { return off; }
    EXPAND_SEEN[canonical] = true;
    MODULE_SYMBOLS[canonical] = "module" + str(len(MODULE_SYMBOLS));
    MODULE_IMPORTS[canonical] = [];

    pp = addr(canonical);
    pl = load64(addr(canonical) - 8);
    let text: Any = slurp(pp, pl);
    let tn: Any = LASTLEN;

    if (text == 0) { die_str("mayc: cannot read ${symbol_name(pp, pl)}\n"); }

    let sourcePath: Any = canonical;
    mut sourceLine: Any = 1;
    mut dl: Any = 0;
    mut k: Any = 0;
    while (k < pl) {
        if (load8(pp + k) == 47) { dl = k + 1; } // '/'
        k = k + 1;
    }
    mut i: Any = 0;
    let lexical: Any = {"block": 0, "stack": []};
    while (i < tn) {
        let ls: Any = i;
        while (i < tn) {
            if (load8(text + i) == 10) { break; } // '\n'
            i = i + 1;
        }
        let le: Any = i;
        mut segment: Any = ls;
        // An empty physical line still belongs to the source-origin mapping.
        if (segment == le) {
            expand_room(off, 1, sourcePath, sourceLine);
            push(EXPAND_ORIGINS, SourceOrigin(off, sourcePath, sourceLine));
            off = emit_line(text, ls, le, buf, off);
        }
        while (segment < le) {
            let directive: Any = lexical.block == 0 and len(lexical.stack) == 0 and import_line(text, segment, le) == 1;
            if (directive) {
                let q1: Any = findq(text, segment, le, 0);
                let q2: Any = findq(text, segment, le, 1);
                if (q1 < 0 or q2 <= q1 + 1) { die_str("${sourcePath}:${sourceLine}: invalid import path\n"); }
                let finish: Any = module_import_end(text, q2 + 1, le);
                module_scan_line(text, segment, finish, lexical);
                mut imported: Any = symbol_name(text + q1 + 1, q2 - q1 - 1);
                let parts: Any = split(imported, "/");
                if (not contains(parts[len(parts) - 1], ".")) { imported = imported + ".may"; }
                let candidate: Any = if (starts_with(imported, "/")) { imported } else { symbol_name(pp, dl) + imported };
                let target: Any = if (file_ok(addr(candidate)) == 1) { module_file(candidate) } else { module_file("stdlib/" + imported) };
                register_import(sourcePath, target, text, segment, finish, q2);
                push(EXPAND_CHAIN, "${sourcePath}:${sourceLine}");
                off = append_file(addr(target), load64(addr(target) - 8), buf, off);
                pop(EXPAND_CHAIN);
                segment = finish;
            } else {
                module_scan_line(text, segment, le, lexical);
                // Column padding, the copied line and its newline.
                expand_room(off, le - ls + 1, sourcePath, sourceLine);
                push(EXPAND_ORIGINS, SourceOrigin(off, sourcePath, sourceLine));
                // Preserve original columns for code after one or more imports.
                mut padding: Any = ls;
                while (padding < segment) { store8(buf + off, 32); off += 1; padding += 1; }
                off = emit_line(text, segment, le, buf, off);
                segment = le;
            }
        }
        i = i + 1;
        sourceLine = sourceLine + 1;
    }
    return off;
}

fun expand(pp: Any, pl: Any) -> Any {
    EXPAND_SEEN = {};
    MODULE_IMPORTS = {};
    MODULE_SYMBOLS = {};
    EXPAND_ORIGINS = [];
    EXPAND_CHAIN = [];
    let buf: Any = irt_alloc(EXPAND_CAPACITY);
    let off: Any = append_file(pp, pl, buf, 0);
    store8(buf + off, 0);
    SRC = buf;
    SRCLEN = off;
    SOURCE_FILES[buf] = SourceFile(symbol_name(pp, pl), EXPAND_ORIGINS);
    return 0;
}
