import "state.may";
import "emitter.may";
import "ast.may";
import "ir.may";
import "diagnostics.may";
import "sema.may";
import "symbols.may";
import "backend/x86_64.may";
import "backend/x86_64_fat.may";

// Target selection is independent of the host running mayc.
struct Target { name: Any, arch: Any, os: Any, format: Any, machine: Any, alignment: Any, runtime: Any }
struct TargetBackend { emit: Any, patch: Any }

fun target_select(name: Any) -> Any {
    if (name == "clang-llvm") { die_str("mayc: the clang-llvm target was removed; mayc emits native executables itself\n"); }
    if (name == "x86_64-linux") { return Target(name, "x86_64", "linux", "elf", 62, 4096, true); }
    if (has(["x86_64-nodeos", "arm64-linux", "riscv64-linux", "arm64-macos", "x86_64-windows"], name)) {
        die_str("mayc: target ${name} is frozen; Maylang currently supports x86_64-linux (see frozen/README.md)\n");
    }
    die_str("mayc: unknown target `${name}`\n");
    return 0;
}

// Each backend implements the same IR-to-code and relocation entry points.
fun backend_for(ctx: Any) -> Any { return TargetBackend(x86_emit, patch_all); }

// `--no-code-align` keeps RAW x86-64 code unpadded (#83).
fun backend_disable_code_alignment() -> Any { X86_FUNCTION_ALIGN = 0; X86_LOOP_ALIGN = 0; return 0; }

fun backend_emit(ctx: Any) -> Any {
    let selected: Any = backend_for(ctx);
    let emit: Any = selected.emit;
    return emit(ctx);
}

fun backend_patch(ctx: Any) -> Any {
    let selected: Any = backend_for(ctx);
    let patch: Any = selected.patch;
    return patch(ctx);
}
