print(nil);
print(true, false);
print(0, -0, 999999, -999999);
print(0.0, -0.0, 1.5, -1.5);
print("", "abc", "with space");
print([], [1,2], [[]], [nil, true]);
print({}, {"a": 1}, {"nested": {"x": 1}});
print(type(nil), type(true), type(1), type(1.0), type("s"), type([1]), type({"a":1}));
print(bool(0), bool(1), bool(""), bool("x"), bool(nil), bool([]), bool([1]));
