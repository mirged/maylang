// sort_ints: 10 000 pseudo-random Ints through the stdlib sort, then a check
// that the result is ordered.
mut state: Int = 12345;
let xs: List<Int> = [];
mut i: Int = 0;
while (i < 10000) {
    state = (state * 1103515245 + 12345) % 2147483648;
    push(xs, state % 100000);
    i += 1;
}
let sorted: List<Int> = sort(xs);
mut sum: Int = 0;
mut ordered: Int = 1;
i = 0;
while (i < len(sorted)) {
    sum = (sum + sorted[i] * (i % 7)) % 1000000007;
    if (i > 0) { if (sorted[i - 1] > sorted[i]) { ordered = 0; } }
    i += 1;
}
print(ordered, sum, len(xs), xs[0], sorted[0], sorted[len(sorted) - 1]);
