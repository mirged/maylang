// floor, ceil and round return Floats. RISC-V rounds below 2^52 through an
// integer, so cover both sides of that boundary, signed zeros and non-finite values.
let nan: Float = sqrt(-1.0);
print(floor(2.5), ceil(2.5), floor(-2.5), ceil(-2.5), ceil(-0.5), floor(-0.0), floor(0.5));
print(floor(1.0e300) == 1.0e300, ceil(-1.0e300) == -1.0e300, floor(nan), ceil(-1.0e308 * 10.0));
print(round(2.5), round(-2.5), round(2.4), round(0.49999999999999994), round(-0.0));
print(round(4503599627370497.0) == 4503599627370497.0, floor(4503599627370495.5) == 4503599627370495.0,
    ceil(4503599627370495.5) == 4503599627370496.0, ceil(-4503599627370495.5) == -4503599627370495.0);
exit(0);
