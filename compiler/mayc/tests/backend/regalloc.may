import "../../src/regalloc.may";
import "../../src/ir.may";
import "../../src/ast.may";

fun value(slot: Any) -> Any { return IRValue(IR_TEMP, slot, 0, 0, 0, 0, 0, 0); }
fun define(slot: Any) -> Any { return Quad(E_INT, value(slot), 0, 0, {"value": slot}, 0); }
fun use(slot: Any) -> Any { return Quad(S_ASSIGN, 0, value(slot), 0, {"value": value(slot)}, 0); }
fun require(ok: Bool) -> Nil { if not ok { fail("register allocation invariant failed"); } return; }

// Expiration reuses both the register and stack home.
let reuse: Any = lsra_allocate(IRBlock([define(0), use(0), define(1), use(1)], 2), [12]);
require(reuse.locations[0].register == 12 and reuse.locations[1].register == 12);
require(reuse.locations[0].home == reuse.locations[1].home and reuse.stackSlots == 1);

// A shorter incoming interval evicts the interval ending farthest away.
let pressure: Any = lsra_allocate(IRBlock([define(0), define(1), use(1), use(0)], 2), [12]);
require(pressure.locations[0].register == -1 and pressure.locations[1].register == 12);
require(pressure.locations[0].home != pressure.locations[1].home);
// A longer incoming interval is itself spilled.
let incoming: Any = lsra_allocate(IRBlock([define(0), define(1), use(0), use(1)], 2), [12]);
require(incoming.locations[0].register == 12 and incoming.locations[1].register == -1);

// Call operands and surviving values get root homes; call results do not
// enter the root list until after their first definition has executed.
let call: Any = Quad(IR_RUNTIME, value(1), value(0), 0, "rt_len", 0);
let roots: Any = lsra_allocate(IRBlock([define(0), call, use(0), use(1)], 2), [12, 13]);
require(roots.locations[0].register >= 0 and roots.locations[1].register >= 0);
require(len(roots.roots[1]) == 1 and roots.roots[1][0].slot == 0);
require(len(roots.roots[2]) == 2);

// A loop-carried, multiply-defined value needs a private home even when its
// last lexical use precedes a later temporary and the back-edge jump.
let loop: Any = IRBlock([define(0), Quad(IR_LABEL, 0, 0, 0, 50, 0), use(0),
    define(1), Quad(IR_COPY, value(0), value(1), 0, 0, 0),
    define(2), use(2), Quad(IR_JUMP, 0, 0, 0, 50, 0)], 3);
let pinned: Any = lsra_allocate(loop, [12]);
require(pinned.locations[0].pinned == true and pinned.locations[0].register == -1);
require(pinned.locations[0].home != pinned.locations[2].home);

// Volatile registers (#87) hold only intervals no call clobbers. calls[p] is
// 1 for a user call and 2 for a syscall; volatile[0] may carry an argument.
let site: Any = Quad(E_CALL, value(2), 0, 0, {"args": value(1)}, 0);
let spanning: Any = IRBlock([define(0), define(1), site, use(0), use(2)], 3);
let user: Any = lsra_plan_calls(spanning, [12, 13], false, [10, 9, 8], [0, 0, 1, 0, 0]);
// 0 spans the call; 1 is its argument; 2 is defined by it.
require(user.locations[0].register == 12 or user.locations[0].register == 13);
require(user.locations[1].register == 10 and user.locations[2].register == 8);
let system: Any = lsra_plan_calls(spanning, [12, 13], false, [10, 9, 8], [0, 0, 2, 0, 0]);
require(system.locations[1].register >= 12 and system.locations[2].register == 8);
require(lsra_member(system.used, 8) and lsra_member(system.used, 12));
// Without a call every interval may take a volatile register, back first.
let free: Any = lsra_plan_calls(IRBlock([define(0), use(0)], 1), [12], false, [10, 9, 8], [0, 0]);
require(free.locations[0].register == 8 and not lsra_member(free.used, 12));
// Without a fitting register, a call-spanning interval spills rather than
// evicting a volatile one.
let tight: Any = lsra_plan_calls(spanning, [], false, [10, 9, 8], [0, 0, 1, 0, 0]);
require(tight.locations[0].register == -1 and tight.locations[1].register == 10);

let noRegisters: Any = lsra_allocate(IRBlock([define(0), use(0), define(1), use(1)], 2), []);
require(len(noRegisters.used) == 0 and noRegisters.stackSlots == 1);
let empty: Any = lsra_allocate(IRBlock([], 0), [12]);
require(len(empty.used) == 0 and empty.stackSlots == 0 and len(empty.roots) == 0);

// Raw literals need neither registers, stack homes, nor roots. A literal may
// span labels, but a multiply-defined loop index must retain its private home.
let literals: Any = lsra_plan(IRBlock([define(0), Quad(IR_LABEL, 0, 0, 0, 50, 0), use(0)], 1), [12], true);
require(literals.locations[0].literal == 0 and literals.locations[0].register == -1);
require(literals.locations[0].home == -1 and literals.stackSlots == 0 and len(literals.used) == 0);
let literalLoop: Any = lsra_plan(loop, [12], true);
require(literalLoop.locations[0].literal == nil and literalLoop.locations[0].pinned == true);
require(literalLoop.locations[0].home >= 0);
require(literalLoop.locations[0].maximum == nil);
require(literalLoop.locations[1].literal == 1 and literalLoop.locations[1].home == -1);
// Raw address constants and unread results must never reserve a callee-save
// register or frame home. Default allocation retains its existing behavior.
let address: Any = {"span": 0, "start": 0, "length": 3};
let addressPlan: Any = lsra_plan(IRBlock([Quad(E_STR, value(0), 0, 0, address, 0), use(0)], 1), [12], true);
require(addressPlan.locations[0].address == address and addressPlan.stackSlots == 0 and len(addressPlan.used) == 0);
let unread: Any = lsra_plan(IRBlock([Quad(E_CALL, value(0), 0, 0, {"args": 0}, 0)], 1), [12], true);
require(unread.locations[0].register == -1 and unread.locations[0].home == -1 and unread.stackSlots == 0);
print("allocator-ok");
