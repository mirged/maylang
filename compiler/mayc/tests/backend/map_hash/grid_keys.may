// Packed coordinates share their low bits, which the probe sequence spreads.
let m: Map<Int, Int> = {};
mut x: Int = 0;
while (x < 600) {
    mut y: Int = 0;
    while (y < 600) { m[x * 65536 + y] = x + y; y += 1; }
    x += 1;
}
mut sum: Int = 0;
x = 0;
while (x < 600) {
    mut y: Int = 0;
    while (y < 600) { sum += m[x * 65536 + y] ?? 0; y += 1; }
    x += 1;
}
print(sum);
