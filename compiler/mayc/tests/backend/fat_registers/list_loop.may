// Reads and writes of List<Int> elements in a function.
fun run(size: Int, rounds: Int) -> Int {
    let xs: List<Int> = [];
    for i: Int in 0..size { push(xs, i % 97); }
    mut total: Int = 0;
    mut round: Int = 0;
    while (round < rounds) {
        mut i: Int = 1;
        while (i < size) {
            xs[i] = (xs[i] + xs[i - 1]) % 65521;
            total += xs[i];
            i += 1;
        }
        round += 1;
    }
    return total;
}
print(run(100000, 300));
