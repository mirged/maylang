// A Float loop body stays tagged for now: its locals already live in the fat
// backend's XMM homes, so the native loop would not pay.
fun run(n: Int, x: Float) -> Float {
    mut acc: Float = x;
    mut i: Int = 0;
    while (i < n) { acc = acc * 1.0000001 + 0.5; i += 1; }
    return acc;
}
print(run(50000000, 1.0));
