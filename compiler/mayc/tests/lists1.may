let a: Any = [1, 2, 3];
print(a, len(a), a[0], a[2]);
push(a, 4);
print(a, pop(a), a);
print(a[10]);
print(slice([1,2,3,4,5], 1, 3));
print(sort([3,1,2]), reverse([1,2,3]));
print(sum([1,2,3,4]), product([1,2,3,4]));
print(min(3, 1), max(3, 1));
print(unique([1,1,2,3,3,3]));
print(flatten([[1,2],[3],[4,5]]));
print(zip([1,2,3], ["a","b","c"]));
print(enumerate(["a","b"]));
print(find([1,2,3], 2), find([1,2,3], 9));
print(count([1,2,2,3,2], 2));
print(range(0, 5), range_step(0, 10, 3));
print([], len([]));
