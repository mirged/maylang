// Register-allocated fat code (#96): forwarded constants and variable
// reads, fused compare-and-branch, immediate operands, power-of-two
// division, inline Float paths and callee-saved register homes for hot
// locals. The expected output was produced by the compiler before #96.

mut counter: Int = 0;
fun bump() -> Int { counter += 10; return counter; }

fun show(label: Str, value: Any) -> Nil { print(label, value); return; }

fun fault(f: () -> Any) -> Str {
    return may { str(f()) } otherwise { "${err.kind}: ${err.message}" };
}

// ------------------------------------------------ immediates and branches
fun compare_all(x: Int) -> Str {
    mut out: Str = "";
    if (x < 3) { out = out + "<"; }
    if (x <= 3) { out = out + "<="; }
    if (x == 3) { out = out + "=="; }
    if (x != 3) { out = out + "!="; }
    if (x >= 3) { out = out + ">="; }
    if (x > 3) { out = out + ">"; }
    let values: List<Bool> = [x < -200, x <= -200, x == -200, x != -200, x >= -200, x > -200];
    return out + " " + str(values);
}
for x: Int in [-1000, -200, 2, 3, 4, 1000000] { show("compare", compare_all(x)); }

fun arithmetic(x: Int) -> List<Int> {
    return [x + 1, x - 1, x * 3, x + 100000, x - 100000, x * -7, x * 1000000];
}
show("arith", arithmetic(0));
show("arith", arithmetic(-5));
show("arith", arithmetic(123456789));
show("add overflow", fault(fun() -> Any { let big: Int = 9223372036854775807; return big + 1; }));
show("sub overflow", fault(fun() -> Any { let small: Int = -9223372036854775807 - 1; return small - 1; }));
show("mul overflow", fault(fun() -> Any { let big: Int = 4611686018427387904; return big * 2; }));
show("mul overflow", fault(fun() -> Any { let big: Int = 3074457345618258603; return big * 3; }));

fun divisions(x: Int) -> List<Int> {
    return [x / 2, x % 2, x / 4, x % 4, x / 8, x % 8, x / 1024, x % 1024, x / 2147483648, x % 2147483648, x / 3, x % 3, x / 1, x % 1];
}
for x: Int in [0, 1, -1, 7, -7, 8, -8, 1023, -1023, 1025, -1025, 4294967297, -4294967297] { show("div", divisions(x)); }
show("div min", divisions(-9223372036854775807 - 1));
show("div max", divisions(9223372036854775807));
show("div zero", fault(fun() -> Any { let x: Int = 5; return x / 0; }));
show("mod zero", fault(fun() -> Any { let x: Int = 5; return x % 0; }));
show("div -1", fault(fun() -> Any { let x: Int = -9223372036854775807 - 1; return x / -1; }));
show("mod -1", -7 % -1);

// Any operands reach the runtime's paths.
fun dynamic(a: Any) -> List<Any> {
    return [a == 1, a != 1, a + 1, a * 2, a - 3];
}
show("dyn int", dynamic(5));
show("dyn float", dynamic(2.5));
show("dyn str", fault(fun() -> Any { return dynamic("s"); }));
show("dyn order", fault(fun() -> Any { let a: Any = "s"; return a < 1; }));
show("dyn float order", fault(fun() -> Any { let a: Any = 1.5; return a < 1; }));
show("dyn div", fault(fun() -> Any { let a: Any = 2.5; return a / 2; }));
show("dyn mod", fault(fun() -> Any { let a: Any = 2.5; return a % 2; }));
fun branch_any(a: Any) -> Str {
    if (a < 10) { return "small"; }
    if (a == 10) { return "ten"; }
    return "big";
}
show("branch any", [branch_any(3), branch_any(10), branch_any(11)]);
show("branch any float", fault(fun() -> Any { return branch_any(2.5); }));
show("branch any str", fault(fun() -> Any { return branch_any("x"); }));

// ------------------------------------------------------------- Floats
fun floats(a: Float, b: Float) -> List<Any> {
    return [a + b, a - b, a * b, a / b, a < b, a <= b, a == b, a != b, a >= b, a > b];
}
show("floats", floats(1.5, 2.25));
show("floats", floats(-0.0, 0.5));
fun nan_value() -> Float { return sqrt(-1.0); }
show("nan", floats(nan_value(), 1.0));
fun float_branches(a: Float, b: Float) -> Str {
    mut out: Str = "";
    if (a < b) { out = out + "<"; }
    if (a <= b) { out = out + "<="; }
    if (a == b) { out = out + "=="; }
    if (a != b) { out = out + "!="; }
    if (a >= b) { out = out + ">="; }
    if (a > b) { out = out + ">"; }
    if (!(a < b)) { out = out + "!<"; }
    if (!(a == b)) { out = out + "!=="; }
    return out;
}
show("fbranch", [float_branches(1.0, 2.0), float_branches(2.0, 2.0), float_branches(3.0, 2.0), float_branches(nan_value(), 2.0), float_branches(nan_value(), nan_value())]);
show("fdiv zero", fault(fun() -> Any { let a: Float = 1.0; let b: Float = 0.0; return a / b; }));
show("fdiv neg zero", fault(fun() -> Any { let a: Float = 1.0; let b: Float = -0.0; return a / b; }));
show("float literal", fault(fun() -> Any { let a: Float = 1.0; return a / 0.0; }));
fun mixed(a: Any, b: Any) -> Any { return a + b; }
show("mixed", fault(fun() -> Any { return mixed(1.5, 2); }));
show("mixed eq", [mixed(1.5, 2.5), 1.5 == to_float(1)]);

// ------------------------------------------------------ forwarding order
counter = 1;
show("read before call", counter + bump());
show("call before read", bump() + counter);
fun local_order() -> List<Int> {
    mut x: Int = 1;
    let first: Int = x;
    x = 5;
    let pair: List<Int> = [x, first, x + first];
    x = x * 2;
    push(pair, x);
    return pair;
}
show("local order", local_order());
let chosen: Int = if (counter > 5) { 1 } else { 2 };
show("if value", chosen);
show("if value nested", if (counter < 0) { "neg" } else if (counter < 100) { "small" } else { "big" });

// --------------------------------------------------------- register homes
fun hot(limit: Int, sink: List<Int>) -> Int {
    mut total: Int = 0;
    mut i: Int = 0;
    while (i < limit) {
        mut j: Int = 0;
        while (j < 10) { total = (total + i * j) % 1000003; j += 1; }
        i += 1;
    }
    push(sink, total);
    return total;
}
show("hot", hot(5000, []));

// Shadowing inside a loop must not share the outer local's register.
fun shadow(sink: List<Int>) -> List<Int> {
    let out: List<Int> = [];
    mut x: Int = 1;
    mut round: Int = 0;
    while (round < 3) {
        push(out, x);
        if (round > 0) { let x: Int = round * 100; push(out, x); }
        round += 1;
    }
    push(out, x);
    push(sink, 0);
    return out;
}
show("shadow", shadow([]));

// Swapped tail-call arguments read the old parameter values.
fun gcd_steps(a: Int, b: Int, steps: Int, sink: List<Int>) -> Int {
    if (b == 0) { push(sink, steps); return a * 1000 + steps; }
    return gcd_steps(b, a % b, steps + 1, sink);
}
show("tail", gcd_steps(1071, 462, 0, []));
fun swap_loop(a: Int, b: Int, n: Int, sink: List<Int>) -> List<Int> {
    if (n == 0) { return [a, b]; }
    return swap_loop(b, a, n - 1, sink);
}
show("swap", [swap_loop(1, 2, 5, []), swap_loop(1, 2, 6, [])]);

// A handler: locals changed in the protected body keep their values.
fun handled(limit: Int, sink: List<Int>) -> List<Any> {
    mut i: Int = 0;
    mut acc: Int = 0;
    let caught: Str = may {
        while (i < limit) { acc += i; i += 1; if (i == 7) { fail("stop"); } }
        "done"
    } otherwise { str(err.message) };
    push(sink, acc);
    return [caught, i, acc];
}
show("handled", handled(100, []));

// A callee with a handler that catches a fault raised below it returns
// to a caller whose register homes must be intact.
fun deep_fail(n: Int) -> Int { if (n == 0) { fail("deep"); } return deep_fail(n - 1) + 1; }
fun catcher(n: Int) -> Str { return may { str(deep_fail(n)) } otherwise { str(err.message) }; }
fun caller(limit: Int, sink: List<Str>) -> List<Any> {
    mut i: Int = 0;
    mut seen: Int = 0;
    while (i < limit) {
        if (catcher(i % 4) == "deep") { seen += i; }
        i += 1;
    }
    push(sink, "x");
    return [i, seen];
}
show("caller", caller(20, []));

// Closures: captured locals live in cells, not registers.
fun closures(limit: Int) -> List<Int> {
    mut shared: Int = 0;
    let add: (Int) -> Int = fun(v: Int) -> Int { shared += v; return shared; };
    mut i: Int = 0;
    mut last: Int = 0;
    while (i < limit) { last = add(i); i += 1; }
    return [shared, last, i];
}
show("closures", closures(100));

// Heap values held only in register homes across allocation-heavy loops.
fun gc_pressure(rounds: Int) -> List<Int> {
    mut keep: List<Int> = [1, 2, 3];
    mut text: Str = "start";
    mut round: Int = 0;
    mut checksum: Int = 0;
    while (round < rounds) {
        let garbage: List<Int> = [round, round + 1, round + 2, round + 3];
        let joined: Str = "${round}:${len(garbage)}";
        checksum = (checksum + len(joined) + garbage[3]) % 1000003;
        if (round % 1000 == 0) { keep = [round, len(keep), checksum]; text = "r${round}"; }
        round += 1;
    }
    return [keep[0], keep[1], checksum, len(text)];
}
show("gc", gc_pressure(300000));

// The two hottest locals are a List and a Str, so register homes hold heap
// values while the loop's garbage is collected.
fun gc_homes(rounds: Int) -> Int {
    mut keep: List<Int> = [0];
    mut text: Str = "t";
    mut n: Int = rounds;
    while (n > 0) {
        keep = [keep[0] + 1, len(keep), len(text)];
        text = "${keep[0]}-${len(text)}";
        let garbage: List<Int> = [n, n, n, n];
        n -= len(garbage) / 4;
    }
    return keep[0] * 100 + keep[2] + len(text);
}
show("gc homes", gc_homes(200000));

fun map_homes(n: Int) -> Int {
    let counts: Map<Str, Int> = {};
    mut i: Int = 0;
    while (i < n) {
        let key: Str = "k${i % 50}";
        counts[key] = (counts[key] ?? 0) + i;
        i += 1;
    }
    mut total: Int = 0;
    for key: Str in keys(counts) { total += counts[key] ?? 0; }
    return total;
}
show("map", map_homes(20000));

// Fibers switch stacks with homes live on both sides.
fun fibers() -> List<Int> {
    let log: List<Int> = [];
    mut main_local: Int = 7;
    spawn(fun() -> Any {
        mut k: Int = 0;
        while (k < 3) { push(log, k); k += 1; yield(); }
        return nil;
    });
    spawn(fun() -> Any {
        mut k: Int = 10;
        while (k < 13) { push(log, k); k += 1; yield(); }
        return nil;
    });
    run();
    main_local += len(log);
    push(log, main_local);
    return log;
}
show("fibers", fibers());

// Top-level loop locals and globals.
mut top_total: Int = 0;
mut top_i: Int = 0;
while (top_i < 1000) {
    mut inner: Int = top_i;
    while (inner > 1) { inner = if (inner % 2 == 0) { inner / 2 } else { inner * 3 + 1 }; top_total += 1; }
    top_i += 1;
}
show("top", top_total);
