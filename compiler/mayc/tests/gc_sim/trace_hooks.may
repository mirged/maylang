// ---- MOSAIC M1 allocation trace (test-only runtime copy) -------------------
// tests/gc_sim/trace.py appends this file to a copy of runtime/fat_linux.may,
// renames rt_alloc_kind, rt_grow_in_place, rt_gc and rt_gc_stats_report to
// *_untraced, and compiles workloads against the copy. The shipped runtime
// never contains it. Records are little-endian 64-bit words written to fd 3;
// the top byte is the tag, the low 48 bits an address:
//   1 alloc   [1|kind<<48|payload] [block bytes] [site number]
//  10 site    [10|number] [ret1] .. [ret24]   a new call-stack signature
//             (see rt_trace_alloc), written before its first allocation
//   2 begin   [2|collection]           a collection starts; then:
//   3 root    [3|payload]              a root word that names a block
//   4 block   [4|payload]              every allocated block, followed by
//   5 edge    [5|payload]              each word the marker would follow
//   6 end     [6|collection]           after the sweep; then:
//   7 live    [7|payload]              every block that survived
//   8 grow    [8|payload] [block bytes] an in-place growth
//   9 exit    [9]
mut TRBUF: Any = 0;
mut TRN: Any = 0;
mut TRCODEHI: Any = 0;
mut TRCOUNT: Any = 0;
// The traced process. A forked child (maylsp's workers) inherits fd 3 and the
// buffer; it discards both at its first flush and stops tracing, so only the
// parent's heap is in the trace.
mut TRPID: Any = 0;
mut TRCHILD: Any = 0;
// Interned call-stack signatures: 1048576 entries of [number, ret1..ret24]
// (a literal: initialisers of the injected runtime's globals do not run).
mut TRSITES: Any = 0;
mut TRRETS: Any = 0;
mut TRSITECOUNT: Any = 0;

fun rt_trace_word(w: Any) -> Any {
    if (TRCHILD != 0) { return 0; }
    if (TRBUF == 0) {
        TRBUF = syscall(9, 0, 1048576, 3, 34, 0 - 1, 0);
        TRN = 0;
        TRCODEHI = addr("trace code bound");
        TRPID = syscall(39);
    }
    store64(TRBUF + TRN, w);
    TRN = TRN + 8;
    if (TRN == 1048576) { rt_trace_flush(); }
    return 0;
}
fun rt_trace_flush() -> Any {
    if (syscall(39) != TRPID) { TRCHILD = 1; TRN = 0; return 0; }
    mut off: Any = 0;
    while (off < TRN) {
        let wrote: Any = syscall(1, 3, TRBUF + off, TRN - off);
        if (wrote <= 0) { TRN = 0; return 0; }
        off = off + wrote;
    }
    TRN = 0;
    return 0;
}
fun rt_trace_tag(tag: Any, value: Any) -> Any {
    return rt_trace_word(tag * 72057594037927936 + value);
}
// Whether `r` can be a return address after a `call rel32` in this image.
fun rt_trace_ret(r: Any) -> Any {
    if (r < 4198405 or r >= TRCODEHI) { return 0; }
    if (load8(r - 5) != 232) { return 0; }
    return 1;
}
// The block a word names, as the marker resolves it (rt_mark_word).
fun rt_trace_target(w: Any) -> Any {
    mut q: Any = rt_candidate(w);
    if (q == 0) { q = rt_candidate(w - 8); }
    return q;
}
fun rt_trace_root(w: Any) -> Any {
    let q: Any = rt_trace_target(w);
    if (q != 0) { rt_trace_tag(3, q); }
    return 0;
}
fun rt_trace_edge(w: Any) -> Any {
    let q: Any = rt_trace_target(w);
    if (q != 0) { rt_trace_tag(5, q); }
    return 0;
}
// The first 24 words above the hook's frame that look like return addresses
// (they follow a `call rel32` in this image), scanning up from the stack
// pointer. Uninitialised frame slots hold many stale ones, so the simulator
// rebuilds the real chain from them: each genuine return address's call
// targets the function that contains the previous one. (Filtering here
// instead, anchored on the first word, lost real frames.) Signatures are
// interned in a table; stale words make many of them distinct, so a lookup
// gives up after 64 probes and the allocation gets site 0 (unknown).
fun rt_trace_alloc(p: Any, kind: Any) -> Any {
    if (TRCHILD != 0) { return 0; }
    if (TRSITES == 0) {
        TRSITES = syscall(9, 0, 1048576 * 200, 3, 34, 0 - 1, 0);
        TRRETS = syscall(9, 0, 4096, 3, 34, 0 - 1, 0);
    }
    let top: Any = CSTOP;
    mut a: Any = __sp();
    mut scanned: Any = 0;
    mut index: Any = 0;
    mut k: Any = 0;
    while (k < 24) { store64(TRRETS + k * 8, 0); k = k + 1; }
    while (index < 24 and scanned < 4096 and a + 8 <= top) {
        let r: Any = load64(a);
        if (rt_trace_ret(r) == 1) {
            store64(TRRETS + index * 8, r);
            index = index + 1;
        }
        a = a + 8;
        scanned = scanned + 1;
    }
    mut hash: Any = 0;
    k = 0;
    while (k < 24) { hash = (hash * 31 + load64(TRRETS + k * 8)) % 1000000007; k = k + 1; }
    mut slot: Any = hash % 1048576;
    mut site: Any = 0;
    mut probes: Any = 0;
    while (site == 0 and probes < 64) {
        let entry: Any = TRSITES + slot * 200;
        let id: Any = load64(entry);
        if (id == 0) {
            TRSITECOUNT = TRSITECOUNT + 1;
            store64(entry, TRSITECOUNT);
            k = 0;
            while (k < 24) { store64(entry + 8 + k * 8, load64(TRRETS + k * 8)); k = k + 1; }
            rt_trace_tag(10, TRSITECOUNT);
            k = 0;
            while (k < 24) { rt_trace_word(load64(TRRETS + k * 8)); k = k + 1; }
            site = TRSITECOUNT;
        } else {
            mut same: Any = 1;
            k = 0;
            while (same == 1 and k < 24) {
                if (load64(entry + 8 + k * 8) != load64(TRRETS + k * 8)) { same = 0; }
                k = k + 1;
            }
            if (same == 1) { site = id; }
            else { slot = (slot + 1) % 1048576; probes = probes + 1; }
        }
    }
    rt_trace_tag(1, kind * 281474976710656 + p);
    rt_trace_word(load64(p - 16));
    rt_trace_word(site);
    return 0;
}
fun rt_trace_blocks(tag: Any, edges: Any) -> Any {
    mut p: Any = HEAP;
    while (p < HP) {
        let hdr: Any = load64(p);
        mut size: Any = hdr - (hdr % 2);
        if (size < 16) { size = 16; }
        let kind: Any = load8(GCSTARTS + (p - HEAP) / 8);
        if (kind != 0) {
            let q: Any = p + 16;
            rt_trace_tag(tag, q);
            if (edges == 1) {
                let end: Any = p + size;
                mut a: Any = q;
                if (kind == 3 or kind == 4) {
                    if (kind == 4) {
                        while (a < q + 48) { rt_trace_edge(load64(a)); a = a + 8; }
                    }
                    while (a + 16 <= end) {
                        let t: Any = load64(a);
                        if (t == 2 or (t >= 4 and t <= 8)) { rt_trace_edge(load64(a + 8)); }
                        a = a + 16;
                    }
                } else if (kind == 1) {
                    while (a < end) { rt_trace_edge(load64(a)); a = a + 8; }
                }
            }
        }
        p = p + size;
    }
    return 0;
}
// The roots rt_gc marks, in the same order. Runs inside rt_gc's wrapper, so
// the stack scan also covers the wrapper's frame: a superset of the roots.
fun rt_trace_roots() -> Any {
    rt_trace_root(GROOTS); rt_trace_root(HSTACK); rt_trace_root(ERRVAL); rt_trace_root(TRACE_STACK);
    rt_trace_root(FIB_TRACE0);
    mut i: Any = 0;
    while (i < GCOUNT) {
        let root: Any = load64(GROOTS + i * 8);
        rt_trace_root(load64(root)); rt_trace_root(load64(root + 8));
        i = i + 1;
    }
    rt_trace_root(__callee_saved(0)); rt_trace_root(__callee_saved(1)); rt_trace_root(__callee_saved(2));
    rt_trace_root(__callee_saved(3)); rt_trace_root(__callee_saved(4));
    mut a: Any = __sp();
    a = a - (a % 8);
    while (a + 8 <= CSTOP) { rt_trace_root(load64(a)); a = a + 8; }
    rt_trace_root(FIB_TAB); rt_trace_root(FIB_SAVE0); rt_trace_root(FIB_HSTACK0); rt_trace_root(FIB_ERRVAL0);
    if (FIB_CUR != 0 and FIB_SAVE0 != 0) {
        mut lo: Any = load64(FIB_SAVE0);
        lo = lo - (lo % 8);
        while (lo + 8 <= STACKTOP) { rt_trace_root(load64(lo)); lo = lo + 8; }
    }
    i = 0;
    while (i < FIB_N) {
        let rec: Any = load64(FIB_TAB + i * 8);
        if (rec != FIB_CUR and load64(rec + 24) > load64(rec)) {
            mut b: Any = load64(rec);
            b = b - (b % 8);
            while (b + 8 <= load64(rec + 24)) { rt_trace_root(load64(b)); b = b + 8; }
        }
        i = i + 1;
    }
    return 0;
}

fun rt_alloc_kind(n: Any, kind: Any) -> Any {
    let p: Any = rt_alloc_kind_untraced(n, kind);
    rt_trace_alloc(p, kind);
    return p;
}
fun rt_grow_in_place(p: Any, extra: Any) -> Any {
    let grown: Any = rt_grow_in_place_untraced(p, extra);
    if (grown == 1) { rt_trace_tag(8, p); rt_trace_word(load64(p - 16)); }
    return grown;
}
fun rt_gc() -> Any {
    if (GCFLAG == 0) { return 0; }
    TRCOUNT = TRCOUNT + 1;
    rt_trace_tag(2, TRCOUNT);
    rt_trace_roots();
    rt_trace_blocks(4, 1);
    rt_gc_untraced();
    rt_trace_tag(6, TRCOUNT);
    rt_trace_blocks(7, 0);
    return 0;
}
fun rt_gc_stats_report() -> Any {
    if (TRBUF != 0 and TRCHILD == 0) { rt_trace_tag(9, 0); rt_trace_flush(); }
    return rt_gc_stats_report_untraced();
}
