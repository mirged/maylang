struct Point { x: Any, y: Any }
let p: Any = Point(3, 4);
print(p.x, p.y, len(p));
p.x = 10;
print(p.x);
struct Rect { w: Any, h: Any }
fun area(r: Any) -> Any { return r.w * r.h }
print(area(Rect(4, 5)));
struct Vec { x: Any, y: Any, "+": vadd }
fun vadd(self: Any, other: Any) -> Any { return Vec(self.x + other.x, self.y + other.y) }
let left: Any = Vec(1, 2);
let right: Any = Vec(3, 4);
let s: Any = left + right;
print(s.x, s.y);
