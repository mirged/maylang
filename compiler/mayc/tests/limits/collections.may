fun probe_collections(iterations: Int, seed: Int) -> Int {
    mut checksum: Int = 0;
    mut index: Int = 0;
    while index < iterations {
        let value: Int = (index + seed) % 1024;
        let values: List<Int> = [value, value + 1, value + 2, value + 3];
        let callback: Fn(Int) -> Int = fun(extra: Int) -> Int {
            return values[0] + values[3] + extra;
        };
        let record: Map<Str, Int> = {"value": callback(7), "index": index % 17};
        checksum += (record["value"] ?? 0) + (record["index"] ?? 0);
        index += 1;
    }
    return checksum;
}
let arguments: List<Str> = args();
print(probe_collections(int(arguments[1]), int(arguments[2])));
