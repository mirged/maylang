import "src/emitter.may";
import "src/state.may";
import "src/ast.may";
import "src/diagnostics.may";
import "src/lexer.may";
import "src/parser.may";
import "src/sema.may";
import "src/strict.may";
import "src/behavior.may";
import "src/ir.may";
import "src/ir_opt.may";
import "src/ir_inline.may";
import "src/backend.may";
import "src/formats.may";
import "src/formats/bytes.may";
import "src/modules.may";
import "src/profile.may";

// main.may — the mayc CLI driver.
//
//   mayc [options] <source.may> [-o <binary>]
//
// Resolves textual imports, lexes, parses, lowers to target machine code,
// packages it in the selected executable format, and writes it to disk with executable permissions.

// ---------------------------------------------------------------- Constants
// Immutable let is Maylang's constant declaration. Update the version here.
let MAYC_VERSION: Str = "0.15.0";
let PRELUDE_FILE_NAME: Any  = "prelude.may";
let NATIVE_FILE_NAME: Any   = "native.may";

// ------------------------------------------------------------- Path Helpers

fun path_next(a0: Any, a0l: Any, np: Any, nl: Any) -> Any {
    mut dl: Any = 0;
    mut k: Any = 0;
    while (k < a0l) {
        if (load8(a0 + k) == 47) { dl = k + 1; } // '/'
        k = k + 1;
    }
    let rp: Any = irt_alloc(dl + nl + 1);
    mut j: Any = 0;
    while (j < dl) {
        store8(rp + j, load8(a0 + j));
        j = j + 1;
    }
    j = 0;
    while (j < nl) {
        store8(rp + dl + j, load8(np + j));
        j = j + 1;
    }
    store8(rp + dl + nl, 0);
    return rp;
}

// Resolved runtime and library files, recorded so --deps can name them.
mut SIDECAR_FILES: Any = [];
// Offset where the user's own sources start in the expanded program.
mut DEPFILE_USER_START: Any = 0;
// The private directory `mayc run` created, removed if compilation fails.
mut RUN_SCRATCH: Any = "";

fun note_sidecar_range(pointer: Any, length: Any) -> Any {
    let text: Any = symbol_name(pointer, length);
    if (not has(SIDECAR_FILES, text)) { push(SIDECAR_FILES, text); }
    return 0;
}

fun note_sidecar(path: Any) -> Any {
    mut count: Any = 0;
    while (load8(path + count) != 0) { count += 1; }
    return note_sidecar_range(path, count);
}

fun side_slurp(a0: Any, a0l: Any, np: Any, nl: Any) -> Any {
    let rp: Any = path_next(a0, a0l, np, nl);
    let text: Any = slurp(rp, 0);
    if (LASTLEN > 0) { note_sidecar(rp); }
    return text;
}

// Read a checkout-relative sidecar and record it when it exists.
fun side_cwd(path: Any) -> Any {
    let text: Any = slurp(addr(path), len(path));
    if (LASTLEN > 0) { note_sidecar_range(addr(path), len(path)); }
    return text;
}

// --------------------------------------------------- File Resolvers (Multi-Tier)

fun load_prelude(a0: Any, a0l: Any) -> Any {
    // 1. Next to mayc executable
    let p1: Any = side_slurp(a0, a0l, addr(PRELUDE_FILE_NAME), len(PRELUDE_FILE_NAME));
    if (LASTLEN > 0) { return p1; }

    // 2. Repo-relative to compiler/mayc (../../stdlib/prelude.may)
    let repo_rel: Any = "../../stdlib/prelude.may";
    let p2: Any = side_slurp(a0, a0l, addr(repo_rel), len(repo_rel));
    if (LASTLEN > 0) { return p2; }

    // 3. Current working directory (a checkout root)
    let cwd_rel: Any = "stdlib/prelude.may";
    return side_cwd(cwd_rel);
}

fun load_native(a0: Any, a0l: Any) -> Any {
    // 1. Next to mayc executable
    let n1: Any = side_slurp(a0, a0l, addr(NATIVE_FILE_NAME), len(NATIVE_FILE_NAME));
    if (LASTLEN > 0) { return n1; }

    // 2. Repo-relative to compiler/mayc (the active sidecar, not stdlib's mirror)
    let repo_rel: Any = "../../compiler/mayc/native.may";
    let n2: Any = side_slurp(a0, a0l, addr(repo_rel), len(repo_rel));
    if (LASTLEN > 0) { return n2; }

    // 3. Current working directory (a checkout root)
    let cwd_rel: Any = "compiler/mayc/native.may";
    return side_cwd(cwd_rel);
}

fun load_math(a0: Any, a0l: Any) -> Any {
    // 1. runtime/ next to the mayc executable
    let name: Any = "runtime/math.may";
    let m1: Any = side_slurp(a0, a0l, addr(name), len(name));
    if (LASTLEN > 0) { return m1; }

    // 2. Repo-relative to compiler/mayc
    let repo_rel: Any = "../../compiler/mayc/runtime/math.may";
    let m2: Any = side_slurp(a0, a0l, addr(repo_rel), len(repo_rel));
    if (LASTLEN > 0) { return m2; }

    // 3. Current working directory (a checkout root)
    let cwd_rel: Any = "compiler/mayc/runtime/math.may";
    let m3: Any = side_cwd(cwd_rel);
    if (LASTLEN == 0) { die_str("mayc: cannot find runtime/math.may\n"); }
    return m3;
}

// Append a runtime file (`extraLength` bytes named `name`) to the runtime
// source already in SRC, keeping each file's own line numbers for diagnostics.
// The runtime and library sidecars must not define a function twice: the
// later definition would silently replace the earlier one for every caller
// (#114). User code may still shadow library functions.
let SIDECAR_LIBRARY: Any = ["prelude.may", "native.may", "runtime/math.may"];

fun check_sidecar_functions() -> Any {
    let seen: Any = {};
    for rec: Any in FUNC_HEAD {
        if (rec.nested != 0 or rec.body == 0 or rec.body == nil) { continue; }
        let span: Any = rec.body.span;
        if (rec.mode != 1 and not has(SIDECAR_LIBRARY, source_path(span))) { continue; }
        let name: Any = symbol_name(rec.p, rec.l);
        let first: Any = seen[name];
        if (first != nil) {
            let where: Any = diagnostic_record(first, "");
            diagnostic(span, "duplicate runtime function `${name}`; first defined at ${where.file}:${where.range.start.line}");
        }
        seen[name] = span;
    }
    return 0;
}

fun append_runtime(extra: Any, extraLength: Any, name: Any) -> Any {
    let base: Any = SRC; let baseLength: Any = SRCLEN;
    let file: Any = SOURCE_FILES[base];
    let origins: Any = if (len(file.origins) > 0) { file.origins } else { [SourceOrigin(0, file.path, 1)] };
    push(origins, SourceOrigin(baseLength + 1, name, 1));
    let combined: Any = irt_alloc(baseLength + extraLength + 2);
    image_copy(combined, base, baseLength);
    store8(combined + baseLength, 10);
    image_copy(combined + baseLength + 1, extra, extraLength);
    store8(combined + baseLength + 1 + extraLength, 0);
    SRC = combined; SRCLEN = baseLength + 1 + extraLength;
    SOURCE_FILES[combined] = SourceFile(file.path, origins);
    return 0;
}

fun load_core(a0: Any, a0l: Any, file: Any) -> Any {
    let name: Any = "runtime/" + file;
    let source: Any = side_slurp(a0, a0l, addr(name), len(name));
    if (LASTLEN == 0) { die_str("mayc: cannot find ${name}\n"); }
    return source;
}

// ------------------------------------------------------------- Dependency file

// Escape one path for a Make dependency line.
fun depfile_escape(value: Any) -> Any {
    mut result: Any = "";
    for c: Any in chars(value) {
        if (c == "\\" or c == " " or c == "#") { result = result + "\\" + c; }
        else if (c == "$") { result = result + "$$"; }
        else { result = result + c; }
    }
    return result;
}

// Write `target: sources...` for the expanded imports and every sidecar the
// compiler actually read.
fun depfile_write(entry: Any, target: Any, path: Any) -> Any {
    let candidates: Any = [entry];
    for file: Any in SIDECAR_FILES { push(candidates, file); }
    for origin: Any in SOURCE_FILES[SRC].origins {
        if (origin.start >= DEPFILE_USER_START) { push(candidates, origin.path); }
    }
    let seen: Any = {};
    let items: Any = [];
    for item: Any in candidates {
        if (item == "" or has(seen, item)) { continue; }
        seen[item] = 1;
        push(items, depfile_escape(item));
    }
    write_file(path, depfile_escape(target) + ": " + join(items, " ") + "\n");
    return 0;
}

// Whether stderr is a terminal (TCGETS succeeds).
fun stderr_is_tty() -> Any {
    let state: Any = irt_alloc(64);
    if (syscall(16, 2, 21505, state) == 0) { return 1; }
    return 0;
}

// Whether an argv span begins with `text`.
fun span_has_prefix(p: Any, l: Any, text: Any) -> Any {
    let n: Any = len(text);
    if (l < n) { return 0; }
    return name_eq(p, n, addr(text), n);
}

// ------------------------------------------------------------- Driver Entry

fun cli_usage() -> Any {
    let message: Any = "Maylang compiler (mayc) ${MAYC_VERSION}\n\nUsage:\n  mayc [options] <source.may> [-o <output>]\n  mayc run <source.may> [-- ARGS...] [options]\n  mayc check <source.may> [options]\n\nCommands:\n  build                Compile a source file (the default)\n  run                  Compile to a temporary executable and run it; exits\n                       with the program's status and forwards arguments after\n                       -- unchanged\n  check                Parse, strictly check and resolve names; write no binary\n\nOptions:\n  -h, --help           Show this help and exit\n  -V, --version        Show compiler version and exit\n  --list-targets       List target formats and default runtimes, then exit\n  -o, --output PATH    Write executable to PATH (default: source name without\n                       .may)\n  --check              Same as the check command\n  --explain-behavior   Check contracts and print inferred effect summaries as\n                       JSON\n  --strict             Enable strict type checking (default)\n  --legacy             Disable strict type checking for legacy source\n  --diagnostics FORMAT text (default) or json; up to 20 errors\n  --color WHEN         Color text diagnostics: auto (default), always or never\n  --no-color           Same as --color never; NO_COLOR also disables auto\n  --deps FILE          Write a Make-style dependency file naming the expanded\n                       imports and the runtime sidecars that were read\n  -O0                  Disable the fat backend's optional optimizations\n  -O1                  Default optimization level\n  -O2                  Enable the accessor and helper inliner\n  --debug              Include function/source traces in runtime errors\n  --no-opt             Disable optional backend optimizations (same as -O0)\n  --inline             Opt in to inlining accessors and one-expression helpers\n                       into their call sites (same as -O2)\n  --raw                Compile without runtime, prelude, or native library\n  --no-code-align      Do not align --raw x86-64 function bodies and loop heads\n  --runtime NAME       full (default) or none (same as --raw)\n  --time               Report compiler stage timings to stderr\n  --target TARGET      x86_64-linux (the only supported target)\n  --dump-expanded      Print expanded source and exit\n  --stack-map-inventory\n                       Print the allocating safepoints (precise stack maps) as\n                       JSON and exit\n\nExamples:\n  mayc hello.may\n  mayc run hello.may -- one two\n  mayc check app.may\n  mayc app.may -o build/app -O2 --deps build/app.d\n";
    syscall(1, 1, addr(message), len(message));
    syscall(60, 0);
    return 0;
}

fun cli_default_output(pointer: Any, length: Any, targetName: Any) -> Any {
    mut baseLength: Any = length;
    let hasMaySuffix: Any = length >= 4 and load8(pointer + length - 4) == 46 and load8(pointer + length - 3) == 109 and load8(pointer + length - 2) == 97 and load8(pointer + length - 1) == 121;
    if (hasMaySuffix) { baseLength = length - 4; }
    let suffix: Any = if (hasMaySuffix) { "" } else { ".out" };
    let suffixLength: Any = len(suffix);
    let result: Any = irt_alloc(baseLength + suffixLength + 1);
    mut i: Any = 0;
    while (i < baseLength) { store8(result + i, load8(pointer + i)); i = i + 1; }
    mut j: Any = 0;
    while (j < suffixLength) { store8(result + baseLength + j, load8(addr(suffix) + j)); j = j + 1; }
    store8(result + baseLength + suffixLength, 0);
    return [result, baseLength + suffixLength];
}

fun cli_list_targets() -> Any {
    let header: Str = "target\tformat\tdefault-runtime\n";
    syscall(1, 1, addr(header), len(header));
    let target: Any = target_select("x86_64-linux");
    let line: Str = "${target.name}\t${target.format}\tfull\n";
    syscall(1, 1, addr(line), len(line));
    let note: Str = "Compiler host: Linux x86-64. Other targets are not supported (docs/design/LINUX_X86_64_FOCUS.md).\n";
    syscall(1, 1, addr(note), len(note));
    syscall(60, 0);
    return 0;
}

fun main2() -> Any {
    irt_init();

    let cmd: Any = slurp(addr("/proc/self/cmdline"), len("/proc/self/cmdline"));
    let cn: Any = LASTLEN;

    // Split the NUL-separated command line into a list of [ptr, len] spans.
    mut argv: Any = [];
    mut i: Any = 0;
    while (i < cn) {
        let s: Any = i;
        while (i < cn) {
            if (load8(cmd + i) == 0) { break; }
            i = i + 1;
        }
        if (i > s) { push(argv, [cmd + s, i - s]); }
        i = i + 1;
    }

    // argv[0] may be a bare PATH command or a symlink in another directory.
    // Sidecars belong to the actual executable, as does its installed stdlib.
    mut a0: Any = argv[0][0];
    mut a0l: Any = argv[0][1];
    let executable: Any = irt_alloc(4096);
    let executableLength: Any = syscall(89, addr("/proc/self/exe"), executable, 4096);
    if (executableLength > 0 and executableLength < 4096) {
        a0 = executable;
        a0l = executableLength;
    }
    // The compiler itself is a dependency of everything it compiles.
    note_sidecar_range(a0, a0l);

    // Subcommands share the flag parser: `mayc run src.may -- args`.
    let child_arguments: Any = [];
    mut subcommand: Any = "";
    mut start: Any = 1;
    if (len(argv) > 1) {
        if (name_eq(argv[1][0], argv[1][1], addr("run"), 3) == 1) { subcommand = "run"; start = 2; }
        else if (name_eq(argv[1][0], argv[1][1], addr("check"), 5) == 1) { subcommand = "check"; start = 2; }
        else if (name_eq(argv[1][0], argv[1][1], addr("build"), 5) == 1) { subcommand = "build"; start = 2; }
        else if (name_eq(argv[1][0], argv[1][1], addr("help"), 4) == 1) { cli_usage(); }
    }
    mut sp: Any = 0;
    mut sl: Any = 0;
    mut op: Any = 0;
    mut ol: Any = 0;
    mut targetName: Any = "x86_64-linux";
    mut runtimeName: Any = "auto";
    mut rawflag: Any = 0;
    mut dumpflag: Any = 0;
    mut checkflag: Any = 0;
    mut expandedflag: Any = 0;
    mut smflag: Any = 0;
    mut forward: Any = 0;
    mut depsflag: Any = 0;
    mut depfile: Any = "";
    mut colorMode: Any = "auto";
    mut userOutput: Any = 0;
    mut runDirectory: Any = "";
    mut runProgram: Any = "";
    mut k: Any = start;
    while (k < len(argv)) {
        let ap: Any = argv[k][0];
        let al: Any = argv[k][1];
        if (forward == 1) {
            push(child_arguments, symbol_name(ap, al));
        } else if (name_eq(ap, al, addr("--"), 2) == 1) {
            forward = 1;
        } else if (name_eq(ap, al, addr("-h"), 2) == 1 or name_eq(ap, al, addr("--help"), 6) == 1) {
            cli_usage();
        } else if (name_eq(ap, al, addr("-V"), 2) == 1 or name_eq(ap, al, addr("--version"), 9) == 1) {
            let version: Str = "mayc " + MAYC_VERSION + "\n";
            syscall(1, 1, addr(version), len(version));
            syscall(60, 0);
        } else if (name_eq(ap, al, addr("--list-targets"), 14) == 1) {
            cli_list_targets();
        } else if (name_eq(ap, al, addr("-o"), 2) == 1 or name_eq(ap, al, addr("--output"), 8) == 1) {
            k = k + 1;
            if (k >= len(argv)) { die_str("mayc: -o/--output requires a path\n"); }
            op = argv[k][0]; ol = argv[k][1]; userOutput = 1;
        } else if (name_eq(ap, al, addr("--target"), 8) == 1) {
            k += 1;
            if (k >= len(argv)) { die_str("mayc: --target requires a target name\n"); }
            targetName = symbol_name(argv[k][0], argv[k][1]);
        } else if (name_eq(ap, al, addr("--raw"), 5) == 1) {
            rawflag = 1;
        } else if (name_eq(ap, al, addr("--no-code-align"), 15) == 1) {
            backend_disable_code_alignment();
        } else if (name_eq(ap, al, addr("--runtime"), 9) == 1) {
            k += 1;
            if (k >= len(argv)) { die_str("mayc: --runtime requires full or none\n"); }
            runtimeName = symbol_name(argv[k][0], argv[k][1]);
            if (runtimeName == "core") { die_str("mayc: runtime core is not supported; Maylang currently supports the full runtime and --raw on x86_64-linux (see docs/design/LINUX_X86_64_FOCUS.md)\n"); }
            if (runtimeName != "full" and runtimeName != "none") { die_str("mayc: unknown runtime `${runtimeName}`\n"); }
        } else if (name_eq(ap, al, addr("--values"), 8) == 1) {
            die_str("mayc: --values was removed; every runtime uses fat values (docs/design/FAT_VALUES.md)\n");
        } else if (name_eq(ap, al, addr("--emit-llvm"), 11) == 1) {
            die_str("mayc: --emit-llvm was removed; mayc emits native executables itself\n");
        } else if (name_eq(ap, al, addr("--time"), 6) == 1) {
            PROFILE_ENABLED = true;
        } else if (name_eq(ap, al, addr("--stack-map-inventory"), 21) == 1) {
            smflag = 1;
        } else if (name_eq(ap, al, addr("--debug"), 7) == 1) {
            DEBUG_TRACES = true;
        } else if (name_eq(ap, al, addr("--no-opt"), 8) == 1) {
            NO_OPT = true;
        } else if (name_eq(ap, al, addr("--inline"), 8) == 1) {
            INLINE_ENABLED = true;
        } else if (name_eq(ap, al, addr("--dump"), 6) == 1) {
            dumpflag = 1;
        } else if (name_eq(ap, al, addr("--dump-expanded"), 15) == 1) {
            expandedflag = 1;
        } else if (name_eq(ap, al, addr("--check"), 7) == 1) {
            checkflag = 1;
        } else if (name_eq(ap, al, addr("--explain-behavior"), 18) == 1) {
            BEHAVIOR_EXPLAIN = true; checkflag = 1;
        } else if (name_eq(ap, al, addr("--diagnostics"), 13) == 1) {
            k += 1; if (k >= len(argv)) { die_str("mayc: --diagnostics requires text or json\n"); }
            DIAGNOSTIC_FORMAT = symbol_name(argv[k][0], argv[k][1]);
            if (DIAGNOSTIC_FORMAT != "text" and DIAGNOSTIC_FORMAT != "json") { die_str("mayc: --diagnostics requires text or json\n"); }
        } else if (name_eq(ap, al, addr("--deps"), 6) == 1) {
            k += 1; if (k >= len(argv)) { die_str("mayc: --deps requires a path\n"); }
            depfile = symbol_name(argv[k][0], argv[k][1]); depsflag = 1;
        } else if (name_eq(ap, al, addr("--color"), 7) == 1) {
            k += 1; if (k >= len(argv)) { die_str("mayc: --color requires auto, always or never\n"); }
            colorMode = symbol_name(argv[k][0], argv[k][1]);
        } else if (span_has_prefix(ap, al, "--color=") == 1) {
            colorMode = symbol_name(ap + 8, al - 8);
        } else if (name_eq(ap, al, addr("--no-color"), 10) == 1) {
            colorMode = "never";
        } else if (al >= 2 and load8(ap) == 45 and load8(ap + 1) == 79) {
            if (al == 2) { }
            else if (al == 3 and load8(ap + 2) == 48) { NO_OPT = true; }
            else if (al == 3 and load8(ap + 2) == 49) { }
            else if (al == 3 and load8(ap + 2) == 50) { INLINE_ENABLED = true; }
            else { die_str("mayc: -O accepts 0, 1 or 2\n"); }
        } else if (name_eq(ap, al, addr("--legacy"), 8) == 1) {
            STRICT_TYPES = false;
        } else if (name_eq(ap, al, addr("--strict"), 8) == 1) {
            STRICT_TYPES = true;
        } else if (al > 0 and load8(ap) == 45) {
            die_str("mayc: unknown option (use --help)\n");
        } else if (sl == 0) {
            sp = ap;
            sl = al;
        } else if (ol == 0) {
            if (subcommand == "run") { die_str("mayc: pass program arguments after --\n"); }
            op = ap;
            ol = al;
        }
        k = k + 1;
    }
    if (subcommand == "check") { checkflag = 1; }
    if (subcommand == "run" and checkflag == 1) {
        die_str("mayc: run compiles and executes a program; drop --check or --explain-behavior\n");
    }
    if (BEHAVIOR_EXPLAIN and (dumpflag == 1 or expandedflag == 1)) {
        die_str("mayc: --explain-behavior cannot be combined with source dumps\n");
    }
    if (sl == 0) {
        die_str("mayc: missing source file (use --help)\n");
    }
    if (colorMode == "always") { DIAGNOSTIC_COLOR = 1; }
    else if (colorMode == "auto") { DIAGNOSTIC_COLOR = if (stderr_is_tty() == 1 and env("NO_COLOR") == nil) { 1 } else { 0 }; }
    else if (colorMode == "never") { DIAGNOSTIC_COLOR = 0; }
    else { die_str("mayc: --color requires auto, always or never\n"); }
    if (ol == 0 and checkflag == 0 and dumpflag == 0 and expandedflag == 0) {
        if (subcommand == "run") {
            // Compile beside the run in a private directory and execute it.
            mut temporary: Any = env("TMPDIR") ?? "/tmp";
            if (temporary == "") { temporary = "/tmp"; }
            let source: Any = symbol_name(sp, sl);
            let pieces: Any = split(source, "/");
            mut base: Any = "program";
            if (len(pieces) > 0) { base = pieces[len(pieces) - 1]; }
            if (ends_with(base, ".may")) { base = substring(base, 0, len(base) - 4); }
            if (base == "") { base = "program"; }
            runDirectory = temporary + "/mayc-run-" + str(syscall(39));
            syscall(83, cstr(runDirectory), 448);
            RUN_SCRATCH = runDirectory;
            runProgram = runDirectory + "/" + base;
            op = addr(runProgram); ol = len(runProgram);
        } else {
            let default: Any = cli_default_output(sp, sl, targetName);
            op = default[0]; ol = default[1];
        }
    }
    if (ol == 0 and checkflag == 0 and dumpflag == 0 and expandedflag == 0) {
        die_str("mayc: missing -o <binary>\n");
    }
    // The depfile names the produced binary, or the source when checking.
    mut depfileTarget: Any = "";
    if (depsflag == 1) {
        depfileTarget = if (ol != 0 and checkflag == 0) { symbol_name(op, ol) } else { symbol_name(sp, sl) };
    }

    let ctx: Any = emitter_new(target_select(targetName));
    if (runtimeName == "auto") { runtimeName = "full"; }
    if (runtimeName == "none") { rawflag = 1; }
    ctx.runtime = if (rawflag == 1) { "none" } else { runtimeName };
    profile_begin();
    // Programs with a runtime (DYNMODE 1) use fat values (#92,
    // docs/design/FAT_VALUES.md); --raw code computes with machine words.
    if (rawflag == 1) {
        PARSE_RAW = 1;
        DYNMODE = 0;
        expand(sp, sl);
        if (expandedflag == 1) {
            syscall(1, 1, SRC, SRCLEN);
            syscall(60, 0);
        }
        DIAGNOSTIC_STAGE = "lex"; lex_all();
        DIAGNOSTIC_STAGE = "parse"; parse_program(ctx);
        profile_mark("parse");
        DIAGNOSTIC_STAGE = "type"; strict_program(ctx);
        profile_mark("types");
        DIAGNOSTIC_STAGE = "name"; sem_program();
        profile_mark("resolve");
        if (depsflag == 1) { depfile_write(symbol_name(sp, sl), depfileTarget, depfile); }
        if (checkflag == 1) { if (BEHAVIOR_EXPLAIN) { print(json_stringify(behavior_report())); } syscall(60, 0); }
        ir_program(ctx);

    } else {
        DYNMODE = 1;
        // The shared fat runtime, then its host (docs/design/FAT_VALUES.md).
        SRC = load_core(a0, a0l, "fat.may"); SRCLEN = LASTLEN;
        SOURCE_FILES[SRC] = SourceFile("runtime/fat.may", []);
        let host: Any = load_core(a0, a0l, "fat_linux.may");
        append_runtime(host, LASTLEN, "runtime/fat_linux.may");
        PARSE_RAW = 1;
        DIAGNOSTIC_STAGE = "lex"; lex_all();
        DIAGNOSTIC_STAGE = "parse"; parse_program(ctx);
        profile_mark("runtime");
        RUNTIME_BODY = MAINBODY;
        for r: Any in FUNC_HEAD {
            r.mode = 1;
        }
        PARSE_RAW = 0;
        expand(sp, sl);
        let ub: Any = SRC;
        let un: Any = SRCLEN;
        if (expandedflag == 1) {
            syscall(1, 1, ub, un);
            syscall(60, 0);
        }

        // Resolve the library: the prelude and native library. Portable math
        // follows any library prelude.
        let parts: Any = [];
        push(parts, [load_prelude(a0, a0l), LASTLEN, "prelude.may"]);
        push(parts, [load_native(a0, a0l), LASTLEN, "native.may"]);
        mut libraryLength: Any = 0;
        for part: Any in parts { libraryLength += part[1]; }
        if (parts[0][1] > 0) { push(parts, [load_math(a0, a0l), LASTLEN, "runtime/math.may"]); }

        if (libraryLength > 0) {
            mut total: Any = un;
            for part: Any in parts { total += part[1]; }
            let cb: Any = irt_alloc(total + 8);
            let origins: Any = [];
            mut at: Any = 0;
            for part: Any in parts {
                image_copy(cb + at, part[0], part[1]);
                push(origins, SourceOrigin(at, part[2], 1));
                at += part[1];
            }
            // Everything before this offset is library text, not a source file.
            DEPFILE_USER_START = at;
            image_copy(cb + at, ub, un);
            SRC = cb;
            SRCLEN = total;
            for origin: Any in EXPAND_ORIGINS {
                push(origins, SourceOrigin(at + origin.start, origin.path, origin.line));
            }
            SOURCE_FILES[cb] = SourceFile(symbol_name(sp, sl), origins);
        }
        if (dumpflag == 1) {
            let fd: Any = syscall(2, addr("mayc_expanded.may"), 577, 420);
            syscall(1, fd, SRC, SRCLEN);
            syscall(3, fd);
            syscall(60, 0);
        }
        DIAGNOSTIC_STAGE = "lex"; lex_all();
        DIAGNOSTIC_STAGE = "parse"; parse_program(ctx);
        check_sidecar_functions();
        profile_mark("parse");
        DIAGNOSTIC_STAGE = "type"; strict_program(ctx);
        profile_mark("types");
        DIAGNOSTIC_STAGE = "name"; sem_program();
        profile_mark("resolve");
        if (depsflag == 1) { depfile_write(symbol_name(sp, sl), depfileTarget, depfile); }
        if (checkflag == 1) { if (BEHAVIOR_EXPLAIN) { print(json_stringify(behavior_report())); } syscall(60, 0); }
        ir_program(ctx);

    }
    ir_inline_program(ctx);
    ir_opt_program(ctx);
    profile_mark("ir");
    if (smflag == 1) {
        print(json_stringify(ir_stack_map_inventory(ctx)));
        syscall(60, 0);
    }
    backend_emit(ctx);
    profile_mark("emit");
    pad_code(ctx);
    format_layout(ctx);
    backend_patch(ctx);
    format_build(ctx);
    write_out(ctx, op, ol);
    emitter_release(ctx);
    profile_mark("package");
    if (subcommand == "run") {
        // Execute the freshly written program, forwarding arguments unchanged.
        let program: Any = [symbol_name(op, ol)];
        for argument: Any in child_arguments { push(program, argument); }
        let child: Any = exec(program);
        let status: Any = wait(child);
        if (userOutput == 0) {
            syscall(87, cstr(symbol_name(op, ol)));
            syscall(84, cstr(runDirectory));
            RUN_SCRATCH = "";
        }
        syscall(60, status);
    }
    return 0;
}

// Remove the scratch directory of a failed `mayc run` compilation.
fun run_scratch_cleanup() -> Any {
    if (RUN_SCRATCH != "") { syscall(84, cstr(RUN_SCRATCH)); RUN_SCRATCH = ""; }
    return 0;
}

may { main2(); } otherwise { run_scratch_cleanup(); report_diagnostic(err.message); }
