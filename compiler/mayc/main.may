import "src/emitter.may";
import "src/state.may";
import "src/ast.may";
import "src/diagnostics.may";
import "src/lexer.may";
import "src/parser.may";
import "src/sema.may";
import "src/strict.may";
import "src/behavior.may";
import "src/ir.may";
import "src/backend.may";
import "src/formats.may";
import "src/formats/bytes.may";
import "src/modules.may";
import "src/profile.may";

// main.may — the mayc CLI driver.
//
//   mayc [options] <source.may> [-o <binary>]
//
// Resolves textual imports, lexes, parses, lowers to target machine code,
// packages it in the selected executable format, and writes it to disk with executable permissions.

// ---------------------------------------------------------------- Constants
// Immutable let is Maylang's constant declaration. Update the version here.
let MAYC_VERSION: Str = "0.14.0";
let PRELUDE_FILE_NAME: Any  = "prelude.may";
let NATIVE_FILE_NAME: Any   = "native.may";

// ------------------------------------------------------------- Path Helpers

fun path_next(a0: Any, a0l: Any, np: Any, nl: Any) -> Any {
    mut dl: Any = 0;
    mut k: Any = 0;
    while (k < a0l) {
        if (load8(a0 + k) == 47) { dl = k + 1; } // '/'
        k = k + 1;
    }
    let rp: Any = irt_alloc(dl + nl + 1);
    mut j: Any = 0;
    while (j < dl) {
        store8(rp + j, load8(a0 + j));
        j = j + 1;
    }
    j = 0;
    while (j < nl) {
        store8(rp + dl + j, load8(np + j));
        j = j + 1;
    }
    store8(rp + dl + nl, 0);
    return rp;
}

fun side_slurp(a0: Any, a0l: Any, np: Any, nl: Any) -> Any {
    let rp: Any = path_next(a0, a0l, np, nl);
    return slurp(rp, 0);
}

// --------------------------------------------------- File Resolvers (Multi-Tier)

fun load_prelude(a0: Any, a0l: Any) -> Any {
    // 1. Next to mayc executable
    let p1: Any = side_slurp(a0, a0l, addr(PRELUDE_FILE_NAME), len(PRELUDE_FILE_NAME));
    if (LASTLEN > 0) { return p1; }

    // 2. Repo-relative to compiler/mayc (../../stdlib/prelude.may)
    let repo_rel: Any = "../../stdlib/prelude.may";
    let p2: Any = side_slurp(a0, a0l, addr(repo_rel), len(repo_rel));
    if (LASTLEN > 0) { return p2; }

    // 3. Current working directory (a checkout root)
    let cwd_rel: Any = "stdlib/prelude.may";
    return slurp(addr(cwd_rel), len(cwd_rel));
}

fun load_native(a0: Any, a0l: Any) -> Any {
    // 1. Next to mayc executable
    let n1: Any = side_slurp(a0, a0l, addr(NATIVE_FILE_NAME), len(NATIVE_FILE_NAME));
    if (LASTLEN > 0) { return n1; }

    // 2. Repo-relative to compiler/mayc (the active sidecar, not stdlib's mirror)
    let repo_rel: Any = "../../compiler/mayc/native.may";
    let n2: Any = side_slurp(a0, a0l, addr(repo_rel), len(repo_rel));
    if (LASTLEN > 0) { return n2; }

    // 3. Current working directory (a checkout root)
    let cwd_rel: Any = "compiler/mayc/native.may";
    return slurp(addr(cwd_rel), len(cwd_rel));
}

fun load_math(a0: Any, a0l: Any) -> Any {
    // 1. runtime/ next to the mayc executable
    let name: Any = "runtime/math.may";
    let m1: Any = side_slurp(a0, a0l, addr(name), len(name));
    if (LASTLEN > 0) { return m1; }

    // 2. Repo-relative to compiler/mayc
    let repo_rel: Any = "../../compiler/mayc/runtime/math.may";
    let m2: Any = side_slurp(a0, a0l, addr(repo_rel), len(repo_rel));
    if (LASTLEN > 0) { return m2; }

    // 3. Current working directory (a checkout root)
    let cwd_rel: Any = "compiler/mayc/runtime/math.may";
    let m3: Any = slurp(addr(cwd_rel), len(cwd_rel));
    if (LASTLEN == 0) { die_str("mayc: cannot find runtime/math.may\n"); }
    return m3;
}

// NodeOS programs carry a Linux syscall personality, which is part of the
// raw runtime in every runtime mode (see runtime/nodeos.may).
fun load_nodeos(a0: Any, a0l: Any) -> Any {
    let name: Any = "runtime/nodeos.may";
    let source: Any = side_slurp(a0, a0l, addr(name), len(name));
    if (LASTLEN == 0) { die_str("mayc: cannot find ${name}\n"); }
    return source;
}

// Append a runtime file (`extraLength` bytes named `name`) to the runtime
// source already in SRC, keeping each file's own line numbers for diagnostics.
fun append_runtime(extra: Any, extraLength: Any, name: Any) -> Any {
    let base: Any = SRC; let baseLength: Any = SRCLEN;
    let file: Any = SOURCE_FILES[base];
    let origins: Any = if (len(file.origins) > 0) { file.origins } else { [SourceOrigin(0, file.path, 1)] };
    push(origins, SourceOrigin(baseLength + 1, name, 1));
    let combined: Any = irt_alloc(baseLength + extraLength + 2);
    image_copy(combined, base, baseLength);
    store8(combined + baseLength, 10);
    image_copy(combined + baseLength + 1, extra, extraLength);
    store8(combined + baseLength + 1 + extraLength, 0);
    SRC = combined; SRCLEN = baseLength + 1 + extraLength;
    SOURCE_FILES[combined] = SourceFile(file.path, origins);
    return 0;
}

// A compiler running on NodeOS builds for NodeOS unless told otherwise. The
// personality reports itself through uname, so this asks the system rather
// than how the compiler was built.
fun host_target() -> Any {
    let names: Any = irt_alloc(390);
    if (syscall(63, names) == 0 and name_eq(names, 6, addr("NodeOS"), 6) == 1 and load8(names + 6) == 0) { return "x86_64-nodeos"; }
    return "x86_64-linux";
}

fun load_core(a0: Any, a0l: Any, file: Any) -> Any {
    let name: Any = "runtime/" + file;
    let source: Any = side_slurp(a0, a0l, addr(name), len(name));
    if (LASTLEN == 0) { die_str("mayc: cannot find ${name}\n"); }
    return source;
}

// ------------------------------------------------------------- Driver Entry

fun cli_usage() -> Any {
    let message: Any = "Maylang compiler (mayc)\n\nUsage:\n  mayc [options] <source.may> [-o <output>]\n\nOptions:\n  -h, --help          Show this help and exit\n  -V, --version       Show compiler version and exit\n  --list-targets      List target formats and default runtimes, then exit\n  -o, --output PATH   Write executable to PATH (default: source name without\n                      .may, or with .nxf for x86_64-nodeos)\n  --check             Parse and type-check; do not emit an executable\n  --explain-behavior  Check contracts and print inferred effect summaries as JSON\n  --strict            Enable strict type checking (default)\n  --diagnostics FORMAT text (default) or json; up to 20 errors\n  --debug             Include function/source traces in runtime errors\n  --legacy            Disable strict type checking for legacy source\n  --raw               Compile without runtime, prelude, or native library\n  --no-code-align     Do not align --raw x86-64 function bodies and loop heads\n  --runtime NAME      full (x86-64 Linux/NodeOS), core (all targets), or none\n  --time              Report compiler stage timings to stderr\n  --target TARGET     x86_64-linux (default on Linux), x86_64-nodeos (default\n                      on NodeOS), arm64-linux, riscv64-linux, arm64-macos,\n                      x86_64-windows (core runtime by default)\n  --dump-expanded     Print expanded source and exit\n\nExamples:\n  mayc hello.may\n  mayc app.may -o build/app\n  mayc --check app.may\n";
    syscall(1, 1, addr(message), len(message));
    syscall(60, 0);
    return 0;
}

fun cli_default_output(pointer: Any, length: Any, targetName: Any) -> Any {
    mut baseLength: Any = length;
    let hasMaySuffix: Any = length >= 4 and load8(pointer + length - 4) == 46 and load8(pointer + length - 3) == 109 and load8(pointer + length - 2) == 97 and load8(pointer + length - 1) == 121;
    if (hasMaySuffix) { baseLength = length - 4; }
    // NodeOS runs images by name only when they carry the .nxf suffix.
    let suffix: Any = if (targetName == "x86_64-nodeos") { ".nxf" } else if (hasMaySuffix) { "" } else { ".out" };
    let suffixLength: Any = len(suffix);
    let result: Any = irt_alloc(baseLength + suffixLength + 1);
    mut i: Any = 0;
    while (i < baseLength) { store8(result + i, load8(pointer + i)); i = i + 1; }
    mut j: Any = 0;
    while (j < suffixLength) { store8(result + baseLength + j, load8(addr(suffix) + j)); j = j + 1; }
    store8(result + baseLength + suffixLength, 0);
    return [result, baseLength + suffixLength];
}

fun cli_list_targets() -> Any {
    let header: Str = "target\tformat\tdefault-runtime\n";
    syscall(1, 1, addr(header), len(header));
    for name: Str in ["x86_64-linux", "x86_64-nodeos", "arm64-linux", "riscv64-linux", "arm64-macos", "x86_64-windows"] {
        let target: Any = target_select(name);
        let runtime: Str = if (target.runtime) { "full" } else { "core" };
        let line: Str = "${name}\t${target.format}\t${runtime}\n";
        syscall(1, 1, addr(line), len(line));
    }
    let note: Str = "Compiler hosts: Linux x86-64 and NodeOS.\n";
    syscall(1, 1, addr(note), len(note));
    syscall(60, 0);
    return 0;
}

fun main2() -> Any {
    irt_init();

    let cmd: Any = slurp(addr("/proc/self/cmdline"), len("/proc/self/cmdline"));
    let cn: Any = LASTLEN;

    // Split the NUL-separated command line into a list of [ptr, len] spans.
    mut argv: Any = [];
    mut i: Any = 0;
    while (i < cn) {
        let s: Any = i;
        while (i < cn) {
            if (load8(cmd + i) == 0) { break; }
            i = i + 1;
        }
        if (i > s) { push(argv, [cmd + s, i - s]); }
        i = i + 1;
    }

    // argv[0] may be a bare PATH command or a symlink in another directory.
    // Sidecars belong to the actual executable, as does its installed stdlib.
    mut a0: Any = argv[0][0];
    mut a0l: Any = argv[0][1];
    let executable: Any = irt_alloc(4096);
    let executableLength: Any = syscall(89, addr("/proc/self/exe"), executable, 4096);
    if (executableLength > 0 and executableLength < 4096) {
        a0 = executable;
        a0l = executableLength;
    }
    mut sp: Any = 0;
    mut sl: Any = 0;
    mut op: Any = 0;
    mut ol: Any = 0;
    mut targetName: Any = host_target();
    mut runtimeName: Any = "auto";
    mut rawflag: Any = 0;
    mut dumpflag: Any = 0;
    mut checkflag: Any = 0;
    mut expandedflag: Any = 0;
    mut k: Any = 1;
    while (k < len(argv)) {
        let ap: Any = argv[k][0];
        let al: Any = argv[k][1];
        if (name_eq(ap, al, addr("-h"), 2) == 1 or name_eq(ap, al, addr("--help"), 6) == 1) {
            cli_usage();
        } else if (name_eq(ap, al, addr("-V"), 2) == 1 or name_eq(ap, al, addr("--version"), 9) == 1) {
            let version: Str = "mayc " + MAYC_VERSION + "\n";
            syscall(1, 1, addr(version), len(version));
            syscall(60, 0);
        } else if (name_eq(ap, al, addr("--list-targets"), 14) == 1) {
            cli_list_targets();
        } else if (name_eq(ap, al, addr("-o"), 2) == 1 or name_eq(ap, al, addr("--output"), 8) == 1) {
            k = k + 1;
            if (k >= len(argv)) { die_str("mayc: -o/--output requires a path\n"); }
            op = argv[k][0]; ol = argv[k][1];
        } else if (name_eq(ap, al, addr("--target"), 8) == 1) {
            k += 1;
            if (k >= len(argv)) { die_str("mayc: --target requires a target name\n"); }
            targetName = symbol_name(argv[k][0], argv[k][1]);
        } else if (name_eq(ap, al, addr("--raw"), 5) == 1) {
            rawflag = 1;
        } else if (name_eq(ap, al, addr("--no-code-align"), 15) == 1) {
            backend_disable_code_alignment();
        } else if (name_eq(ap, al, addr("--runtime"), 9) == 1) {
            k += 1;
            if (k >= len(argv)) { die_str("mayc: --runtime requires full, core, or none\n"); }
            runtimeName = symbol_name(argv[k][0], argv[k][1]);
            if (runtimeName != "full" and runtimeName != "core" and runtimeName != "none") { die_str("mayc: unknown runtime `${runtimeName}`\n"); }
        } else if (name_eq(ap, al, addr("--values"), 8) == 1) {
            die_str("mayc: --values was removed; every runtime uses fat values (docs/design/FAT_VALUES.md)\n");
        } else if (name_eq(ap, al, addr("--emit-llvm"), 11) == 1) {
            die_str("mayc: --emit-llvm was removed; mayc emits native executables itself\n");
        } else if (name_eq(ap, al, addr("--time"), 6) == 1) {
            PROFILE_ENABLED = true;
        } else if (name_eq(ap, al, addr("--debug"), 7) == 1) {
            DEBUG_TRACES = true;
        } else if (name_eq(ap, al, addr("--dump"), 6) == 1) {
            dumpflag = 1;
        } else if (name_eq(ap, al, addr("--dump-expanded"), 15) == 1) {
            expandedflag = 1;
        } else if (name_eq(ap, al, addr("--check"), 7) == 1) {
            checkflag = 1;
        } else if (name_eq(ap, al, addr("--explain-behavior"), 18) == 1) {
            BEHAVIOR_EXPLAIN = true; checkflag = 1;
        } else if (name_eq(ap, al, addr("--diagnostics"), 13) == 1) {
            k += 1; if (k >= len(argv)) { die_str("mayc: --diagnostics requires text or json\n"); }
            DIAGNOSTIC_FORMAT = symbol_name(argv[k][0], argv[k][1]);
            if (DIAGNOSTIC_FORMAT != "text" and DIAGNOSTIC_FORMAT != "json") { die_str("mayc: --diagnostics requires text or json\n"); }
        } else if (name_eq(ap, al, addr("--legacy"), 8) == 1) {
            STRICT_TYPES = false;
        } else if (name_eq(ap, al, addr("--strict"), 8) == 1) {
            STRICT_TYPES = true;
        } else if (al > 0 and load8(ap) == 45) {
            die_str("mayc: unknown option (use --help)\n");
        } else if (sl == 0) {
            sp = ap;
            sl = al;
        } else if (ol == 0) {
            op = ap;
            ol = al;
        }
        k = k + 1;
    }
    if (BEHAVIOR_EXPLAIN and (dumpflag == 1 or expandedflag == 1)) {
        die_str("mayc: --explain-behavior cannot be combined with source dumps\n");
    }
    if (sl == 0) {
        die_str("mayc: missing source file (use --help)\n");
    }
    if (ol == 0 and checkflag == 0 and dumpflag == 0 and expandedflag == 0) {
        let default: Any = cli_default_output(sp, sl, targetName);
        op = default[0]; ol = default[1];
    }
    if (ol == 0 and checkflag == 0 and dumpflag == 0 and expandedflag == 0) {
        die_str("mayc: missing -o <binary>\n");
    }

    let ctx: Any = emitter_new(target_select(targetName));
    if (runtimeName == "auto") { runtimeName = if (targetName == "x86_64-linux" or targetName == "x86_64-nodeos") { "full" } else { "core" }; }
    let nodeos: Any = ctx.target.os == "nodeos";
    if (runtimeName == "none") { rawflag = 1; }
    ctx.runtime = if (rawflag == 1) { "none" } else { runtimeName };
    profile_begin();
    // Programs with a runtime use fat values (#92, docs/design/FAT_VALUES.md);
    // --raw code computes with machine words.
    FAT_VALUES = rawflag == 0;
    if (checkflag == 0 and dumpflag == 0 and expandedflag == 0) { backend_validate(ctx, rawflag); }
    if (rawflag == 1) {
        PARSE_RAW = 1;
        DYNMODE = 0;
        if (nodeos and expandedflag == 0) {
            // Raw programs still reach the system through the personality.
            SRC = load_nodeos(a0, a0l); SRCLEN = LASTLEN;
            SOURCE_FILES[SRC] = SourceFile("runtime/nodeos.may", []);
            DIAGNOSTIC_STAGE = "lex"; lex_all();
            DIAGNOSTIC_STAGE = "parse"; parse_program(ctx);
            RUNTIME_BODY = MAINBODY;
            for r: Any in FUNC_HEAD { r.mode = 1; }
        }
        expand(sp, sl);
        if (expandedflag == 1) {
            syscall(1, 1, SRC, SRCLEN);
            syscall(60, 0);
        }
        DIAGNOSTIC_STAGE = "lex"; lex_all();
        DIAGNOSTIC_STAGE = "parse"; parse_program(ctx);
        profile_mark("parse");
        DIAGNOSTIC_STAGE = "type"; strict_program(ctx);
        profile_mark("types");
        DIAGNOSTIC_STAGE = "name"; sem_program();
        profile_mark("resolve");
        if (checkflag == 1) { if (BEHAVIOR_EXPLAIN) { print(json_stringify(behavior_report())); } syscall(60, 0); }
        ir_program(ctx);

    } else {
        DYNMODE = 1;
        // The shared fat runtime, then its host (docs/design/FAT_VALUES.md).
        SRC = load_core(a0, a0l, "fat.may"); SRCLEN = LASTLEN;
        SOURCE_FILES[SRC] = SourceFile("runtime/fat.may", []);
        let hostName: Any = if (ctx.runtime == "core") { "fat_core.may" } else { "fat_linux.may" };
        let host: Any = load_core(a0, a0l, hostName);
        append_runtime(host, LASTLEN, "runtime/" + hostName);
        if (nodeos) { let personality: Any = load_nodeos(a0, a0l); append_runtime(personality, LASTLEN, "runtime/nodeos.may"); }
        PARSE_RAW = 1;
        DIAGNOSTIC_STAGE = "lex"; lex_all();
        DIAGNOSTIC_STAGE = "parse"; parse_program(ctx);
        profile_mark("runtime");
        RUNTIME_BODY = MAINBODY;
        for r: Any in FUNC_HEAD {
            r.mode = 1;
        }
        PARSE_RAW = 0;
        expand(sp, sl);
        let ub: Any = SRC;
        let un: Any = SRCLEN;
        if (expandedflag == 1) {
            syscall(1, 1, ub, un);
            syscall(60, 0);
        }

        // Resolve the library: the prelude and native library (the core
        // runtime adds runtime/fat_corelib.may). Portable math follows any
        // library prelude.
        let parts: Any = [];
        push(parts, [load_prelude(a0, a0l), LASTLEN, "prelude.may"]);
        push(parts, [load_native(a0, a0l), LASTLEN, "native.may"]);
        if (ctx.runtime == "core") { push(parts, [load_core(a0, a0l, "fat_corelib.may"), LASTLEN, "runtime/fat_corelib.may"]); }
        mut libraryLength: Any = 0;
        for part: Any in parts { libraryLength += part[1]; }
        if (parts[0][1] > 0) { push(parts, [load_math(a0, a0l), LASTLEN, "runtime/math.may"]); }

        if (libraryLength > 0) {
            mut total: Any = un;
            for part: Any in parts { total += part[1]; }
            let cb: Any = irt_alloc(total + 8);
            let origins: Any = [];
            mut at: Any = 0;
            for part: Any in parts {
                image_copy(cb + at, part[0], part[1]);
                push(origins, SourceOrigin(at, part[2], 1));
                at += part[1];
            }
            image_copy(cb + at, ub, un);
            SRC = cb;
            SRCLEN = total;
            for origin: Any in EXPAND_ORIGINS {
                push(origins, SourceOrigin(at + origin.start, origin.path, origin.line));
            }
            SOURCE_FILES[cb] = SourceFile(symbol_name(sp, sl), origins);
        }
        if (dumpflag == 1) {
            let fd: Any = syscall(2, addr("mayc_expanded.may"), 577, 420);
            syscall(1, fd, SRC, SRCLEN);
            syscall(3, fd);
            syscall(60, 0);
        }
        DIAGNOSTIC_STAGE = "lex"; lex_all();
        DIAGNOSTIC_STAGE = "parse"; parse_program(ctx);
        profile_mark("parse");
        DIAGNOSTIC_STAGE = "type"; strict_program(ctx);
        profile_mark("types");
        DIAGNOSTIC_STAGE = "name"; sem_program();
        profile_mark("resolve");
        if (checkflag == 1) { if (BEHAVIOR_EXPLAIN) { print(json_stringify(behavior_report())); } syscall(60, 0); }
        ir_program(ctx);

    }
    profile_mark("ir");
    format_output_name(ctx, symbol_name(op, ol));
    backend_emit(ctx);
    profile_mark("emit");
    pad_code(ctx);
    format_layout(ctx);
    backend_patch(ctx);
    format_build(ctx);
    write_out(ctx, op, ol);
    emitter_release(ctx);
    profile_mark("package");
    return 0;
}

may { main2(); } otherwise { report_diagnostic(err.message); }
