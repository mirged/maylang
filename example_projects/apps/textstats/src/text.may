// text.may — tokenisation helpers.
//
// Pure Maylang on top of the native prelude's char/string primitives.

fun is_letter_code(c: Int) -> Bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

fun is_digit_code(c: Int) -> Bool { return c >= 48 && c <= 57; }

/// Turn every control/whitespace character into a single space.
fun normalize_ws(text: Str) -> Str {
    mut out: Str = "";
    for i: Int in 0..len(text) {
        let c: Int = char_at(text, i);
        if (c == 10 || c == 9 || c == 13 || c == 12) {
            out = out + " ";
        } else {
            out = out + char_from(c);
        }
    }
    return out;
}

/// Drop everything that is not a letter or digit (punctuation, symbols).
fun strip_punct(word: Str) -> Str {
    mut out: Str = "";
    for i: Int in 0..len(word) {
        let c: Int = char_at(word, i);
        if (is_letter_code(c) || is_digit_code(c)) {
            out = out + char_from(c);
        }
    }
    return out;
}

/// Split normalised text into clean, lower-cased words.
fun words(text: Str) -> List<Str> {
    let raw: List<Str> = split(normalize_ws(text), " ");
    let out: List<Str> = [];
    for i: Int in 0..len(raw) {
        let cleaned: Str = strip_punct(to_lower(raw[i]));
        if (len(cleaned) > 0) {
            push(out, cleaned);
        }
    }
    return out;
}
