// report.may — terminal formatting.
import "stats.may";

fun pad_right(s: Str, width: Int) -> Str {
    mut out: Str = s;
    while (len(out) < width) { out = out + " "; }
    return out;
}

fun bar(count: Int) -> Str { return repeat("#", count); }

fun rule(width: Int) -> Str { return repeat("-", width); }

/// Render the ranked report. `entries` is a list of [word, count] pairs.
fun render(title: Str, summary: Summary, entries: List<Entry>, limit: Int) -> Int {
    let width: Int = 46;
    print(rule(width));
    print("  " + title);
    print(rule(width));
    print("words", summary.total, " unique", summary.unique, " avg", summary.avg);
    print("longest", summary.longest);
    print(rule(width));

    let n: Int = len(entries);
    let shown: Int = min(n, limit);
    for i: Int in 0..shown {
        let entry: Entry = entries[i];
        print(pad_right(entry.word, 18), pad_right(str(entry.count), 5), bar(entry.count));
    }
    if (n > shown) {
        print("... and", n - shown, "more");
    }
    return print(rule(width));
}
