// stats.may — counting, ranking and summary statistics.
import "text.may";

struct Entry { word: Str, count: Int }
struct Summary { total: Int, unique: Int, avg: Str, longest: Str }

/// Count occurrences of each word. Returns a map word -> count.
fun count_words(words_list: List<Str>) -> Map<Str, Int> {
    let counts: Map<Str, Int> = {};
    for word in words_list { counts[word] = (counts[word] ?? 0) + 1; }
    return counts;
}

/// Order two [word, count] entries: more frequent first, ties alphabetical.
fun compare_entries(a: Entry, b: Entry) -> Int {
    if (a.count > b.count) { return -1; }
    if (a.count < b.count) { return 1; }
    if (cmp(a.word, b.word) < 0) { return -1; }
    if (cmp(a.word, b.word) > 0) { return 1; }
    return 0;
}

/// Turn a count map into a list of [word, count] pairs, ranked.
fun rank(counts: Map<Str, Int>) -> List<Entry> {
    let entries: List<Entry> = [];
    for w: Str in keys(counts) {
        push(entries, Entry(w, counts[w] ?? 0));
    }
    let n: Int = len(entries);
    for i: Int in 1..n {
        let key: Entry = entries[i];
        mut j: Int = i - 1;
        while (j >= 0 && compare_entries(entries[j], key) > 0) {
            entries[j + 1] = entries[j];
            j = j - 1;
        }
        entries[j + 1] = key;
    }
    return entries;
}

fun total_length(words_list: List<Str>) -> Int {
    return sum(map(words_list, |w: Str| -> Int { return len(w); }));
}

fun longest_word(words_list: List<Str>) -> Str {
    return reduce(
        words_list,
        |a: Str, b: Str| -> Str { return if (len(b) > len(a)) { b } else { a }; },
        ""
    );
}

/// Build a summary map for the report.
fun summarize(words_list: List<Str>, counts: Map<Str, Int>) -> Summary {
    let total: Int = len(words_list);
    let total_chars: Int = total_length(words_list);
    mut whole: Int = 0;
    mut frac: Int = 0;
    if (total > 0) {
        whole = total_chars / total;
        frac = (total_chars * 100 / total) % 100;
    }
    mut frac_text: Str = str(frac);
    if (len(frac_text) < 2) { frac_text = "0" + frac_text; }
    return Summary(total, len(counts), str(whole) + "." + frac_text, longest_word(words_list));
}
