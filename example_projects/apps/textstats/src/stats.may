// stats.may — counting, ranking and summary statistics.
import "text.may";

/// Count occurrences of each word. Returns a map word -> count.
fun count_words(words_list: Any) -> Any {
    let counts: Any = to_map([]);
    for i: Any in 0..len(words_list) {
        let w: Any = words_list[i];
        let previous: Any = map_get(counts, w);
        mut n: Any = 0;
        if (previous != nil) { n = previous; }
        map_set(counts, w, n + 1);
    }
    return counts;
}

/// Order two [word, count] entries: more frequent first, ties alphabetical.
fun compare_entries(a: Any, b: Any) -> Any {
    if (a[1] > b[1]) { return -1; }
    if (a[1] < b[1]) { return 1; }
    if (cmp(a[0], b[0]) < 0) { return -1; }
    if (cmp(a[0], b[0]) > 0) { return 1; }
    return 0;
}

/// Turn a count map into a list of [word, count] pairs, ranked.
fun rank(counts: Any) -> Any {
    let entries: Any = [];
    for w: Any in keys(counts) {
        push(entries, [w, map_get(counts, w)]);
    }
    let n: Any = len(entries);
    for i: Any in 1..n {
        let key: Any = entries[i];
        mut j: Any = i - 1;
        while (j >= 0 && compare_entries(entries[j], key) > 0) {
            entries[j + 1] = entries[j];
            j = j - 1;
        }
        entries[j + 1] = key;
    }
    return entries;
}

fun total_length(words_list: Any) -> Any {
    return sum(map(words_list, |w: Any| -> Any { return len(w); }));
}

fun longest_word(words_list: Any) -> Any {
    return reduce(
        words_list,
        |a: Any, b: Any| -> Any { return if (len(b) > len(a)) { b } else { a }; },
        ""
    );
}

/// Build a summary map for the report.
fun summarize(words_list: Any, counts: Any) -> Any {
    let total: Any = len(words_list);
    let total_chars: Any = total_length(words_list);
    mut whole: Any = 0;
    mut frac: Any = 0;
    if (total > 0) {
        whole = total_chars / total;
        frac = (total_chars * 100 / total) % 100;
    }
    mut frac_text: Any = str(frac);
    if (len(frac_text) < 2) { frac_text = "0" + frac_text; }
    return {
        "total": total,
        "unique": len(counts),
        "avg": str(whole) + "." + frac_text,
        "longest": longest_word(words_list)
    };
}
