import "model.may";
import "genome.may";
import "../../../../stdlib/random.may";

fun new_world(config: Config) -> World {
    let rng: Any = random_new(config.seed);
    let cells: List<Cell> = [];
    for i: Int in 0..config.width * config.width {
        let fertility: Float = 0.45 + 0.55 * random_float(rng);
        push(cells, Cell(5.0 * fertility, 0.0, 0.5, fertility));
    }
    let world: World = World(config, rng, 0, 1, cells, [], empty_totals(), [], [], 0.0);
    for i: Int in 0..config.population {
        let genome: Genome = founder_genome(rng);
        let egg: Egg = Egg(world.next_id, 0, 0, genome, int(random_int(rng, 0, config.width - 1)),
                          int(random_int(rng, 0, config.width - 1)), 3.0, body_energy(genome));
        push(world.creatures, hatch(egg));
        world.next_id += 1;
    }
    world.totals.initial_energy = stored_energy(world);
    return world;
}
fun stored_energy(world: World) -> Float {
    mut total: Float = 0.0;
    for cell: Cell in world.cells { total += cell.plants + cell.carrion; }
    for creature: Creature in world.creatures { total += creature.energy + creature.body; }
    return total;
}
fun season(generation: Int) -> Float {
    return 0.75 + 0.25 * sin(2.0 * pi() * float(generation % 257) / 257.0);
}
fun grow_environment(world: World) -> Nil {
    let sunlight: Float = season(world.generation);
    for cell: Cell in world.cells {
        let decay: Float = cell.carrion * 0.025;
        cell.carrion -= decay;
        cell.nutrients = bounded(cell.nutrients + decay * 0.15 - 0.015, 0.0, 5.0);
        world.totals.heat += decay;
        let growth: Float = smaller(6.0 - cell.plants, 1.1 * cell.fertility * sunlight * (1.0 + cell.nutrients * 0.1));
        cell.plants += growth;
        world.totals.sunlight += growth;
    }
    return;
}
fun deposit_corpse(world: World, creature: Creature) -> Nil {
    let cell: Cell = world.cells[cell_index(creature.x, creature.y, world.config.width)];
    cell.carrion += creature.body + creature.energy;
    creature.body = 0.0; creature.energy = 0.0; creature.health = 0.0;
    return;
}
fun occupancy(world: World) -> List<List<Int>> {
    let buckets: List<List<Int>> = [];
    for i: Int in 0..len(world.cells) { push(buckets, []); }
    for i: Int in 0..len(world.creatures) {
        let creature: Creature = world.creatures[i];
        if (creature.health > 0.0) { push(buckets[cell_index(creature.x, creature.y, world.config.width)], i); }
    }
    return buckets;
}
fun displacement(a: Int, b: Int, width: Int) -> Int {
    mut delta: Int = b - a;
    if (delta > width / 2) { delta -= width; }
    if (delta < -width / 2) { delta += width; }
    return delta;
}
fun neighbor_index(world: World, buckets: List<List<Int>>, actor_index: Int) -> Int {
    let actor: Creature = world.creatures[actor_index];
    mut found: Int = -1;
    mut distance: Int = 3;
    for offset: Int in 0..5 {
        let dx: Int = if (offset == 1) { 1 } else if (offset == 2) { -1 } else { 0 };
        let dy: Int = if (offset == 3) { 1 } else if (offset == 4) { -1 } else { 0 };
        let bucket: List<Int> = buckets[cell_index(actor.x + dx, actor.y + dy, world.config.width)];
        for other_index: Int in bucket {
            if (other_index != actor_index) {
                let other: Creature = world.creatures[other_index];
                let next: Int = int(abs(displacement(actor.x, other.x, world.config.width))) + int(abs(displacement(actor.y, other.y, world.config.width)));
                if (other.health > 0.0 and next < distance) { found = other_index; distance = next; }
            }
        }
    }
    return found;
}
