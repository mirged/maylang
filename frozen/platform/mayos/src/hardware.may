fun port_read(port: Int) -> Int {
    return __ccall6(load64(2097216), port, 0, 0, 0, 0, 0);
}
fun port_write(port: Int, value: Int) -> Nil {
    __ccall6(load64(2097224), port, value, 0, 0, 0, 0);
    return;
}
fun idle_cpu() -> Nil {
    __ccall6(load64(2097232), 0, 0, 0, 0, 0, 0);
    return;
}
fun ticks() -> Int { return load64(2097152); }
fun port_read16(port: Int) -> Int {
    return __ccall6(load64(2097256), port, 0, 0, 0, 0, 0);
}
fun port_write16(port: Int, value: Int) -> Nil {
    __ccall6(load64(2097248), port, value, 0, 0, 0, 0);
    return;
}
fun shutdown() -> Nil {
    __ccall6(load64(2097240), 244, 16, 0, 0, 0, 0);
    // QEMU ACPI fallback when the debug-exit device is absent.
    __ccall6(load64(2097248), 1540, 8192, 0, 0, 0, 0);
    while (1 == 1) { idle_cpu(); }
    return;
}
fun boot_error_exit() -> Nil {
    __ccall6(load64(2097240), 244, 17, 0, 0, 0, 0);
    while (1 == 1) { idle_cpu(); }
    return;
}
