import "../shared/format.may" as format;
let argv: List<Str> = args();
let USAGE: Str = "usage: mayfmt [--check] file.may ...\n\n  --check     report files that need formatting without writing; exit 1 if any\n  -h, --help  show this help and exit";
mut check: Bool = false; mut changed: Bool = false; mut count: Int = 0;
for i: Int in 1..len(argv) {
    let path: Str = argv[i];
    if (path == "--check") { check = true; continue; }
    if (path == "--help" or path == "-h") { print(USAGE); exit(0); }
}
for i: Int in 1..len(argv) {
    let path: Str = argv[i];
    if (path != "--check" and starts_with(path, "--")) { fail("mayfmt: unknown option " + path); }
}
for i: Int in 1..len(argv) {
    let path: Str = argv[i];
    if (path == "--check") { continue; }
    let source: Str = read_file(path);
    let formatted: Str = format.format_source(source, 4, true);
    if (source != formatted) {
        changed = true;
        if (check) { print("needs formatting:", path); } else { write_file(path, formatted); }
    }
    count += 1;
}
if (count == 0) { print(USAGE); exit(2); }
exit(if (check and changed) { 1 } else { 0 });
