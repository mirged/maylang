// Byte offsets internally; UTF-16 code units at the protocol boundary.
/// An LSP position: zero-based line and UTF-16 column.
struct Position { line: Int, character: Int }
/// An LSP range between two positions.
struct Range { start: Position, end: Position }
let LS_KEYWORDS: List<Str> = ["fun", "let", "mut", "if", "else", "while", "for", "in", "return", "break", "continue", "unless", "match", "may", "otherwise", "struct", "enum", "pub", "extern", "import", "from", "as", "and", "or", "not", "true", "false", "nil"];
// File suffixes do not determine filesystem type: .may is also a build cache.
fun ls_is_directory(path: Str) -> Bool {
    let descriptor: Int = syscall(2, cstr(path), 589824, 0);
    if (descriptor < 0) { return false; }
    syscall(3, descriptor); return true;
}
fun ls_bytes(s: Str) -> Int { return load64(addr(s) - 8); }
fun ls_byte(s: Str, i: Int) -> Int { if (i < 0 or i >= ls_bytes(s)) { return 0; } return load8(addr(s) + i); }
fun ls_width(c: Int) -> Int {
    if (c < 128) { return 1; }
    if (c < 224) { return 2; }
    if (c < 240) { return 3; }
    return 4;
}
fun ls_blank(n: Int) -> Str {
    // Doubling avoids the prelude's repeated one-character concatenation.
    mut out: Str = ""; mut block: Str = " "; mut left: Int = n;
    while (left > 0) {
        if (left % 2 == 1) { out = out + block; }
        left = left / 2;
        if (left > 0) { block = block + block; }
    }
    return out;
}
fun ls_text(p: Ptr, n: Int) -> Str {
    let out: Str = ls_blank(n); mut i: Int = 0;
    // 32-bit chunks fit safely in Maylang's tagged integer representation.
    while (i + 4 <= n) { store32(addr(out) + i, load32(p + i)); i += 4; }
    while (i < n) { store8(addr(out) + i, load8(p + i)); i += 1; }
    return out;
}
fun ls_slice(s: Str, a: Int, b: Int) -> Str { return ls_text(addr(s) + a, max(0, b - a)); }
fun ls_trim(s: Str) -> Str {
    mut a: Int = 0; mut b: Int = ls_bytes(s);
    while (a < b and has([32, 9, 10, 13], ls_byte(s, a))) { a += 1; }
    while (b > a and has([32, 9, 10, 13], ls_byte(s, b - 1))) { b -= 1; }
    if (a == 0 and b == ls_bytes(s)) { return s; }
    return ls_slice(s, a, b);
}
fun ls_matches(s: Str, at: Int, part: Str) -> Bool {
    let n: Int = ls_bytes(part);
    if (at < 0 or at + n > ls_bytes(s)) { return false; }
    mut i: Int = 0;
    while (i < n) { if (load8(addr(s) + at + i) != load8(addr(part) + i)) { return false; } i += 1; }
    return true;
}
fun ls_starts(s: Str, prefix: Str) -> Bool { return ls_matches(s, 0, prefix); }
fun ls_ends(s: Str, suffix: Str) -> Bool { return ls_matches(s, ls_bytes(s) - ls_bytes(suffix), suffix); }
fun ls_find(s: Str, part: Str) -> Int {
    let stop: Int = ls_bytes(s) - ls_bytes(part); mut i: Int = 0;
    while (i <= stop) { if (ls_matches(s, i, part)) { return i; } i += 1; }
    return -1;
}
fun ls_contains(s: Str, part: Str) -> Bool { return ls_find(s, part) >= 0; }
fun ls_split(s: Str, separator: Str) -> List<Str> {
    let parts: List<Str> = []; let width: Int = ls_bytes(separator); mut start: Int = 0; mut i: Int = 0;
    if (width == 0) { return [s]; }
    while (i + width <= ls_bytes(s)) {
        if (ls_matches(s, i, separator)) { push(parts, ls_slice(s, start, i)); i += width; start = i; }
        else { i += 1; }
    }
    push(parts, ls_slice(s, start, ls_bytes(s))); return parts;
}
fun ls_lower(s: Str) -> Str {
    let out: Str = ls_slice(s, 0, ls_bytes(s));
    for i: Int in 0..ls_bytes(out) { let c: Int = ls_byte(out, i); if (c >= 65 and c <= 90) { store8(addr(out) + i, c + 32); } }
    return out;
}
fun ls_validate_utf8(s: Str) -> Nil {
    mut i: Int = 0;
    while (i < ls_bytes(s)) {
        let c: Int = ls_byte(s, i); let w: Int = ls_width(c);
        if (c < 128) { i += 1; continue; }
        if (c < 194 or c > 244 or i + w > ls_bytes(s)) { fail("invalid UTF-8"); }
        for j: Int in 1..w { let b: Int = ls_byte(s, i + j); if (b < 128 or b > 191) { fail("invalid UTF-8"); } }
        let second: Int = ls_byte(s, i + 1);
        if ((c == 224 and second < 160) or (c == 237 and second >= 160) or (c == 240 and second < 144) or (c == 244 and second >= 144)) { fail("invalid UTF-8"); }
        i += w;
    }
    return;
}
mut LS_POSITION_TEXT: Str = "";
mut LS_LINE_STARTS: List<Int> = [0];
fun ls_lines(s: Str) -> Nil {
    if (addr(s) != addr(LS_POSITION_TEXT)) {
        LS_POSITION_TEXT = s; LS_LINE_STARTS = [0];
        for i: Int in 0..ls_bytes(s) { if (ls_byte(s, i) == 10) { push(LS_LINE_STARTS, i + 1); } }
    }
    return;
}
fun ls_position(s: Str, offset: Int) -> Position {
    ls_lines(s); let limit: Int = min(max(0, offset), ls_bytes(s));
    mut lo: Int = 0; mut hi: Int = len(LS_LINE_STARTS);
    while (lo + 1 < hi) { let mid: Int = (lo + hi) / 2; if (LS_LINE_STARTS[mid] <= limit) { lo = mid; } else { hi = mid; } }
    mut i: Int = LS_LINE_STARTS[lo]; mut col: Int = 0;
    while (i < limit) { let c: Int = ls_byte(s, i); col += if (c >= 240) { 2 } else { 1 }; i += ls_width(c); }
    return Position(lo, col);
}
fun ls_offset(s: Str, p: Any) -> Int {
    if (value_tag(p) != 7 or value_tag(p.line) != 0 or value_tag(p.character) != 0 or p.line < 0 or p.character < 0) { fail("invalid position"); }
    ls_lines(s);
    if (p.line >= len(LS_LINE_STARTS)) { return ls_bytes(s); }
    mut i: Int = LS_LINE_STARTS[p.line]; mut col: Int = 0;
    while (i < ls_bytes(s) and col < p.character and ls_byte(s, i) != 10 and ls_byte(s, i) != 13) {
        let c: Int = ls_byte(s, i); col += if (c >= 240) { 2 } else { 1 }; i += ls_width(c);
    }
    return i;
}
fun ls_range(s: Str, a: Int, b: Int) -> Range { return Range(ls_position(s, a), ls_position(s, b)); }
fun ls_ident_start(c: Int) -> Bool { return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95; }
fun ls_ident(c: Int) -> Bool { return ls_ident_start(c) or (c >= 48 and c <= 57); }
fun ls_valid_name(s: Str) -> Bool {
    if (ls_bytes(s) == 0 or not ls_ident_start(ls_byte(s, 0)) or has(LS_KEYWORDS, s)) { return false; }
    for i: Int in 1..ls_bytes(s) { if (not ls_ident(ls_byte(s, i))) { return false; } }
    return true;
}
// Copy a dynamic JSON array of strings into a typed list.
fun ls_str_list(value: Any) -> List<Str> {
    let out: List<Str> = [];
    if (value == nil) { return out; }
    for item: Any in value { push(out, str(item)); }
    return out;
}
// Read one dynamic value out of a typed map; JSON fields stay reachable as Any.
fun ls_map_value(map: Map<Str, Any>, key: Str) -> Any {
    let value: Optional<Any> = map[key];
    if (value == nil) { return nil; }
    return value;
}
fun ls_dir(path: Str) -> Str {
    let parts: List<Str> = ls_split(path, "/"); pop(parts); return join(parts, "/");
}
fun ls_normal(path: Str) -> Str {
    let parts: List<Str> = [];
    for part: Str in ls_split(path, "/") {
        if (part == "..") { if (len(parts) > 0) { pop(parts); } }
        else if (part != "" and part != ".") { push(parts, part); }
    }
    return "/" + join(parts, "/");
}
fun ls_hex(c: Int) -> Int {
    if (c >= 48 and c <= 57) { return c - 48; }
    if (c >= 65 and c <= 70) { return c - 55; }
    if (c >= 97 and c <= 102) { return c - 87; }
    return fail("invalid URI escape");
}
fun ls_path(uri: Str) -> Str {
    if (not ls_starts(uri, "file://")) { fail("only file URIs are supported"); }
    let raw: Str = ls_slice(uri, 7, ls_bytes(uri));
    if (ls_starts(raw, "localhost/")) { return ls_path("file:///" + ls_slice(raw, 10, ls_bytes(raw))); }
    if (not ls_starts(raw, "/")) { fail("remote file URIs are unsupported"); }
    mut encoded: Str = "";
    mut i: Int = 0;
    // Decode percent bytes via a temporary byte buffer, preserving UTF-8.
    let p: Int = syscall(9, 0, ls_bytes(raw) + 1, 3, 34, -1, 0);
    mut n: Int = 0;
    while (i < ls_bytes(raw)) {
        mut c: Int = ls_byte(raw, i);
        if (c == 37) {
            if (i + 2 >= ls_bytes(raw)) { syscall(11, p, ls_bytes(raw) + 1); fail("invalid URI"); }
            c = ls_hex(ls_byte(raw, i + 1)) * 16 + ls_hex(ls_byte(raw, i + 2)); i += 2;
        }
        store8(p + n, c); n += 1; i += 1;
    }
    encoded = ls_text(ptr(p), n); syscall(11, p, ls_bytes(raw) + 1);
    return ls_normal(encoded);
}
fun ls_join(parts: List<Str>, separator: Str) -> Str {
    if (len(parts) == 0) { return ""; }
    mut level: List<Str> = parts;
    // Balanced concatenation bounds copied bytes for large semantic-token
    // arrays; the stdlib join repeatedly copies the entire growing result.
    while (len(level) > 1) {
        let next: List<Str> = []; mut i: Int = 0;
        while (i < len(level)) {
            if (i + 1 < len(level)) { push(next, level[i] + separator + level[i + 1]); }
            else { push(next, level[i]); }
            i += 2;
        }
        level = next;
    }
    return level[0];
}
fun ls_uri(path: Str) -> Str {
    let hex: Str = "0123456789ABCDEF";
    let parts: List<Str> = ["file://"]; mut start: Int = 0; mut i: Int = 0;
    while (i < ls_bytes(path)) {
        let c: Int = ls_byte(path, i);
        if (not (ls_ident(c) or c == 47 or c == 45 or c == 46 or c == 126 or c == 58)) {
            push(parts, ls_slice(path, start, i));
            push(parts, "%" + chr(ls_byte(hex, c / 16)) + chr(ls_byte(hex, c % 16))); start = i + 1;
        }
        i += 1;
    }
    push(parts, if (start == 0) { path } else { ls_slice(path, start, ls_bytes(path)) });
    return ls_join(parts, "");
}
