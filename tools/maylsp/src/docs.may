        "docs": "Fold a list from left to right, passing the accumulator and current item to the function.\n\n**Parameters**\n- `xs`: The input list.\n- `f`: A function taking (accumulator, item).\n- `init`: The initial accumulator.\n\n**Returns:** The final accumulator, or `init` for an empty list.\n\n**Example**\n```may\nprint(reduce([1, 2, 3], |acc: Any, x: Any| -> Any { return acc + x; }, 0));\n```",
        "params": [
            "xs",
            "f",
            "init"
        ],
        "parameterDocs": {
            "xs": "The input list.",
            "f": "A function taking (accumulator, item).",
            "init": "The initial accumulator."
        }
    },
    "sum": {
        "signature": "sum(xs)",
        "docs": "Add the numeric values in a list.\n\n**Parameters**\n- `xs`: A list of numbers.\n\n**Returns:** The total; zero for an empty list.\n\n**Example**\n```may\nprint(sum([1, 2, 3])); // 6\n```",
        "params": [
            "xs"
        ],
        "parameterDocs": {
            "xs": "A list of numbers."
        }
    },
    "any": {
        "signature": "any(xs, f)",
        "docs": "Test whether at least one item makes the predicate return `true`. Stop at the first match.\n\n**Parameters**\n- `xs`: The input list.\n- `f`: A predicate returning a boolean.\n\n**Returns:** A boolean; `false` for an empty list.\n\n**Example**\n```may\nprint(any([1, 2, 3], |x: Any| -> Any { return x > 2; }));\n```",
        "params": [
            "xs",
            "f"
        ],
        "parameterDocs": {
            "xs": "The input list.",
            "f": "A predicate returning a boolean."
        }
    },
    "all": {
        "signature": "all(xs, f)",
        "docs": "Test whether every item makes the predicate return `true`. Stop at the first nonmatching item.\n\n**Parameters**\n- `xs`: The input list.\n- `f`: A predicate returning a boolean.\n\n**Returns:** A boolean; `true` for an empty list.\n\n**Example**\n```may\nprint(all([1, 2, 3], |x: Any| -> Any { return x > 0; }));\n```",
        "params": [
            "xs",
            "f"
        ],
        "parameterDocs": {
            "xs": "The input list.",
            "f": "A predicate returning a boolean."
        }
    },
    "min": {
        "signature": "min(a, b)",
        "docs": "Return the lesser of two comparable values.\n\n**Parameters**\n- `a`: The first value.\n- `b`: The second value.\n\n**Returns:** One of the two values.\n\n**Example**\n```may\nprint(min(3, 8)); // 3\n```",
        "params": [
            "a",
            "b"
        ],
        "parameterDocs": {
            "a": "The first value.",
            "b": "The second value."
        }
    },
    "max": {
        "signature": "max(a, b)",
        "docs": "Return the greater of two comparable values.\n\n**Parameters**\n- `a`: The first value.\n- `b`: The second value.\n\n**Returns:** One of the two values.\n\n**Example**\n```may\nprint(max(3, 8)); // 8\n```",
        "params": [
            "a",
            "b"
        ],
        "parameterDocs": {
            "a": "The first value.",
            "b": "The second value."
        }
    },
    "abs": {
        "signature": "abs(x)",
        "docs": "Return the nonnegative magnitude of a number.\n\n**Parameters**\n- `x`: The input number.\n\n**Returns:** A numeric absolute value.\n\n**Example**\n```may\nprint(abs(-4)); // 4\n```",
        "params": [
            "x"
        ],
        "parameterDocs": {
            "x": "The input number."
        }
    },
    "sort": {
        "signature": "sort(xs)",
        "docs": "Return the items in ascending order using the standard comparison function. The input list is preserved.\n\n**Parameters**\n- `xs`: A list of comparable values.\n\n**Returns:** A new sorted list.\n\n**Example**\n```may\nprint(sort([3, 1, 2]));\n```",
        "params": [
            "xs"
        ],
        "parameterDocs": {
            "xs": "A list of comparable values."
        }
    },
    "reverse": {
        "signature": "reverse(xs)",
        "docs": "Build a list with the input items in reverse order.\n\n**Parameters**\n- `xs`: The input list.\n\n**Returns:** A new list.\n\n**Example**\n```may\nprint(reverse([1, 2, 3]));\n```",
        "params": [
            "xs"
        ],
        "parameterDocs": {
            "xs": "The input list."
        }
    },
    "slice": {
        "signature": "slice(xs, start, stop)",
        "docs": "Copy a contiguous section of a list. Bounds are clamped to the list length; the stop index is exclusive.\n\n**Parameters**\n- `xs`: The input list.\n- `start`: The zero-based inclusive starting index.\n- `stop`: The exclusive ending index.\n\n**Returns:** A new list; empty if stop is not greater than start.\n\n**Example**\n```may\nprint(slice([10, 20, 30, 40], 1, 3)); // [20, 30]\n```",
        "params": [
            "xs",
            "start",
            "stop"
        ],
        "parameterDocs": {
            "xs": "The input list.",
            "start": "The zero-based inclusive starting index.",
            "stop": "The exclusive ending index."
        }
    },
    "keys": {
        "signature": "keys(m)",
        "docs": "Collect the keys of a map.\n\n**Parameters**\n- `m`: The input map.\n\n**Returns:** A list of keys.\n\n**Example**\n```may\nprint(keys({\"a\": 1}));\n```",
        "params": [
            "m"
        ],
        "parameterDocs": {
            "m": "The input map."
        }
    },
    "values": {
        "signature": "values(m)",
        "docs": "Collect the values of a map.\n\n**Parameters**\n- `m`: The input map.\n\n**Returns:** A list of values.\n\n**Example**\n```may\nprint(values({\"a\": 1}));\n```",
        "params": [
            "m"
        ],
        "parameterDocs": {
            "m": "The input map."
        }
    },
    "has": {
        "signature": "has(x, key)",
        "docs": "Check for a map key, a matching list item, or a substring within a string.\n\n**Parameters**\n- `x`: The map, list, or string to search.\n- `key`: The key, item, or substring to find.\n\n**Returns:** A boolean.\n\n**Example**\n```may\nprint(has({\"name\": \"Ada\"}, \"name\"));\n```",
        "params": [
            "x",
            "key"
        ],
        "parameterDocs": {
            "x": "The map, list, or string to search.",
            "key": "The key, item, or substring to find."
        }
    },
    "map_get": {
        "signature": "map_get(m, key)",
        "docs": "Look up a map entry without changing the map.\n\n**Parameters**\n- `m`: The input map.\n- `key`: The key to look up.\n\n**Returns:** The stored value, or `nil` if missing.\n\n**Example**\n```may\nprint(map_get({\"a\": 1}, \"a\"));\n```",
        "params": [
            "m",
            "key"
        ],
        "parameterDocs": {
            "m": "The input map.",
            "key": "The key to look up."
        }
    },
    "map_set": {
        "signature": "map_set(m, key, value)",
        "docs": "Insert or replace an entry in the existing map.\n\n**Parameters**\n- `m`: The map to modify.\n- `key`: The key to assign.\n- `value`: The value to store.\n\n**Returns:** The assigned value.\n\n**Example**\n```may\nlet m: Any = {};\nmap_set(m, \"a\", 1);\nprint(m.a);\n```",
        "params": [
            "m",
            "key",
            "value"
        ],
        "parameterDocs": {
            "m": "The map to modify.",
            "key": "The key to assign.",
            "value": "The value to store."
        }
    },
    "remove": {
        "signature": "remove(m, key)",
        "docs": "Copy a map while omitting one key. The original map is preserved.\n\n**Parameters**\n- `m`: The input map.\n- `key`: The key to omit.\n\n**Returns:** A new map.\n\n**Example**\n```may\nlet m: Any = {\"a\": 1, \"b\": 2};\nlet smaller: Any = remove(m, \"a\");\n```",
        "params": [
            "m",
            "key"
        ],
        "parameterDocs": {
            "m": "The input map.",
            "key": "The key to omit."
        }
    },
    "merge": {
        "signature": "merge(a, b)",
        "docs": "Combine two maps into a new map. Entries from the second map replace matching keys from the first.\n\n**Parameters**\n- `a`: The first map.\n- `b`: The second map, which takes precedence.\n\n**Returns:** A new combined map.\n\n**Example**\n```may\nprint(merge({\"a\": 1}, {\"a\": 2, \"b\": 3}));\n```",
        "params": [
            "a",
            "b"
        ],
        "parameterDocs": {
            "a": "The first map.",
            "b": "The second map, which takes precedence."
        }
    },
    "read_file": {
        "signature": "read_file(path)",
        "docs": "Read a file into a string. An I/O failure can be caught with `may` / `otherwise`.\n\n**Parameters**\n- `path`: The filesystem path to read.\n\n**Returns:** The file contents as a string.\n\n**Example**\n```may\nlet text: Any = may { read_file(\"notes.txt\") } otherwise { \"\" };\n```",
        "params": [
            "path"
        ],
        "parameterDocs": {
            "path": "The filesystem path to read."
        }
    },
    "write_file": {
        "signature": "write_file(path, text)",
        "docs": "Write a string to a file, creating it or replacing its existing contents. I/O failures are catchable.\n\n**Parameters**\n- `path`: The filesystem path to write.\n- `text`: The contents to store.\n\n**Returns:** `nil`.\n\n**Example**\n```may\nwrite_file(\"notes.txt\", \"hello\n\");\n```",
        "params": [
            "path",
            "text"
        ],
        "parameterDocs": {
            "path": "The filesystem path to write.",
            "text": "The contents to store."
        }
    },
    "read_dir": {
        "signature": "read_dir(path)",
        "docs": "List names in a directory, excluding `.` and `..`. Names are relative to the supplied directory.\n\n**Parameters**\n- `path`: The directory to inspect.\n\n**Returns:** A list of names; empty if the directory cannot be read.\n\n**Example**\n```may\nprint(read_dir(\".\"));\n```",
        "params": [
            "path"
        ],
        "parameterDocs": {
            "path": "The directory to inspect."
        }
    },
    "file_exists": {
        "signature": "file_exists(path)",
        "docs": "Test whether a filesystem path exists.\n\n**Parameters**\n- `path`: The file or directory path to test.\n\n**Returns:** A boolean.\n\n**Example**\n```may\nprint(file_exists(\"notes.txt\"));\n```",
        "params": [
            "path"
        ],
        "parameterDocs": {
            "path": "The file or directory path to test."
        }
    },
    "json_parse": {
        "signature": "json_parse(s)",
        "docs": "Decode a JSON string into Maylang strings, numbers, booleans, lists, maps, and `nil`.\n\n**Parameters**\n- `s`: The JSON text.\n\n**Returns:** The decoded value.\n\n**Example**\n```may\nlet value: Any = json_parse(\"{\\\"name\\\":\\\"Ada\\\"}\");\nprint(value.name);\n```",
        "params": [
            "s"
        ],
        "parameterDocs": {
            "s": "The JSON text."
        }
    },
    "json_stringify": {
        "signature": "json_stringify(v)",
        "docs": "Encode a value as JSON text. Strings are quoted and escaped; lists and maps are encoded recursively.\n\n**Parameters**\n- `v`: The value to encode.\n\n**Returns:** A JSON string.\n\n**Example**\n```may\nprint(json_stringify({\"name\": \"Ada\", \"ready\": true}));\n```",
        "params": [
            "v"
        ],
        "parameterDocs": {
            "v": "The value to encode."
        }
    },
    "input": {
        "signature": "input(prompt)",
        "docs": "Display a prompt and read one line from standard input. The trailing newline is removed.\n\n**Parameters**\n- `prompt`: The text to display before reading; `nil` suppresses it.\n\n**Returns:** A string, or `nil` at end of input.\n\n**Example**\n```may\nlet name: Any = input(\"Name: \");\n```",
        "params": [
            "prompt"
        ],
        "parameterDocs": {
            "prompt": "The text to display before reading; `nil` suppresses it."
        }
    },
    "read_stdin": {
        "signature": "read_stdin()",
        "docs": "Read standard input until end of file. This waits for EOF, so it is suitable for piped data.\n\n**Returns:** The collected input as a string.\n\n**Example**\n```may\nlet text: Any = read_stdin();\nprint(len(text));\n```",
        "params": [],
        "parameterDocs": {}
    },
    "clock": {
        "signature": "clock()",
        "docs": "Read the wall clock as fractional seconds since the Unix epoch.\n\n**Returns:** A floating-point timestamp.\n\nThis is a wall clock, so clock adjustments can change elapsed-time measurements.\n\n**Example**\n```may\nlet before: Any = clock();\nprint(clock() - before);\n```",
        "params": [],
        "parameterDocs": {}
    },
    "time": {
        "signature": "time()",
        "docs": "Read the current Unix timestamp in milliseconds.\n\n**Returns:** An integer timestamp in milliseconds.\n\n**Example**\n```may\nprint(time());\n```",
        "params": [],
        "parameterDocs": {}
    },
    "sleep": {
        "signature": "sleep(ms)",
        "docs": "Pause the calling thread for a duration measured in milliseconds.\n\n**Parameters**\n- `ms`: The nonnegative duration in milliseconds.\n\n**Returns:** `nil`.\n\n**Example**\n```may\nsleep(100);\n```",
        "params": [
            "ms"
        ],
        "parameterDocs": {
            "ms": "The nonnegative duration in milliseconds."
        }
    },
    "spawn": {
        "signature": "spawn(f)",
        "docs": "Register a zero-argument function as a cooperative fiber. Call `run()` to execute scheduled fibers.\n\n**Parameters**\n- `f`: A zero-argument function to schedule.\n\n**Returns:** A runtime fiber handle.\n\n**Example**\n```may\nspawn(fun() -> Any { return print(\"worker\"); });\nrun();\n```",
        "params": [
            "f"
        ],
        "parameterDocs": {
            "f": "A zero-argument function to schedule."
        }
    },
    "yield": {
        "signature": "yield()",
        "docs": "Suspend the current cooperative fiber so another scheduled fiber can run. Outside a fiber it has no scheduling effect.\n\n**Returns:** A runtime scheduling result.\n\n**Example**\n```may\nspawn(fun() -> Any { print(\"first\"); yield(); return print(\"again\"); });\nrun();\n```",
        "params": [],
        "parameterDocs": {}
    },
    "run": {
        "signature": "run()",
        "docs": "Execute scheduled cooperative fibers until they finish. Fibers yield explicitly with `yield()`.\n\n**Returns:** A runtime scheduling result.\n\n**Example**\n```may\nspawn(fun() -> Any { return print(\"hello\"); });\nrun();\n```",
        "params": [],
        "parameterDocs": {}
    },
    "fail": {
        "signature": "fail(message)",
        "docs": "Raise a runtime failure. A surrounding `may` block can catch it and access `err.message`.\n\n**Parameters**\n- `message`: The failure description.\n\n**Returns:** Does not return normally.\n\n**Example**\n```may\nmay { fail(\"bad input\"); } otherwise { print(err.message); };\n```",
        "params": [
            "message"
        ],
        "parameterDocs": {
            "message": "The failure description."
        }
    },
    "exit": {
        "signature": "exit(status)",
        "docs": "Terminate the process with an exit status. Zero conventionally indicates success.\n\n**Parameters**\n- `status`: The process exit code.\n\n**Returns:** Does not return.\n\n**Example**\n```may\nexit(0);\n```",
        "params": [
            "status"
        ],
        "parameterDocs": {
            "status": "The process exit code."
        }
    },
    "syscall": {
        "signature": "syscall(number, arguments...)",
        "docs": "Invoke a Linux system call directly, with up to six integer arguments. This bypasses normal file and memory helpers.\n\n**Parameters**\n- `number`: The Linux x86-64 syscall number.\n- `arguments...`: Raw integer arguments in syscall order.\n\n**Returns:** The raw integer result; failures usually return a negative errno.\n\n**Example**\n```may\nlet pid: Any = syscall(39); // Linux getpid\n```",
        "params": [
            "number",
            "arguments..."
        ],
        "parameterDocs": {
            "number": "The Linux x86-64 syscall number.",
            "arguments...": "Raw integer arguments in syscall order."
        }
    },
    "addr": {
        "signature": "addr(s)",
        "docs": "Return the address of a string’s UTF-8 bytes. Keep the string alive while using the address.\n\n**Parameters**\n- `s`: The string whose byte storage is addressed.\n\n**Returns:** An integer address.\n\n**Example**\n```may\nlet s: Any = \"abc\";\nprint(load8(addr(s))); // 97\n```",
        "params": [
            "s"
        ],
        "parameterDocs": {
            "s": "The string whose byte storage is addressed."
        }
    },
    "cstr": {
        "signature": "cstr(s)",
        "docs": "Create a NUL-terminated representation of a string for a native API.\n\n**Parameters**\n- `s`: The string to pass to native code.\n\n**Returns:** An integer address to NUL-terminated bytes.\n\n**Example**\n```may\nlet path: Any = cstr(\"notes.txt\");\n```",
        "params": [
            "s"
        ],
        "parameterDocs": {
            "s": "The string to pass to native code."
        }
    },
    "load8": {
        "signature": "load8(p)",
        "docs": "Read 8 bits from a raw memory address. This operation performs no bounds or lifetime checks.\n\n**Parameters**\n- `p`: A valid readable address with enough remaining bytes.\n\n**Returns:** The loaded integer value.\n\n**Example**\n```may\nlet s: Any = \"abcdefgh\";\nlet value: Any = load8(addr(s));\n```",
        "params": [
            "p"
        ],
        "parameterDocs": {
            "p": "A valid readable address with enough remaining bytes."
        }
    },
    "store8": {
        "signature": "store8(p, value)",
        "docs": "Write 8 bits to a raw memory address. This operation performs no bounds or lifetime checks.\n\n**Parameters**\n- `p`: A valid writable address with enough remaining bytes.\n- `value`: The integer bits to write.\n\n**Returns:** A raw runtime result.\n\n**Example**\n```may\n// p must refer to writable allocated memory.\nstore8(p, 0);\n```",
        "params": [
            "p",
            "value"
        ],
        "parameterDocs": {
            "p": "A valid writable address with enough remaining bytes.",
            "value": "The integer bits to write."
        }
    },
    "load16": {
        "signature": "load16(p)",
        "docs": "Read 16 bits from a raw memory address. This operation performs no bounds or lifetime checks.\n\n**Parameters**\n- `p`: A valid readable address with enough remaining bytes.\n\n**Returns:** The loaded integer value.\n\n**Example**\n```may\nlet s: Any = \"abcdefgh\";\nlet value: Any = load16(addr(s));\n```",
        "params": [
            "p"
        ],
        "parameterDocs": {
            "p": "A valid readable address with enough remaining bytes."
        }
    },
    "store16": {
        "signature": "store16(p, value)",
        "docs": "Write 16 bits to a raw memory address. This operation performs no bounds or lifetime checks.\n\n**Parameters**\n- `p`: A valid writable address with enough remaining bytes.\n- `value`: The integer bits to write.\n\n**Returns:** A raw runtime result.\n\n**Example**\n```may\n// p must refer to writable allocated memory.\nstore16(p, 0);\n```",
        "params": [
            "p",
            "value"
        ],
        "parameterDocs": {
            "p": "A valid writable address with enough remaining bytes.",
            "value": "The integer bits to write."
        }
    },
    "load32": {
        "signature": "load32(p)",
        "docs": "Read 32 bits from a raw memory address. This operation performs no bounds or lifetime checks.\n\n**Parameters**\n- `p`: A valid readable address with enough remaining bytes.\n\n**Returns:** The loaded integer value.\n\n**Example**\n```may\nlet s: Any = \"abcdefgh\";\nlet value: Any = load32(addr(s));\n```",
        "params": [
            "p"
        ],
        "parameterDocs": {
            "p": "A valid readable address with enough remaining bytes."
        }
    },
    "store32": {
        "signature": "store32(p, value)",
        "docs": "Write 32 bits to a raw memory address. This operation performs no bounds or lifetime checks.\n\n**Parameters**\n- `p`: A valid writable address with enough remaining bytes.\n- `value`: The integer bits to write.\n\n**Returns:** A raw runtime result.\n\n**Example**\n```may\n// p must refer to writable allocated memory.\nstore32(p, 0);\n```",
        "params": [
            "p",
            "value"
        ],
        "parameterDocs": {
            "p": "A valid writable address with enough remaining bytes.",
            "value": "The integer bits to write."
        }
    },
    "load64": {
        "signature": "load64(p)",
        "docs": "Read 64 bits from a raw memory address. This operation performs no bounds or lifetime checks.\n\n**Parameters**\n- `p`: A valid readable address with enough remaining bytes.\n\n**Returns:** The loaded integer value.\n\n**Example**\n```may\nlet s: Any = \"abcdefgh\";\nlet value: Any = load64(addr(s));\n```",
        "params": [
            "p"
        ],
        "parameterDocs": {
            "p": "A valid readable address with enough remaining bytes."
        }
    },
    "store64": {
        "signature": "store64(p, value)",
        "docs": "Write 64 bits to a raw memory address. This operation performs no bounds or lifetime checks.\n\n**Parameters**\n- `p`: A valid writable address with enough remaining bytes.\n- `value`: The integer bits to write.\n\n**Returns:** A raw runtime result.\n\n**Example**\n```may\n// p must refer to writable allocated memory.\nstore64(p, 0);\n```",
        "params": [
            "p",
            "value"
        ],
        "parameterDocs": {
            "p": "A valid writable address with enough remaining bytes.",
            "value": "The integer bits to write."
        }
    },
    "ccall": {
        "signature": "ccall(fn, args)",
        "docs": "Call machine code at a raw address with up to six integer arguments using the native calling convention.\n\n**Parameters**\n- `fn`: The native function address.\n- `args`: A list of at most six integer arguments.\n\n**Returns:** The native integer return value.\n\n**Example**\n```may\n// fn must be a valid native function address.\nlet result: Any = ccall(fn, [1, 2]);\n```",
        "params": [
            "fn",
            "args"
        ],
        "parameterDocs": {
            "fn": "The native function address.",
            "args": "A list of at most six integer arguments."
        }
    },
    "extern_c": {
        "signature": "extern_c(fn)",
        "docs": "Wrap a native function address as a callable Maylang function accepting six integer arguments.\n\n**Parameters**\n- `fn`: The native function address.\n\n**Returns:** A callable wrapper.\n\n**Example**\n```may\n// fn must be a valid native function address.\nlet call: Any = extern_c(fn);\nlet result: Any = call(1, 2, 0, 0, 0, 0);\n```",
        "params": [
            "fn"
        ],
        "parameterDocs": {
            "fn": "The native function address."
        }
    },
    "sqrt": {
        "signature": "sqrt(x)",
        "docs": "Compute a number’s square root.\n\n**Parameters**\n- `x`: The number to evaluate; trigonometric angles use radians.\n\n**Returns:** A floating-point result.\n\n**Example**\n```may\nprint(sqrt(9.0));\n```",
        "params": [
            "x"
        ],
        "parameterDocs": {
            "x": "The number to evaluate; trigonometric angles use radians."
        }
    },
    "floor": {
        "signature": "floor(x)",
        "docs": "Round a number down to an integer-valued numeric result.\n\n**Parameters**\n- `x`: The number to evaluate; trigonometric angles use radians.\n\n**Returns:** The rounded value.\n\n**Example**\n```may\nprint(floor(2.9));\n```",
        "params": [
            "x"
        ],
        "parameterDocs": {
            "x": "The number to evaluate; trigonometric angles use radians."
        }
    },
    "ceil": {
        "signature": "ceil(x)",
        "docs": "Round a number up to an integer-valued numeric result.\n\n**Parameters**\n- `x`: The number to evaluate; trigonometric angles use radians.\n\n**Returns:** The rounded value.\n\n**Example**\n```may\nprint(ceil(2.1));\n```",
        "params": [
            "x"
        ],
        "parameterDocs": {
            "x": "The number to evaluate; trigonometric angles use radians."
        }
    },
    "sin": {
        "signature": "sin(x)",
        "docs": "Compute the sine of an angle in radians.\n\n**Parameters**\n- `x`: The number to evaluate; trigonometric angles use radians.\n\n**Returns:** A floating-point result.\n\n**Example**\n```may\nprint(sin(0.0));\n```",
        "params": [
            "x"
        ],
        "parameterDocs": {
            "x": "The number to evaluate; trigonometric angles use radians."
        }
    },
