import "../../shared/format.may" as formatting;
import "text.may";
import "index.may";
import "protocol.may";
import "docs.may";
/// A pending document-symbol node: where it ends and the children it collects.
struct SymbolFrame { end: Int, children: List<Map<Str, Any>> }
/// An indexed workspace symbol: its spelling, lowercase form and declaration.
struct WorkspaceSymbol { name: Str, lower: Str, kind: Int, definition: Def }
/// One incoming/outgoing call group before it is serialized as JSON.
struct CallGroup { target: Map<Str, Any>, ranges: List<Range> }
mut LS_WORKSPACE_SYMBOL_EPOCH: Int = -1;
mut LS_WORKSPACE_SYMBOL_INDEX: List<WorkspaceSymbol> = [];
mut LS_WORKSPACE_SYMBOL_DOC_COUNT: Int = -1;
fun ls_doc_param(p: Any) -> Doc {
    if (value_tag(p) != 7 or value_tag(p.textDocument) != 7 or value_tag(p.textDocument.uri) != 1) { fail("textDocument.uri is required"); }
    let doc: Optional<Doc> = ls_document(str(p.textDocument.uri));
    if (doc == nil) { fail("document not found"); }
    return doc;
}
fun ls_target(doc: Doc, p: Any) -> Optional<Def> { return ls_resolve(doc, ls_token_index(doc, p.position)); }
// Render the standard doc comment sections (docs/guide/DOCSTRINGS.md) like
// the generated catalog entries; fenced code passes through unchanged.
fun ls_render_docs(text: Str) -> Str {
    let out: List<Str> = []; mut fenced: Bool = false;
    for line: Str in ls_split(text, "\n") {
        mut shown: Str = line;
        if (ls_starts(ls_trim(line), "```")) { fenced = not fenced; }
        else if (not fenced) {
            if (line == "Params:") { shown = "**Parameters**"; }
            else if (line == "Example:") { shown = "**Example**"; }
            else {
                for section: Str in ["Returns:", "Faults:"] {
                    if (ls_starts(line, section)) { shown = "**" + section + "**" + ls_slice(line, ls_bytes(section), ls_bytes(line)); }
                }
            }
        }
        push(out, shown);
    }
    return join(out, "\n");
}
fun ls_definition_docs(d: Def) -> Str {
    if (d.docs != "") { return ls_render_docs(d.docs); }
    if (has(ls_builtin_uris(), d.uri)) {
        let entry: Any = LS_REFERENCE[d.name];
        if (entry != nil) { return str(entry.docs); }
    }
    return "";
}
fun ls_parameter_docs(d: Def, entry: Any, parameter: Str, index: Int) -> Str {
    if (d.docs != "") {
        // Signature labels carry annotations ("factor: Int"); docs name the parameter.
        let colon: Int = ls_find(parameter, ":");
        let name: Str = if (colon >= 0) { ls_trim(ls_slice(parameter, 0, colon)) } else { parameter };
        let prefix: Str = "@param " + parameter; let item: Str = "- `" + name + "`: ";
        let lines: List<Str> = ls_split(d.docs, "\n");
        for i: Int in 0..len(lines) {
            let line: Str = lines[i]; let text: Str = ls_trim(line);
            if (ls_starts(line, item)) {
                // A Params: item continues on following lines indented by two spaces.
                mut found: Str = ls_trim(ls_slice(line, ls_bytes(item), ls_bytes(line))); mut next: Int = i + 1;
                while (next < len(lines) and ls_starts(lines[next], "  ") and ls_trim(lines[next]) != "") { found = found + " " + ls_trim(lines[next]); next += 1; }
                return found;
            }
            if (ls_starts(text, prefix)) {
                mut at: Int = ls_bytes(prefix);
                if (ls_byte(text, at) == 58) { at += 1; }
                if (has([32, 9], ls_byte(text, at))) { return ls_trim(ls_slice(text, at, ls_bytes(text))); }
            }
        }
    }
    if (entry != nil and index < len(entry.params) and has(entry.parameterDocs, entry.params[index])) { return str(entry.parameterDocs[entry.params[index]]); }
    return "";
}
fun ls_reference_for(doc: Doc, i: Int, d: Optional<Def>) -> Any {
    if (i < 0) { return nil; }
    let t: Token = doc.tokens[i]; let entry: Any = LS_REFERENCE[t.name];
    if (entry == nil) { return nil; }
    if (d != nil) {
        if (has(ls_builtin_uris(), d.uri)) { return entry; }
        return nil;
    }
    if (t.kind == "identifier") {
        if (i > 0 and has([".", "?."], doc.tokens[i - 1].name)) { return nil; }
        if (ls_at(doc.tokens, i + 1) == ":" and has(["{" , ","], ls_at(doc.tokens, i - 1))) { return nil; }
        // An ambiguous imported name is not a reference to a runtime builtin.
        for imp: Import in doc.imports {
            if (imp.plain and (len(imp.selected) == 0 or has(imp.selected, t.name))) {
                let module: Optional<Doc> = ls_import_doc(doc, imp);
                if (module != nil) {
                    let exported: Optional<Def> = ls_export(module, t.name);
                    if (exported != nil) { return nil; }
                }
            }
        }
    }
    return entry;
}
fun ls_hover(doc: Doc, p: Any) -> Optional<Map<Str, Any>> {
    let i: Int = ls_token_index(doc, p.position); if (i < 0) { return nil; }
    let t: Token = doc.tokens[i]; let d: Optional<Def> = ls_resolve(doc, i); let entry: Any = ls_reference_for(doc, i, d);
    if (d == nil and entry == nil) { return nil; }
    let signature: Str = if (d != nil) { d.signature } else { str(entry.signature) };
    let prose: Str = if (d != nil) { ls_definition_docs(d) } else { str(entry.docs) };
    let origin: Str = if (d != nil) { "\n\n[Go to definition](" + d.uri + ")" } else { "" };
    return {"contents": {"kind": "markdown", "value": "```may\n" + signature + "\n```\n\n" + prose + origin}, "range": ls_range(doc.text, t.a, t.b)};
}
fun ls_completion_item(d: Def) -> Map<Str, Any> {
    return {"label": d.name, "kind": if (d.kind == 12) { 3 } else if (d.kind == 23) { 22 } else if (d.kind == 14) { 21 } else { 6 }, "detail": d.signature, "documentation": {"kind": "markdown", "value": ls_definition_docs(d)}, "data": d.id};
}
fun ls_reference_item(name: Str, kind: Int) -> Map<Str, Any> {
    let entry: Any = LS_REFERENCE[name];
    return {"label": name, "kind": kind, "detail": str(entry?.signature ?? name), "documentation": {"kind": "markdown", "value": str(entry?.docs ?? "")}};
}
fun ls_complete(doc: Doc, p: Any) -> Map<Str, Any> {
    let offset: Int = ls_offset(doc.text, p.position); let items: List<Map<Str, Any>> = []; let seen: Map<Str, Bool> = {}; mut scope: Int = 0;
    for i: Int in 0..len(doc.scopes) { if (doc.scopes[i].a <= offset and offset < doc.scopes[i].b) { scope = i; } }
    mut prefixStart: Int = offset;
    while (prefixStart > 0 and ls_ident(ls_byte(doc.text, prefixStart - 1))) { prefixStart -= 1; }
    let prefix: Str = ls_slice(doc.text, prefixStart, offset);
    mut qualified: Str = "";
    if (prefixStart > 0 and ls_byte(doc.text, prefixStart - 1) == 46) {
        mut start: Int = prefixStart - 1;
        while (start > 0 and ls_ident(ls_byte(doc.text, start - 1))) { start -= 1; }
        qualified = ls_slice(doc.text, start, prefixStart - 1);
    }
    let candidates: List<Def> = [];
    if (qualified == "") {
        // Inner scopes win when names shadow one another.
        mut current: Int = scope;
        while (current >= 0) {
            for d: Def in reverse(doc.defs) { if (d.scope == current and (d.a <= offset or d.kind == 12 or d.scope == 0 or ls_starts(d.signature, "parameter "))) { push(candidates, d); } }
            current = doc.scopes[current].parent;
        }
    } else {
        let token: Token = ls_token("", "", offset, offset, scope);
        for member: Def in ls_members(doc, qualified, token) { push(candidates, member); }
    }
    for imp: Import in doc.imports {
        if ((qualified == "" and (imp.plain or len(imp.selected) > 0)) or (imp.alias == qualified and ls_local(doc, qualified, ls_token("", "", offset, offset, scope)) == nil)) {
            let imported: Optional<Doc> = ls_import_doc(doc, imp);
            if (imported != nil) {
                for d: Def in imported.defs {
                    if (d.scope == 0 and (not imported.explicit or d.public) and (qualified != "" or (imp.plain and (len(imp.selected) == 0 or has(imp.selected, d.name))))) { push(candidates, d); }
                }
            }
        }
    }
    if (qualified == "") {
        for name: Str in ["native.may", "prelude.may"] {
            let builtin: Optional<Doc> = ls_document(ls_uri(LS_STDLIB + "/" + name));
            if (builtin != nil) { for d: Def in builtin.defs { if (d.scope == 0 and not ls_starts(d.name, "__")) { push(candidates, d); } } }
        }
    }
    for d: Def in candidates {
        if (ls_starts(d.name, prefix) and not has(seen, d.name)) { push(items, ls_completion_item(d)); seen[d.name] = true; }
    }
    if (qualified == "") {
        for name: Str in LS_KEYWORDS {
            if (ls_starts(name, prefix) and not has(seen, name)) { push(items, ls_reference_item(name, 14)); seen[name] = true; }
        }
        for name: Str in LS_BUILTINS {
            if (ls_starts(name, prefix) and not has(seen, name)) { push(items, ls_reference_item(name, 3)); seen[name] = true; }
        }
        for name: Str in LS_TYPES {
            if (ls_starts(name, prefix) and not has(seen, name)) { push(items, ls_reference_item(name, 22)); seen[name] = true; }
        }
    }
    for item: Map<Str, Any> in items { item.textEdit = {"range": ls_range(doc.text, prefixStart, offset), "newText": item.label}; }
    return {"isIncomplete": false, "items": items};
}
fun ls_signature(doc: Doc, p: Any) -> Optional<Map<Str, Any>> {
    let offset: Int = ls_offset(doc.text, p.position); let ts: List<Token> = doc.tokens; let stack: List<Int> = [];
    for i: Int in 0..len(ts) {
        if (ts[i].a >= offset) { break; }
        if (ts[i].name == "(") { push(stack, i); }
        else if (ts[i].name == ")" and len(stack) > 0) { pop(stack); }
    }
    if (len(stack) == 0) { return nil; }
    let open: Int = stack[len(stack) - 1];
    if (open == 0) { return nil; }
    let resolved: Optional<Def> = ls_resolve(doc, open - 1); let entry: Any = ls_reference_for(doc, open - 1, resolved);
    if (resolved == nil) {
        if (entry == nil or not ls_contains(str(entry.signature), "(")) { return nil; }
        let label: Str = ts[open - 1].name;
        let synthetic: Def = Def("", "", label, 12, -1, -1, -1, -1, -1, str(entry.signature), ls_params_of(entry), false, str(entry.docs), "Any", [], false, "", -1, -1, "", [], "Any", -1);
        return ls_signature_result(synthetic, entry, open, offset, ts);
    }
    if (resolved.kind != 12) { return nil; }
    return ls_signature_result(resolved, entry, open, offset, ts);
}
// Read a catalog entry's parameter labels as typed strings.
fun ls_params_of(entry: Any) -> List<Str> {
    let out: List<Str> = [];
    if (entry == nil) { return out; }
    for param: Any in entry.params { push(out, str(param)); }
    return out;
}
fun ls_signature_result(d: Def, entry: Any, open: Int, offset: Int, ts: List<Token>) -> Map<Str, Any> {
    mut active: Int = 0; mut i: Int = open + 1;
    while (i < len(ts) and ts[i].a < offset) {
        if (ts[i].pair > i and ts[ts[i].pair].a < offset) { i = ts[i].pair; }
        else if (ts[i].name == ",") { active += 1; }
        i += 1;
    }
    let params: List<Map<Str, Any>> = [];
    for index: Int in 0..len(d.params) {
        let param: Str = d.params[index]; let item: Map<Str, Any> = {"label": param};
        let parameterDocs: Str = ls_parameter_docs(d, entry, param, index);
        if (parameterDocs != "") { item.documentation = {"kind": "markdown", "value": parameterDocs}; }
        push(params, item);
    }
    return {"signatures": [{"label": d.signature, "documentation": {"kind": "markdown", "value": ls_definition_docs(d)}, "parameters": params}], "activeSignature": 0, "activeParameter": min(active, max(0, len(params) - 1))};
}
fun ls_symbols(doc: Doc) -> List<Map<Str, Any>> {
    let out: List<Map<Str, Any>> = []; let parents: List<SymbolFrame> = [];
    for d: Def in doc.defs {
        if (ls_starts(d.signature, "parameter ") or ls_starts(d.signature, "loop variable ")) { continue; }
        let children: List<Map<Str, Any>> = [];
        let sym: Map<Str, Any> = {"name": d.name, "kind": d.kind, "detail": d.signature, "range": ls_range(doc.text, d.start, d.end), "selectionRange": ls_range(doc.text, d.a, d.b), "children": children};
        while (len(parents) > 0 and parents[len(parents) - 1].end <= d.start) { pop(parents); }
        if (len(parents) > 0 and d.end <= parents[len(parents) - 1].end) { push(parents[len(parents) - 1].children, sym); }
        else { push(out, sym); }
        if (d.kind == 12 or d.kind == 23 or d.kind == 10) { push(parents, SymbolFrame(d.end, children)); }
    }
    return out;
}
fun ls_workspace_symbols(query: Str) -> List<Map<Str, Any>> {
    ls_workspace(); let out: List<Map<Str, Any>> = []; let lowered: Str = ls_lower(query); let queryLength: Int = ls_bytes(query);
    let documentCount: Int = len(keys(LS_DOCS));
    if (LS_WORKSPACE_SYMBOL_EPOCH != LS_INDEX_EPOCH or LS_WORKSPACE_SYMBOL_DOC_COUNT != documentCount) {
        LS_WORKSPACE_SYMBOL_INDEX = [];
        for uri: Str in keys(LS_DOCS) {
            let indexed: Optional<Doc> = LS_DOCS[uri];
            if (indexed != nil) {
                for d: Def in indexed.defs {
                    if (d.scope == 0) { push(LS_WORKSPACE_SYMBOL_INDEX, WorkspaceSymbol(d.name, ls_lower(d.name), d.kind, d)); }
                }
            }
        }
        LS_WORKSPACE_SYMBOL_EPOCH = LS_INDEX_EPOCH;
        LS_WORKSPACE_SYMBOL_DOC_COUNT = documentCount;
    }
    for item: WorkspaceSymbol in LS_WORKSPACE_SYMBOL_INDEX {
        if (ls_bytes(item.name) >= queryLength and ls_contains(item.lower, lowered)) { push(out, {"name": item.name, "kind": item.kind, "location": ls_location(item.definition)}); }
    }
    return out;
}
fun ls_prepare_rename(doc: Doc, p: Any) -> Optional<Map<Str, Any>> {
    let i: Int = ls_token_index(doc, p.position); let d: Optional<Def> = ls_resolve(doc, i);
    if (d == nil or ls_starts(d.uri, ls_uri(LS_STDLIB) + "/")) { return nil; }
    return {"range": ls_range(doc.text, doc.tokens[i].a, doc.tokens[i].b), "placeholder": d.name};
}
fun ls_rename_target(doc: Doc, p: Any) -> Def {
    if (value_tag(p.newName) != 1 or not ls_valid_name(str(p.newName))) { fail("newName must be a non-reserved Maylang identifier"); }
    let target: Optional<Def> = ls_target(doc, p);
    if (target == nil or ls_prepare_rename(doc, p) == nil) { fail("symbol cannot be renamed"); }
    let declaring: Optional<Doc> = ls_document(target.uri);
    if (declaring == nil) { fail("document not found"); }
    for d: Def in declaring.defs { if (d.scope == target.scope and d.name == str(p.newName) and d.id != target.id) { fail("name already declared in this scope"); } }
    return target;
}
fun ls_rename_edit(using: Doc, target: Def, occurrence: Occurrence, newName: Str) -> Map<Str, Any> {
    let at: Int = ls_token_index(using, occurrence.range.start);
    if (at >= 0 and (at == 0 or not has([".", "?."], ls_at(using.tokens, at - 1)))) {
        let collision: Optional<Def> = ls_local(using, newName, using.tokens[at]);
        if (collision != nil and collision.id != target.id) { fail("rename would capture an existing binding"); }
    }
    return {"range": occurrence.range, "newText": newName};
}
fun ls_rename(doc: Doc, p: Any) -> Map<Str, Any> {
    let target: Def = ls_rename_target(doc, p);
    let changes: Map<Str, List<Map<Str, Any>>> = {};
    for occurrence: Occurrence in ls_occurrences(target, true) {
        let uri: Str = occurrence.uri;
        let using: Optional<Doc> = ls_document(uri);
        if (using == nil) { continue; }
        if (not has(changes, uri)) { changes[uri] = []; }
        let edits: Optional<List<Map<Str, Any>>> = changes[uri];
        if (edits != nil) { push(edits, ls_rename_edit(using, target, occurrence, str(p.newName))); }
    }
    return {"changes": changes};
}
fun ls_folding(doc: Doc) -> List<Map<Str, Any>> {
    let out: List<Map<Str, Any>> = [];
    for t: Token in doc.tokens {
        if (has(["{", "[", "("], t.name) and t.pair >= 0) {
            let a: Position = ls_position(doc.text, t.a); let b: Position = ls_position(doc.text, doc.tokens[t.pair].a);
            if (b.line > a.line) { push(out, {"startLine": a.line, "startCharacter": a.character, "endLine": b.line, "endCharacter": b.character, "kind": "region"}); }
        }
    }
    mut start: Int = -1; mut last: Int = -1;
    for t: Token in doc.comments {
        let line: Int = ls_position(doc.text, t.a).line;
        if (line != last + 1) { if (last > start and start >= 0) { push(out, {"startLine": start, "endLine": last, "kind": "comment"}); } start = line; }
        last = line;
    }
    if (last > start and start >= 0) { push(out, {"startLine": start, "endLine": last, "kind": "comment"}); }
    return out;
}
fun ls_selection(doc: Doc, positions: Any) -> List<Map<Str, Any>> {
    let out: List<Map<Str, Any>> = [];
    for p: Any in positions {
        let offset: Int = ls_offset(doc.text, p); let i: Int = ls_token_index(doc, p);
        mut parent: Map<Str, Any> = {"range": ls_range(doc.text, 0, ls_bytes(doc.text))};
        let widths: List<Int> = []; let scopes: Map<Str, Scope> = {};
        for index: Int in 1..len(doc.scopes) {
            let scope: Scope = doc.scopes[index];
            if (scope.a <= offset and offset <= scope.b) {
                let width: Int = scope.b - scope.a;
                if (not has(scopes, str(width))) { push(widths, width); scopes[str(width)] = scope; }
            }
        }
        for width: Int in reverse(sort(widths)) {
            let chosen: Optional<Scope> = scopes[str(width)];
            if (chosen != nil) { parent = {"range": ls_range(doc.text, chosen.a, chosen.b), "parent": parent}; }
        }
        if (i >= 0) { parent = {"range": ls_range(doc.text, doc.tokens[i].a, doc.tokens[i].b), "parent": parent}; }
        else { parent = {"range": {"start": p, "end": p}, "parent": parent}; }
        push(out, parent);
    }
    return out;
}
fun ls_links(doc: Doc) -> List<Map<Str, Any>> {
    let out: List<Map<Str, Any>> = [];
    for imp: Import in doc.imports {
        let target: Optional<Doc> = ls_import_doc(doc, imp);
        if (target != nil) { push(out, {"range": ls_range(doc.text, imp.a + 1, imp.b - 1), "target": target.uri}); }
    }
    return out;
}
fun ls_inlay(doc: Doc, p: Any) -> List<Map<Str, Any>> {
    let out: List<Map<Str, Any>> = []; let a: Int = ls_offset(doc.text, p.range.start); let b: Int = ls_offset(doc.text, p.range.end);
    for d: Def in doc.defs {
        if (not d.hasAnnotation and (ls_starts(d.signature, "let ") or ls_starts(d.signature, "mut ")) and d.b >= a and d.b <= b) {
            let type: Str = ls_binding_type(doc, d, 0);
            if (type != "Any") { push(out, {"position": ls_position(doc.text, d.b), "label": ": " + type, "kind": 1, "paddingLeft": false}); }
        }
    }
    return out;
}
mut LS_SEMANTIC_ID: Int = 0;
fun ls_semantic(doc: Doc, requested: Any) -> Map<Str, Any> {
    let cache: Optional<Map<Str, Any>> = doc.semanticCache;
    if (requested == nil and doc.semanticEpoch == LS_INDEX_EPOCH and cache != nil) { return cache; }
    let tokens: List<Map<Str, Any>> = [];
    mut comment: Int = 0;
    for i: Int in 0..len(doc.tokens) {
        let t: Token = doc.tokens[i]; mut type: Int = -1; mut modifiers: Int = 0;
        while (comment < len(doc.comments) and doc.comments[comment].a < t.a) {
            let c: Token = doc.comments[comment]; push(tokens, {"a": c.a, "b": c.b, "type": 3, "modifiers": 0}); comment += 1;
        }
        if (t.kind == "keyword") { type = 0; }
        else if (t.kind == "string") { type = 1; }
        else if (t.kind == "number") { type = 2; }
        else if (t.kind == "identifier") {
            let d: Optional<Def> = ls_resolve(doc, i); type = 5;
            if (d != nil) {
                if (d.kind == 12) { type = 4; }
                else if (d.kind == 23 or d.kind == 10) { type = 7; }
                else if (ls_starts(d.signature, "parameter ")) { type = 6; }
                if (has(doc.declared, str(t.a))) { modifiers = 1; }
                if (d.kind == 14) { modifiers += 2; }
            } else if (has(LS_BUILTINS, t.name) and ls_at(doc.tokens, i + 1) == "(") { type = 4; }
            let firstByte: Int = ls_byte(t.name, 0);
            if (has(LS_TYPES, t.name) or (firstByte >= 65 and firstByte <= 90)) { type = 7; }
        } else if (has(["+", "-", "*", "/", "%", "=", "<", ">", "!", "?", "|", "&", "||", "&&", "|>", "=>", "->", "??", "?.", "..", "..=", "==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "**"], t.name)) { type = 8; }
        if (type >= 0) { push(tokens, {"a": t.a, "b": t.b, "type": type, "modifiers": modifiers}); }
    }
    while (comment < len(doc.comments)) {
        let c: Token = doc.comments[comment]; push(tokens, {"a": c.a, "b": c.b, "type": 3, "modifiers": 0}); comment += 1;
    }
    let data: List<Int> = []; mut previousLine: Int = 0; mut previousChar: Int = 0;
    let a: Int = if (requested == nil) { 0 } else { ls_offset(doc.text, requested.start) };
    let b: Int = if (requested == nil) { ls_bytes(doc.text) } else { ls_offset(doc.text, requested.end) };
    for t: Map<Str, Any> in tokens {
        mut start: Int = max(a, int(t.a)); let end: Int = min(b, int(t.b));
        while (start < end) {
            mut stop: Int = start;
            while (stop < end and ls_byte(doc.text, stop) != 10 and ls_byte(doc.text, stop) != 13) { stop += ls_width(ls_byte(doc.text, stop)); }
            if (stop > start) {
                let p: Position = ls_position(doc.text, start); let q: Position = ls_position(doc.text, stop);
                push(data, p.line - previousLine); push(data, if (p.line == previousLine) { p.character - previousChar } else { p.character });
                push(data, q.character - p.character); push(data, int(t.type)); push(data, int(t.modifiers));
                previousLine = p.line; previousChar = p.character;
            }
            start = stop + 1;
        }
    }
    let result: Map<Str, Any> = {"data": data};
    if (requested == nil) {
        LS_SEMANTIC_ID += 1; result.resultId = str(LS_SEMANTIC_ID);
        let history: List<Map<Str, Any>> = doc.semanticHistory;
        doc.semanticHistory = if (len(history) > 0) { [history[len(history) - 1], result] } else { [result] };
        doc.semanticCache = result; doc.semanticEpoch = LS_INDEX_EPOCH;
    }
    return result;
}
// Read a semantic-token data array out of a cached JSON snapshot.
fun ls_int_list(value: Any) -> List<Int> {
    let out: List<Int> = [];
    if (value == nil) { return out; }
    for item: Any in value { push(out, int(item)); }
    return out;
}
fun ls_semantic_delta(doc: Doc, previous: Any) -> Map<Str, Any> {
    if (value_tag(previous) != 1) { fail("previousResultId must be a string"); }
    mut before: List<Int> = []; mut found: Bool = false;
    for snapshot: Map<Str, Any> in doc.semanticHistory {
        if (snapshot.resultId == previous) { before = ls_int_list(snapshot.data); found = true; }
    }
    let current: Map<Str, Any> = ls_semantic(doc, nil);
    if (not found) { return current; }
    let after: List<Int> = ls_int_list(current.data); mut start: Int = 0;
    while (start < len(before) and start < len(after) and before[start] == after[start]) { start += 1; }
    mut oldEnd: Int = len(before); mut newEnd: Int = len(after);
    while (oldEnd > start and newEnd > start and before[oldEnd - 1] == after[newEnd - 1]) { oldEnd -= 1; newEnd -= 1; }
    let edits: List<Map<Str, Any>> = [];
    if (oldEnd != start or newEnd != start) {
        push(edits, {"start": start, "deleteCount": oldEnd - start, "data": slice(after, start, newEnd)});
    }
    return {"resultId": current.resultId, "edits": edits};
}
fun ls_format(doc: Doc, options: Any) -> Str {
    let size: Any = options.tabSize ?? 4;
    let spaces: Any = options.insertSpaces ?? true;
    if (value_tag(size) != 0 or size < 1 or size > 16) { fail("tabSize must be between 1 and 16"); }
    if (value_tag(spaces) != 3 and value_tag(spaces) != 4) { fail("insertSpaces must be a boolean"); }
    return formatting.format_source(str(doc.text), int(size), bool(spaces));
}
fun ls_format_edits(doc: Doc, p: Any) -> List<Map<Str, Any>> {
    let formatted: Str = ls_format(doc, p.options ?? ({}));
    if (formatted == doc.text) { return []; }
    return [{"range": ls_range(doc.text, 0, ls_bytes(doc.text)), "newText": formatted}];
}
fun ls_actions(doc: Doc, p: Any) -> List<Map<Str, Any>> {
    if (p.context.only != nil and not has(p.context.only, "source.organizeImports") and not has(p.context.only, "source")) { return []; }
    let edits: List<Map<Str, Any>> = []; let lines: List<Str> = ls_split(doc.text, "\n"); push(lines, ""); mut offset: Int = 0; let block: List<Str> = []; mut start: Int = 0;
    for line: Str in lines {
        let trimmed: Str = ls_trim(line);
        mut isImport: Bool = false;
        if ((ls_starts(trimmed, "import \"") or ls_starts(trimmed, "from \"")) and ls_ends(trimmed, ";")) {
            // Sort only a complete lexical directive. Inline statements and
            // import-looking text inside strings/comments must retain order.
            for imp: Import in doc.imports {
                if (imp.start >= offset and imp.end <= offset + ls_bytes(line) and ls_trim(ls_slice(doc.text, offset, imp.start)) == "" and ls_trim(ls_slice(doc.text, imp.end, offset + ls_bytes(line))) == "") {
                    isImport = true; break;
                }
            }
        }
        if (isImport) { if (len(block) == 0) { start = offset; } push(block, line); }
        else if (len(block) > 0) {
            let replacement: Str = join(sort(block), "\n") + "\n";
            if (replacement != ls_slice(doc.text, start, offset)) { push(edits, {"range": ls_range(doc.text, start, offset), "newText": replacement}); }
            while (len(block) > 0) { pop(block); }
        }
        offset += ls_bytes(line) + 1;
    }
    if (len(edits) == 0) { return []; }
    let changes: Map<Str, List<Map<Str, Any>>> = {}; changes[doc.uri] = edits;
    return [{"title": "Organize imports", "kind": "source.organizeImports", "edit": {"changes": changes}}];
}
fun ls_call_item(d: Def) -> Map<Str, Any> {
    let doc: Optional<Doc> = ls_document(d.uri);
    if (doc == nil) {
        return {"name": d.name, "kind": 12, "uri": d.uri, "detail": d.signature, "range": ls_range("", 0, 0), "selectionRange": ls_range("", 0, 0), "data": {"uri": d.uri, "offset": d.a}};
    }
    return {"name": d.name, "kind": 12, "uri": d.uri, "detail": d.signature, "range": ls_range(doc.text, d.start, d.end), "selectionRange": ls_range(doc.text, d.a, d.b), "data": {"uri": d.uri, "offset": d.a}};
}
fun ls_call_target(item: Any) -> Optional<Def> {
    if (value_tag(item.uri) != 1) { return nil; }
    let doc: Optional<Doc> = ls_document(str(item.uri)); if (doc == nil) { return nil; }
    let offset: Int = ls_offset(doc.text, item.selectionRange.start);
    for d: Def in doc.defs { if (d.kind == 12 and d.a == offset) { return d; } }
    return nil;
}
fun ls_caller(doc: Doc, offset: Int) -> Optional<Def> {
    mut best: Optional<Def> = nil; mut bestStart: Int = -1;
    for d: Def in doc.defs { if (d.kind == 12 and d.b < offset and offset < d.end and (best == nil or d.start > bestStart)) { best = d; bestStart = d.start; } }
    return best;
}
// The incoming-call groups of one document. A caller encloses its calls, so a
// document's groups are complete without the rest of the workspace.
fun ls_document_incoming(doc: Doc, target: Def) -> List<Map<Str, Any>> {
    let groups: Map<Str, CallGroup> = {}; let order: List<Str> = [];
    for i: Int in 0..len(doc.tokens) {
        let t: Token = doc.tokens[i];
        if (t.name != target.name or ls_at(doc.tokens, i + 1) != "(" or has(doc.declared, str(t.a))) { continue; }
        let resolved: Optional<Def> = ls_resolve(doc, i); let caller: Optional<Def> = ls_caller(doc, t.a);
        if (resolved != nil and resolved.id == target.id and caller != nil) {
            if (not has(groups, caller.id)) { groups[caller.id] = CallGroup(ls_call_item(caller), []); push(order, caller.id); }
            let group: Optional<CallGroup> = groups[caller.id];
            if (group != nil) { push(group.ranges, ls_range(doc.text, t.a, t.b)); }
        }
    }
    let out: List<Map<Str, Any>> = [];
    for id: Str in order {
        let group: Optional<CallGroup> = groups[id];
        if (group != nil) { push(out, {"from": group.target, "fromRanges": group.ranges}); }
    }
    return out;
}
fun ls_incoming_calls(item: Any) -> List<Map<Str, Any>> {
    let target: Optional<Def> = ls_call_target(item); if (target == nil) { return []; }
    ls_workspace(); let out: List<Map<Str, Any>> = [];
    for uri: Str in keys(LS_DOCS) {
        let doc: Optional<Doc> = LS_DOCS[uri];
        if (doc != nil) { for group: Map<Str, Any> in ls_document_incoming(doc, target) { push(out, group); } }
    }
    return out;
}
fun ls_outgoing_calls(item: Any) -> List<Map<Str, Any>> {
    let caller: Optional<Def> = ls_call_target(item); if (caller == nil) { return []; }
    let doc: Optional<Doc> = ls_document(caller.uri); if (doc == nil) { return []; }
    let groups: Map<Str, CallGroup> = {}; let order: List<Str> = [];
    for i: Int in 0..len(doc.tokens) {
        let t: Token = doc.tokens[i];
        if (t.a <= caller.b or t.a >= caller.end or ls_at(doc.tokens, i + 1) != "(" or has(doc.declared, str(t.a))) { continue; }
        let enclosing: Optional<Def> = ls_caller(doc, t.a);
        if (enclosing == nil or enclosing.id != caller.id) { continue; }
        let target: Optional<Def> = ls_resolve(doc, i);
        if (target != nil and target.kind == 12) {
            if (not has(groups, target.id)) { groups[target.id] = CallGroup(ls_call_item(target), []); push(order, target.id); }
            let group: Optional<CallGroup> = groups[target.id];
            if (group != nil) { push(group.ranges, ls_range(doc.text, t.a, t.b)); }
        }
    }
    let out: List<Map<Str, Any>> = [];
    for id: Str in order {
        let group: Optional<CallGroup> = groups[id];
        if (group != nil) { push(out, {"to": group.target, "fromRanges": group.ranges}); }
    }
    return out;
}
