import "protocol.may";
import "text.may";
import "index.may";
import "features.may";
import "diagnostics.may";

/// A queued navigation request: its JSON-RPC id, method, params and index epoch.
struct NavigationJob { id: Any, method: Str, params: Any, epoch: Int }

// One isolated navigation worker, at most 32 queued requests. The parent owns
// transport and cancels snapshots invalidated by edits or workspace changes.
mut LS_NAVIGATION_PID: Int = 0;
mut LS_NAVIGATION_JOB: Optional<NavigationJob> = nil;
mut LS_NAVIGATION_QUEUE: List<NavigationJob> = [];
mut LS_NAVIGATION_PARTS: List<Str> = [];
mut LS_NAVIGATION_BYTES: Int = 0;
mut LS_NAVIGATION_DEADLINE: Int = 0;
let LS_NAVIGATION_IO: Int = syscall(9, 0, 65536, 3, 34, -1, 0);

fun ls_navigation_method(method: Str) -> Bool {
    return has(["workspace/symbol", "textDocument/references", "textDocument/rename",
        "callHierarchy/incomingCalls", "callHierarchy/outgoingCalls"], method);
}
fun ls_navigation_stream(method: Str, p: Any) -> Nil {
    if (method == "workspace/symbol") {
        let query: Str = ls_lower(str(p.query ?? "")); mut first: Bool = true;
        ls_write("{\"result\":[");
        ls_navigation_walk(fun(doc: Doc) -> Nil {
            for d: Def in doc.defs {
                if (d.scope == 0 and ls_contains(ls_lower(d.name), query)) {
                    if (not first) { ls_write(","); } first = false;
                    ls_write(ls_json({"name": d.name, "kind": d.kind, "location": ls_location(d)}));
                }
            }
            return;
        });
        ls_write("]}"); return;
    }
    if (method == "callHierarchy/incomingCalls") {
        // Stream through bounded batches like references: loading the whole
        // workspace at once made the worker's heap grow with every file.
        let targetDef: Optional<Def> = ls_call_target(p.item);
        if (targetDef == nil) { ls_write("{\"result\":[]}"); return; }
        let target: Def = targetDef;
        mut first: Bool = true;
        ls_write("{\"result\":[");
        ls_navigation_walk(fun(doc: Doc) -> Nil {
            for group: Map<Str, Any> in ls_document_incoming(doc, target) {
                if (not first) { ls_write(","); } first = false;
                ls_write(ls_json(group));
            }
            return;
        });
        ls_write("]}"); return;
    }
    if (method == "callHierarchy/outgoingCalls") { ls_write(ls_json({"result": ls_outgoing_calls(p.item)})); return; }
    let doc: Doc = ls_doc_param(p); let rename: Bool = method == "textDocument/rename";
    let targetDef: Optional<Def> = if (rename) { ls_rename_target(doc, p) } else { ls_target(doc, p) };
    if (targetDef == nil) { ls_write("{\"result\":[]}"); return; }
    let target: Def = targetDef;
    let declarations: Bool = rename or bool(p.context?.includeDeclaration ?? false);
    mut first: Bool = true;
    ls_write(if (rename) { "{\"result\":{\"changes\":{" } else { "{\"result\":[" });
    ls_navigation_walk(fun(using: Doc) -> Nil {
        let found: List<Occurrence> = ls_document_occurrences(using, target, declarations);
        if (rename and len(found) > 0) {
            let edits: List<Map<Str, Any>> = [];
            for occurrence: Occurrence in found { push(edits, ls_rename_edit(using, target, occurrence, str(p.newName))); }
            if (not first) { ls_write(","); } first = false;
            ls_write(ls_quote(using.uri) + ":" + ls_json(edits));
        } else if (not rename) {
            for occurrence: Occurrence in found {
                if (not first) { ls_write(","); } first = false;
                ls_write(ls_json(occurrence));
            }
        }
        return;
    });
    ls_write(if (rename) { "}}}" } else { "]}" }); return;
}
fun ls_navigation_scan(path: Str, depth: Int, files: List<Str>, seen: Map<Str, Bool>) -> Nil {
    if (depth > 24 or len(files) >= 10000) { return; }
    let entries: List<Str> = may { read_dir(path) } otherwise { [] };
    for entry: Str in entries {
        if (len(files) >= 10000) { break; }
        if (has([".", "..", ".git", ".may", "target", "node_modules", ".codex", ".agents", "build"], entry)) { continue; }
        let child: Str = path + "/" + entry;
        if (ls_is_directory(child)) { ls_navigation_scan(child, depth + 1, files, seen); }
        else if (ls_ends(entry, ".may")) {
            let uri: Str = ls_uri(child);
            if (not has(seen, uri)) { seen[uri] = true; push(files, uri); }
        }
    }
    return;
}
fun ls_navigation_restore(base: Map<Str, Doc>) -> Nil {
    let documents: Map<Str, Doc> = {};
    for uri: Str in keys(base) {
        let kept: Optional<Doc> = base[uri];
        if (kept != nil) { documents[uri] = kept; }
    }
    LS_DOCS = documents; return;
}
fun ls_navigation_walk(visit: (Doc) -> Nil) -> Nil {
    let base: Map<Str, Doc> = {}; let seen: Map<Str, Bool> = {}; let files: List<Str> = keys(LS_DOCS);
    for uri: Str in files {
        let cached: Optional<Doc> = LS_DOCS[uri];
        if (cached != nil) { base[uri] = cached; }
        seen[uri] = true;
    }
    for root: Str in LS_ROOTS { ls_navigation_scan(root, 0, files, seen); }
    mut count: Int = 0;
    for uri: Str in files {
        let doc: Optional<Doc> = ls_document(uri);
        if (doc != nil) { visit(doc); }
        count += 1;
        // Retain unsaved buffers and their original dependency snapshot, while
        // releasing transient indexes after each bounded batch of disk files.
        if (count % 32 == 0) { ls_navigation_restore(base); }
    }
    ls_navigation_restore(base); return;
}
fun ls_navigation_stop() -> Nil {
    if (LS_NAVIGATION_PID > 0) {
        syscall(62, LS_NAVIGATION_PID, 9);
        mut waited: Int = syscall(61, LS_NAVIGATION_PID, 0, 0, 0);
        while (waited == -4) { waited = syscall(61, LS_NAVIGATION_PID, 0, 0, 0); }
    }
    if (LS_NAVIGATION_FD >= 0) { syscall(3, LS_NAVIGATION_FD); }
    LS_NAVIGATION_PID = 0; LS_NAVIGATION_FD = -1; LS_NAVIGATION_JOB = nil;
    LS_NAVIGATION_PARTS = []; LS_NAVIGATION_BYTES = 0; return;
}
fun ls_navigation_invalidate(code: Int, message: Str) -> Nil {
    let active: Optional<NavigationJob> = LS_NAVIGATION_JOB;
    if (active != nil) { ls_error(active.id, code, message); }
    ls_navigation_stop();
    for job: NavigationJob in LS_NAVIGATION_QUEUE { ls_error(job.id, code, message); }
    LS_NAVIGATION_QUEUE = []; return;
}
fun ls_navigation_changed() -> Nil {
    let active: Optional<NavigationJob> = LS_NAVIGATION_JOB;
    mut stale: Bool = active != nil and active.epoch != LS_INDEX_EPOCH;
    for job: NavigationJob in LS_NAVIGATION_QUEUE { if (job.epoch != LS_INDEX_EPOCH) { stale = true; } }
    if (stale) { ls_navigation_invalidate(-32803, "Content changed during navigation; retry request"); }
    return;
}
fun ls_navigation_cancel(id: Any) -> Nil {
    let active: Optional<NavigationJob> = LS_NAVIGATION_JOB;
    if (active != nil and active.id == id) {
        ls_navigation_stop(); ls_error(id, -32800, "Request cancelled");
    }
    let remaining: List<NavigationJob> = [];
    for job: NavigationJob in LS_NAVIGATION_QUEUE {
        if (job.id == id) { ls_error(id, -32800, "Request cancelled"); } else { push(remaining, job); }
    }
    LS_NAVIGATION_QUEUE = remaining; return;
}
fun ls_request_navigation(id: Any, method: Str, p: Any) -> Nil {
    if (len(LS_NAVIGATION_QUEUE) >= 32) { ls_error(id, -32803, "Navigation queue limit exceeded"); return; }
    push(LS_NAVIGATION_QUEUE, NavigationJob(id, method, p, LS_INDEX_EPOCH));
    return;
}
fun ls_navigation_start(job: NavigationJob, now: Int) -> Nil {
    if (syscall(293, LS_NAVIGATION_IO, 524288) < 0) { ls_error(job.id, -32803, "Navigation pipe failed"); return; }
    let readFd: Int = load32(LS_NAVIGATION_IO); let writeFd: Int = load32(LS_NAVIGATION_IO + 4);
    let parentPid: Int = syscall(39); let pid: Int = syscall(57);
    if (pid < 0) { syscall(3, readFd); syscall(3, writeFd); ls_error(job.id, -32803, "Navigation fork failed"); return; }
    if (pid == 0) {
        syscall(157, 1, 9, 0, 0, 0);
        if (syscall(110) != parentPid) { syscall(60, 0); }
        syscall(3, readFd);
        if (LS_BACKGROUND_FD >= 0) { syscall(3, LS_BACKGROUND_FD); }
        if (LS_WORKSPACE_FD >= 0) { syscall(3, LS_WORKSPACE_FD); }
        // Runtime fatal errors write directly to fd 1. Keep those bytes off
        // the client transport; malformed worker output becomes a request error.
        syscall(33, writeFd, 1);
        LS_OUTPUT_FD = writeFd; LS_DIAGNOSTIC_PUBLISH = false;
        // Results stream to the parent as files are visited. A final status
        // record commits success or discards partial results after late errors.
        may { ls_navigation_stream(job.method, job.params); ls_write("\n{}"); }
        otherwise { ls_write("\n" + ls_json({"error": {"code": -32602, "message": str(err.message)}})); }
        syscall(3, writeFd); syscall(60, 0); exit(0);
    }
    syscall(3, writeFd); syscall(72, readFd, 4, 2048);
    LS_NAVIGATION_PID = pid; LS_NAVIGATION_FD = readFd; LS_NAVIGATION_JOB = job;
    LS_NAVIGATION_PARTS = []; LS_NAVIGATION_BYTES = 0; LS_NAVIGATION_DEADLINE = now + 30000;
    return;
}
fun ls_navigation_tick(now: Int) -> Nil {
    let active: Optional<NavigationJob> = LS_NAVIGATION_JOB;
    if (active != nil and active.epoch != LS_INDEX_EPOCH) {
        ls_navigation_invalidate(-32803, "Content changed during navigation; retry request");
    }
    if (LS_NAVIGATION_PID > 0 and now >= LS_NAVIGATION_DEADLINE) {
        if (active != nil) { ls_navigation_stop(); ls_error(active.id, -32803, "Navigation time limit exceeded"); }
    }
    if (LS_NAVIGATION_FD >= 0) {
        mut done: Bool = false;
        // Bound pipe draining per turn so a large result cannot starve input.
        for chunk: Int in 0..4 {
            let n: Int = syscall(0, LS_NAVIGATION_FD, LS_NAVIGATION_IO, 65536);
            if (n == -4) { continue; }
            if (n == -11) { break; }
            if (n <= 0) { done = true; break; }
            push(LS_NAVIGATION_PARTS, ls_text(ptr(LS_NAVIGATION_IO), n)); LS_NAVIGATION_BYTES += n;
            if (LS_NAVIGATION_BYTES > 16777216) { done = true; break; }
        }
        if (done) {
            let finished: Optional<NavigationJob> = LS_NAVIGATION_JOB; let body: Str = ls_join(LS_NAVIGATION_PARTS, "");
            ls_navigation_stop();
            if (finished == nil) { return; }
            if (finished.epoch != LS_INDEX_EPOCH) { ls_error(finished.id, -32803, "Content changed during navigation; retry request"); }
            else {
                // The worker streams `{"result":...}`, a newline and a status
                // record that commits success. Only the small status is parsed;
                // the result text is forwarded as the worker encoded it, since
                // parsing and re-encoding it dominated large replies.
                let prefix: Str = "{\"result\":";
                let snapshot: Any = may {
                    // Encoded JSON has no raw newline, so the boundary is the last
                    // one; scanning back reads only the status record.
                    mut boundary: Int = ls_bytes(body) - 1;
                    while (boundary >= 0 and ls_byte(body, boundary) != 10) { boundary -= 1; }
                    if (boundary < 0) { fail("incomplete navigation worker result"); }
                    let status: Any = ls_parse_json(ls_slice(body, boundary + 1, ls_bytes(body)));
                    if (status.error != nil) { status }
                    else if (boundary < ls_bytes(prefix) + 1 or ls_slice(body, 0, ls_bytes(prefix)) != prefix or ls_slice(body, boundary - 1, boundary) != "}") { fail("malformed navigation worker result"); }
                    else { ({"raw": ls_slice(body, ls_bytes(prefix), boundary - 1)}) }
                } otherwise { ({"error": {"code": -32803, "message": "Navigation worker failed or result limit exceeded"}}) };
                if (snapshot.error != nil) { ls_error(finished.id, int(snapshot.error.code), str(snapshot.error.message)); }
                else { ls_reply_raw(finished.id, str(snapshot.raw)); }
            }
        }
    }
    if (LS_NAVIGATION_PID == 0 and len(LS_NAVIGATION_QUEUE) > 0) {
        let job: NavigationJob = LS_NAVIGATION_QUEUE[0]; LS_NAVIGATION_QUEUE = slice(LS_NAVIGATION_QUEUE, 1, len(LS_NAVIGATION_QUEUE));
        if (job.epoch != LS_INDEX_EPOCH) { ls_error(job.id, -32803, "Content changed during navigation; retry request"); }
        else { ls_navigation_start(job, now); }
    }
    return;
}
