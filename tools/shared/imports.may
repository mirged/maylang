// imports.may — find the modules a source file imports.
//
// Used by `may` (consumers are listed in README.md). It lists every
// `import "..."` / `from "..." import` path in a source file, ignoring strings
// and comments, so build caches can track a module's dependencies.

// ---------------------------------------------------------------- scanning

/// A token read from a character list: its text and the index after it.
struct Scanned { value: Str, next: Int }

fun is_ident_start(c: Str) -> Bool {
    if (c >= "a" && c <= "z") { return true; }
    if (c >= "A" && c <= "Z") { return true; }
    return c == "_";
}

fun is_ident_char(c: Str) -> Bool {
    if (is_ident_start(c)) { return true; }
    return c >= "0" && c <= "9";
}

fun is_space(c: Str) -> Bool {
    if (c == " " || c == "\t" || c == "\n" || c == "\r") { return true; }
    return false;
}

fun skip_line(cs: List<Str>, i: Int) -> Int {
    mut j: Int = i;
    while (j < len(cs) && cs[j] != "\n") { j = j + 1; }
    return j;
}

fun skip_block(cs: List<Str>, i: Int) -> Int {
    mut j: Int = i + 2;
    mut depth: Int = 1;
    while (j < len(cs) && depth > 0) {
        if (cs[j] == "/" && j + 1 < len(cs) && cs[j + 1] == "*") {
            depth = depth + 1;
            j = j + 2;
        } else if (cs[j] == "*" && j + 1 < len(cs) && cs[j + 1] == "/") {
            depth = depth - 1;
            j = j + 2;
        } else {
            j = j + 1;
        }
    }
    return j;
}

fun read_str(cs: List<Str>, i: Int) -> Scanned {
    mut j: Int = i + 1;
    mut buf: Str = "";
    while (j < len(cs)) {
        let c: Str = cs[j];
        if (c == "\\") { if (j + 1 < len(cs)) { buf = buf + cs[j + 1]; } j = j + 2; continue; }
        if (c == "\"") { return Scanned(buf, j + 1); }
        buf = buf + c;
        j = j + 1;
    }
    return Scanned(buf, j);
}

fun read_ident(cs: List<Str>, i: Int) -> Scanned {
    mut j: Int = i;
    mut buf: Str = "";
    while (j < len(cs) && is_ident_char(cs[j])) {
        buf = buf + cs[j];
        j = j + 1;
    }
    return Scanned(buf, j);
}

/// All import paths mentioned in a source file, with comments and unrelated
/// strings ignored.
pub fun scan_imports(src: Str) -> List<Str> {
    let cs: List<Str> = chars(src);
    let n: Int = len(cs);
    let out: List<Str> = [];
    mut i: Int = 0;
    mut last: Str = "";
    while (i < n) {
        let c: Str = cs[i];
        if (c == "/" && i + 1 < n && cs[i + 1] == "/") { i = skip_line(cs, i); continue; }
        if (c == "/" && i + 1 < n && cs[i + 1] == "*") { i = skip_block(cs, i); continue; }
        if (c == "\"") {
            let r: Scanned = read_str(cs, i);
            if (last == "import" || last == "from") { push(out, r.value); }
            i = r.next;
            last = "";
            continue;
        }
        if (is_ident_start(c)) {
            let r: Scanned = read_ident(cs, i);
            last = r.value;
            i = r.next;
            continue;
        }
        if (is_space(c)) { i = i + 1; continue; }
        last = "";
        i = i + 1;
    }
    return out;
}
